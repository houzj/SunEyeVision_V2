UsageExample.cs

# 大型二进制依赖 - 不追踪到 Git（部署时单独分发）
libs/halcon/runtime/
build_output/
runtime/
# 通讯设备运行时是源码，不属于二进制运行目录。
!/src/DeviceDriver/Communications/Runtime/
!/src/DeviceDriver/Communications/Runtime/*.cs

# 安装包第三方工具（Inno Setup 安装器 10.3MB，按需从官网下载）
installer/third-party/

# 安装包产物（Inno Setup 输出，约 158MB，部署时单独分发）
dist/

# 打包脚本生成的版本片段（installer/Pack-Release.ps1 每次打包重写）
installer/.generated/

# IDE 临时文件 (find-skills 等技能自动生成的 plan 草案,不应入库)
.codebuddy/plans/

# 工具运行时状态 (方案实施 STATE.md 每次实施会重写,不入库)
.codebuddy/skills/方案实施/STATE.md

# 开发计划 hook 运行时状态 (记录上次同步的提交 hash,每次提交都变,不入库)
plans/.last_synced_commit
# 补齐同步的运行锁 + 中间产物 (运行时生成,不入库)
plans/.sync.lock
plans/_sync_payload.json
plans/_apply_out.txt
plans/_fix_out.txt

# 开发计划 hook 生成产物 (全部可从 git log + 模板重建,每次提交后重建看板都变,不入库)
# plan.json 保留入库 (含人工维护的模块/任务定义 + 幂等日志追加)
plans/plan.html
plans/tasks/
plans/gitlogs/
plans/weekly.json

# AI 会话记忆 (私有数据,不随 git 分发)
.workbuddy/

# MSBuild 隔离构建临时目录 (重定向的 obj 输出,含绝对路径与缓存,不入库)
build_temp_verify/
