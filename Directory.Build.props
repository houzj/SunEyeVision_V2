<Project>
  <!--
  Directory.Build.props
  全局构建配置文件,适用于所有项目
  
  输出路径设计:
  - Main (SunEyeVision_Dev): d:/MyWork/SunEyeVision_Dev/dev/Debug/ (保持不变)
  - Camera (SunEyeVision_Dev-camera): d:/MyWork/SunEyeVision_Dev-camera/dev/Debug/
  - Tool (SunEyeVision_Dev-tool): d:/MyWork/SunEyeVision_Dev-tool/dev/Debug/
  - Release: d:/MyWork/SunEyeVision_Dev/Release/SunEyeVision_v1.0.0/SunEyeVision/
  -->

  <PropertyGroup>
    <!-- 关键: 在 props 评估早期就设置默认 Configuration。
         若此处不为空,SDK 到 csproj 阶段才赋默认值(Debug),
         则下方 Condition="'$(Configuration)'=='Debug'" 的 OutputPath/OutDir 在 props 评估时空值不生效,
         导致主程序等所有项目 OutputPath 回落 SDK 默认 bin/ 。 -->
    <Configuration Condition="'$(Configuration)'==''">Debug</Configuration>

    <!-- 工作区基础路径 = 本 props 文件所在目录(即当前 worktree 根, 末尾自带 \)。
         治本(2026-09-10): 原写法 $(MSBuildProjectDirectory)\..\..\ 是"相对项目目录上溯两级",
         仅对 src/xxx、tools/xxx、tests/xxx 这类恰好两层深的项目成立;
         项目若建在其它层级(如 .codebuddy/tmp/xxx 临时工具), 上溯即错位,
         把输出偏到 .codebuddy\dev\Debug\ 与 .codebuddy\build_temp\ 等意外目录。
         $(MSBuildThisFileDirectory) 恒等于 worktree 根, 与项目层级无关,
         天然满足"各 worktree 输出到各自 dev/"的设计意图, 故原 WorktreeName 分支冗余已删。 -->
    <WorktreeBasePath>$(MSBuildThisFileDirectory)</WorktreeBasePath>
    
    <!-- Debug 输出到各 worktree 独立的 dev/Debug/ 目录
         同时设置 OutputPath 与 OutDir：
         OutputPath 必须在这里(props 早期)设置,SDK 计算 TargetPath/deps.json 时才能跟随,
         仅设 OutDir 时 TargetPath 仍回落 SDK 默认 bin/ 。

         测试项目(文件名 *.Tests)统一输出到 tests\bin\<Configuration>\<TargetFramework>\
         (非各自 bin、非 dev/Debug 根) —— 所有测试项目共享同一输出目录:
         * 主程序 dev/Debug 与 Release 发布目录零测试污染;
         * 宿主依赖(框架 dll / halcon native / OpenCvSharp runtimes / 语言资源)
           由各测试项目 copy-local 到同一共享目录自然合并去重, 只有一份, 不随工具数量膨胀;
         * 测试运行目录自足完整, 不依赖从 dev/Debug 根补齐 (宿主依赖不都在根,
           native 在 runtimes\win-x64\native\ 等子目录)。
         props 阶段 IsTestProject 尚不可知(在 csproj 内定义), 用 MSBuildProjectName 以
         .Tests 结尾可靠判定 —— 全部测试项目 csproj 均以 .Tests.csproj 命名, 普通项目无此后缀。
         (说明: $(MSBuildProjectDirectory)\..\ = worktree\tests\, 故 ..\bin = worktree\tests\bin) -->
    <OutputPath Condition="'$(Configuration)'=='Debug' And !$(MSBuildProjectName.EndsWith('.Tests'))">$(WorktreeBasePath)\dev\Debug\</OutputPath>
    <OutputPath Condition="'$(Configuration)'=='Release' And !$(MSBuildProjectName.EndsWith('.Tests'))">$(WorktreeBasePath)\Release\SunEyeVision_v1.0.0\SunEyeVision\</OutputPath>
    <OutDir Condition="'$(Configuration)'=='Debug' And !$(MSBuildProjectName.EndsWith('.Tests'))">$(WorktreeBasePath)\dev\Debug\</OutDir>
    <OutDir Condition="'$(Configuration)'=='Release' And !$(MSBuildProjectName.EndsWith('.Tests'))">$(WorktreeBasePath)\Release\SunEyeVision_v1.0.0\SunEyeVision\</OutDir>

    <OutputPath Condition="'$(Configuration)'=='Debug' And $(MSBuildProjectName.EndsWith('.Tests'))">$(MSBuildProjectDirectory)\..\bin\Debug\</OutputPath>
    <OutputPath Condition="'$(Configuration)'=='Release' And $(MSBuildProjectName.EndsWith('.Tests'))">$(MSBuildProjectDirectory)\..\bin\Release\</OutputPath>
    <OutDir Condition="'$(Configuration)'=='Debug' And $(MSBuildProjectName.EndsWith('.Tests'))">$(MSBuildProjectDirectory)\..\bin\Debug\</OutDir>
    <OutDir Condition="'$(Configuration)'=='Release' And $(MSBuildProjectName.EndsWith('.Tests'))">$(MSBuildProjectDirectory)\..\bin\Release\</OutDir>
    <!-- 共享输出目录要求所有文件(含 deps.json/runtimeconfig)落在同一层, 关闭 SDK 自动追加 TFM 子目录 -->
    <AppendTargetFrameworkToOutputPath Condition="$(MSBuildProjectName.EndsWith('.Tests'))">false</AppendTargetFrameworkToOutputPath>

    <!-- 中间目录也独立到各 worktree -->
    <IntermediateOutputPath>$(WorktreeBasePath)\build_temp\obj\$(MSBuildProjectName)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>

    <CreateProgramDatabase>true</CreateProgramDatabase>
    <DebugType Condition="'$(Configuration)'=='Release'">embedded</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)'=='Debug'">full</DebugType>
  </PropertyGroup>

  <!-- 工具插件特殊配置: OutputPath/OutDir 覆盖必须放在 Directory.Build.targets,
       因为 props 评估时 csproj 的 <IsToolPlugin>true</IsToolPlugin> 尚未生效。 -->


  <ItemGroup Condition="'$(IsToolPlugin)'=='true'">
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
  </ItemGroup>


</Project>
