<Project>
  <!-- 工具插件拦截: 6 步清理 plugins/ 输出目录污染
       适用条件: csproj 设置 <IsToolPlugin>true</IsToolPlugin>。

       设计原则(rule-008):
       - 零兼容: 直接 Remove,不留任何兼容层
       - 报错优先: 路径错误直接 warn 让用户看到
       - YAGNI: 只拦截观察到的污染通道
       - KISS: 每个 Step 一个独立 Target,职责单一

       评估顺序: SDK 内置 Target → props → csproj → Directory.Build.targets
       OutDir 覆盖: 在 Directory.Build.targets 中统一管理,
       工具输出到 <worktree>/dev/Debug/plugins/<ToolName>/ 子目录。
       OutDir 用 $[System.IO.Path]::GetFullPath 规范化,避免字面拼接 '..\..\' 在
       后续 Delete/RemoveDir 操作中无法被 SDK 规范化导致路径不匹配。 -->

  <!-- Halcon 托管程序集自动部署:
       工具插件通过 HintPath=..\..\dev\Debug\halcondotnetxl.dll 引用 Halcon 托管封装。
       该 dll 源文件位于 libs\halcon\net\,不在构建输出链中,删 dev/Debug 后工具会编译失败。
       本 Target 在"解析引用前"把源文件复制到 <worktree>/dev/Debug/,
       保证任何项目编译前 halcondotnetxl.dll 已就位,无需手动部署。
       SkipUnchangedFiles 保证幂等(已存在且未变则跳过)。 -->
  <Target Name="EnsureHalconNetAssembly"
          BeforeTargets="ResolveReferences"
          Condition="Exists('$(MSBuildThisFileDirectory)libs\halcon\net\halcondotnetxl.dll')">
    <MakeDir Directories="$(MSBuildThisFileDirectory)dev\Debug\" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)libs\halcon\net\halcondotnetxl.dll"
          DestinationFolder="$(MSBuildThisFileDirectory)dev\Debug\"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 工具插件: OutDir 统一覆盖到 plugins/<ToolName>/ 子目录
       不区分特例,所有 IsToolPlugin=true 的 csproj 一律输出到独立子目录,
       避免 AvalonEdit/Roslyn 等重型 NuGet 依赖污染 plugins/ 根。 -->
  <PropertyGroup Condition="'$(IsToolPlugin)'=='true'">
    <OutDir Condition="'$(Configuration)'=='Debug'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\dev\Debug\plugins\$(MSBuildProjectName)\'))</OutDir>
    <OutDir Condition="'$(Configuration)'=='Release'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Release\SunEyeVision_v1.0.0\SunEyeVision\plugins\$(MSBuildProjectName)\'))</OutDir>
  </PropertyGroup>

  <!-- Step 1: 从 ReferenceCopyLocalPaths 移除非工具主程序集
       <ProjectReference Private=false</ProjectReference> 只控制 ProjectReference,
       PackageReference 走 ReferenceCopyLocalPaths 通道,源头 <Private>false</Private> 也无效。
       必须在 ResolveAssemblyReferences 之后从 ReferenceCopyLocalPaths 中显式 Remove。
       保留白名单: SunEyeVision.Tool.* (工具主程序集) + SunEyeVision.* 内部跨工具共享程序集。
       其余 framework / NuGet 运行时 / 工具运行时依赖 一律 Remove, 由主程序统一提供。
       设计模型: "宿主统一加载" - 主程序 csproj 集中声明 Script 工具所需的 AvalonEdit/Roslyn 等重型 NuGet,
       主程序 AppDomain 在 dev/Debug/ 根目录 BCL probing 找到这些依赖,
       Assembly.LoadFrom(工具 dll) 时 CLR 自动在 probing 路径解析。-->
  <Target Name="RemoveNonToolAssembliesFromCopyLocal" AfterTargets="ResolveAssemblyReferences" Condition="'$(IsToolPlugin)'=='true'">
    <ItemGroup>
      <!-- 1.1 移除所有不以 SunEyeVision.Tool. 开头的 SunEyeVision.* 主程序集(框架模块) -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::new('%(Filename)').StartsWith('SunEyeVision.'))
                    And !$([System.String]::new('%(Filename)').StartsWith('SunEyeVision.Tool.'))" />
      <!-- 1.2 移除所有 NuGet framework dll(AvalonEdit / Roslyn / OpenCvSharp / Humanizer / System.Composition.* 等)
              特征: 不以 SunEyeVision. 开头的所有 dll
              Microsoft.NETCore.App 共享运行时引用,本来就不该出现在 ReferenceCopyLocalPaths -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="!$([System.String]::new('%(Filename)').StartsWith('SunEyeVision.'))" />
      <!-- 1.3 移除 halcondotnetxl(主程序统一加载) -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::new('%(Filename)').Equals('halcondotnetxl'))" />
    </ItemGroup>
  </Target>

  <!-- Step 2: 禁止 NuGet 原生运行时 DLL 复制 (OpenCvSharp4 等 runtimes 子目录)
       Content/None Link 包含 'runtimes' 路径的项会被复制到输出目录,
       这些是原生 dll(opencv_world、halcon native 等),必须拦截。
       但 SDK 会自动创建 RID 解析的空目录(win-x64/native/),Step 2 拦不住空目录,Step 7 处理。 -->
  <Target Name="SuppressNativeRuntimesForToolPlugins" BeforeTargets="PrepareForBuild" Condition="'$(IsToolPlugin)'=='true'">
    <ItemGroup>
      <_RuntimeTrash Include="@(None)" Condition="'%(None.Link)' != '' And $([System.String]::new('%(None.Link)').Contains('runtimes'))" />
      <_RuntimeTrash Include="@(Content)" Condition="'%(Content.Link)' != '' And $([System.String]::new('%(Content.Link)').Contains('runtimes'))" />
      <None Remove="@(_RuntimeTrash)" />
      <Content Remove="@(_RuntimeTrash)" />
    </ItemGroup>
  </Target>

  <!-- Step 4: 删除工具自身的 .deps.json
       走 SDK 内部独立的 AddDepsFileToOutput 通道,
       不在 ReferenceCopyLocalPaths / AllItemsFullPathWithTargetPath 中,
       源头 <Private>false</Private> 和 OutDir 覆盖都无法拦截。
       必须 Build 之后 Delete,Delete 的 Files 属性不支持通配符,
       必须先放入 ItemGroup 才能用 @(_ToolDepsJson) 展开。
       工具的外部 NuGet 依赖由主程序 AppDomain 在 dev/Debug/ 根目录统一提供,
       工具 dll 不应独立解析 deps.json,保留会导致 AssemblyLoadContext 版本冲突。 -->
  <Target Name="RemoveToolDepsJson" AfterTargets="Build" Condition="'$(IsToolPlugin)'=='true'">
    <ItemGroup>
      <_ToolDepsJson Include="$(OutDir)SunEyeVision.Tool.*.deps.json" />
    </ItemGroup>
    <Delete Files="@(_ToolDepsJson)" />
  </Target>

  <!-- Step 5: 删除 NuGet 多语言资源子目录
       AvalonEdit / Roslyn / OpenCvSharp4 / ICSharpCode.Decompiler 等 NuGet 包内嵌 13 种语言的 .NET 资源卫星程序集,
       通过 ReferenceCopyLocalPaths 通道复制到 <OutDir>\<lang>\*.resources.dll。
       工具插件场景下不需要国际化支持(UI 由主程序承载),
       直接删除所有语言子目录,只保留主程序需要的 en/ (由主程序自行管理)。 -->
  <Target Name="RemoveToolLanguageResources" AfterTargets="Build" Condition="'$(IsToolPlugin)'=='true'">
    <ItemGroup>
      <_ToolLangDirs Include="$(OutDir)cs" />
      <_ToolLangDirs Include="$(OutDir)de" />
      <_ToolLangDirs Include="$(OutDir)es" />
      <_ToolLangDirs Include="$(OutDir)fr" />
      <_ToolLangDirs Include="$(OutDir)it" />
      <_ToolLangDirs Include="$(OutDir)ja" />
      <_ToolLangDirs Include="$(OutDir)ko" />
      <_ToolLangDirs Include="$(OutDir)pl" />
      <_ToolLangDirs Include="$(OutDir)pt-BR" />
      <_ToolLangDirs Include="$(OutDir)ru" />
      <_ToolLangDirs Include="$(OutDir)tr" />
      <_ToolLangDirs Include="$(OutDir)zh-Hans" />
      <_ToolLangDirs Include="$(OutDir)zh-Hant" />
    </ItemGroup>
    <RemoveDir Directories="@(_ToolLangDirs)" Condition="Exists('%(Identity)')" />
  </Target>

  <!-- Step 6: Resources/ 子目录 — 已撤回
       Script 工具自带 Resources/CSharpLight.xshd / CSharpDark.xshd(语法高亮定义),
       与 AvalonEdit NuGet 包内的通用 Resources/ 在输出目录重名。
       Step 6 一刀切会误删 Script 工具自己的 xshd,导致脚本编辑器语法高亮失效。
       xshd 文件体积小(< 50KB),保留无副作用,与 MAGE3D MCTools/ 残留 1 个 Resources/ 一致可接受。
       如果未来需要清理,可改为检测"目录内全部为 NuGet 通用资源"的精准判断。 -->

  <!-- Step 7: 删除 RID 解析产生的空 runtimes/ 目录树
       Script 工具的 AvalonEdit/Avalonia 等 NuGet 包声明了 RID 目标(win-x64 / win / browser),
       SDK 会创建 runtimes/<rid>/native/ 占位空目录,Step 2 无法拦截空目录。
       工具插件场景下不需要 RID 解析(纯托管),直接删除整个 runtimes/ 目录树。 -->
  <Target Name="RemoveToolEmptyRuntimesTree" AfterTargets="Build" Condition="'$(IsToolPlugin)'=='true'">
    <RemoveDir Directories="$(OutDir)runtimes" Condition="Exists('$(OutDir)runtimes')" />
  </Target>

  <!-- Step 8: 删除 WPF 临时构建目录 <ToolName>_*_wpftmp/
       UseWPF=true 时 SDK 会创建 <ToolName>_<hash>_wpftmp/ 临时目录用于 XAML 编译,
       编译完成后该目录被 SDK 留作缓存,实际为空但污染 plugins/ 目录。
       关键: SDK 把 wpftmp 放在项目 OutDir 的**父目录**(即 plugins/ 根),而非 OutDir 自身子目录。
       例如 OutDir=plugins\SunEyeVision.Tool.Script\, wpftmp 实际在 plugins\SunEyeVision.Tool.Script_xxx_wpftmp\。
       所以搜索路径要用 $([System.IO.Path]::GetDirectoryName($(OutDir))) 的父目录。
       MSBuild ItemGroup 的 Include glob 在评估时展开,wpftmp 目录在 Build 中途创建,
       AfterTargets=Build 时 ItemGroup Include 不会重新评估。
       用 utilities/Remove-WpfTempDir.ps1 辅助脚本在 Target 执行时动态枚举并删除,
       避免 MSBuild XML/属性引号转义问题。 -->
  <Target Name="RemoveToolWpfTempDir" AfterTargets="Build" Condition="'$(IsToolPlugin)'=='true'">
    <PropertyGroup>
      <_WpfTempPath>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName('$([System.IO.Path]::GetDirectoryName('$(OutDir)'))'))'))</_WpfTempPath>
      <_WpfTempFilter>$(MSBuildProjectName)_*_wpftmp</_WpfTempFilter>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)utilities\Remove-WpfTempDir.ps1&quot; -Path &quot;$(_WpfTempPath)&quot; -Filter &quot;$(_WpfTempFilter)&quot;" ContinueOnError="true" />
  </Target>

  <!-- Step 9: 复制 Halcon native dll 到主程序输出目录(绿色部署)
       libs/halcon/runtime/x64-win64/ 下的 25 个 native dll(halconxl.dll 等)
       是 halcondotnetxl.dll 的 P/Invoke 目标,必须与 halcondotnetxl 同目录才能加载。
       仅在主程序场景(IsToolPlugin!=true)复制,工具插件目录由主程序 AppDomain
       在 dev/Debug/ 根目录统一解析 native 依赖。
       Halcon 目录不存在直接报错(rule-008 报错优先),不静默跳过。
       去重: 用 $(OutDir) 路径作为 Key 防止 sln 多 csproj 链式构建时重复执行
       (Plugin.SDK/Core/Workflow 都会触发本 Target, SkipUnchangedFiles 仅跳过 IO 不会跳过 Target 自身,
       首个 csproj 完成复制后其余 csproj 因 .lock 文件存在直接 return)。-->
  <Target Name="CopyHalconNativeRuntimes" AfterTargets="Build" Condition="'$(IsToolPlugin)'!='true'">
    <PropertyGroup>
      <_HalconSrcDir>$(MSBuildThisFileDirectory)libs\halcon\runtime\x64-win64\</_HalconSrcDir>
      <_HalconLockFile>$(OutDir).halcon-native-deployed</_HalconLockFile>
    </PropertyGroup>
    <Error Text="Halcon native 目录不存在: $(_HalconSrcDir)。请先部署 libs/halcon/runtime/x64-win64/*.dll (rule-008 报错优先)。" Condition="!Exists('$(_HalconSrcDir)')" />
    <ItemGroup>
      <_HalconNative Include="$(_HalconSrcDir)**\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HalconNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Touch Files="$(_HalconLockFile)" AlwaysCreate="true" />
    <Message Text="[Halcon] 已部署 25 个 native dll -> $(OutDir)" Importance="high" />
  </Target>
</Project>
