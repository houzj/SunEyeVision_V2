<Project>
  <!-- ============================================================
       工具插件输出控制
       目标: dev/Debug/plugins/ 只包含工具自身的 dll/pdb/deps.json
       ============================================================ -->

  <!-- Halcon 运行时 DLL: 排除工具插件 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)libs\halcon\runtime\x64-win64') And '$(IsToolPlugin)'!='true'">
    <None Include="$(MSBuildThisFileDirectory)libs\halcon\runtime\x64-win64\**\*.dll"
          Link="runtimes\halcon\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- 工具插件全局属性 -->
  <PropertyGroup Condition="'$(IsToolPlugin)'=='true'">
    <!-- 禁止引用项目的 .pdb/.xml 复制 -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- =====================================================================
       工具插件: 禁止框架 DLL 复制到 plugins/ 目录
        
       方案说明:
       1. 静态 ItemGroup — 运行时评估阶段设置 Private=false，阻止直接引用复制
       2. RemoveFrameworkDllsFromCopyLocal — 在 ResolveAssemblyReferences 之后
          从 ReferenceCopyLocalPaths 中移除框架 DLL，阻止传递依赖复制
       3. SuppressNativeRuntimesForToolPlugins — 禁止原生运行时 DLL 复制
       
       效果: plugins/ 只包含工具自身的 .dll/.pdb/.deps.json
       ===================================================================== -->
       
  <!-- Step 1: 静态 ItemGroup — 阻止直接引用复制 -->
  <ItemGroup Condition="'$(IsToolPlugin)'=='true'">
    <ProjectReference Update="@(ProjectReference)">
      <Private>false</Private>
    </ProjectReference>
    <Reference Update="halcondotnetxl">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Step 2: 构建时移除传递依赖 — 从 ReferenceCopyLocalPaths 删除框架 DLL -->
  <Target Name="RemoveFrameworkDllsFromCopyLocal" AfterTargets="ResolveAssemblyReferences" Condition="'$(IsToolPlugin)'=='true'">
    <ItemGroup>
      <!-- 移除 SunEyeVision.* 框架 DLL（保留 SunEyeVision.Tool.* 工具自身） -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" 
          Condition="$([System.String]::new('%(Filename)').StartsWith('SunEyeVision.'))
                    And !$([System.String]::new('%(Filename)').StartsWith('SunEyeVision.Tool.'))" />
      <!-- 移除 Halcon .NET 包装 -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" 
          Condition="$([System.String]::new('%(Filename)').Equals('halcondotnetxl'))" />
      <!-- OpenCvSharp 由 SuppressNativeRuntimesForToolPlugins 处理 -->
    </ItemGroup>
  </Target>

  <!-- Step 3: 禁止 NuGet 原生运行时 DLL 复制 (OpenCvSharp4) 和 Halcon 运行时 -->
  <Target Name="SuppressNativeRuntimesForToolPlugins" BeforeTargets="PrepareForBuild" Condition="'$(IsToolPlugin)'=='true'">
    <ItemGroup>
      <_RuntimeTrash Include="@(None)" Condition="'%(None.Link)' != '' And $([System.String]::new('%(None.Link)').Contains('runtimes'))" />
      <_RuntimeTrash Include="@(Content)" Condition="'%(Content.Link)' != '' And $([System.String]::new('%(Content.Link)').Contains('runtimes'))" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="@(_RuntimeTrash)" />
      <Content Remove="@(_RuntimeTrash)" />
    </ItemGroup>
  </Target>

  <!-- Step 4: 构建后清理残留的运行时目录（防止全解决方案构建时其他项目拷贝干扰） -->
  <Target Name="CleanupPluginRuntimeResidue" AfterTargets="Build" Condition="'$(IsToolPlugin)'=='true'">
    <RemoveDir Directories="$(OutDir)runtimes" Condition="Exists('$(OutDir)runtimes')" />
  </Target>
</Project>
