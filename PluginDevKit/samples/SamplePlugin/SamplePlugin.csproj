<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SamplePlugin</RootNamespace>
    <AssemblyName>SamplePlugin</AssemblyName>
    <IsToolPlugin>true</IsToolPlugin>
    <ToolComponentId>SamplePlugin.Runtime</ToolComponentId>
    <ToolComponentToolId>SamplePlugin</ToolComponentToolId>
    <ToolComponentRole>Runtime</ToolComponentRole>
    <ToolComponentEntryType>SamplePlugin.SampleTool</ToolComponentEntryType>
    
    <!-- 插件元数据 -->
    <PluginId>SamplePlugin</PluginId>
    <PluginName>示例插件</PluginName>
    <PluginVersion>1.0.0</PluginVersion>
    <PluginDescription>用于演示插件开发流程的示例插件</PluginDescription>
    <PluginAuthor>SunEyeVision Team</PluginAuthor>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Plugin.cs" />
    <Compile Remove="SampleTool.cs" />
  </ItemGroup>
</Project>
