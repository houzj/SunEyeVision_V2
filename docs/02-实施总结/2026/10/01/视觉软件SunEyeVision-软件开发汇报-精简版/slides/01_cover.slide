<Slide style={{
    width: '1280px', height: '720px', position: 'relative', overflow: 'hidden',
    background: 'linear-gradient(135deg, #0B2A45 0%, #14456E 55%, #2196F3 160%)',
    padding: '20px 60px', fontFamily: '"Microsoft YaHei", "Segoe UI", sans-serif'
}}>
    {/* 背景装饰：右侧大圆弧 */}
    <Box style={{
        position: 'absolute', right: -160, top: -180, width: 620, height: 620,
        borderRadius: '50%', background: 'rgba(255,255,255,0.06)'
    }} />
    <Box style={{
        position: 'absolute', right: 80, bottom: -220, width: 460, height: 460,
        borderRadius: '50%', background: 'rgba(33,150,243,0.18)'
    }} />

    {/* 顶部标识 */}
    <Box style={{
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        height: 40, position: 'relative', zIndex: 2
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{
                width: 30, height: 30, borderRadius: 8, background: '#2196F3',
                justifyContent: 'center', alignItems: 'center'
            }}>
                <FAIcon name='eye' style={{ fill: '#ffffff', width: 18, height: 18 }} />
            </Box>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#ffffff', letterSpacing: 1 }}>
                视觉软件 SunEyeVision（V2）
            </Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#9FC3E0' }}>视觉引导抓取平台</Text>
    </Box>

    {/* 主体：左侧骑线标题 + 右侧大数字组 */}
    <Box style={{ flexDirection: 'row', flex: 1, alignItems: 'center', position: 'relative', zIndex: 2 }}>
        {/* 左：标题区 */}
        <Box style={{ width: '58%', flexDirection: 'column', gap: 16 }}>
            <Box style={{
                flexDirection: 'row', alignItems: 'center', gap: 10,
                background: 'rgba(255,255,255,0.12)', padding: '6px 14px',
                borderRadius: 999, width: 250
            }}>
                <FAIcon name='calendar' style={{ fill: '#9FC3E0', width: 15, height: 15 }} />
                <Text style={{ fontSize: 13, color: '#DCEAF6' }}>2026-10-01 汇报</Text>
            </Box>
            <Text style={{ fontSize: 78, fontWeight: 800, color: '#ffffff', lineHeight: 1.15, letterSpacing: -1 }}>
                软件开发汇报
            </Text>
            <Text style={{ fontSize: 22, color: '#BBD6EC', lineHeight: 1.5 }}>
                已完成产出 · 当前在建 · 下一步计划
            </Text>
            <Text style={{ fontSize: 14, color: '#9FC3E0' }}>
                产品定位：<span style={{ color: '#ffffff', fontWeight: 'bold' }}>平台能力</span>（协议与机型按现场挂载，可复用到多机型 / 多现场），非单一项目定制
            </Text>
            <Box style={{
                marginTop: 4, padding: '14px 18px', borderRadius: 10,
                background: 'rgba(255,255,255,0.10)', borderLeft: '4px solid #E8930C'
            }}>
                <Text style={{ fontSize: 17, color: '#EAF3FB', lineHeight: 1.6 }}>
                    平台底座与视觉工具链<span style={{ fontWeight: 'bold', color: '#ffffff' }}>已成型</span>，19 个工具插件<span style={{ fontWeight: 'bold' }}>可直接组流程演示</span>；
                    测量工具链提前完工，当前收口<span style={{ fontWeight: 'bold', color: '#ffffff' }}>相机 / 通讯 / 图像源</span>设备层；<br />交付目标：<span style={{ fontWeight: 'bold', color: '#E8930C' }}>12/31 具备引导抓取的演示能力</span>。
                </Text>
            </Box>
        </Box>

        {/* 右：大数字组（视觉锚点） */}
        <Box style={{ width: '42%', flexDirection: 'column', gap: 16, paddingLeft: 30 }}>
            <Box style={{
                background: 'rgba(255,255,255,0.10)', borderRadius: 14,
                padding: '18px 22px', flexDirection: 'row', alignItems: 'flex-end', gap: 12
            }}>
                <Text style={{ fontSize: 84, fontWeight: 800, color: '#E8930C', lineHeight: 1 }}>71%</Text>
                <Box style={{ flexDirection: 'column', paddingBottom: 8 }}>
                    <Text style={{ fontSize: 15, color: '#ffffff', fontWeight: 'bold' }}>整体完成度</Text>
                    <Text style={{ fontSize: 13, color: '#9FC3E0' }}>197 / 276 子任务</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 16 }}>
                <Box style={{
                    flex: 1, background: 'rgba(255,255,255,0.10)', borderRadius: 14, padding: '16px 18px'
                }}>
                    <Text style={{ fontSize: 46, fontWeight: 800, color: '#ffffff', lineHeight: 1 }}>19</Text>
                    <Text style={{ fontSize: 14, color: '#BBD6EC', marginTop: 6 }}>已落地工具插件</Text>
                </Box>
                <Box style={{
                    flex: 1, background: 'rgba(255,255,255,0.10)', borderRadius: 14, padding: '16px 18px'
                }}>
                    <Text style={{ fontSize: 46, fontWeight: 800, color: '#E8930C', lineHeight: 1 }}>12/31</Text>
                    <Text style={{ fontSize: 14, color: '#BBD6EC', marginTop: 6 }}>引导抓取演示能力</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 区页脚 */}
    <Box style={{
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        height: 40, position: 'relative', zIndex: 2
    }}>
        <Text style={{ fontSize: 13, color: '#8FB4D1' }}>数据来源：Git 提交记录 + 计划看板 + docs 文档库</Text>
        <Text style={{ fontSize: 13, color: '#8FB4D1' }}>01 / 4</Text>
    </Box>
</Slide>
