<Slide style={{
    width: '1280px', height: '720px', position: 'relative', overflow: 'hidden',
    background: '#FFFFFF', padding: '20px 60px',
    fontFamily: '"Microsoft YaHei", "Segoe UI", sans-serif'
}}>
    {/* A 区：标题块 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 100, gap: 14 }}>
        <Box style={{ width: 6, height: 38, background: '#2196F3', borderRadius: 3 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 700, color: '#0B2A45' }}>已完成产出</Text>
            <Text style={{ fontSize: 13, color: '#5B6B7C' }}>
                五条开发线均已出活 · 主界面可直接演示（数据来源：Git 提交 + 计划看板 + docs 文档库）
            </Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Box style={{
            flexDirection: 'row', alignItems: 'center', gap: 8,
            background: 'rgba(33,150,243,0.08)', padding: '7px 14px', borderRadius: 999
        }}>
            <FAIcon name='check-circle' style={{ fill: '#2196F3', width: 16, height: 16 }} />
            <Text style={{ fontSize: 14, color: '#14456E', fontWeight: 'bold' }}>整体完成 197 / 276 子任务</Text>
        </Box>
    </Box>

    {/* B 区：左 = 五条产出线清单 / 右 = 软件主界面截图 */}
    <Box style={{ flexDirection: 'row', height: 440, gap: 24 }}>
        {/* 左：产出线清单 */}
        <Box style={{ width: 446, flexDirection: 'column', gap: 9 }}>
            <Box style={{
                height: 54, background: '#0B2A45', borderRadius: 12, padding: '0 16px',
                flexDirection: 'row', alignItems: 'center', gap: 10
            }}>
                <FAIcon name='layer-group' style={{ fill: '#2196F3', width: 26, height: 26 }} />
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: 800, color: '#ffffff' }}>五条线都已出活</Text>
                    <Text style={{ fontSize: 12, color: '#BBD6EC' }}>任一块都可单独拿出来演示或交付</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 10, padding: '0 12px', flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                <FAIcon name='cube' style={{ fill: '#2196F3', width: 17, height: 17 }} />
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0B2A45' }}>平台底座（14 模块）</Text>
                    <Text style={{ fontSize: 12, color: '#5B6B7C' }}>画布与工作流、路径算法、参数绑定、结果树、RoI、SDK 控件</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 10, padding: '0 12px', flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                <FAIcon name='thumbtack' style={{ fill: '#2196F3', width: 17, height: 17 }} />
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0B2A45' }}>视觉工具插件 19 个</Text>
                    <Text style={{ fontSize: 12, color: '#5B6B7C' }}>图像处理 5 · 引导匹配 3 · 几何测量 6 · 流程控制 3 · 分析标定 2</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: 'rgba(232,147,12,0.08)', borderRadius: 10, padding: '0 12px', flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                <FAIcon name='ruler-combined' style={{ fill: '#E8930C', width: 17, height: 17 }} />
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0B2A45' }}>测量工具链（9/28 完工）</Text>
                    <Text style={{ fontSize: 12, color: '#5B6B7C' }}>圆/直线查找 + 几何测量六件套：算法＋控件＋契约测试，提前 25 天</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 10, padding: '0 12px', flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                <FAIcon name='box-open' style={{ fill: '#2196F3', width: 17, height: 17 }} />
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0B2A45' }}>交付工程化</Text>
                    <Text style={{ fontSize: 12, color: '#5B6B7C' }}>版本单一真源 + 一键打包；安装包 2.0.0.1（alpha）</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 10, padding: '0 12px', flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                <FAIcon name='clipboard-check' style={{ fill: '#2196F3', width: 17, height: 17 }} />
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0B2A45' }}>质量与文档</Text>
                    <Text style={{ fontSize: 12, color: '#5B6B7C' }}>607 个用例 / 28 个测试工程；337 篇文档，52/54 模块有方案</Text>
                </Box>
            </Box>

        </Box>

        {/* 右：软件主界面截图 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 7 }}>
                    <FAIcon name='window-maximize' style={{ fill: '#2196F3', width: 15, height: 15 }} />
                    <Text style={{ fontSize: 15, fontWeight: 700, color: '#0B2A45' }}>软件主界面（内测版 2.0.0.1）</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#5B6B7C' }}>可视化工作流 · 图像与检测结果 · 运行日志</Text>
            </Box>
            <Image src="assets/main_ui.jpg" style={{ width: 682, height: 410, borderRadius: 10, border: '1px solid #DCE6EF' }} />
        </Box>
    </Box>

    {/* 在建状态条 */}
    <Box style={{ flexDirection: 'row', height: 60, gap: 14, marginTop: 16 }}>
        <Box style={{
            flexDirection: 'row', alignItems: 'center', gap: 10,
            background: '#0B2A45', borderRadius: 12, padding: '0 18px', width: 210
        }}>
            <FAIcon name='hammer' style={{ fill: '#E8930C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#ffffff' }}>当前在建</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 12, padding: '10px 14px', flexDirection: 'column', gap: 6 }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0B2A45' }}>相机管理</Text>
                    <Text style={{ fontSize: 14, color: '#E8930C', fontWeight: 'bold' }}>3 / 4</Text>
                </Box>
                <Box style={{ height: 6, background: '#E3E9EF', borderRadius: 3 }}>
                    <Box style={{ width: '75%', height: 6, background: '#2196F3', borderRadius: 3 }} />
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 12, padding: '10px 14px', flexDirection: 'column', gap: 6 }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0B2A45' }}>通讯管理</Text>
                    <Text style={{ fontSize: 14, color: '#E8930C', fontWeight: 'bold' }}>3 / 4</Text>
                </Box>
                <Box style={{ height: 6, background: '#E3E9EF', borderRadius: 3 }}>
                    <Box style={{ width: '75%', height: 6, background: '#2196F3', borderRadius: 3 }} />
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#F5F8FB', borderRadius: 12, padding: '10px 14px', flexDirection: 'column', gap: 6 }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0B2A45' }}>通讯工具链</Text>
                    <Text style={{ fontSize: 14, color: '#E8930C', fontWeight: 'bold' }}>0 / 7</Text>
                </Box>
                <Box style={{ height: 6, background: '#E3E9EF', borderRadius: 3 }} />
            </Box>
            <Box style={{
                flex: 1.2, background: 'rgba(33,150,243,0.08)', borderRadius: 12, padding: '10px 14px',
                flexDirection: 'column', justifyContent: 'center', gap: 3
            }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0B2A45' }}>标定工具链 · N 点标定</Text>
                <Text style={{ fontSize: 13, color: '#5B6B7C' }}>计划内工作提前启动，已落地 1,291 行</Text>
            </Box>
        </Box>
    </Box>

    {/* C 区：页脚 */}
    <Box style={{
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        height: 40, marginTop: 0
    }}>
        <Text style={{ fontSize: 13, color: '#8FB4D1' }}>视觉软件 SunEyeVision · 软件开发汇报</Text>
        <Text style={{ fontSize: 13, color: '#8FB4D1' }}>02 / 4</Text>
    </Box>
</Slide>
