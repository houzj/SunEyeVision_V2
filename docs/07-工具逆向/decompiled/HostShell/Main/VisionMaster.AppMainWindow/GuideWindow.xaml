<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMaster.AppMainWindow.GuideWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:appMainWindow="clr-namespace:VisionMaster.AppMainWindow" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Attached="clr-namespace:Apps.UIHelper.Attach;assembly=Apps.UIHelper" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="guide" Title="{DynamicResource GuideWindow}" WindowStyle="SingleBorderWindow" Height="546" Width="800" CloseButtonVisibility="Collapsed" BorderThickness="0" CornerRadius="4" ShowInTaskbar="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Controls;component/Styles/BaseWindowStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <convert:LongTextConvert x:Key="LongTextConvert" FontSize="16" MaxLen="138" FontFamily="Microsoft YaHei" />
      <Style x:Key="sp2" TargetType="{x:Type Separator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="25,0,35,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Grid Height="40" Width="1">
                <Rectangle VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource Col_GuideWindow_Spliter}" StrokeThickness="0" Width="1" Height="40" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type appMainWindow:GuideButton}" TargetType="{x:Type appMainWindow:GuideButton}">
        <Setter Property="Height" Value="122" />
        <Setter Property="Width" Value="180" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource NormalTextBlockColor}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type appMainWindow:GuideButton}">
              <Grid>
                <Image Name="Image" Source="{TemplateBinding appMainWindow:GuideButton.BackImage}" />
                <ContentPresenter Margin="16,50,0,0" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Name="help" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,16" FontSize="11" Foreground="{DynamicResource GuideTextBlockFg}" FontWeight="Normal" Text="{TemplateBinding appMainWindow:GuideButton.HelpContent}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                  <Setter TargetName="help" Value="{DynamicResource ButtonForground}" Property="TextBlock.Foreground" />
                  <Setter TargetName="Image" Property="Image.Source" Value="{Binding BackImageClick, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Col_GuideWindow_ListView_Foreground}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
              <Grid>
                <Border>
                  <ContentPresenter Name="HeaderContent" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="3,0,0,0" />
        <Setter Property="Attached:AttachedRoutedEvent.Event" Value="MouseDoubleClick" />
        <Setter Property="Attached:AttachedRoutedEventBase.Command" Value="{Binding SelectSolutionCommand}" />
        <Setter Property="Attached:AttachedRoutedEventBase.CommandParameter" Value="{x:Reference guide}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListViewItem}">
              <Border Background="{TemplateBinding Control.Background}" Margin="0,8,0,0" Height="31" BorderThickness="{TemplateBinding Border.BorderThickness}" SnapsToDevicePixels="True">
                <GridViewRowPresenter VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                <Image Name="Image" Source="/VisionMasterMain;component/Resources/guide_check-box_off.png" Cursor="Hand" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" Margin="6,0,0,0" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Image" Property="Image.Source" Value="/VisionMasterMain;component/Resources/guide_check-box_on.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <controls:BaseWindow.TitleBar>
    <Border Height="130" Margin="-1" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Col_SubForm_BorderBrush}" Background="{DynamicResource Col_GuideWindow_Title_Background}">
      <Grid>
        <Rectangle StrokeThickness="2" Height="2" Margin="0,0,0,0" VerticalAlignment="Top" Stroke="{DynamicResource Col_Window_TopFill}" />
        <Image Name="titleLogo" Source="/VisionMasterMain;component/Resources/logo_VM.png" Margin="20,9,20,9" Width="100" Height="48" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Name="titleVersion" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="138,37,0,0" Text="{DynamicResource Lang_version}" FontStyle="Italic" Foreground="{DynamicResource TextBlockFg}" />
        <ToggleButton Name="buttonShow" WindowChrome.IsHitTestVisibleInChrome="True" Content="{DynamicResource 不再显示}" Foreground="{DynamicResource ToggleButtonFg}" FontSize="14" Margin="0,0,45,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Right" Checked="DoNotShow_OnChecked" Unchecked="DoNotShow_OnUnchecked">
          <UIElement.RenderTransform>
            <TranslateTransform Y="10" />
          </UIElement.RenderTransform>
        </ToggleButton>
        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{DynamicResource WinCloseBtnStyle}" Height="32" Width="32" HorizontalAlignment="Right" Click="Close_OnClick">
          <UIElement.RenderTransform>
            <TranslateTransform Y="4" />
          </UIElement.RenderTransform>
        </Button>
      </Grid>
    </Border>
  </controls:BaseWindow.TitleBar>
  <Border SnapsToDevicePixels="True" UseLayoutRounding="True" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource Col_SubForm_BorderBrush}" Background="{DynamicResource Col_GuideWindow_Background}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="78" />
      </Grid.RowDefinitions>
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Col_GuideWindow_CenterLine}">
        <Border.Background>
          <DrawingBrush Stretch="Fill" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <GeometryDrawing Brush="{DynamicResource Col_GuideWindow_Background_Line}" Geometry="M0,2 L1,2 L1,3 L0,3 M1,1 L2,1 L2,2 L1,2 M2,0 L3,0 L3,1 L2,1 M3,5 L4,5 L4,6 L3,6 M4,4 L5,4 L5,5 L4,5 M5,3 L6,3 L6,4 L5,4" />
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Background>
      </Border>
      <Border Grid.Row="1" Background="{DynamicResource Col_GuideWindow_Bottom_Background}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Col_GuideWindow_CenterLine}" />
      <Border Name="Border" Margin="55,0,0,56" Grid.Row="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Col_GuideWindow_RightLine}" Width="412" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="412">
          <appMainWindow:GuideButton Click="GuideButton_OnClick" Width="188" Height="130" BackImageClick="/VisionMasterMain;component/Resources/guide_general_click.png" BackImage="/VisionMasterMain;component/Resources/guide_general.png" Margin="0,0,22,22" HelpContent="{DynamicResource 建立普通空白方案}" ToolBoxType="General">
            <TextBlock Text="{DynamicResource 通用方案}" Margin="0,10,0,0" />
          </appMainWindow:GuideButton>
          <appMainWindow:GuideButton Click="GuideButton_OnClick" Width="188" Height="130" BackImageClick="/VisionMasterMain;component/Resources/guide_position_click.png" BackImage="/VisionMasterMain;component/Resources/guide_position.png" Margin="0,0,0,22" HelpContent="{DynamicResource 通过定位、测量工具进行设计}" ToolBoxType="Position">
            <TextBlock Text="{DynamicResource 定位测量}" Margin="0,10,0,0" />
          </appMainWindow:GuideButton>
          <appMainWindow:GuideButton Click="GuideButton_OnClick" Width="188" Height="130" BackImageClick="/VisionMasterMain;component/Resources/guide_defect_click.png" BackImage="/VisionMasterMain;component/Resources/guide_defect.png" Margin="0,0,22,0" HelpContent="{DynamicResource 借助检测工具查找工件缺陷}" ToolBoxType="Defect">
            <TextBlock Text="{DynamicResource Defect Detection}" Margin="0,10,0,0" />
          </appMainWindow:GuideButton>
          <appMainWindow:GuideButton Click="GuideButton_OnClick" Width="188" Height="130" BackImageClick="/VisionMasterMain;component/Resources/guide_recognition_click.png" BackImage="/VisionMasterMain;component/Resources/guide_recognition.png" HelpContent="{DynamicResource 通过识别工具进行方案设计}" ToolBoxType="Recognition">
            <TextBlock Text="{DynamicResource 用于识别}" Margin="0,10,0,0" />
          </appMainWindow:GuideButton>
        </WrapPanel>
      </Border>
      <ListView Name="ListView" Grid.Row="0" VerticalAlignment="Bottom" BorderThickness="0" Width="225" HorizontalAlignment="Right" Margin="0,0,58,56" Background="#00FFFFFF" ItemsSource="{Binding RecentlySolutions, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type appMainWindow:GuideWindow}}}" Height="{Binding ActualHeight, ElementName=Border}">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{DynamicResource Lang_OpenLastSol}" Width="140">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Name="TextBlock" Margin="-5,0,0,0" FontSize="16" Foreground="{DynamicResource Col_GuideWindow_ListView_Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding FileName, Mode=OneWay, Converter={StaticResource LongTextConvert}}" ToolTip="{Binding SolutionPath}" />
                  <DataTemplate.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}}">
                      <Setter TargetName="TextBlock" Value="{DynamicResource Col_GuideWindow_ListView_Selected_Foreground}" Property="TextBlock.Foreground" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="80">
              <GridViewColumn.Header>
                <controls:IconMenuItem ShowMask="False" Height="32" Width="40" Margin="30,0,0,0" NormalIcon="/VisionMasterMain;component/Resources/guide_open_normal.png" HoverIcon="/VisionMasterMain;component/Resources/guide_open_click .png" ClickIcon="/VisionMasterMain;component/Resources/guide_open_click .png" Click="OpenFile_OnClick" />
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontSize="14" Foreground="{DynamicResource Col_GuideWindow_ListView_Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding LastTimeStr, Mode=OneWay}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <Rectangle Height="20" Width="2" Fill="{DynamicResource Col_Theme}" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0" Margin="0,6,290,0" />
      <Menu Name="areaGuideLine" Grid.Row="1" Background="#00FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="35,0,0,0">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type controls:IconMenuItem}" TargetType="{x:Type controls:IconMenuItem}">
              <Setter Property="FontSize" Value="16" />
              <Setter Property="controls:IconMenuItem.ShowMask" Value="False" />
              <Setter Property="Foreground" Value="{DynamicResource Col_GuideWindow_ListView_Foreground}" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Col_Theme}" />
                </Trigger>
                <Trigger Property="MenuItem.IsPressed" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Col_Theme}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <controls:IconMenuItem NormalIcon="/VisionMasterMain;component/Resources/ic_1_normal.png" HoverIcon="/VisionMasterMain;component/Resources/ic_1_click.png" ClickIcon="/VisionMasterMain;component/Resources/ic_1_click.png" Header="{Binding LearnStr, ElementName=guide}" Click="LocalHelp_OnClick" />
        <Separator Style="{StaticResource sp2}" />
        <controls:IconMenuItem NormalIcon="/VisionMasterMain;component/Resources/ic_2_normal.png" HoverIcon="/VisionMasterMain;component/Resources/ic_2_click.png" ClickIcon="/VisionMasterMain;component/Resources/ic_2_click.png" Header="{DynamicResource 查看示例方案}" Click="Open_Demo" />
        <Separator Style="{StaticResource sp2}" />
        <controls:IconMenuItem NormalIcon="/VisionMasterMain;component/Resources/ic_3_normal.png" HoverIcon="/VisionMasterMain;component/Resources/ic_3_click.png" ClickIcon="/VisionMasterMain;component/Resources/ic_3_click.png" Header="{DynamicResource 获取更多支持和帮助}" Click="OnLineHelp_OnClick" />
      </Menu>
    </Grid>
  </Border>
</controls:BaseWindow>