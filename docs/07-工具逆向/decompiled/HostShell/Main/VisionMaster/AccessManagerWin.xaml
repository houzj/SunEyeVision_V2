<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMaster.AccessManagerWin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="accessManagerWindow" WindowStartupLocation="CenterScreen" Title="{DynamicResource 用户管理}" Height="420" Width="370" BorderBrush="#FF161617" BorderThickness="1" MinButtonVisibility="Collapsed" ShowInTaskbar="False" xmlns:visionmaster="clr-namespace:VisionMaster;assembly=VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFF2F3F5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <ScrollViewer Name="listParam" Grid.Row="0" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">
      <StackPanel Orientation="Vertical" VerticalAlignment="Top">
        <StackPanel Name="panelAdminTech" Orientation="Vertical" VerticalAlignment="Top">
          <Label Content="{DynamicResource Lang_Role_Admin}" FontSize="14" Margin="18,20,0,7" Foreground="#FF4D4D4D" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
            <Label Content="{DynamicResource 旧密码}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
            <Grid>
              <PasswordBox Name="adminOldCode" Margin="12,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
              <TextBox Name="textBoxOldCode" Margin="12,0,0,0" Width="182" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" Tag="{DynamicResource 请输入密码}" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ElementName=adminOldCode, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
            </Grid>
            <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessManagerWindow, Path=IfShowOldCode, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Name="oldCodeTips" Text="{DynamicResource 管理员旧密码有误}" Margin="138,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
            <Label Content="{DynamicResource 新密码}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
            <Grid>
              <PasswordBox Name="adminNewCode" Margin="12,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
              <TextBox Name="textBoxNewCode" Margin="12,0,0,0" Width="182" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" Tag="{DynamicResource 请输入3~15位密码}" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ElementName=adminNewCode, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
            </Grid>
            <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessManagerWindow, Path=IfShowNewCode, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Name="newCodeTips" Text="{DynamicResource 密码格式不正确}" Margin="138,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
            <Label Content="{DynamicResource 确认密码}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
            <Grid>
              <PasswordBox Name="adminCheckCode" Margin="12,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
              <TextBox Name="textBoxCheckCode" Margin="12,0,0,0" Width="182" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" Tag="{DynamicResource 请输入密码}" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ElementName=adminCheckCode, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
            </Grid>
            <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessManagerWindow, Path=IfShowCheckCode, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Name="checkCodeTips" Text="{DynamicResource 两次密码不一致}" Margin="138,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
          <Label Content="{DynamicResource Lang_Role_Tech}" FontSize="14" Margin="18,12,0,10" Foreground="#FF4D4D4D" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
            <Label Content="{DynamicResource 启用技术员}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
            <ToggleButton Name="techEnable" Grid.Row="1" Template="{StaticResource switchbutton}" Width="80" Checked="techEnable_Checked" Unchecked="techEnable_Unchecked" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
            <Label Content="{DynamicResource 技术员密码}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
            <Grid>
              <PasswordBox Name="techSetCode" Margin="12,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding ElementName=techCode, Path=IsEnabled}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
              <TextBox Name="techCode" Margin="12,0,0,0" Style="{StaticResource textBoxStyle}" IsEnabled="False" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" Visibility="Collapsed" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
            </Grid>
            <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessManagerWindow, Path=IfShowTechSetCode, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Name="teckCodeTips" Text="{DynamicResource 密码格式不正确}" Margin="138,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
          <TextBlock FontSize="12" Height="120" Margin="48,0,50,0" TextWrapping="Wrap" Foreground="#FF999999" Text="{DynamicResource Lang_TrainNote}" />
        </StackPanel>
        <Label Content="{DynamicResource Lang_Role_Operator}" FontSize="14" Margin="18,12,0,10" Foreground="#FF4D4D4D" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 启用操作员}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
          <ToggleButton Name="operatorEnable" Grid.Row="1" Template="{StaticResource switchbutton}" Width="80" Unchecked="operatorEnable_Unchecked" Checked="operatorEnable_Checked" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 操作员密码}" Width="80" FontSize="14" Margin="46,0,0,0" Foreground="#FF666666" />
          <Grid>
            <PasswordBox Name="operatorSetCode" Margin="12,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding ElementName=operatorCode, Path=IsEnabled}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
            <TextBox Name="operatorCode" Margin="12,0,0,0" Style="{StaticResource textBoxStyle}" IsEnabled="False" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" Visibility="Collapsed" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
          </Grid>
          <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessManagerWindow, Path=IfShowOperatorSetCode, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Name="operatorCodeTips" Text="{DynamicResource 密码格式不正确}" Margin="138,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
        <TextBlock FontSize="12" Height="44" Margin="48,0,50,30" TextWrapping="Wrap" Foreground="#FF999999" Text="{DynamicResource Lang_OperatorNote}" />
      </StackPanel>
    </ScrollViewer>
    <Grid Background="#FFE4E4E7" Row="1" Height="32" VerticalAlignment="Bottom">
      <Button Grid.Row="4" Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Confirm}" HorizontalAlignment="Right" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="ButtonApply_Click" />
    </Grid>
  </Grid>
</controls:BaseWindow>