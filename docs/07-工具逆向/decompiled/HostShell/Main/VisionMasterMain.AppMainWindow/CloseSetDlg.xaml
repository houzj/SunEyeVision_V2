<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.AppMainWindow.CloseSetDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="CloseSet" Title="{DynamicResource Lang_CloseSet}" Height="200" Width="300" xmlns:appmainwindow="clr-namespace:VisionMasterMain.AppMainWindow;assembly=VisionMasterMain" Loaded="dlgModify_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/RadioButtonStyle/RadioButtonStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NormalRadioButton}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="34,8,20,0" VerticalAlignment="Center">
      <RadioButton Content="{DynamicResource Lang_BackRun}" IsChecked="{Binding IsRunBackground, ElementName=CloseSet, Mode=TwoWay}" />
      <RadioButton Content="{DynamicResource Lang_StopBackRun}" IsChecked="True" />
      <CheckBox Content="{DynamicResource Lang_UnNotify}" HorizontalAlignment="Right" Style="{DynamicResource CheckBoxStyle1}" Foreground="#808080" FontSize="12" Height="16" IsChecked="{Binding IsNotifyRunBackground, ElementName=CloseSet}" />
    </StackPanel>
    <Border Grid.Row="1" BorderThickness="0" Background="#E4E5E7">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="btnOK" FontSize="12" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="24" Width="60" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnOK_Click" />
        <Button Name="btnCancel" FontSize="12" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Lang_Msg_Cancel}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="24" Width="60" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnCancel_Click" />
      </StackPanel>
    </Border>
  </Grid>
</controls:BaseWindow>