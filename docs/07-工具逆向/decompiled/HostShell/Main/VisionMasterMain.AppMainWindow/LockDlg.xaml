<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.AppMainWindow.LockDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="baseWindow" Title="{DynamicResource Lang_InfoTips}" Height="200" Width="350" xmlns:appmainwindow="clr-namespace:VisionMasterMain.AppMainWindow;assembly=VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="30,3,30,0" VerticalAlignment="Center">
      <TextBlock Text="{DynamicResource Lang_LockingTips}" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
    <Border Grid.Row="1" BorderThickness="0" Background="#E4E5E7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" Content="{DynamicResource 不再显示}" HorizontalAlignment="Left" Margin="10,0,0,0" Style="{StaticResource CheckBoxStyle1}" FontSize="12" Height="26" IsChecked="{Binding IsNotifyLock, ElementName=baseWindow, Mode=TwoWay}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="btnOK" FontSize="12" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Yes}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="24" Width="60" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnOK_Click" />
          <Button Name="btnNO" FontSize="12" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource No}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="24" Width="60" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnNO_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</controls:BaseWindow>