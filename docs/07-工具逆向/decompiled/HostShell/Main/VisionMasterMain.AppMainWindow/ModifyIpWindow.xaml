<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.AppMainWindow.ModifyIpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:VisionMasterMain.AppMainWindow" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" x:Name="ModifyIp" FontSize="14" Height="420" Width="550" Foreground="#353637" Title="{DynamicResource ModifyIpAddress}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Controls;component/Styles/BaseWindowStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/RadioButtonStyle/RadioButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary>
          <Style x:Key="IpTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
          </Style>
          <Style x:Key="IpTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#696969" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="5,4" />
            <Setter Property="Height" Value="32" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                  <Border Name="TextBoxBorder" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                    <ScrollViewer Name="PART_ContentHost" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Value="StaticIP" Binding="{Binding ElementName=ModifyIp, Path=SelectedIpAssignment}">
                      <Setter Property="IsEnabled" Value="True" />
                    </DataTrigger>
                    <DataTrigger Value="False" Binding="{Binding Path=Text, Converter={x:Static local:IpLegalCvt.Cvt}, RelativeSource={RelativeSource Mode=Self}}">
                      <Setter TargetName="TextBoxBorder" Property="Border.BorderBrush" Value="#FF0000" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="EnumRadioButtonStyle" BasedOn="{StaticResource NormalRadioButton}" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#696969" />
          </Style>
          <Style x:Key="ButtonConfig" BasedOn="{StaticResource Orange_ButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Background" Value="#D6D5D4" />
            <Setter Property="Foreground" Value="#353637" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
          </Style>
          <Style x:Key="ButtonCancel" BasedOn="{StaticResource ButtonConfig}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#F2F3F5" />
          </Style>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Margin="30,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock Text="{DynamicResource ModifyIpAddressTips}" Margin="0,5" />
        <TextBlock>
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0} - {1}">
              <Binding ElementName="ModifyIp" Path="CurrentDevice.LowIpAddress" />
              <Binding ElementName="ModifyIp" Path="CurrentDevice.HighIpAddress" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>
      <RadioButton Grid.Row="1" Margin="0,15,0,0" GroupName="EnumGroup" Style="{StaticResource EnumRadioButtonStyle}" Content="{DynamicResource StaticIpType}" IsChecked="{Binding ElementName=ModifyIp, Path=SelectedIpAssignment, Converter={x:Static local:IpAssignmentEnumCvt.Cvt}, ConverterParameter={x:Static local:IpAssignmentEnumCvt.StaticIP}}" />
      <Grid Row="2" Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IpTextBlockStyle}" Text="{DynamicResource Lang_SelectServerIpAddress}" />
        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IpTextBoxStyle}" Text="{Binding ElementName=ModifyIp, Path=CurrentDevice.CurrentIP}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IpTextBlockStyle}" Text="{DynamicResource SubNetMask}" />
        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource IpTextBoxStyle}" Text="{Binding ElementName=ModifyIp, Path=CurrentDevice.SubNetMask}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IpTextBlockStyle}" Text="{DynamicResource DefaultGateway}" />
        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource IpTextBoxStyle}" Text="{Binding ElementName=ModifyIp, Path=CurrentDevice.DefaultGateway}" />
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,10">
        <RadioButton Margin="0,4" GroupName="EnumGroup" Content="{DynamicResource DHCPIpType}" Style="{StaticResource EnumRadioButtonStyle}" IsChecked="{Binding ElementName=ModifyIp, Path=SelectedIpAssignment, Converter={x:Static local:IpAssignmentEnumCvt.Cvt}, ConverterParameter={x:Static local:IpAssignmentEnumCvt.DHCP}}" />
        <RadioButton Margin="0,4" GroupName="EnumGroup" Content="{DynamicResource LLAIpType}" Style="{StaticResource EnumRadioButtonStyle}" IsChecked="{Binding ElementName=ModifyIp, Path=SelectedIpAssignment, Converter={x:Static local:IpAssignmentEnumCvt.Cvt}, ConverterParameter={x:Static local:IpAssignmentEnumCvt.LLA}}" />
      </StackPanel>
      <Border Grid.Row="4" Margin="-30,0,-30,-10" Background="#E4E5E7">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,0">
          <Button Name="ConfigButton" Content="{DynamicResource 确定}" Margin="10,8" Style="{StaticResource ButtonConfig}" Click="ConfigButton_Click" />
          <Button Name="CancelButton" Margin="10,8" Content="{DynamicResource 取消}" Style="{StaticResource ButtonCancel}" Click="CancelButton_Click" />
        </StackPanel>
      </Border>
    </Grid>
    <ProgressBar Name="ProgressBar" Grid.Row="3" VerticalAlignment="Bottom" Height="2" Margin="0,0" IsIndeterminate="True" Visibility="{Binding ElementName=ModifyIp, Path=ProgressBarVisibility}" />
    <Border Grid.Row="0" Background="#666666" Grid.RowSpan="3" Opacity="0.6" Visibility="{Binding ElementName=ProgressBar, Path=Visibility}" />
  </Grid>
</controls:BaseWindow>