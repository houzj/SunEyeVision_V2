<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="VisionMasterMain.AppMainWindow.TitleBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VisionMasterMain.AppMainWindow" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:PControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:DiagramData="clr-namespace:Apps.Data;assembly=Apps.Data" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/MenuStyle/MenuStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <convert:LongTextConvert x:Key="longTextConvert" FontSize="13" MaxLen="128" FontFamily="Microsoft YaHei" />
      <HierarchicalDataTemplate x:Key="MenueDataTemplate" ItemsSource="{Binding Items}">
        <TextBlock>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Lang:ResourceBinding Name}" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsSolutionPath}">
                  <Setter Property="Text" Value="{Binding Name, Mode=OneWay}" />
                  <Setter Property="FrameworkElement.ToolTip" Value="{Binding ToolTip}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </HierarchicalDataTemplate>
      <Style x:Key="SolutionButton" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Height="34" BorderBrush="{x:Null}">
                <TextBlock Name="Label_SolutionName" Foreground="{DynamicResource Col_Menubar_Foreground}" TextAlignment="Right" VerticalAlignment="Center" FontSize="13" Text="{Binding SolutionName, Converter={StaticResource longTextConvert}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Label_SolutionName" Value="{DynamicResource Col_Theme}" Property="TextBlock.Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FrontedButton" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Image Name="icon" Height="24" Width="24" Source="/Apps.Style;component/Resources/Frontend/ic_topbar_运行fronted_normal.png" />
                <Border Height="24" BorderBrush="{x:Null}">
                  <TextBlock Name="tb" Text="{DynamicResource RunParam_Operating Mode}" TextAlignment="Right" VerticalAlignment="Center" FontSize="13" Margin="6,0,16,0" Foreground="{DynamicResource Col_Menubar_Foreground}" />
                </Border>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="tb" Value="{DynamicResource Col_Theme}" Property="TextBlock.Foreground" />
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/Frontend/ic_topbar_运行fronted_click.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="dashboardStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="bd">
                <Image Name="ime" Stretch="None" Source="/Apps.Style;component/Resources/ic_dashboard.png" />
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsAlert}">
                  <Setter TargetName="ime" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_dashboard_异常.png" />
                </DataTrigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="bd" Value="{DynamicResource Col_Menubar_Selected_Background}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <system:Double x:Key="leftWidth">132</system:Double>
      <DataTemplate x:Key="dashboardContent">
        <ContentControl FontSize="14" Foreground="#FFBFBFBF" FontWeight="Medium">
          <Grid MinWidth="164" Height="auto">
            <Border CornerRadius="5" Background="#FF000000" BorderThickness="1">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="3" Direction="280" Opacity="0.09" ShadowDepth="2" Color="Orange" />
              </UIElement.Effect>
            </Border>
            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource Col_Menubar_VMInfo_BorderBrush}" Background="{DynamicResource Col_Menubar_VMInfo_Background}">
              <StackPanel Margin="14" KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource 内存利用率}" Foreground="{DynamicResource Col_Menubar_VMInfo_Foreground}" Width="{StaticResource leftWidth}" />
                  <TextBlock Name="tb1">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding StringFormat=' {0}%', Path=MemeryUsed, Mode=OneWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="-1" Binding="{Binding MemeryUsed}">
                            <Setter Property="Text" Value="{DynamicResource 未知}" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding MemeryAlert}">
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource CPU利用率}" Foreground="{DynamicResource Col_Menubar_VMInfo_Foreground}" Width="{StaticResource leftWidth}" />
                  <TextBlock Name="tb2">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding StringFormat=' {0}%', Path=CPUUsed, Mode=OneWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="-1" Binding="{Binding CPUUsed}">
                            <Setter Property="Text" Value="{DynamicResource 未知}" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding CPUAlert}">
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Foreground="{DynamicResource Col_Menubar_VMInfo_Foreground}" Width="{StaticResource leftWidth}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding StrEncryptType}" />
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                  <TextBlock>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{DynamicResource 未知}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="{x:Static DiagramData:DogStateEnum.NORMAL}" Binding="{Binding DogState}">
                            <Setter Property="Text" Value="{Binding StrDogState}" />
                          </DataTrigger>
                          <DataTrigger Value="{x:Static DiagramData:DogStateEnum.OVERDUE}" Binding="{Binding DogState}">
                            <Setter Property="Text" Value="{DynamicResource 过期}" />
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                          <DataTrigger Value="{x:Static DiagramData:DogStateEnum.UNDETECTED}" Binding="{Binding DogState}">
                            <Setter Property="Text" Value="{DynamicResource 未检测}" />
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Foreground="{DynamicResource Col_Menubar_VMInfo_Foreground}" Width="{StaticResource leftWidth}" Tag="{Lang:LangResource Lang_DongleSeri}" Text="{Binding Tag, StringFormat='{}{0}:', RelativeSource={RelativeSource Mode=Self}}" />
                  <TextBlock>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding Path=StrDongleSerialNo, Mode=OneWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource Camera_support}" Foreground="{DynamicResource Col_Menubar_VMInfo_Foreground}" Width="{StaticResource leftWidth}" />
                  <TextBlock Name="tb3">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding CameraNum, Mode=OneWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUnlimitOfCamera}">
                            <Setter Property="Text" Value="{DynamicResource Unlimit}" />
                          </DataTrigger>
                          <DataTrigger Value="{x:Static DiagramData:DogStateEnum.UNDETECTED}" Binding="{Binding DogState}">
                            <Setter Property="Text" Value="{DynamicResource 未检测}" />
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource RemainTime}" Foreground="{DynamicResource Col_Menubar_VMInfo_Foreground}" Width="{StaticResource leftWidth}" />
                  <TextBlock Name="tb4">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding RemainTimeDay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUnlimitOfRemainTime}">
                            <Setter Property="Text" Value="{DynamicResource Lang_Permanent}" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding RemainTimeAlert}">
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                  <TextBlock Margin="2,0,0,0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{DynamicResource Day}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUnlimitOfRemainTime}">
                            <Setter Property="Visibility" Value="Hidden" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding RemainTimeAlert}">
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                  <TextBlock Margin="2,0,0,0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding RemainTimeHour}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUnlimitOfRemainTime}">
                            <Setter Property="Visibility" Value="Hidden" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding RemainTimeAlert}">
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                  <TextBlock Margin="2,0,0,0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{DynamicResource Hour}" />
                        <Setter Property="Foreground" Value="{DynamicResource Col_Menubar_VMInfo_Foreground}" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUnlimitOfRemainTime}">
                            <Setter Property="Visibility" Value="Hidden" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding RemainTimeAlert}">
                            <Setter Property="Foreground" Value="#FFEC0000" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsSoftEncrypt}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </StackPanel>
                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#FFFF0000" TextWrapping="Wrap" Width="136">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Setter Property="Text" Value="{DynamicResource AttentionOfComputer}" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding CPUAlert}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Setter Property="Text" Value="{DynamicResource AttentionOfComputerCPU}" />
                        </DataTrigger>
                        <DataTrigger Value="True" Binding="{Binding MemeryAlert}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
              </StackPanel>
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="7" Direction="305" Opacity="0.45" ShadowDepth="3" Color="Black" />
              </UIElement.Effect>
            </Border>
          </Grid>
        </ContentControl>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Height="81" Background="{DynamicResource Col_Menubar_Background}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="184" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="34" />
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="4">
          <Image Name="logoImg" Margin="22,14,22,0" Width="126" Source="{Binding LogoImage}" Visibility="{Binding IsHideLogo, Converter={StaticResource bool2VisibilityConverter}}" />
        </StackPanel>
        <Rectangle Grid.Row="0" Grid.ColumnSpan="3" StrokeThickness="2" Margin="0,0,0,0" Stroke="{DynamicResource Col_Window_TopFill}" />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button WindowChrome.IsHitTestVisibleInChrome="True" Margin="6,0" Height="34" VerticalAlignment="Center" Style="{StaticResource SolutionButton}" ToolTip="{Binding SolutionPath}" Command="{Binding OpenSolPathCommand}" />
          <Menu Background="#00FFFFFF">
            <controls:IconMenuItem Name="accessButton" Style="{StaticResource LoginUserIconMenuItem}" NormalIcon="/VisionMasterMain;component/Resources/windowAUZ.png" ClickIcon="/VisionMasterMain;component/Resources/windowAUZ.png" HoverIcon="/VisionMasterMain;component/Resources/windowAUZ.png" Margin="0,2,0,0" Padding="-4,0,0,0" VerticalContentAlignment="Center" Width="100" Height="30" Foreground="#FFBEBEBE" WindowChrome.IsHitTestVisibleInChrome="True" Header="{Binding AccessManager.AccessButtonHeader, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding AccessManager.AccessButtonVisibility, UpdateSourceTrigger=PropertyChanged}">
              <controls:IconMenuItem Header="{DynamicResource 切换角色}" Style="{StaticResource LoginUserIconMenuItem}" Command="{Binding AccessManager.ChangeLoginUserCommand}" />
            </controls:IconMenuItem>
          </Menu>
          <PControl:PopupButton WindowChrome.IsHitTestVisibleInChrome="True" HorizontalOffsetVal="-120" VerticalOffsetVal="10" ButtonStyle="{StaticResource dashboardStyle}" SubContent="{StaticResource dashboardContent}" Style="{x:Null}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="MouseEnter">
                <core:ChangePropertyAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" PropertyName="IsDropDownOpen" Value="True" i:TargetedTriggerAction.TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type PControl:PopupButton}}}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </PControl:PopupButton>
          <Button Style="{StaticResource BtnMinimize}" Margin="3,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource 最小化}" Command="{Binding Source={x:Static SystemCommands.MinimizeWindowCommand}}" />
          <Button Style="{StaticResource BtnMaximize}" Margin="3,0" WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource BtnClose}" Margin="3,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource Off}" Command="{Binding Source={x:Static SystemCommands.CloseWindowCommand}}" Click="Button_Click" />
        </StackPanel>
        <Menu Name="menu" WindowChrome.IsHitTestVisibleInChrome="True" Grid.Row="1" Grid.Column="1" VerticalAlignment="Stretch" Margin="0,3,0,1" Background="#00FFFFFF" Style="{StaticResource NormalMenuStyle}" ItemTemplate="{StaticResource MenueDataTemplate}" FontSize="14" HorizontalAlignment="Left" IsEnabled="{Binding IsButtonClickEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TitleBar}}" ItemsSource="{Binding MenuSource.Items}">
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource NormalMenuItemStyle}" TargetType="{x:Type MenuItem}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding IsVisible}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
              <EventSetter Event="SubmenuOpened" Handler="MenuItem_SubmenuOpened" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </Menu>
        <Rectangle HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="1" Height="1" Fill="{DynamicResource Col_Menubar_CentreLine_Fill}" VerticalAlignment="Bottom" />
        <ScrollViewer Name="m_HorScroll" Grid.Row="3" Grid.Column="1" Focusable="False" Height="42" Background="#00FFFFFF" Style="{StaticResource titleBarShrinkScrollViewer}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:TitleToolBar ItemsSource="{Binding MenuToolSource}" IsEnabled="{Binding IsButtonClickEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TitleBar}}" />
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource FrontedButton}" ToolTip="{DynamicResource Lang_RunSet}" Command="{Binding OpenRunSetCommand}" />
          </Grid>
        </ScrollViewer>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>