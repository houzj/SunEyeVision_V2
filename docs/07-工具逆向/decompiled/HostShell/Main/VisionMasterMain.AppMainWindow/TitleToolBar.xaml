<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VisionMasterMain.AppMainWindow.TitleToolBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VisionMasterMain.AppMainWindow" xmlns:AppData="clr-namespace:Apps.Data.Common;assembly=Apps.Data" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" x:Name="us">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary>
          <BooleanToVisibilityConverter x:Key="boolToVisibilityCvt" />
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <CollectionViewSource x:Key="src" IsLiveGroupingRequested="True" Source="{Binding ItemsSource, Source={x:Reference us}}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="ToolGroupItemInfo.GroupName" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
      <DataTemplate x:Key="SingleRunTemplate">
        <Button Margin="4,0,4,0" Height="36" Width="36" Command="{Binding ItemClickCommand}" ToolTip="{Lang:ResourceBinding Name}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonStyle}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding Path=CustomItemData.(VMInterface:IVMRun.IsRunning)}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Value="0" Binding="{Binding CustomItemData.Modules.Count}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding CustomItemData.IsOnExecuteAfterLoad}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="ContinousRunTemplate">
        <ContentPresenter Name="cp" ContentTemplate="{StaticResource ToolButtonDataTemplate}" Content="{Binding Items[0]}" />
        <DataTemplate.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=CustomItemData.(VMInterface:IVMRun.ContinuousRunEnable)}">
            <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding Items[1]}" />
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="False" Binding="{Binding Path=CustomItemData.(VMInterface:IVMRun.ContinuousRunEnable)}" />
              <Condition Value="True" Binding="{Binding Path=CustomItemData.(VMInterface:IVMRun.IsRunning)}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="UIElement.IsEnabled" Value="False" />
          </MultiDataTrigger>
          <DataTrigger Value="0" Binding="{Binding CustomItemData.Modules.Count}">
            <Setter Property="UIElement.IsEnabled" Value="False" />
          </DataTrigger>
          <DataTrigger Value="True" Binding="{Binding CustomItemData.IsOnExecuteAfterLoad}">
            <Setter Property="UIElement.IsEnabled" Value="False" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="LockingTemplate">
        <ContentPresenter Name="cp" Content="{Binding Items[0]}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentPresenter}">
              <Setter Property="ContentTemplate" Value="{StaticResource ToolButtonDataTemplate}" />
            </Style>
          </FrameworkElement.Style>
        </ContentPresenter>
        <DataTemplate.Triggers>
          <DataTrigger Value="True" Binding="{Binding CustomItemData.IsWorkAreaLocking}">
            <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding Items[1]}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="DownPopTemplate">
        <Grid>
          <Button Name="oo" Margin="4,0,4,0" Height="36" Width="36" Command="{Binding ItemClickCommand}" ToolTip="{Lang:ResourceBinding Name}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonStyle}">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Value="True" Binding="{Binding CustomItemData.CanUndo}" />
                      <Condition Value="False" Binding="{Binding CustomItemData.LockAreaStatus}" />
                      <Condition Value="False" Binding="{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.Setters>
                      <Setter Property="IsEnabled" Value="True" />
                    </MultiDataTrigger.Setters>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Button>
          <Grid Name="rightBottom" VerticalAlignment="Bottom" HorizontalAlignment="Right" DataContext="{Binding Items[0]}">
            <Image Width="16" Height="16">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type Image}" TargetType="{x:Type Image}">
                    <Setter Property="Source" Value="{Binding ImageDisablePath}" />
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                        <Setter Property="Source" Value="{Binding ImageEnablePath}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </Image>
            <Popup Name="Popup" AllowsTransparency="True" Width="150" Height="44" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" Placement="Bottom" HorizontalOffset="-24" IsOpen="{Binding IsMouseOver, ElementName=rightBottom, Mode=OneWay}">
              <StackPanel>
                <Grid Height="2" Background="#FF000000" Opacity="0" />
                <Grid Background="{DynamicResource ToolBarPopupGridBg}" Width="150" Height="42">
                  <Border CornerRadius="2" BorderThickness="1" Background="{DynamicResource Col_Menubar_Sub_Background}" BorderBrush="{DynamicResource Col_Menubar_Sub_BorderBrush}">
                    <Grid Height="28" Background="#00FFFFFF">
                      <Grid>
                        <TextBlock Name="PART_Header" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource Col_Menubar_Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Text="{Lang:ResourceBinding Name}" />
                      </Grid>
                      <Rectangle Name="line" Height="1" Margin="5,0,5,0" Fill="{DynamicResource Col_Theme}" Opacity="1" VerticalAlignment="Bottom" />
                      <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDown">
                          <UIHelper:ParamsEventCommand Command="{Binding ItemClickCommand}" />
                        </i:EventTrigger>
                      </i:Interaction.Triggers>
                    </Grid>
                  </Border>
                  <Border CornerRadius="2" BorderThickness="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Popup.BorderBrush}">
                    <Rectangle Height="28" Margin="5,6,5,6" Fill="#FFFFFFFF" Opacity="0.1" VerticalAlignment="Center" StrokeThickness="2" />
                    <UIElement.Effect>
                      <DropShadowEffect BlurRadius="3" Direction="280" Opacity="0.09" ShadowDepth="2" Color="Orange" />
                    </UIElement.Effect>
                  </Border>
                </Grid>
              </StackPanel>
            </Popup>
          </Grid>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="RedoTemplate">
        <Button Margin="4,0,4,0" Height="36" Width="36" Command="{Binding ItemClickCommand}" ToolTip="{Lang:ResourceBinding Name}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonStyle}">
              <Setter Property="IsEnabled" Value="False" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding CustomItemData.CanRedo}" />
                    <Condition Value="False" Binding="{Binding CustomItemData.LockAreaStatus}" />
                    <Condition Value="False" Binding="{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}" />
                  </MultiDataTrigger.Conditions>
                  <MultiDataTrigger.Setters>
                    <Setter Property="IsEnabled" Value="True" />
                  </MultiDataTrigger.Setters>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="TitleToolButtonDataTemplate">
        <Button Margin="4,0,4,0" Height="36" Width="36" Command="{Binding ItemClickCommand}" ToolTip="{Lang:ResourceBinding Name}" Visibility="{Binding IsVisible, Converter={StaticResource boolToVisibilityCvt}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonStyle}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
              <EventSetter Event="Click" Handler="Button_Click" />
            </Style>
          </FrameworkElement.Style>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="customDataTemplate">
        <ContentPresenter Name="cp" Content="{Binding}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentPresenter}">
              <Setter Property="ContentTemplate" Value="{StaticResource TitleToolButtonDataTemplate}" />
              <Style.Triggers>
                <DataTrigger Value="SingleRunTemplate" Binding="{Binding CustomItemTemplateName}">
                  <Setter Property="ContentTemplate" Value="{StaticResource SingleRunTemplate}" />
                </DataTrigger>
                <DataTrigger Value="ContinousRunTemplate" Binding="{Binding CustomItemTemplateName}">
                  <Setter Property="ContentTemplate" Value="{StaticResource ContinousRunTemplate}" />
                </DataTrigger>
                <DataTrigger Value="DownPopTemplate" Binding="{Binding CustomItemTemplateName}">
                  <Setter Property="ContentTemplate" Value="{StaticResource DownPopTemplate}" />
                </DataTrigger>
                <DataTrigger Value="RedoTemplate" Binding="{Binding CustomItemTemplateName}">
                  <Setter Property="ContentTemplate" Value="{StaticResource RedoTemplate}" />
                </DataTrigger>
                <DataTrigger Value="LockingTemplate" Binding="{Binding CustomItemTemplateName}">
                  <Setter Property="ContentTemplate" Value="{StaticResource LockingTemplate}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ContentPresenter>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ItemsControl ItemsPanel="{StaticResource HorizontalItemsPanelTemplate}" ItemTemplate="{StaticResource customDataTemplate}" ItemsSource="{Binding Source={StaticResource src}}">
    <ItemsControl.GroupStyle>
      <GroupStyle ContainerStyle="{StaticResource ResourceKey=ToolButtonGroupItemStyle}" Panel="{StaticResource ResourceKey=HorizontalItemsPanelTemplate}" />
    </ItemsControl.GroupStyle>
  </ItemsControl>
</UserControl>