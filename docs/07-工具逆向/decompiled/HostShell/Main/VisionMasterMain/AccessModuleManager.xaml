<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.AccessModuleManager" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="source" WindowStartupLocation="CenterScreen" Title="{DynamicResource Lang_AccessModuleManager}" Height="420" Width="374" ShowInTaskbar="False" xmlns:visionmastermain="clr-namespace:VisionMasterMain;assembly=VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFE4E4E7" UseLayoutRounding="True">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <CollectionViewSource x:Key="infos" Source="{Binding ElementName=source, Path=Items}">
          <CollectionViewSource.GroupDescriptions>
            <PropertyGroupDescription PropertyName="Group" />
          </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <Grid Background="#F2F3F5">
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Lang_AccessModuleManagerLabel}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" FontSize="14" Foreground="#FF666666" />
      <CheckBox Name="all" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,10,0" Foreground="#FF666666" Content="{DynamicResource Lang_AccessModuleManagerCheckAll}" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked" />
      <ScrollViewer Grid.Row="2" Margin="5,10" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}" MaxHeight="280">
        <ItemsControl HorizontalAlignment="Stretch" ItemsSource="{Binding Source={StaticResource infos}}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <convert:LongTextConvert x:Key="LongTextConvert2" FontSize="14" MaxLen="80" FontFamily="Microsoft YaHei" />
              <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#FF666666" />
                <Setter Property="Width" Value="300" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="7,5" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="{x:Type GroupItem}">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                          </Grid.RowDefinitions>
                          <Border BorderBrush="#E0DFDE" BorderThickness="0,0,0,1">
                            <CheckBox MaxWidth="85" Content="{Binding Name, Converter={StaticResource LongTextConvert2}}" ToolTip="{Binding Name}" Click="ButtonBase_OnClick" Checked="Group_OnChecked" Unchecked="Group_OnUnchecked" Initialized="FrameworkElement_OnInitialized" />
                          </Border>
                          <ItemsPresenter Margin="10,5,10,10" Grid.Row="1" />
                        </Grid>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </ItemsControl.GroupStyle>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ItemsControl}">
              <Setter Property="ItemTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <CheckBox MaxWidth="100" Content="{Binding DisplayName, Converter={StaticResource LongTextConvert2}}" IsChecked="{Binding ConfigAvailable}" ToolTip="{Binding DisplayName}" Click="ButtonBase_OnClick" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" />
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </FrameworkElement.Style>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <Button Grid.Row="1" VerticalAlignment="Center" Content="{DynamicResource Lang_Sure}" HorizontalAlignment="Right" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="Button_Click" />
  </Grid>
</controls:BaseWindow>