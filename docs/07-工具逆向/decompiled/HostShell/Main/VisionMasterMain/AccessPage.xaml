<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VisionMasterMain.AccessPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="accessPage" Title="AccessPage" xmlns:visionmastermain="clr-namespace:VisionMasterMain;assembly=VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ScrollViewer Name="listParam" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="20,20,0,0" VerticalAlignment="Top">
      <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left">
        <StackPanel Name="accessTool" Orientation="Horizontal" Height="26" Margin="0,0,0,9">
          <Label Content="{DynamicResource Lang_AccessFun}" FontSize="14" Foreground="#FF4D4D4D" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto" />
          <Button Name="btnImportPermission" Content="{DynamicResource 导入}" Margin="46,0,0,0" Style="{DynamicResource BottomButtonStyle}" Click="ImportPermission_Click" />
          <Button Name="btnExportPermission" Content="{DynamicResource 导出}" Margin="30,0,0,0" Style="{DynamicResource BottomButtonStyle}" Click="ExportPermission_Click" />
        </StackPanel>
        <StackPanel Name="titleparam" Orientation="Horizontal" Height="32">
          <Label Content="{DynamicResource Lang_EnablePermissions}" FontSize="14" Foreground="#FF4D4D4D" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Label}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsChecked, ElementName=autoAccessEnable}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Label>
          <Label Content="{DynamicResource Lang_CancelPermissions}" FontSize="14" Foreground="#FF4D4D4D" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto" Visibility="{Binding ElementName=autoAccessEnable, Path=IsChecked, Converter={StaticResource bool2VisibilityConverter}}" />
          <ToggleButton Name="autoAccessEnable" Margin="20,0,0,0" Template="{StaticResource switchbutton}" Width="80" Click="autoAccessEnable_Click" />
        </StackPanel>
        <StackPanel Name="accessparam" Orientation="Vertical" Margin="28,9,0,0">
          <StackPanel Name="adminparam" Orientation="Horizontal" Height="26">
            <TextBlock Text="{DynamicResource Lang_EditPassword}" Width="88" Style="{DynamicResource TextBlockNormal}" />
            <Button Content="{DynamicResource Lang_Edit}" Margin="24,0,0,0" Style="{DynamicResource BottomButtonStyle}" Click="ReSetPassword_Click" />
          </StackPanel>
          <StackPanel Name="techparam" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Height="32" Margin="0,9,0,0">
              <TextBlock Text="{DynamicResource Lang_TechAuthority}" Width="88" Style="{DynamicResource TextBlockNormal}" />
              <ToggleButton Name="techEnable" Margin="4,0,0,0" Template="{StaticResource switchbutton}" Width="80" Checked="techEnable_Checked" Unchecked="techEnable_Unchecked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="32" Margin="0,6,0,0" Visibility="{Binding ElementName=tecEnable, Path=Visibility}">
              <TextBlock Text="{DynamicResource 技术员密码}" Width="88" Style="{DynamicResource TextBlockNormal}" />
              <Grid>
                <PasswordBox Name="techSetCode" Margin="24,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding ElementName=techCode, Path=IsEnabled}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                  <UIElement.CommandBindings>
                    <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                  </UIElement.CommandBindings>
                </PasswordBox>
                <TextBox Name="techCode" Margin="24,0,0,0" Style="{StaticResource textBoxStyle}" IsEnabled="False" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" Visibility="Collapsed" Text="{Binding ElementName=techSetCode, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                  <UIElement.CommandBindings>
                    <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                  </UIElement.CommandBindings>
                </TextBox>
              </Grid>
              <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessPage, Path=IfShowTechSetCode, Mode=TwoWay}" IsEnabled="{Binding ElementName=techCode, Path=IsEnabled}" />
            </StackPanel>
            <TextBlock Name="teckCodeTips" Text="{DynamicResource 密码格式不正确}" Margin="114,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
            <TextBlock FontSize="12" Height="Auto" MinHeight="50" MaxHeight="300" Margin="114,5,50,0" TextWrapping="Wrap" Foreground="#FF999999" Text="{DynamicResource Lang_TrainNote}" />
            <StackPanel Orientation="Horizontal" Height="26" Margin="0,9,0,0" Visibility="{Binding ElementName=tecEnable, Path=Visibility}">
              <TextBlock Text="{DynamicResource Lang_AccessModuleManager}" Width="88" Style="{DynamicResource TextBlockNormal}" />
              <Button Name="techAccessSet" Content="{DynamicResource Lang_SetCnfg}" Margin="24,0,0,0" Style="{DynamicResource BottomButtonStyle}" Click="Permission_Click" />
            </StackPanel>
          </StackPanel>
          <StackPanel Name="operatparam" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Height="32" Margin="0,9,0,0">
              <TextBlock Text="{DynamicResource Lang_OperAuthority}" Width="88" Style="{DynamicResource TextBlockNormal}" />
              <ToggleButton Name="operatorEnable" Margin="4,0,0,0" Template="{StaticResource switchbutton}" Width="80" Checked="operatorEnable_Checked" Unchecked="operatorEnable_Unchecked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="32" Margin="0,6,0,0">
              <TextBlock Text="{DynamicResource 操作员密码}" Width="88" Style="{DynamicResource TextBlockNormal}" />
              <Grid>
                <PasswordBox Name="operatorSetCode" Margin="24,0,0,0" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding ElementName=operatorCode, Path=IsEnabled}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                  <UIElement.CommandBindings>
                    <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                  </UIElement.CommandBindings>
                </PasswordBox>
                <TextBox Name="operatorCode" Margin="24,0,0,0" Style="{StaticResource textBoxStyle}" IsEnabled="False" Tag="{DynamicResource 请输入3~15位密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" Visibility="Collapsed" Text="{Binding ElementName=operatorSetCode, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                  <UIElement.CommandBindings>
                    <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                    <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                  </UIElement.CommandBindings>
                </TextBox>
              </Grid>
              <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessPage, Path=IfShowOperatorSetCode, Mode=TwoWay}" IsEnabled="{Binding ElementName=operatorCode, Path=IsEnabled}" />
            </StackPanel>
            <TextBlock Name="operatorCodeTips" Text="{DynamicResource 密码格式不正确}" Margin="114,0,0,0" Height="20" FontSize="12" Foreground="#FFFF1A1A" Visibility="Collapsed" />
            <TextBlock FontSize="12" MaxHeight="40" Margin="114,5,50,0" TextWrapping="Wrap" Foreground="#FF999999" Text="{DynamicResource Lang_OperatorNote}" />
            <StackPanel Orientation="Horizontal" Height="32" Margin="0,6,0,10">
              <TextBlock Text="{DynamicResource Lang_IsOperatorEnabled}" MinWidth="88" Style="{DynamicResource TextBlockNormal}" />
              <ToggleButton Name="isOperatorEnabled" Width="80" Margin="4,0,0,0" Template="{StaticResource switchbutton}" IsChecked="{Binding IsOperatorEnabled}" IsEnabled="{Binding ElementName=operatorCode, Path=IsEnabled}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>