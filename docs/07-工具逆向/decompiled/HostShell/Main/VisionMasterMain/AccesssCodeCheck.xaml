<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.AccesssCodeCheck" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="accessCodeCheckWindow" WindowStartupLocation="CenterScreen" Title="{DynamicResource 验证管理员密码}" Height="206" Width="370" BorderBrush="#FF161617" BorderThickness="1" MinButtonVisibility="Collapsed" ShowInTaskbar="False" xmlns:visionmastermain="clr-namespace:VisionMasterMain;assembly=VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFF2F3F5">
    <Grid.RowDefinitions>
      <RowDefinition Height="20" />
      <RowDefinition Height="52" />
      <RowDefinition Height="34" />
      <RowDefinition Height="22" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center" Text="{DynamicResource 请输入密码}" Margin="46,0,0,0" />
      <Grid>
        <PasswordBox Name="textCodeSet" Margin="20,0,0,0" Width="182" Height="32" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入密码}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
        <TextBox Name="textBoxCodeSet" Margin="20,0,0,0" Width="182" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" Tag="{DynamicResource 请输入密码}" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ElementName=textCodeSet, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
      </Grid>
      <ToggleButton Style="{StaticResource eyeToggleButton}" Width="40" Margin="-40,0,10,0" IsChecked="{Binding ElementName=accessCodeCheckWindow, Path=IfShowPassword, Mode=TwoWay}" />
    </StackPanel>
    <TextBlock Name="txtCodeErrorTips" Grid.Row="2" Margin="158,0,0,0" Text="{DynamicResource 密码输入错误}" Foreground="#FFFF1A1A" Visibility="Collapsed" />
    <TextBlock Name="txtCodeInfoTips" Grid.Row="2" Margin="158,0,0,0" Text="{DynamicResource Lang_LowToAdm}" Foreground="#FFFF1A1A" Visibility="Collapsed" />
    <Grid Background="#FFE4E4E7" Row="4" Height="32" VerticalAlignment="Bottom">
      <Button Grid.Row="4" Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Confirm}" HorizontalAlignment="Right" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="ApplyButtonClick" />
    </Grid>
  </Grid>
</controls:BaseWindow>