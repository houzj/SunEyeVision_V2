<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VisionMasterMain.CollectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VisionMasterMain.AppMainWindow.SoftwareSet" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" Title="CollectionPage" xmlns:visionmastermain="clr-namespace:VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF" Margin="20,20,18,0">
    <ScrollViewer VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,0,0,10">
        <TextBlock Text="{DynamicResource Tab_Image Saving Settings}" Style="{DynamicResource TextBlockBold}" />
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,12,0,0">
          <Label Content="{DynamicResource Lang_LargeImageSave}" Width="130" FontSize="14" Foreground="#FF4D4D4D" ToolTip="{DynamicResource Lang_LargeImageSave}" />
          <ToggleButton Name="SaveLargeSet" Width="48" Style="{StaticResource boolean}" IsChecked="{Binding IsLargeImageSave}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3" Visibility="{Binding ElementName=SaveLargeSet, Path=IsChecked, Converter={StaticResource bool2VisibilityConverter}}">
          <Label Content="{DynamicResource BigFileName}" Width="130" FontSize="14" Foreground="#FF4D4D4D" ToolTip="{DynamicResource BigFileName}" />
          <TextBox Name="loadPath" Margin="3,0,0,0" FontSize="14" Width="182" Text="{Binding LargeFilePath}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type TextBox}">
                <Border BorderBrush="#CCCDCD" Background="#FCFCFC" BorderThickness="1" CornerRadius="2">
                  <ScrollViewer Name="PART_ContentHost" Margin="4,4,30,4" VerticalAlignment="Stretch" BorderThickness="0" IsTabStop="False" />
                </Border>
              </ControlTemplate>
            </Control.Template>
          </TextBox>
          <Button Name="selPath" Width="30" Height="29" Margin="-32,0,0,0" VerticalAlignment="Center" Style="{StaticResource OpenFileButton}" Command="{Binding ClickCommand}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Lang_ImageSaveUsageScenario}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Lang_ImageSaveUsageScenarioText}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Lang_ImageSaveNotes}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Lang_ImageSaveNotesText1}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Lang_ImageSaveNotesText2}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Lang_ImageSaveNotesText3}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>