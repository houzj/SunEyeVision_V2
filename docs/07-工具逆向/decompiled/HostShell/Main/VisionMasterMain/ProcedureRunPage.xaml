<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VisionMasterMain.ProcedureRunPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:hikcontrols="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:PCImage="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localUI="clr-namespace:VisionMasterMain" Title="RunStrategyPage">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <localUI:BoolToHeightConvert x:Key="booltoHeigthConvert" />
      <localUI:IndexToHeightConvert x:Key="indextoVisibleConvert" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ListViewComboBoxStyle}" />
      <Style x:Key="LeftPlaceTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Name="ColumnDefinition0" />
                  <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Name="RowDefinition0" Height="Auto" />
                  <RowDefinition Name="RowDefinition1" Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer Tag="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}">
                  <Grid Column="0" Row="0">
                    <TabPanel Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" ZIndex="1" />
                    <TextBlock Text="{DynamicResource 流程列表}" Margin="12,21,0,0" FontSize="14" FontFamily="Microsoft YaHei" FontWeight="Bold" />
                  </Grid>
                </ScrollViewer>
                <Border Name="ContentPanel" BorderBrush="{TemplateBinding Control.BorderBrush}" Margin="{TemplateBinding FrameworkElement.Margin}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                  <ContentPresenter Name="PART_SelectedContentHost" ContentTemplate="{TemplateBinding TabControl.SelectedContentTemplate}" Content="{TemplateBinding TabControl.SelectedContent}" ContentStringFormat="{TemplateBinding TabControl.SelectedContentStringFormat}" ContentSource="SelectedContent" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="TabControl.TabStripPlacement" Value="Bottom">
                  <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="1" />
                  <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                  <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="Auto" />
                  <Setter TargetName="HeaderPanel" Property="Margin" Value="2,0,2,2" />
                </Trigger>
                <Trigger Property="TabControl.TabStripPlacement" Value="Left">
                  <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0" />
                  <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                  <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="Auto" />
                  <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="*" />
                  <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                  <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Margin" Value="0,41,0,0" />
                </Trigger>
                <Trigger Property="TabControl.TabStripPlacement" Value="Right">
                  <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="1" />
                  <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                  <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="*" />
                  <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="Auto" />
                  <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                  <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Margin" Value="0,2,2,2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ProcTab" TargetType="{x:Type TabItem}">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <hikcontrols:FouerColorBorder Name="Bd" Margin="2,0,4,0" CornerRadius="2" Width="107" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0,0,0,1" Padding="{TemplateBinding Control.Padding}">
                <Grid Height="32">
                  <ContentPresenter Name="PART_Header" VerticalAlignment="Center" HorizontalAlignment="Stretch" ContentSource="Header" />
                </Grid>
              </hikcontrols:FouerColorBorder>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#E2E0E0" />
                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="hikcontrols:FouerColorBorder.BottomBorderBrush" />
                  <Setter Property="Foreground" Value="#4D4D4D" />
                </Trigger>
                <Trigger SourceName="Bd" Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#E2E0E0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="40" />
      <RowDefinition Height="50" />
      <RowDefinition Height="20" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="135" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Label Name="labelOperationMode" Grid.Column="0" Grid.Row="0" Margin="12,15,5,5" Content="{DynamicResource RunParam_Operating Mode}" HorizontalAlignment="Left" Height="32" VerticalAlignment="Center" Width="126" FontSize="14" />
    <ComboBox Name="ComboBoxOperationMode" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Height="32" VerticalAlignment="Center" Width="182" Margin="0,10,0,0" SelectedIndex="{Binding RunningModeIndex}" ItemsSource="{Binding OperationModeOptions}" />
    <TextBlock Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Foreground="#FF808080" VerticalAlignment="Center" TextWrapping="Wrap">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="0" Binding="{Binding ElementName=ComboBoxOperationMode, Path=SelectedIndex}">
              <Setter Property="Text" Value="{DynamicResource Lang_NormalModeTip}" />
            </DataTrigger>
            <DataTrigger Value="1" Binding="{Binding ElementName=ComboBoxOperationMode, Path=SelectedIndex}">
              <Setter Property="Text" Value="{DynamicResource Lang_DiagnosticModeTip}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Label Name="labelChooseProcrunPolicy" Grid.Column="0" Grid.Row="2" Margin="12,10,5,10" Content="{DynamicResource 策略模式}" HorizontalAlignment="Left" Height="32" VerticalAlignment="Center" Width="114" FontSize="14" />
    <ComboBox Name="ComboBoxProcrunPolicy" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Height="32" VerticalAlignment="Center" Width="182" SelectedIndex="{Binding RunStrategyIndex}" ItemsSource="{Binding RunPolicyOptions}" />
    <TextBlock Grid.Column="1" Grid.Row="3" Height="40" HorizontalAlignment="Left" Foreground="#FF808080" VerticalAlignment="Center" Text="{DynamicResource Lang_StablityPolicyTip}" TextWrapping="Wrap" Margin="0,0,0,-20" Visibility="{Binding ElementName=ComboBoxProcrunPolicy, Path=SelectedIndex, Converter={StaticResource indextoVisibleConvert}}" />
    <TextBlock Grid.Column="1" Grid.Row="3" Height="40" HorizontalAlignment="Left" Foreground="#FF808080" VerticalAlignment="Center" Text="{DynamicResource Lang_DefaultPolicyTip}" TextWrapping="Wrap" Margin="0,0,0,-20">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="0" Binding="{Binding ElementName=ComboBoxProcrunPolicy, Path=SelectedIndex}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Value="1" Binding="{Binding ElementName=ComboBoxProcrunPolicy, Path=SelectedIndex}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="2" Binding="{Binding ElementName=ComboBoxProcrunPolicy, Path=SelectedIndex}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Border Name="bdRunProc" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Background="#FFFFFFFF" Margin="18,0,18,18" BorderBrush="#E0DFDE" BorderThickness="1" Visibility="{Binding RunStrategyEnable, Converter={StaticResource bool2VisibilityConverter}}">
      <TabControl BorderBrush="#E0DFDE" Background="#FFFFFFFF" BorderThickness="1,0,0,0" TabStripPlacement="Left" ItemContainerStyle="{StaticResource ProcTab}" Style="{StaticResource LeftPlaceTabControlStyle}" ItemsSource="{Binding ProcedureRunPolicyList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Name="headText" Margin="-5,0,0,0" Foreground="#FF666666" TextAlignment="Center" FontSize="14" VerticalAlignment="Center" Text="{Binding strDisplayName}" ToolTip="{Binding strDisplayName}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0" Grid.Row="0" Margin="18,0,0,-3" Content="{DynamicResource 线程配置}" ToolTip="{DynamicResource 线程配置说明}" HorizontalAlignment="Left" Height="32" VerticalAlignment="Bottom" Width="105" FontSize="14" FontFamily="Microsoft YaHei" />
              <PCImage:SliderArrange Grid.Column="1" Margin="0,5,0,0" Grid.Row="0" Width="156" FontSize="14" HorizontalAlignment="Left" SliderTickFrequency="1" FontFamily="MircosoftYaHei" Minimum="1" Maximum="64" StartValue="{Binding RunStrategyThreadNum, Mode=TwoWay}" />
              <Label Grid.Column="0" Grid.Row="1" Margin="18,0,0,-3" Content="{DynamicResource CPU配置}" HorizontalAlignment="Left" Height="32" VerticalAlignment="Bottom" Width="90" FontSize="14" FontFamily="Microsoft YaHei" />
              <ScrollViewer Style="{StaticResource RecScrollViewer}" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Tag="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                <ItemsControl ItemsSource="{Binding RunStrategyCpus}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="1">
                        <Grid Height="32">
                          <StackPanel Orientation="Horizontal">
                            <CheckBox Margin="7,0,0,0" Style="{DynamicResource CheckBoxStyle1}" VerticalAlignment="Center" HorizontalAlignment="Left" IsChecked="{Binding IsRelated, Mode=TwoWay}" />
                            <TextBlock Margin="4,0,0,0" Width="45" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Microsoft YaHei" Foreground="#666666" FontSize="14" Text="{Binding Name}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Border>
  </Grid>
</Page>