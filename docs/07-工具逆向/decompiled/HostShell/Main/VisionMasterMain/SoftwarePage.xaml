<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VisionMasterMain.SoftwarePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VisionMaster.AppMainWindow" xmlns:localcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:tools="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:user="clr-namespace:VM.User;assembly=VM.User" xmlns:localConverter="clr-namespace:VisionMasterMain.Converter" x:Name="basepage" Title="SoftwarePage" xmlns:visionmastermain="clr-namespace:VisionMasterMain" Loaded="basepage_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/RadioButtonStyle/RadioButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ExpanderStyle/ExpanderStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ListViewComboBoxStyle}" />
      <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NormalRadioButton}" />
      <Style x:Key="accessPanelStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True" Binding="{Binding ElementName=autoLoadEnable, Path=IsChecked}" />
              <Condition Value="True" Binding="{Binding IsAccessEnable, Source={x:Static user:CodeManager.Instance}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <localConverter:MultiBindingConverter x:Key="multiBindingConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ScrollViewer Name="listParam" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="20,20,0,0" VerticalAlignment="Stretch">
      <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,0,0,10">
        <TextBlock Text="{DynamicResource Lang_LoadSet}" Margin="0,3" Width="200" Style="{DynamicResource TextBlockBold}" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 开机软件自启动}" Width="110" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="autoStartEnable" Grid.Row="1" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding AutoStartEnable}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3" Visibility="{Binding ElementName=autoStartEnable, Path=IsChecked, Converter={StaticResource bool2VisibilityConverter}}">
          <Label Content="{DynamicResource 延时启动}" Width="110" FontSize="14" Margin="18,0,0,0" Foreground="#FF666666" />
          <localcontrol:SliderArrange Name="delayTime" Width="145" FontSize="14" Margin="12,0,0,0" SliderTickFrequency="1" Minimum="0" Maximum="1000" StartValue="{Binding DelayTime, Mode=TwoWay}" />
          <Label Content="{DynamicResource 秒}" Width="auto" FontSize="14" Margin="0,0,0,0" Foreground="#FF666666" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource Lang_CloseSoftware}" MinWidth="110" Width="auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="closeSoftewarePassword" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding CloseSoftwarePasswordEnabled}" Command="{Binding CloseSoftewarePasswordCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 隐藏欢迎页}" MinWidth="110" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="hideGuideWindowEnable" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding HideGuideWindow}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 启动时最大化}" MinWidth="110" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="isMaximumWhenStartUp" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding IsMaxWhenStartUp}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 启动时全屏}" MinWidth="110" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="isFullScreenWhenStartUp" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding IsFullScreenWhenStartUp}" />
        </StackPanel>
        <StackPanel Name="FrontendFirstSP" Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 默认运行界面}" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="FrontendFirst" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding IsFronted}" />
        </StackPanel>
        <StackPanel Name="IsMaximizedWhenFrontendIndependentlySP" Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource IsMaximizedWhenFrontendIndependently}" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" ToolTip="{DynamicResource IsMaximizedWhenFrontendIndependently}" />
          <ToggleButton Name="IsMaximizedWhenFrontendIndependently" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding IsMaximizedWhenFrontendIndependently}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource 自动加载指定方案}" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="autoLoadEnable" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding IsAutoLoad}" />
          <Label Content="{DynamicResource 自动加载最近打开方案}" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <ToggleButton Name="autoLoadLastEnable" Margin="-9,0,0,0" Template="{StaticResource switchbutton}" Width="80" IsChecked="{Binding IsAutoLoadLast}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <UIElement.Visibility>
            <MultiBinding Converter="{StaticResource multiBindingConverter}">
              <Binding ElementName="autoLoadEnable" Path="IsChecked" Converter="{StaticResource bool2VisibilityConverter}" />
            </MultiBinding>
          </UIElement.Visibility>
          <Label Content="{DynamicResource 载入路径}" Width="110" FontSize="14" Margin="18,0,0,0" Foreground="#FF666666" />
          <TextBox Name="loadPath" Margin="12,0,0,0" FontSize="14" Width="182" IsReadOnly="True" Text="{Binding SolPath}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type TextBox}">
                <Border BorderBrush="#CCCDCD" Background="#FCFCFC" BorderThickness="1" CornerRadius="2">
                  <ScrollViewer Name="PART_ContentHost" Margin="4,4,30,4" VerticalAlignment="Stretch" BorderThickness="0" IsTabStop="False" />
                </Border>
              </ControlTemplate>
            </Control.Template>
          </TextBox>
          <Button Name="selPath" Width="30" Height="29" Margin="-32,0,0,0" VerticalAlignment="Center" Style="{StaticResource OpenFileButton}" Command="{Binding PathSelectCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <UIElement.Visibility>
            <MultiBinding Converter="{StaticResource multiBindingConverter}">
              <Binding ElementName="autoLoadEnable" Path="IsChecked" Converter="{StaticResource bool2VisibilityConverter}" />
            </MultiBinding>
          </UIElement.Visibility>
          <Label Content="{DynamicResource Lang_SolutionPassword}" Width="110" FontSize="14" Margin="18,0,0,0" Foreground="#FF666666" />
          <Grid Height="32" Width="200">
            <Grid>
              <PasswordBox Name="solCodeBox" Margin="12,0,0,0" IsEnabled="True" Width="182" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入密码}" tools:PasswordBoxBindingHelper.Attach="True" input:InputMethod.IsInputMethodEnabled="False" tools:PasswordBoxBindingHelper.Password="{Binding Path=SolPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                <UIElement.CommandBindings>
                  <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                  <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                  <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                </UIElement.CommandBindings>
              </PasswordBox>
              <TextBox Name="solCodeText" Margin="12,0,0,0" Style="{StaticResource textBoxStyle}" IsEnabled="True" Tag="{DynamicResource 请输入密码}" Width="182" input:InputMethod.IsInputMethodEnabled="False" Visibility="Collapsed" Text="{Binding SolPassword, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                <UIElement.CommandBindings>
                  <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                  <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                  <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                </UIElement.CommandBindings>
              </TextBox>
            </Grid>
          </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <UIElement.Visibility>
            <MultiBinding Converter="{StaticResource multiBindingConverter}">
              <Binding ElementName="autoLoadEnable" Path="IsChecked" Converter="{StaticResource bool2VisibilityConverter}" />
              <Binding ElementName="autoLoadLastEnable" Path="IsChecked" Converter="{StaticResource bool2VisibilityConverter}" />
            </MultiBinding>
          </UIElement.Visibility>
          <Label Content="{DynamicResource 启动状态}" Width="110" FontSize="14" Margin="18,0,0,0" Foreground="#FF666666" />
          <ComboBox Name="runState" Margin="12,0,0,0" Width="182" SelectedIndex="{Binding RunState}" ItemsSource="{Binding RunStateOptions}" />
        </StackPanel>
        <StackPanel Name="accessPanel" Orientation="Horizontal" Height="32" Margin="0,3" Style="{StaticResource accessPanelStyle}">
          <Label Content="{DynamicResource 选择身份}" Width="110" FontSize="14" Margin="18,0,0,0" Foreground="#FF666666" />
          <ComboBox Name="access" Margin="12,0,0,0" Width="182" DisplayMemberPath="UserDisPlayName" SelectedValuePath="UserName" ItemsSource="{Binding AccessItems}" SelectedValue="{Binding SelectedAccessValue, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Name="accessText" FontSize="12" Height="30" Margin="18,0,0,0" TextWrapping="Wrap" Foreground="#FF999999" Text="{DynamicResource Lang_IDtip}" Visibility="{Binding Path=Visibility, ElementName=accessPanel}" />
        <Border Width="482px" Height="1px" BorderBrush="#E0DFDE" Background="#E0DFDE" VerticalAlignment="Top" Margin="0,3" />
        <TextBlock Text="{DynamicResource Lang_UnRedoSetting}" Style="{DynamicResource TextBlockBold}" Margin="0,3" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource Lang_CacheStepSetting}" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <localcontrol:SliderArrange Name="UnRedoStepSize" Width="145" FontSize="14" Margin="12,0,0,0" SliderTickFrequency="1" Minimum="0" Maximum="15" StartValue="{Binding UnRedoStep, Mode=TwoWay}" />
        </StackPanel>
        <Border Width="482px" Height="1px" BorderBrush="#E0DFDE" Background="#E0DFDE" VerticalAlignment="Top" Margin="0,3" />
        <TextBlock Text="{DynamicResource Lang_AutoConnectSpanSetting}" Style="{DynamicResource TextBlockBold}" Margin="0,3" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Height="32" Margin="0,3">
          <Label Content="{DynamicResource ModuleConnectSpan}" Width="Auto" FontSize="14" Margin="18,0,0,0" Foreground="#FF4D4D4D" />
          <localcontrol:SliderArrange Name="MoudleSpanSize" Width="145" FontSize="14" Margin="12,0,0,0" SliderTickFrequency="1" Minimum="0" Maximum="80" StartValue="{Binding ModuleSpan, Mode=TwoWay}" />
        </StackPanel>
        <Border Width="482px" Height="1px" BorderBrush="#E0DFDE" Background="#E0DFDE" VerticalAlignment="Top" Margin="0,3" />
        <Expander Style="{DynamicResource ExpanderStyle1}">
          <HeaderedContentControl.Header>
            <TextBlock Text="{DynamicResource 高级设置}" Style="{DynamicResource TextBlockBold}" Margin="0,3" VerticalAlignment="Top" HorizontalAlignment="Left" />
          </HeaderedContentControl.Header>
          <tools:ContainerFidScroller Name="paramSearchUI" Background="#00FFFFFF" Margin="5,0,150,0" ItemsSource="{Binding AdvanceSetting}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>