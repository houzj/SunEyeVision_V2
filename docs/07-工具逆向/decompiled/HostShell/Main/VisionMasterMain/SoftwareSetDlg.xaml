<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.SoftwareSetDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="softwareSetDlg" Title="{DynamicResource Lang_Set}" Height="448" Width="700" xmlns:visionmastermain="clr-namespace:VisionMasterMain;assembly=VisionMasterMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SetTypeRBtn" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="#E3E4E6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iborder" Background="#00FFFFFF">
                <TextBlock Name="itext" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" FontSize="14px" Text="{TemplateBinding ContentControl.Content}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iborder" Property="Border.Background" Value="#F2F3F5" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="iborder" Property="Border.Background" Value="#F2F3F5" />
                  <Setter TargetName="itext" Property="TextBlock.FontWeight" Value="Bold" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <controls:BaseWindow.TitleBar>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Foreground="{DynamicResource Col_SubForm_HeaderBrush_Foreground}" Text="{DynamicResource Lang_Set}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" FontWeight="Bold" />
      <Button Margin="8,0" ToolTip="{DynamicResource Lang_Help}" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ElementName=softwareSetDlg, Path=OpenHelpCommand}">
        <ContentControl.Content>
          <Image Name="img" Width="14" Height="14" Stretch="Uniform" Source="/Apps.Style;component/Resources/btn_help.png" />
        </ContentControl.Content>
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="border" Width="30" Height="26" Background="#00FFFFFF" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Value="{DynamicResource Col_Menubar_Shortcut_Selected_Background}" Property="Border.Background" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
    </StackPanel>
  </controls:BaseWindow.TitleBar>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Background="#E3E4E6">
        <RadioButton Name="rbt_accessset" Content="{DynamicResource 权限设置}" Style="{StaticResource SetTypeRBtn}" Click="SetType_Click" />
        <RadioButton Name="rbt_vmset" Content="{DynamicResource 软件设置}" Style="{StaticResource SetTypeRBtn}" Click="SetType_Click" />
        <RadioButton Name="rbt_solset" Content="{DynamicResource 方案设置}" Style="{StaticResource SetTypeRBtn}" Click="SetType_Click" />
        <RadioButton Name="rbt_runstragety" Content="{DynamicResource 运行策略}" Style="{StaticResource SetTypeRBtn}" Click="SetType_Click" />
        <RadioButton Name="rbt_collectionstragety" Content="{DynamicResource 采集策略}" Style="{StaticResource SetTypeRBtn}" Click="SetType_Click" />
      </StackPanel>
      <Grid Column="1" Background="#F2F3F5">
        <ContentControl Name="setpagechage" />
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#E4E5E7" BorderThickness="1" BorderBrush="#B8B6B6">
      <Button Content="{DynamicResource Confirm}" VerticalAlignment="Center" HorizontalAlignment="Right" Width="64" Height="24" Margin="0,0,13,0" Style="{DynamicResource Orange_ButtonStyle}" Click="Apply_OnClick" />
    </Border>
  </Grid>
</controls:BaseWindow>