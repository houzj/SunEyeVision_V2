<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VisionMasterMain.SolPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:tools="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:localcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:convert="clr-namespace:VisionMasterMain" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:VMControlsWPF="clr-namespace:VMControls.WPF.GlobalUI;assembly=VMControls.WPF" x:Name="solPage">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate DataType="VMControlsWPF:GlobalVariableItem">
              <Grid Height="38px">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="VerticalContentAlignment" Value="Center" />
                      <Setter Property="HorizontalAlignment" Value="Left" />
                      <Setter Property="HorizontalContentAlignment" Value="Left" />
                      <Setter Property="FontSize" Value="14px" />
                      <Setter Property="FontFamily" Value="Microsoft YaHei" />
                      <Setter Property="Height" Value="32" />
                      <Setter Property="Foreground" Value="#808080" />
                      <Setter Property="Background" Value="#FCFCFC" />
                      <Setter Property="BorderBrush" Value="#CCCCCD" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="Padding" Value="6,0,0,0" />
                      <Setter Property="UIElement.AllowDrop" Value="True" />
                      <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                      <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
                      <Setter Property="input:Stylus.IsFlicksEnabled" Value="False" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" CornerRadius="2">
                              <themes:ListBoxChrome Background="#00FFFFFF" BorderThickness="0" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderFocused="{TemplateBinding UIElement.IsKeyboardFocusWithin}" UIElement.SnapsToDevicePixels="True">
                                <ScrollViewer Name="PART_ContentHost" Background="#00FFFFFF" BorderThickness="0" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                              </themes:ListBoxChrome>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                                <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                              </Trigger>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                              </Trigger>
                              <Trigger Property="UIElement.IsFocused" Value="True">
                                <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <MultiTrigger>
                          <MultiTrigger.Conditions>
                            <Condition Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="True" />
                            <Condition Property="TextBoxBase.IsSelectionActive" Value="False" />
                          </MultiTrigger.Conditions>
                          <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                        </MultiTrigger>
                      </Style.Triggers>
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <Grid.RowDefinitions>
                  <RowDefinition Height="32px" />
                  <RowDefinition Height="8px" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="158" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="95" />
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="34" FontSize="14" FontFamily="Microsoft YaHei" Text="{Binding Index}" />
                <Grid Column="1" Row="0" Margin="0,0,8,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox MinWidth="120" Padding="0" BorderThickness="0" VerticalAlignment="Center" Text="{Binding SolPath}" ToolTip="{Binding SolPath}" />
                  <Button Width="30" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource OpenFileButton}" Command="{Binding PathSelectCommand}" />
                  <Border BorderThickness="1" CornerRadius="2" BorderBrush="#CCCCCD" Grid.Column="0" Grid.ColumnSpan="2" />
                </Grid>
                <Grid Height="32" Width="80" Column="2" Row="0">
                  <Grid HorizontalAlignment="Left">
                    <PasswordBox Name="solCodeBox" Margin="-12,0,0,0" IsEnabled="True" Width="80" tools:PasswordBoxBindingHelper.Attach="True" input:InputMethod.IsInputMethodEnabled="False" Style="{StaticResource textCodeBoxStyle}" tools:PasswordBoxBindingHelper.Password="{Binding Path=SolPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SolCodeBoxShow, Converter={StaticResource bool2VisibilityConverter}}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                      <UIElement.CommandBindings>
                        <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                      </UIElement.CommandBindings>
                    </PasswordBox>
                    <TextBox Name="solCodeText" Margin="-12,0,0,0" IsEnabled="True" Tag="{DynamicResource SubWindowPassword}" Width="80" input:InputMethod.IsInputMethodEnabled="False" Style="{StaticResource textBoxStyle}" Text="{Binding SolPassword, Mode=TwoWay}" Visibility="{Binding SolCodeTextShow, Converter={StaticResource bool2VisibilityConverter}}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                      <UIElement.CommandBindings>
                        <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                      </UIElement.CommandBindings>
                    </TextBox>
                  </Grid>
                </Grid>
                <TextBox Grid.Column="3" Grid.Row="0" Width="88" Text="{Binding CommString}" />
                <ToggleButton Grid.Column="4" Grid.Row="0" Width="48" Style="{StaticResource boolean}" IsChecked="{Binding CommEnable}" />
                <Button Grid.Column="5" Grid.Row="0" VerticalAlignment="Center" Style="{StaticResource delete}" Command="{Binding DeleteCommand}" />
              </Grid>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF" Margin="20,20,0,0">
    <ScrollViewer VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Orientation="Vertical" Margin="0 0 0 10">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="{DynamicResource Lang_SolSet}" Style="{DynamicResource TextBlockBold}" />
          <TextBlock Text="{DynamicResource Lang_SolSetTip}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Number}" Width="62px" Style="{DynamicResource TextBlockBold}" />
            <TextBlock Text="{DynamicResource Lang_SolutionPath}" Width="158px" Style="{DynamicResource TextBlockBold}" />
            <TextBlock Text="{DynamicResource Lang_SolutionPassword}" Width="90px" Style="{DynamicResource TextBlockBold}" />
            <TextBlock Text="{DynamicResource Lang_SolutionCommString}" Width="95px" Style="{DynamicResource TextBlockBold}" />
            <TextBlock Text="{DynamicResource Lang_SolCommChangeEnable}" Width="78px" Style="{DynamicResource TextBlockBold}" />
          </StackPanel>
          <StackPanel Orientation="Vertical" Margin="0,10,0,0" MinHeight="64">
            <ItemsControl ItemsSource="{Binding Path=SolItems}" />
            <Button Style="{StaticResource AddBtnStyle}" Margin="0,0,6,0" HorizontalAlignment="Left" Command="{Binding AddCommand}" />
          </StackPanel>
        </StackPanel>
        <Border Height="1" HorizontalAlignment="Stretch" Background="#E0DFDE" />
        <StackPanel Orientation="Vertical" Margin="0,12,0,0">
          <TextBlock Text="{DynamicResource Lang_CallbackSet}" Style="{DynamicResource TextBlockBold}" />
          <TextBlock Text="{DynamicResource Lang_CallBackSetTip}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" VerticalAlignment="Top" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Lang_CallbackSet}" Width="86" Style="{DynamicResource TextBlockNormal}" />
            <Button Content="{DynamicResource Lang_AllOpen}" HorizontalAlignment="Left" Style="{DynamicResource BottomButtonStyle}" Command="{Binding SetResultBackCommand}" />
          </StackPanel>
        </StackPanel>
        <Border Height="1" HorizontalAlignment="Stretch" Background="#E0DFDE" />
        <StackPanel Orientation="Vertical" Margin="0,12,0,0">
          <TextBlock Text="{DynamicResource Lang_AutoSaveSet}" Style="{DynamicResource TextBlockBold}" />
          <TextBlock Text="{DynamicResource Lang_AutoSaveSetTip}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" VerticalAlignment="Top" MaxWidth="470" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Lang_AutoSaveRunParam}" Width="160" Style="{DynamicResource TextBlockNormal}" />
            <ToggleButton Name="autoSave" Width="48" Style="{StaticResource boolean}" IsChecked="{Binding SaveSolTimerEnable}" />
          </StackPanel>
          <TextBlock Text="{DynamicResource Lang_AutoSaveAllSet}" Style="{DynamicResource TextBlockBold}" />
          <TextBlock Text="{DynamicResource Lang_AutoSaveAllSetTip}" Margin="0,10,0,0" Style="{DynamicResource TextBlockNormal}" VerticalAlignment="Top" MaxWidth="470" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Lang_AutoSaveSolution}" Width="160" Style="{DynamicResource TextBlockNormal}" />
            <ToggleButton Name="autoSaveAll" Width="48" Style="{StaticResource boolean}" IsChecked="{Binding SaveAllSolTimerEnable}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Height="32" Margin="0,12,0,0" Visibility="{Binding ElementName=autoSaveAll, Path=IsChecked, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{DynamicResource Lang_AutoSaveSetTime}" Width="Auto" Margin="0,0,5,0" Style="{DynamicResource TextBlockNormal}" />
            <localcontrol:SliderArrange Name="autoSaveTime" Width="145" FontSize="14" SliderTickFrequency="1" Minimum="3" Maximum="60" StartValue="{Binding AutoSaveTime, Mode=TwoWay}" />
            <TextBlock Text="{DynamicResource Lang_Minutes}" Width="50" Margin="5,0,0,0" Style="{DynamicResource TextBlockNormal}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>