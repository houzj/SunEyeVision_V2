<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="VisionMasterMain.SolutionManagerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:VMControlsWPF="clr-namespace:VMControls.WPF.GlobalUI;assembly=VMControls.WPF" xmlns:tools="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" x:Name="source" Title="{DynamicResource Lang_SolSet}" Height="448" Width="680" xmlns:visionmastermain="clr-namespace:VisionMasterMain;assembly=VisionMasterMain">
  <Grid Background="#F2F3F5">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
          <ResourceDictionary Source="/VisionMasterMain;component/AppMainWindow/SoftwareSet/Styles/SolControlStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
          <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
          <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
          <Setter Property="ItemsPanel">
            <Setter.Value>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ItemTemplate">
            <Setter.Value>
              <DataTemplate DataType="VMControlsWPF:GlobalVariableItem">
                <Grid Margin="0,0,0,6">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="FontSize" Value="14px" />
                        <Setter Property="FontFamily" Value="Microsoft YaHei" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Foreground" Value="#808080" />
                        <Setter Property="Background" Value="#FCFCFC" />
                        <Setter Property="BorderBrush" Value="#CCCCCD" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="6,0,0,0" />
                        <Setter Property="UIElement.AllowDrop" Value="True" />
                        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
                        <Setter Property="input:Stylus.IsFlicksEnabled" Value="False" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" CornerRadius="2">
                                <themes:ListBoxChrome Background="#00FFFFFF" BorderThickness="0" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderFocused="{TemplateBinding UIElement.IsKeyboardFocusWithin}" UIElement.SnapsToDevicePixels="True">
                                  <ScrollViewer Name="PART_ContentHost" Background="#00FFFFFF" BorderThickness="0" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                                </themes:ListBoxChrome>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                                </Trigger>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                                </Trigger>
                                <Trigger Property="UIElement.IsFocused" Value="True">
                                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="True" />
                              <Condition Property="TextBoxBase.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                          </MultiTrigger>
                        </Style.Triggers>
                      </Style>
                      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
                        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                        <Setter Property="Foreground" Value="#808080" />
                        <Setter Property="BorderBrush" Value="#CCCCCC" />
                        <Setter Property="Background" Value="#FCFCFC" />
                        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
                        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="ItemContainerStyle">
                          <Setter.Value>
                            <Style TargetType="{x:Type ComboBoxItem}">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                                      <Grid>
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="10" />
                                          <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                                      </Trigger>
                                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                                        <Setter Property="Foreground" Value="#4D4D4D" />
                                      </Trigger>
                                      <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                                        <Setter TargetName="Back" Property="Border.Background" Value="#FFDDE6F2" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBox}">
                              <Grid Background="{TemplateBinding Control.Background}">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                  <Grid>
                                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                                      <Border.Background>
                                        <LinearGradientBrush>
                                          <GradientStop Offset="0.0" Color="#FCFCFC" />
                                          <GradientStop Offset="0.15" Color="#FCFCFC" />
                                          <GradientStop Offset="1" Color="#F7F7F7" />
                                        </LinearGradientBrush>
                                      </Border.Background>
                                      <UIElement.Effect>
                                        <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                                      </UIElement.Effect>
                                      <UIElement.RenderTransform>
                                        <TranslateTransform X="-4" />
                                      </UIElement.RenderTransform>
                                      <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" input:KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                                      </ScrollViewer>
                                    </Border>
                                  </Grid>
                                </Popup>
                                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Grid Column="0" Margin="11,0,0,0">
                                  <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                                  <ContentPresenter />
                                </Grid>
                                <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                                </Trigger>
                                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                                </DataTrigger>
                                <Trigger Property="ComboBox.IsEditable" Value="True">
                                  <Setter Property="IsTabStop" Value="False" />
                                  <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="15" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Width="40" Grid.Column="0" FontSize="14" FontFamily="Microsoft YaHei" Text="{Binding Index}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="230" Grid.Column="1" Text="{Binding SolPath}" />
                    <Button Width="32" Height="32" Margin="0,0,0,0" VerticalAlignment="Top" Style="{StaticResource OpenFileButton}" Command="{Binding PathSelectCommand}" />
                  </StackPanel>
                  <Grid Column="2">
                    <PasswordBox Width="86" tools:PasswordBoxBindingHelper.Attach="True" input:InputMethod.IsInputMethodEnabled="False" Style="{StaticResource textCodeBoxStyle}" tools:PasswordBoxBindingHelper.Password="{Binding Path=SolPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SolCodeBoxShow, Converter={StaticResource bool2VisibilityConverter}}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                      <UIElement.CommandBindings>
                        <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                      </UIElement.CommandBindings>
                    </PasswordBox>
                    <TextBox Tag="{DynamicResource SubWindowPassword}" Width="86" input:InputMethod.IsInputMethodEnabled="False" Style="{StaticResource textBoxStyle}" Text="{Binding SolPassword, Mode=TwoWay}" Visibility="{Binding SolCodeTextShow, Converter={StaticResource bool2VisibilityConverter}}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
                      <UIElement.CommandBindings>
                        <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute" />
                        <input:CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute" />
                      </UIElement.CommandBindings>
                    </TextBox>
                  </Grid>
                  <TextBox Width="120" Grid.Column="3" MaxLength="100" Text="{Binding CommString}" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource booleanToggleButton}" IsChecked="{Binding CommEnable}" />
                    <Button Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource deleteButton}" Command="{Binding DeleteCommand}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Margin="18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="41" />
        <RowDefinition Height="38" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Border BorderBrush="#E0DFDE" BorderThickness="0,0,0,1">
        <TextBlock FontSize="12px" FontFamily="Microsoft YaHei" Foreground="#999999" Text="{DynamicResource Lang_SolutionManagerLable}" VerticalAlignment="Center" HorizontalAlignment="Left" />
      </Border>
      <Grid Row="1">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
              <Setter Property="HorizontalAlignment" Value="Left" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="FontFamily" Value="Microsoft YaHei" />
              <Setter Property="Foreground" Value="#4C4C4C" />
              <Setter Property="FontSize" Value="14px" />
              <Setter Property="FontWeight" Value="Bold" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4*" />
          <ColumnDefinition Width="20*" />
          <ColumnDefinition Width="8*" />
          <ColumnDefinition Width="10*" />
          <ColumnDefinition Width="6*" />
          <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Number}" />
        <TextBlock Grid.Column="1" Text="{DynamicResource Lang_SolutionPath}" />
        <TextBlock Grid.Column="2" Text="{DynamicResource Lang_SolutionPassword}" Margin="8 0 0 0" />
        <TextBlock Grid.Column="3" Text="{DynamicResource Lang_SolutionCommString}" />
        <TextBlock Grid.Column="4" Text="{DynamicResource Lang_SolCommChangeEnable}" />
      </Grid>
      <StackPanel Orientation="Vertical" Grid.Row="2" VerticalAlignment="Top">
        <ScrollViewer Name="ScrollViewer" MaxHeight="266" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Path=SolItems}" />
        </ScrollViewer>
        <Button Style="{StaticResource AddBtnStyle}" Margin="0,0,6,0" HorizontalAlignment="Left" Command="{Binding AddCommand}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#E4E5E7">
      <Button HorizontalAlignment="Right" Style="{StaticResource BottomButtonStyle}" Width="66" Height="24" Margin="0,0,15,0" Content="{DynamicResource Confirm}" Click="Apply_OnClick" />
    </Border>
  </Grid>
</controls:BaseWindow>