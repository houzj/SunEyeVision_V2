<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="OpenFileButton" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border BorderBrush="#B8B6B6" CornerRadius="2">
            <Image Name="icon" Height="32" Width="32" Source="/Apps.Style;component/Resources/ic_文件路径_normal.png" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_文件路径_hover.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="delete" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Image Name="Image" Source="/Apps.Style;component/Resources/delete_normal.png" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.Style;component/Resources/delete_click.png" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.Style;component/Resources/delete_click.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="boolean" TargetType="{x:Type ToggleButton}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Image Name="Image" Source="/Apps.Style;component/Resources/swith_off.png" />
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.Style;component/Resources/swith_on.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="switchbutton" TargetType="{x:Type ToggleButton}">
    <Image Name="icon" Source="/Apps.Style;component/Resources/swith_off.png" Stretch="None" />
    <ControlTemplate.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/swith_on.png" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="TextBlockBold" TargetType="{x:Type TextBlock}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Foreground" Value="{DynamicResource ModuleForeground}" />
    <Setter Property="FontSize" Value="14px" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="TextBlockNormal" TargetType="{x:Type TextBlock}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Foreground" Value="{DynamicResource WinAreaColor}" />
    <Setter Property="FontSize" Value="12px" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style x:Key="textBoxStyleSol" TargetType="{x:Type TextBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="TextBox.MaxLength" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="FrameworkElement.ContextMenu">
      <Setter.Value>
        <controls:HikContextMenu>
          <MenuItem Command="Cut" />
          <MenuItem Command="Copy" />
          <MenuItem Command="Paste" />
        </controls:HikContextMenu>
      </Setter.Value>
    </Setter>
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="" Binding="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LoginUserIconMenuItem" TargetType="{x:Type controls:IconMenuItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextBox.Foreground}" />
    <Setter Property="controls:IconMenuItem.PopupStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background">
            <Setter.Value>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#252525" Offset="0" />
                <GradientStop Color="#323232" Offset="1" />
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
          <Setter Property="Border.Padding" Value="4,5,4,5" />
          <Setter Property="Border.CornerRadius" Value="4" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="{DynamicResource Popup.BorderBrush}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="controls:IconMenuItem.TopMaskNormal">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="#00FFFFFF" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="controls:IconMenuItem.TopMaskHover">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="{DynamicResource TopMaskHover}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="controls:IconMenuItem.TopMaskClick">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="{DynamicResource TopMaskHover}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="controls:IconMenuItem.SubMaskNormal">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="135" />
          <Setter Property="Background" Value="#00FFFFFF" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="controls:IconMenuItem.SubMaskHover">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="135" />
          <Setter Property="Background" Value="#26F2F4F6" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Setter Property="BorderBrush" Value="{DynamicResource Col_Theme}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="controls:IconMenuItem.SubMaskClick">
      <Setter.Value>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="135" />
          <Setter Property="Background" Value="{DynamicResource SubMaskHover}" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Setter Property="BorderBrush" Value="{DynamicResource Col_Theme}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundHover}" />
      </Trigger>
      <Trigger Property="MenuItem.IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>