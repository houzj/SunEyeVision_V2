<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:local="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <local:AddComboxVisbileConverter x:Key="comboxVisbileConvert" />
  <local:AddButtonMarginConverter x:Key="addButtonMarginConvert" />
  <Style x:Key="LogicTypeRadioButtonStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LogicTypeButtonBB}" />
    <Setter Property="Background" Value="{DynamicResource btnEditTemplateBorderBG}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Width" Value="50" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Path Name="path" Data="M50,10 L100,10 L100,30 L91,38 L59,38 L50,30" Fill="{DynamicResource btnEditTemplateBorderBG}" Stretch="Fill" Stroke="{DynamicResource LogicTypeButtonBB}" />
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="path" Value="{DynamicResource Col_Theme}" Property="Shape.Stroke" />
              <Setter TargetName="path" Value="{DynamicResource btnEditTemplateBorderBG}" Property="Shape.Fill" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="path" Value="{DynamicResource Col_Theme}" Property="Shape.Stroke" />
              <Setter TargetName="path" Value="{DynamicResource btnEditTemplateBorderBG}" Property="Shape.Fill" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="path" Value="{DynamicResource Col_Theme}" Property="Shape.Stroke" />
              <Setter TargetName="path" Value="{DynamicResource btnEditTemplateBorderBG}" Property="Shape.Fill" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="path" Value="{DynamicResource btnEditTemplateBorderBG}" Property="Shape.Stroke" />
              <Setter TargetName="path" Value="{DynamicResource Col_Theme}" Property="Shape.Fill" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="path" Value="{DynamicResource LogicTypeStroke}" Property="Shape.Stroke" />
              <Setter TargetName="path" Value="{DynamicResource LogicTypeFill}" Property="Shape.Fill" />
              <Setter Value="{DynamicResource LogicTypeFG}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="AddButton_Logic">
    <StackPanel Orientation="Horizontal" Margin="{Binding EnumEntrysA, Converter={StaticResource addButtonMarginConvert}}">
      <ComboBox SelectedIndex="0" DisplayMemberPath="DisplayNameALang" Width="68" Height="32" Margin="10,0" ItemsSource="{Binding EnumEntrysA}" SelectedValue="{Binding CurValueA, Mode=TwoWay}" Visibility="{Binding EnumEntrysA, Converter={StaticResource comboxVisbileConvert}}" />
      <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="EnumEntry_LogicType">
    <StackPanel Width="50" Height="50" Orientation="Vertical" Margin="5,3,5,0">
      <RadioButton Name="btnLogicType" Focusable="True" Height="30" IsThreeState="False" Style="{StaticResource LogicTypeRadioButtonStyle}" Content="{Binding DisplayTitleA}" IsEnabled="{Binding IsEnableA}" IsChecked="{Binding IsSelectedA}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Checked">
            <i:InvokeCommandAction Command="{Binding CheckedCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </RadioButton>
      <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Text="{Lang:ResourceBinding DisplayNameALang}" ToolTip="{Binding DescriptionALang}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationLogicType">
    <ItemsControl ItemTemplate="{StaticResource EnumEntry_LogicType}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </DataTemplate>
  <DataTemplate x:Key="LogicOperationItem">
    <localParamTab:LeftRightControl FrameworkElement.Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Text="{DynamicResource Data}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding DisplayIndexA}" />
        </StackPanel>
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecter}" />
            <Button Grid.Column="1" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </Grid>
        </ContentControl>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_LogicItem_Container">
    <Grid Margin="5,0,0,0">
      <StackPanel>
        <ItemsControl Name="listVarItems" ItemTemplate="{StaticResource LogicOperationItem}" ItemsSource="{Binding ItemsA}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button Margin="30,5,0,3" HorizontalAlignment="Left" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}" Visibility="{Binding IsAllowAdd, Converter={StaticResource bool2VisibilityConverter}}">
          <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
          <FrameworkElement.Tag>
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
          </FrameworkElement.Tag>
        </Button>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_LogicItem">
    <Grid>
      <ContentControl Name="bsLogicItem" ContentTemplate="{StaticResource ButtonSelecter_LogicItem_Container}" Content="{Binding BridgeObjA}" />
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewMouseWheel">
          <i:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=bsRangeConF}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </Grid>
  </DataTemplate>
</ResourceDictionary>