<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localcontrol="clr-namespace:Apps.XmlUI.ParamTabControl;assembly=Apps.XmlUI" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/ParamTabControl/ParamTabUI/SubUI/ClearButtonTextBox/ClearButtonTextBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="ListParamItem_Boolean">
    <localcontrol:BooleanControl ToggleButton.IsChecked="{Binding IfDebugMode, Mode=TwoWay}">
      <localcontrol:BooleanControl.OffContent>
        <Image Stretch="None" Source="/Apps.Style;component/Resources/swith_off.png" />
      </localcontrol:BooleanControl.OffContent>
      <localcontrol:BooleanControl.OnContent>
        <Image Stretch="None" Source="/Apps.Style;component/Resources/swith_on.png" />
      </localcontrol:BooleanControl.OnContent>
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnCheckedChange">
          <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </localcontrol:BooleanControl>
  </DataTemplate>
  <DataTemplate x:Key="ListParamItemStr">
    <localParamTab:LeftRightControl FrameworkElement.Height="32" FrameworkElement.Margin="0,6,0,0">
      <localParamTab:LeftRightControl.LeftContent>
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Text="{DynamicResource 模块ID：}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding ID}" />
        </StackPanel>
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl Margin="-10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBox Width="115" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" TextWrapping="Wrap" Style="{StaticResource ClearButtonTextBoxStyle}" Text="{Binding InputValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="TextChanged">
                  <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
            <ContentControl Margin="15,0,0,0" ContentTemplate="{StaticResource ListParamItem_Boolean}" Content="{Binding}" />
            <Button Height="20" Width="20" Template="{StaticResource UpTemplate}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Value="true" Binding="{Binding IsFirst}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <i:InvokeCommandAction Command="{Binding UpTemplateCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Button>
            <Button Height="20" Width="20" Template="{StaticResource DownTemplate}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Value="true" Binding="{Binding IsLast}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <i:InvokeCommandAction Command="{Binding DownTemplateCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Button>
          </StackPanel>
        </ContentControl>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="ListParamStr">
    <ItemsControl Name="listBoxParam" ItemTemplate="{StaticResource ListParamItemStr}" ItemsSource="{Binding CurValueA}" IsEnabled="{Binding IsEnabledA}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </DataTemplate>
</ResourceDictionary>