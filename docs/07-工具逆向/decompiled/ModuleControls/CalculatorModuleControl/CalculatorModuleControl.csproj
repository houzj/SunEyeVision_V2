<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CalculatorModuleControl</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <TargetFramework>net461</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <Page Remove="CalculatorModuleControl\CalculatorProPanel.xaml" />
    <Page Remove="CalculatorModuleControl\CalculatorWindow.xaml" />
    <Page Remove="CalculatorModuleControl\ExpressionEditor.xaml" />
    <Page Remove="datatemplate\paramusercontroldatatemplate.xaml" />
    <Page Include="CalculatorModuleControl\CalculatorProPanel.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="calculatorpropanel.xaml" />
    <Page Include="CalculatorModuleControl\CalculatorWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="calculatorwindow.xaml" />
    <Page Include="CalculatorModuleControl\ExpressionEditor.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="expressioneditor.xaml" />
    <Page Include="datatemplate\paramusercontroldatatemplate.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="datatemplate/paramusercontroldatatemplate.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Apps.XmlParser" />
    <Reference Include="VMControls.Interface" />
    <Reference Include="VM.Core" />
    <Reference Include="Mvvm" />
    <Reference Include="VM.Util" />
    <Reference Include="VM.Controls" />
    <Reference Include="Apps.XmlUI" />
    <Reference Include="Apps.UIHelper" />
    <Reference Include="VM.Xml" />
    <Reference Include="System.Core" />
    <Reference Include="Apps.Localization" />
    <Reference Include="VM.Utility" />
    <Reference Include="VMControls.BaseInterface" />
    <Reference Include="Apps.Log" />
    <Reference Include="Apps.BaseLog" />
    <Reference Include="Apps.Json" />
  </ItemGroup>
</Project>