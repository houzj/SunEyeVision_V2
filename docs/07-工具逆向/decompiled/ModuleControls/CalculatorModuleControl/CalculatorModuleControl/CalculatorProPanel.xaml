<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CalculatorModuleControl.CalculatorProPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:CalculatorModuleControl" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="calculatorPanel" UseLayoutRounding="True" Background="#F2F3F3" Width="900">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="CategoryHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Foreground" Value="#4C4C4C" />
        <Setter Property="FontSize" Value="14px" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="cbx" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
                <Image Name="icon" Height="16" Width="16" Source="/Apps.XmlUI;component/Resources/combo_ic_triangle_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/combo_ic_triangle_click.png" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/combo_ic_triangle_click.png" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="combobox" TargetType="{x:Type ComboBox}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="Background" Value="#FCFCFC" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                        <Setter Property="Foreground" Value="#4D4D4D" />
                      </Trigger>
                      <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#FFDDE6F2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#FCFCFC" />
                          <GradientStop Offset="0.15" Color="#FCFCFC" />
                          <GradientStop Offset="1" Color="#F7F7F7" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                      </UIElement.Effect>
                      <UIElement.RenderTransform>
                        <TranslateTransform X="-4" />
                      </UIElement.RenderTransform>
                      <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{StaticResource cbx}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Grid Column="0" Margin="11,0,0,0">
                  <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  <ContentPresenter />
                </Grid>
                <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </DataTrigger>
                <Trigger Property="ComboBox.IsEditable" Value="True">
                  <Setter Property="IsTabStop" Value="False" />
                  <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource input}" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource combobox}" />
      <Style x:Key="ButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}" />
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Top" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource AddBtnStyle}" />
      <Style x:Key="boolean" TargetType="{x:Type ToggleButton}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Image Name="Image" Source="/Apps.XmlUI;component/Resources/swith_off.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/swith_on.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="delete" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteBtnStyle}" />
      <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate DataType="calculator:CalculatorItem">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3.5*" />
                  <ColumnDefinition Width="8.6*" />
                  <ColumnDefinition Width="8.0*" />
                  <ColumnDefinition Width="3.5*" />
                  <ColumnDefinition Width="2.8*" />
                  <ColumnDefinition Width="3.5*" />
                </Grid.ColumnDefinitions>
                <TextBox Width="88" Text="{Binding Name}" ToolTip="{Binding Name}" />
                <local:ExpressionEditor Width="242" Height="32" Grid.Column="1" Expression="{Binding Expression, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Width="242" HorizontalAlignment="Stretch" Text="{Binding RemarkInfo}" ToolTip="{Binding RemarkInfo}" />
                <TextBox Width="88" Grid.Column="3" Text="{Binding Initial}" ToolTip="{Binding Initial}" IsEnabled="{Binding CanEdit}" />
                <ComboBox Width="66" Height="32" Grid.Column="4" HorizontalAlignment="Left" SelectedItem="{Binding Type}">
                  <system:String>int</system:String>
                  <system:String>float</system:String>
                  <system:String>POINT</system:String>
                </ComboBox>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                  <ToggleButton Style="{StaticResource boolean}" IsChecked="{Binding Summation}" IsEnabled="{Binding CanEdit}" />
                  <Button Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource delete}" Click="Delete_Click" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="38" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Border BorderBrush="#E0DFDE" BorderThickness="0,0,0,1">
        <TextBlock FontSize="12px" FontFamily="Microsoft YaHei" Foreground="#999999" Text="{DynamicResource Lang_CalculatorLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Border>
      <Grid Row="1">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3.5*" />
          <ColumnDefinition Width="8.6*" />
          <ColumnDefinition Width="8.0*" />
          <ColumnDefinition Width="2.8*" />
          <ColumnDefinition Width="3.5*" />
          <ColumnDefinition Width="3.5*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Lang_Name}" />
        <TextBlock Grid.Column="1" Text="{DynamicResource Lang_CalculatorCEXP}" />
        <TextBlock Grid.Column="2" Text="{DynamicResource Lang_ReMark}" />
        <TextBlock Grid.Column="3" Text="{DynamicResource Lang_CalculatorCValue}" />
        <TextBlock Grid.Column="4" Text="{DynamicResource Lang_CalculatorCType}" />
        <TextBlock Grid.Column="5" Text="{DynamicResource Lang_CalculatorCInitial}" />
      </Grid>
      <StackPanel Orientation="Vertical" Grid.Row="2" VerticalAlignment="Top">
        <ScrollViewer Name="ScrollViewer" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="266">
          <ItemsControl ItemsSource="{Binding Path=Items}" />
        </ScrollViewer>
        <Button VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding AddCommand}" CommandParameter="{Binding MaxIOCount, ElementName=calculatorPanel}" Click="Add_Out" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>