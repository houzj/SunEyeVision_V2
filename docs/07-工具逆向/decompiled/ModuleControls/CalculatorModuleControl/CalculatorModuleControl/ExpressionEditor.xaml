<?xml version="1.0" encoding="utf-8"?>
<TextBox x:Class="CalculatorModuleControl.ExpressionEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:calculator="clr-namespace:CalculatorModuleControl" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" x:Name="Control" HorizontalAlignment="Stretch" Text="{Binding Expression, Mode=TwoWay}" ToolTip="{Binding Expression}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type calculator:ExpressionEditor}" TargetType="{x:Type calculator:ExpressionEditor}">
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="FrameworkElement.ContextMenu">
          <Setter.Value>
            <controls:HikContextMenu>
              <controls:HikMenuItem Command="Copy" />
              <controls:HikMenuItem Command="Cut" />
              <controls:HikMenuItem Command="Paste" />
            </controls:HikContextMenu>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="bg" BorderBrush="#cccccd" BorderThickness="1" Background="#fcfcfc" CornerRadius="2" Focusable="False" Uid="Border_17">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <themes:ListBoxChrome Background="#00FFFFFF" BorderThickness="0" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderFocused="{TemplateBinding UIElement.IsKeyboardFocusWithin}" UIElement.SnapsToDevicePixels="True">
                    <ScrollViewer Name="PART_ContentHost" Background="#00FFFFFF" BorderThickness="0" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  </themes:ListBoxChrome>
                  <Button HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,1,0" Background="#FCFCFC" Click="OpenPanel_OnClick" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bg" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="bg" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}">
                <Image Name="icon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Source="/Apps.XmlUI;component/Resources/ic_计算器_normal.png" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_计算器_hover.png" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_计算器_click.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
</TextBox>