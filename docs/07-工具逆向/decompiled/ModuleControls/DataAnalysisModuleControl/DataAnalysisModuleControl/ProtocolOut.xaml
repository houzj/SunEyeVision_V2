<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DataAnalysisModuleControl.ProtocolOut" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DataAnalysisModuleControl" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Diagram="clr-namespace:DataAnalysisModuleControl" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" x:Name="outCrotol" Height="230" Width="480">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <Style x:Key="normalLabel" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14px" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <DataTemplate x:Key="VarBasicType">
        <ComboBox Height="32" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding IoSelectValueTypes}" Text="{Binding ValueTypeA, Mode=TwoWay}" />
      </DataTemplate>
      <DataTemplate x:Key="ProtocolOutputParam_Item">
        <Grid Margin="0,0,0,6" Height="32" Width="Auto" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding IndexA}" />
          <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="15,0,6,0" CornerRadius="2">
            <TextBox Name="txtName" BorderThickness="0" Padding="12,0,0,0" VerticalContentAlignment="Center" TextWrapping="NoWrap" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#808080" Background="#00FFFFFF" Text="{Lang:ResourceBinding NameA, Mode=OneWay}" MaxLength="{Binding LengthA}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" PreviewKeyDown="TxtName_PreviewKeyDown">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=txtName}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <ContentControl Grid.Column="2" Margin="10,0,6,0" ContentTemplate="{StaticResource VarBasicType}" Content="{Binding}" />
          <Button Grid.Column="3" Margin="0,0,5,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ProtocolOutputParam_Container">
        <Grid Margin="10,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="85" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{DynamicResource Number}" Style="{StaticResource normalLabel}" />
            <Label Grid.Column="1" Content="{DynamicResource Lang_Name}" Style="{StaticResource normalLabel}" />
            <Label Grid.Column="2" Content="{DynamicResource Lang_Type}" Style="{StaticResource normalLabel}" />
          </Grid>
          <StackPanel Grid.Row="1">
            <ScrollViewer Name="srcView" Tag="1" MaxHeight="170" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
              <ItemsControl Name="listVarItems" ItemTemplate="{StaticResource ProtocolOutputParam_Item}" ItemsSource="{Binding ItemsA}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <Button Margin="25,10,0,3" HorizontalAlignment="Left" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ContentControl ContentTemplate="{StaticResource ProtocolOutputParam_Container}" Content="{Binding DataContext, ElementName=outCrotol}" />
  </Grid>
</UserControl>