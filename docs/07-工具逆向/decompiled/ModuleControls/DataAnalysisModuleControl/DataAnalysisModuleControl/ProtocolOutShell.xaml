<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DataAnalysisModuleControl.ProtocolOutShell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:DataAnalysisModuleControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="outShellCrotol" Height="230" Width="480">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <Style x:Key="normalLabel" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14px" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <DataTemplate x:Key="ProtocolOutputParam_Shell_Item">
        <Grid Margin="0,0,0,6" Height="32" Width="Auto" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding IndexA}" />
          <TextBlock Grid.Column="1" Margin="27,0,6,0" MaxWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#808080" Text="{Lang:ResourceBinding NameA}" ToolTip="{Binding NameA}" />
          <TextBlock Grid.Column="2" Margin="13,0,3,0" FontFamily="Microsoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Foreground="#808080" Text="{Binding ValueTypeA}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ProtocolOutputParam_Shell_Container">
        <Grid Margin="10,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{DynamicResource Number}" HorizontalAlignment="Center" Style="{StaticResource normalLabel}" />
            <Label Grid.Column="1" Content="{DynamicResource Lang_Name}" Margin="27,0,0,0" Style="{StaticResource normalLabel}" />
            <Label Grid.Column="2" Content="{DynamicResource Lang_Type}" Style="{StaticResource normalLabel}" />
          </Grid>
          <StackPanel Grid.Row="1">
            <ScrollViewer Name="srcView" Tag="1" MaxHeight="170" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
              <ItemsControl Name="listVarShellItems" ItemTemplate="{StaticResource ProtocolOutputParam_Shell_Item}" ItemsSource="{Binding ItemsA}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ContentControl ContentTemplate="{StaticResource ProtocolOutputParam_Shell_Container}" Content="{Binding DataContext, ElementName=outShellCrotol}" />
  </Grid>
</UserControl>