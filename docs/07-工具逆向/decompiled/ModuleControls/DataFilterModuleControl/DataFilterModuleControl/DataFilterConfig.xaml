<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DataFilterModuleControl.DataFilterConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DataFilterModuleControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:ConditionConvert x:Key="conditionConvert" />
      <local:BoolToVisibilityConvert x:Key="boolToVisibility" />
      <local:TypeFloatToVisibilityConvert x:Key="floatToVisibility" />
      <local:TypeIntToVisibilityConvert x:Key="intToVisibility" />
      <DataTemplate x:Key="ConditionGroupItem">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontSize="14" Width="100" Height="25" Foreground="#666666" Margin="10,7,0,0" Text="{Binding ConditionGroupName}" />
            <Button Name="Del" Margin="0,4,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteConditionGroupCommand}" CommandParameter="{Binding}">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ConditionItem">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="55*" />
            <ColumnDefinition Width="10*" />
          </Grid.ColumnDefinitions>
          <ContentControl Grid.Column="0" Margin="0,1,0,0" Width="132" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecter}" />
          <ContentControl Grid.Column="1" Margin="10,0,0,0" Width="300" Height="32" ContentTemplate="{StaticResource FloatBettween_sub}" Content="{Binding FilterBettween}" Visibility="{Binding TypeName, Converter={StaticResource floatToVisibility}}" />
          <ContentControl Grid.Column="1" Margin="10,0,0,0" Width="300" Height="32" ContentTemplate="{StaticResource IntegerBettween_Sub}" Content="{Binding IntegerBettween}" Visibility="{Binding TypeName, Converter={StaticResource intToVisibility}}" />
          <Button Grid.Column="2" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteConditionItemCommand}" CommandParameter="{Binding}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
      <Style x:Key="ListViewStyle" TargetType="{x:Type ListView}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <Border Name="Border" BorderThickness="1" Background="{x:Null}">
                <ScrollViewer Style="{StaticResource RecScrollViewer}">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListViewItem}">
              <Border Background="{TemplateBinding Control.Background}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                  </Grid.RowDefinitions>
                  <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" TextBlock.Foreground="{TemplateBinding Control.Foreground}" />
                  <Grid Row="1" Height="1" Background="#F76900" Visibility="{TemplateBinding IsSelected, Converter={StaticResource boolToVisibility}}" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#D8D8D8" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#E7E5E4" />
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="True">
            <Setter Property="Background" Value="#E7E5E4" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Border BorderThickness="1" Width="710" Height="370" BorderBrush="#E0DFDE">
          <Grid Background="#FFFFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Button Content="下发参数" Grid.Row="1" Visibility="Collapsed" Command="{Binding TestCommand}" />
              <StackPanel Orientation="Horizontal" Margin="8">
                <Label Content="{DynamicResource Lang_ConditionListOR}" FontWeight="Black" FontFamily="Microsoft YaHei" FontSize="14" />
                <Button Style="{StaticResource BaseImage_ButtonStyle}" Margin="15,0" HorizontalAlignment="Left" Command="{Binding AddConditionGroupCommand}">
                  <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
                  <FrameworkElement.Tag>
                    <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
                  </FrameworkElement.Tag>
                </Button>
              </StackPanel>
              <ListView Name="lv_group" Grid.Row="2" BorderThickness="0" Style="{StaticResource ListViewStyle}" ItemContainerStyle="{StaticResource ListViewItemStyle}" ItemTemplate="{StaticResource ConditionGroupItem}" SelectedItem="{Binding SelectedConditionGroupItem}" ItemsSource="{Binding ConditionGroups}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedItem, ElementName=lv_group}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ListView>
            </Grid>
            <Grid Column="1" Background="#E0DFDE" />
            <Grid Column="2" DataContext="{Binding SelectedConditionGroupItem}">
              <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Lang_LogicContentAND}" Margin="15,14,0,7" Foreground="#999999" FontSize="12" />
              <Grid Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="25*" />
                  <ColumnDefinition Width="55*" />
                  <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource RunParam_Content}" Grid.Column="0" Foreground="#4C4C4C" FontSize="14" FontWeight="Black" Margin="15,7" />
                <TextBlock Text="{DynamicResource Range}" Grid.Column="1" Foreground="#4C4C4C" FontSize="14" FontWeight="Black" Margin="15,7" />
              </Grid>
              <Grid Row="2">
                <Grid Name="g3" Margin="5,0,0,0" Visibility="{Binding SelectedItem, ElementName=lv_group, Converter={StaticResource conditionConvert}}">
                  <ScrollViewer Name="scrollcondition" Grid.Row="2" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                      <ItemsControl Name="listVarItems" ItemTemplate="{StaticResource ConditionItem}" ItemsSource="{Binding ConditionItems}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                        <ComboBox Style="{StaticResource ListViewComboBoxNTStyle}" Width="68" Height="32" Margin="10,0" SelectedIndex="{Binding SelectTypeIndex}">
                          <ComboBoxItem Content="Int" />
                          <ComboBoxItem Content="Float" />
                        </ComboBox>
                        <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddConditionItemCommand}">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>