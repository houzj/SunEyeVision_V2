<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DataQueueModuleControl</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <TargetFramework>net461</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <Page Remove="DataQueueModuleControl\DataQueueDataGrid.xaml" />
    <Page Remove="DataQueueModuleControl\DataQueuePanel.xaml" />
    <Page Remove="DataQueueModuleControl\TriggerProcedurePanel.xaml" />
    <Page Remove="datatemplate\paramusercontroldatatemplate.xaml" />
    <Page Include="DataQueueModuleControl\DataQueueDataGrid.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="dataqueuedatagrid.xaml" />
    <Page Include="DataQueueModuleControl\DataQueuePanel.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="dataqueuepanel.xaml" />
    <Page Include="DataQueueModuleControl\TriggerProcedurePanel.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="triggerprocedurepanel.xaml" />
    <Page Include="datatemplate\paramusercontroldatatemplate.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="datatemplate/paramusercontroldatatemplate.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Apps.XmlParser" />
    <Reference Include="VM.Core" />
    <Reference Include="Apps.Interface" />
    <Reference Include="VMControls.Interface" />
    <Reference Include="System.Core" />
    <Reference Include="VMControls.BaseInterface" />
    <Reference Include="VM.Util" />
    <Reference Include="VM.Controls" />
    <Reference Include="Apps.Localization" />
    <Reference Include="Apps.Log" />
    <Reference Include="Apps.BaseLog" />
    <Reference Include="VM.Xml" />
    <Reference Include="VM.PlatformSDKCS" />
    <Reference Include="Apps.ErrorCode" />
  </ItemGroup>
</Project>