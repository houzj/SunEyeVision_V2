<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DataQueueModuleControl.TriggerProcedurePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:listView="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:dataQueueCenter="clr-namespace:DataQueueModuleControl" x:Name="source" UseLayoutRounding="True" MouseDown="Source_MouseDown">
  <Grid Background="#F2F3F3">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}" />
        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource addButton}" />
        <Style x:Key="label" TargetType="{x:Type TextBlock}">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontFamily" Value="Microsoft YaHei" />
          <Setter Property="Foreground" Value="#666666" />
          <Setter Property="FontSize" Value="14px" />
        </Style>
        <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ListViewComboBoxStyle}" />
        <Style x:Key="delete" TargetType="{x:Type Button}" BasedOn="{StaticResource deleteButton}">
          <EventSetter Event="Click" Handler="Delete_OnHandler" />
        </Style>
        <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
          <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
          <Setter Property="ItemsPanel">
            <Setter.Value>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ItemTemplate">
            <Setter.Value>
              <DataTemplate DataType="dataQueueCenter:TriggerProcessItem">
                <Grid Margin="0,0,5,6">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource input}" />
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="5*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Left" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" Text="{Binding Index}" />
                  <Grid Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4.5*" />
                      <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox DisplayMemberPath="DisplayNameA" SelectedValuePath="ValueA" Height="32" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,10,0" ItemsSource="{Binding ProcessList}" SelectedValue="{Binding TriggerProcessID, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                    <Button Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource delete}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Margin="18,5,10,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="34" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource label}" Text="{DynamicResource RunParam_AsynchronousTrigger}" ToolTip="{DynamicResource RunParam_AsynchronousTrigger}" />
        <ContentControl Grid.Column="1" ContentTemplate="{StaticResource Boolean_sub}" Margin="10,0,0,0" Height="32" Content="{Binding ElementName=source, Path=TriggerBoolean}" />
      </Grid>
      <Border BorderThickness="0,0,0,1" Grid.Row="1" BorderBrush="#E0DFDE">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{DynamicResource Lang_TriggerProcedureList}" />
          <Button Margin="15,0,0,0" Style="{StaticResource BaseImage_ButtonStyle}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_help_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_help_normal.png" />
            </FrameworkElement.Tag>
            <FrameworkElement.ToolTip>
              <TextBlock Width="225" Text="{DynamicResource DataQueueTriggerTips}" TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="12" FontWeight="Normal" />
            </FrameworkElement.ToolTip>
          </Button>
        </StackPanel>
      </Border>
      <Grid Row="2" VerticalAlignment="Top">
        <Grid.RowDefinitions>
          <RowDefinition Height="38" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.6*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{DynamicResource Number}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Process}" />
        </Grid>
        <ScrollViewer Grid.Row="1" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="controlItem" ItemsSource="{Binding ElementName=source, Path=Items}" />
        </ScrollViewer>
        <Button Grid.Row="2" Margin="0,6" HorizontalAlignment="Left" Click="AddProcessItem_OnClick" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>