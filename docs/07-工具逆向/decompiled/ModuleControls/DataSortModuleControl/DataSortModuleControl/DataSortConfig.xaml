<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DataSortModuleControl.DataSortConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DataSortModuleControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="SortItem">
        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="20*" />
          </Grid.ColumnDefinitions>
          <ContentControl Grid.Column="0" HorizontalAlignment="Left" Margin="10,1,0,0" Width="230" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding SortSelecter}" />
          <Border Grid.Column="1" BorderBrush="#CCCCCD" BorderThickness="1" Margin="8,0,15,0" CornerRadius="2">
            <TextBox Foreground="{DynamicResource Col_ModuleConfig_ComboBox_Foreground}" FontSize="14" BorderThickness="0" IsReadOnly="True" Width="55" Height="32" VerticalContentAlignment="Center" MaxLength="65" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Binding TypeName, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <ComboBox Grid.Column="2" HorizontalAlignment="Left" Width="180" Height="32" Margin="0,0" Style="{StaticResource ListViewComboBoxNTStyle}" ItemsSource="{Binding RuleTypeSource}" SelectedIndex="{Binding SelectedSortTypeIndex}" />
          <Button Grid.Column="3" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteSortItemCommand}" CommandParameter="{Binding}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Border BorderThickness="1" Width="660" Height="370" BorderBrush="#E0DFDE">
        <Grid Name="gridParam" Background="#F2F3F5">
          <Grid Background="#FFFFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Column="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
              </Grid.RowDefinitions>
              <Grid Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56*" />
                  <ColumnDefinition Width="23*" />
                  <ColumnDefinition Width="25*" />
                  <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Tab_Params}" Grid.Column="0" Foreground="#4C4C4C" FontSize="14" FontWeight="Black" Margin="35,7" />
                <TextBlock Text="{DynamicResource Lang_Type}" Grid.Column="1" Foreground="#4C4C4C" FontSize="14" FontWeight="Black" Margin="10,7" />
                <TextBlock Text="{DynamicResource Lang_SortType}" Grid.Column="2" Foreground="#4C4C4C" FontSize="14" FontWeight="Black" Margin="15,7" />
              </Grid>
              <Grid Row="2">
                <Grid Name="g3" Margin="25,0,0,0">
                  <ScrollViewer Name="scrollSort" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                      <ItemsControl Name="listVarItems" ItemTemplate="{StaticResource SortItem}" ItemsSource="{Binding SortItems}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                        <ComboBox Style="{StaticResource ListViewComboBoxNTStyle}" Width="68" Height="32" Margin="10,0" SelectedIndex="{Binding SelectTypeIndex}">
                          <ComboBoxItem Content="Int" />
                          <ComboBoxItem Content="Float" />
                          <ComboBoxItem Content="Point" />
                        </ComboBox>
                        <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddSortItemCommand}">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="PreviewMouseWheel">
              <i:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=gridParam}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Grid>
      </Border>
    </ControlTemplate>
  </Control.Template>
</Control>