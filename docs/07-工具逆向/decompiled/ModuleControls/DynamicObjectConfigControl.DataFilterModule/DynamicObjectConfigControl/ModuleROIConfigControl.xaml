<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.ModuleROIConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:BaseLocal="clr-namespace:Apps.XmlUI" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:VMBaseControls="clr-namespace:VMBaseControls;assembly=VMBaseControls" xmlns:localcontrol="clr-namespace:Apps.XmlUI.ParamTabControl;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:controls="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:wpfControl="clr-namespace:VMControls.WPF;assembly=VMControls.WPF" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:xmlui="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:xmlParser="clr-namespace:Apps.XmlParser.ItemInterface;assembly=Apps.XmlParser" Width="1000" Height="600">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Grid Margin="10,10,0,0">
            <localParamTab:LeftRightControl>
              <localParamTab:LeftRightControl.LeftContent>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource 运行控制}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
              </localParamTab:LeftRightControl.LeftContent>
              <localParamTab:LeftRightControl.RightContent>
                <StackPanel Orientation="Horizontal">
                  <xmlui:ParamUserControl FrameworkElement.DataContext="{Binding ContinuousExecute}" />
                  <xmlui:ParamUserControl FrameworkElement.DataContext="{Binding StopExcuteOnce}" />
                  <xmlui:ParamUserControl FrameworkElement.DataContext="{Binding SelfExcuteOnce}" />
                </StackPanel>
              </localParamTab:LeftRightControl.RightContent>
            </localParamTab:LeftRightControl>
          </Grid>
          <localcontrol:RoiSelectControl FrameworkElement.VerticalAlignment="Top" FrameworkElement.Margin="10" FrameworkElement.DataContext="{Binding Path=(VMInterface:IDecorate.DecorateSource)}" ImageWidth="{Binding DataContext.ImageWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" ImageHeight="{Binding DataContext.ImageHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}" CanUpDateROI="{Binding Path=(xmlParser:IROISelecter.CanUpdateROI), Mode=OneWayToSource}" />
        </StackPanel>
        <Grid Column="1">
          <wpfControl:RenderControlBase MultiImageButtonVisible="True" ROIVisible="True" ModuleSource="{Binding ModuleSource}" SelectedROI="{Binding Path=(VMInterface:IDecorate.DecorateSource)}" ROIList="{Binding ROIList}" ImageSizeChangedCommand="{Binding ImageSizeChangedCommand}" RoiSelectedCommand="{Binding RoiSelectedCommand}" RoiDelCommand="{Binding RoiDelCommand}" RoiCopyCommand="{Binding RoiCopyCommand}" RoiPasteCommand="{Binding RoiPasteCommand}" RoiVisibleChangedCommand="{Binding RoiVisibleChangedCommand}" />
        </Grid>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>