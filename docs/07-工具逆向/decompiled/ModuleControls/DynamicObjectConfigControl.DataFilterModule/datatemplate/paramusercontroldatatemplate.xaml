<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:DisplayForGroupControl="clr-namespace:Apps.XmlUI.ParamTabControl.DisplayForGroupControl;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:UIHelper="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:paramtab="clr-namespace:Apps.XmlParser.ParamTab">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="GroupCommunicationParam">
    <local:CommunicationParamConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="GroupInputParam">
    <local:DynamicIOConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="GroupDisplayParam">
    <local:DynamicDisplayObjectConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="GroupRunParam">
    <local:DynamicRunParamConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="DynamicNameValueItemOfGroup">
    <Grid>
      <appxmlUI:ParamUserControl Name="con" FrameworkElement.DataContext="{Binding CloneSource}" ExternDisplayType="{Binding Path=(VMInterface:IGroupRunParam.DisplayForGroupType)}" />
      <Border Name="bd" Background="#00FFFFFF" Visibility="Collapsed">
        <Rectangle Height="1" SnapsToDevicePixels="False" Fill="#FFFF0000" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20" />
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="false" Binding="{Binding IsRelationEnable}">
        <Setter TargetName="bd" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="con" Property="UIElement.IsEnabled" Value="False" />
        <Setter Value="{DynamicResource Incorrelation}" TargetName="bd" Property="FrameworkElement.ToolTip" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ROISelecter_GroupControl">
    <local:ModuleROIConfigControl />
  </DataTemplate>
</ResourceDictionary>