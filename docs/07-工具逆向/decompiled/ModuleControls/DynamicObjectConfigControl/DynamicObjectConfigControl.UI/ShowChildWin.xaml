<?xml version="1.0" encoding="utf-8"?>
<pcUI:ConfirmBaseWindow x:Class="DynamicObjectConfigControl.UI.ShowChildWin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl.UI" xmlns:pcUI="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" x:Name="win" WindowStartupLocation="CenterOwner" Title="{DynamicResource 输入名称}" CancelVisible="Collapsed">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ListBox Width="370" Height="420" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding LeafIOs}">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <TextBox BorderThickness="0" IsReadOnly="True" Text="{Lang:ResourceBinding DataContext, RelativeSource={RelativeSource Self}}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ListBox>
</pcUI:ConfirmBaseWindow>