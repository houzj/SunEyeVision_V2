<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.DynamicDisplayObjectConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="DisplayVar">
        <Grid Margin="0,0,5,6" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" Height="32" Width="Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="42" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCD" BorderThickness="1" Margin="0,0,0,0" CornerRadius="2">
            <TextBox Name="tb" BorderThickness="0" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="32" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=tb}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <Border Grid.Column="1" BorderBrush="#CCCCCD" BorderThickness="1" Margin="8,0,0,0" CornerRadius="2">
            <TextBox BorderThickness="0" IsReadOnly="True" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="65" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Binding ValueType, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <Grid Margin="8,0,0,0" Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding ImageFilterSelecter}" />
            <ContentControl VerticalAlignment="Center" Grid.Column="1">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentControl}">
                  <Setter Property="ContentTemplate">
                    <Setter.Value>
                      <DataTemplate>
                        <commomcontrol:SuperImageButton Margin="6,0,0,0" Command="{Binding ConfigShapeCommand}">
                          <commomcontrol:SuperImageButton.NormalConnent>
                            <Image Source="/Apps.Style;component/Resources/编辑normal.png" Stretch="None" />
                          </commomcontrol:SuperImageButton.NormalConnent>
                          <commomcontrol:SuperImageButton.PressedConnent>
                            <Image Source="/Apps.Style;component/Resources/编辑click.png" Stretch="None" />
                          </commomcontrol:SuperImageButton.PressedConnent>
                          <commomcontrol:SuperImageButton.MOverConnent>
                            <Image Source="/Apps.Style;component/Resources/编辑click.png" Stretch="None" />
                          </commomcontrol:SuperImageButton.MOverConnent>
                        </commomcontrol:SuperImageButton>
                      </DataTemplate>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="Content" Value="{Binding}" />
                  <Style.Triggers>
                    <DataTrigger Value="image" Binding="{Binding ValueType, Mode=OneWay}">
                      <Setter Property="ContentTemplate" Value="{x:Null}" />
                      <Setter Property="Content" Value="{x:Null}" />
                    </DataTrigger>
                    <DataTrigger Value="pixelinfoimage" Binding="{Binding ValueType, Mode=OneWay}">
                      <Setter Property="ContentTemplate" Value="{x:Null}" />
                      <Setter Property="Content" Value="{x:Null}" />
                    </DataTrigger>
                    <DataTrigger Value="PointCloud3DImage" Binding="{Binding ValueType, Mode=OneWay}">
                      <Setter Property="ContentTemplate" Value="{x:Null}" />
                      <Setter Property="Content" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentControl>
          </Grid>
          <ContentControl Margin="5,0,0,0" Grid.Column="3">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Setter Property="Content" Value="{x:Null}" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsShowAccumulatedDisplay, Mode=OneWay}">
                    <Setter Property="ContentTemplate" Value="{StaticResource Boolean_sub}" />
                    <Setter Property="Content" Value="{Binding IsAccumulatedDisplay}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContentControl>
          <Button Name="delBtn" Margin="4,4,0,0" Grid.Column="4" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Value="false" Binding="{Binding IsEditState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=appxmlUI:ParamsTabUserControl}}">
            <Setter TargetName="delBtn" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="DisplayVar2">
        <Grid Margin="0,0,5,6" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" Height="32" Width="Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="42" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCD" BorderThickness="1" Margin="0,0,0,0" CornerRadius="2">
            <TextBox Name="tb" BorderThickness="0" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="32" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=tb}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <Border Grid.Column="1" BorderBrush="#CCCCCD" BorderThickness="1" Margin="8,0,0,0" CornerRadius="2">
            <TextBox BorderThickness="0" IsReadOnly="True" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="65" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Binding ValueType, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <Border Grid.Column="2" Margin="8,0" Height="32" HorizontalAlignment="Left">
            <TextBlock VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} {1}">
                  <Binding Path="RelateIOPre" />
                  <Lang:ResourceBinding Path="RelateIO.Name" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>
          <ContentControl Grid.Column="3" VerticalAlignment="Center">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate">
                  <Setter.Value>
                    <DataTemplate>
                      <commomcontrol:SuperImageButton Margin="6,0,0,0" Command="{Binding ConfigShapeCommand}">
                        <commomcontrol:SuperImageButton.NormalConnent>
                          <Image Source="/Apps.Style;component/Resources/编辑normal.png" Stretch="None" />
                        </commomcontrol:SuperImageButton.NormalConnent>
                        <commomcontrol:SuperImageButton.PressedConnent>
                          <Image Source="/Apps.Style;component/Resources/编辑click.png" Stretch="None" />
                        </commomcontrol:SuperImageButton.PressedConnent>
                        <commomcontrol:SuperImageButton.MOverConnent>
                          <Image Source="/Apps.Style;component/Resources/编辑click.png" Stretch="None" />
                        </commomcontrol:SuperImageButton.MOverConnent>
                      </commomcontrol:SuperImageButton>
                    </DataTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="Content" Value="{Binding}" />
                <Style.Triggers>
                  <DataTrigger Value="image" Binding="{Binding ValueType, Mode=OneWay}">
                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                    <Setter Property="Content" Value="{x:Null}" />
                  </DataTrigger>
                  <DataTrigger Value="pixelinfoimage" Binding="{Binding ValueType, Mode=OneWay}">
                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                    <Setter Property="Content" Value="{x:Null}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContentControl>
        </Grid>
      </DataTemplate>
      <local:ItemTemplateSelector x:Key="itemTemplateSelector" FirstTemplate="{StaticResource DisplayVar}" SecondTemplate="{StaticResource DisplayVar2}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate TargetType="{x:Type Control}">
      <Grid Background="#FCFCFC" Focusable="True" MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Tab_Image Display}" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource TitleColor}" />
        <Grid Row="1" Margin="18,0,0,0" TextBlock.Foreground="{DynamicResource ParamsTabForeground}" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{DynamicResource Lang_ParamName}" Margin="0,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="68" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Type}" Margin="8,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="68" FontWeight="Bold" />
          <TextBlock Grid.Column="2" Text="{DynamicResource correlation}" Margin="8,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" FontWeight="Bold" />
          <TextBlock Grid.Column="3" Text="{DynamicResource Lang_AccumulatedDisplay}" ToolTip="{DynamicResource Lang_AccumulatedDisplay}" TextTrimming="CharacterEllipsis" Margin="8,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="95" FontWeight="Bold" Visibility="{Binding IsShowAccumulatedDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
        <Grid Row="2" Margin="18,0,2,0" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ItemsControl Name="listInputVars" Style="{StaticResource ScrollItemsControlStyle}" ItemTemplateSelector="{StaticResource itemTemplateSelector}" ItemsSource="{Binding DisplayItemsA}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel Name="AddStack" Orientation="Horizontal" Grid.Row="1" Margin="0,6">
            <ComboBox Style="{StaticResource ListViewComboBoxStyle}" SelectedValuePath="Item2" Width="68" Height="32" ToolTip="{Lang:ResourceBinding SelectionBoxItem.Item1, RelativeSource={RelativeSource Mode=Self}}" ItemsSource="{Binding DisplayTypes}" SelectedValue="{Binding SelectedType, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Lang:ResourceBinding Item1}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Button Margin="7,6,0,0" Style="{StaticResource BaseImage_ButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddCommand}">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Value="false" Binding="{Binding IsEditState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=appxmlUI:ParamsTabUserControl}}">
          <Setter TargetName="AddStack" Property="UIElement.Visibility" Value="Collapsed" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Control>