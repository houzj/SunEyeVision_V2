<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.DynamicIOConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="InputVar">
        <Grid Margin="0,0,5,6" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" Height="32" Width="Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="42" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCD" BorderThickness="1" Margin="0,0,0,0" CornerRadius="2">
            <TextBox Name="tb" BorderThickness="0" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="{x:Static core:VmIO.MaxNameLenth}" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=tb}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <Border Grid.Column="1" BorderBrush="#CCCCCD" BorderThickness="1" Margin="8,0,0,0" CornerRadius="2">
            <TextBox BorderThickness="0" IsReadOnly="True" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="65" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Binding ValueType, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <Grid Margin="8,0,0,0" Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecter}" />
            <ContentControl VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentControl}">
                  <Setter Property="ContentTemplate" Value="{x:Null}" />
                  <Setter Property="Content" Value="{x:Null}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsShowDisplayCheckBox, Mode=OneWay}">
                      <Setter Property="ContentTemplate">
                        <Setter.Value>
                          <DataTemplate>
                            <CheckBox Margin="5,0,0,0" ToolTip="{DynamicResource RunParam_Display}" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding IsDisplayForImage}" />
                          </DataTemplate>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="Content" Value="{Binding}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentControl>
          </Grid>
          <ContentControl Margin="5,0,0,0" Grid.Column="3">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Setter Property="Content" Value="{x:Null}" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsShowAccumulatedOutput, Mode=OneWay}">
                    <Setter Property="ContentTemplate" Value="{StaticResource Boolean_sub}" />
                    <Setter Property="Content" Value="{Binding IsAccumulatedOutput}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContentControl>
          <Button Name="Del" Margin="0,4,0,0" Grid.Column="4" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Value="false" Binding="{Binding IsEditState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=appxmlUI:ParamsTabUserControl}}">
            <Setter TargetName="Del" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Background="#FCFCFC" Focusable="True" MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid Margin="18,0,0,0" TextBlock.Foreground="{DynamicResource TitleColor}" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="68" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Lang_ParamName}" Margin="0,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="68" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Type}" Margin="8,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="68" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="{DynamicResource 订阅关系}" Margin="8,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" FontWeight="Bold" />
            <TextBlock Grid.Column="3" Text="{DynamicResource Lang_AccumulatedOutput}" ToolTip="{DynamicResource Lang_AccumulatedOutput}" TextTrimming="CharacterEllipsis" Margin="8,5,0,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="95" FontWeight="Bold" Visibility="{Binding IsShowAccumulatedOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </Grid>
        <Grid Row="1" Margin="18,0,2,0" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ItemsControl Name="listInputVars" Style="{StaticResource ScrollItemsControlStyle}" ItemTemplate="{StaticResource InputVar}" ItemsSource="{Binding ItemsA}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel Name="AddStack" Orientation="Horizontal" Grid.Row="1" Margin="0,6">
            <ComboBox Style="{StaticResource ListViewComboBoxStyle}" SelectedValuePath="Item2" Width="68" Height="32" ToolTip="{Lang:ResourceBinding SelectionBoxItem.Item1, RelativeSource={RelativeSource Mode=Self}}" ItemsSource="{Binding InputOutputTypes}" SelectedValue="{Binding SelectedType, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Lang:ResourceBinding Item1}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Button Margin="7,6,0,0" Style="{StaticResource BaseImage_ButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddCommand}">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Value="false" Binding="{Binding IsEditState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=appxmlUI:ParamsTabUserControl}}">
          <Setter TargetName="AddStack" Property="UIElement.Visibility" Value="Collapsed" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Control>