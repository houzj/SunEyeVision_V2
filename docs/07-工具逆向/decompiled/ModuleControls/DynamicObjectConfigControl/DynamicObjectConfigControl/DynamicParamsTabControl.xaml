<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.DynamicParamsTabControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Wpf="clr-namespace:VMControls.WPF;assembly=VMControls.WPF" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="win">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Background="#F2F3F5">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#E0DFDE" Background="#FCFCFC" BorderThickness="1" Margin="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding FirstColumnWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Wpf:ParamsConfigControlBase Name="paramsTab" Grid.Column="0" Focusable="True" ROIPartUI="{Binding ROIPartUI, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ParamsConfig="{Binding ParamsConfig, RelativeSource={RelativeSource Mode=TemplatedParent}}" IsEditState="{Binding IsEditState, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <Rectangle Width="1" Grid.Column="0" SnapsToDevicePixels="False" Fill="#E0DFDE" VerticalAlignment="Stretch" HorizontalAlignment="Right" />
            <local:DynamicResultView Grid.Column="1" ModuleSource="{Binding DataContext.Owner, ElementName=paramsTab}" ImageDecorate="{Binding ImageDecorate, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#E4E5E7" BorderThickness="0,1,0,0" BorderBrush="#C8C4C1">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ContentControl ContentTemplate="{StaticResource ContinuousExecuteBottomCommand}" Margin="0,0,3,0" Content="{Binding ContinuousExecuteBottom, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding IsExecute, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <ContentControl ContentTemplate="{StaticResource StopExecuteBottomCommand}" Content="{Binding StopExecuteBottom, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding IsExecute, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <ContentControl ContentTemplate="{StaticResource ExecuteOnceBottomCommand}" Margin="0,0,3,0" Content="{Binding ExecuteOnceBottom, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding IsExecute, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <ContentControl ContentTemplate="{StaticResource BottomCommand}" Margin="0,0,11.5,0" Content="{Binding ConfirmBottom, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
          </StackPanel>
        </Border>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>