<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.DynamicResultView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:wpfControl="clr-namespace:VMControls.WPF;assembly=VMControls.WPF" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TabControlStyle/TabControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <wpfControl:TextLengthConverter x:Key="treeLengthConverter" />
      <convert:LongTextConvert x:Key="LongTextConvert" FontSize="14" MaxLen="270" FontFamily="Microsoft YaHei" />
      <local:BoolToTabControlHeightConverter x:Key="TabControlHeightConverter" />
      <Style x:Key="ResultTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Name="ColumnDefinition0" />
                  <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Name="RowDefinition0" Height="Auto" />
                  <RowDefinition Name="RowDefinition1" Height="*" />
                </Grid.RowDefinitions>
                <Border Name="head" Background="#FAFAFC" Height="38" BorderBrush="#CCC7C6" BorderThickness="0,0,0,1" Width="{TemplateBinding FrameworkElement.ActualWidth}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Name="scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                      <StackPanel Name="stack" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TabPanel Name="HeaderPanel" Grid.Column="0" Grid.Row="0" Margin="0" ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                      </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Column="1" Margin="5,0" ToolTip="{DynamicResource Lang_Filtrate}" Style="{StaticResource ScreenButtonStyle}" Command="{Binding FiltrateCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DynamicResultView}}" />
                  </Grid>
                </Border>
                <Grid Name="PART_ItemsHolder" Column="0" Row="1" ColumnSpan="2" Background="{DynamicResource Col_TabControl_Background}" />
                <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Grid.ColumnSpan="2" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TabItemTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#4D4D4D" />
        <Setter Property="FontSize" Value="12px" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      <Style x:Key="ResultListViewStyle" TargetType="{x:Type ListView}">
        <Setter Property="ItemsControl.AlternationCount" Value="2" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <ScrollViewer Tag="1" Style="{StaticResource RecScrollViewer}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </ScrollViewer>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
        <Style.Setters>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListViewItem}">
                <Border Name="bd" SnapsToDevicePixels="True" Height="34px" Padding="0" BorderThickness="1,0" BorderBrush="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" MaxWidth="300" TextTrimming="CharacterEllipsis" Text="{Binding Name, Converter={StaticResource LongTextConvert}}" ToolTip="{Binding Name}" />
                    <Rectangle Grid.Column="1" Width="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" MaxWidth="300" TextTrimming="CharacterEllipsis" Text="{Binding Value}">
                      <FrameworkElement.ToolTip>
                        <ToolTip DataContext="{Binding Path=PlacementTarget, RelativeSource={x:Static RelativeSource.Self}}">
                          <TextBlock TextWrapping="Wrap" MaxWidth="600" Text="{Binding Text, Converter={StaticResource treeLengthConverter}}" />
                        </ToolTip>
                      </FrameworkElement.ToolTip>
                    </TextBlock>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter TargetName="bd" Value="{DynamicResource Col_ProcessTimeConsuming_Subfrom_AlternationIndex1}" Property="Border.Background" />
                  </Trigger>
                  <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter TargetName="bd" Value="{DynamicResource Col_ProcessTimeConsuming_Subfrom_AlternationIndex2}" Property="Border.Background" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style.Setters>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Name="LayoutRoot">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Name="rowInput" Height="188" />
        </Grid.RowDefinitions>
        <Grid Row="0" DataContext="{Binding ImageDecorate, RelativeSource={RelativeSource Mode=TemplatedParent}}">
          <wpfControl:RenderControlBase MultiImageButtonVisible="False" ROIVisible="True" ModuleSource="{Binding ModuleSource}" SelectedROI="{Binding Path=(VMInterface:IDecorate.DecorateSource)}" ROIList="{Binding ROIList}" ImageSizeChangedCommand="{Binding ImageSizeChangedCommand}" RoiSelectedCommand="{Binding RoiSelectedCommand}" RoiDelCommand="{Binding RoiDelCommand}" RoiCopyCommand="{Binding RoiCopyCommand}" RoiPasteCommand="{Binding RoiPasteCommand}" RoiVisibleChangedCommand="{Binding RoiVisibleChangedCommand}" />
        </Grid>
        <TabControl Grid.Row="1" Style="{StaticResource ResultTabControlStyle}" SelectedIndex="0">
          <TabItem Height="37" Style="{StaticResource NorTablItemStyle}" Width="{Binding TabItemWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}">
            <HeaderedContentControl.Header>
              <Grid VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Lang_OutputResult}" Style="{StaticResource TabItemTextStyle}" />
              </Grid>
            </HeaderedContentControl.Header>
            <Grid Margin="18,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Row="0" Background="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Title}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Lang_ParamName}" ToolTip="{DynamicResource Lang_ParamName}" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Rectangle Grid.Column="1" Width="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Lang_CurRslt}" ToolTip="{DynamicResource Lang_CurRslt}" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <StackPanel Grid.Row="1">
                <ListView Style="{StaticResource ResultListViewStyle}" MaxHeight="102" ItemsSource="{Binding DynamicOutputList, RelativeSource={RelativeSource Mode=TemplatedParent}}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" />
                <Rectangle Height="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>