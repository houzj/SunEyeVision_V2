<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.DynamicRunParamConfigPanal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:localXmlParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core" xmlns:appBaseData="clr-namespace:Apps.BaseData;assembly=Apps.BaseData">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ListViewStyle/ListViewStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ExpanderStyle/ExpanderStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <appBaseData:UPEnableOfListMultiplicationConverter x:Key="UpEnableConvert" />
      <appBaseData:DownEnableOfListMultiplicationConverter x:Key="DownEnableConvert" />
      <DataTemplate x:Key="RelationModulesConfigTemplate">
        <Grid Background="#00FFFFFF">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="5,0,0,0" Foreground="#808080" Background="#00FFFFFF" FontSize="14" VerticalAlignment="Center" Text="{Binding RelationModulesStr}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          <Button Name="rt" Grid.Column="1" Style="{StaticResource LinkButtonStyle}" Command="{Binding RelationModulesConfigCommand}" CommandParameter="{Binding EditModulesMethod, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DynamicRunParamConfigPanal}}" />
          <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource TextBox.Static.Border}" Grid.Column="0" Grid.ColumnSpan="2" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ResetTemplate">
        <Button Style="{StaticResource SyncDataBtnStyle2}" Command="{Binding SyncCommand}" />
      </DataTemplate>
      <DataTemplate x:Key="UpDownHead">
        <StackPanel Orientation="Horizontal" />
      </DataTemplate>
      <DataTemplate x:Key="DeleteTemplate">
        <StackPanel Orientation="Horizontal">
          <Button Name="up" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding}">
            <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_normal.png" Stretch="None" />
            <FrameworkElement.Tag>
              <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" Stretch="None" />
            </FrameworkElement.Tag>
          </Button>
          <Button Name="down" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding}">
            <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_normal.png" Stretch="None" />
            <FrameworkElement.Tag>
              <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" Stretch="None" />
            </FrameworkElement.Tag>
          </Button>
          <Button Name="delete" Background="#00FFFFFF" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.DeleteParamCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding}">
            <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" Stretch="None" />
            <FrameworkElement.Tag>
              <Image Source="/Apps.XmlUI;component/Resources/delete_click.png" Stretch="None" />
            </FrameworkElement.Tag>
          </Button>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="ReNameTemplate">
        <TextBox Width="120" MaxLength="{x:Static core:VmIO.MaxNameLenth}" HorizontalAlignment="Stretch" Margin="0,0,5,0" Style="{StaticResource input}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="LostFocus">
              <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </TextBox>
      </DataTemplate>
      <DataTemplate x:Key="GridViewColumnHeaderTextBlock">
        <TextBlock Margin="0,0,-25,0" Style="{StaticResource TitleTextBlock}" Text="{Binding}" />
      </DataTemplate>
      <Style x:Key="GridViewCellTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ContentTextBlock}">
        <Setter Property="MaxWidth" Value="150" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FrameworkElement.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
      </Style>
      <DataTemplate x:Key="PathGridViewCellTextBlock">
        <TextBlock Style="{StaticResource GridViewCellTextBlockStyle}" Text="{Lang:PathResourceBinding Path}" />
      </DataTemplate>
      <DataTemplate x:Key="TypeNameGridViewCellTextBlock">
        <TextBlock Style="{StaticResource GridViewCellTextBlockStyle}" Text="{Lang:PathResourceBinding TypeName}" />
      </DataTemplate>
      <Style x:Key="ParamGroupItemStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupItem}">
              <Expander Name="groupContainer" BorderThickness="1" Style="{StaticResource SelectableExpanderStyle}" IsExpanded="{Binding Name.IsExpanded}">
                <HeaderedContentControl.Header>
                  <Grid>
                    <DockPanel Margin="5,8,0,8">
                      <TextBox Name="ht" MaxLength="{x:Static core:VmIO.MaxNameLenth}" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource TitleColor}" Width="auto" Style="{StaticResource input}" Text="{Binding Name.Name, Mode=OneWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="LostFocus">
                            <UIHelper:ParamsEventCommand Command="{Binding Name.TextChangedCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                      <TextBlock Name="SelectedTx" Margin="10,0,0,0" Text="{DynamicResource Lang_LeftSelectItem}" Visibility="Collapsed" Style="{StaticResource noteStyle}" />
                    </DockPanel>
                    <StackPanel Margin="603,0,0,0" Orientation="Horizontal">
                      <Button Name="up" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.UpGroupCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding Name}">
                        <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_normal.png" Stretch="None" />
                        <FrameworkElement.Tag>
                          <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" Stretch="None" />
                        </FrameworkElement.Tag>
                      </Button>
                      <Button Name="down" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.DownGroupCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding Name}">
                        <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_normal.png" Stretch="None" />
                        <FrameworkElement.Tag>
                          <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" Stretch="None" />
                        </FrameworkElement.Tag>
                      </Button>
                      <Button Background="#00FFFFFF" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.DelGroupCommand, RelativeSource={RelativeSource AncestorType=local:DynamicRunParamConfigPanal}}" CommandParameter="{Binding Name}">
                        <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" Stretch="None" />
                        <FrameworkElement.Tag>
                          <Image Source="/Apps.XmlUI;component/Resources/delete_click.png" Stretch="None" />
                        </FrameworkElement.Tag>
                      </Button>
                    </StackPanel>
                  </Grid>
                </HeaderedContentControl.Header>
                <ItemsPresenter />
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <UIHelper:ParamsEventCommand Command="{Binding Name.SelectCommand}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </Expander>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding Name.IsSelected}">
                  <Setter TargetName="groupContainer" Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                  <Setter TargetName="SelectedTx" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <CollectionViewSource x:Key="src" IsLiveGroupingRequested="True" Source="{Binding Collection}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="GroupName" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate TargetType="{x:Type Control}">
      <Grid Background="#f2f3f5" Focusable="True" MouseDown="Grid_MouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="370" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="IsExpandedTemplate">
              <ToggleButton Name="gg" Visibility="Collapsed" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="Checked">
                    <core1:ChangePropertyAction xmlns:core1="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" PropertyName="IsExpanded" Value="True" i:TargetedTriggerAction.TargetObject="{Binding}" />
                  </i:EventTrigger>
                  <i:EventTrigger EventName="Unchecked">
                    <ChangePropertyAction PropertyName="IsExpanded" Value="False" i:TargetedTriggerAction.TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </ToggleButton>
            </DataTemplate>
            <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localXmlParserTab:Holder}}" DataType="{x:Type localXmlParserTab:Holder}" ItemsSource="{Binding EnumEntrysA}">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <CheckBox VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding CheckEnabled}" Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=paramtab:CheckBoxConfigTreeView}}" CommandParameter="{Binding}" />
                  <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Lang:ResourceBinding Name}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                </StackPanel>
                <ContentControl Name="Expend" ContentTemplate="{StaticResource IsExpandedTemplate}" Content="{Binding}" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Value="0" Binding="{Binding EnumEntrysA.Count}">
                  <Setter TargetName="Expend" Property="ContentControl.Content" Value="{x:Null}" />
                  <Setter TargetName="Expend" Property="ContentControl.ContentTemplate" Value="{x:Null}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </HierarchicalDataTemplate>
            <Style x:Key="textBoxStyle" TargetType="{x:Type TextBox}">
              <Setter Property="TextBox.MaxLength" Value="256" />
              <Setter Property="FontSize" Value="14" />
              <Setter Property="Height" Value="32" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="BorderBrush" Value="#CCCCCD" />
              <Setter Property="Background" Value="{DynamicResource Col_ModuleConfig_ComboBox_Background}" />
              <Setter Property="Foreground" Value="#666666" />
              <Setter Property="HorizontalContentAlignment" Value="Left" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="HorizontalAlignment" Value="Left" />
              <Setter Property="FontFamily" Value="Microsoft YaHei" />
              <Setter Property="Grid.ColumnSpan" Value="2" />
              <Setter Property="Padding" Value="6,0,32,0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                      <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" CornerRadius="2" Width="215">
                        <Grid>
                          <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                          <TextBlock Name="Message" HorizontalAlignment="Left" Width="185" FontSize="12" VerticalAlignment="Center" Foreground="#80808080" Padding="8,0,0,0" Text="{DynamicResource Lang_SearchTag}" Visibility="Hidden" />
                        </Grid>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                        <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                      </Trigger>
                      <Trigger Property="UIElement.IsFocused" Value="True">
                        <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Border Grid.Column="0" BorderBrush="#E0DFDE" Margin="0,10,0,0">
          <Grid Background="#ffffff">
            <Grid.RowDefinitions>
              <RowDefinition Height="37" />
              <RowDefinition Height="37" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="#4c4c4c" Margin="12,0,0,0" Text="{DynamicResource Lang_SelectList}" FontFamily="微软雅黑" FontWeight="Bold" TextAlignment="Left" FontSize="14px" />
            <StackPanel Grid.Row="1" Orientation="Horizontal">
              <ComboBox Name="SearchComboBox" Width="130" Margin="12,0,5,0" SelectedIndex="0" Style="{StaticResource ListViewComboBoxStyle}" Height="32" ItemsSource="{Binding SelectedType}" SelectedItem="{Binding ComboBoxSelectedItem, Mode=TwoWay}" ToolTip="{Lang:ResourceBinding SelectedValue, RelativeSource={RelativeSource Self}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource ContentTextBlock}" Text="{Lang:ResourceBinding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="185" />
                  <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBox Name="searchWord" Style="{StaticResource textBoxStyle}" Text="{Binding SearchWord}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="TextChanged">
                      <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=searchWord}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </TextBox>
                <commomcontrol:SuperImageButton Grid.Column="1" Margin="-3,0,1,-1">
                  <commomcontrol:SuperImageButton.NormalConnent>
                    <Image Source="/Apps.XmlUI;component/Resources/ic_search_normal.png" Stretch="None" />
                  </commomcontrol:SuperImageButton.NormalConnent>
                  <commomcontrol:SuperImageButton.PressedConnent>
                    <Image Source="/Apps.XmlUI;component/Resources/ic_search_click.png" Stretch="None" />
                  </commomcontrol:SuperImageButton.PressedConnent>
                  <commomcontrol:SuperImageButton.MOverConnent>
                    <Image Source="/Apps.XmlUI;component/Resources/ic_search_hover.png" Stretch="None" />
                  </commomcontrol:SuperImageButton.MOverConnent>
                </commomcontrol:SuperImageButton>
              </Grid>
            </StackPanel>
            <Border Background="#ffffff" Grid.Row="2" Margin="5,5,5,3" BorderBrush="#E0DFDE" BorderThickness="1">
              <paramtab:CheckBoxConfigTreeView Name="outputConfigTreeView" FrameworkElement.Margin="2,5,2,3" IsDisplayCheckBox="False" FrameworkElement.HorizontalAlignment="Stretch" ItemsSource="{Binding EnumEntrysA}" />
            </Border>
          </Grid>
        </Border>
        <Grid Column="1" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="37" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#4c4c4c" Margin="12,0,0,0" Text="{DynamicResource Selected_Params}" FontFamily="微软雅黑" FontWeight="Bold" TextAlignment="Left" FontSize="14px" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Margin="5,0,12,0" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Lang_AddGroup}" Command="{Binding AddGroupCommand}" />
              <Button Margin="5,0,12,0" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Clear}" Command="{Binding DelAllCommand}" />
            </StackPanel>
          </Grid>
          <ListView Grid.Row="1" SelectionMode="Single" Style="{StaticResource ListViewWithHeadStyle}" ItemsSource="{Binding Source={StaticResource src}}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListView.View>
              <GridView ColumnHeaderContainerStyle="{StaticResource NormalGridViewColumnHeaderStyle}">
                <GridViewColumn Header="{DynamicResource DataSource}" CellTemplate="{StaticResource PathGridViewCellTextBlock}" HeaderTemplate="{StaticResource GridViewColumnHeaderTextBlock}" Width="150" />
                <GridViewColumn Header="{DynamicResource Lang_CustomName}" HeaderTemplate="{StaticResource GridViewColumnHeaderTextBlock}" Width="150" CellTemplate="{StaticResource ReNameTemplate}" />
                <GridViewColumn Header="{DynamicResource Lang_Type}" CellTemplate="{StaticResource TypeNameGridViewCellTextBlock}" HeaderTemplate="{StaticResource GridViewColumnHeaderTextBlock}" Width="90" />
                <GridViewColumn Header="{DynamicResource correlation}" HeaderTemplate="{StaticResource GridViewColumnHeaderTextBlock}" Width="150" CellTemplate="{StaticResource RelationModulesConfigTemplate}" />
                <GridViewColumn Header="{DynamicResource Data_Sync}" HeaderTemplate="{StaticResource GridViewColumnHeaderTextBlock}" Width="70" CellTemplate="{StaticResource ResetTemplate}" />
                <GridViewColumn HeaderTemplate="{StaticResource UpDownHead}" Width="90" CellTemplate="{StaticResource DeleteTemplate}" />
              </GridView>
            </ListView.View>
            <ItemsControl.GroupStyle>
              <GroupStyle ContainerStyle="{StaticResource ResourceKey=ParamGroupItemStyle}" />
            </ItemsControl.GroupStyle>
          </ListView>
        </Grid>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>