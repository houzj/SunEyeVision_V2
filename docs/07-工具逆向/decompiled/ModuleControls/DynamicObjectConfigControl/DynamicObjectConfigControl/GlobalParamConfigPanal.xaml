<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DynamicObjectConfigControl.GlobalParamConfigPanal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:localXmlParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:appUi="clr-namespace:Apps.PcUI;assembly=Apps.PcUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/VM.Controls;component/Styles/MenuItemStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ListViewStyle/ListViewStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TabControlStyle/TabControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ExpanderStyle/ExpanderStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TreeViewStyle/TreeViewStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="textBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="TextBox.MaxLength" Value="256" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="32" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#CCCCCD" />
        <Setter Property="Background" Value="{DynamicResource Col_ModuleConfig_ComboBox_Background}" />
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Padding" Value="6,0,32,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Grid>
                <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" CornerRadius="2" Width="142">
                  <Grid>
                    <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                    <TextBlock Name="Message" HorizontalAlignment="Left" Width="110" FontSize="14" VerticalAlignment="Center" Foreground="#80808080" Padding="8,0,0,0" Text="{DynamicResource Lang_Search}" Visibility="Hidden" />
                  </Grid>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GridViewCellTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ContentTextBlock}">
        <Setter Property="MaxWidth" Value="150" />
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FrameworkElement.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
      </Style>
      <DataTemplate x:Key="PathGridViewCellTextBlock">
        <TextBlock Margin="12,0,0,0" Style="{StaticResource GridViewCellTextBlockStyle}" Text="{Lang:PathResourceBinding Path}" />
      </DataTemplate>
      <DataTemplate x:Key="GridViewColumnHeaderTextBlock">
        <TextBlock Style="{StaticResource TitleTextBlock}" Text="{Binding}" />
      </DataTemplate>
      <DataTemplate x:Key="ReNameTemplate">
        <TextBox Width="190" MaxLength="{x:Static core:VmIO.MaxNameLenth}" HorizontalAlignment="Stretch" Style="{StaticResource input}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="LostFocus">
              <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </TextBox>
      </DataTemplate>
      <DataTemplate x:Key="TypeNameGridViewCellTextBlock">
        <TextBlock Style="{StaticResource GridViewCellTextBlockStyle}" Text="{Lang:PathResourceBinding TypeName}" />
      </DataTemplate>
      <DataTemplate x:Key="RelationModulesConfigTemplate">
        <Grid Background="#00FFFFFF" Width="190">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="5,0,0,0" Foreground="#808080" Background="#00FFFFFF" FontSize="14" VerticalAlignment="Center" Text="{Binding RelationModulesStr}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          <Button Name="rt" Grid.Column="1" Style="{StaticResource LinkButtonStyle}" Command="{Binding RelationModulesConfigCommand}" CommandParameter="{Binding EditModulesMethod, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:GlobalParamConfigPanal}}" />
          <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource TextBox.Static.Border}" Grid.Column="0" Grid.ColumnSpan="2" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ResetTemplate">
        <Button Margin="16,0,0,0" HorizontalAlignment="Center" Style="{StaticResource SyncDataBtnStyle2}" Command="{Binding SyncCommand}" />
      </DataTemplate>
      <DataTemplate x:Key="UpDownHead">
        <StackPanel Orientation="Horizontal" />
      </DataTemplate>
      <DataTemplate x:Key="DeleteTemplate">
        <Button Name="delete" Margin="8,0,0,0" Background="#00FFFFFF" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DataContext.DeleteParamCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding}">
          <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" Stretch="None" />
          <FrameworkElement.Tag>
            <Image Source="/Apps.XmlUI;component/Resources/delete_click.png" Stretch="None" />
          </FrameworkElement.Tag>
        </Button>
      </DataTemplate>
      <Style x:Key="ParamGroupItemStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupItem}">
              <Expander Name="groupContainer" Margin="8,0" BorderThickness="0" Style="{StaticResource ExpanderUnselectedStyle}" IsExpanded="{Binding Name.IsExpanded}">
                <HeaderedContentControl.Header>
                  <Grid Height="32">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="686" />
                      <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <Grid Column="0" Margin="5,8,0,8">
                      <appUi:HeadReNameTextBox Name="groupText" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Background="#00FFFFFF" MaxLength="{x:Static core:VmIO.MaxNameLenth}" Width="auto" FontWeight="Bold" Foreground="#4C4C4C" FontFamily="Microsoft YaHei" FontSize="14" Text="{Binding Name.Name, Mode=OneWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="LostFocus">
                            <UIHelper:ParamsEventCommand Command="{Binding Name.TextChangedCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </appUi:HeadReNameTextBox>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button ToolTip="{DynamicResource Lang_Rename}" Style="{StaticResource IcEditStyle}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="Click">
                            <core1:ChangePropertyAction i:TargetedTriggerAction.TargetName="groupText" xmlns:core1="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" PropertyName="IsReName" Value="True" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </Button>
                      <Button Margin="4,0,8,0" Style="{StaticResource DeleteButton}" Command="{Binding DataContext.DelGroupCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}" CommandParameter="{Binding Name}" />
                    </StackPanel>
                  </Grid>
                </HeaderedContentControl.Header>
                <ItemsPresenter />
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <UIHelper:ParamsEventCommand Command="{Binding Name.SelectCommand}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </Expander>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding Name.IsSelected}">
                  <Setter TargetName="groupContainer" Property="Style" Value="{StaticResource ExpanderSelectedStyle}" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Button x:Key="Com" HorizontalAlignment="Left" Margin="4,0" Height="36" Width="36" Style="{StaticResource TabAddButton}" Command="{Binding AddGlobalParamCommand}" />
      <Style x:Key="TabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Name="ColumnDefinition0" />
                  <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Name="RowDefinition0" Height="Auto" />
                  <RowDefinition Name="RowDefinition1" Height="*" />
                </Grid.RowDefinitions>
                <Border Name="head" Background="#FAFAFC" Height="38" BorderBrush="#CCC7C6" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                      <ScrollViewer Name="scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Style="{StaticResource titleBarShrinkScrollViewer}">
                        <StackPanel Name="stack" Orientation="Horizontal" HorizontalAlignment="Left">
                          <TabPanel Name="HeaderPanel" Grid.Column="0" Grid.Row="0" Margin="0" ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                          <Grid Name="Com" Width="36">
                            <ContentPresenter Name="ComContent" HorizontalAlignment="Center" Content="{x:Null}" />
                          </Grid>
                        </StackPanel>
                      </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                      <ContentPresenter Name="subComContent" Content="{x:Null}" />
                    </StackPanel>
                  </Grid>
                  <i:Interaction.Triggers>
                    <core1:DataTrigger xmlns:core1="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" Comparison="LessThan" core1:PropertyChangedTrigger.Binding="{Binding ActualWidth, ElementName=scroll}" Value="{Binding ActualWidth, ElementName=stack}">
                      <core1:ChangePropertyAction PropertyName="Content" i:TargetedTriggerAction.TargetObject="{Binding ElementName=ComContent}" Value="{x:Null}" />
                      <core1:ChangePropertyAction PropertyName="Content" Value="{DynamicResource Com}" i:TargetedTriggerAction.TargetObject="{Binding ElementName=subComContent}" />
                    </core1:DataTrigger>
                    <DataTrigger Comparison="GreaterThanOrEqual" p27:PropertyChangedTrigger.Binding="{Binding ActualWidth, ElementName=scroll}" Value="{Binding ActualWidth, ElementName=stack}" xmlns:p27="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions">
                      <p27:ChangePropertyAction PropertyName="Content" i:TargetedTriggerAction.TargetObject="{Binding ElementName=subComContent}" Value="{x:Null}" />
                      <p27:ChangePropertyAction PropertyName="Content" Value="{DynamicResource Com}" i:TargetedTriggerAction.TargetObject="{Binding ElementName=ComContent}" />
                    </DataTrigger>
                  </i:Interaction.Triggers>
                </Border>
                <Grid Name="PART_ItemsHolder" Column="0" Row="1" Background="#F2F3F5" />
                <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <controls:HikContextMenu x:Key="OperateMenu">
        <MenuItem Header="{DynamicResource Lang_Rename}" Command="{Binding RenameGlobalParamCommand}" />
        <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteGlobalParamCommand}" />
      </controls:HikContextMenu>
      <Style x:Key="TopTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource OperateMenu}" />
        <Setter Property="TabItem.IsSelected" Value="{Binding IsSelected}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Grid Name="Panel" ToolTip="{Binding Name}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="2" />
                </Grid.RowDefinitions>
                <ContentPresenter Name="ContentSite" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="0" />
                <Grid Name="bottomLine" Height="2" Row="1" VerticalAlignment="Bottom" Background="{DynamicResource Col_Theme}" Visibility="Hidden" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="Panel" Value="{DynamicResource Col_Theme_Light}" Property="Panel.Background" />
                  <Setter TargetName="bottomLine" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="TabItem.IsSelected" Value="False">
                  <Setter TargetName="Panel" Property="Panel.Background" Value="#FAFAFC" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="UpButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                <Image Name="img" Stretch="None" Source="/Apps.Style;component/Resources/ic_up_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="img" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_up_click.png" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="img" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_up_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DownButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                <Image Name="img" Stretch="None" Source="/Apps.Style;component/Resources/ic_down_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="img" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_down_click.png" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="img" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_down_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#f2f3f5" Focusable="True" MouseDown="Grid_MouseDown">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="267" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" BorderBrush="#E0DFDE" Background="#FFFFFF" BorderThickness="0,0,1,0">
      <Grid Background="#ffffff">
        <Grid.RowDefinitions>
          <RowDefinition Height="37" />
          <RowDefinition Height="37" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="#4c4c4c" Margin="12,0,0,0" Text="{DynamicResource Lang_ContentSelectList}" FontFamily="Microsoft YaHei" FontWeight="Bold" TextAlignment="Left" FontSize="14px" />
        <ToggleButton Grid.Row="0" Style="{StaticResource AllFoldUnfoldBtnStyle}" IsChecked="{Binding IsUnfold, Mode=TwoWay}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal">
          <ComboBox Name="SearchComboBox" Width="90" Height="32" Margin="12,0,8,0" SelectedIndex="0" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding SelectedType}" SelectedItem="{Binding ComboBoxSelectedItem, Mode=TwoWay}" ToolTip="{Lang:ResourceBinding SelectedValue, RelativeSource={RelativeSource Self}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource ContentTextBlock}" Text="{Lang:ResourceBinding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBox Name="searchWord" Style="{StaticResource textBoxStyle}" Text="{Binding SearchWord}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="TextChanged">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=searchWord}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
            <commomcontrol:SuperImageButton Grid.Column="1" Margin="-1,0,0,-1">
              <commomcontrol:SuperImageButton.NormalConnent>
                <Image Source="/Apps.XmlUI;component/Resources/ic_search_normal.png" Stretch="None" />
              </commomcontrol:SuperImageButton.NormalConnent>
              <commomcontrol:SuperImageButton.PressedConnent>
                <Image Source="/Apps.XmlUI;component/Resources/ic_search_click.png" Stretch="None" />
              </commomcontrol:SuperImageButton.PressedConnent>
              <commomcontrol:SuperImageButton.MOverConnent>
                <Image Source="/Apps.XmlUI;component/Resources/ic_search_hover.png" Stretch="None" />
              </commomcontrol:SuperImageButton.MOverConnent>
            </commomcontrol:SuperImageButton>
          </Grid>
        </StackPanel>
        <Border Grid.Row="2" Margin="2,5" BorderBrush="#E0DFDE">
          <TreeView Name="paramList" Style="{StaticResource EditParamTreeViewStyle}" HorizontalAlignment="Stretch" ItemsSource="{Binding EnumEntrysA}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localXmlParserTab:Holder}}" DataType="{x:Type localXmlParserTab:Holder}" ItemsSource="{Binding EnumEntrysA}">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding CheckEnabled}" Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}}" CommandParameter="{Binding}" />
                      <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Lang:ResourceBinding Name}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                    </StackPanel>
                  </Grid>
                </HierarchicalDataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </TreeView>
        </Border>
      </Grid>
    </Border>
    <Grid Column="1">
      <TabControl Style="{StaticResource TabControlStyle}" ItemContainerStyle="{StaticResource TopTabItemStyle}" ItemsSource="{Binding GlobalParamItems}" SelectedItem="{Binding SelectedGlobalItem}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="35" Width="76">
              <appUi:HeadReNameTextBox Name="headText" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Background="#00FFFFFF" MaxLength="64" MaxWidth="70" FontWeight="Bold" Foreground="#4D4D4D" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}" IsReName="{Binding IsReName, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Grid Background="#F2F3F5">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <CollectionViewSource x:Key="src" IsLiveGroupingRequested="True" Source="{Binding Collection}">
                    <CollectionViewSource.GroupDescriptions>
                      <PropertyGroupDescription PropertyName="GroupName" />
                    </CollectionViewSource.GroupDescriptions>
                  </CollectionViewSource>
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid>
                <Button Name="addButton" Width="100" Height="26" Margin="14,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource Orange_ButtonStyle}" Command="{Binding AddGroupCommand}">
                  <StackPanel Orientation="Horizontal">
                    <Image VerticalAlignment="Center" Margin="0,0,5,0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Image}">
                          <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板_normal.png" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding ElementName=addButton, Path=IsPressed}">
                              <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板_click.png" />
                            </DataTrigger>
                            <DataTrigger Value="True" Binding="{Binding ElementName=addButton, Path=IsMouseOver}">
                              <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板_click.png" />
                            </DataTrigger>
                            <DataTrigger Value="False" Binding="{Binding ElementName=addButton, Path=IsEnabled}">
                              <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板 _disable.png" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </Image>
                    <ContentControl VerticalAlignment="Center" Content="{DynamicResource Lang_AddGroup}" />
                  </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                  <ToggleButton Grid.Row="0" Style="{StaticResource AllFoldUnfoldBtnStyle}" IsChecked="{Binding IsUnfold, Mode=TwoWay}" />
                  <Button ToolTip="{DynamicResource MoveUp}" Style="{StaticResource UpButtonStyle}" Command="{Binding UpCommand}" />
                  <Button Margin="10,0,14,0" ToolTip="{DynamicResource MoveDown}" Style="{StaticResource DownButtonStyle}" Command="{Binding DownCommand}" />
                </StackPanel>
              </Grid>
              <Border Grid.Row="1" BorderBrush="#E0DFDE" Background="#FCFCFC" BorderThickness="1" Margin="14,0,14,12">
                <ScrollViewer Style="{StaticResource RecScrollViewer}" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                  <ListView SelectionMode="Single" Style="{StaticResource ListViewWithHeadStyle}" ItemsSource="{Binding Source={StaticResource src}}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <ListView.View>
                      <GridView ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeaderStyle}">
                        <GridViewColumn CellTemplate="{StaticResource PathGridViewCellTextBlock}" Width="150" />
