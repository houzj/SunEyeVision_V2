                        <GridViewColumn CellTemplate="{StaticResource TypeNameGridViewCellTextBlock}" Width="90" />
                        <GridViewColumn CellTemplate="{StaticResource RelationModulesConfigTemplate}" Width="210" />
                        <GridViewColumn CellTemplate="{StaticResource ResetTemplate}" Width="60" />
                        <GridViewColumn CellTemplate="{StaticResource DeleteTemplate}" Width="40" />
                      </GridView>
                    </ListView.View>
                    <ItemsControl.GroupStyle>
                      <GroupStyle ContainerStyle="{StaticResource ResourceKey=ParamGroupItemStyle}" />
                    </ItemsControl.GroupStyle>
                  </ListView>
                </ScrollViewer>
              </Border>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>
    <Rectangle Height="1" Grid.ColumnSpan="2" SnapsToDevicePixels="False" Fill="#C8C4C1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
  </Grid>
