<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="DynamicObjectConfigControl.Picker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:localXmlParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" Title="{DynamicResource 批量选择}" Height="420" Width="370">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localXmlParserTab:Holder}}" DataType="{x:Type localXmlParserTab:Holder}" ItemsSource="{Binding EnumEntrysA}">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Lang:ResourceBinding Name}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
        </HierarchicalDataTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Name="LeftPanel" Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <TextBlock Foreground="#4c4c4c" Margin="18,0,0,0" Text="{DynamicResource Lang_SelectList}" FontFamily="微软雅黑" FontWeight="Bold" TextAlignment="Left" FontSize="14" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="1" Margin="18,0,18,10" BorderBrush="#E0DFDE" BorderThickness="1">
        <Grid Background="#ffffff">
          <paramtab:CheckBoxConfigTreeView Name="outputConfigTreeView" FrameworkElement.Margin="10" ItemsSource="{Binding EnumEntrysA}">
            <!--Unknown connection ID: 2-->
          </paramtab:CheckBoxConfigTreeView>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#E4E5E7">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <CheckBox Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding IsNeedIncludeModuleName}" />
          <TextBlock Foreground="#4c4c4c" Text="{DynamicResource Lang_IsIncludeModuleName}" FontFamily="微软雅黑" TextAlignment="Left" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{DynamicResource Lang_Msg_Cancel}" Style="{StaticResource BottomButtonStyle}" Width="66" Height="24" Margin="0,0,15,0" Click="Canncel_OnClick" />
          <Button Content="{DynamicResource Confirm}" Style="{StaticResource BottomButtonStyle}" Width="66" Height="24" Margin="0,0,15,0" Click="Confirm_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</controls:BaseWindow>