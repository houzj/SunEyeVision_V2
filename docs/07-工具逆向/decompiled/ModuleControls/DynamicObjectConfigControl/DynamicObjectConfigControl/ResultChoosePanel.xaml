<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="DynamicObjectConfigControl.ResultChoosePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DynamicObjectConfigControl">
  <Control.Template>
    <ControlTemplate>
      <Grid Background="#f2f3f5" Focusable="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Bottom" Foreground="#4C4C4C" Margin="18,0,0,0" Text="{DynamicResource Lang_SelectList}" FontFamily="Microsoft YaHei" FontWeight="Bold" TextAlignment="Left" FontSize="14px" />
        <Border Grid.Row="1" BorderBrush="#E0DFDE" Background="#FFFFFF" BorderThickness="1" Margin="18,12,18,14">
          <local:DynamicRunParamRelationModulesConfig MaxHeight="360" ItemsSource="{Binding EnumEntrysA}" />
        </Border>
        <Rectangle Grid.Row="1" Height="1" SnapsToDevicePixels="False" Fill="#C8C4C1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>