<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DynamicObjectConfigControl" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:DisplayForGroupControl="clr-namespace:Apps.XmlUI.ParamTabControl.DisplayForGroupControl;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:UIHelper="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:paramtab="clr-namespace:Apps.XmlParser.ParamTab">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="TextBlockBold" TargetType="{x:Type TextBlock}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Microsoft YaHei-Bold" />
    <Setter Property="Foreground" Value="#4C4C4C" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <DataTemplate x:Key="RegularSend">
    <Border BorderThickness="1" BorderBrush="#e0dfde" Margin="0,5,20,5">
      <Grid Margin="5" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" Height="auto" Width="auto">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="5,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Lang_Comm}" HorizontalAlignment="Left" Style="{StaticResource TextBlockBold}" />
          <TextBlock Style="{StaticResource TextBlockBold}" Text="{Binding DisplayIndex}" />
        </StackPanel>
        <Border Grid.Column="2" Width="32" Height="32" BorderThickness="1" BorderBrush="#d3d2d2" Background="#eceaea" CornerRadius="2" Visibility="{Binding DelBtnVisible, Converter={StaticResource bool2VisibilityConverter}}">
          <Button Name="Del" HorizontalAlignment="Right" Background="#eceaea" Style="{StaticResource BaseImageConfig_DeleteButtonStyle}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
        </Border>
        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Lang_TimeInterval}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding SetInterval}" />
        <Label Grid.Row="2" Content="{DynamicResource Lang_SendAddress}" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Height="32" ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding CommDeviceSelecterA}" />
            <Border Grid.Row="2" Margin="2,0,0,0" Grid.Column="1" Width="30" Height="30" BorderThickness="1" BorderBrush="#d3d2d2" Background="#eceaea" CornerRadius="2">
              <Button Grid.Column="1" Margin="-2,-2,0,0" ToolTip="{DynamicResource Lang_CommSet}" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
                <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_modal_communication_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_modal_communication_click.png" />
                </FrameworkElement.Tag>
              </Button>
            </Border>
          </Grid>
          <ContentControl ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding PLCVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding AddressItemListA}" />
        </StackPanel>
        <Label Grid.Row="3" Content="{DynamicResource Lang_ConditionalJudgement}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecterIfJudge}" />
        <Label Grid.Row="4" Content="{DynamicResource Lang_OKSend}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource Boolean2VisibilityReverse}}" Content="{Binding FilterSelecterOKInput}" />
        <ContentControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding IOItemOKSendListA}" />
        <Label Grid.Row="5" Content="{DynamicResource Lang_NGSend}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource Boolean2VisibilityReverse}}" Content="{Binding FilterSelecterNGInput}" />
        <ContentControl Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding IOItemNGSendListA}" />
        <Label Grid.Row="6" Content="{DynamicResource Lang_TimeoutSend}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource Boolean2VisibilityReverse}}" Content="{Binding FilterSelecterTimeoutSend}" />
        <ContentControl Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding IOItemTimeoutSendListA}" />
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="EndSend">
    <Border BorderThickness="1" BorderBrush="#e0dfde" Margin="5">
      <Grid Margin="5" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" Height="auto" Width="auto">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="5,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Lang_Comm}" HorizontalAlignment="Left" Style="{StaticResource TextBlockBold}" />
          <TextBlock Style="{StaticResource TextBlockBold}" Text="{Binding DisplayIndex}" />
        </StackPanel>
        <Border Grid.Column="2" Width="32" Height="32" BorderThickness="1" BorderBrush="#d3d2d2" Background="#eceaea" CornerRadius="2" Visibility="{Binding DelBtnVisible, Converter={StaticResource bool2VisibilityConverter}}">
          <Button Name="Del" HorizontalAlignment="Right" Background="#eceaea" Style="{StaticResource BaseImageConfig_DeleteButtonStyle}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
        </Border>
        <Label Grid.Row="1" Content="{DynamicResource Lang_SendAddress}" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Height="32" ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding CommDeviceSelecterA}" />
            <Border Grid.Row="2" Margin="2,0,0,0" Grid.Column="1" Width="30" Height="30" BorderThickness="1" BorderBrush="#d3d2d2" Background="#eceaea" CornerRadius="2">
              <Button Grid.Column="1" Margin="-2,-2,0,0" ToolTip="{DynamicResource Lang_ControllerSet}" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
                <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_modal_communication_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_modal_communication_click.png" />
                </FrameworkElement.Tag>
              </Button>
            </Border>
          </Grid>
          <ContentControl ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding PLCVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding AddressItemListA}" />
        </StackPanel>
        <Label Grid.Row="2" Content="{DynamicResource Lang_ConditionalJudgement}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecterIfJudge}" />
        <Label Grid.Row="3" Content="{DynamicResource Lang_OKSend}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource Boolean2VisibilityReverse}}" Content="{Binding FilterSelecterOKInput}" />
        <ContentControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding IOItemOKSendListA}" />
        <Label Grid.Row="4" Content="{DynamicResource Lang_NGSend}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource Boolean2VisibilityReverse}}" Content="{Binding FilterSelecterNGInput}" />
        <ContentControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ContentTemplate="{StaticResource Enumeration_Sub}" Visibility="{Binding IOVisibleA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding IOItemNGSendListA}" />
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="ProcedureComm_Container">
    <Grid Background="#fcfcfc">
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{DynamicResource Lang_SendMode}" FontSize="14" FontWeight="ExtraBold" FontFamily="Microsoft YaHei" Foreground="#4C4C4C" />
        <RadioButton Grid.Column="1" Foreground="#666666" Content="{DynamicResource Lang_ScheduleSend}" Margin="50,0,0,0" CommandParameter="IsRegular" Style="{StaticResource Check_RadioButtonStyle}" IsChecked="{Binding IsRegularChecked}" Command="{Binding IsCheckedCommand}" />
        <RadioButton Name="EndSendRadioButton" Grid.Column="1" Foreground="#666666" Content="{DynamicResource Lang_EndSend}" Margin="50,0,0,0" CommandParameter="IsEnd" Style="{StaticResource Check_RadioButtonStyle}" IsChecked="{Binding IsEndChecked}" Command="{Binding IsCheckedCommand}" />
      </StackPanel>
      <Grid Row="1" Margin="18,0,2,0" VerticalAlignment="Top">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl Style="{StaticResource ScrollItemsControlStyle}" ItemsSource="{Binding ObservableCollectionA}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" Margin="0,5,0,0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ContentControl Content="{Binding}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="ContentTemplate" Value="{StaticResource RegularSend}" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsChecked, ElementName=EndSendRadioButton}">
                        <Setter Property="ContentTemplate" Value="{StaticResource EndSend}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContentControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,6">
          <Button Name="Add" Margin="5,6,0,0" HorizontalAlignment="Left" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="false" Binding="{Binding IsEditState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=appxmlUI:ParamsTabUserControl}}">
        <Setter TargetName="Add" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="GroupCommunicationParam">
    <Grid>
      <ContentControl Name="bsItem" ContentTemplate="{StaticResource ProcedureComm_Container}" Content="{Binding BridgeObjA}" />
      <interactivity:Interaction.Triggers xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
        <interactivity:EventTrigger xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" EventName="PreviewMouseWheel">
          <interactivity:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=bsItem}" />
        </interactivity:EventTrigger>
      </interactivity:Interaction.Triggers>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="GroupInputParam">
    <local:DynamicIOConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="GroupDisplayParam">
    <local:DynamicDisplayObjectConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="GroupRunParam">
    <local:DynamicRunParamConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="DynamicNameValueItemOfGroup">
    <Grid>
      <appxmlUI:ParamUserControl Name="con" FrameworkElement.DataContext="{Binding CloneSource}" ExternDisplayType="{Binding Path=(VMInterface:IGroupRunParam.DisplayForGroupType)}" />
      <Border Name="bd" Background="#00FFFFFF" Visibility="Collapsed">
        <Rectangle Height="1" SnapsToDevicePixels="False" Fill="#FFFF0000" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20" />
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="false" Binding="{Binding IsRelationEnable}">
        <Setter TargetName="bd" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="con" Property="UIElement.IsEnabled" Value="False" />
        <Setter Value="{DynamicResource Incorrelation}" TargetName="bd" Property="FrameworkElement.ToolTip" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ROISelecter_GroupControl">
    <local:ModuleROIConfigControl />
  </DataTemplate>
  <DataTemplate x:Key="GlobalRunParam">
    <local:ComprehensiveConfigControl />
  </DataTemplate>
</ResourceDictionary>