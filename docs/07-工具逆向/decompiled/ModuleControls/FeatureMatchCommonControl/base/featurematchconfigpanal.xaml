<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FeatureMatchCommonControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="ImageButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
            <ContentPresenter Name="con" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
              <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="TextBoxControlTemplate1" TargetType="{x:Type TextBox}">
    <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="0" Background="#00FFFFFF" Focusable="False" Uid="Border_17">
      <ScrollViewer Name="PART_ContentHost" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" Uid="ScrollViewer_1" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" />
    </Border>
  </ControlTemplate>
  <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
  <Style x:Key="{x:Type local:FeatureMatchConfigPanal}" TargetType="{x:Type local:FeatureMatchConfigPanal}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FeatureMatchConfigPanal}">
          <Border BorderBrush="#FFEADFDE" BorderThickness="1" CornerRadius="1">
            <Grid>
              <Grid Name="mainView" Background="#FFFCFCFC">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#FFEADFDE" BorderThickness="0,0,1,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                  <Grid Column="0" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="33" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="2" Grid.Row="0">
                      <StackPanel Orientation="Horizontal">
                        <commomcontrol:SuperImageButton Name="Build" Height="20" Command="{Binding Decorate.AddModelCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                          <commomcontrol:SuperImageButton.NormalConnent>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="/Apps.XmlUI;component/Resources/FM_ic_Creat_normal.png" />
                              <TextBlock VerticalAlignment="Center" Padding="6,0,0,0" Foreground="#FF808080" Text="{DynamicResource 创建}" />
                            </StackPanel>
                          </commomcontrol:SuperImageButton.NormalConnent>
                          <commomcontrol:SuperImageButton.PressedConnent>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="/Apps.XmlUI;component/Resources/FM_ic_Creat_focus.png" />
                              <TextBlock VerticalAlignment="Center" Padding="6,0,0,0" Foreground="#FF808080" Text="{DynamicResource 创建}" />
                            </StackPanel>
                          </commomcontrol:SuperImageButton.PressedConnent>
                          <commomcontrol:SuperImageButton.MOverConnent>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="/Apps.XmlUI;component/Resources/FM_ic_Creat_focus.png" />
                              <TextBlock VerticalAlignment="Center" Padding="6,0,0,0" Foreground="#FF808080" Text="{DynamicResource 创建}" />
                            </StackPanel>
                          </commomcontrol:SuperImageButton.MOverConnent>
                        </commomcontrol:SuperImageButton>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <commomcontrol:SuperImageButton Name="LoadModule" Height="20" Command="{Binding Decorate.LoadModuleCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                          <commomcontrol:SuperImageButton.NormalConnent>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="/Apps.XmlUI;component/Resources/FM_ic_Load_normal.png" />
                              <TextBlock VerticalAlignment="Center" Padding="6,0,0,0" Foreground="#FF808080" Text="{DynamicResource 载入}" />
                            </StackPanel>
                          </commomcontrol:SuperImageButton.NormalConnent>
                          <commomcontrol:SuperImageButton.PressedConnent>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="/Apps.XmlUI;component/Resources/FM_ic_Load_focus.png" />
                              <TextBlock VerticalAlignment="Center" Padding="6,0,0,0" Foreground="#FF808080" Text="{DynamicResource 载入}" />
                            </StackPanel>
                          </commomcontrol:SuperImageButton.PressedConnent>
                          <commomcontrol:SuperImageButton.MOverConnent>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="/Apps.XmlUI;component/Resources/FM_ic_Load_focus.png" />
                              <TextBlock VerticalAlignment="Center" Padding="6,0,0,0" Foreground="#FF808080" Text="{DynamicResource 载入}" />
                            </StackPanel>
                          </commomcontrol:SuperImageButton.MOverConnent>
                        </commomcontrol:SuperImageButton>
                      </StackPanel>
                    </UniformGrid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#FFEADFDE">
                      <ListView Name="ModelList" FontSize="14" Foreground="#FF666666" BorderThickness="0" AlternationCount="2" Background="#00FFFFFF" Style="{StaticResource ListViewStyle1}" ItemsSource="{Binding Decorate.ModelList, IsAsync=True, Mode=OneTime, RelativeSource={RelativeSource Mode=TemplatedParent}}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                        <FrameworkElement.Resources>
                          <ResourceDictionary>
                            <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="{x:Type GridViewColumnHeader}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                          </ResourceDictionary>
                        </FrameworkElement.Resources>
                        <ListView.View>
                          <GridView>
                            <GridViewColumn Header="{DynamicResource Number}" x:Name="Index" Width="28">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <TextBlock Name="ModelId" Text="{Binding Index}" ToolTip="{Binding Index}" />
                                  </Grid>
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource 模板名称}" x:Name="Name" Width="92">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <TextBox Name="ModelName" MaxLength="63" MinWidth="80" MinHeight="20" Template="{StaticResource TextBoxControlTemplate1}" Text="{Binding Name}" ToolTip="{Binding Name}" IsEnabled="{Binding IsCorrect}">
                                      <interactivity:Interaction.Triggers xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
                                        <interactivity:EventTrigger xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" EventName="LostFocus">
                                          <interactivity:InvokeCommandAction Command="{Binding ModelNameTextChangedCommand}" CommandParameter="{Binding ElementName=ModelName}" />
                                        </interactivity:EventTrigger>
                                        <interactivity:EventTrigger EventName="GotFocus">
                                          <interactivity:InvokeCommandAction Command="{Binding ModelNameGotFocusCommand}" CommandParameter="{Binding ElementName=ModelList}" />
                                        </interactivity:EventTrigger>
                                      </interactivity:Interaction.Triggers>
                                    </TextBox>
                                  </Grid>
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource Lang_Operate}" x:Name="Opration" Width="106">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="1" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="1" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="1" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="1" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Name="up" Height="24" Grid.Column="1" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle}" Command="{Binding Decorate.UpCommand, RelativeSource={RelativeSource AncestorType=local:FeatureMatchConfigPanal}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Mode=Self}}">
                                      <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_normal.png" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" />
                                      </FrameworkElement.Tag>
                                    </Button>
                                    <Button Name="down" Height="24" Grid.Column="3" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle}" Command="{Binding Decorate.DownCommand, RelativeSource={RelativeSource AncestorType=local:FeatureMatchConfigPanal}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Mode=Self}}">
                                      <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_normal.png" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" />
                                      </FrameworkElement.Tag>
                                    </Button>
                                    <Button Name="delete" Height="24" Grid.Column="5" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle}" Command="{Binding Decorate.DelCommand, RelativeSource={RelativeSource AncestorType=local:FeatureMatchConfigPanal}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Mode=Self}}">
                                      <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/delete_click.png" />
                                      </FrameworkElement.Tag>
                                    </Button>
                                    <CheckBox Name="select" Height="24" Grid.Column="7" Background="#00FFFFFF" ToolTip="{DynamicResource Tab_AddSearchList}" Style="{StaticResource NormalCheckBoxStyle}" IsChecked="{Binding IsSelected}" Command="{Binding Decorate.SelectedCommand, RelativeSource={RelativeSource AncestorType=local:FeatureMatchConfigPanal}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Mode=Self}}">
                                      <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
                                    </CheckBox>
                                  </Grid>
                                  <DataTemplate.Triggers>
                                    <DataTrigger Value="true" Binding="{Binding Decorate.HasUnCorrect, RelativeSource={RelativeSource AncestorType=local:FeatureMatchConfigPanal}}">
                                      <Setter TargetName="up" Property="IsEnabled" Value="False" />
                                      <Setter TargetName="down" Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                  </DataTemplate.Triggers>
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                          </GridView>
                        </ListView.View>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="{x:Type ListViewItem}">
                            <Style.Setters>
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border Name="bd" BorderThickness="0" SnapsToDevicePixels="True" Background="#FFFFFFFF" Height="30">
                                      <GridViewRowPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Border.Background" Value="#FFF2F4F7" />
                                      </Trigger>
                                      <DataTrigger Value="false" Binding="{Binding IsCorrect}">
                                        <Setter TargetName="bd" Property="Border.BorderThickness" Value="1" />
                                        <Setter TargetName="bd" Property="Border.BorderBrush" Value="#FFFF0000" />
                                        <Setter Value="{DynamicResource 模型加载失败}" Property="FrameworkElement.ToolTip" />
                                      </DataTrigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style.Setters>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                      </ListView>
                    </Border>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                  <Image Name="imageView" Margin="11,11,11,0" Width="98" Height="98" Source="{Binding Decorate.ImageSource, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                  <Button Name="btnEditTemplate" Height="24" Width="98" VerticalAlignment="Top" Margin="7" Content="{DynamicResource 编辑模板}" Style="{StaticResource BottomButtonStyle}" Command="{Binding Decorate.ChangeModelCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}" CommandParameter="{Binding EditModelMethod, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                  <Button Name="btnDeleteAllModels" Height="24" Width="98" VerticalAlignment="Top" Margin="7" Content="{DynamicResource 删除所有模板}" Style="{StaticResource BottomButtonStyle}" Command="{Binding Decorate.DeleteAllModelsCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Mode=Self}}" Value="{x:Null}">
              <Setter TargetName="imageView" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_image.png" />
              <Setter TargetName="btnEditTemplate" Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Value="false" Binding="{Binding SelectedItem.IsCorrect, RelativeSource={RelativeSource Mode=Self}}">
              <Setter TargetName="imageView" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_image.png" />
              <Setter TargetName="btnEditTemplate" Property="IsEnabled" Value="False" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>