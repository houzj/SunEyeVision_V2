<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="FewShotCommonControl.AddCategoryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:local="clr-namespace:FewShotCommonControl" xmlns:PCListView="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" x:Name="addCategory" Title="{DynamicResource Lang_AddNewCategory}" Height="350" Width="450">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}" />
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource addButton}" />
      <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate DataType="local:CategoryData">
              <Grid Margin="0,0,0,5">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NormalTextBoxStyle}" />
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="7*" />
                  <ColumnDefinition Width="4*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="30" Foreground="#666666" MaxLength="256" Margin="0,0,10,0" Text="{Binding CategoryName}" />
                <PCListView:ColorPickerControlView Grid.Column="1" Width="115" CurrentColor="{Binding LabelColor, Mode=TwoWay}" />
                <Button Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource deleteButton}" Click="DeleteCategory_OnClick" />
              </Grid>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource Col_SubForm_Background}" UseLayoutRounding="True">
    <Grid Margin="20,10,18,5">
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
        <RowDefinition Height="35" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="7*" />
          <ColumnDefinition Width="4*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Lang_CategoryName}" />
        <TextBlock Grid.Column="1" Text="{DynamicResource Lang_LabelColor}" />
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top">
        <ScrollViewer Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="200">
          <ItemsControl Name="controlItem" ItemsSource="{Binding ElementName=addCategory, Path=NewCategories}" />
        </ScrollViewer>
        <Button VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0" Click="AddCategory_OnClick" />
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" ToolTip="{DynamicResource Confirm}" Click="Confirm_OnClick" />
      </StackPanel>
    </Grid>
  </Grid>
</controls:BaseWindow>