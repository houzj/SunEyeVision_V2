<?xml version="1.0" encoding="utf-8"?>
<pcUI:ConfirmBaseWindow x:Class="FewShotCommonControl.EditCategoryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FewShotCommonControl" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:PCListView="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:pcUI="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" x:Name="editCategory" Title="{DynamicResource Lang_EditCategory}" Height="160" Width="420" CancelVisible="Collapsed">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}" />
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NormalTextBoxStyle}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource Col_SubForm_Background}">
    <Grid Margin="20,10,18,5">
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7*" />
        <ColumnDefinition Width="4*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Lang_CategoryName}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Lang_LabelColor}" />
      <TextBox Grid.Row="1" Grid.Column="0" Height="30" Foreground="#666666" MaxLength="256" Margin="0,0,10,0" Text="{Binding CategoryName}" />
      <PCListView:ColorPickerControlView HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Height="30" Width="120" CurrentColor="{Binding LabelColor, Mode=TwoWay}" />
    </Grid>
    <Rectangle Height="1" SnapsToDevicePixels="False" Fill="#C8C4C1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
  </Grid>
</pcUI:ConfirmBaseWindow>