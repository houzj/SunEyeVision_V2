<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FewShotCommonControl.FewShotEdgeLearningPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:local="clr-namespace:FewShotCommonControl" x:Name="ELPanel">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.ColorFun;component/ColorStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:BooleanToStringConvert x:Key="BTS" />
      <local:BooleanConvert x:Key="BC" />
      <Style x:Key="ParamNameStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FrameworkElement.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
      </Style>
      <Style x:Key="CellBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <ScrollViewer Background="#00FFFFFF" BorderBrush="#00FFFFFF" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="5,0,5,0" PreviewMouseWheel="ModelList_PreviewMouseWheel">
        <Grid Background="#00FFFFFF" Margin="18,18,18,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Button Name="btnAddTemplate" Height="26" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource Add_ButtonStyle}" Content="{DynamicResource Lang_RegisterImage}" Width="{Binding RegisterButtonWidth, ElementName=ELPanel}" Click="RegisterImage_Click" />
          <commomcontrol:SuperImageButton Name="LoadModel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,64,0" ToolTip="{DynamicResource 导入}" Click="LoadModel_Click">
            <commomcontrol:SuperImageButton.NormalConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导入_normal.png" Stretch="None" />
            </commomcontrol:SuperImageButton.NormalConnent>
            <commomcontrol:SuperImageButton.DisableConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导入_disabkle.png" Stretch="None" />
            </commomcontrol:SuperImageButton.DisableConnent>
            <commomcontrol:SuperImageButton.PressedConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.PressedConnent>
            <commomcontrol:SuperImageButton.MOverConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.MOverConnent>
          </commomcontrol:SuperImageButton>
          <commomcontrol:SuperImageButton Name="SaveModel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,32,0" ToolTip="{DynamicResource 导出}" IsEnabled="{Binding IsRegisterOK, ElementName=ELPanel}" Click="ExportModel_Click">
            <commomcontrol:SuperImageButton.NormalConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_normal.png" Stretch="None" />
            </commomcontrol:SuperImageButton.NormalConnent>
            <commomcontrol:SuperImageButton.DisableConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_disable.png" Stretch="None" />
            </commomcontrol:SuperImageButton.DisableConnent>
            <commomcontrol:SuperImageButton.PressedConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.PressedConnent>
            <commomcontrol:SuperImageButton.MOverConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.MOverConnent>
          </commomcontrol:SuperImageButton>
          <commomcontrol:SuperImageButton Name="DeleteModel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" ToolTip="{DynamicResource Lang_Delet}" IsEnabled="{Binding IsRegisterOK, ElementName=ELPanel}" Click="ClearModel_Click">
            <commomcontrol:SuperImageButton.NormalConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" Stretch="None" />
            </commomcontrol:SuperImageButton.NormalConnent>
            <commomcontrol:SuperImageButton.DisableConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_disable.png" Stretch="None" />
            </commomcontrol:SuperImageButton.DisableConnent>
            <commomcontrol:SuperImageButton.PressedConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.PressedConnent>
            <commomcontrol:SuperImageButton.MOverConnent>
              <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.MOverConnent>
          </commomcontrol:SuperImageButton>
          <Border Grid.Row="1" CornerRadius="1" BorderBrush="#FCFCFC" Background="#FCFCFC" BorderThickness="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Lang_ModelData}" Style="{StaticResource ParamNameStyle}" FontWeight="Bold" VerticalAlignment="Center" />
              <Border Grid.Row="1" BorderBrush="#FF000000" BorderThickness="1" Margin="10,10,10,0">
                <Grid Name="viewGrid">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Row="0" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource HasAngle}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding IsHasAngle, ElementName=ELPanel, Converter={StaticResource BC}}" />
                  </Border>
                  <Border Grid.Row="1" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource TrainImageNums}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding TrainImageNum, ElementName=ELPanel}" />
                  </Border>
                  <Border Grid.Row="2" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource TrainInstanceNums}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="2" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding TrainInstanceNum, ElementName=ELPanel}" />
                  </Border>
                  <Border Grid.Row="3" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource ELClassNums}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="3" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding ClassNum, ElementName=ELPanel}" />
                  </Border>
                  <Border Grid.Row="4" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource ClassTags}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding xxx}" />
                  </Border>
                  <Border Grid.Row="4" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding ClassTag, ElementName=ELPanel}" />
                  </Border>
                  <Border Grid.Row="5" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource Epoch}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="5" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding Epoch, ElementName=ELPanel}" />
                  </Border>
                  <Border Grid.Row="6" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource 颜色增强}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="6" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding ColorEnhanceEnable, ElementName=ELPanel, Converter={StaticResource BTS}}" />
                  </Border>
                  <Border Grid.Row="7" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource 翻转增强}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="7" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding FlipEnhanceEnable, ElementName=ELPanel, Converter={StaticResource BTS}}" />
                  </Border>
                  <Border Grid.Row="8" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource 旋转增强}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="8" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding RotateEnhanceEnable, ElementName=ELPanel, Converter={StaticResource BTS}}" />
                  </Border>
                  <Border Grid.Row="9" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="0,0,0,0">
                    <TextBlock Text="{DynamicResource 缩放增强}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" />
                  </Border>
                  <Border Grid.Row="9" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1,0,0,0">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ParamNameStyle}" Text="{Binding ResizeEnhanceEnable, ElementName=ELPanel, Converter={StaticResource BTS}}" />
                  </Border>
                </Grid>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsRegisterOK, ElementName=ELPanel}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </ControlTemplate>
  </Control.Template>
</UserControl>