                  <Border Background="#303033" MinWidth="140" MinHeight="60" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LogicTypeFG}">
                    <StackPanel>
                      <Button Content="{DynamicResource Lang_CurImage}" HorizontalAlignment="Stretch" Height="30" Style="{StaticResource MenuButton}" Command="{Binding AddCurImageCommand}">
                        <interactivity:Interaction.Triggers xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
                          <interactivity:EventTrigger xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" EventName="Click">
                            <core:ChangePropertyAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" PropertyName="IsOpen" Value="false" interactivity:TargetedTriggerAction.TargetObject="{Binding ElementName=Popup}" />
                          </interactivity:EventTrigger>
                        </interactivity:Interaction.Triggers>
                      </Button>
                      <Button Content="{DynamicResource Lang_CacheImage}" HorizontalAlignment="Stretch" Height="30" Style="{StaticResource MenuButton}" Command="{Binding AddCacheImageCommand}">
                        <Interaction.Triggers xmlns="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
                          <EventTrigger EventName="Click">
                            <ChangePropertyAction PropertyName="IsOpen" Value="false" p28:TargetedTriggerAction.TargetObject="{Binding ElementName=Popup}" xmlns:p28="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                          </EventTrigger>
                        </Interaction.Triggers>
                      </Button>
                      <Button Content="{DynamicResource Lang_ImportLocalImage}" HorizontalAlignment="Stretch" Height="30" Style="{StaticResource MenuButton}" Command="{Binding AddImageCommand}" />
                      <Button Content="{DynamicResource Lang_ImportFolder}" HorizontalAlignment="Stretch" Height="30" Style="{StaticResource MenuButton}" Command="{Binding AddImageDirCommand}" />
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_click.png" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Btn_RoiType" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource showCrossToggleButtonStyle}">
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="False" Binding="{Binding ROIHitTestVisible, ElementName=window}" />
              <Condition Value="True" Binding="{Binding IsChecked, ElementName=Arrow}" />
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.Setters>
              <Setter Property="IsEnabled" Value="False" />
            </MultiDataTrigger.Setters>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Btn_StyleLeft" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Image Name="ImageBackground" Width="26" Height="54" Source="/Apps.XmlUI;component/Resources/leftarrow_normal.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/leftarrow_hover.png" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/leftarrow_press.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/leftarrow_disabled.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxStyle1" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="1,0,1,1" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Control.Padding}" Tag="1" Style="{StaticResource RecScrollViewer}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource {x:Static SystemColors.ControlBrushKey}}" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxItemStyle1" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid SnapsToDevicePixels="True" Margin="2">
                <Border Name="Border" Background="#00FFFFFF" CornerRadius="2" BorderBrush="{DynamicResource GlobalRectFill}" BorderThickness="1" />
                <ContentPresenter />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  <Setter TargetName="Border" Property="Border.BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxItemStyle2" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid SnapsToDevicePixels="True" Margin="20,2,0,2">
                <Border Name="Border" Background="#00FFFFFF" CornerRadius="2" BorderBrush="{DynamicResource GlobalRectFill}" BorderThickness="1" />
                <ContentPresenter />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  <Setter TargetName="Border" Property="Border.BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ParamNameStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FrameworkElement.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
      </Style>
      <Style x:Key="BottomLineButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Background" Value="{DynamicResource ButtonForground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
        <Setter Property="FontSize" Value="12px" />
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <controls:FouerColorBorder Name="Border" CornerRadius="2" BottomBorderBrush="{DynamicResource Col_Theme}" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1,1,1,1">
                <ContentPresenter Name="con" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </controls:FouerColorBorder>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#FFF76900" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Background" Value="#80F2F2F2" />
                  <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
                  <Setter Property="BorderBrush" Value="#80CCCCCC" />
                  <Setter TargetName="Border" Property="controls:FouerColorBorder.BottomBorderBrush" Value="#80F76900" />
                </Trigger>
                <DataTrigger Value="0" Binding="{Binding TotalImageCount}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsShowMask}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Interaction.Triggers xmlns="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
    <EventTrigger EventName="Closing">
      <commomcontrol:ParamsEventCommand Command="{Binding ClosingCommand}" />
    </EventTrigger>
  </Interaction.Triggers>
  <Grid Name="mainGrid" Background="{DynamicResource Col_SubForm_Background}" UseLayoutRounding="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="13" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="14,0,14,13" Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>
      <Border Background="#FFFFFFFF" BorderThickness="1" BorderBrush="{DynamicResource GlobalRectFill}" Width="{Binding PageLeftWidth, ElementName=registerImage}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="146" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <RadioButton Name="Arrow" GroupName="ty" CommandParameter="0" IsChecked="True" Background="#00FFFFFF" Visibility="Collapsed" ToolTip="{DynamicResource 移动图像}" Style="{StaticResource showCrossToggleButtonStyle}" Command="{Binding DrawROICommand}">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_click.png" />
                </FrameworkElement.Tag>
              </RadioButton>
              <RadioButton Name="rectRoi" GroupName="ty" CommandParameter="3" Background="#00FFFFFF" ToolTip="{DynamicResource 创建矩形掩膜}" Style="{StaticResource Btn_RoiType}" Command="{Binding DrawROICommand}">
                <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_绘制矩形_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_绘制矩形_click.png" />
                </FrameworkElement.Tag>
              </RadioButton>
              <RadioButton Name="Polygon" GroupName="ty" CommandParameter="1" Background="#00FFFFFF" ToolTip="{DynamicResource 创建多边形掩膜}" Style="{StaticResource Btn_RoiType}" Command="{Binding DrawROICommand}">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制多边形_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制多边形_click.png" />
                </FrameworkElement.Tag>
              </RadioButton>
              <RadioButton Name="PolygonEx" GroupName="ty" CommandParameter="2" Background="#00FFFFFF" ToolTip="{DynamicResource ExternROI Creation}" Style="{StaticResource Btn_RoiType}" Command="{Binding DrawROICommand}">
                <Image Stretch="None" Source="/Apps.Style;component/Resources/window_shieldPolygon_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.Style;component/Resources/window_shieldPolygon_click.png" />
                </FrameworkElement.Tag>
              </RadioButton>
            </StackPanel>
            <UniformGrid Columns="4" Width="150" HorizontalAlignment="Right">
              <controls1:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookImageViewBox="{Binding ElementName=imageView}" />
              <controls1:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookImageViewBox="{Binding ElementName=imageView}" />
              <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="RegionScale_Click" />
              <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="FullScreen_Click" />
            </UniformGrid>
          </Grid>
          <Grid Name="viewGrid" Row="1">
            <imageView:ImageViewBox Name="imageView" Margin="2,0" ROIVisible="True" IsDisplayPixelAuto="True" IsMenuVisible="True" ROITypeUI="True" IsPasteInSelectedSubROIList="True" ImageDataSource="{Binding CurImage.ImageSource}" ShapeList="{Binding ShapeList}" ROIList="{Binding ROIList}" DrawROIType="{Binding ROIRoot.SelectedROI.DrawROIType}" IsStateForDrawROI="{Binding ROIRoot.SelectedROI.IsStateForDrawROI}" RoiAddCommand="{Binding ROIRoot.SelectedROI.AddROICommand}" SelectedSubROIList="{Binding CurROIList}" ImageSizeChangedCommand="{Binding ROIRoot.ImageSizeChangedCommand}" RoiSelectedCommand="{Binding ROIRoot.RoiSelectedCommand}" RoiDelCommand="{Binding ROIRoot.RoiDelCommand}" RoiCopyCommand="{Binding ROIRoot.RoiCopyCommand}" RoiPasteCommand="{Binding RoiPasteCommand}" RoiVisibleChangedCommand="{Binding ROIRoot.RoiVisibleChangedCommand}" ROIHitTestVisible="{Binding ROIHitTestVisible, Mode=TwoWay, ElementName=window}" RoiAddEvent="imageView_RoiAddEvent">
              <Interaction.Triggers xmlns="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
                <EventTrigger EventName="RoiAddEvent">
