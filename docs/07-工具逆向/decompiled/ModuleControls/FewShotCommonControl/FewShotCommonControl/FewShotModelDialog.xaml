<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="FewShotCommonControl.FewShotModelDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:imageView="clr-namespace:VMBaseControls;assembly=VMBaseControls" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:controls1="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:wpfcontrol="clr-namespace:VMControls.WPF;assembly=VMControls.WPF" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:local="clr-namespace:FewShotCommonControl" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" x:Name="window" Title="{DynamicResource Lang_RegisterImage}" Height="680" Width="1100">
  <FrameworkElement.Resources>
