                </EventTrigger>
                <EventTrigger EventName="RoiDeleteEvent">
                  <commomcontrol:ParamsEventCommand Command="{Binding ROIChangedCommand}" />
                </EventTrigger>
                <EventTrigger EventName="RoiParamChangedEvent">
                  <commomcontrol:ParamsEventCommand Command="{Binding ROIChangedCommand}" />
                </EventTrigger>
              </Interaction.Triggers>
            </imageView:ImageViewBox>
            <Button Name="btnLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Width="26" Height="54" Style="{StaticResource Btn_StyleLeft}" CommandParameter="Last" Command="{Binding ChangeCurImageCommand}">
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/leftarrow_normal.png" />
            </Button>
            <Button Name="btnRight" HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="54" Style="{StaticResource Btn_StyleLeft}" CommandParameter="Next" RenderTransformOrigin="0.5,0.5" Command="{Binding ChangeCurImageCommand}">
