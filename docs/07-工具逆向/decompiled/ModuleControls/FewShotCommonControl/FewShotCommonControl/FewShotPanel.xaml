<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="FewShotCommonControl.FewShotPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:fewshotcommoncontrol="clr-namespace:FewShotCommonControl;assembly=FewShotCommonControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Background="#00FFFFFF" Margin="18,18,18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="41" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button Name="btnAddTemplate" Height="26" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource Add_ButtonStyle}" Content="{DynamicResource Lang_RegisterImage}" Width="{Binding RegisterButtonWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" Click="btnAddTemplate_Click" />
        <commomcontrol:SuperImageButton Name="LoadModel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,64,0" ToolTip="{DynamicResource 导入}" Click="LoadModel_Click">
          <commomcontrol:SuperImageButton.NormalConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_normal.png" Stretch="None" />
          </commomcontrol:SuperImageButton.NormalConnent>
          <commomcontrol:SuperImageButton.DisableConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_disabkle.png" Stretch="None" />
          </commomcontrol:SuperImageButton.DisableConnent>
          <commomcontrol:SuperImageButton.PressedConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.PressedConnent>
          <commomcontrol:SuperImageButton.MOverConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.MOverConnent>
        </commomcontrol:SuperImageButton>
        <commomcontrol:SuperImageButton Name="SaveModel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,32,0" ToolTip="{DynamicResource 导出}" IsEnabled="{Binding HasModel, RelativeSource={RelativeSource Mode=TemplatedParent}}" Click="SaveModel_Click">
          <commomcontrol:SuperImageButton.NormalConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_normal.png" Stretch="None" />
          </commomcontrol:SuperImageButton.NormalConnent>
          <commomcontrol:SuperImageButton.DisableConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_disable.png" Stretch="None" />
          </commomcontrol:SuperImageButton.DisableConnent>
          <commomcontrol:SuperImageButton.PressedConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.PressedConnent>
          <commomcontrol:SuperImageButton.MOverConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导出2_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.MOverConnent>
        </commomcontrol:SuperImageButton>
        <commomcontrol:SuperImageButton Name="DeleteModel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" ToolTip="{DynamicResource Lang_Delet}" IsEnabled="{Binding HasModel, RelativeSource={RelativeSource Mode=TemplatedParent}}" Click="DeleteModel_Click">
          <commomcontrol:SuperImageButton.NormalConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" Stretch="None" />
          </commomcontrol:SuperImageButton.NormalConnent>
          <commomcontrol:SuperImageButton.DisableConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_disable.png" Stretch="None" />
          </commomcontrol:SuperImageButton.DisableConnent>
          <commomcontrol:SuperImageButton.PressedConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.PressedConnent>
          <commomcontrol:SuperImageButton.MOverConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.MOverConnent>
        </commomcontrol:SuperImageButton>
        <Border Grid.Row="1" CornerRadius="1" BorderBrush="#E0DFDE" Background="#FCFCFC" BorderThickness="1">
          <Grid>
            <Grid Name="viewGrid">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
            </Grid>
            <Image Name="defaultImage" Source="/Apps.XmlUI;component/Resources/pic_边缘缺陷检测.png" Stretch="None" />
          </Grid>
        </Border>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>