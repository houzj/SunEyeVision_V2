<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FormatModuleControl.FormatConfigPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:PControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:format="clr-namespace:FormatModuleControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:PCommom="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <format:BoolToVisibilityDeleteButtonConvert x:Key="BoolToVisibilityDeleteButtonConvert" />
      <format:FormatFocusConvert x:Key="FormatFocusConvert" />
      <Style x:Key="InsertRowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <StackPanel Orientation="Horizontal" Background="#E1E1E2">
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_add_normal.png" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" />
                <TextBlock Foreground="#666666" FontFamily="Microsoft YaHei" FontSize="13px" Text="{TemplateBinding ContentControl.Content}" Padding="5" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_add_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_add_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FormatLinkToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid Name="grid">
                <Image Name="icon" Stretch="None" Height="26" Width="26" Source="/Apps.XmlUI;component/Resources/ic_btn_link_normal.png" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_link_click.png" />
                  <Setter TargetName="grid" Value="{DynamicResource Col_Theme}" Property="Panel.Background" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_link_click.png" />
                  <Setter TargetName="grid" Value="{DynamicResource Col_Theme}" Property="Panel.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_link_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InsertTextButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="grid">
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_btn_text_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_text_click.png" />
                  <Setter TargetName="grid" Value="{DynamicResource Col_Theme}" Property="Panel.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_text_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InsertArrayButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="grid">
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_btn_array_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_array_click.png" />
                  <Setter TargetName="grid" Value="{DynamicResource Col_Theme}" Property="Panel.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_btn_array_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="UpButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_格式化_上_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_上_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_上_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DownButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_格式化_下_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_下_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_下_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LeftButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_格式化_左_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_左_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_左_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RightButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_格式化_右_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_右_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_格式化_右_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ClearButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Image Name="image" Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type format:FormatButton}" TargetType="{x:Type format:FormatButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type format:FormatButton}">
              <Image Name="image" Stretch="None" Source="{TemplateBinding format:FormatButton.NormalIcon}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="{Binding HoverIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="image" Property="Image.Source" Value="{Binding ClickIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FormatTextInfoStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <StackPanel Orientation="Horizontal">
                <PControl:PopupButton Name="et" Margin="0" HorizontalAlignment="Left" HorizontalOffsetVal="0" Style="{x:Null}" IsDropDownOpen="{Binding IsTextDropDownOpen, Mode=TwoWay}">
                  <PControl:PopupButton.ButtonStyle>
                    <Style TargetType="{x:Type ToggleButton}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <StackPanel Orientation="Vertical">
                              <StackPanel Orientation="Horizontal" Margin="2,0">
                                <Border BorderThickness="1" BorderBrush="{Binding IsFocus, Converter={StaticResource FormatFocusConvert}}">
                                  <format:FormatTextBox HorizontalAlignment="Left" Background="#00FFFFFF" FontSize="14px" Foreground="#4C4C4C" Grid.ColumnSpan="2" AllowDrop="False" TargetValue="{Binding TempValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}">
                                    <i:Interaction.Triggers>
                                      <i:EventTrigger EventName="OnTBFoucsChanged">
                                        <PCommom:ParamsEventCommand Command="{Binding FocusedCommand}" />
                                      </i:EventTrigger>
                                      <i:EventTrigger EventName="Loaded">
                                        <PCommom:ParamsEventCommand Command="{Binding InitializedCommand}" />
                                      </i:EventTrigger>
                                      <i:EventTrigger EventName="MouseDoubleClick">
                                        <PCommom:ParamsEventCommand Command="{Binding DoubleClickCommand}" />
                                      </i:EventTrigger>
                                      <i:EventTrigger EventName="OnDataChanged">
                                        <PCommom:ParamsEventCommand Command="{Binding DataChangedCommand}" />
                                      </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                  </format:FormatTextBox>
                                </Border>
                                <Button Margin="-5,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DelParamCommand}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityDeleteButtonConvert}}">
                                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_selected_delete_normal.png" />
                                  <FrameworkElement.Tag>
                                    <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_selected_delete_click.png" />
                                  </FrameworkElement.Tag>
                                </Button>
                                <i:Interaction.Triggers>
                                  <i:EventTrigger EventName="MouseEnter">
                                    <PCommom:ParamsEventCommand Command="{Binding MouseEnterCommand}" />
                                  </i:EventTrigger>
                                  <i:EventTrigger EventName="MouseLeave">
                                    <PCommom:ParamsEventCommand Command="{Binding MouseLeaveCommand}" />
                                  </i:EventTrigger>
                                </i:Interaction.Triggers>
                              </StackPanel>
                            </StackPanel>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </PControl:PopupButton.ButtonStyle>
                  <PControl:PopupButton.SubContent>
                    <DataTemplate>
                      <Border Margin="0,4,0,0" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6" Visibility="{Binding IsTextPopupVisible, Converter={StaticResource bool2VisibilityConverter}}">
                        <Border.Background>
                          <LinearGradientBrush>
                            <GradientStop Offset="0.0" Color="#FCFCFC" />
                            <GradientStop Offset="0.15" Color="#FCFCFC" />
                            <GradientStop Offset="1" Color="#F7F7F7" />
                          </LinearGradientBrush>
                        </Border.Background>
                        <ParamTab:SubTreeView FrameworkElement.Width="180" FrameworkElement.Height="180">
                          <i:Interaction.Triggers>
                            <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                              <PCommom:ParamsEventCommand Command="{Binding IndexClickCommand}" />
                            </i:EventTrigger>
                          </i:Interaction.Triggers>
                        </ParamTab:SubTreeView>
                      </Border>
                    </DataTemplate>
                  </PControl:PopupButton.SubContent>
                </PControl:PopupButton>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FormatRowStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <StackPanel Orientation="Horizontal">
                <Border Name="border" BorderBrush="#00FFFFFF" BorderThickness="1">
                  <Button Background="#FFD3D3D3" Command="{Binding RowSelectCommand}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <TextBlock TextAlignment="Center" Width="24" Height="24" FontFamily="Microsoft YaHei" FontSize="14px" Foreground="#666666" Text="{Binding Index}" />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </FrameworkElement.Style>
                    <FrameworkElement.ContextMenu>
                      <ContextMenu StaysOpen="True">
                        <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteRowCommand}" />
                        <MenuItem Header="{DynamicResource 清空内容}" Command="{Binding ClearRowCommand}" />
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                  </Button>
                </Border>
                <ListBox Name="formatRow" HorizontalAlignment="Left" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Background="#00FFFFFF" ScrollViewer.CanContentScroll="False" Margin="10,0,0,0" ItemContainerStyle="{StaticResource FormatTextInfoStyle}" ItemsSource="{Binding FormatInfoCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ListBox>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  <Setter TargetName="border" Property="Border.Background" Value="#DEDEDE" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ComboxEditFormat">
        <StackPanel>
          <TextBlock VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="14px" FontWeight="Bold" Foreground="{DynamicResource ModuleForeground}" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
          <ContentControl Width="100" Height="34" Margin="0,7" ContentTemplate="{StaticResource ComboxEdit_sub}" Content="{Binding}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <i:Interaction.Triggers>
      <i:EventTrigger EventName="KeyDown">
        <PCommom:ParamsEventCommand Command="{Binding KeyDownCommand}" />
      </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Vertical" Margin="4,5,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Border BorderBrush="#C6C7C8" BorderThickness="1" CornerRadius="2" Margin="15,0,0,0">
            <Button Width="76" Height="28" Style="{StaticResource InsertRowButtonStyle}" ToolTip="{DynamicResource AddRow}" Content="{DynamicResource 添加}" Command="{Binding AddRowCommand}" />
          </Border>
          <Rectangle Height="28" Width="1" Fill="#C6C6C7" StrokeThickness="1" Margin="20,0,0,0" />
          <Border BorderThickness="1" BorderBrush="#CCCCCD" Margin="20,0,0,0" Width="26" Height="26" CornerRadius="2">
            <Button Style="{StaticResource InsertTextButtonStyle}" ToolTip="{DynamicResource InsertText}" Command="{Binding AddTextCommand}" IsEnabled="{Binding CanAdd}" />
          </Border>
          <Border BorderThickness="1" BorderBrush="#CCCCCD" Margin="15,0,0,0" ToolTip="{DynamicResource InsertSubscription}" Width="26" Height="26" CornerRadius="2">
            <PControl:PopupButton Name="rt" Width="26" Margin="0.2,0.2,-2.2,-2.2" HorizontalAlignment="Left" ButtonStyle="{StaticResource FormatLinkToggleButton}" IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay}" IsEnabled="{Binding CanAdd}">
              <PControl:PopupButton.SubContent>
                <DataTemplate>
                  <Grid Background="#00FFFFFF" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="27" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#FCFCFC" />
                          <GradientStop Offset="0.15" Color="#FCFCFC" />
                          <GradientStop Offset="1" Color="#F7F7F7" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <ParamTab:SubTreeView FrameworkElement.Width="180" FrameworkElement.Height="180">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                            <PCommom:ParamsEventCommand Command="{Binding ClickCommand}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </ParamTab:SubTreeView>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource PopWindowButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{DynamicResource Lang_OpenSubscriptionWindow}" Command="{Binding PopSubscribeWindowCommand}" />
                  </Grid>
                </DataTemplate>
              </PControl:PopupButton.SubContent>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="DropDownOpened">
                  <i:InvokeCommandAction Command="{Binding DropDownCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </PControl:PopupButton>
          </Border>
          <Border BorderThickness="1" BorderBrush="#CCCCCD" Margin="15,0,0,0" Width="26" Height="26" CornerRadius="2">
            <Button Style="{StaticResource InsertArrayButtonStyle}" ToolTip="{DynamicResource InsertArray}" Command="{Binding AddPairCommand}" IsEnabled="{Binding CanAdd}" />
          </Border>
          <Button Margin="15,0,0,0" Style="{StaticResource BaseImage_ButtonStyle}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_help_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_help_normal.png" />
            </FrameworkElement.Tag>
            <FrameworkElement.ToolTip>
              <TextBlock Width="180" Text="{DynamicResource ArrayTips}" TextWrapping="Wrap" />
            </FrameworkElement.ToolTip>
          </Button>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Width="28" Height="28" Style="{StaticResource UpButtonStyle}" ToolTip="{DynamicResource MoveUp}" Margin="5,0,0,0" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" />
          <Button Width="28" Height="28" Style="{StaticResource DownButtonStyle}" ToolTip="{DynamicResource MoveDown}" Margin="5,0,0,0" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" />
          <Button Width="28" Height="28" Style="{StaticResource LeftButtonStyle}" ToolTip="{DynamicResource MoveLeft}" Margin="5,0,0,0" Command="{Binding MoveLeftCommand}" IsEnabled="{Binding CanMoveLeft}" />
          <Button Width="28" Height="28" Style="{StaticResource RightButtonStyle}" ToolTip="{DynamicResource MoveRight}" Margin="5,0,0,0" Command="{Binding MoveRightCommand}" IsEnabled="{Binding CanMoveRight}" />
          <Rectangle Height="28" Width="1" Fill="#C6C6C7" StrokeThickness="1" Margin="10,0" />
          <Button Width="28" Height="28" Style="{StaticResource ClearButtonStyle}" ToolTip="{DynamicResource Clear}" Margin="5,0" Command="{Binding ClearCommand}" />
        </StackPanel>
      </Grid>
      <Border BorderThickness="1" Background="#FFFEFEFE" CornerRadius="4" BorderBrush="#CCCCCD" Margin="0,10,0,0" Height="210">
        <ScrollViewer Name="sv" Height="210" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid>
            <ListBox HorizontalAlignment="Left" ItemContainerStyle="{StaticResource FormatRowStyle}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Background="#00FFFFFF" ScrollViewer.CanContentScroll="False" ItemsSource="{Binding FormatRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding CurrentRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseMove">
                  <PCommom:ParamsEventCommand Command="{Binding PreviewMouseMoveCommand}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                  <PCommom:ParamsEventCommand Command="{Binding PreviewMouseLeftButtonDownCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </ListBox>
            <Rectangle Panel.ZIndex="1" HorizontalAlignment="Left" Width="1" Margin="30,0,0,0" Fill="#E0DFDE" Height="{Binding ElementName=sv}" />
          </Grid>
        </ScrollViewer>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="PreviewMouseWheel">
            <i:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=sv}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="1">
      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="{DynamicResource 输入结束符}" Foreground="#666666" FontSize="14px" FontWeight="Bold" Margin="10,5,0,5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="12,5,0,0">
          <format:FormatButton Text="&#xD;" Margin="0,0,40,0" Height="34" Width="34" ToolTip="{DynamicResource 回车}" NormalIcon="/Apps.XmlUI;component/Resources/字符格式化_回车_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/字符格式化_回车_click.png" ClickIcon="/Apps.XmlUI;component/Resources/字符格式化_回车_click.png" Target="{Binding Tag, ElementName=et}" IsEnabled="{Binding CanAdd}" />
          <format:FormatButton Text="&#xA;" Margin="0,0,40,0" Height="34" Width="34" ToolTip="{DynamicResource 换行}" NormalIcon="/Apps.XmlUI;component/Resources/字符格式化_换行_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/字符格式化_换行_click.png" ClickIcon="/Apps.XmlUI;component/Resources/字符格式化_换行_click.png" Target="{Binding Tag, ElementName=et}" IsEnabled="{Binding CanAdd}" />
          <format:FormatButton Text="&#xD;&#xA;" Height="34" Width="54" ToolTip="{DynamicResource 回车+换行}" NormalIcon="/Apps.XmlUI;component/Resources/字符格式化_回车+换行_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/字符格式化_回车+换行_click.png" ClickIcon="/Apps.XmlUI;component/Resources/字符格式化_回车+换行_click.png" Target="{Binding Tag, ElementName=et}" IsEnabled="{Binding CanAdd}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Margin="50,0,0,0">
        <ContentControl ContentTemplate="{StaticResource ComboxEditFormat}" Margin="5,4,0,0" Content="{Binding Delimiter}" />
      </StackPanel>
      <StackPanel Margin="50,0,0,0">
        <ContentControl ContentTemplate="{StaticResource ComboxEditFormat}" Margin="5,4,0,0" Content="{Binding ArrayDelimiter}" />
      </StackPanel>
    </StackPanel>
    <Grid Row="0" RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <format:FormatMessageBox Message="{Binding Message}" Result="{Binding Result}" Visibility="{Binding IsShowMessageBox}" />
    </Grid>
  </Grid>
</UserControl>