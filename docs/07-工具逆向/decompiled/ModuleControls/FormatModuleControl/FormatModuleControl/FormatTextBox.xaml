<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FormatModuleControl.FormatTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:format="clr-namespace:FormatModuleControl" xmlns:local="clr-namespace:FormatModuleControl" x:Name="myControl" DataContextChanged="myControl_DataContextChanged">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{x:Null}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <themes:ListBoxChrome Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderFocused="{TemplateBinding UIElement.IsKeyboardFocusWithin}" UIElement.SnapsToDevicePixels="True">
                <Grid>
                  <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  <TextBlock Name="Message" Margin="0,2" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
                </Grid>
              </themes:ListBoxChrome>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="themes:ListBoxChrome.Background" />
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
                <DataTrigger Value="" Binding="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="True" />
              <Condition Property="TextBoxBase.IsSelectionActive" Value="False" />
            </MultiTrigger.Conditions>
            <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
      <local:ThicknessConvert x:Key="ThicknessConverter" />
      <local:FormatBackGroundConvert x:Key="FormatBackGroundConverter" />
      <local:ItemCheckConverter x:Key="CheckConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF">
    <TextBox Name="tb" InputMethod.PreferredImeState="Off" Margin="0,0,0,0" TextWrapping="Wrap" HorizontalContentAlignment="Left" VerticalAlignment="Top" FontFamily="Microsoft YaHei" TextAlignment="Center" AllowDrop="False" IsReadOnly="{Binding IsReadOnly, ElementName=myControl}" Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type format:FormatTextBox}}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type format:FormatTextBox}}}" Text="{Binding TargetValue, ElementName=myControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Width="{Binding ActWidth, ElementName=myControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{Binding MyItemState, Converter={StaticResource CheckConverter}}" BorderThickness="{Binding MyItemState, Converter={StaticResource ThicknessConverter}}" Background="{Binding MyItemState, Converter={StaticResource FormatBackGroundConverter}}" SelectionChanged="tb_SelectionChanged" TextChanged="tb_TextChanged" GotFocus="tb_GotFocus" LostFocus="tb_LostFocus" />
  </Grid>
</UserControl>