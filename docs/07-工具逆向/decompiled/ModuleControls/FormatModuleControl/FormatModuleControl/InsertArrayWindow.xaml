<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="FormatModuleControl.InsertArrayWindow" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="insertArrayWindow" Title="{DynamicResource InsertArray}" Height="420" Foreground="#BEBEBE" FontFamily="Microsoft YaHei" FontSize="14px" xmlns:formatmodulecontrol="clr-namespace:FormatModuleControl;assembly=FormatModuleControl" Width="{Binding ArrayWidth, ElementName=insertArrayWindow}" Loaded="InsertArrayWindow_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="ArrayItemStyle" TargetType="{x:Type ListBoxItem}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListBoxItem}">
                <paramtab:LeftRightControl FrameworkElement.Height="32">
                  <paramtab:LeftRightControl.LeftContent>
                    <TextBlock Margin="-5,0,0,0" Padding="2,0,0,0" Height="29" Width="28" FontSize="14px" Text="{Binding RealIndex}" />
                  </paramtab:LeftRightControl.LeftContent>
                  <paramtab:LeftRightControl.RightContent>
                    <ContentControl Margin="-13,3,0,0">
                      <Border>
                        <StackPanel Orientation="Horizontal">
                          <Grid>
                            <ContentControl Width="182" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding IndexInfo}" />
                          </Grid>
                          <Button Width="24" Height="24" Template="{DynamicResource StringCompareUpTemplate}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding UpEnable, Mode=TwoWay}" />
                          <Button Width="24" Height="24" Template="{DynamicResource StringCompareDownTemplate}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding DownEnable, Mode=TwoWay}" />
                          <Button Width="24" Height="24" Template="{DynamicResource StringCompareDeleteTemplate}" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                      </Border>
                    </ContentControl>
                  </paramtab:LeftRightControl.RightContent>
                </paramtab:LeftRightControl>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <ControlTemplate x:Key="StringCompareUpTemplate" TargetType="{x:Type Button}">
          <Image Name="Image" Height="24" Width="24" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_normal.png" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" />
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_disable.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="StringCompareDownTemplate" TargetType="{x:Type Button}">
          <Image Name="Image" Height="24" Width="24" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_normal.png" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" />
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_disable.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="StringCompareDeleteTemplate" TargetType="{x:Type Button}">
          <Image Name="Image" Height="24" Width="24" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/delete_click.png" />
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/delete_click.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate x:Key="Combox">
          <paramtab:LeftRightControl FrameworkElement.Height="34">
            <paramtab:LeftRightControl.LeftContent>
              <Control Template="{StaticResource TextLeft}" />
            </paramtab:LeftRightControl.LeftContent>
            <paramtab:LeftRightControl.RightContent>
              <ContentControl Width="182" HorizontalAlignment="Left" ContentTemplate="{StaticResource ComboxEdit_sub}" Content="{Binding}" />
            </paramtab:LeftRightControl.RightContent>
          </paramtab:LeftRightControl>
        </DataTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Margin="10">
      <StackPanel Orientation="Vertical" Margin="4">
        <Label Content="{DynamicResource 基本设置}" FontFamily="Microsoft YaHei" Foreground="#4C4C4C" FontSize="14px" FontWeight="Bold" />
        <ContentControl ContentTemplate="{StaticResource Combox}" HorizontalAlignment="Left" Margin="32,0,0,0" Content="{Binding Delimiter}" />
        <ContentControl ContentTemplate="{StaticResource ButtonSelecter}" HorizontalAlignment="Left" Margin="32,10,0,0" Content="{Binding IndexInfo}" Width="{Binding BtnSelectWidth, ElementName=insertArrayWindow}" />
        <Rectangle Height="1" VerticalAlignment="Top" RadiusX="4" RadiusY="4" Fill="#E0DFDE" Margin="0,10,0,8" />
        <Label Content="{DynamicResource 数组列表}" FontFamily="Microsoft YaHei" Foreground="#4C4C4C" FontSize="14px" FontWeight="Bold" />
        <paramtab:LeftRightControl FrameworkElement.Height="32" FrameworkElement.Margin="5,6,0,0">
          <paramtab:LeftRightControl.LeftContent>
            <TextBlock Margin="10,0,0,0" Padding="2,0,0,0" Text="{DynamicResource Number}" Height="30" FontSize="14px" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
          </paramtab:LeftRightControl.LeftContent>
          <paramtab:LeftRightControl.RightContent>
            <TextBlock Margin="80,0,0,0" Padding="2,0,0,0" Text="{DynamicResource RunParam_Content}" Height="30" FontSize="14px" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
          </paramtab:LeftRightControl.RightContent>
        </paramtab:LeftRightControl>
        <ScrollViewer Name="scroll" Height="140" Style="{StaticResource RecScrollViewer}" PreviewMouseWheel="scroll_PreviewMouseWheel">
          <StackPanel>
            <ListBox ItemContainerStyle="{StaticResource ArrayItemStyle}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Background="#00FFFFFF" ItemsSource="{Binding ArrayList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Grid.Row="1">
              <Button Margin="20,5,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
                </FrameworkElement.Tag>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Grid>
    <Border BorderBrush="#B8B6B6" BorderThickness="1" CornerRadius="2" Grid.Row="1" Background="#E4E5E7">
      <Button FontFamily="Microsoft YaHei" FontSize="12px" Foreground="#666666" Width="66" Height="24" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D6D5D4" Content="{DynamicResource Confirm}" Style="{StaticResource Orange_ButtonStyle}" Click="Button_Click" />
    </Border>
  </Grid>
</controls:BaseWindow>