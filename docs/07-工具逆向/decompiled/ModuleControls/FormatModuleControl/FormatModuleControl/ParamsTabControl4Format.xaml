    </MultiBinding>
  </Window.Title>
  <local1:ParamsConfigControlBase Name="paramstab" Focusable="True" ROIPartUI="{Binding ROIPartUI, ElementName=win, Mode=OneWay}" />
</local1:TabWinBase>