<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="GlobalCameraModuleControl.DynamicCameraParamConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:local="clr-namespace:GlobalCameraModuleControl" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:paramTab="clr-namespace:Apps.XmlParser.ParamTab" xmlns:xmlData="clr-namespace:GlobalCameraModuleControl.XmlData" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TreeViewStyle/TreeViewStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/GlobalCameraModuleControl;component/DataTemplate/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <appxmlUI:ItemCheckConverter x:Key="CheckConverter" />
      <BooleanToVisibilityConverter x:Key="bv" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Name="row0" Height="44" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <TextBlock Margin="10,0,0,0" HorizontalAlignment="Left" Text="{DynamicResource 自定义参数为收藏的相机参数}" ToolTip="{DynamicResource 自定义参数为收藏的相机参数}" Width="200" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <ContentControl Margin="5" ContentTemplate="{StaticResource CommandWithTip_sub_Min}" Content="{Binding MVSContent}" />
            <ContentControl Margin="5" ContentTemplate="{StaticResource CommandWithTip_sub_Min}" Content="{Binding RealTimeContent}" />
            <Button Name="bt" Margin="5" Height="32" Width="80" Style="{StaticResource BottomButtonStyle}" ToolTip="{DynamicResource 自定义编辑}" Command="{Binding ConfigCommand}" CommandParameter="{Binding EditRunParamMethod, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <TextBlock Width="80" Height="16" Text="{DynamicResource 自定义编辑}" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
        <TreeView Style="{StaticResource GlobalParamTreeViewStyle}" Grid.Row="1" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="#00FFFFFF" ItemsSource="{Binding GroupCollection}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type xmlData:DynamicCameraNameItemOfGroupCategory}}" DataType="{x:Type xmlData:DynamicCameraNameItemOfGroupCategory}" ItemsSource="{Binding Collection}">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" TextTrimming="CharacterEllipsis" Style="{StaticResource TitleTextBlock}" Text="{Binding}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
              </HierarchicalDataTemplate>
              <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type paramTab:DynamicCameraNameItemOfGroup}}" DataType="{x:Type paramTab:DynamicCameraNameItemOfGroup}" ItemsSource="{Binding Collection}">
                <ContentControl ContentTemplate="{StaticResource ParamItemTemplate}" Content="{Binding}" />
              </HierarchicalDataTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </TreeView>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>