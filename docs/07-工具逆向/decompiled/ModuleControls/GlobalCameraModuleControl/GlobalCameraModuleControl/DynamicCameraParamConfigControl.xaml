<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="GlobalCameraModuleControl.DynamicCameraParamConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:local="clr-namespace:GlobalCameraModuleControl" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:paramTab="clr-namespace:Apps.XmlParser.ParamTab" xmlns:xmlData="clr-namespace:GlobalCameraModuleControl.XmlData" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TreeViewStyle/TreeViewStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <appxmlUI:ItemCheckConverter x:Key="CheckConverter" />
      <BooleanToVisibilityConverter x:Key="bv" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
          <Button Name="bt" Margin="5" Height="28" Width="80" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Lang_AddGroup}" Command="{Binding AddGroupCommand}" />
          <Button Name="BtnMove" Height="28" Width="170" Content="{DynamicResource 勾选参数移动至}" Margin="5,0,0,0" Click="BtnMove_Click" />
          <Popup Name="Pop1" StaysOpen="False" Margin="0" AllowsTransparency="True" PlacementTarget="{Binding ElementName=BtnMove}">
            <Grid Height="100" Width="150" HorizontalAlignment="Left" Background="{DynamicResource MainviewBaground}">
              <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="0,4,0,4" Background="#252525">
                <ListBox Name="PART_ListBoxSearchResult" Foreground="{DynamicResource Col_ComboBox_Foreground}" Margin="0,10" Padding="0" Background="#FFFFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Auto" MaxHeight="215" VirtualizingPanel.IsVirtualizing="True" BorderThickness="0" ItemsSource="{Binding GroupCollection}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Label Width="{TemplateBinding FrameworkElement.Width}" Content="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="Foreground" Value="#FFFFFFFF" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border Name="Bd" Height="25" Margin="0,0,0,0" BorderThickness="0" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Left" Margin="0,0,0,0" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                              </Grid>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListBox>
              </Border>
            </Grid>
          </Popup>
        </StackPanel>
        <Border Margin="10" BorderThickness="1" Grid.Row="1" Width="{TemplateBinding FrameworkElement.Width}">
          <TreeView Style="{StaticResource GlobalParamTreeViewStyle}" Grid.Row="1" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="#00FFFFFF" ItemsSource="{Binding GroupCollection}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type xmlData:DynamicCameraNameItemOfGroupCategory}}" DataType="{x:Type xmlData:DynamicCameraNameItemOfGroupCategory}" ItemsSource="{Binding Collection}">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{DynamicResource RunParam_Display}" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding CheckEnabled}" />
                      <TextBox Name="ht" Margin="10,0,0,0" VerticalAlignment="Center" MaxLength="64" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource TitleColor}" Width="150" Style="{StaticResource input}" Text="{Binding Name, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="LostFocus">
                            <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Background="#00FFFFFF" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DelGroupCommand}">
                      <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" Stretch="None" />
                      <FrameworkElement.Tag>
                        <Image Source="/Apps.XmlUI;component/Resources/delete_click.png" Stretch="None" />
                      </FrameworkElement.Tag>
                    </Button>
                  </Grid>
                </HierarchicalDataTemplate>
                <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type paramTab:DynamicCameraNameItemOfGroup}}" DataType="{x:Type paramTab:DynamicCameraNameItemOfGroup}" ItemsSource="{Binding Collection}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <CheckBox Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{DynamicResource RunParam_Display}" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding CheckEnabled}" />
                      <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TitleTextBlock}" Text="{Binding DisplayNameA}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                    </StackPanel>
                    <Grid Column="1">
                      <TextBox Width="250" VerticalAlignment="Center" MaxLength="64" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource TitleColor}" Style="{StaticResource input}" Text="{Binding DisplayNameA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="LostFocus">
                            <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                      <Button HorizontalAlignment="Right" Background="#00FFFFFF" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DelGroupCommand}">
                        <Image Source="/Apps.XmlUI;component/Resources/delete_normal.png" Stretch="None" />
                        <FrameworkElement.Tag>
                          <Image Source="/Apps.XmlUI;component/Resources/delete_click.png" Stretch="None" />
                        </FrameworkElement.Tag>
                      </Button>
                    </Grid>
                  </Grid>
                </HierarchicalDataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </TreeView>
        </Border>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>