<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GlobalCameraModuleControl.FrequentlyParamListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="UserControl" xmlns:globalcameramodulecontrol="clr-namespace:GlobalCameraModuleControl;assembly=GlobalCameraModuleControl" Unloaded="FrequentlyParamListView_UnLoaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GlobalCameraModuleControl;component/DataTemplate/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="EnumerationLx">
        <Grid Height="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LangCameraNomalWidth}" />
            <ColumnDefinition Width="152" />
            <ColumnDefinition Width="34" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
          <ComboBox Name="cb" Grid.Column="1" DisplayMemberPath="DisplayNameA" SelectedValuePath="ValueA" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding EnumCurValueA, Mode=OneWay}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="SelectionChanged">
                <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </ComboBox>
          <Button Grid.Column="2" Content="刷新" VerticalAlignment="Center" ToolTip="{DynamicResource 刷新}" Command="{Binding ClickCommand}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Image Name="ImageBackground" Width="34" Height="34" Source="/Apps.XmlUI;component/Resources/tabbar_ic_refresh_normal.png" />
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_refresh_click.png" />
                  </Trigger>
                  <Trigger Property="ButtonBase.IsPressed" Value="True">
                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_refresh_click.png" />
                  </Trigger>
                  <Trigger Property="UIElement.IsEnabled" Value="False">
                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_refresh_normal.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </Grid>
      </DataTemplate>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Label Name="ImageBackground" Height="30" Background="#FFFFFFFF" Foreground="#FF000000" HorizontalContentAlignment="Center" BorderBrush="#FF808080" BorderThickness="1" Content="{TemplateBinding ContentControl.Content}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ImageBackground" Property="Background" Value="#FFFFFFFF" />
                  <Setter Value="{DynamicResource ImageListdBorderBrush}" TargetName="ImageBackground" Property="BorderBrush" />
                  <Setter Value="{DynamicResource ImageListdBorderBrush}" TargetName="ImageBackground" Property="Foreground" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ImageBackground" Property="Background" Value="#FFD3D3D3" />
                  <Setter Value="{DynamicResource ImageListdBorderBrush}" TargetName="ImageBackground" Property="BorderBrush" />
                  <Setter Value="{DynamicResource ImageListdBorderBrush}" TargetName="ImageBackground" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderStyle" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Expander}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" CornerRadius="3" SnapsToDevicePixels="True">
                <DockPanel>
                  <ContentPresenter Name="ExpandSite" DockPanel.Dock="Bottom" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" Visibility="Collapsed" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                  <ContentControl Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top" FontWeight="{TemplateBinding Control.FontWeight}" FontStyle="{TemplateBinding Control.FontStyle}" FontStretch="{TemplateBinding Control.FontStretch}" FontFamily="{TemplateBinding Control.FontFamily}" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}" />
                </DockPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Expander.IsExpanded" Value="True">
                  <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Expander.ExpandDirection" Value="Up">
                  <Setter TargetName="ExpandSite" Property="DockPanel.Dock" Value="Top" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid">
    <ScrollViewer Style="{DynamicResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="8*" />
          <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,0,0" Background="{DynamicResource MainviewBaground}">
          <ContentControl Name="EnumerationLxf" ContentTemplate="{StaticResource EnumerationLx}" Margin="20,15,10,5" Content="{Binding CameraName, ElementName=UserControl}" />
          <ContentControl ContentTemplate="{StaticResource Integer}" Margin="20,5,10,5" Content="{Binding CameraWidth, ElementName=UserControl}" />
          <ContentControl ContentTemplate="{StaticResource Integer}" Margin="20,5,10,5" Content="{Binding CameraHeight, ElementName=UserControl}" />
          <ContentControl ContentTemplate="{StaticResource EnumerationBx}" Margin="20,5,10,5" Content="{Binding PixelFormat, ElementName=UserControl}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>