  <DataTemplate x:Key="Integer">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LangCameraNomalWidth}" />
        <ColumnDefinition Width="152" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ImgPanelForeground}" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
      <localcontrol:SliderArrange localcontrol:SliderArrangeBase.TBtnBgNormal="/VM.PcUI;component/Resources/inputbox_ic_triangle_top_normal.png" localcontrol:SliderArrangeBase.TBtnBgHover="/VM.PcUI;component/Resources/inputbox_ic_triangle_top_click.png" Control.Foreground="{DynamicResource ImgPanelForeground}" localcontrol:SliderArrangeBase.TBackground="{DynamicResource GloCameraComboBorderBg}" localcontrol:SliderArrangeBase.TBorderBrush="{DynamicResource GloCameraComboBB}" Grid.Column="1" FrameworkElement.Height="30" Control.FontSize="14" localcontrol:SliderArrangeBase.SliderTickFrequency="{Binding IncValueA}" localcontrol:SliderArrangeBase.StartValue="{Binding CurValueA, Mode=TwoWay}" localcontrol:SliderArrangeBase.Minimum="{Binding MinValueA}" localcontrol:SliderArrangeBase.Maximum="{Binding MaxValueA}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="OnStartValueChange">
            <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </localcontrol:SliderArrange>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationBx">
    <Grid Height="30">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LangCameraNomalWidth}" />
        <ColumnDefinition Width="152" />
        <ColumnDefinition Width="52" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ImgPanelForeground}" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
      <ComboBox Name="cb" Grid.Column="1" DisplayMemberPath="DisplayNameA" SelectedValuePath="ValueA" Style="{StaticResource CameraCommonComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding CurValueA, Mode=TwoWay}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
          </i:EventTrigger>
          <i:EventTrigger EventName="Mousewheel">
            <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
    </Grid>
