    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationIP">
    <localParamTab:LeftRightControl FrameworkElement.Height="32">
      <localParamTab:LeftRightControl.RightContent>
        <ComboBox DisplayMemberPath="DisplayNameA" SelectedValuePath="StrValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding CurValueA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="SelectionChanged">
              <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </ComboBox>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
