<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="GraphicsSetModuleControl.DynamicDisplayObjectConfigForGraphicsSetControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:graphicssetmodulecontrol="clr-namespace:GraphicsSetModuleControl;assembly=GraphicsSetModuleControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="RelateSelecter">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCD" BorderThickness="1" Margin="0,0,0,0" CornerRadius="2">
            <TextBlock TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Background="#00FFFFFF" Text="{Binding RelateStr}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <Button Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ConfigCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/combo_ic_关联_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/combo_ic_关联_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DisplayVar3">
        <Grid Margin="0,0,0,6" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" Height="32" Width="Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="2">
            <TextBox Name="tb" BorderThickness="0" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="32" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=tb}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <Border Grid.Column="1" BorderBrush="#CCCCCD" BorderThickness="1" Margin="8,0,0,0" CornerRadius="2">
            <TextBox BorderThickness="0" IsReadOnly="True" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="65" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Binding ValueType, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <Grid Margin="8,0,0,0" Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl VerticalAlignment="Center" ContentTemplate="{StaticResource RelateSelecter}" Content="{Binding}" />
            <ContentControl VerticalAlignment="Center" Grid.Column="1">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentControl}">
                  <Setter Property="ContentTemplate">
                    <Setter.Value>
                      <DataTemplate>
                        <Button Margin="4,0,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ConfigShapeCommand}">
                          <Image Stretch="None" Source="/Apps.Style;component/Resources/编辑normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.Style;component/Resources/编辑click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </DataTemplate>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="Content" Value="{Binding}" />
                  <Style.Triggers>
                    <DataTrigger Value="image" Binding="{Binding ValueType, Mode=OneWay}">
                      <Setter Property="ContentTemplate" Value="{x:Null}" />
                      <Setter Property="Content" Value="{x:Null}" />
                    </DataTrigger>
                    <DataTrigger Value="pixelinfoimage" Binding="{Binding ValueType, Mode=OneWay}">
                      <Setter Property="ContentTemplate" Value="{x:Null}" />
                      <Setter Property="Content" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentControl>
          </Grid>
          <Button Name="delBtn" VerticalAlignment="Center" Margin="4,0,8,0" Grid.Column="3" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate TargetType="{x:Type Control}">
      <Grid Focusable="True" MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Tab_Image Display}" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource TitleColor}" />
        <Grid Row="1" Margin="18,0,0,0" TextBlock.Foreground="{DynamicResource ParamsTabForeground}" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0" Content="{DynamicResource Lang_ParamName}" Margin="0,0,0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="68" Height="32" />
          <Label Grid.Column="1" Content="{DynamicResource Lang_Type}" Margin="8,0,0,4" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="68" Height="32" />
          <Label Grid.Column="2" Content="{DynamicResource correlation}" Margin="40,0,0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="150" Height="32" />
        </Grid>
        <Grid Row="2" Margin="18,0,0,0" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ItemsControl Name="listInputVars" MaxHeight="300" ItemTemplate="{StaticResource DisplayVar3}" ItemsSource="{Binding DisplayItemsA}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type ItemsControl}">
                <ScrollViewer Name="listInputScrollViewer" Style="{StaticResource RecScrollViewer}" Tag="1">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </ControlTemplate>
            </Control.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,0">
            <ComboBox Style="{StaticResource ListViewComboBoxStyle}" SelectedValuePath="Item2" Width="68" Height="32" ToolTip="{Lang:ResourceBinding SelectionBoxItem.Item1, RelativeSource={RelativeSource Mode=Self}}" ItemsSource="{Binding DisplayTypes}" SelectedValue="{Binding SelectedType, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Lang:ResourceBinding Item1}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Button Margin="7,6,0,0" Style="{StaticResource BaseImage_ButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddCommand}" Click="Button_Click">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>