<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSBlobFindLabelsModuControl.ThresholdAreaPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dataStatistics="clr-namespace:IMVSBlobFindLabelsModuControl" x:Name="source" UseLayoutRounding="True" MouseDown="Source_MouseDown">
  <Grid Background="#00FFFFFF">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.Style;component/TextBlockStyle/TextBlockStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}" />
        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource addButton}" />
        <Style x:Key="delete" TargetType="{x:Type Button}" BasedOn="{StaticResource deleteButton}">
          <EventSetter Event="Click" Handler="Delete_OnHandler" />
        </Style>
        <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
          <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
          <Setter Property="ItemsPanel">
            <Setter.Value>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ItemTemplate">
            <Setter.Value>
              <DataTemplate DataType="dataStatistics:ThresholdAreaItem">
                <Grid Margin="0,0,0,5">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NormalTextBoxStyle}" />
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Left" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" Text="{Binding Index}" />
                  <ContentControl Grid.Column="1" Height="32" Foreground="#666666" ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding GrayValue}" />
                  <ContentControl Grid.Column="2" Margin="6,0,0,0" Height="32" Foreground="#666666" ContentTemplate="{StaticResource IntegerBettween_Sub}" Content="{Binding AreaRange}" />
                  <CheckBox Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding IsInverse, Mode=TwoWay}" />
                  <Button Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource delete}" />
                </Grid>
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Margin="18,0,18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="1.5*" />
          <ColumnDefinition Width="4.8*" />
          <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Number}" Margin="-5,0,0,0" />
        <TextBlock Grid.Column="1" Text="{DynamicResource GrayValue}" Margin="{Binding ElementName=source, Path=GrayValueSpace}" />
        <TextBlock Grid.Column="2" Text="{DynamicResource RunParam_Area Range}" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{DynamicResource Lang_Inverse}" Margin="4,0,0,0" />
      </Grid>
      <StackPanel Orientation="Vertical" Grid.Row="1" VerticalAlignment="Top">
        <ItemsControl Name="controlItem" ItemsSource="{Binding ElementName=source, Path=Items}" MouseWheel="ItemsControl_MouseWheel" />
        <Button VerticalAlignment="Center" HorizontalAlignment="Left" Click="AddModuleItem_OnClick" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>