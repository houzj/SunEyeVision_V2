<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSColorExtractModuControl.UserScrollView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:IMVSColorExtractModuControl" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:PCommom="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" x:Name="UserScroll">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/ScrollBarStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="RangeInfoStyle" TargetType="{x:Type ListViewItem}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListViewItem}">
                <Grid Margin="3" Background="#FCFCFC" MouseEnter="OnMouse_Enter" MouseLeave="OnMouse_Leave">
                  <controls:FouerColorBorder Name="BD_Border" BorderThickness="1" BorderBrush="#00FFFFFF" CornerRadius="2">
                    <Grid Name="BD_Grid" ColumnSpan="2">
                      <Canvas Width="54" Height="54">
                        <Ellipse Canvas.Left="0" Canvas.Top="0" Width="54" Height="54" Fill="{Binding BrushColor}" />
                      </Canvas>
                      <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding IsChecked}" />
                    </Grid>
                  </controls:FouerColorBorder>
                  <Button Margin="0,-5,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DelParamCommand}" Visibility="{Binding CanDelete, Converter={StaticResource bool2VisibilityConverter}}">
                    <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_selected_delete_normal.png" />
                    <FrameworkElement.Tag>
                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_selected_delete_click.png" />
                    </FrameworkElement.Tag>
                  </Button>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="BD_Border" Property="Border.BorderBrush" Value="#CCCCCC" />
                    <Setter TargetName="BD_Grid" Property="Panel.Background" Value="#F2F2F2" />
                  </Trigger>
                  <Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <Setter TargetName="BD_Border" Property="Border.BorderBrush" Value="#E0E0E0" />
                    <Setter TargetName="BD_Border" Value="{DynamicResource Col_Theme}" Property="controls:FouerColorBorder.BottomBorderBrush" />
                    <Setter TargetName="BD_Grid" Property="Panel.Background" Value="#F2F2F2" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="AddColor_ButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Grid>
                  <Image Name="fore" Height="54" Source="/Apps.XmlUI;component/Resources/btn_add color_normal.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="fore" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/btn_add color_hover.png" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="fore" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/btn_add color_click.png" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="fore" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/btn_add color_disable.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ScrollViewer Name="sv" Style="{StaticResource titleBarShrinkScrollViewer}" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Visible" Width="334" Height="80" HorizontalAlignment="Left" Padding="3,0,3,0" PreviewMouseWheel="OnMouseWheel">
      <StackPanel Orientation="Horizontal">
        <ListView Height="64" VerticalAlignment="Center" BorderBrush="#00FFFFFF" HorizontalAlignment="Left" ItemContainerStyle="{StaticResource RangeInfoStyle}" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False" Background="#FCFCFC" ItemsSource="{Binding ColorRangeCollection}" SelectedItem="{Binding SelectedRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ListView>
        <Button Margin="3" Style="{StaticResource AddColor_ButtonStyle}" HorizontalAlignment="Left" Height="64" Command="{Binding AddCommand}" CommandParameter="{Binding ElementName=sv}" Click="AddExtractRange_Click" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>