<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IMVSColorExtractModuControl" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:xmlUi="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:PControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:localcontrol="clr-namespace:Apps.XmlUI.ParamTabControl;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:PCommom="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/ScrollBarStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="LightRecScrollViewer" TargetType="{x:Type ScrollViewer}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
            <Grid Background="#00FFFFFF" Margin="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ScrollContentPresenter Name="expandGrid" Grid.Column="0" Cursor="{TemplateBinding FrameworkElement.Cursor}" Margin="{TemplateBinding Control.Padding}" Grid.ColumnSpan="1" Grid.RowSpan="1" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
              <ScrollBar Name="PART_VerticalScrollBar" Tag="{TemplateBinding FrameworkElement.Tag}" Background="#00FFFFFF" Orientation="Vertical" Grid.Row="0" Grid.Column="1" Margin="-12,0,2,0" Value="{TemplateBinding ScrollViewer.VerticalOffset}" Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}" ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}" Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}" Style="{StaticResource LightRecScrollBarStyle}" />
              <ScrollBar Name="PART_HorizontalScrollBar" Background="#00FFFFFF" Tag="{TemplateBinding FrameworkElement.Tag}" Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,-12,0,2" Value="{TemplateBinding ScrollViewer.HorizontalOffset}" Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}" ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}" Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}" Style="{StaticResource LightRecScrollBarStyle}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BoxRoiBtnStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Margin" Value="0,0,27,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Background="#00FFFFFF">
            <Image Name="bg" Width="36" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Source="/Apps.XmlUI;component/Resources/ROI_选中但未绘制_bg.png" />
            <Image Name="icon" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/ROI_retangle_normal.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding BoxEnable_ModuleEnableA}">
              <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ROI_retangle_click.png" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding BoxA}">
              <Setter TargetName="bg" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="ColorExtractList">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="18" />
        <RowDefinition Height="92" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{DynamicResource ExtractList}" Foreground="#666666" FontSize="14" FontWeight="Bold" Margin="18,0,0,0" />
      <Border Grid.Row="1" Margin="18,10,10,0" Height="82" BorderThickness="1" BorderBrush="#FFD3D3D3" Background="#FCFCFC">
        <local:UserScrollView />
      </Border>
      <ScrollViewer Grid.Row="2" Padding="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Style="{StaticResource LightRecScrollViewer}">
        <StackPanel>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Params Settings}" Foreground="#666666" FontSize="14" FontWeight="Bold" Margin="18,16,0,0" />
          </StackPanel>
          <StackPanel Orientation="Vertical" Margin="18,5,0,0">
            <xmlUi:LeftRightControl FrameworkElement.Height="32">
              <xmlUi:LeftRightControl.LeftContent>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Color Space}" ToolTip="{DynamicResource Color Space}" />
              </xmlUi:LeftRightControl.LeftContent>
              <xmlUi:LeftRightControl.RightContent>
                <ComboBox DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Width="182" Style="{StaticResource GlobalItemComboBoxStyle}" ItemsSource="{Binding SelectedRange.ColorTypes.EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding SelectedRange.ColorTypes.CurValueA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                      <i:InvokeCommandAction Command="{Binding SelectedRange.SelectionChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </ComboBox>
              </xmlUi:LeftRightControl.RightContent>
            </xmlUi:LeftRightControl>
            <localcontrol:RoiSelectControl FrameworkElement.DataContext="{Binding}" />
            <xmlUi:LeftRightControl FrameworkElement.Height="64" FrameworkElement.Margin="0,10,0,0" ChildLeftWidth="108">
              <xmlUi:LeftRightControl.LeftContent>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource ChannelOne}" ToolTip="{DynamicResource ChannelOne}" />
              </xmlUi:LeftRightControl.LeftContent>
              <xmlUi:LeftRightControl.RightContent>
                <StackPanel Orientation="Horizontal">
                  <Border BorderThickness="1" BorderBrush="#FFD3D3D3" Width="108" VerticalAlignment="Center" Margin="5,0,0,0">
                    <PControl:HikHistogramSingle InnerHeight="50" Width="108" DataPoints="{Binding SelectedRange.DataPoints1}" />
                  </Border>
                  <StackPanel Orientation="Vertical" Width="68" Margin="10,0,0,0">
                    <localcontrol:SliderArrange localcontrol:SliderArrangeBase.SliderTickFrequency="1" localcontrol:SliderArrangeBase.Minimum="0" localcontrol:SliderArrangeBase.Maximum="255" localcontrol:SliderArrangeBase.StartValue="{Binding SelectedRange.C1LowTo, Mode=TwoWay}" />
                    <localcontrol:SliderArrange localcontrol:SliderArrangeBase.SliderTickFrequency="1" localcontrol:SliderArrangeBase.Minimum="0" localcontrol:SliderArrangeBase.Maximum="255" localcontrol:SliderArrangeBase.StartValue="{Binding SelectedRange.C1HighTo, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>
              </xmlUi:LeftRightControl.RightContent>
            </xmlUi:LeftRightControl>
            <xmlUi:LeftRightControl FrameworkElement.Height="64" FrameworkElement.Margin="0,10,0,0" ChildLeftWidth="108">
              <xmlUi:LeftRightControl.LeftContent>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource ChannelTwo}" ToolTip="{DynamicResource ChannelTwo}" />
              </xmlUi:LeftRightControl.LeftContent>
              <xmlUi:LeftRightControl.RightContent>
                <StackPanel Orientation="Horizontal">
                  <Border BorderThickness="1" BorderBrush="#FFD3D3D3" Width="108" VerticalAlignment="Center" Margin="5,0,0,0">
                    <PControl:HikHistogramSingle InnerHeight="50" Width="108" DataPoints="{Binding SelectedRange.DataPoints2}" />
                  </Border>
                  <StackPanel Orientation="Vertical" Width="68" Margin="10,0,0,0">
                    <localcontrol:SliderArrange localcontrol:SliderArrangeBase.SliderTickFrequency="1" localcontrol:SliderArrangeBase.Minimum="0" localcontrol:SliderArrangeBase.Maximum="255" localcontrol:SliderArrangeBase.StartValue="{Binding SelectedRange.C2LowTo, Mode=TwoWay}" />
                    <localcontrol:SliderArrange localcontrol:SliderArrangeBase.SliderTickFrequency="1" localcontrol:SliderArrangeBase.Minimum="0" localcontrol:SliderArrangeBase.Maximum="255" localcontrol:SliderArrangeBase.StartValue="{Binding SelectedRange.C2HighTo, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>
              </xmlUi:LeftRightControl.RightContent>
            </xmlUi:LeftRightControl>
            <xmlUi:LeftRightControl FrameworkElement.Height="64" FrameworkElement.Margin="0,10,0,0" ChildLeftWidth="108">
              <xmlUi:LeftRightControl.LeftContent>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource ChannelThree}" ToolTip="{DynamicResource ChannelThree}" />
              </xmlUi:LeftRightControl.LeftContent>
              <xmlUi:LeftRightControl.RightContent>
                <StackPanel Orientation="Horizontal">
                  <Border BorderThickness="1" BorderBrush="#FFD3D3D3" Width="108" VerticalAlignment="Center" Margin="5,0,0,0">
                    <PControl:HikHistogramSingle InnerHeight="50" Width="108" DataPoints="{Binding SelectedRange.DataPoints3}" />
                  </Border>
                  <StackPanel Orientation="Vertical" Width="68" Margin="10,0,0,0">
                    <localcontrol:SliderArrange localcontrol:SliderArrangeBase.SliderTickFrequency="1" localcontrol:SliderArrangeBase.Minimum="0" localcontrol:SliderArrangeBase.Maximum="255" localcontrol:SliderArrangeBase.StartValue="{Binding SelectedRange.C3LowTo, Mode=TwoWay}" />
                    <localcontrol:SliderArrange localcontrol:SliderArrangeBase.SliderTickFrequency="1" localcontrol:SliderArrangeBase.Minimum="0" localcontrol:SliderArrangeBase.Maximum="255" localcontrol:SliderArrangeBase.StartValue="{Binding SelectedRange.C3HighTo, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>
              </xmlUi:LeftRightControl.RightContent>
            </xmlUi:LeftRightControl>
            <xmlUi:LeftRightControl FrameworkElement.Height="32" ChildLeftWidth="108">
              <xmlUi:LeftRightControl.LeftContent>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource ColorInversion}" ToolTip="{DynamicResource ColorInversion}" />
              </xmlUi:LeftRightControl.LeftContent>
              <xmlUi:LeftRightControl.RightContent>
                <localcontrol:BooleanControl ToggleButton.IsChecked="{Binding SelectedRange.IsColorInversion, Mode=TwoWay}">
                  <localcontrol:BooleanControl.OffContent>
                    <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_off.png" />
                  </localcontrol:BooleanControl.OffContent>
                  <localcontrol:BooleanControl.OnContent>
                    <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_on.png" />
                  </localcontrol:BooleanControl.OnContent>
                </localcontrol:BooleanControl>
              </xmlUi:LeftRightControl.RightContent>
            </xmlUi:LeftRightControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DataTemplate>
</ResourceDictionary>