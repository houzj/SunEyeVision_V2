                    <Style TargetType="{x:Type ListViewItem}">
                      <Style.Setters>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                              <Grid Name="bd" SnapsToDevicePixels="True" Margin="0,3" Height="28">
                                <StackPanel Orientation="Horizontal" Focusable="True">
                                  <Grid Width="80" Margin="4,0,4,0">
                                    <Border Name="bord" BorderThickness="1" Background="#00FFFFFF" SnapsToDevicePixels="True" BorderBrush="{Binding MyItemState, Converter={StaticResource CheckConverter}}" />
                                    <TextBox VerticalAlignment="Center" Style="{StaticResource EdtTextBox}" BorderThickness="0" MaxLength="64" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#666666" IsReadOnly="{Binding TextBoxIsReadOnly, Mode=TwoWay}" Text="{Binding Name, Mode=TwoWay}" ToolTip="{Binding Name}" KeyDown="item_KeyDown" LostFocus="TextBox_LostFocus" />
                                  </Grid>
                                  <Grid Width="80">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="True" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#666666" Text="{Binding MaskList.Count}" />
                                    <Border Background="#00FFFFFF" />
                                  </Grid>
                                  <Grid>
                                    <Border Background="#00FFFFFF" BorderThickness="0" />
                                  </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                  <Button Focusable="False" Style="{StaticResource BaseImage_ButtonStyle}" Margin="0,0,4,0" Command="{Binding EditeCommand}">
