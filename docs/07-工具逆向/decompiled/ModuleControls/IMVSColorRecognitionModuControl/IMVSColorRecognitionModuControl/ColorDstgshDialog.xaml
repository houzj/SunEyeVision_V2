                <ComboBox Name="SensitivityComb" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" Background="#00FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#4C4C4C" ItemsSource="{Binding SensitivityModeList, ElementName=userControl}" SelectionChanged="Sensitivity_Selected" />
              </Grid>
              <Grid Row="1">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{DynamicResource FeatureType}" Margin="10,0,0,0" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#4C4C4C" />
                <ComboBox Name="FeatureComb" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" Background="#00FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#4C4C4C" ItemsSource="{Binding FeatureTypeList, ElementName=userControl}" SelectionChanged="Feature_Selected" />
              </Grid>
              <Grid Row="2">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{DynamicResource Intensity}" Margin="10,0,0,0" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#4C4C4C" />
