                                  <Trigger Property="ButtonBase.IsPressed" Value="True">
                                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/标签_ic_delete_click.png" />
                                  </Trigger>
                                  <Trigger Property="UIElement.IsEnabled" Value="False">
                                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/标签_ic_delete_disable.png" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>
