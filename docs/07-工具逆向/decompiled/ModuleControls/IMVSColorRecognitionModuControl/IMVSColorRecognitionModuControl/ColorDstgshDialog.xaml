                                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/edit_click.png" />
                                    </FrameworkElement.Tag>
                                  </Button>
                                  <Button Focusable="False" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
                                    <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/标签类_ic_delete_normal.png" />
                                    <FrameworkElement.Tag>
                                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/标签类_ic_delete_click.png" />
                                    </FrameworkElement.Tag>
                                  </Button>
                                  <Border Width="10" Background="#00FFFFFF" BorderThickness="0" />
                                </StackPanel>
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Panel.Background" Value="#FFE8E4E4" />
                                </Trigger>
                                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                  <Setter TargetName="bd" Property="Panel.Background" Value="#FFE8E4E4" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style.Setters>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListView>
              </ScrollViewer>
