          <Button Name="Submit" Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" Click="submit_Click" />
        </UniformGrid>
      </Grid>
    </Border>
    <AppPdUI:ProgressMask Grid.RowSpan="4" Message="{DynamicResource 生成模型}" DataContext="{Binding ElementName=userControl}" Visibility="{Binding IsShowProcessMask, Converter={StaticResource bool2VisibilityConverter}}" />
  </Grid>
</UserControl>