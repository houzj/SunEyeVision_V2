              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{DynamicResource Params Settings}" Margin="2,0,0,0" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#4C4C4C" FontWeight="Black" />
            </Grid>
            <Grid Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
