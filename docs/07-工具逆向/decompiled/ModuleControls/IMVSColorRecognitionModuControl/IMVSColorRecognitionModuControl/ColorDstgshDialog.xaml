                          <DataTrigger Comparison="NotEqual" Value="0" p26:PropertyChangedTrigger.Binding="{Binding SelectedItemsCount, ElementName=userControl}" xmlns:p26="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions">
