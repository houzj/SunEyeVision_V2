<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSColorRecognitionModuControl.ColorDstgshPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:local="clr-namespace:IMVSColorRecognitionModuControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization">
  <Border Padding="18,0" Background="#f2f3f5">
    <Grid UseLayoutRounding="True">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
          </ResourceDictionary.MergedDictionaries>
          <local:ItemsConverter x:Key="itemsCvt" />
          <Style x:Key="Orange_ButtonStyle2" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#D6D5D4" />
            <Setter Property="BorderBrush" Value="#B6B4B4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Background" Value="#80D6D5D4" />
                      <Setter Property="BorderBrush" Value="#80B6B4B4" />
                      <Setter Property="Foreground" Value="#80666666" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="sp2" TargetType="{x:Type Separator}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="7,0,7,0" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                  <Grid Height="18" Width="1">
                    <Line VerticalAlignment="Center" HorizontalAlignment="Center" X1="0" Y1="0" X2="0" Y2="18" Stroke="#A9A9A9" StrokeDashArray="0.75,0.5" StrokeThickness="4" />
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="sp1" TargetType="{x:Type ItemsControl}">
            <Style.Triggers>
              <DataTrigger Value="true" Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=ItemsSource, Converter={StaticResource itemsCvt}}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="0.6*" />
                          <RowDefinition Height="auto" />
                          <RowDefinition Height="auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Row="1" Grid.Column="1" Source="/Apps.XmlUI;component/Resources/pic_颜色识别.png" />
                        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource 请添加模型}" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#4D4D4D" />
                      </Grid>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Menu Name="Menu" Grid.Row="0" HorizontalAlignment="Left" Background="#00FFFFFF" Height="32">
        <controls:IconMenuItem ToolTip="{DynamicResource 创建}" Margin="0,4,0,0" ShowMask="False" Height="24" Width="30" NormalIcon="/Apps.XmlUI;component/Resources/ic_创建_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/ic_创建_click.png" ClickIcon="/Apps.XmlUI;component/Resources/ic_创建_click.png" Click="CreatModel_Click" />
        <controls:IconMenuItem ToolTip="{DynamicResource 导入}" Margin="0,4,0,0" ShowMask="False" Height="24" Width="30" NormalIcon="/Apps.XmlUI;component/Resources/ic_导入_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/ic_导入_click.png" ClickIcon="/Apps.XmlUI;component/Resources/ic_导入_click.png" Click="LoadModel_Click" />
        <controls:IconMenuItem ToolTip="{DynamicResource 导出}" Margin="0,4,0,0" ShowMask="False" Height="24" Width="30" NormalIcon="/Apps.XmlUI;component/Resources/ic_导出2_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/ic_导出2_click.png" ClickIcon="/Apps.XmlUI;component/Resources/ic_导出2_click.png" Click="ExportModel_Click" />
        <controls:IconMenuItem ToolTip="{DynamicResource Lang_Delet}" Margin="0,4,0,0" ShowMask="False" Height="24" Width="30" NormalIcon="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" HoverIcon="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" ClickIcon="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Click="ClearModel_Click" />
      </Menu>
      <Button Name="Button" Grid.Row="0" Width="94" Height="26" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource BottomButtonStyle}" Click="EditModel_Click">
        <StackPanel Orientation="Horizontal">
          <Image VerticalAlignment="Center" Margin="0,0,3,0">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Image}">
                <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_normal.png" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding ElementName=Button, Path=IsPressed}">
                    <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_click.png" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding ElementName=Button, Path=IsMouseOver}">
                    <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_click.png" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding ElementName=Button, Path=IsEnabled}">
                    <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_normal.png" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Image>
          <ContentControl Content="{DynamicResource Lang_ColorDistinguish_ModifyModel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Border Grid.Row="2" BorderBrush="#E0DFDE" BorderThickness="1" Margin="0,5,0,10">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <ItemsPanelTemplate x:Key="ItemsPanelTemplate">
              <WrapPanel IsItemsHost="True" HorizontalAlignment="Center" Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="DataTemplate">
              <Border BorderBrush="#00FFFFFF" BorderThickness="2" Margin="5">
                <StackPanel Orientation="Vertical">
                  <Image Width="38" Height="54" Stretch="Uniform" HorizontalAlignment="Center" Source="{Binding Source}" />
                  <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" TextTrimming="CharacterEllipsis" Width="38" Text="{Binding Name}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ScrollViewer Name="ScrollViewer" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="ItemsControl" Style="{StaticResource sp1}" ItemsPanel="{DynamicResource ItemsPanelTemplate}" ItemTemplate="{DynamicResource DataTemplate}" />
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</UserControl>