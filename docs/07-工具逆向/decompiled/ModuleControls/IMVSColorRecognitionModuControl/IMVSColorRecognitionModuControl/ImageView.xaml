<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSColorRecognitionModuControl.ImageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:imvscolorrecognitionmoducontrol="clr-namespace:IMVSColorRecognitionModuControl;assembly=IMVSColorRecognitionModuControl">
  <Grid>
    <Grid Name="TempGrid">
      <Image Name="ImageItem" Stretch="Fill" Source="{Binding ImageSource, Mode=OneWay}" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" />
      <StackPanel Name="LstItemPanel" VerticalAlignment="Top" Background="#FF000000" Opacity="0.6" Visibility="Collapsed" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave">
        <TextBlock Foreground="#FFFFFFFF" Height="20" HorizontalAlignment="Center" FontSize="12" Text="{Binding ImageName}" ToolTip="{Binding ImagePath}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>