<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="IMVSEdgeFlawInspModuControl.EdgepatMatchConfigPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF808080" xmlns:imvsedgeflawinspmoducontrol="clr-namespace:IMVSEdgeFlawInspModuControl;assembly=IMVSEdgeFlawInspModuControl" IsVisibleChanged="UserControl_IsVisibleChanged">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Background="#00FFFFFF" Margin="18,18,18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="41" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <commomcontrol:SuperImageButton Name="Build" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Build_Click">
          <commomcontrol:SuperImageButton.NormalConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_创建_normal.png" Stretch="None" />
          </commomcontrol:SuperImageButton.NormalConnent>
          <commomcontrol:SuperImageButton.DisableConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_创建_disable.png" Stretch="None" />
          </commomcontrol:SuperImageButton.DisableConnent>
          <commomcontrol:SuperImageButton.PressedConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_创建_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.PressedConnent>
          <commomcontrol:SuperImageButton.MOverConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_创建_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.MOverConnent>
        </commomcontrol:SuperImageButton>
        <commomcontrol:SuperImageButton Name="LoadModule" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,0,0,0" Click="LoadModule_Click">
          <commomcontrol:SuperImageButton.NormalConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_normal.png" Stretch="None" />
          </commomcontrol:SuperImageButton.NormalConnent>
          <commomcontrol:SuperImageButton.DisableConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_disabkle.png" Stretch="None" />
          </commomcontrol:SuperImageButton.DisableConnent>
          <commomcontrol:SuperImageButton.PressedConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.PressedConnent>
          <commomcontrol:SuperImageButton.MOverConnent>
            <Image Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" Stretch="None" />
          </commomcontrol:SuperImageButton.MOverConnent>
        </commomcontrol:SuperImageButton>
        <Button Name="btnEditTemplate" Height="26" Width="94" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource btnEditTemplateStyle}" IsEnabled="False" Click="btnEditTemplate_Click" />
        <Border Grid.Row="1" CornerRadius="1" BorderBrush="#E0DFDE" Background="#FCFCFC" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Name="imageView" Source="/Apps.XmlUI;component/Resources/pic_边缘缺陷检测.png" Stretch="None" />
          </StackPanel>
        </Border>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>