<?xml version="1.0" encoding="utf-8"?>
<mcontrols:BaseWindow x:Class="IMVSEdgePairFlawInspModuControl.EdgepatMatchDialogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:mcontrols="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:localcontrol="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:controls="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:local="clr-namespace:IMVSEdgePairFlawInspModuControl" xmlns:localControl="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:myControl="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" x:Name="userControl" Title="{DynamicResource Tab_Model configuration}" MinButtonVisibility="Collapsed" ShowInTaskbar="False" Height="534" Width="820">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/DataGridStyle/DataGridStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="showCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content">
                    <Setter.Value>
                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_disable.png" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <Grid Row="0" Background="#f2f3f4">
      <Border Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Padding="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="30" />
              </Grid.ColumnDefinitions>
              <commomcontrol:SuperImageButton Name="Save" Grid.Column="1" ToolTip="{DynamicResource 保存模型工程}" Click="Save_Click">
                <commomcontrol:SuperImageButton.NormalConnent>
                  <Image Source="/Apps.Style;component/Resources/ic_导出_normal.png" />
                </commomcontrol:SuperImageButton.NormalConnent>
                <commomcontrol:SuperImageButton.DisableConnent>
                  <Image Source="/Apps.Style;component/Resources/ic_导出_disable.png" />
                </commomcontrol:SuperImageButton.DisableConnent>
                <commomcontrol:SuperImageButton.PressedConnent>
                  <Image Source="/Apps.Style;component/Resources/ic_导出_click.png" />
                </commomcontrol:SuperImageButton.PressedConnent>
                <commomcontrol:SuperImageButton.MOverConnent>
                  <Image Source="/Apps.Style;component/Resources/ic_导出_click.png" />
                </commomcontrol:SuperImageButton.MOverConnent>
              </commomcontrol:SuperImageButton>
              <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                <Button Name="CurImgBtn" Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,7,8,6" Content="{DynamicResource Lang_SelectCurrentImage}" Click="Button_Click_1" />
                <Button Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,7,5,6" Content="{DynamicResource Lang_SelectOtherImage}" Click="Button_Click" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{Binding ParamListWidth, ElementName=userControl}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#E6E6E6" BorderThickness="1" Margin="0,0,5,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#E6E6E6" BorderThickness="0,0,0,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
                  <Grid Row="0" Background="#fcfcfc">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                      <UniformGrid Columns="2" Width="68">
                        <RadioButton Name="Arrow" GroupName="ty" IsChecked="True" Background="#00FFFFFF" ToolTip="{DynamicResource 移动图像}" Style="{StaticResource showCrossToggleButtonStyle}">
                          <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_箭头_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_箭头_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                        <RadioButton Name="hikPath" GroupName="ty" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource Lang_CreatePolyLine}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_折线_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_折线_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                      </UniformGrid>
                      <Path Grid.Column="10" Data="M0,0 L0,1" Stretch="Fill" Height="15" Stroke="#FFD3D3D3" StrokeThickness="1" Margin="0,8,0,8" />
                      <UniformGrid Columns="7" Width="250">
                        <Button Name="Match" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle3}" ToolTip="{DynamicResource Lang_buildModel}" Click="Match_Click">
                          <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_生成学习模板_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_生成学习模板_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Canvas Name="iBack" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Width="32">
                          <RadioButton Name="ckbMask" GroupName="ty" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 擦除轮廓点}" Canvas.Left="0" Canvas.Top="0" IsEnabled="{Binding EditOutlinePointsEnable}" Checked="ckbMask_Checked" Unchecked="ckbMask_Unchecked">
                            <Image Source="/Apps.Style;component/Resources/ic_橡皮擦2_normal.png" />
                            <FrameworkElement.Tag>
                              <Image Source="/Apps.Style;component/Resources/ic_橡皮擦2_click.png" />
                            </FrameworkElement.Tag>
                          </RadioButton>
                          <myControl:ResultOverviewPopupButton Name="setBtn" FrameworkElement.ToolTip="{DynamicResource 调整橡皮擦大小}" ButtonStyle="{StaticResource setCrossToggleButtonStyle}" Canvas.Left="20" Canvas.Top="0" FrameworkElement.Width="12" FrameworkElement.Height="32" HorizontalOffsetVal="-45" VerticalOffsetVal="18" FrameworkElement.DataContext="{Binding ElementName=userControl}">
                            <myControl:ResultOverviewPopupButton.SubContent>
                              <ContentControl>
                                <myControl:PxSlider Value="{Binding PanRectWidth, Mode=TwoWay}">
                                  <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="OnThumbMouseLeftButtonDown">
                                      <core:CallMethodAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" MethodName="ThumbMouseLeftButtonDown" TargetObject="{Binding}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="OnThumbMouseLeftButtonUp">
                                      <CallMethodAction MethodName="ThumbMouseLeftButtonUp" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                                    </i:EventTrigger>
                                  </i:Interaction.Triggers>
                                </myControl:PxSlider>
                              </ContentControl>
                            </myControl:ResultOverviewPopupButton.SubContent>
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type UserControl}">
                                <Setter Property="UIElement.IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                  <DataTrigger Value="true" Binding="{Binding ElementName=ckbMask, Path=IsChecked}">
                                    <Setter Property="UIElement.IsHitTestVisible" Value="True" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                            <!--Unknown connection ID: 10-->
                          </myControl:ResultOverviewPopupButton>
                        </Canvas>
                        <Button Name="clear" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Clear}" Click="clear_Click">
                          <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_清空图片_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_清空图片_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="BackStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource 撤销}" IsEnabled="{Binding BackEnable, ElementName=userControl}" Click="BackStep_Click">
                          <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_上一步_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_上一步_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="ForwardStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_Redo}" IsEnabled="{Binding ForwardEnable, ElementName=userControl}" Click="ForwardStep_Click">
                          <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_下一步_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_下一步_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="import" Visibility="Collapsed" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource 导入}" Click="Import_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_导入_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_导入_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="export" Visibility="Collapsed" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource 导出}" Click="Export_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_导出2_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_导出2_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </UniformGrid>
                    </StackPanel>
                    <UniformGrid Grid.Row="0" Columns="4" Width="150" HorizontalAlignment="Right">
                      <controls:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ElementName=imageView}" />
                      <controls:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ElementName=imageView}" />
                      <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
                      <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
                    </UniformGrid>
                  </Grid>
                </Border>
                <Grid Name="viewGrid" Row="1">
                  <localcontrol:HikImageView Name="imageView" NeedLargePoints="True" Margin="1" ShapeList="{Binding ShapesData}" RoiList="{Binding ItemsData, Mode=TwoWay}" PointsData="{Binding PointsData}" DataContext="{Binding ElementName=userControl, Path=DataContext}" />
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" Visibility="Collapsed" Grid.Row="0" BorderBrush="#e6e6e6" BorderThickness="1" Margin="0,0,0,10">
              <DataGrid Name="dataGrid" Style="{StaticResource dataGridStyle}" ColumnHeaderStyle="{StaticResource dataGridColumnHeaderStyle}" RowStyle="{StaticResource dataGridRowStyle}" CellStyle="{StaticResource dataGridCellStyle}" ItemsSource="{Binding PathPoints}" SelectedItem="{Binding SelectItem, Mode=TwoWay}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{DynamicResource Number}" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Index}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{DynamicResource X坐标}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Height="30" BorderThickness="0" Background="#00FFFFFF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{DynamicResource Y坐标}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Height="30" BorderThickness="0" Background="#00FFFFFF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Grid Column="1" Row="1">
              <ScrollViewer Style="{StaticResource RecScrollViewer}" Tag="1">
                <Border Background="#FFFFFFFF" BorderBrush="#e6e6e6" BorderThickness="1">
                  <StackPanel Margin="0,0,10,0">
                    <StackPanel Margin="10,12,0,0" Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource 起始范围}" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="#FF4D4D4D" Width="auto" />
                      <Image Margin="3,1,1,1" Height="18" Width="18" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Apps.XmlUI;component/Resources/ic_help_normal.png">
                        <FrameworkElement.ToolTip>
                          <TextBlock Text="{DynamicResource 生成轨迹描述}" Width="auto" TextWrapping="Wrap" />
                        </FrameworkElement.ToolTip>
                      </Image>
                    </StackPanel>
                    <localControl:ParamListView ItemsControl.ItemContainerStyle="{StaticResource ParamItemStyle}" ChildMargin="10, 1, 5, 0" FrameworkElement.DataContext="{Binding ElementName=userControl, Path=ParentDataSource}" ChildLeftWidth="{Binding LeftTextWidth, ElementName=userControl}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                          <Themes:ListBoxChrome BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="#00FFFFFF" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderFocused="{TemplateBinding UIElement.IsKeyboardFocusWithin}" UIElement.SnapsToDevicePixels="True">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                          </Themes:ListBoxChrome>
                        </ControlTemplate>
                      </Control.Template>
                    </localControl:ParamListView>
                  </StackPanel>
                </Border>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" BorderBrush="#C2C2C2" BorderThickness="0,1,0,0">
      <Grid Background="#E6E6E6">
        <StatusBar Name="statusBarMain" Grid.Row="1" Height="25" Background="#00FFFFFF" Foreground="#808080" FontSize="13">
          <StatusBarItem Content=" ( x , y ) : " />
          <StatusBarItem Name="xyVal" Content="(000)" HorizontalContentAlignment="Center" />
          <StatusBarItem Content="{DynamicResource 灰度值}" />
          <StatusBarItem Name="grayVal" Content="000" HorizontalContentAlignment="Center" HorizontalAlignment="Left" />
        </StatusBar>
        <Grid HorizontalAlignment="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Name="InitFixtureInfo" Grid.Column="0" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Content="{DynamicResource Lang_ClearReference}" Click="InitFixtureInfo_Click" />
          <Button Name="OK" Grid.Column="1" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Content="{DynamicResource Confirm}" Click="OK_Click" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</mcontrols:BaseWindow>