<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Apps.XmlParser.ParamTab" xmlns:localAppsXmlUI="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="Command_EnumEntry">
    <StackPanel Width="100" Height="60" Orientation="Vertical" Margin="5,3,5,0">
      <RadioButton Name="btnCmdType" Focusable="True" Height="50" IsThreeState="False" HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadioButtonStyle}" Content="{Binding DisplayTitleA}" IsEnabled="{Binding IsEnableA}" IsChecked="{Binding IsSelectedA}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Checked">
            <i:InvokeCommandAction Command="{Binding CheckedCommand}" />
          </i:EventTrigger>
          <i:EventTrigger EventName="Click">
            <i:InvokeCommandAction Command="{Binding ClickCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </RadioButton>
      <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Binding DescriptionA}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="CommandSelecter_Frame_Old">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>
      <ItemsControl Grid.Row="0" ItemTemplate="{StaticResource Command_EnumEntry}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <StackPanel Grid.Row="1" Height="30" Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="{DynamicResource 已统计图像数量}" HorizontalAlignment="Center" />
        <TextBlock HorizontalAlignment="Center" Text="{Binding ImgCountA}" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CommandSelecter_Frame">
    <Grid Margin="37,0,35,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="73" />
        <RowDefinition Height="16" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="0,2,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding LangCurrentImageWidth}" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="{Binding LangCurrentImageWidth}" />
        </Grid.ColumnDefinitions>
        <RadioButton Name="btnInclude" Focusable="True" Grid.Column="0" IsThreeState="False" HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadioButtonStyle}" IsEnabled="{Binding EnumEntrysA[0].IsEnableA}" IsChecked="{Binding EnumEntrysA[0].IsSelectedA}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="Checked">
              <i:InvokeCommandAction Command="{Binding EnumEntrysA[0].CheckedCommand}" />
            </i:EventTrigger>
            <i:EventTrigger EventName="Click">
              <i:InvokeCommandAction Command="{Binding EnumEntrysA[0].ClickCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <StackPanel Orientation="Vertical">
            <Image Source="/Apps.XmlUI;component/Resources/统计当前图像.png" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,9,0,0" Width="46" Height="34" />
            <TextBlock Text="{DynamicResource Record CurrentImage}" ToolTip="{DynamicResource Record CurrentImage}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12" Margin="0,1" Height="24" />
          </StackPanel>
        </RadioButton>
        <RadioButton Name="btnExclude" Focusable="True" Grid.Column="2" IsThreeState="False" HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadioButtonStyle}" IsEnabled="{Binding EnumEntrysA[1].IsEnableA}" IsChecked="{Binding EnumEntrysA[1].IsSelectedA}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="Checked">
              <i:InvokeCommandAction Command="{Binding EnumEntrysA[1].CheckedCommand}" />
            </i:EventTrigger>
            <i:EventTrigger EventName="Click">
              <i:InvokeCommandAction Command="{Binding EnumEntrysA[1].ClickCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <StackPanel Orientation="Vertical">
            <Image Source="/Apps.XmlUI;component/Resources/不统计当前图像 copy.png" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,9,0,0" Width="46" Height="34" />
            <TextBlock Text="{DynamicResource NoRecord CurrentImage}" ToolTip="{DynamicResource NoRecord CurrentImage}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12" Margin="0,1" Height="24" />
          </StackPanel>
        </RadioButton>
      </Grid>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="246" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Height="32" Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource 已统计图像数量}" HorizontalAlignment="Left" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#FF4C4C4C" VerticalAlignment="Center" />
          <TextBlock HorizontalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="24" Foreground="#FF4C4C4C" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding ImgCountA}" />
        </StackPanel>
        <RadioButton Name="btnClear" Focusable="True" Grid.Column="1" Height="32" IsThreeState="False" Background="#00FFFFFF" HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadbtnDeleteStyle}" IsEnabled="{Binding EnumEntrysA[2].IsEnableA}" IsChecked="{Binding EnumEntrysA[2].IsSelectedA}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="Checked">
              <i:InvokeCommandAction Command="{Binding EnumEntrysA[2].CheckedCommand}" />
            </i:EventTrigger>
            <i:EventTrigger EventName="Click">
              <i:InvokeCommandAction Command="{Binding EnumEntrysA[2].ClickCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Grid>
            <Image Name="Image" Stretch="Uniform" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" HorizontalAlignment="Left" />
          </Grid>
        </RadioButton>
      </Grid>
    </Grid>
  </DataTemplate>
</ResourceDictionary>