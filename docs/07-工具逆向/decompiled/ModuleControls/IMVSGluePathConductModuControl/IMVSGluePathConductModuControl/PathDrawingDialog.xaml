<?xml version="1.0" encoding="utf-8"?>
<vmControls:BaseWindow x:Class="IMVSGluePathConductModuControl.PathDrawingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vmControls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:localcontrol="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:controls="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:localControl="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="window" Height="534" Width="820" xmlns:imvsgluepathconductmoducontrol="clr-namespace:IMVSGluePathConductModuControl;assembly=IMVSGluePathConductModuControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="mainGrid">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.Style;component/DataGridStyle/DataGridStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
          <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="showCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Name="iBorder" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                  <ContentPresenter Name="con" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="con" Property="ContentPresenter.Content">
                      <Setter.Value>
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_disable.png" />
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ButtonBase.ClickMode" Value="Press" />
        </Style>
        <Style x:Key="ImageButtonStyle3" TargetType="{x:Type Button}">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                  <ContentPresenter Name="con" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="ListViewStyle1" TargetType="{x:Type ListView}">
          <Setter Property="Background" Value="#fcfcfc" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
          <Setter Property="ScrollViewer.PanningMode" Value="Both" />
          <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListView}">
                <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="1" SnapsToDevicePixels="True">
                  <ScrollViewer Focusable="False" Padding="{TemplateBinding Control.Padding}" Tag="1" Style="{StaticResource RecScrollViewer}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  </ScrollViewer>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="ItemsControl.IsGrouping" Value="True" />
                      <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
          <Style.Setters>
            <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                  <Border Name="bd" BorderThickness="1" BorderBrush="#e6e6e6" SnapsToDevicePixels="True" Background="#FFFFFFFF" Height="30px">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                      </Grid.ColumnDefinitions>
                      <Grid Column="0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="20px" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Text="{Binding Name}" />
                      </Grid>
                      <DockPanel Grid.Column="1" LastChildFill="False">
                        <Button Name="Down" DockPanel.Dock="Right" Background="#00FFFFFF" Margin="10,0" Style="{StaticResource ImageButtonStyle3}" Click="Down_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="Up" DockPanel.Dock="Right" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle3}" Click="Up_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </DockPanel>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                    </Trigger>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style.Setters>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <Grid Row="0" Background="#f2f3f5">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,5">
          <Button Name="CurImgBtn" Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,4,8,6" Content="{DynamicResource Lang_SelectCurrentImage}" Click="CurImgButton_Click" />
          <Button Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,4,0,6" Content="{DynamicResource Lang_SelectOtherImage}" Click="OtherImgButton_Click" />
        </StackPanel>
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="270" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#E6E6E6" BorderThickness="1" Margin="0,0,5,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border BorderBrush="#E6E6E6" BorderThickness="0,0,0,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid Row="0" Background="#fcfcfc">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <UniformGrid Columns="3" Width="102">
                      <RadioButton Name="Arrow" GroupName="ty" IsChecked="True" Background="#00FFFFFF" ToolTip="{DynamicResource 移动图像}" Style="{StaticResource showCrossToggleButtonStyle}">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_click.png" />
                        </FrameworkElement.Tag>
                      </RadioButton>
                      <RadioButton Name="hikPath" GroupName="ty" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource Lang_CreatePolyLine}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_折线_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_折线_click.png" />
                        </FrameworkElement.Tag>
                      </RadioButton>
                      <RadioButton Name="hikCoverCircle" GroupName="ty" IsEnabled="True" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 创建扇圆形掩膜}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制圆_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制圆_click.png" />
                        </FrameworkElement.Tag>
                      </RadioButton>
                    </UniformGrid>
                    <Path Grid.Column="10" Data="M0,0 L0,1" Stretch="Fill" Height="15" Stroke="#FFD3D3D3" StrokeThickness="1" Margin="0,8,0,8" />
                    <UniformGrid Columns="7" Width="250">
                      <Button Name="Match" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle3}" ToolTip="{DynamicResource Lang_buildModel}" Click="Match_Click">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_生成学习模板_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_生成学习模板_click.png" />
                        </FrameworkElement.Tag>
                      </Button>
                      <Button Name="clear" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Clear}" Click="Clear_Click">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                        </FrameworkElement.Tag>
                      </Button>
                      <Button Name="BackStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource 撤销}" IsEnabled="{Binding BackEnable, ElementName=window}" Click="BackStep_Click">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_click.png" />
                        </FrameworkElement.Tag>
                      </Button>
                      <Button Name="ForwardStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_Redo}" IsEnabled="{Binding ForwardEnable, ElementName=window}" Click="ForwardStep_Click">
                        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_click.png" />
                        </FrameworkElement.Tag>
                      </Button>
                    </UniformGrid>
                  </StackPanel>
                  <UniformGrid Grid.Row="0" Columns="4" Width="150" HorizontalAlignment="Right">
                    <controls:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ElementName=imageView}" />
                    <controls:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ElementName=imageView}" />
                    <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
                    <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
                  </UniformGrid>
                </Grid>
              </Border>
              <Grid Name="viewGrid" Row="1">
                <localcontrol:HikImageView Name="imageView" NeedLargePoints="True" Margin="1" ShapeList="{Binding ShapesData}" RoiList="{Binding ItemsData, Mode=TwoWay}" PointsData="{Binding PointsData}" DataContext="{Binding ElementName=mainGrid, Path=DataContext}" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" BorderBrush="#e6e6e6" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
              </Grid.RowDefinitions>
              <ListView Style="{StaticResource ListViewStyle1}" BorderBrush="#e6e6e6" ItemsSource="{Binding Paths, ElementName=window, Mode=OneWay}" SelectedItem="{Binding SelectedPath, ElementName=window, Mode=TwoWay}" />
              <localControl:ParamListView Name="paramList" Grid.Row="1" FrameworkElement.Style="{StaticResource ParamListViewStyle}" ItemsControl.ItemContainerStyle="{StaticResource ParamItemStyle}" Control.Background="#FFFFFFFF" ChildMargin="10, 1, 5, 0" ChildLeftWidth="120" UIElement.Visibility="Collapsed" FrameworkElement.DataContext="{Binding ElementName=window, Path=ParentDataSource}">
                <!--Unknown connection ID: 18-->
              </localControl:ParamListView>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#E6E6E6" BorderThickness="0,1,0,0" BorderBrush="#C2C2C2">
      <Grid>
        <StatusBar Height="25" Background="#00FFFFFF" Foreground="#808080" FontSize="13" HorizontalAlignment="Left">
          <StatusBarItem Content="   x : " />
          <StatusBarItem Name="xVal" Content="--" HorizontalContentAlignment="Center" />
          <StatusBarItem Content="  y : " />
          <StatusBarItem Name="yVal" Content="--" HorizontalContentAlignment="Center" />
          <StatusBarItem Content="  " />
          <StatusBarItem Content="{DynamicResource 灰度值}" />
          <StatusBarItem Name="grayVal" Content="000" HorizontalContentAlignment="Center" HorizontalAlignment="Left" />
        </StatusBar>
        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Name="InitFixtureInfo" Style="{StaticResource BottomButtonStyle}" HorizontalAlignment="Right" Margin="0,0,10,0" Content="{DynamicResource Lang_ClearReference}" ToolTip="{DynamicResource Lang_ClearReference}" Click="InitFixtureInfo_Click" />
          <Button Style="{StaticResource BottomButtonStyle}" Margin="0" Content="{DynamicResource Lang_OK}" ToolTip="{DynamicResource Lang_OK}" HorizontalAlignment="Right" Click="Finish_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</vmControls:BaseWindow>