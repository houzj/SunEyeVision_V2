<?xml version="1.0" encoding="utf-8"?>
<Wpf:TabWinBase x:Class="IMVSGroupControl.ParamsTabControl4Group" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:IMVSGroupControl" xmlns:Wpf="clr-namespace:VMControls.WPF;assembly=VMControls.WPF" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:dynamicControl="clr-namespace:DynamicObjectConfigControl;assembly=DynamicObjectConfigControl" x:Name="win" IsCustomPosition="True">
