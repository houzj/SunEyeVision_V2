<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IMVSGroupControl" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="ButtonSelecter_LoopControl_sub">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ContentControl Grid.Column="0" ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding CmpTypeA}" />
      <ContentControl Grid.Column="2" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding SelecterA}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_LoopControl">
    <localParamTab:LeftRightControl FrameworkElement.Height="32">
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource ButtonSelecter_LoopControl_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
</ResourceDictionary>