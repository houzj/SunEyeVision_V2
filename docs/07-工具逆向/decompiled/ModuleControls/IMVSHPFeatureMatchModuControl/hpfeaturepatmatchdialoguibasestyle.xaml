<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IMVSHPFeatureMatchModuControl" xmlns:appUI="clr-namespace:Apps.PcUI.Controls;assembly=Apps.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:controls="clr-namespace:Apps.PcUI.Controls;assembly=Apps.PcUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
    <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <local:DoubleToFloatConvert x:Key="cvtDoubleToFloat" />
  <Style x:Key="HikTextBoxStyle" TargetType="{x:Type appUI:HikTextBox}" BasedOn="{StaticResource NormalTextBoxStyle}">
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding MatchPointLock}">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="BottomBorder">
    <Border BorderBrush="#C2C2C2" BorderThickness="0,1,0,0">
      <Grid Background="#E6E6E6">
        <StatusBar Name="statusBarMain" Grid.Row="1" Height="30" Background="#00FFFFFF" Foreground="#808080" FontSize="13">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StatusBarItem Content="{DynamicResource 匹配中心}" />
            <StatusBarItem Content=":(" />
            <Border BorderThickness="1" CornerRadius="4">
              <controls:HikTextBox Name="FixX" Width="76" TextAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource HikTextBoxStyle}" Text="{Binding FixPointX, Converter={StaticResource cvtDoubleToFloat}}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <StatusBarItem Content="," />
            <Border BorderThickness="1" CornerRadius="4">
              <controls:HikTextBox Name="FixY" Width="76" TextAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource HikTextBoxStyle}" Text="{Binding FixPointY, Converter={StaticResource cvtDoubleToFloat}}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <StatusBarItem Content=")" />
            <CheckBox Name="isLock" Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource CheckBoxStyle1}" IsChecked="{Binding MatchPointLock, Mode=TwoWay}" />
            <TextBlock Text="{DynamicResource Lang_Locking}" VerticalAlignment="Center" />
          </StackPanel>
        </StatusBar>
        <Grid HorizontalAlignment="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Margin="0,0,10,0" Content="{DynamicResource Confirm}" Style="{StaticResource BottomButtonStyle}" Command="{Binding ConfirmCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:HPFeaturepatMatchDialogUI}}" />
        </Grid>
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="Shadow">
    <controls:ProgressMask Message="{DynamicResource 生成模型}" IsShowProgressBar="False" />
  </DataTemplate>
</ResourceDictionary>