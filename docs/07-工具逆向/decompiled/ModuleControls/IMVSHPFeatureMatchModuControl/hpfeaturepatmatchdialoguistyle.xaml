                              </Style.Setters>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                        </ListView>
                        <Separator Grid.Row="2" Margin="10" BorderThickness="1" BorderBrush="#E0DFDE" />
                        <GroupBox Name="FeatureConfig" Grid.Row="3" Background="#FCFFFFFF" BorderBrush="#00FFFFFF" Height="210">
                          <HeaderedContentControl.HeaderTemplate>
                            <DataTemplate>
                              <TextBlock Name="txtHeader" Text="{DynamicResource Tab_Match Params}" Margin="3,0,0,0" Foreground="#4C4C4C" FontFamily="Microsoft YaHei" FontSize="14" FontWeight="Bold" />
                            </DataTemplate>
                          </HeaderedContentControl.HeaderTemplate>
                          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Style="{StaticResource shrinkScrollViewer}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource PyramidScaleFlag}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Lang_Compressibility}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource 特征尺度}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Thresh Mode}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Lang_ContrastThreshold}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="5" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource ChainFlag}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="6" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource MinChainLen}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <ComboBox Grid.Row="0" Grid.Column="1" Height="25" Width="100" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding PyramidscaleModeSel, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                                <ComboBoxItem Content="{DynamicResource Mannual}" />
                              </ComboBox>
                              <pcuicontrol:SliderArrangeFloat Grid.Row="1" Grid.Column="1" Width="100" SliderTickFrequency="0.1" Minimum="1" Maximum="20" DecimalDigits="1" StartValue="{Binding RoughPyramidscale, Mode=TwoWay}" IsEnabled="{Binding PyramidscaleEnable}" />
                              <pcuicontrol:SliderArrange Grid.Row="2" Grid.Column="1" Width="100" SliderTickFrequency="1" Minimum="1" StartValue="{Binding FinePyramidscale, Mode=TwoWay}" Maximum="{Binding RoughPyramidscale, Mode=TwoWay, Converter={StaticResource cvtFloatToInt}}" IsEnabled="{Binding PyramidscaleEnable}" />
                              <ComboBox Grid.Row="3" Grid.Column="1" Height="25" Width="100" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding ThresholdModeSel, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                                <ComboBoxItem Content="{DynamicResource Mannual}" />
                              </ComboBox>
                              <pcuicontrol:SliderArrange Grid.Row="4" Grid.Column="1" Width="100" Minimum="1" Maximum="255" StartValue="{Binding HighThreshold, Mode=TwoWay}" IsEnabled="{Binding ThresholdEnable}" />
                              <ComboBox Name="ComboBoxChainFlag" Grid.Row="5" Grid.Column="1" Width="100" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding ChainFlag, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="{DynamicResource Mannual}" />
                                <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                              </ComboBox>
                              <pcuicontrol:SliderArrange Grid.Row="6" Grid.Column="1" Width="100" SliderTickFrequency="1" Minimum="2" Maximum="1000" StartValue="{Binding MinChainLen, Mode=TwoWay}" IsEnabled="{Binding ElementName=ComboBoxChainFlag, Path=SelectedIndex, Converter={x:Static local:ModeToEnableCvt.Cvt}}" />
                            </Grid>
                          </ScrollViewer>
                        </GroupBox>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource BottomBorder}" Content="{Binding}" />
            <ContentControl Name="windowShadow" Margin="-50,-50,-50,-50" Visibility="Collapsed" ContentTemplate="{StaticResource Shadow}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsUsePen}">
              <Setter TargetName="hikCoverCircle" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="hikSector" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="hikFrame" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="hikPolygon" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="iBack" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="iPen" Property="UIElement.Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding MatchPointLock}">
              <Setter TargetName="hikCross" Property="UIElement.Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>