<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSImgStitchCalibModuControl.ImgStitchPannel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="userControl" Height="370" Width="400" xmlns:imvsimgstitchcalibmoducontrol="clr-namespace:IMVSImgStitchCalibModuControl;assembly=IMVSImgStitchCalibModuControl" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="10,0,6,0">
    <Grid Name="mainGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <Button Name="BtnNewModel" Width="94" Click="BtnNewModel_Click">
          <StackPanel Orientation="Horizontal">
            <Image VerticalAlignment="Center" Margin="0" Width="20" Height="20">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Image}">
                  <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板_normal.png" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding ElementName=BtnNewModel, Path=IsPressed}">
                      <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板_click.png" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding ElementName=BtnNewModel, Path=IsMouseOver}">
                      <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板_click.png" />
                    </DataTrigger>
                    <DataTrigger Value="False" Binding="{Binding ElementName=BtnNewModel, Path=IsEnabled}">
                      <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/btn_新建模板 _disable.png" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Image>
            <ContentControl VerticalAlignment="Center" Content="{DynamicResource 新建模型}" />
          </StackPanel>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding HasModel}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
        <Button Name="BtnEditModel" Style="{StaticResource BottomButtonStyle}" Margin="5,0,0,0" Width="94" Visibility="{Binding HasModel, Converter={StaticResource bool2VisibilityConverter}}" Click="BtnEditModel_Click">
          <StackPanel Orientation="Horizontal">
            <Image VerticalAlignment="Center" Margin="0" Width="20" Height="20">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Image}">
                  <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_normal.png" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding ElementName=BtnEditModel, Path=IsPressed}">
                      <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_click.png" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding ElementName=BtnEditModel, Path=IsMouseOver}">
                      <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_click.png" />
                    </DataTrigger>
                    <DataTrigger Value="False" Binding="{Binding ElementName=BtnEditModel, Path=IsEnabled}">
                      <Setter Property="Source" Value="/Apps.XmlUI;component/Resources/ic_btn_edit_disable.png" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Image>
            <ContentControl VerticalAlignment="Center" Content="{DynamicResource Lang_ColorDistinguish_ModifyModel}" />
          </StackPanel>
        </Button>
        <Button Name="BtnClear" ToolTip="{DynamicResource 清空模型}" DockPanel.Dock="Right" Height="34" Width="34" IsEnabled="{Binding HasModel}" Click="BtnClear_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Image Name="ImageBackground" Width="34" Height="34" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <Button ToolTip="{DynamicResource 导出}" DockPanel.Dock="Right" Height="34" Width="34" IsEnabled="{Binding HasModel}" Click="Export_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Image Name="ImageBackground" Width="34" Height="34" Source="/Apps.XmlUI;component/Resources/ic_导出2_normal.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_导出2_click.png" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_导出2_click.png" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_导出2_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <Button ToolTip="{DynamicResource 导入}" DockPanel.Dock="Right" Height="34" Width="34" Click="Import_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Image Name="ImageBackground" Width="34" Height="34" Source="/Apps.XmlUI;component/Resources/ic_导入_normal.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_导入_click.png" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_导入_click.png" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_导入_disabkle.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DockPanel>
      <Border Name="BdImagePanel" Grid.Row="1" Background="#FCFCFC" BorderBrush="#E0DFDE" BorderThickness="1" CornerRadius="1" Visibility="{Binding HasModel, Converter={StaticResource bool2VisibilityConverter}}">
        <UniformGrid Name="UniformImageList" />
      </Border>
      <Border Grid.Row="1" Background="#FCFCFC" BorderBrush="#E0DFDE" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
          <Image Height="120" Width="140" VerticalAlignment="Center" Source="/Apps.XmlUI;component/Resources/图像运行_图片.png" />
          <TextBlock Text="{DynamicResource 请添加模型}" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Border}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding HasModel}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Border>
    </Grid>
  </Grid>
</UserControl>