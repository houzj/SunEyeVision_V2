<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IMVSImgStitchCalibModuControl" xmlns:tabcontrol="clr-namespace:Apps.XmlUI.ParamTabControl;assembly=Apps.XmlUI" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI">
  <DataTemplate x:Key="Pannel_ImgStitch">
    <local:ImgStitchPannel ParentNode="{Binding}" />
  </DataTemplate>
  <DataTemplate x:Key="ImageSourceList">
    <local:ImageSourceListView Background="#00FFFFFF" DataContext="{Binding ImageSourceContainerA.BridgeObjA}" />
  </DataTemplate>
  <DataTemplate x:Key="NumberMultiply">
    <paramtab:LeftRightControl FrameworkElement.Height="Auto">
      <paramtab:LeftRightControl.RightContent>
        <Border BorderBrush="#FFFF0000" Padding="0,1" BorderThickness="{Binding TBorderThicknessA}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>
            <tabcontrol:NumericControl Grid.Column="0" TBackground="#FCFCFC" TBorderBrush="#CCCCCC" Text="{Binding LeftValueA, Mode=TwoWay}" Increment="{Binding IncValueA}" Minimum="{Binding MinValueA}" Maximum="{Binding MaxValueA}" />
            <TextBlock Grid.Column="1" Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <tabcontrol:NumericControl Grid.Column="2" TBackground="#FCFCFC" TBorderBrush="#CCCCCC" Text="{Binding RightValueA, Mode=TwoWay}" Increment="{Binding IncValueA}" Minimum="{Binding MinValueA}" Maximum="{Binding MaxValueA}" />
          </Grid>
        </Border>
      </paramtab:LeftRightControl.RightContent>
    </paramtab:LeftRightControl>
  </DataTemplate>
</ResourceDictionary>