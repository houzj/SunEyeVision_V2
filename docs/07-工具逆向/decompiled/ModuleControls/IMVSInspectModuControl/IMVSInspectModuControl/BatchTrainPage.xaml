<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSInspectModuControl.BatchTrainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:imagecontrol="clr-namespace:VMBaseControls;assembly=VMBaseControls" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:moduleLayout="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" xmlns:controls1="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:ocrDefect="clr-namespace:IMVSInspectModuControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localControl="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Name="BatchTrain" Height="Auto" Width="Auto">
  <Grid Background="#f2f3f5" UseLayoutRounding="True">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/ListViewStyle/ListViewStyle.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="SolidColorBrush" Color="#E0DFDE" />
        <SolidColorBrush x:Key="FocusBrush" Color="#CF9F81" />
        <Style x:Key="TopTabItemStyle" TargetType="{x:Type TabItem}">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Padding" Value="10,1" />
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Foreground" Value="#FF666666" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabItem}">
                <Grid>
                  <Border Name="bd" HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Background="#00FFFFFF" Width="{Binding ParamWidth}">
                    <ContentPresenter Name="Content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" Margin="{TemplateBinding Control.Padding}" />
                  </Border>
                  <Rectangle Name="line" Height="2" Fill="{DynamicResource Col_Theme}" Visibility="Hidden" VerticalAlignment="Bottom" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="TabItem.IsSelected" Value="True">
                    <Setter TargetName="bd" Value="{DynamicResource Col_Theme_Light}" Property="Border.Background" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#FF4D4D4D" />
                    <Setter TargetName="line" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter TargetName="line" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="MoreToggleButtonStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="32" />
          <Setter Property="Width" Value="32" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid>
                  <Image Name="icon" Stretch="None" Source="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_normal.png" />
                  <Popup Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False" IsOpen="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="#303033" MinWidth="140" MinHeight="60" CornerRadius="4" BorderThickness="1" BorderBrush="#66666666">
                      <ItemsControl Margin="5" ItemsSource="{Binding MoreOptions, ElementName=BatchTrain}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="ItemsPanel">
                              <Setter.Value>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                              </Setter.Value>
                            </Setter>
                            <Setter Property="ItemTemplate">
                              <Setter.Value>
                                <DataTemplate>
                                  <Grid>
                                    <FrameworkElement.Resources>
                                      <ResourceDictionary>
                                        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
                                          <Setter Property="Foreground" Value="#E6E6E6" />
                                          <Setter Property="FontSize" Value="14px" />
                                          <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                          <Setter Property="HorizontalAlignment" Value="Center" />
                                          <Setter Property="VerticalAlignment" Value="Center" />
                                          <Setter Property="Template">
                                            <Setter.Value>
                                              <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid>
                                                  <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition Height="1" />
                                                  </Grid.RowDefinitions>
                                                  <Border Name="Border" Background="#00FFFFFF" Padding="24,0">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                  </Border>
                                                  <Border Name="bd" Grid.Row="1" Background="{DynamicResource Col_Theme}" Visibility="Hidden" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Border.Background" Value="#4C4E53" />
                                                    <Setter TargetName="bd" Property="Visibility" Value="Visible" />
                                                  </Trigger>
                                                </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                            </Setter.Value>
                                          </Setter>
                                        </Style>
                                      </ResourceDictionary>
                                    </FrameworkElement.Resources>
                                    <Button HorizontalAlignment="Stretch" Height="30" Content="{Binding}">
                                      <interactivity:Interaction.Triggers xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
                                        <interactivity:EventTrigger xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" EventName="Click">
                                          <commomcontrol:ParamsEventCommand Command="{Binding ClickCommand, ElementName=BatchTrain}" CommandParameter="{Binding}" />
                                          <core:ChangePropertyAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" PropertyName="IsOpen" Value="false" interactivity:TargetedTriggerAction.TargetObject="{Binding ElementName=Popup}" />
                                        </interactivity:EventTrigger>
                                      </interactivity:Interaction.Triggers>
                                    </Button>
                                  </Grid>
                                </DataTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </FrameworkElement.Style>
                      </ItemsControl>
                    </Border>
                  </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_click.png" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_click.png" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tabbar_ic_addimage_disable.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="setCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Width" Value="12" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                  <Image Name="ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="CategoryHeader" TargetType="{x:Type TextBlock}">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontFamily" Value="Microsoft YaHei" />
          <Setter Property="Foreground" Value="#4C4C4C" />
          <Setter Property="FontSize" Value="14px" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="BottomLineButtonStyle" TargetType="{x:Type Button}">
          <Setter Property="Foreground" Value="#666666" />
          <Setter Property="FontFamily" Value="Microsoft YaHei" />
          <Setter Property="Background" Value="#F2F2F2" />
          <Setter Property="BorderBrush" Value="#CCCCCC" />
          <Setter Property="FontSize" Value="12px" />
          <Setter Property="Width" Value="198" />
          <Setter Property="Height" Value="28" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <controls:FouerColorBorder Name="Border" CornerRadius="2" BottomBorderBrush="{DynamicResource Col_Theme}" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1,1,1,1">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                </controls:FouerColorBorder>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#80F2F2F2" />
                    <Setter Property="Foreground" Value="#80666666" />
                    <Setter Property="BorderBrush" Value="#80CCCCCC" />
                    <Setter TargetName="Border" Value="{DynamicResource Col_Theme_Light}" Property="controls:FouerColorBorder.BottomBorderBrush" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="TrainButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BottomLineButtonStyle}">
          <Setter Property="Content" Value="{DynamicResource 训练}" />
          <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource 训练}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsTrainFinish, ElementName=BatchTrain}">
              <Setter Property="Content" Value="{DynamicResource 重新训练}" />
              <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource 重新训练}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="Btn_StyleLeft" TargetType="{x:Type Button}">
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Image Name="ImageBackground" Width="26" Height="54" Source="/Apps.XmlUI;component/Resources/leftarrow_normal.png" />
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/leftarrow_hover.png" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/leftarrow_press.png" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/leftarrow_disabled.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="DisplayHideBtnStyle1" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Margin" Value="0,0,10,0" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="icon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/tab_expand.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="False" Binding="{Binding IsDisplayVerifyParam, ElementName=BatchTrain}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tab_collapsed.png" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_Unwarp}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding IsDisplayVerifyParam, ElementName=BatchTrain}">
              <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource 收起}" />
            </DataTrigger>
            <DataTrigger Value="Inherit" Binding="{Binding CurModelType, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ocrDefect:ModelTrainDialog}}}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="DisplayHideBtnStyle2" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Margin" Value="0,0,10,0" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="icon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/tab_expand.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsDisplayVerifyParam, ElementName=BatchTrain}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tab_collapsed.png" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_Unwarp}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsDisplayVerifyParam, ElementName=BatchTrain}">
              <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource 收起}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#FFFFFFFF" BorderThickness="1" BorderBrush="{DynamicResource SolidColorBrush}" Width="625">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition Height="*" />
          <RowDefinition Height="130" />
        </Grid.RowDefinitions>
        <Grid>
          <UniformGrid Columns="4" Width="150" HorizontalAlignment="Right">
            <controls1:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookImageViewBox="{Binding ElementName=imageView}" />
            <controls1:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookImageViewBox="{Binding ElementName=imageView}" />
            <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
            <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
          </UniformGrid>
        </Grid>
        <Grid Name="viewGrid" Row="1">
          <imagecontrol:ImageViewBox Name="imageView" ROITypeUI="False" ImageDataSource="{Binding CurImage, ElementName=BatchTrain}" ShapeList="{Binding ShapeList, ElementName=BatchTrain}" DrawROIType="{Binding SelectedROI.DrawROIType, ElementName=BatchTrain}" IsStateForDrawROI="{Binding SelectedROI.IsStateForDrawROI, ElementName=BatchTrain}" RoiAddCommand="{Binding SelectedROI.AddROICommand, ElementName=BatchTrain}" SelectedSubROIList="{Binding SelectedROI.ROIList, ElementName=BatchTrain}" ROIList="{Binding SelectedROI.ROIList, ElementName=BatchTrain}" />
          <Button Name="btnLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Width="26" Height="54" Style="{StaticResource Btn_StyleLeft}" Click="front_Click">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/leftarrow_normal.png" />
          </Button>
          <Button Name="btnRight" HorizontalAlignment="Right" VerticalAlignment="Center" Height="54" Width="26" Style="{StaticResource Btn_StyleLeft}" RenderTransformOrigin="0.5,0.5" Click="next_Click">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/leftarrow_normal.png" />
            <UIElement.RenderTransform>
              <ScaleTransform ScaleX="-1" />
            </UIElement.RenderTransform>
          </Button>
        </Grid>
        <Grid Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22*" />
            <ColumnDefinition Width="69*" />
            <ColumnDefinition Width="420*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0" ColumnSpan="3">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="8,0">
              <ComboBox Name="m_ImageType" Style="{StaticResource ListViewComboBoxStyle}" Width="120" Height="28" SelectedIndex="0" Margin="0,0,12,0" ItemsSource="{Binding ComboOptions, ElementName=BatchTrain}" IsEnabled="{Binding IsEnable, ElementName=BatchTrain}" SelectionChanged="ImageListType_SelectionChanged" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_Current}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" Text="{Binding CurIndex, ElementName=BatchTrain}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}">/</TextBlock>
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" Text="{Binding DisplayImageCount, ElementName=BatchTrain}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="8,0">
              <CheckBox Style="{StaticResource CheckBoxStyle1}" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsExportToModel, ElementName=BatchTrain}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_ExportToModel}" Margin="0,0,10,0" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource 已标定}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" Text="{Binding MarkNum, ElementName=BatchTrain}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}">/</TextBlock>
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="{Binding TextFontSize, ElementName=BatchTrain}" Text="{Binding AllImageCount, ElementName=BatchTrain}" />
              <Rectangle Width="1" Height="15" Fill="#FFD9D9D9" Margin="10,0" />
              <ToggleButton Style="{StaticResource MoreToggleButtonStyle}" Command="{Binding FreshOptionsCommand, ElementName=BatchTrain}" />
              <commomcontrol:SuperImageButton Name="Del" ToolTip="{DynamicResource Lang_ClearTrainData}" IsEnabled="{Binding IsEnable, ElementName=BatchTrain}" Click="ClearTrainData_Click">
                <commomcontrol:SuperImageButton.NormalConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空_normal.png" Stretch="None" />
                </commomcontrol:SuperImageButton.NormalConnent>
                <commomcontrol:SuperImageButton.DisableConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空_disable.png" Stretch="None" />
                </commomcontrol:SuperImageButton.DisableConnent>
                <commomcontrol:SuperImageButton.PressedConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空_click.png" Stretch="None" />
                </commomcontrol:SuperImageButton.PressedConnent>
                <commomcontrol:SuperImageButton.MOverConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空_click.png" Stretch="None" />
                </commomcontrol:SuperImageButton.MOverConnent>
              </commomcontrol:SuperImageButton>
              <commomcontrol:SuperImageButton ToolTip="{DynamicResource 清空图像}" IsEnabled="{Binding IsEnable, ElementName=BatchTrain}" Click="DelAllImage_Click">
                <commomcontrol:SuperImageButton.NormalConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" Stretch="None" />
                </commomcontrol:SuperImageButton.NormalConnent>
                <commomcontrol:SuperImageButton.DisableConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_disable.png" Stretch="None" />
                </commomcontrol:SuperImageButton.DisableConnent>
                <commomcontrol:SuperImageButton.PressedConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Stretch="None" />
                </commomcontrol:SuperImageButton.PressedConnent>
                <commomcontrol:SuperImageButton.MOverConnent>
                  <Image Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" Stretch="None" />
                </commomcontrol:SuperImageButton.MOverConnent>
              </commomcontrol:SuperImageButton>
            </StackPanel>
          </Grid>
          <ScrollViewer Name="listScroll" Grid.Row="1" Tag="1" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Grid.ColumnSpan="3" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" ScrollChanged="listScroll_ScrollChanged">
            <ListView Name="lst" Grid.Row="1" Style="{StaticResource ImageListViewStyle}" ItemsSource="{Binding DisplayImageList, ElementName=BatchTrain}" SelectionChanged="lst_SelectionChanged">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Name="grid">
                    <ocrDefect:ImageView Width="100" Height="80" Margin="2" />
                    <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Width="30" Height="20" Background="{DynamicResource TabPanalLight}" FontSize="14" TextAlignment="Center" Margin="2,2,0,0" Text="{Binding ImageScore}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Setter Property="Foreground" Value="{DynamicResource NGColor}" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsVerify}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Value="True" Binding="{Binding IsOKVerify}">
                              <Setter Property="Foreground" Value="{DynamicResource OKColor}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                    <TextBlock Text="OK" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="30" Height="20" Background="{DynamicResource OKColor}" Foreground="#FFFFFF" FontSize="14" TextAlignment="Center" Margin="0,0,2,2">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsOKCalibrated}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                    <TextBlock Text="NG" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="30" Height="20" Background="{DynamicResource NGColor}" Foreground="#FFFFFF" FontSize="14" TextAlignment="Center" Margin="0,0,2,2">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Value="True" Binding="{Binding IsCalibrated}" />
                                <Condition Value="False" Binding="{Binding IsOKCalibrated}" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListView>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Column="1" Background="#FFFFFFFF" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource SolidColorBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="1" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="okBtn" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="68" />
                <Setter Property="Width" Value="135" />
                <Setter Property="IsEnabled" Value="{Binding IsEnable, ElementName=BatchTrain}" />
                <Setter Property="Margin" Value="12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#ECECEC" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DEDEDE" />
                <Setter Property="Foreground" Value="#00D53C" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="Border" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="4">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#1EAB25" />
                          <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter Property="Background" Value="#1EAB25" />
                          <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="ngBtn" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="68" />
                <Setter Property="Width" Value="135" />
                <Setter Property="IsEnabled" Value="{Binding IsEnable, ElementName=BatchTrain}" />
                <Setter Property="Margin" Value="20,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#ECECEC" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DEDEDE" />
                <Setter Property="Foreground" Value="#CA0831" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="Border" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="4">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#E6001D" />
                          <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter Property="Background" Value="#E6001D" />
                          <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="delbtn" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="32" />
                <Setter Property="IsEnabled" Value="{Binding ElementName=BatchTrain, Path=TrainImageEnable}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Width" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderBrush" Value="#00FFFFFF" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderThickness="0" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2">
                        <Grid>
                          <Image Name="Image" Stretch="Uniform" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" HorizontalAlignment="Left" />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Value="{DynamicResource Col_Theme}" Property="Foreground" />
                          <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter Value="{DynamicResource Col_Theme}" Property="Foreground" />
                          <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Grid.RowDefinitions>
            <RowDefinition Height="43" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="33" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource CategoryHeader}" Text="{DynamicResource Lang_ModelRegistration}" Margin="10,0" />
          <Button Grid.Row="1" Style="{StaticResource okBtn}" HorizontalAlignment="Left" Click="MarkOKImage_OnClick">
            <Grid>
              <TextBlock Text="OK" FontSize="36" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5,3" FontWeight="Bold" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="OK : " FontSize="11" />
                <TextBlock FontSize="11" Text="{Binding MarkOkNum, ElementName=BatchTrain}" />
                <TextBlock Text="/20" FontSize="11" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Grid.Row="1" Style="{StaticResource ngBtn}" HorizontalAlignment="Right" Click="MarkNGImage_OnClick">
            <Grid>
              <TextBlock Text="NG" FontSize="36" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5,3" FontWeight="Bold" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="NG : " FontSize="11" />
                <TextBlock FontSize="11" Text="{Binding MarkNgNum, ElementName=BatchTrain}" />
                <TextBlock Text="/20" FontSize="11" />
              </StackPanel>
            </Grid>
          </Button>
          <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource SolidColorBrush}" CornerRadius="2" Margin="12,5,20,8">
            <localControl:ParamListView Name="paramTrainUI" Control.Background="#00FFFFFF" ChildLeftWidth="100" ChildMargin="6,0,15,0" FrameworkElement.Margin="5">
              <!--Unknown connection ID: 15-->
            </localControl:ParamListView>
          </Border>
          <TextBlock Grid.Row="3" FontSize="14" Foreground="#666666" Text="{DynamicResource Lang_DefectContrast_BatchTrain}" ToolTip="{DynamicResource Lang_DefectContrast_BatchTrain}" Margin="12,0,12,0" />
          <Button Grid.Row="3" HorizontalAlignment="Right" Style="{StaticResource TrainButtonStyle}" Margin="0,-12,20,0" IsEnabled="{Binding IsEnable, ElementName=BatchTrain}" Click="Train_OnClick" />
        </Grid>
        <Rectangle Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="{DynamicResource SolidColorBrush}" StrokeThickness="0" Margin="10,0" />
        <Grid Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition>
              <FrameworkContentElement.Style>
                <Style TargetType="{x:Type RowDefinition}">
                  <Setter Property="Height" Value="34" />
                  <Style.Triggers>
                    <DataTrigger Value="Inherit" Binding="{Binding CurModelType, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ocrDefect:ModelTrainDialog}}}">
                      <Setter Property="Height" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkContentElement.Style>
            </RowDefinition>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CategoryHeader}" Text="{DynamicResource Lang_ModelVerification}" Margin="14,5,0,0" />
            <ToggleButton Grid.Column="1" Style="{StaticResource DisplayHideBtnStyle1}" Click="DisplayOrHide_Click" />
          </Grid>
          <Grid Row="1" Height="155">
            <Grid.RowDefinitions>
              <RowDefinition Height="65" />
              <RowDefinition Height="35" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_OKStandard}" ToolTip="{DynamicResource Lang_OKStandard}" VerticalAlignment="Center" Margin="12,-10,0,0" />
            <moduleLayout:OkNgSlider Grid.Row="0" Grid.Column="1" FrameworkElement.Margin="0,-10,20,0" Value="{Binding OKStandard, ElementName=BatchTrain, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_ModelVerification}" ToolTip="{DynamicResource Lang_ModelVerification}" Margin="12,0,12,0" Grid.ColumnSpan="2" />
            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource BottomLineButtonStyle}" Margin="0,-12,20,0" Content="{DynamicResource Lang_ModelVerification}" ToolTip="{DynamicResource Lang_ModelVerification}" IsEnabled="{Binding IsEnable, ElementName=BatchTrain}" Click="ModelVerify_OnClick" />
            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_StatisticalResult}" ToolTip="{DynamicResource Lang_StatisticalResult}" Margin="12,5,12,0" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="0,5">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_OKScoreNum}" />
                <TextBlock FontSize="14" Foreground="{DynamicResource OKColor}" Margin="2,0" Text="{Binding ScoreOkNum, ElementName=BatchTrain}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{DynamicResource Lang_NGScoreNum}" />
                <TextBlock FontSize="14" Foreground="{DynamicResource NGColor}" Margin="2,0" Text="{Binding ScoreNgNum, ElementName=BatchTrain}" />
              </StackPanel>
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsDisplayVerifyParam, ElementName=BatchTrain}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CategoryHeader}" Text="{DynamicResource Tab_Verify Params}" Margin="14,0,0,0" />
            <ToggleButton Name="btnSearchDisplayHide" Grid.Column="1" Style="{StaticResource DisplayHideBtnStyle2}" Click="DisplayOrHide_Click" />
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="Inherit" Binding="{Binding CurModelType, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ocrDefect:ModelTrainDialog}}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Row="3" Height="150">
            <localControl:ParamListView Name="paramVerifyUI" Grid.Row="1" Control.Background="#00FFFFFF" ChildLeftWidth="115" ChildMargin="6,0,15,0" FrameworkElement.Margin="5">
              <!--Unknown connection ID: 20-->
            </localControl:ParamListView>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsDisplayVerifyParam, ElementName=BatchTrain}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>