<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSInspectModuControl.LocationModelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:myControl="clr-namespace:IMVSInspectModuControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localcontrol="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:viewcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:pcUiControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:moduleLayout="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" x:Name="LocationModel" Background="#FFFFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <myControl:FloatToIntConvert x:Key="cvtFloatToInt" />
      <SolidColorBrush x:Key="SolidColorBrush" Color="#E0DFDE" />
      <Style x:Key="ComboxStyleBtn" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
                <Image Name="icon" Height="14" Width="14" Source="/Apps.XmlUI;component/Resources/combo_ic_triangle_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/combo_ic_triangle_click.png" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/combo_ic_triangle_click.png" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="Background" Value="#FCFCFC" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                        <Setter Property="Foreground" Value="#4D4D4D" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#FCFCFC" />
                          <GradientStop Offset="0.15" Color="#FCFCFC" />
                          <GradientStop Offset="1" Color="#F7F7F7" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                      </UIElement.Effect>
                      <UIElement.RenderTransform>
                        <TranslateTransform X="-4" />
                      </UIElement.RenderTransform>
                      <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{DynamicResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Grid Column="0" Margin="11,0,0,0">
                  <ContentPresenter Name="ContentPresenter" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Grid>
                <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ImageButtonStyleK" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28px" />
        <Setter Property="Height" Value="28px" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ImageButtonStyle3" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="setCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <Image Name="ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="showCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content">
                    <Setter.Value>
                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_disable.png" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
      <Style x:Key="showCrossToggleButtonStyle2" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="28px" />
        <Setter Property="Height" Value="28px" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
      <Style x:Key="ListViewStyle" TargetType="{x:Type ListView}">
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="1" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Control.Padding}" Style="{StaticResource shrinkScrollViewer}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CustomButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}">
        <Setter Property="IsEnabled" Value="True" />
        <Style.Triggers>
          <DataTrigger Value="False" Binding="{Binding IsHasCurImage, ElementName=LocationModel}">
            <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AppToolButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Background="#f2f3f4">
      <Border>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" BorderBrush="#E0DFDE" Background="#FFFFFF" BorderThickness="1,1,1,0">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
              <Button Style="{StaticResource CustomButtonStyle}" Width="95" Margin="8,5" Content="{DynamicResource Lang_SelectCurrentImage}" ToolTip="{DynamicResource Lang_SelectCurrentImage}" Click="SelectCurImage_OnClick" />
              <Button Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,5" Content="{DynamicResource Lang_SelectOtherImage}" ToolTip="{DynamicResource Lang_SelectOtherImage}" Click="SelectOtherImage_OnClick" />
            </StackPanel>
          </Border>
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="625" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#E6E6E6" BorderThickness="1" Margin="0,0,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#E6E6E6" BorderThickness="0,0,0,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
                  <Grid Row="0" Background="#fcfcfc">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                      <UniformGrid Columns="5" Width="170">
                        <RadioButton Name="Arrow" GroupName="ty" IsChecked="True" Background="#00FFFFFF" ToolTip="{DynamicResource 移动图像}" Style="{StaticResource showCrossToggleButtonStyle}">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                        <RadioButton Name="hikCoverCircle" GroupName="ty" IsEnabled="True" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 创建扇圆形掩膜}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制圆_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制圆_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                        <RadioButton Name="hikFrame" GroupName="ty" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 创建矩形掩膜}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制矩形_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制矩形_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                        <RadioButton Name="hikPolygon" GroupName="ty" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 创建多边形掩膜}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制多边形_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制多边形_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                        <RadioButton Name="hikCross" GroupName="ty" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 选择模型匹配中心}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_中心定位_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_中心定位_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                      </UniformGrid>
                      <Path Grid.Column="10" Data="M0,0 L0,1" Stretch="Fill" Height="15" Stroke="#FFD3D3D3" StrokeThickness="1" Margin="0,8,0,8" />
                      <UniformGrid Columns="5" Width="170">
                        <Button Name="Match" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle3}" ToolTip="{DynamicResource 生成模型}" Click="GenerateModel_OnClick">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_生成学习模板_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_生成学习模板_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Canvas Name="iBack" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Width="32">
                          <RadioButton Name="fun2" GroupName="ty" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 擦除轮廓点}" Canvas.Left="0" Canvas.Top="0" Width="32" Height="32" IsEnabled="{Binding EditOutlinePointsEnable}" Checked="Rubber_Checked" Unchecked="Rubber_Unchecked">
                            <Image Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_normal.png" />
                            <FrameworkElement.Tag>
                              <Image Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_click.png" />
                            </FrameworkElement.Tag>
                          </RadioButton>
                          <moduleLayout:ResultOverviewPopupButton Name="setBtn" FrameworkElement.ToolTip="{DynamicResource 调整橡皮擦大小}" ButtonStyle="{StaticResource setCrossToggleButtonStyle}" Canvas.Left="20" Canvas.Top="0" FrameworkElement.Width="12" FrameworkElement.Height="32" HorizontalOffsetVal="-45" VerticalOffsetVal="18" FrameworkElement.DataContext="{Binding ElementName=LocationModel}">
                            <moduleLayout:ResultOverviewPopupButton.SubContent>
                              <ContentControl>
                                <moduleLayout:PxSlider Value="{Binding PanRectWidth, Mode=TwoWay}">
                                  <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="OnThumbMouseLeftButtonDown">
                                      <core:CallMethodAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" MethodName="ThumbMouseLeftButtonDown" TargetObject="{Binding}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="OnThumbMouseLeftButtonUp">
                                      <CallMethodAction MethodName="ThumbMouseLeftButtonUp" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                                    </i:EventTrigger>
                                  </i:Interaction.Triggers>
                                </moduleLayout:PxSlider>
                              </ContentControl>
                            </moduleLayout:ResultOverviewPopupButton.SubContent>
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type UserControl}">
                                <Setter Property="UIElement.IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                  <DataTrigger Value="true" Binding="{Binding ElementName=fun2, Path=IsChecked}">
                                    <Setter Property="UIElement.IsHitTestVisible" Value="True" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                            <!--Unknown connection ID: 12-->
                          </moduleLayout:ResultOverviewPopupButton>
                        </Canvas>
                        <Button Name="clear" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Clear}" Click="clear_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="BackStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_Undo}" IsEnabled="{Binding BackEnable, ElementName=LocationModel}" Click="BackStep_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="ForwardStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_Redo}" IsEnabled="{Binding ForwardEnable, ElementName=LocationModel}" Click="ForwardStep_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </UniformGrid>
                    </StackPanel>
                    <UniformGrid Grid.Row="0" Columns="4" Width="150" HorizontalAlignment="Right">
                      <pcUiControl:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ElementName=imageView}" />
                      <pcUiControl:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ElementName=imageView}" />
                      <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
                      <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
                    </UniformGrid>
                  </Grid>
                </Border>
                <Grid Name="viewGrid" Row="1">
                  <localcontrol:HikImageView Name="imageView" NeedLargePoints="True" ContextMenuVisible="False" RoiList="{Binding ItemsData}" PointsData="{Binding PointsData}" />
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#E0DFDE" BorderThickness="0,1,1,1" Background="#FFFFFF" Margin="0,0,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="38" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="1" />
                  <RowDefinition Height="34" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource 列表}" FontFamily="Microsoft YaHei" FontSize="14" Background="#FFFFFF" Foreground="#4C4C4C" FontWeight="Bold" HorizontalAlignment="Left" Margin="14,14,0,0" />
                <ListView Name="listView" Grid.Row="1" SelectionMode="Single" Style="{DynamicResource ListViewStyle}" Margin="0,0,0,5" ItemsSource="{Binding ItemsData}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                      <Style.Setters>
                        <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                              <Border Name="bd" BorderThickness="0" BorderBrush="#e6e6e6" SnapsToDevicePixels="True" Height="30px">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                  </Grid.ColumnDefinitions>
                                  <Grid Column="0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="20px" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#666666" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Lang:ResourceBinding Name}" />
                                  </Grid>
                                  <Grid Column="1" HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="28px" />
                                      <ColumnDefinition Width="2px" />
                                      <ColumnDefinition Width="28px" />
                                      <ColumnDefinition Width="2px" />
                                      <ColumnDefinition Width="28px" />
                                      <ColumnDefinition Width="8px" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Name="Eye" Grid.Column="0" Style="{StaticResource showCrossToggleButtonStyle2}" Background="#00FFFFFF" IsChecked="{Binding TIsVisible, Mode=TwoWay}">
                                      <Image Source="/Apps.XmlUI;component/Resources/see_normal.png" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/not-see_normal.png" />
                                      </FrameworkElement.Tag>
                                    </ToggleButton>
                                    <ToggleButton Name="Sign" Grid.Column="2" Background="#00FFFFFF" Style="{StaticResource showCrossToggleButtonStyle2}" IsChecked="{Binding Sign, Mode=TwoWay}">
                                      <Image Source="/Apps.XmlUI;component/Resources/ic_add rectangle_normal.png" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/ic_deduct_normal.png" />
                                      </FrameworkElement.Tag>
                                    </ToggleButton>
                                    <Button Name="Delete" Grid.Column="4" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyleK}" Tag="{Binding}" Click="DeleteRoi_OnClick">
                                      <Image Margin="0" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
                                    </Button>
                                  </Grid>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                                </Trigger>
                                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                  <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style.Setters>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListView>
                <Rectangle Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="{StaticResource SolidColorBrush}" StrokeThickness="0" Margin="10,0" />
                <Grid Row="3">
                  <TextBlock Text="{DynamicResource Lang_ModelParameter}" FontFamily="Microsoft YaHei" FontSize="14" Background="#FFFFFF" Foreground="#4C4C4C" FontWeight="Bold" HorizontalAlignment="Left" Margin="14,5,0,0" />
                </Grid>
                <GroupBox Name="FeatureConfig" Grid.Row="4" Background="#FFFFFF" BorderThickness="0" Height="180">
                  <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Name="row_fine" Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                      </Grid.RowDefinitions>
                      <Label Grid.Row="0" Grid.Column="0" Foreground="#666666" VerticalContentAlignment="Center" Content="{DynamicResource PyramidScaleFlag}" ToolTip="{DynamicResource PyramidScaleFlag}" Margin="10,0,0,0" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <Label Grid.Row="1" Grid.Column="0" Foreground="#666666" VerticalContentAlignment="Center" Content="{DynamicResource Lang_Compressibility}" ToolTip="{DynamicResource Lang_Compressibility}" Margin="10,0,0,0" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <Label Grid.Row="2" Grid.Column="0" Foreground="#666666" VerticalContentAlignment="Center" Content="{DynamicResource 特征尺度}" ToolTip="{DynamicResource 特征尺度}" Margin="10,0,0,0" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <Label Grid.Row="3" Grid.Column="0" Foreground="#666666" VerticalContentAlignment="Center" Content="{DynamicResource Thresh Mode}" ToolTip="{DynamicResource Thresh Mode}" Margin="10,0,0,0" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <Label Grid.Row="4" Grid.Column="0" Foreground="#666666" VerticalContentAlignment="Center" Content="{DynamicResource Lang_ContrastThreshold}" ToolTip="{DynamicResource Lang_ContrastThreshold}" Margin="10,0,0,0" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <ComboBox Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,10,0" SelectedIndex="{Binding PyramidscaleModeSel, Mode=TwoWay}" FontSize="{Binding TextFontSize, ElementName=LocationModel}">
                        <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                        <ComboBoxItem Content="{DynamicResource Mannual}" />
                      </ComboBox>
                      <viewcontrol:SliderArrangeFloat Grid.Row="1" Grid.Column="1" Foreground="#666666" SliderTickFrequency="0.1" Minimum="1" Maximum="20" DecimalDigits="1" Margin="0,0,10,0" FontFamily="Microsoft YaHei" StartValue="{Binding RoughPyramidscale, Mode=TwoWay}" IsEnabled="{Binding PyramidscaleEnable}" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <viewcontrol:SliderArrange Grid.Row="2" Grid.Column="1" Foreground="#666666" SliderTickFrequency="1" Minimum="1" Margin="0,0,10,0" FontFamily="Microsoft YaHei" StartValue="{Binding FinePyramidscale, Mode=TwoWay}" Maximum="{Binding RoughPyramidscale, Mode=TwoWay, Converter={StaticResource cvtFloatToInt}}" IsEnabled="{Binding PyramidscaleEnable}" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                      <ComboBox Grid.Row="3" Grid.Column="1" Height="26" Margin="0,0,10,0" SelectedIndex="{Binding ThresholdModeSel, Mode=TwoWay}" FontSize="{Binding TextFontSize, ElementName=LocationModel}">
                        <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                        <ComboBoxItem Content="{DynamicResource Mannual}" />
                      </ComboBox>
                      <viewcontrol:SliderArrange Grid.Row="4" Grid.Column="1" Foreground="#666666" Minimum="1" Maximum="255" Margin="0,0,10,0" FontFamily="Microsoft YaHei" StartValue="{Binding HighThreshold, Mode=TwoWay}" IsEnabled="{Binding ThresholdEnable}" FontSize="{Binding TextFontSize, ElementName=LocationModel}" />
                    </Grid>
                  </ScrollViewer>
                </GroupBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>