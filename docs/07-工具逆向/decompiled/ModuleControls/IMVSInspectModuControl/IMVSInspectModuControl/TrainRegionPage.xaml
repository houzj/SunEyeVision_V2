<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSInspectModuControl.TrainRegionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:imageView="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:controls1="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:listView="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="TrainRegion" Height="Auto" Width="Auto" xmlns:imvsinspectmoducontrol="clr-namespace:IMVSInspectModuControl;assembly=IMVSInspectModuControl">
  <Grid Background="#f2f3f5" UseLayoutRounding="True">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="SolidColorBrush" Color="#E0DFDE" />
        <SolidColorBrush x:Key="FocusBrush" Color="#CF9F81" />
        <Style x:Key="CategoryHeader" TargetType="{x:Type TextBlock}">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontFamily" Value="Microsoft YaHei" />
          <Setter Property="Foreground" Value="#4C4C4C" />
          <Setter Property="FontSize" Value="14px" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RectRoiBtnStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="34" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Margin" Value="0,0,10,0" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="bg" Width="36" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Source="/Apps.XmlUI;component/Resources/ROI_选中但未绘制_bg.png" />
                  <Image Name="icon" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/ROI_retangle_normal.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding RectEnable, ElementName=TrainRegion}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ROI_retangle_click.png" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsDrawRect, ElementName=TrainRegion}">
                    <Setter TargetName="bg" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="FullScreenRoiBtnStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="34" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Margin" Value="0,0,10,0" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="bg" Width="36" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Source="/Apps.XmlUI;component/Resources/ROI_选中但未绘制_bg.png" />
                  <Image Name="icon" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/ROI_full-screen_normal.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="False" Binding="{Binding RectEnable, ElementName=TrainRegion}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/ROI_full-screen_click.png" />
                  </DataTrigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border Background="#FFFFFFFF" BorderThickness="1" BorderBrush="{StaticResource SolidColorBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <ToggleButton Name="fullScreenRoi" ToolTip="{DynamicResource 全屏}" Style="{StaticResource FullScreenRoiBtnStyle}" Click="FullScreen_Click" />
            <ToggleButton Name="rectRoi" ToolTip="{DynamicResource Box}" Style="{StaticResource RectRoiBtnStyle}" Click="RectROI_Click" />
          </StackPanel>
          <UniformGrid Columns="4" Width="150" HorizontalAlignment="Right">
            <controls1:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ElementName=imageView}" />
            <controls1:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ElementName=imageView}" />
            <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
            <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
          </UniformGrid>
        </Grid>
        <Grid Name="viewGrid" Row="1">
          <imageView:HikImageView Name="imageView" NeedLargePoints="True" ContextMenuVisible="False" OnRoi_Click="imageView_ROIClick" RoiList="{Binding RectRois, ElementName=TrainRegion}" MouseLeftButtonUp="imageView_MouseLeftButtonUp" />
        </Grid>
        <Grid Height="40" Row="1" VerticalAlignment="Bottom" Background="#808080" DataContext="{Binding SelectedBox, ElementName=TrainRegion}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedBox, ElementName=TrainRegion}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}">
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Margin" Value="5,0" />
                <Setter Property="Width" Value="60" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
              </Style>
              <Style x:Key="{x:Type listView:SliderArrangeFloat}" TargetType="{x:Type listView:SliderArrangeFloat}">
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="listView:SliderArrangeBase.TBtnBgNormal" Value="/Apps.XmlUI;component/Resources/inputbox_ic_triangle_top_normal.png" />
                <Setter Property="listView:SliderArrangeBase.TBtnBgHover" Value="/Apps.XmlUI;component/Resources/inputbox_ic_triangle_top_click.png" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="Foreground" Value="#808080" />
                <Setter Property="listView:SliderArrangeBase.TBackground" Value="#FCFCFC" />
                <Setter Property="listView:SliderArrangeBase.TBorderBrush" Value="#CCCCCD" />
                <Setter Property="listView:SliderArrangeBase.SliderTickFrequency" Value="1" />
                <Setter Property="listView:SliderArrangeBase.Minimum" Value="0" />
                <Setter Property="listView:SliderArrangeBase.Maximum" Value="9999" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Lang_Width}" ToolTip="{DynamicResource Lang_Width}" />
            <listView:SliderArrangeFloat StartValue="{Binding Width, Mode=TwoWay}" OnStartValueChange="StartValueChange" />
            <TextBlock Text="{DynamicResource Lang_Height}" ToolTip="{DynamicResource Lang_Height}" />
            <listView:SliderArrangeFloat StartValue="{Binding Height, Mode=TwoWay}" OnStartValueChange="StartValueChange" />
            <TextBlock Text="{DynamicResource CenterX}" ToolTip="{DynamicResource CenterX}" />
            <listView:SliderArrangeFloat StartValue="{Binding CenterX, Mode=TwoWay}" OnStartValueChange="StartValueChange" />
            <TextBlock Text="{DynamicResource CenterY}" ToolTip="{DynamicResource CenterY}" />
            <listView:SliderArrangeFloat StartValue="{Binding CenterY, Mode=TwoWay}" OnStartValueChange="StartValueChange" />
            <TextBlock Text="{DynamicResource Angle}" ToolTip="{DynamicResource Angle}" />
            <listView:SliderArrangeFloat Minimum="-360" Maximum="360" StartValue="{Binding Angle, Mode=TwoWay}" OnStartValueChange="StartValueChange" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>