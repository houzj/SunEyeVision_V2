<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSMarkFindModuControl.MarkFindDialogUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:IMVSMarkFindModuControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:pcUiControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:moduleLayout="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" xmlns:localcontrol="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:pcuicontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" x:Name="userControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:FloatToIntConvert x:Key="cvtFloatToInt" />
      <Style x:Key="ComboxStyleBtn" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
                <Image Name="icon" Height="14" Width="14" Source="/Apps.XmlUI;component/Resources/combo_ic_triangle_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/combo_ic_triangle_click.png" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/combo_ic_triangle_click.png" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="Background" Value="#FCFCFC" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                        <Setter Property="Foreground" Value="#4D4D4D" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#FCFCFC" />
                          <GradientStop Offset="0.15" Color="#FCFCFC" />
                          <GradientStop Offset="1" Color="#F7F7F7" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                      </UIElement.Effect>
                      <UIElement.RenderTransform>
                        <TranslateTransform X="-4" />
                      </UIElement.RenderTransform>
                      <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{DynamicResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Grid Column="0" Margin="11,0,0,0">
                  <ContentPresenter Name="ContentPresenter" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Grid>
                <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ImageButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ImageButtonStyleK" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28px" />
        <Setter Property="Height" Value="28px" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ImageButtonStyle3" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="EditButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content">
                    <Setter.Value>
                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/edit_click.png" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="showCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content">
                    <Setter.Value>
                      <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_disable.png" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
      <Style x:Key="showCrossToggleButtonStyle2" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="28px" />
        <Setter Property="Height" Value="28px" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
      <Style x:Key="TextButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" CornerRadius="2" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="#CCCCCC" BorderThickness="1">
                <ContentPresenter Margin="10,0,10,0" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListViewStyle1" TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="#fcfcfc" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="1" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Control.Padding}" Style="{StaticResource shrinkScrollViewer}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="setCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <Image Name="ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AppToolButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <Grid Row="0" Background="#f2f3f4">
      <Border Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Padding="2">
            <Grid>
              <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                <ComboBox Name="cbxMarketType" Width="95" Margin="0,7,8,6" Height="auto" SelectedIndex="{Binding MaskType, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" SelectionChanged="CmbMarkType_SelectionChanged">
                  <ComboBoxItem Content="{DynamicResource Lang_CrossMark}" />
                  <ComboBoxItem Content="{DynamicResource Lang_RectangeleMark}" />
                </ComboBox>
                <Button Name="BtnCurImage" Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,7,8,6" Content="{DynamicResource Lang_SelectCurrentImage}" Click="Button_Click_1" />
                <Button Style="{StaticResource Orange_ButtonStyle}" Width="95" Margin="0,7,5,6" Content="{DynamicResource Lang_SelectOtherImage}" Click="Button_Click" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="17*" />
              <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#E6E6E6" BorderThickness="1" Margin="0,5,5,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#E6E6E6" BorderThickness="0,0,0,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
                  <Grid Row="0" Background="#fcfcfc">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Name="Arrow" GroupName="ty" IsChecked="True" Background="#00FFFFFF" ToolTip="{DynamicResource 移动图像}" Style="{StaticResource showCrossToggleButtonStyle}">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_click.png" />
                          </FrameworkElement.Tag>
                        </RadioButton>
                        <Path Grid.Column="10" Data="M0,0 L0,1" Stretch="Fill" Height="15" Stroke="#FFD3D3D3" StrokeThickness="1" Margin="5,8,5,8" />
                        <Button Name="Match" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyle3}" ToolTip="{DynamicResource Lang_buildModel}" Click="Match_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_生成学习模板_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_生成学习模板_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Canvas Name="iBack" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Width="32">
                          <RadioButton Name="fun2" GroupName="ty" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 擦除轮廓点}" Canvas.Left="0" Canvas.Top="0" Width="32" Height="32" IsEnabled="{Binding EditOutlinePointsEnable}" Checked="fun2_Checked" Unchecked="fun2_Unchecked">
                            <Image Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_normal.png" />
                            <FrameworkElement.Tag>
                              <Image Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_click.png" />
                            </FrameworkElement.Tag>
                          </RadioButton>
                          <pcUiControl:ResultOverviewPopupButton Name="setBtn" ToolTip="{DynamicResource 调整橡皮擦大小}" ButtonStyle="{StaticResource setCrossToggleButtonStyle}" Canvas.Left="20" Canvas.Top="0" Width="12" Height="32" HorizontalOffsetVal="-45" VerticalOffsetVal="18" DataContext="{Binding ElementName=userControl}">
                            <pcUiControl:ResultOverviewPopupButton.SubContent>
                              <ContentControl>
                                <moduleLayout:PxSlider Value="{Binding PanRectWidth, Mode=TwoWay}">
                                  <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="OnThumbMouseLeftButtonDown">
                                      <core:CallMethodAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" MethodName="ThumbMouseLeftButtonDown" TargetObject="{Binding}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="OnThumbMouseLeftButtonUp">
                                      <CallMethodAction MethodName="ThumbMouseLeftButtonUp" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                                    </i:EventTrigger>
                                  </i:Interaction.Triggers>
                                </moduleLayout:PxSlider>
                              </ContentControl>
                            </pcUiControl:ResultOverviewPopupButton.SubContent>
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type UserControl}">
                                <Setter Property="UIElement.IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                  <DataTrigger Value="true" Binding="{Binding ElementName=fun2, Path=IsChecked}">
                                    <Setter Property="UIElement.IsHitTestVisible" Value="True" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </pcUiControl:ResultOverviewPopupButton>
                        </Canvas>
                        <Button Name="BackStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource 撤销}" IsEnabled="{Binding BackEnable}" Click="BackStep_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Button Name="ForwardStep" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource 重做}" IsEnabled="{Binding ForwardEnable}" Click="ForwardStep_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                        <Path Grid.Column="10" Data="M0,0 L0,1" Stretch="Fill" Height="15" Stroke="#FFD3D3D3" StrokeThickness="1" Margin="5,8,5,8" />
                        <Button Name="clear" Background="#00FFFFFF" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_ClearMask}" Click="clear_Click">
                          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" />
                          <FrameworkElement.Tag>
                            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                          </FrameworkElement.Tag>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                    <UniformGrid Grid.Row="0" Columns="4" Width="150" HorizontalAlignment="Right">
                      <pcUiControl:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ElementName=imageView}" />
                      <pcUiControl:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ElementName=imageView}" />
                      <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="%1:1%" Click="zoomOrgBtn_Click" />
                      <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
                    </UniformGrid>
                  </Grid>
                </Border>
                <Grid Name="viewGrid" Row="1">
                  <localcontrol:HikImageView Name="imageView" NeedLargePoints="True" Margin="1" RoiList="{Binding ItemsData}" PointsData="{Binding PointsData}" />
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#e6e6e6" BorderThickness="0" Margin="0,5,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <ListView Name="listView" Grid.Row="0" BorderBrush="#e6e6e6" SelectionMode="Single" Style="{StaticResource ListViewStyle1}" ItemsSource="{Binding ItemsData}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                      <Style.Setters>
                        <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                              <Border Name="bd" BorderThickness="1" BorderBrush="#e6e6e6" SnapsToDevicePixels="True" Background="#FFFFFFFF" Height="30px">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                  </Grid.ColumnDefinitions>
                                  <Grid Column="0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="20px" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Lang:ResourceBinding Name}" />
                                  </Grid>
                                  <Grid Column="1" HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="28px" />
                                      <ColumnDefinition Width="12px" />
                                      <ColumnDefinition Width="28px" />
                                      <ColumnDefinition Width="12px" />
                                      <ColumnDefinition Width="28px" />
                                      <ColumnDefinition Width="18px" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Name="Eye" Grid.Column="0" Style="{StaticResource showCrossToggleButtonStyle2}" Background="#00FFFFFF" IsChecked="{Binding TIsVisible, Mode=TwoWay}">
                                      <Image Source="/Apps.XmlUI;component/Resources/window_visible_normal.png" Height="24" Width="24" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/window_invisible_normal.png" Height="24" Width="24" />
                                      </FrameworkElement.Tag>
                                    </ToggleButton>
                                    <ToggleButton Name="Sign" Grid.Column="2" Style="{StaticResource showCrossToggleButtonStyle2}" Background="#00FFFFFF" IsChecked="{Binding Sign, Mode=TwoWay}" Visibility="{Binding TIsSignVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource bool2VisibilityConverter}}">
                                      <Image Source="/Apps.XmlUI;component/Resources/list_ic_add_gray.png" Height="24" Width="24" />
                                      <FrameworkElement.Tag>
                                        <Image Source="/Apps.XmlUI;component/Resources/list_ic_reduce_gray.png" Height="24" Width="24" />
                                      </FrameworkElement.Tag>
                                    </ToggleButton>
                                    <Button Name="Delete" Grid.Column="4" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyleK}" Tag="{Binding}" Visibility="{Binding TIsDeleteVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource bool2VisibilityConverter}}" Click="Delete_Click">
                                      <Image Margin="0" Source="/Apps.XmlUI;component/Resources/list_ic_delete_gray.png" Height="24" Width="24" />
                                    </Button>
                                  </Grid>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                                </Trigger>
                                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                  <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style.Setters>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListView>
                <GroupBox Name="MarkConfig" Grid.Row="1" Background="#fcfcfc" BorderBrush="#e6e6e6" Header="{DynamicResource Tab_Match Params}">
                  <ScrollViewer Name="scrollViewerMarkConfig" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="210" Style="{StaticResource shrinkScrollViewer}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14*" />
                        <ColumnDefinition Width="10*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Name="row" Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                      </Grid.RowDefinitions>
                      <Label Grid.Row="0" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource 定位方式}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" />
                      <Label Grid.Row="1" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource PyramidScaleFlag}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" />
                      <Label Grid.Row="2" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource Lang_Compressibility}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" />
                      <Label Name="lbFine" Grid.Row="3" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource 特征尺度}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" />
                      <Label Grid.Row="4" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource Thresh Mode}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" />
                      <Label Grid.Row="5" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource Lang_ContrastThreshold}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" />
                      <Label Grid.Row="7" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource RotateAngle}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <Label Grid.Row="8" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource 旋转步长}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <Label Grid.Row="9" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource 投影区间}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <Label Grid.Row="10" Grid.Column="0" FontWeight="Bold" VerticalContentAlignment="Center" FontSize="12" Content="{DynamicResource Mark类型}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <ComboBox Grid.Row="0" Grid.Column="1" Height="25" SelectedIndex="{Binding FeatureMatchType, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource IMVSFastFeatureMatchModu}" />
                        <ComboBoxItem Content="{DynamicResource IMVSHPFeatureMatchModu}" />
                      </ComboBox>
                      <ComboBox Grid.Row="1" Grid.Column="1" Height="25" SelectedIndex="{Binding PyramidscaleModeSel, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                        <ComboBoxItem Content="{DynamicResource Mannual}" />
                      </ComboBox>
                      <pcuicontrol:SliderArrangeFloat Grid.Row="2" Grid.Column="1" SliderTickFrequency="0.1" Minimum="1" Maximum="20" DecimalDigits="1" StartValue="{Binding RoughPyramidscale, Mode=TwoWay}" IsEnabled="{Binding PyramidscaleEnable}" />
                      <pcuicontrol:SliderArrange Name="saFine" Grid.Row="3" Grid.Column="1" SliderTickFrequency="1" Minimum="1" StartValue="{Binding FinePyramidscale, Mode=TwoWay}" Maximum="{Binding RoughPyramidscale, Mode=TwoWay, Converter={StaticResource cvtFloatToInt}}" IsEnabled="{Binding PyramidscaleEnable}" />
                      <ComboBox Grid.Row="4" Grid.Column="1" Height="25" SelectedIndex="{Binding ThresholdModeSel, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                        <ComboBoxItem Content="{DynamicResource Mannual}" />
                      </ComboBox>
                      <pcuicontrol:SliderArrange Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="255" StartValue="{Binding HighThreshold, Mode=TwoWay}" IsEnabled="{Binding ThresholdEnable}" />
                      <ToggleButton Grid.Row="6" Grid.Column="1" Height="30" HorizontalAlignment="Right" VerticalContentAlignment="Center" Content="{DynamicResource 高级参数}" Style="{StaticResource ExpandButtonStyle}" IsChecked="{Binding IsExpand, Mode=TwoWay}" />
                      <pcuicontrol:SliderArrange Grid.Row="7" Grid.Column="1" Minimum="5" Maximum="45" StartValue="{Binding RotationAngle, Mode=TwoWay}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <pcuicontrol:SliderArrangeFloat Grid.Row="8" Grid.Column="1" SliderTickFrequency="0.1" DecimalDigits="1" Minimum="0.1" Maximum="1" StartValue="{Binding RotationStep, Mode=TwoWay}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <pcuicontrol:SliderArrange Grid.Row="9" Grid.Column="1" Minimum="1" Maximum="10" StartValue="{Binding ProjectionInterval, Mode=TwoWay}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" />
                      <ComboBox Name="cbMarkTypeSelecter" Grid.Row="10" Grid.Column="1" Height="25" SelectedIndex="{Binding MarkType, Mode=TwoWay}" Visibility="{Binding IsExpand, Converter={StaticResource bool2VisibilityConverter}}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                        <ComboBoxItem Content="{DynamicResource 自动判断}" Visibility="Collapsed" />
                        <ComboBoxItem Name="cbHollowCross" Content="{DynamicResource 空心十字}" />
                        <ComboBoxItem Name="cbSolidCross" Content="{DynamicResource 实心十字}" />
                        <ComboBoxItem Name="cbRect" Content="{DynamicResource Box}" />
                      </ComboBox>
                    </Grid>
                  </ScrollViewer>
                </GroupBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" BorderBrush="#C2C2C2" BorderThickness="0,1,0,0">
      <Grid Background="#E6E6E6">
        <StatusBar Name="statusBarMain" Grid.Row="1" Height="25" Background="#00FFFFFF" Foreground="#808080" FontSize="13">
          <StatusBarItem Content=" ( x , y ) : " />
          <StatusBarItem Name="xyVal" Content="(000)" HorizontalContentAlignment="Center" />
          <StatusBarItem Content="{DynamicResource 灰度值}" />
          <StatusBarItem Name="grayVal" Content="000" HorizontalContentAlignment="Center" HorizontalAlignment="Left" />
        </StatusBar>
        <Grid HorizontalAlignment="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Content="{DynamicResource Confirm}" Click="Button_Click_OK" />
        </Grid>
      </Grid>
    </Border>
    <Grid Name="windowShadow" Margin="-50,-50,-50,-50" Visibility="Collapsed" Background="#44F0F4F9" />
  </Grid>
</UserControl>