<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="IMVSMarkInspModuControl.OCRModelTrainDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:ocrDefect="clr-namespace:IMVSMarkInspModuControl" xmlns:moduleLayout="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" x:Name="modelTrain" Title="{DynamicResource Lang_OCRDefect_TrainTitle}" Height="600" Width="930">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Background="#f2f3f5" UseLayoutRounding="True">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <SolidColorBrush x:Key="SolidColorBrush" Color="#E0DFDE" />
          <SolidColorBrush x:Key="FocusBrush" Color="#CF9F81" />
          <Style x:Key="label" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14px" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
          </Style>
          <Style x:Key="{x:Type moduleLayout:GuideButton}" TargetType="{x:Type moduleLayout:GuideButton}">
            <Setter Property="FrameworkElement.Height" Value="56" />
            <Setter Property="FrameworkElement.Width" Value="200" />
            <Setter Property="FrameworkElement.Cursor" Value="Hand" />
            <Setter Property="Control.FontSize" Value="15" />
            <Setter Property="Control.Foreground" Value="{DynamicResource Col_Theme}" />
            <Setter Property="Control.FontWeight" Value="Bold" />
            <Setter Property="Control.FontFamily" Value="Microsoft YaHei" />
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type moduleLayout:GuideButton}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Column="0">
                      <Path Name="path" Height="28" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Path}">
                            <Setter Property="Fill" Value="{DynamicResource Col_Theme}" />
                            <Setter Property="StrokeThickness" Value="0" />
                            <Setter Property="Data">
                              <Setter.Value>
                                <EllipseGeometry RadiusX="13" RadiusY="13" Center="14,14" />
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </FrameworkElement.Style>
                      </Path>
                      <TextBlock Name="label" FontFamily="Microsoft YaHei" FontSize="15" Foreground="#FFFFFF" FontWeight="Bold" Text="{TemplateBinding moduleLayout:GuideButton.LabelContent}" Style="{StaticResource label}" />
                    </Grid>
                    <Grid Column="1">
                      <Image Name="Image" Source="{TemplateBinding moduleLayout:GuideButton.BackImage}" />
                      <ContentPresenter Margin="10,12,0,0" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                      <TextBlock Name="help" FontFamily="{TemplateBinding Control.FontFamily}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,10" FontSize="10" Foreground="#575757" FontWeight="Normal" Text="{TemplateBinding moduleLayout:GuideButton.HelpContent}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="moduleLayout:GuideButton.IsCurrentStep" Value="False">
                      <Setter Property="Control.Foreground" Value="#947764" />
                      <Setter TargetName="help" Property="TextBlock.Foreground" Value="#7B7B7B" />
                      <Setter TargetName="label" Property="TextBlock.Foreground" Value="#947764" />
                      <Setter TargetName="path" Property="Shape.Stroke" Value="#B19B8C" />
                      <Setter TargetName="path" Property="Shape.Fill" Value="#FCFCFC" />
                      <Setter TargetName="path" Property="Shape.StrokeThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="UIElement.IsEnabled" Value="False">
                      <Setter Property="Control.Foreground" Value="#A6A6A6" />
                      <Setter TargetName="help" Property="TextBlock.Foreground" Value="#B0B0B0" />
                      <Setter TargetName="label" Property="TextBlock.Foreground" Value="#999999" />
                      <Setter TargetName="path" Property="Shape.Stroke" Value="#C9C9C9" />
                      <Setter TargetName="path" Property="Shape.Fill" Value="#FCFCFC" />
                      <Setter TargetName="path" Property="Shape.StrokeThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Value="{DynamicResource Col_Theme}" Property="Control.Foreground" />
                      <Setter TargetName="help" Property="TextBlock.Foreground" Value="#575757" />
                      <Setter TargetName="label" Property="TextBlock.Foreground" Value="#947764" />
                      <Setter TargetName="path" Value="{DynamicResource Col_Theme}" Property="Shape.Stroke" />
                      <Setter TargetName="path" Property="Shape.Fill" Value="#FCFCFC" />
                      <Setter TargetName="path" Property="Shape.StrokeThickness" Value="2" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition />
        <RowDefinition Height="35" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="166" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="166" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <moduleLayout:GuideButton Name="gbLocationModel" Grid.Column="0" IsCurrentStep="True" FrameworkElement.Height="56" LabelContent="1" HelpContent="{DynamicResource Lang_OCRDefect_Positioning_Help}" FrameworkElement.ToolTip="{DynamicResource Lang_OCRDefect_Positioning_Help}" ModelTrainStep="LocationModel" FrameworkElement.Margin="17,0,0,0" Click="GuideButton_OnClick">
          <TextBlock Width="100" Text="{DynamicResource Lang_OCRDefect_Positioning}" ToolTip="{DynamicResource Lang_OCRDefect_Positioning}" TextTrimming="WordEllipsis" />
        </moduleLayout:GuideButton>
        <Image Width="80" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Stretch="None" Source="/Apps.XmlUI;component/Resources/fold.png" />
        <moduleLayout:GuideButton Name="gbTrainRegion" Grid.Column="2" UIElement.IsEnabled="False" IsCurrentStep="False" FrameworkElement.Height="56" LabelContent="2" HelpContent="{DynamicResource Lang_OCRDefect_Region_Help}" FrameworkElement.ToolTip="{DynamicResource Lang_OCRDefect_Region_Help}" ModelTrainStep="TrainRegion" Click="GuideButton_OnClick">
          <TextBlock Width="130" Text="{DynamicResource Lang_OCRDefect_Region}" ToolTip="{DynamicResource Lang_OCRDefect_Region}" TextTrimming="CharacterEllipsis" />
        </moduleLayout:GuideButton>
        <Image Width="80" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="3" Stretch="None" Source="/Apps.XmlUI;component/Resources/fold.png" />
        <moduleLayout:GuideButton Name="gbTrainTarget" Grid.Column="4" UIElement.IsEnabled="False" IsCurrentStep="False" FrameworkElement.Height="56" LabelContent="3" HelpContent="{DynamicResource Lang_OCRDefect_Target_Help}" FrameworkElement.ToolTip="{DynamicResource Lang_OCRDefect_Target_Help}" ModelTrainStep="TrainTarget" Click="GuideButton_OnClick">
          <TextBlock Width="130" Text="{DynamicResource Lang_OCRDefect_Target}" ToolTip="{DynamicResource Lang_OCRDefect_Target}" TextTrimming="CharacterEllipsis" />
        </moduleLayout:GuideButton>
        <Image Width="80" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="5" Stretch="None" Source="/Apps.XmlUI;component/Resources/fold.png" />
        <moduleLayout:GuideButton Name="gbStatisticsTrain" Grid.Column="6" UIElement.IsEnabled="False" IsCurrentStep="False" FrameworkElement.Height="56" LabelContent="4" HelpContent="{DynamicResource Lang_OCRDefect_Statistics_Help}" FrameworkElement.ToolTip="{DynamicResource Lang_OCRDefect_Statistics_Help}" ModelTrainStep="StatisticsTrain" Click="GuideButton_OnClick">
          <TextBlock Text="{DynamicResource Lang_OCRDefect_TrainLabel}" ToolTip="{DynamicResource Lang_OCRDefect_TrainLabel}" TextTrimming="CharacterEllipsis" />
        </moduleLayout:GuideButton>
      </Grid>
      <Grid Row="1" Margin="14,10,14,15">
        <ocrDefect:OCRLocationModelPage x:Name="pageLocationModel">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type UserControl}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="LocationModel" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ocrDefect:OCRLocationModelPage>
        <ocrDefect:OCRTrainRegionPage x:Name="pageTrainRegion">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type UserControl}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="TrainRegion" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ocrDefect:OCRTrainRegionPage>
        <ocrDefect:OCRTrainTargetPage x:Name="pageTrainTarget">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type UserControl}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="TrainTarget" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ocrDefect:OCRTrainTargetPage>
        <ocrDefect:OCRStatisticsTrainPage x:Name="pageStatisticsTrain">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type UserControl}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="StatisticsTrain" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ocrDefect:OCRStatisticsTrainPage>
      </Grid>
      <Border Grid.Row="2" Background="#E6E6E6" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SolidColorBrush}">
        <Grid>
          <StatusBar Height="25" Background="#00FFFFFF" Foreground="#808080" FontSize="13" HorizontalAlignment="Left">
            <StatusBarItem Content="   x : " />
            <StatusBarItem Name="xVal" Content="--" HorizontalContentAlignment="Center" />
            <StatusBarItem Content="  y : " />
            <StatusBarItem Name="yVal" Content="--" HorizontalContentAlignment="Center" />
            <StatusBarItem Content="  " />
            <StatusBarItem Content="{DynamicResource 灰度值}" />
            <StatusBarItem Name="grayVal" Content="000" HorizontalContentAlignment="Center" HorizontalAlignment="Left" />
          </StatusBar>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="NextStep_ButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BottomButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Value="StatisticsTrain" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="LastStep_ButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BottomButtonStyle}">
                  <Setter Property="Width" Value="{Binding LastStepWidth, ElementName=modelTrain}" />
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Value="LocationModel" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="Finish_ButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BottomButtonStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="StatisticsTrain" Binding="{Binding CurTrainStep, ElementName=modelTrain}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Button Style="{StaticResource LastStep_ButtonStyle}" Margin="0,0,10,0" Content="{DynamicResource Lang_OCRDefect_LastStep}" ToolTip="{DynamicResource Lang_OCRDefect_LastStep}" Click="LastStep_OnClick" />
            <Button Name="btnNextStep" HorizontalAlignment="Right" Style="{StaticResource NextStep_ButtonStyle}" IsEnabled="False" Margin="0,0,10,0" Content="{DynamicResource Lang_OCRDefect_NextStep}" ToolTip="{DynamicResource Lang_OCRDefect_NextStep}" Click="NextStep_OnClick" />
            <Button Style="{StaticResource Finish_ButtonStyle}" Margin="0,0,10,0" Content="{DynamicResource Lang_OK}" ToolTip="{DynamicResource Lang_OK}" Click="TrainFinish_OnClick" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Name="windowShadow" Margin="-50,-50,-50,-50" Visibility="Collapsed" Background="#55F0F4F9" />
  </Grid>
</controls:BaseWindow>