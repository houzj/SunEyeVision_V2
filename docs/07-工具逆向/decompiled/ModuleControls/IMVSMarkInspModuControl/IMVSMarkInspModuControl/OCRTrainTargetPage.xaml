<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IMVSMarkInspModuControl.OCRTrainTargetPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:imageView="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:moduleLayout="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" xmlns:controls1="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:paramTagUi="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:ocrDefect="clr-namespace:IMVSMarkInspModuControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:listView="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" x:Name="TrainTarget" Height="Auto" Width="Auto">
  <Grid Background="#f2f3f5" UseLayoutRounding="True">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="SolidColorBrush" Color="#E0DFDE" />
        <SolidColorBrush x:Key="FocusBrush" Color="#CF9F81" />
        <ocrDefect:TrainCountConvert x:Key="TrainCountConvert" />
        <Style x:Key="showCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Name="iBorder" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" Margin="-4">
                  <ContentPresenter Name="con" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ButtonBase.ClickMode" Value="Press" />
        </Style>
        <Style x:Key="DisplayHideBtnStyle1" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Margin" Value="0,0,10,0" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="icon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/tab_expand.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="False" Binding="{Binding IsDisplayLocationParam, ElementName=TrainTarget}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tab_collapsed.png" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_Unwarp}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding IsDisplayLocationParam, ElementName=TrainTarget}">
              <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource 收起}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="DisplayHideBtnStyle2" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="30" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Margin" Value="0,0,10,0" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="icon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/tab_expand.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsDisplayLocationParam, ElementName=TrainTarget}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/tab_collapsed.png" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_Unwarp}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsDisplayLocationParam, ElementName=TrainTarget}">
              <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource 收起}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="setCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Width" Value="12" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                  <Image Name="ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="AppToolButtonStyle" TargetType="{x:Type Button}">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                  <ContentPresenter Name="con" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="CategoryHeader" TargetType="{x:Type TextBlock}">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontFamily" Value="Microsoft YaHei" />
          <Setter Property="Foreground" Value="#4C4C4C" />
          <Setter Property="FontSize" Value="14px" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="BottomLineButtonStyle" TargetType="{x:Type Button}">
          <Setter Property="Foreground" Value="#666666" />
          <Setter Property="FontFamily" Value="Microsoft YaHei" />
          <Setter Property="Background" Value="#F2F2F2" />
          <Setter Property="BorderBrush" Value="#CCCCCC" />
          <Setter Property="FontSize" Value="12px" />
          <Setter Property="Width" Value="{Binding ButtonWidth, ElementName=TrainTarget}" />
          <Setter Property="Height" Value="26" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <controls:FouerColorBorder Name="Border" CornerRadius="2" BottomBorderBrush="{DynamicResource Col_Theme}" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1,1,1,1">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                </controls:FouerColorBorder>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#80F2F2F2" />
                    <Setter Property="Foreground" Value="#80666666" />
                    <Setter Property="BorderBrush" Value="#80CCCCCC" />
                    <Setter TargetName="Border" Value="{DynamicResource Col_Theme_Light}" Property="controls:FouerColorBorder.BottomBorderBrush" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#FFFFFFFF" BorderThickness="1" BorderBrush="{StaticResource SolidColorBrush}" Width="{Binding PageLeftWidth, ElementName=TrainTarget}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <RadioButton Name="Arrow" GroupName="ty" IsChecked="True" Margin="8" ToolTip="{DynamicResource 移动图像}" Style="{StaticResource showCrossToggleButtonStyle}">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_箭头_click.png" />
                </FrameworkElement.Tag>
              </RadioButton>
              <RadioButton Name="hikFrame" GroupName="ty" Margin="8" Style="{StaticResource showCrossToggleButtonStyle}" ToolTip="{DynamicResource 创建矩形掩膜}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制矩形_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_绘制矩形_click.png" />
                </FrameworkElement.Tag>
              </RadioButton>
              <Path Data="M0,0 L0,1" Stretch="Fill" Height="15" Stroke="#FFD3D3D3" StrokeThickness="1" Margin="8" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Canvas Name="iBack" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Width="32" Margin="0">
                <RadioButton Name="mask" GroupName="ty" ToolTip="{DynamicResource 掩膜工具}" Canvas.Left="8" Canvas.Top="5" Checked="Mask_OnChecked" Unchecked="Mask_OnUnchecked">
                  <Image Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_normal.png" />
                  <FrameworkElement.Tag>
                    <Image Source="/Apps.XmlUI;component/Resources/ic_橡皮擦2_click.png" />
                  </FrameworkElement.Tag>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                      <Setter Property="Width" Value="20" />
                      <Setter Property="Height" Value="20" />
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                              <ContentPresenter Name="con" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                                <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                              </Trigger>
                              <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="ButtonBase.ClickMode" Value="Press" />
                    </Style>
                  </FrameworkElement.Style>
                </RadioButton>
                <moduleLayout:ResultOverviewPopupButton Name="setBtn" FrameworkElement.ToolTip="{DynamicResource 调整橡皮擦大小}" ButtonStyle="{StaticResource setCrossToggleButtonStyle}" Canvas.Left="20" Canvas.Top="0" FrameworkElement.Width="12" FrameworkElement.Height="32" HorizontalOffsetVal="-45" VerticalOffsetVal="18" FrameworkElement.DataContext="{Binding ElementName=TrainTarget}">
                  <moduleLayout:ResultOverviewPopupButton.SubContent>
                    <ContentControl>
                      <moduleLayout:PxSlider Value="{Binding PanRectWidth, Mode=TwoWay}">
                        <interactivity:Interaction.Triggers xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity">
                          <interactivity:EventTrigger xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" EventName="OnThumbMouseLeftButtonDown">
                            <core:CallMethodAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" MethodName="ThumbMouseLeftButtonDown" TargetObject="{Binding}" />
                          </interactivity:EventTrigger>
                          <interactivity:EventTrigger EventName="OnThumbMouseLeftButtonUp">
                            <CallMethodAction MethodName="ThumbMouseLeftButtonUp" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                          </interactivity:EventTrigger>
                        </interactivity:Interaction.Triggers>
                      </moduleLayout:PxSlider>
                    </ContentControl>
                  </moduleLayout:ResultOverviewPopupButton.SubContent>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type UserControl}">
                      <Setter Property="UIElement.IsHitTestVisible" Value="False" />
                      <Style.Triggers>
                        <DataTrigger Value="true" Binding="{Binding ElementName=mask, Path=IsChecked}">
                          <Setter Property="UIElement.IsHitTestVisible" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <!--Unknown connection ID: 6-->
                </moduleLayout:ResultOverviewPopupButton>
              </Canvas>
              <Button Name="clear" ToolTip="{DynamicResource Clear}" Click="Clear_OnClick">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_清空图片_click.png" />
                </FrameworkElement.Tag>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Background" Value="#00FFFFFF" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                            <ContentPresenter Name="con" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                              <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                              <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </FrameworkElement.Style>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button Name="BackStep" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_Undo}" IsEnabled="{Binding EnableUndo}" Click="BackStep_OnClick">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_上一步_click.png" />
                </FrameworkElement.Tag>
              </Button>
              <Button Name="ForwardStep" Style="{StaticResource AppToolButtonStyle}" ToolTip="{DynamicResource Lang_Redo}" IsEnabled="{Binding EnableRedo}" Click="ForwardStep_OnClick">
                <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/ic_下一步_click.png" />
                </FrameworkElement.Tag>
              </Button>
            </StackPanel>
          </StackPanel>
          <UniformGrid Columns="4" Width="150" HorizontalAlignment="Right">
            <controls1:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ElementName=imageView}" />
            <controls1:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ElementName=imageView}" />
            <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
            <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
          </UniformGrid>
        </Grid>
        <Grid Name="viewGrid" Row="1">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <controls:HikContextMenu x:Key="HikContextMenu">
                <controls:HikMenuItem Header="{DynamicResource Lang_Delet}" Click="DeleteBox_OnClick" />
              </controls:HikContextMenu>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <imageView:HikImageView Name="imageView" NeedLargePoints="True" ContextMenuVisible="False" OnRoi_Click="imageView_ROIClick" OnRoiParamChange="imageView_OnRoiParamChange" RoiList="{Binding BoxCovers, ElementName=TrainTarget}" MouseLeftButtonUp="imageView_MouseLeftButtonUp">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type imageView:HikImageView}">
                <Setter Property="FrameworkElement.ContextMenu" Value="{DynamicResource HikContextMenu}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedBox, ElementName=TrainTarget}" Value="{x:Null}">
                    <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding IsDisplayBinaryImage, ElementName=TrainTarget}">
                    <Setter Property="imageView:HikImageView.ImageDataSource" Value="{Binding CurImage, ElementName=TrainTarget}" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsDisplayBinaryImage, ElementName=TrainTarget}">
                    <Setter Property="imageView:HikImageView.ImageDataSource" Value="{Binding BinaryImage, ElementName=TrainTarget}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </imageView:HikImageView>
        </Grid>
        <Grid Height="76" Row="1" VerticalAlignment="Bottom" Background="#808080" DataContext="{Binding SelectedBox, ElementName=TrainTarget}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedBox, ElementName=TrainTarget}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CategoryHeader}">
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Margin" Value="5,0" />
                <Setter Property="Width" Value="60" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
              </Style>
              <Style x:Key="{x:Type listView:SliderArrangeFloat}" TargetType="{x:Type listView:SliderArrangeFloat}">
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="listView:SliderArrangeBase.TBtnBgNormal" Value="/Apps.XmlUI;component/Resources/inputbox_ic_triangle_top_normal.png" />
                <Setter Property="listView:SliderArrangeBase.TBtnBgHover" Value="/Apps.XmlUI;component/Resources/inputbox_ic_triangle_top_click.png" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="Foreground" Value="#808080" />
                <Setter Property="listView:SliderArrangeBase.TBackground" Value="#FCFCFC" />
                <Setter Property="listView:SliderArrangeBase.TBorderBrush" Value="#CCCCCD" />
                <Setter Property="listView:SliderArrangeBase.SliderTickFrequency" Value="1" />
                <Setter Property="listView:SliderArrangeBase.Minimum" Value="0" />
                <Setter Property="listView:SliderArrangeBase.Maximum" Value="9999" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Lang_Width}" ToolTip="{DynamicResource Lang_Width}" />
            <listView:SliderArrangeFloat StartValue="{Binding Width, Mode=TwoWay}" />
            <TextBlock Text="{DynamicResource Lang_Height}" ToolTip="{DynamicResource Lang_Height}" />
            <listView:SliderArrangeFloat StartValue="{Binding Height, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="{DynamicResource CenterX}" ToolTip="{DynamicResource CenterX}" />
            <listView:SliderArrangeFloat StartValue="{Binding CenterX, Mode=TwoWay}" />
            <TextBlock Text="{DynamicResource CenterY}" ToolTip="{DynamicResource CenterY}" />
            <listView:SliderArrangeFloat StartValue="{Binding CenterY, Mode=TwoWay}" />
            <TextBlock Text="{DynamicResource Angle}" ToolTip="{DynamicResource Angle}" />
            <listView:SliderArrangeFloat Minimum="-360" Maximum="360" StartValue="{Binding Angle, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Column="1" Background="#FFFFFFFF" BorderThickness="0,1,1,1" BorderBrush="{StaticResource SolidColorBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="1" />
          <RowDefinition Height="34" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="34" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0,0,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="43" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource CategoryHeader}" Text="{DynamicResource Tab_Char Sgt}" Margin="10,0" />
          <Button Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource BottomLineButtonStyle}" Margin="0,0,26,0" Content="{DynamicResource Lang_DrawCharacter}" ToolTip="{DynamicResource Lang_DrawCharacter}" Click="GetBox_OnClick" />
          <paramTagUi:ParamListView Name="paramDivideUI" Grid.Row="1" Control.Background="#00FFFFFF" ChildMargin="5,0,15,0" FrameworkElement.Margin="5,0,0,0" ChildLeftWidth="{Binding ParamLeftWidth, ElementName=TrainTarget}">
            <!--Unknown connection ID: 16-->
          </paramTagUi:ParamListView>
        </Grid>
        <Rectangle Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="{StaticResource SolidColorBrush}" StrokeThickness="0" Margin="10,0" />
        <Grid Row="2" Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="36" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource CategoryHeader}" Text="{DynamicResource Tab_Train Params}" Margin="10,0" />
          <Button Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource BottomLineButtonStyle}" Margin="0,0,-7,0" Content="{DynamicResource Lang_OCRDefect_FeatureMatchModel}" ToolTip="{DynamicResource Lang_OCRDefect_FeatureMatchModel}" IsEnabled="{Binding BoxCovers.Count, ElementName=TrainTarget, Converter={StaticResource TrainCountConvert}}" Click="FeatureModel_OnClick" />
