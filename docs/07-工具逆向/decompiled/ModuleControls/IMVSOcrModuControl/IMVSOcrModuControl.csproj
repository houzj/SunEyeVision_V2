    <Reference Include="VM.Xml" />
    <Reference Include="Apps.XmlParser" />
    <Reference Include="VM.ExternalCall" />
    <Reference Include="Apps.Localization" />
    <Reference Include="VM.PlatformSDKCS" />
    <Reference Include="VMControls.BaseInterface" />
    <Reference Include="Apps.PcUI" />
    <Reference Include="VMControls.Interface" />
    <Reference Include="System.Core" />
    <Reference Include="Apps.Log" />
