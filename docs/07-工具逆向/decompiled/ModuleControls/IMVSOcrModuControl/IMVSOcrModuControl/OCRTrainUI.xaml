                        <Popup Name="Popup" Placement="Top" AllowsTransparency="True">
                          <Grid Width="48">
                            <Border Margin="0,0,0,2" Width="38" Height="54" BorderBrush="#FF000000" BorderThickness="1">
                              <Image Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Character_ImageSource}" />
                            </Border>
                          </Grid>
                        </Popup>
                      </StackPanel>
                      <Button Name="count" Style="{StaticResource indexButtonStyle}" Click="count_Click" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger SourceName="image" Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Popup" Property="Popup.IsOpen" Value="True" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                      </Trigger>
                      <Trigger SourceName="lable" Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="lbd" Property="UIElement.Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger SourceName="TB" Property="UIElement.IsFocused" Value="True">
                        <Setter TargetName="lbd" Property="UIElement.Visibility" Value="Visible" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                  <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
                    <Setter Property="Template" Value="{StaticResource ListViewItemTemplate}" />
                    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                    <EventSetter Event="MouseDoubleClick" Handler="count_Click" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <ListView.View>
                <GridView>
                  <GridView.Columns>
                    <GridViewColumn>
                      <GridViewColumnHeader />
                    </GridViewColumn>
                  </GridView.Columns>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Grid Background="#E4E5E7" VerticalAlignment="Bottom" Height="35" ColumnSpan="2">
      <StatusBar Name="statusBarMain2" Grid.Row="1" Height="25" Background="#00FFFFFF" Foreground="#808080" FontSize="13">
        <StatusBarItem Content=" ( x , y ) : " />
        <StatusBarItem Name="xyVal" Content="(000)" HorizontalContentAlignment="Center" />
        <StatusBarItem Content="{DynamicResource 灰度值}" />
        <StatusBarItem Name="grayVal" Content="000" HorizontalContentAlignment="Center" HorizontalAlignment="Left" />
      </StatusBar>
      <Grid HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="{DynamicResource Confirm}" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Click="OK_Click" />
        <Button Grid.Column="1" Content="{DynamicResource Lang_Msg_Cancel}" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click" />
      </Grid>
      <Rectangle Height="1" Fill="#C8C4C1" VerticalAlignment="Top" />
    </Grid>
  </Grid>
</UserControl>