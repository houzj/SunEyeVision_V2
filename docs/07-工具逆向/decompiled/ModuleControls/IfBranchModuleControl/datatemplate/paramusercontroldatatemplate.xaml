<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="IfBranchItem">
    <Grid Margin="0,0,0,6" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="143" />
        <ColumnDefinition Width="314" />
        <ColumnDefinition Width="80" />
        <ColumnDefinition Width="86" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="14,0,0,0" Width="60" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Binding RealNameA}" />
      <ContentControl Grid.Column="1" Margin="11,0,0,0" Width="132" Height="32" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecter}" />
      <ContentControl Grid.Column="2" Margin="14,0,0,0" Width="300" Height="32" ContentTemplate="{StaticResource FloatBettween_sub}" Content="{Binding Floatbetween}" />
      <ContentControl Grid.Column="3" Margin="14,0,0,0" Height="32" ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding State}" />
      <ComboBox Grid.Column="4" Margin="14,0,0,0" DisplayMemberPath="DisplayNameA" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA}" SelectedValue="{Binding RunModuleId, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
      <Button Grid.Column="5" Width="24" Height="24" Margin="14,0,0,0" Style="{StaticResource deleteButton}" Command="{Binding DeleteCommand}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_IfBranch_Container">
    <Grid Margin="5,0,0,0">
      <StackPanel>
        <ItemsControl Name="listVarItems" ItemTemplate="{StaticResource IfBranchItem}" ItemsSource="{Binding ItemsA}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
          <ComboBox DisplayMemberPath="DisplayNameALang" Width="68" Height="32" Margin="10,0" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA}" SelectedIndex="{Binding SelectTypeIndex}" />
          <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_IfBranch">
    <Grid>
      <ContentControl Name="MyIfBranch" ContentTemplate="{StaticResource ButtonSelecter_IfBranch_Container}" Content="{Binding BridgeObjA}" />
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewMouseWheel">
          <i:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=MyIfBranch}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </Grid>
  </DataTemplate>
</ResourceDictionary>