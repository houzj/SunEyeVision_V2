<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Local="clr-namespace:Apps.XmlParser.ParamTab" xmlns:localcontrol="clr-namespace:Apps.XmlUI.ParamTabControl;assembly=Apps.XmlUI" xmlns:controls1="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
  <DataTemplate x:Key="OpenFileForAcquisition">
    <localParamTab:LeftRightControl FrameworkElement.Height="34">
      <localParamTab:LeftRightControl.LeftContent>
        <TextBlock VerticalAlignment="Center" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource OpenFileDialog_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="ImageConfigItem">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="{DynamicResource Image Config}" HorizontalAlignment="Left" Margin="26,0,0,0" FontWeight="Bold" FontSize="14" />
        <Label Grid.Column="1" FontWeight="Bold" FontSize="14" Margin="-4,0,0,0" Content="{Binding Serial}" />
        <Button Grid.Column="3" Style="{StaticResource BaseImageConfig_DeleteButtonStyle}" Command="{Binding DeleteCommand}" />
      </Grid>
      <ContentControl Grid.Row="1" ContentTemplate="{StaticResource Float}" Content="{Binding FloatExposure}" Visibility="{Binding DataContext.IsCameraMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource bool2VisibilityConverter}}" />
      <ContentControl Grid.Row="2" ContentTemplate="{StaticResource Float}" Content="{Binding FloatGain}" Visibility="{Binding DataContext.IsCameraMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource bool2VisibilityConverter}}" />
      <ContentControl Grid.Row="3" ContentTemplate="{StaticResource EnumerationLight}" Content="{Binding EnumerationLightA}" Visibility="{Binding DataContext.IsCameraMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource bool2VisibilityConverter}}" />
      <ContentControl Grid.Row="4" ContentTemplate="{StaticResource Integer}" Content="{Binding IntTriggerTime}" Visibility="{Binding DataContext.IsCameraMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource bool2VisibilityConverter}}" />
      <ContentControl Grid.Row="5" ContentTemplate="{StaticResource Integer}" Content="{Binding IntChannel}" Visibility="{Binding DataContext.IsCameraMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource bool2VisibilityConverter}}" />
      <ContentControl Grid.Row="6" ContentTemplate="{StaticResource Integer}" Content="{Binding IntBright}" Visibility="{Binding DataContext.IsCameraMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource bool2VisibilityConverter}}" />
      <ContentControl Grid.Row="7" ContentTemplate="{StaticResource Float}" Content="{Binding FloatDistribution}" />
      <ContentControl Grid.Row="8" ContentTemplate="{StaticResource Float}" Content="{Binding FloatIrradiation}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ImageConfig">
    <StackPanel>
      <ItemsControl Name="listInputImageConfig" ItemTemplate="{StaticResource ImageConfigItem}" ItemsSource="{Binding ItemsA}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <Button Margin="18,10,0,3" HorizontalAlignment="Left" Style="{StaticResource BaseImageConfig_ButtonStyle}" Command="{Binding AddCommand}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>