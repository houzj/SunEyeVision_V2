<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="ImageSourceModuleControl.LocalImageListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ImageSourceModuleControl" xmlns:localcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="UserControl" Width="{Binding CustomTabWidth, ElementName=UserControl}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/ParamTabControl/ParamTabUI/FrequentlyStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="Boolean_sub">
        <localcontrol:BooleanControl Margin="5,4,0,0" IsChecked="{Binding CurValueA, Mode=TwoWay}">
          <localcontrol:BooleanControl.OffContent>
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_off_dark.png" />
          </localcontrol:BooleanControl.OffContent>
          <localcontrol:BooleanControl.OnContent>
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_on_dark.png" />
          </localcontrol:BooleanControl.OnContent>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="OnCheckedChange">
              <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </localcontrol:BooleanControl>
      </DataTemplate>
      <DataTemplate x:Key="Boolean">
        <StackPanel Height="40" Width="auto" HorizontalAlignment="Right" Orientation="Horizontal" Margin="{Binding MarginA}">
          <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Col_DisplayImage_ImageSource_Foreground}" Margin="5,1,-5,0" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
          <ContentControl Margin="20,0,0,0" ContentTemplate="{StaticResource Boolean_sub}" Content="{Binding}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Border BorderBrush="#CCBEBEBE" BorderThickness="1">
        <Grid Name="MainGrid">
          <StackPanel Margin="0,0,0,0" Background="#FFFFFFFF">
            <Grid Height="40">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="36" />
              </Grid.ColumnDefinitions>
              <ComboBox Name="cbx" Grid.Column="1" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="20,5" SelectedIndex="0" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding ImageModes, ElementName=UserControl}" SelectedValue="{Binding IsSelectMode, ElementName=UserControl}" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource self}}" Visibility="{Binding IsExpanded, ElementName=UserControl, Converter={StaticResource bool2VisibilityConverter}}" SelectionChanged="cbxMode_SelectionChanged" />
              <Border Grid.Column="2">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Width" Value="130" />
                    <Style.Triggers>
                      <DataTrigger Value="False" Binding="{Binding IsImageSourceModule, ElementName=list}">
                        <Setter Property="Width" Value="0" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Border>
              <ToggleButton Grid.Column="3" Style="{StaticResource DisplayHideBtnStyle}" IsChecked="{Binding IsExpanded, ElementName=UserControl}" />
            </Grid>
            <local:ImageListPanel x:Name="list" Margin="5,-40,5,5" CurSelectedModule="{Binding DataContext.DecorateSource, ElementName=UserControl}" TargetValue="{Binding CurValueA, Mode=TwoWay}" IsSelectMode="{Binding IsSelectMode, Mode=TwoWay, ElementName=UserControl}" DataContext="{Binding CurrentImagePath, ElementName=UserControl}" IsExpanded="{Binding IsExpanded, ElementName=UserControl}" DoFreshImageList="{Binding FreshImageListFlag}" />
          </StackPanel>
        </Grid>
      </Border>
    </ControlTemplate>
  </Control.Template>
  <FrameworkElement.Style>
    <Style TargetType="{x:Type Control}">
      <Setter Property="Height" Value="125" />
      <Style.Triggers>
        <DataTrigger Value="False" Binding="{Binding IsExpanded, ElementName=UserControl}">
          <Setter Property="Height" Value="40" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
</Control>