<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="OCRModuleCommonControl.MultiROIFilterUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:jas="clr-namespace:WPF.JoshSmith.ServiceProviders.UI;assembly=VM.ModuleControl" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:PControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:OCR="clr-namespace:VM.ModuleControl;assembly=VM.ModuleControl" xmlns:local="clr-namespace:OCRModuleCommonControl" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="b2v" />
      <Style x:Key="boolean" TargetType="{x:Type ToggleButton}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Image Name="Image" Source="/Apps.Style;component/Resources/swith_off.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Image" Property="Image.Source" Value="/Apps.Style;component/Resources/swith_on.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="OCRFilterItemStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid Background="#00FFFFFF">
                <Popup Name="Popup" Placement="Top" AllowsTransparency="True">
                  <Border Name="pbd" BorderThickness="1" BorderBrush="#B8B3AF" CornerRadius="1" Background="#F2F3F5">
                    <TextBlock FontSize="14" Foreground="#666666" Text="{Binding CustomString}" />
                  </Border>
                </Popup>
                <Grid Name="gd" Width="32" Margin="11,10,0,0">
                  <Border Name="bd" Width="32" Height="38" CornerRadius="2" BorderBrush="#FFCCCCCD" BorderThickness="1" Background="#FFFCFCFC" HorizontalAlignment="Right" MouseLeftButtonDown="bd_MouseLeftButtonDown">
                    <PControl:PopupButton Name="et" Grid.Column="0" HorizontalOffsetVal="0" Style="{x:Null}" IsDropDownOpen="{Binding IsConfigPanalDropDownOpen, Mode=TwoWay}">
                      <PControl:PopupButton.ButtonStyle>
                        <Style TargetType="{x:Type ToggleButton}">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <TextBlock Foreground="#FF808080" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding DisplayName, Mode=OneWay}">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                      <Setter Property="FontSize" Value="18" />
                                      <Style.Triggers>
                                        <DataTrigger Value="English" Binding="{Binding MyLanguage}">
                                          <Setter Property="FontSize" Value="13" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </TextBlock>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </PControl:PopupButton.ButtonStyle>
                      <PControl:PopupButton.SubContent>
                        <DataTemplate>
                          <OCR:CustomPanelConfigUI />
                        </DataTemplate>
                      </PControl:PopupButton.SubContent>
                    </PControl:PopupButton>
                  </Border>
                </Grid>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <DataTrigger Value="" Binding="{Binding CustomString}">
                  <Setter TargetName="pbd" Property="Border.BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsInterval}">
                  <Setter TargetName="gd" Property="Width" Value="49" />
                </DataTrigger>
                <Trigger SourceName="bd" Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Popup" Property="Popup.IsOpen" Value="True" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="jas:ListViewItemDragState.IsBeingDragged" Value="True">
            <Setter Property="FontWeight" Value="DemiBold" />
          </Trigger>
          <Trigger Property="jas:ListViewItemDragState.IsUnderDragCursor" Value="True">
            <Setter Property="FontWeight" Value="DemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="OCRFilterButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <EventSetter Event="Click" Handler="Button_Click" />
      </Style>
      <Style x:Key="ListViewStyle1" TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FF042271" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <Themes:ListBoxChrome Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" UIElement.SnapsToDevicePixels="True">
                <ScrollViewer Tag="1" Style="{StaticResource RecScrollViewer}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Themes:ListBoxChrome>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Themes:ListBoxChrome.Background" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ListView}" TargetType="{x:Type ListView}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
          <Setter Property="ScrollViewer.PanningMode" Value="Both" />
          <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListView}">
                <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="1,1,0,1" SnapsToDevicePixels="True">
                  <ScrollViewer Tag="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="{TemplateBinding Control.Padding}" Style="{StaticResource RecScrollViewer}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  </ScrollViewer>
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="ItemsControl.IsGrouping" Value="True" />
                      <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                  </MultiTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsSingleCheck}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
          <Style.Setters>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                  <Border Name="bd" SnapsToDevicePixels="True" Height="40px" Padding="{TemplateBinding Control.Padding}" Background="{x:Null}">
                    <Grid Margin="10,0,8,0">
                      <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ModuleForeground}" Text="{Binding Index, StringFormat=ROI-{0}}" />
                      <StackPanel Orientation="Horizontal" Margin="65,0,0,0" Visibility="{Binding DataContext.IsROIListCustomizable, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Converter={StaticResource b2v}}">
                        <Button Width="24" Height="24" Style="{StaticResource ToUpButtonStyle}" Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}" />
                        <Button Width="24" Height="24" Margin="2,0,0,0" Style="{StaticResource ToDownButtonStyle}" Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IcDeleteBtnStyle}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter Value="{DynamicResource GlobalMouseOverBg}" TargetName="bd" Property="Border.Background" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Value="{DynamicResource GlobalMouseOverBg}" TargetName="bd" Property="Border.Background" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style.Setters>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Background="{DynamicResource GlobalGridBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="14,0">
        <TextBlock FontSize="14" Foreground="{DynamicResource ModuleForeground}" FontWeight="Bold" Text="{DynamicResource Lang_SingleCheck}" VerticalAlignment="Center" MinWidth="80" HorizontalAlignment="Left" />
        <ToggleButton Style="{StaticResource boolean}" Margin="14,0,0,0" IsChecked="{Binding IsSingleCheck}" Checked="SingleButton_Checked" />
      </StackPanel>
      <Grid Margin="15,10,14,0" Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Tab_ROI List}" Foreground="{DynamicResource ModuleForeground}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
        <Button Grid.Column="1" Style="{StaticResource AddBtnStyle}" HorizontalAlignment="Center" Visibility="{Binding IsROIListCustomizable, Converter={StaticResource b2v}}" Click="Add_Click" />
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsSingleCheck}">
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Grid>
      <Grid Row="2" Margin="0,5">
        <ListView Name="roiList" ItemsSource="{Binding FilterDataCollection}" SelectedItem="{Binding CurSelectItem}" />
      </Grid>
    </Grid>
    <Grid Name="cfgGrid" Column="1" Background="{DynamicResource GlobalMouseOverBg}" DataContext="{Binding CurSelectItem}">
      <Grid.RowDefinitions>
        <RowDefinition Height="102" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="18,0,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <TextBlock Name="fi" FontSize="14" Foreground="#FF4C4C4C" FontWeight="Bold" Text="{DynamicResource Character Check Enable}" VerticalAlignment="Center" MinWidth="116" HorizontalAlignment="Left" />
          <ToggleButton Style="{StaticResource boolean}" Margin="14,0,0,0" IsChecked="{Binding FontFilterEnable}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding FontFilterEnable}">
          <TextBlock FontSize="14" Foreground="#666666" Text="{DynamicResource Identify Character Quantity}" VerticalAlignment="Center" HorizontalAlignment="Right" Width="{Binding ActualWidth, ElementName=fi}" />
          <ContentControl ContentTemplate="{StaticResource Integer_Sub}" Width="182" Margin="14,0,0,0" Content="{Binding FontFilterNum}" />
        </StackPanel>
      </StackPanel>
      <Rectangle Height="1" Fill="#FFE0DFDE" Width="468" Margin="18,0,0,0" VerticalAlignment="Bottom" />
      <StackPanel Grid.Row="1" Margin="18,0,0,0" DataContext="{Binding OCRFilerUIData}">
        <TextBlock FontSize="14" Foreground="#FF4C4C4C" FontWeight="Bold" Text="{DynamicResource 设置字符类型}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,16,0,0">
          <Button Name="all" Content="{DynamicResource All}" Style="{StaticResource OCRFilterButtonStyle}" />
          <Button Name="num" Content="{DynamicResource 数字}" Style="{StaticResource OCRFilterButtonStyle}" />
          <Button Name="cap" Content="{DynamicResource 大写字母}" Style="{StaticResource OCRFilterButtonStyle}" />
          <Button Name="lower" Content="{DynamicResource 小写字母}" Style="{StaticResource OCRFilterButtonStyle}" />
          <Button Name="spe" Content="{DynamicResource 特殊字符}" Style="{StaticResource OCRFilterButtonStyle}" />
          <Button Name="spa" Content="{DynamicResource 空格}" Style="{StaticResource OCRFilterButtonStyle}" />
          <Button Name="cus" Content="{DynamicResource 自定义}" Style="{StaticResource OCRFilterButtonStyle}" />
        </StackPanel>
        <ListView Name="listView" Margin="0,13,18,0" Height="160" Style="{StaticResource ListViewStyle1}" Background="#00FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource OCRFilterItemStyle}" FocusVisualStyle="{x:Null}" ItemsSource="{Binding Collection}" SelectedItem="{Binding curSelectedItem}" DragEnter="OnListViewDragEnter" Drop="OnListViewDrop">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Margin="5,0,0,0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ListView>
      </StackPanel>
      <Grid Row="1" Background="#FFFFFFFF" Opacity="0.5">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding FontFilterEnable}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding FontFilterEnable}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Grid>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource GlobalBorderBg}">
      <Grid HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="{DynamicResource Confirm}" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Click="OK_Click" />
        <Button Grid.Column="1" Content="{DynamicResource Lang_Msg_Cancel}" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click" />
      </Grid>
    </Border>
  </Grid>
</UserControl>