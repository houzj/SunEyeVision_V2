<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:local="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="AddButton_PointSet">
    <Grid Height="20" Margin="34,8,40,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <commomcontrol:SuperImageButton Name="ByPoint" Grid.Column="0" Height="20">
        <commomcontrol:SuperImageButton.NormalConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
            <TextBlock Text="{DynamicResource RunParam_By Point}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#808080" />
          </StackPanel>
        </commomcontrol:SuperImageButton.NormalConnent>
        <commomcontrol:SuperImageButton.PressedConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
            <TextBlock Text="{DynamicResource RunParam_By Point}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Col_Theme}" />
          </StackPanel>
        </commomcontrol:SuperImageButton.PressedConnent>
        <commomcontrol:SuperImageButton.MOverConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
            <TextBlock Text="{DynamicResource RunParam_By Point}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Col_Theme}" />
          </StackPanel>
        </commomcontrol:SuperImageButton.MOverConnent>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <commomcontrol:ParamsEventCommand CommandParameter="0" Command="{Binding ClickCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </commomcontrol:SuperImageButton>
      <commomcontrol:SuperImageButton Name="ByCoordinate" Grid.Column="1" Height="20">
        <commomcontrol:SuperImageButton.NormalConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
            <TextBlock Text="{DynamicResource RunParam_By Coordinate}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#808080" />
          </StackPanel>
        </commomcontrol:SuperImageButton.NormalConnent>
        <commomcontrol:SuperImageButton.PressedConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
            <TextBlock Text="{DynamicResource RunParam_By Coordinate}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Col_Theme}" />
          </StackPanel>
        </commomcontrol:SuperImageButton.PressedConnent>
        <commomcontrol:SuperImageButton.MOverConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
            <TextBlock Text="{DynamicResource RunParam_By Coordinate}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Col_Theme}" />
          </StackPanel>
        </commomcontrol:SuperImageButton.MOverConnent>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <commomcontrol:ParamsEventCommand CommandParameter="1" Command="{Binding ClickCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </commomcontrol:SuperImageButton>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="PointCoordinate">
    <Grid Height="68" Margin="34,1,40,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="4" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>
      <Grid Column="0" Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding LangParamWidth}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Control Template="{StaticResource TextLeft}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding DisplayIndexA}" />
          <TextBlock VerticalAlignment="Center" Text="/X" />
        </StackPanel>
        <ContentControl Grid.Column="1" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding XCoordButtonSelecterA}" />
      </Grid>
      <Grid Column="0" Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding LangParamWidth}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Control Template="{StaticResource TextLeft}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding DisplayIndexA}" />
          <TextBlock VerticalAlignment="Center" Text="/Y" />
        </StackPanel>
        <ContentControl Grid.Column="1" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding YCoordButtonSelecterA}" />
      </Grid>
      <Grid Column="1" RowSpan="3" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
        <Image Stretch="Uniform" Source="/Apps.Style;component/Resources/ic_delete-line_click.png" />
        <Button Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
          <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
          <FrameworkElement.Tag>
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
          </FrameworkElement.Tag>
        </Button>
      </Grid>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Point">
    <local:LeftRightControl FrameworkElement.Height="32">
      <local:LeftRightControl.LeftContent>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Control Template="{StaticResource TextLeft}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding DisplayIndexA}" />
        </StackPanel>
      </local:LeftRightControl.LeftContent>
      <local:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource ButtonSelecterSub_Del}" Content="{Binding}" />
      </local:LeftRightControl.RightContent>
    </local:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="PointSet">
    <Grid>
      <ContentControl Name="point" ContentTemplate="{StaticResource Point}" Visibility="{Binding IsPointA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding}" />
      <ContentControl Name="pointCoord" ContentTemplate="{StaticResource PointCoordinate}" Visibility="{Binding IsPointCoordinateA, Converter={StaticResource bool2VisibilityConverter}}" Content="{Binding}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>