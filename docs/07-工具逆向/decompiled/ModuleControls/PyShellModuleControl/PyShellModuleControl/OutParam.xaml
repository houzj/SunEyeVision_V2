<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PyShellModuleControl.OutParam" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PyShellModuleControl" xmlns:localcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:PCommom="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:PControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" x:Name="OutParamEdit">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <convert:LongTextConvert x:Key="OutputLongTextConvert" FontFamily="Microsoft YaHei" MaxLen="130" FontSize="14" />
      <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="#FF3C7FB1" />
      <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="Transparent" />
      <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="#222" />
      <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="#FF526C7B" />
      <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="Transparent" />
      <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="#FF003366" />
      <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="DarkGray" />
      <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="Transparent" />
      <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#666" />
      <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="Transparent" />
      <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="DarkGray" />
      <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="#666" />
      <Style x:Key="ExpanderDownHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Padding="{TemplateBinding Control.Padding}">
                <Grid Background="#00FFFFFF" SnapsToDevicePixels="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Path Name="arrow" Data="M1,1.5 L4.5,5 L1,8.5" HorizontalAlignment="Center" SnapsToDevicePixels="False" StrokeThickness="2" VerticalAlignment="Center" Stroke="{StaticResource Expander.Static.Arrow.Stroke}" />
                  <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" Margin="4,0,0,0" RecognizesAccessKey="True" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="arrow" Property="Path.Data" Value="M1,1.5 L4.5,5 L8,1.5" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="{StaticResource Expander.MouseOver.Arrow.Stroke}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="{StaticResource Expander.Pressed.Arrow.Stroke}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="{StaticResource Expander.Disabled.Arrow.Stroke}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderHeaderFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border>
                <Rectangle Margin="0" SnapsToDevicePixels="True" Stroke="#FF000000" StrokeThickness="1" StrokeDashArray="1 2" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderStyle1" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Expander}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" CornerRadius="3" SnapsToDevicePixels="True">
                <DockPanel>
                  <ToggleButton Name="HeaderSite" ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderedContentControl.HeaderTemplateSelector}" Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top" Foreground="{TemplateBinding Control.Foreground}" FontWeight="{TemplateBinding Control.FontWeight}" FontStyle="{TemplateBinding Control.FontStyle}" FontStretch="{TemplateBinding Control.FontStretch}" FontSize="{TemplateBinding Control.FontSize}" FontFamily="{TemplateBinding Control.FontFamily}" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="1" MinWidth="0" MinHeight="0" Padding="{TemplateBinding Control.Padding}" VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}" Style="{StaticResource ExpanderDownHeaderStyle}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter Name="ExpandSite" DockPanel.Dock="Bottom" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" Visibility="Collapsed" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                </DockPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Expander.IsExpanded" Value="True">
                  <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="EnumerationVarType">
        <ComboBox Name="cb" Height="32" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding IoSelectValueTypes}" Text="{Binding DisplayValueTypeA, Mode=TwoWay}" />
      </DataTemplate>
      <DataTemplate x:Key="DisplayOutputVar">
        <Grid Margin="0" HorizontalAlignment="Stretch" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
          <Expander ExpandDirection="Down" HorizontalAlignment="Stretch" Style="{DynamicResource ExpanderStyle1}" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel Margin="0,0,0,0" Orientation="Horizontal" Height="28">
                <TextBlock VerticalAlignment="Center" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#4D4D4D" Text="{Lang:ResourceBinding NameA, Mode=OneWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Mode=Self}}" />
                <TextBlock VerticalAlignment="Center" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#666666" Text="{Binding Path=DisplayValueTypeA, StringFormat=' ({0})'}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <ContentControl.Content>
              <ScrollViewer Margin="23,0,0,0" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}">
                <ItemsControl Name="listInputVars" ItemsSource="{Binding ShellOutputVarA, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,4,0,0" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </ContentControl.Content>
          </Expander>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="OutputVar">
        <Grid Margin="0,0,0,6" Height="32" Width="Auto" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="42" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,6,0" CornerRadius="2">
            <TextBox Name="txtName" BorderThickness="0" Padding="12,0,0,0" VerticalContentAlignment="Center" TextWrapping="NoWrap" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#808080" Background="#00FFFFFF" Text="{Lang:ResourceBinding NameA, Mode=OneWay}" MaxLength="{Binding LengthA}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Mode=Self}}" PreviewKeyDown="TxtName_PreviewKeyDown">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=txtName}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <ContentControl Grid.Column="1" Margin="0,0,6,0" ContentTemplate="{StaticResource EnumerationVarType}" Content="{Binding}" />
          <Button Margin="0,0,10,0" Grid.Column="2" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DisplayOutputVarContainer">
        <Grid Margin="18,0,0,0">
          <ScrollViewer Name="listParam" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsControl Name="listOutputVars" ItemTemplate="{StaticResource DisplayOutputVar}" ItemsSource="{Binding ItemsA}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="EditOutputVarContainer">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid Margin="18,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="42" />
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0" Content="{DynamicResource 变量名}" Margin="0,0,6,4" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#666666" />
              <Label Grid.Column="1" Content="{DynamicResource 类型}" Margin="0,0,6,4" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#666666" />
            </Grid>
          </Grid>
          <Grid Row="1" Margin="18,0,0,0">
            <ScrollViewer Name="listParam" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
              <StackPanel>
                <ItemsControl Name="listInputVars" ItemTemplate="{StaticResource OutputVar}" ItemsSource="{Binding ItemsA}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Margin="0,10,0,3" HorizontalAlignment="Left" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
                  <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
                  <FrameworkElement.Tag>
                    <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
                  </FrameworkElement.Tag>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Label Content="{DynamicResource 输出变量}" Margin="18,14,0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="0" FontWeight="Bold" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#4D4D4D" />
      <ToggleButton Name="ButEdit" Content="{DynamicResource 完成}" HorizontalAlignment="Right" Style="{StaticResource ShellEditButtonStyle1}" IsChecked="False" Visibility="{Binding IsEditCode, Converter={StaticResource bool2VisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:PyShellRun}}" Click="ParamSwitch_Click" />
    </Grid>
    <Grid Row="1">
      <ContentControl Name="editConCtrl" Visibility="Collapsed" ContentTemplate="{StaticResource EditOutputVarContainer}" Content="{Binding}" />
      <ContentControl Name="displayConCtrl" Visibility="Visible" ContentTemplate="{StaticResource DisplayOutputVarContainer}" Content="{Binding}" />
    </Grid>
  </Grid>
</UserControl>