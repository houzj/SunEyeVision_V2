<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PyShellModuleControl.PyShellRun" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:control="clr-namespace:PyShellModuleControl" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls1="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:hikCompletion="clr-namesapce:VM.CodeCompletion;assemblye=VM.CodeCompletion" xmlns:AppPcUI="clr-namespace:Apps.PcUI.Controls;assembly=Apps.PcUI" xmlns:al="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="ShellControl" Margin="-4,-4,-4,0" Unloaded="ShellControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <SolidColorBrush x:Key="GridSplitterBackground" Color="#FFE0DFDE" />
      <Style x:Key="PasswordBoxStyle" TargetType="{x:Type PasswordBox}">
        <Setter Property="Foreground" Value="#FF666666" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="False" Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" />
              <Condition Value="False" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Background">
              <Setter.Value>
                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                  <VisualBrush.Visual>
                    <TextBlock Padding="5,2" Background="#00FFFFFF" Foreground="#FFBFBFBF" Text="请输入密码" />
                  </VisualBrush.Visual>
                </VisualBrush>
              </Setter.Value>
            </Setter>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="0" BorderThickness="0" BorderBrush="#FFFF0000">
    <Grid Margin="0,0,0,8">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="borderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#A5D1D5DA" />
          </Style>
          <Style x:Key="borderStyleInText" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#A5D1D5DA" />
            <Setter Property="Background" Value="#FFFFFFFF" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="314*" MinWidth="300" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="586*" MinWidth="200" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="100" />
          <RowDefinition Height="1" />
          <RowDefinition Height="*" MinHeight="100" />
        </Grid.RowDefinitions>
        <control:InputParam x:Name="inputParamCtrl" Grid.Row="0" Background="#00FFFFFF" DataContext="{Binding ShellInVarContainerA}" />
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="19,-1,19,-1" Background="{StaticResource GridSplitterBackground}" />
        <control:OutParam x:Name="outParamCtrl" Grid.Row="2" Background="#00FFFFFF" DataContext="{Binding ShellOutVarContainerA}" />
      </Grid>
      <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource GridSplitterBackground}" Margin="-1,0,-1,0" />
      <Grid Column="2" Margin="0" Visibility="{Binding ElementName=ShellControl, Path=IsEditCode, Converter={StaticResource bool2VisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="376*" MinHeight="100" />
          <RowDefinition Height="1" />
          <RowDefinition Height="160*" MinHeight="100" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Margin="0,4,0,0" Style="{StaticResource borderStyle}" Background="#F5F7FA">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Name="btnInportCode" FontSize="12" Style="{StaticResource Orange_ButtonStyle}" Content="{DynamicResource 导入}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="24" Width="80" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="btnInportCode_Click" />
                <Button Name="btnExportCode" FontSize="12" Style="{StaticResource Orange_ButtonStyle}" Content="{DynamicResource 导出}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="24" Width="80" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="btnExportCode_Click" />
              </StackPanel>
              <Grid Column="1" Margin="0,0,10,0">
                <Button Name="btnEnablePermissions" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource Lang_EnablePermissions}" Style="{StaticResource EnablePermissions_ButtonStyle}" Visibility="{Binding ElementName=ShellControl, Path=IsPasswordUnEnabled, Mode=TwoWay, Converter={StaticResource bool2VisibilityConverter}}" Click="btnEnablePermissions_Click" />
                <Button Name="btnCancelPermissions" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource Lang_CancelPermissions}" Style="{StaticResource CancelPermissions_ButtonStyle}" Visibility="{Binding ElementName=ShellControl, Path=IsPasswordEnabled, Mode=TwoWay, Converter={StaticResource bool2VisibilityConverter}}" Click="btnCancelPermissions_Click" />
              </Grid>
            </Grid>
          </Border>
          <Grid Row="1" Margin="0,0,0,0">
            <Border Style="{StaticResource borderStyleInText}">
              <avalonedit:TextEditor FrameworkElement.Name="textEditorControl" Control.FontFamily="Consolas" Control.FontSize="10pt" xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ShowLineNumbers="True" TextChanged="textEditorControl_TextChanged" />
            </Border>
          </Grid>
          <Border Style="{StaticResource borderStyle}" Grid.Row="1" />
        </Grid>
        <GridSplitter Grid.Row="1" Margin="0,-1,0,-1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource GridSplitterBackground}" />
        <ScrollViewer Name="CompileResult" Grid.Row="2" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
          <TextBox Name="textBoxCompile" Margin="1" TextWrapping="Wrap" Padding="18,20,18,20" IsReadOnly="True" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="12" Foreground="#666666" BorderThickness="0" Text="{Binding CompileResultA}">
            <FrameworkElement.ContextMenu>
              <controls1:HikContextMenu>
                <MenuItem Header="{DynamicResource Lang_Clear}" Click="ClearRichText_OnClick" />
              </controls1:HikContextMenu>
            </FrameworkElement.ContextMenu>
          </TextBox>
        </ScrollViewer>
      </Grid>
      <Grid Column="2" Background="#FFFFFFFF">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding IsEditCode, ElementName=ShellControl}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Button FontSize="14" Style="{StaticResource Orange_ButtonStyle}" Content="{DynamicResource Lang_EditCode}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnEditCode_Click" />
      </Grid>
    </Grid>
  </Border>
</UserControl>