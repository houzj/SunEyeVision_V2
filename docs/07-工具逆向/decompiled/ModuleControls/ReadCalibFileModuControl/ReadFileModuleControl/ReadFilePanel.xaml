<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ReadFileModuleControl.ReadFilePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:paramTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:readfilemodulecontrol="clr-namespace:ReadFileModuleControl;assembly=ReadCalibFileModuControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:UserTempConverter x:Key="userTempConverter" />
      <Style x:Key="InputParamStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <ContentControl ContentTemplate="{Binding DisplayType, Converter={StaticResource userTempConverter}}" Content="{Binding}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ListBox Name="listBox" HorizontalAlignment="Left" ItemContainerStyle="{StaticResource InputParamStyle}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Background="#00FFFFFF" ScrollViewer.CanContentScroll="False" ItemsSource="{Binding CalibParam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
  </Grid>
</UserControl>