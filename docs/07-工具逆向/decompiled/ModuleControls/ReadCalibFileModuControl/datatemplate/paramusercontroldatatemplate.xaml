<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReadFileModuleControl" xmlns:paramTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:PControl="clr-namespace:Apps.PcUI.Controls;assembly=Apps.PcUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="StaticText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextBox.Normal.Forground}" />
  </Style>
  <DataTemplate x:Key="ReadFileConfigData">
    <local:ReadFilePanel />
  </DataTemplate>
  <DataTemplate x:Key="OpenFileDialog4ReadFile">
    <paramTab:LeftRightControl FrameworkElement.Height="34">
      <paramTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource OpenFileDialog_sub}" Content="{Binding}" />
      </paramTab:LeftRightControl.RightContent>
    </paramTab:LeftRightControl>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="NineBoxItemsPanelStyle">
    <UniformGrid Columns="3" IsItemsHost="True" />
  </ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="PointListStyle">
    <WrapPanel IsItemsHost="False" Orientation="Vertical" />
  </ItemsPanelTemplate>
  <DataTemplate x:Key="StaticParam">
    <Grid Margin="30,5" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource StaticText}" Text="{Binding NameA}" />
      <TextBlock Text=":" Grid.Column="1" Style="{StaticResource StaticText}" />
      <TextBlock Grid.Column="2" Style="{StaticResource StaticText}" Text="{Binding ValueA}" />
    </Grid>
  </DataTemplate>
  <Style x:Key="FloatStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="3">
            <PControl:HikTextBox Height="30" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="{Binding ValueA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ValueA}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PointStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <UniformGrid Columns="3">
            <PControl:HikTextBox Height="30" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding X}" />
            <PControl:HikTextBox Height="30" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Y}" />
            <PControl:HikTextBox Height="30" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding R}" />
          </UniformGrid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=WrapPanel}}" />
  </Style>
  <DataTemplate x:Key="CalibPointList">
    <StackPanel Orientation="Vertical">
      <TextBlock Margin="30,5,0,0" Style="{StaticResource StaticText}" Text="{Binding NameA}" />
      <ListBox Margin="34,10,0,0" Background="#00FFFFFF" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PointStyle}" ItemsPanel="{StaticResource PointListStyle}" ItemsSource="{Binding PointList}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="FloatList">
    <StackPanel Orientation="Vertical">
      <TextBlock Margin="30,5,0,0" Style="{StaticResource StaticText}" Text="{Binding NameA}" />
      <ListBox Margin="34,10,40,0" Background="#00FFFFFF" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource FloatStyle}" ItemsPanel="{StaticResource NineBoxItemsPanelStyle}" ItemsSource="{Binding EnumEntrysA}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>