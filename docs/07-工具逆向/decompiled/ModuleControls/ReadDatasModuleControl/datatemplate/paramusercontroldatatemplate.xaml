<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:local="clr-namespace:ReadDatasModuleControl" xmlns:paramtab="clr-namespace:Apps.XmlParser.ParamTab">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="QueueItemOut_Var">
    <Grid Height="32" Margin="0,1,0,0" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="85" />
        <ColumnDefinition Width="15" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="42" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="0,1,0,1" BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="2">
        <TextBox Name="tb" BorderThickness="0" TextWrapping="NoWrap" VerticalContentAlignment="Center" FontWeight="Normal" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#808080" Background="#00FFFFFF" Text="{Lang:ResourceBinding NameA, Mode=OneWay}" BorderBrush="{x:Null}" MaxLength="{Binding LengthA}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="LostFocus">
              <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=tb}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </TextBox>
      </Border>
      <ContentControl Grid.Column="2" ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding ReadDataModuleFilterA.QueueSelecterA}" />
      <Button Margin="0,0,10,0" Grid.Column="3" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
        <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="QueueItemOut_Container">
    <Grid Margin="0,0,0,0">
      <ScrollViewer Name="QueueItemOut_Container" VerticalScrollBarVisibility="Auto" Style="{StaticResource RecScrollViewer}">
        <StackPanel>
          <ItemsControl Name="listInputVars" ItemTemplate="{StaticResource QueueItemOut_Var}" ItemsSource="{Binding ItemsA}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button Margin="0,10,0,3" HorizontalAlignment="Left" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="QueueItemOut">
    <Grid Margin="30,0,0,0">
      <ContentControl Name="editConCtrl" ContentTemplate="{StaticResource QueueItemOut_Container}" Content="{Binding BridgeObjA}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Enumeration_Sub_Global_Read">
    <paramtab:ComboNoWheel Style="{StaticResource GlobalItemComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" Text="{Lang:ResourceBinding CurrentNameA, Mode=OneWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <TextBlock Name="bt" Height="30" Width="195" Padding="10,5,0,0" FontSize="14px" FontFamily="Microsoft YaHei" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="{Binding DisplayNameALang}" />
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="MouseLeftButtonDown">
                <i:InvokeCommandAction Command="{Binding OnItemClickCommand}" CommandParameter="{Binding ElementName=bt, Path=Text}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </paramtab:ComboNoWheel>
  </DataTemplate>
