<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="ButtonSelecterSub_Del_TxtSave">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <ContentControl Grid.Column="0" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding}" Visibility="{Binding IfOthersA, Converter={StaticResource bool2VisibilityConverter}}" />
      <Button Grid.Column="1" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="SaveTextItem">
    <paramtab:LeftRightControl ChildLeftWidth="100">
      <paramtab:LeftRightControl.LeftContent>
        <TextBox Width="92" FontFamily="Microsoft YaHei" FontSize="14" Foreground="#808080" Background="#00FFFFFF" MaxLength="31" Style="{StaticResource input}" Text="{Binding ColumnNameA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ColumnNameA}" />
      </paramtab:LeftRightControl.LeftContent>
      <paramtab:LeftRightControl.RightContent>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ContentControl Grid.Column="0" Width="55" Margin="5,0,0,0" ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding GlobalVarItemListA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ContentControl Grid.Column="2" ContentTemplate="{StaticResource ButtonSelecterSub_Del_TxtSave}" Content="{Binding}" />
        </Grid>
      </paramtab:LeftRightControl.RightContent>
    </paramtab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="AddButton_SaveText">
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
      <Button Margin="35,5,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>