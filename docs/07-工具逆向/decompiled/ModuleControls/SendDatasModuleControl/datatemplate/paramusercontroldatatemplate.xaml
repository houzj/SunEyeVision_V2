  <DataTemplate x:Key="GateWaySendEventItem">
    <Border Margin="30,1,0,0">
      <StackPanel Orientation="Vertical">
        <Grid Height="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{DynamicResource Number}" FontFamily="Microsoft YaHei" FontSize="14px" HorizontalAlignment="Left" Foreground="#FF666666" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Name}" FontFamily="Microsoft YaHei" FontSize="14px" HorizontalAlignment="Left" Foreground="#FF666666" />
          <TextBlock Grid.Column="2" Text="{DynamicResource Lang_Type}" FontFamily="Microsoft YaHei" FontSize="14px" HorizontalAlignment="Left" Foreground="#FF666666" />
          <TextBlock Grid.Column="3" Text="{DynamicResource RunParam_Subscribe}" FontFamily="Microsoft YaHei" FontSize="14px" HorizontalAlignment="Center" Foreground="#FF666666" />
        </Grid>
        <ItemsControl ItemsSource="{Binding ItemsA}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="5,0,0,0" FontSize="14px" VerticalAlignment="Center" FontFamily="Microsoft YaHei" Foreground="{DynamicResource ParamsTabForeground}" HorizontalAlignment="Left" Text="{Binding IndexA}" />
                <TextBlock Grid.Column="1" FontSize="14px" VerticalAlignment="Center" FontFamily="Microsoft YaHei" Foreground="{DynamicResource ParamsTabForeground}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding NameA}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock Grid.Column="2" Margin="2,0,0,0" FontSize="14px" VerticalAlignment="Center" FontFamily="Microsoft YaHei" Foreground="{DynamicResource ParamsTabForeground}" HorizontalAlignment="Left" Text="{Binding TypeNameA}" />
                <ContentControl Grid.Column="3" Margin="10,0" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>
