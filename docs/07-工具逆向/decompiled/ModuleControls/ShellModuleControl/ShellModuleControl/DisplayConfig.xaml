<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ShellModuleControl.DisplayConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ShellModuleControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:commomcontrol="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <DataTemplate x:Key="DisplayVar">
        <Grid Margin="0,0,5,6" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" Height="32" Width="Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" SharedSizeGroup="NameGroup" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="42" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#CCCCCD" BorderThickness="1" Margin="0,0,0,0" CornerRadius="2">
            <TextBox Name="tb" BorderThickness="0" Height="32" Padding="12,0,0,0" VerticalContentAlignment="Center" MaxLength="32" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Lang:ResourceBinding Name, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" IsEnabled="{Binding IsEditCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ShellRun}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="LostFocus">
                  <UIHelper:ParamsEventCommand Command="{Binding TextChangedCommand}" CommandParameter="{Binding Text, ElementName=tb}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </TextBox>
          </Border>
          <GridSplitter Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Background="#00FFFFFF" />
          <Border Grid.Column="2" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="2">
            <TextBox BorderThickness="0" IsReadOnly="True" Width="68" Height="32" VerticalContentAlignment="Center" MaxLength="65" Background="{DynamicResource ListViewComboBoxIsSelected}" Text="{Binding ValueType, Mode=OneWay}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
          </Border>
          <Border Grid.Column="3" Margin="8,0,0,0" Height="32">
            <TextBlock VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} {1}">
                  <Binding Path="RelateIOPre" />
                  <Lang:ResourceBinding Path="RelateIO.Name" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>
          <ContentControl Grid.Column="4" VerticalAlignment="Center" Visibility="{Binding IsEditCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ShellRun}, Converter={StaticResource bool2VisibilityConverter}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate">
                  <Setter.Value>
                    <DataTemplate>
                      <commomcontrol:SuperImageButton Margin="6,0,0,0" Command="{Binding ConfigShapeCommand}">
                        <commomcontrol:SuperImageButton.NormalConnent>
                          <Image Source="/Apps.Style;component/Resources/编辑normal.png" Stretch="None" />
                        </commomcontrol:SuperImageButton.NormalConnent>
                        <commomcontrol:SuperImageButton.PressedConnent>
                          <Image Source="/Apps.Style;component/Resources/编辑click.png" Stretch="None" />
                        </commomcontrol:SuperImageButton.PressedConnent>
                        <commomcontrol:SuperImageButton.MOverConnent>
                          <Image Source="/Apps.Style;component/Resources/编辑click.png" Stretch="None" />
                        </commomcontrol:SuperImageButton.MOverConnent>
                      </commomcontrol:SuperImageButton>
                    </DataTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="Content" Value="{Binding}" />
                <Style.Triggers>
                  <DataTrigger Value="image" Binding="{Binding ValueType, Mode=OneWay}">
                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                    <Setter Property="Content" Value="{x:Null}" />
                  </DataTrigger>
                  <DataTrigger Value="pixelinfoimage" Binding="{Binding ValueType, Mode=OneWay}">
                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                    <Setter Property="Content" Value="{x:Null}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContentControl>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="18,0,0,0" TextBlock.Foreground="{DynamicResource ParamsTabForeground}" TextBlock.FontFamily="Microsoft YaHei" TextBlock.FontSize="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="78" />
        <ColumnDefinition Width="68" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Content="{DynamicResource Lang_ParamName}" Margin="-5,0,0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="68" Height="32" />
      <Label Grid.Column="1" Content="{DynamicResource Lang_Type}" Margin="0,0,0,4" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="68" Height="32" />
      <Label Grid.Column="2" Content="{DynamicResource correlation}" Margin="6,0,0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="150" Height="32" />
    </Grid>
    <Grid Row="1" Margin="18,0,2,0">
      <ScrollViewer Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <ItemsControl Name="listDisplay" ItemTemplate="{StaticResource DisplayVar}" ItemsSource="{Binding DisplayItemsA}" SizeChanged="listDisplay_SizeChanged">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>