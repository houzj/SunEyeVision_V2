<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:StringCompareModuleControl" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:localAppsXmlUI="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:local1="clr-namespace:Apps.XmlParser.ParamTab">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <ControlTemplate x:Key="StringCompareUpTemplate" TargetType="{x:Type Button}">
    <Image Name="Image" Height="24" Width="24" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_normal.png" />
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" />
      </Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_click.png" />
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序上_disable.png" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="StringCompareDownTemplate" TargetType="{x:Type Button}">
    <Image Name="Image" Height="24" Width="24" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_normal.png" />
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" />
      </Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_click.png" />
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/特征模板_ic_排序下_disable.png" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="StringCompareDeleteTemplate" TargetType="{x:Type Button}">
    <Image Name="Image" Height="24" Width="24" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/delete_click.png" />
      </Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter TargetName="Image" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/delete_click.png" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <local1:IntegerValueConvert x:Key="IntegerValueConvert" />
  <DataTemplate x:Key="StringCompare">
    <local:LeftRightControl Height="32" Margin="5,6,0,0" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
      <local:LeftRightControl.LeftContent>
        <TextBox Margin="-5,0,0,0" Padding="2,0,0,0" Height="30" Width="30" FontSize="14" HorizontalContentAlignment="Left" Style="{StaticResource input}" Text="{Binding RealIndex}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="LostFocus">
              <i:InvokeCommandAction Command="{Binding RealIndexCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </TextBox>
      </local:LeftRightControl.LeftContent>
      <local:LeftRightControl.RightContent>
        <ContentControl Margin="-5,0,0,0">
          <Border>
            <StackPanel Orientation="Horizontal">
              <Grid>
                <ContentControl Width="130" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FilterSelecter}" />
              </Grid>
              <Button Width="24" Height="24" Template="{StaticResource StringCompareUpTemplate}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding UpEnable, Mode=TwoWay}" />
              <Button Width="24" Height="24" Template="{StaticResource StringCompareDownTemplate}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding DownEnable, Mode=TwoWay}" />
              <Button Width="24" Height="24" Template="{StaticResource StringCompareDeleteTemplate}" Command="{Binding DeleteCommand}" />
            </StackPanel>
          </Border>
        </ContentControl>
      </local:LeftRightControl.RightContent>
    </local:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="AddButtonStringCompare">
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
      <Button Margin="35,5,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_StringComp_Container">
    <Grid Margin="5,0,0,0">
      <StackPanel>
        <ItemsControl Name="listVarItems" ItemTemplate="{StaticResource StringCompare}" ItemsSource="{Binding ItemsA}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button Margin="30,5,0,3" HorizontalAlignment="Left" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
          <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
          <FrameworkElement.Tag>
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
          </FrameworkElement.Tag>
        </Button>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_StringComp">
    <Grid>
      <ContentControl Name="btnStringComp" ContentTemplate="{StaticResource ButtonSelecter_StringComp_Container}" Content="{Binding BridgeObjA}" />
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewMouseWheel">
          <i:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=ButtonSelecter_IOVar}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </Grid>
  </DataTemplate>
</ResourceDictionary>