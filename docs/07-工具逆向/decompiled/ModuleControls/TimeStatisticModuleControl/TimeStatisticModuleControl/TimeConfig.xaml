<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="TimeStatisticModuleControl.TimeConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TimeStatisticModuleControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:core="clr-namespace:VM.Core;assembly=VM.Core" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:appxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" x:Name="uc">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="ModuleItem">
        <Grid Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
          </Grid.ColumnDefinitions>
          <TextBlock Foreground="#4C4C4C" FontSize="14" Text="{Binding TimeName}" />
          <Grid Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox DisplayMemberPath="Name" Grid.Row="0" HorizontalAlignment="Center" Width="200" Height="32" Margin="2" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding StartModules}" SelectedItem="{Binding StartModule}" />
            <ComboBox DisplayMemberPath="Name" Grid.Row="1" HorizontalAlignment="Center" Width="200" Height="32" Margin="2" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EndModules}" SelectedItem="{Binding EndModule}" />
          </Grid>
          <Button Grid.Column="2" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommond}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <StackPanel>
        <ItemsControl Name="listVarItems" Margin="10" ItemTemplate="{StaticResource ModuleItem}" ItemsSource="{Binding TimeStatisticItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="10">
          <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommond}" Click="Button_Click">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </StackPanel>
      </StackPanel>
    </ControlTemplate>
  </Control.Template>
</Control>