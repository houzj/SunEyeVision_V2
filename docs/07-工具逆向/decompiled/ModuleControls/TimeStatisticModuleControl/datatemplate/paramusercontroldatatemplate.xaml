<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:local="clr-namespace:TimeStatisticModuleControl" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="Enumeration_TimeStatistic">
    <localParamTab:LeftRightControl FrameworkElement.Height="32">
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="TimeStatisticItem">
    <Grid Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Grid Column="0">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" Width="200" Height="32" ContentTemplate="{StaticResource Enumeration_TimeStatistic}" Content="{Binding StartEnumeration}" />
        <ContentControl Grid.Row="1" Width="200" Height="32" ContentTemplate="{StaticResource Enumeration_TimeStatistic}" Content="{Binding EndEnumeration}" />
      </Grid>
      <Button Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}">
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/delete_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="TimeStatistic_Container">
    <Grid Margin="5,0,0,0">
      <StackPanel>
        <ItemsControl Name="listItems" ItemTemplate="{StaticResource TimeStatisticItem}" ItemsSource="{Binding ItemsA}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
          <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding AddCommand}">
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/add_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Selecter_TimeStatistic">
    <Grid>
      <ContentControl Name="MyTimeStatistic" ContentTemplate="{StaticResource TimeStatistic_Container}" Content="{Binding BridgeObjA}" />
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewMouseWheel">
          <i:InvokeCommandAction Command="{Binding PreviewMouseWheelCommand}" CommandParameter="{Binding ElementName=MyTimeStatistic}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="TimeConfig">
    <local:TimeConfig />
  </DataTemplate>
</ResourceDictionary>