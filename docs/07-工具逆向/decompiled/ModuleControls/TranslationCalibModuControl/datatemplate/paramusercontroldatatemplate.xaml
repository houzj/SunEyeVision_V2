<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TranslationCalibModuControl" xmlns:paramTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="EditButton_Calib_sub">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>
      <ContentControl Grid.Column="0" ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding}" />
      <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding EditDialogA.ClickCommand}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border BorderThickness="1" BorderBrush="#FFCCCCCD" CornerRadius="2" Margin="2,2,0,1">
                    <Image Name="icon" Height="28" Width="28" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Apps.XmlUI;component/Resources/edit_normal.png" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="icon" Property="Image.Source" Value="/Apps.XmlUI;component/Resources/edit_click.png" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </FrameworkElement.Style>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EditButton_Calib">
    <paramTab:LeftRightControl FrameworkElement.Height="32">
      <paramTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </paramTab:LeftRightControl.LeftContent>
      <paramTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource EditButton_Calib_sub}" Content="{Binding}" />
      </paramTab:LeftRightControl.RightContent>
    </paramTab:LeftRightControl>
  </DataTemplate>
</ResourceDictionary>