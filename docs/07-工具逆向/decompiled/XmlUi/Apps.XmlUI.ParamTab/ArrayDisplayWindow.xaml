<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="Apps.XmlUI.ParamTab.ArrayDisplayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Apps.XmlUI.ParamTab" xmlns:PCommom="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="arryDlg" Height="460" Width="670" Title="{Binding WindowTitle, ElementName=arryDlg}" Loaded="arryDlg_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
          <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
          <Setter Property="ItemsPanel">
            <Setter.Value>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ItemTemplate">
            <Setter.Value>
              <DataTemplate DataType="ValueItem">
                <Grid Height="28" Width="122" Margin="20,5,5,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock MaxWidth="40" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" ToolTip="{Binding Index}" Text="{Binding Index}" />
                  <TextBlock Grid.Column="1" MaxWidth="90" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" ToolTip="{Binding Value}" Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Name="LeftPanel" Row="0">
      <Border Margin="20,20,20,5" BorderBrush="#E0DFDE" BorderThickness="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
          </Grid.RowDefinitions>
          <Border Grid.Column="0" BorderBrush="#E4E5E7" Background="#E4E5E7" BorderThickness="1">
            <ScrollViewer Name="ScrollViewer" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding Path=Height, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}">
              <ItemsControl Width="652" ItemsSource="{Binding ElementName=arryDlg, Path=BindItems}" />
            </ScrollViewer>
          </Border>
          <Border Grid.Row="1" Margin="0,5,0,0">
            <paramtab:PageNumControl HorizontalAlignment="Right" Margin="0,1,9,2" TotalDataCount="{Binding ElementName=arryDlg, Path=ItemsTotalCount}" CurrentPageNumber="{Binding ElementName=arryDlg, Path=CurrentPageNum, Mode=TwoWay}" PageDataCount="{Binding ElementName=arryDlg, Path=PageCount, Mode=TwoWay}" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</controls:BaseWindow>