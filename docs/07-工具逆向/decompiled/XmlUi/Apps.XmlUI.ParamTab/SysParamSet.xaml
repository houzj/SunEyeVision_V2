<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="Apps.XmlUI.ParamTab.SysParamSet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:localcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:PControl="clr-namespace:HikPcUI.Controls;assembly=VM.PcUI" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="SysParamSetX" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Title="{DynamicResource Lang_RunInterval}" Height="200" Width="370" BorderBrush="#FF161617" BorderThickness="1" MinButtonVisibility="Collapsed" ShowInTaskbar="False" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFF2F3F5">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32" Margin="0,0,0,20">
      <Label Content="{DynamicResource Lang_RunIntervalms}" Width="122" FontSize="14" Margin="26,0,0,0" Foreground="#FF666666" />
      <localcontrol:SliderArrange Name="timeSpan" Margin="12,0,0,0" FontSize="14" Width="182" Maximum="100000" Minimum="0" SliderTickFrequency="10" StartValue="80">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="OnStartValueChange">
            <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </localcontrol:SliderArrange>
    </StackPanel>
    <Grid Background="#FFE4E4E7" Height="32" VerticalAlignment="Bottom">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Confirm}" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="ButtonApply_Click" />
        <Button Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Lang_Msg_Cancel}" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="ButtonClose_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</controls:BaseWindow>