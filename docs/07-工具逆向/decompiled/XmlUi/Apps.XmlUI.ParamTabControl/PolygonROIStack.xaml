<?xml version="1.0" encoding="utf-8"?>
<localcontrol:ROIStackControl x:Class="Apps.XmlUI.ParamTabControl.PolygonROIStack" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Apps.XmlUI.ParamTabControl" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:baseData="clr-namespace:Apps.BaseData;assembly=Apps.BaseData" xmlns:localcontrol="clr-namespace:Apps.XmlUI.ParamTabControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:com="clr-namespace:HikPcUI.Commom;assembly=VM.PcUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <baseData:GetIndexConverter x:Key="indexConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <ItemsControl Name="listViewParam" MaxHeight="160" Margin="0,0,0,0" HorizontalAlignment="Left" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#00FFFFFF" VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ScrollItemsControlStyle}" ItemsSource="{Binding ROIData.PolygonPoints, RelativeSource={RelativeSource Mode=TemplatedParent}}" AlternationCount="{Binding ItemsSource.Count, RelativeSource={RelativeSource Mode=Self}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <localParamTab:LeftRightControl Height="32">
              <localParamTab:LeftRightControl.LeftContent>
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Text="{DynamicResource Point}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Path=(ItemsControl.AlternationIndex), Converter={StaticResource indexConverter}, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                  <TextBlock VerticalAlignment="Center" Text="(x,y)" />
                </StackPanel>
              </localParamTab:LeftRightControl.LeftContent>
              <localParamTab:LeftRightControl.RightContent>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <localcontrol:SliderArrangePoint Grid.Column="0" SliderTickFrequency="1" Minimum="-30000" Maximum="30000" ImageLenth="{Binding ImageWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}}" OriPoints="{Binding ItemsSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:PolygonROIStack}}">
                    <localcontrol:SliderArrangePoint.PointSource>
                      <MultiBinding Mode="TwoWay">
                        <MultiBinding.Converter>
                          <baseData:PointRightFixdMultiplicationConverter />
                        </MultiBinding.Converter>
                        <Binding Path="DataContext" Mode="OneWay" RelativeSource="{RelativeSource Mode=Self}" />
                        <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                        <Binding Path="ImageHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                      </MultiBinding>
                    </localcontrol:SliderArrangePoint.PointSource>
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="OnStartValueChange">
                        <i:InvokeCommandAction Command="{Binding DataContext.ROIValueChangedCommand, ElementName=listViewParam}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </localcontrol:SliderArrangePoint>
                  <TextBlock Grid.Column="1" Text="," HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                  <localcontrol:SliderArrangePoint Grid.Column="2" SliderTickFrequency="1" IsX="False" Minimum="-30000" Maximum="30000" ImageLenth="{Binding ImageHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}}" OriPoints="{Binding ItemsSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:PolygonROIStack}}">
                    <localcontrol:SliderArrangePoint.PointSource>
                      <MultiBinding Mode="TwoWay">
                        <MultiBinding.Converter>
                          <baseData:PointRightFixdMultiplicationConverter />
                        </MultiBinding.Converter>
                        <Binding Path="DataContext" Mode="OneWay" RelativeSource="{RelativeSource Mode=Self}" />
                        <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                        <Binding Path="ImageHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                      </MultiBinding>
                    </localcontrol:SliderArrangePoint.PointSource>
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="OnStartValueChange">
                        <i:InvokeCommandAction Command="{Binding DataContext.ROIValueChangedCommand, ElementName=listViewParam}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </localcontrol:SliderArrangePoint>
                </Grid>
              </localParamTab:LeftRightControl.RightContent>
            </localParamTab:LeftRightControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ControlTemplate>
  </Control.Template>
</localcontrol:ROIStackControl>