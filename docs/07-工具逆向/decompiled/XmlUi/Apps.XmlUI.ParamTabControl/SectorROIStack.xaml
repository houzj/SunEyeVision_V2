<?xml version="1.0" encoding="utf-8"?>
<localcontrol:ROIStackControl x:Class="Apps.XmlUI.ParamTabControl.SectorROIStack" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Apps.XmlUI.ParamTabControl" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:baseData="clr-namespace:Apps.BaseData;assembly=Apps.BaseData" xmlns:localcontrol="clr-namespace:Apps.XmlUI.ParamTabControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:PCImage="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <StackPanel>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Circle Center X}" ToolTip="{DynamicResource Circle Center X}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:SliderArrangeFloat SliderTickFrequency="1" Minimum="-30000" Maximum="30000" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <localcontrol:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <baseData:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.CenterX" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </localcontrol:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localcontrol:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Circle Center Y}" ToolTip="{DynamicResource Circle Center Y}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:SliderArrangeFloat SliderTickFrequency="1" Minimum="-30000" Maximum="30000" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <localcontrol:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <baseData:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.CenterY" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </localcontrol:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localcontrol:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource roiAnnulusOuterRadius}" ToolTip="{DynamicResource roiAnnulusOuterRadius}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:SliderArrangeFloat SliderTickFrequency="1" Minimum="0" Maximum="{x:Static PCImage:HikCoverCircle2.MaxRadius}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <localcontrol:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <baseData:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.Radius" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </localcontrol:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localcontrol:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource CircleInnerRadius}" ToolTip="{DynamicResource CircleInnerRadius}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:SliderArrangeFloat SliderTickFrequency="1" Minimum="0" Maximum="{x:Static PCImage:HikCoverCircle2.MaxRadius}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <localcontrol:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <baseData:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.MinRadius" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </localcontrol:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localcontrol:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Angle Start}" ToolTip="{DynamicResource Angle Start}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:SliderArrangeFloat SliderTickFrequency="1" Minimum="-180" Maximum="180" StartValue="{Binding ROIData.BeginAngle, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localcontrol:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource AngleRange}" ToolTip="{DynamicResource AngleRange}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:SliderArrangeFloat SliderTickFrequency="1" Minimum="0" StartValue="{Binding ROIData.AngleRange, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" Maximum="{Binding MaxAngleRange, RelativeSource={RelativeSource Mode=TemplatedParent}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localcontrol:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
      </StackPanel>
    </ControlTemplate>
  </Control.Template>
</localcontrol:ROIStackControl>