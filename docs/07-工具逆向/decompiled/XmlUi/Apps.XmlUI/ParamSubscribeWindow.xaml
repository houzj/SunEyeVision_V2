<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="Apps.XmlUI.ParamSubscribeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:PCommon="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:local="clr-namespace:Apps.XmlUI.ParamTabControl" x:Name="win" Height="480" Width="240" MaxButtonVisibility="Collapsed" MinButtonVisibility="Collapsed" ShowInTaskbar="False" xmlns:xmlui="clr-namespace:Apps.XmlUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="b2v" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <controls:BaseWindow.TitleBar>
    <Grid WindowChrome.IsHitTestVisibleInChrome="True">
      <TextBlock Text="{DynamicResource Lang_ParamSubscription}" HorizontalAlignment="Left" FontFamily="Microsoft YaHei" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="10,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <CheckBox Style="{StaticResource NormalCheckBoxStyle}" VerticalAlignment="Center" IsChecked="{Binding Path=Solution.(VMInterface:IVmSolution.IsSubscribeInWindow)}" />
        <TextBlock Text="{DynamicResource Lang_DefaultMethod}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" FontSize="10" Foreground="#FFFFFFFF" TextAlignment="Center" />
      </StackPanel>
    </Grid>
  </controls:BaseWindow.TitleBar>
  <Grid Background="{DynamicResource GlobalMouseOverBg}" DataContext="{Binding SelectedSubscribeParam}" DataContextChanged="Grid_DataContextChanged">
    <localParamTab:SubTreeView x:Name="treeView" Margin="12" Background="#FFFFFFFF">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnTreeNodeDoubleClick">
          <PCommon:ParamsEventCommand Command="{Binding ClickCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type localParamTab:SubTreeView}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsSubscribeIndex, ElementName=win}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </localParamTab:SubTreeView>
    <localParamTab:SubTreeView x:Name="indextreeView" Margin="12" Background="#FFFFFFFF" Visibility="{Binding IsSubscribeIndex, ElementName=win, Converter={StaticResource b2v}}">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnTreeNodeDoubleClick">
          <PCommon:ParamsEventCommand Command="{Binding IndexClickCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </localParamTab:SubTreeView>
  </Grid>
</controls:BaseWindow>