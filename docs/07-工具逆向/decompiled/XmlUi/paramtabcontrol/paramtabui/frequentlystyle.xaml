<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:localcontrol="clr-namespace:HikPcUI.ListView;assembly=VM.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization">
  <DataTemplate x:Key="Boolean_sub">
    <localcontrol:BooleanControl Margin="5,4,0,0" IsChecked="{Binding CurValueA, Mode=TwoWay}">
      <localcontrol:BooleanControl.OffContent>
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_off_dark.png" />
      </localcontrol:BooleanControl.OffContent>
      <localcontrol:BooleanControl.OnContent>
        <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_on_dark.png" />
      </localcontrol:BooleanControl.OnContent>
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnCheckedChange">
          <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </localcontrol:BooleanControl>
  </DataTemplate>
  <DataTemplate x:Key="Boolean">
    <local:LeftRightControl Height="40" Width="285" HorizontalAlignment="Right" Margin="{Binding MarginA}">
      <local:LeftRightControl.LeftContent>
        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#ccBEBEBE" FontWeight="Bold" Margin="5,1,-5,0" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
      </local:LeftRightControl.LeftContent>
      <local:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource Boolean_sub}" Content="{Binding}" />
      </local:LeftRightControl.RightContent>
    </local:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="Default">
    <TextBox Text="默认控件显示" />
  </DataTemplate>
</ResourceDictionary>