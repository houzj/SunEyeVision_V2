<?xml version="1.0" encoding="utf-8"?>
<local:HikROIBase x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView.HikCircleArc" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Name="userControl" Loaded="UserControl_Loaded" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave" MouseUp="UserControl_MouseUp" MouseLeftButtonDown="UserControl_MouseLeftButtonDown" Focusable="True" FocusVisualStyle="{x:Null}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VM.PcUI/imageview/roidictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:HikCoverCircleStyleConverter x:Key="hccStyleConverter" />
      <sys:Double x:Key="dwidth">8</sys:Double>
      <sys:Double x:Key="mwidth">16</sys:Double>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="bd" BorderThickness="1" Margin="-1" BorderBrush="#00FFFFFF">
    <Canvas Name="Gp">
      <Path Name="PathFillColor" Stretch="None" StrokeThickness="1" Style="{StaticResource HikArcPathStyle}" Opacity="1" Visibility="Visible" Cursor="SizeAll">
        <Path.Data>
          <GeometryGroup>
            <PathGeometry>
              <PathFigure IsClosed="False" StartPoint="{Binding ElementName=userControl, Path=StartPoint}">
                <ArcSegment Size="{Binding ElementName=userControl, Path=MaxSize}" Point="{Binding ElementName=userControl, Path=EndPoint}" IsLargeArc="{Binding ElementName=userControl, Path=IsLargeArc}" SweepDirection="{Binding ElementName=userControl, Path=ClockWise}" />
              </PathFigure>
            </PathGeometry>
          </GeometryGroup>
        </Path.Data>
      </Path>
      <Path Name="PathFillColor2" Stretch="None" StrokeThickness="1" Style="{StaticResource HikArcPathStyle}" Opacity="1" Visibility="Visible" Cursor="SizeAll">
        <Path.Data>
          <GeometryGroup>
            <EllipseGeometry RadiusX="{Binding ElementName=userControl, Path=Radius}" RadiusY="{Binding ElementName=userControl, Path=Radius}" Center="{Binding ElementName=userControl, Path=MyCenterPoint}" />
          </GeometryGroup>
        </Path.Data>
      </Path>
      <Canvas Background="#00FFFFFF">
        <local:SquareArea x:Name="endAngle" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="YellowGreen" BorderAngle="{Binding ElementName=userControl, Path=EndAngle}" />
        <local:SquareArea x:Name="startAngle" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="YellowGreen" BorderAngle="{Binding ElementName=userControl, Path=StartAngle}" />
        <local:SquareArea x:Name="rec1" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="YellowGreen" />
        <local:SquareArea x:Name="radiusArrow" Opacity="1" Height="{DynamicResource mwidth}" Width="{DynamicResource mwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="Transparent" IsHitTestVisible="False" X="{Binding ElementName=userControl, Path=RadiusArrowPoint.X}" Y="{Binding ElementName=userControl, Path=RadiusArrowPoint.Y}" Angle="{Binding ElementName=userControl, Path=RadiusArrowAngle}">
          <local:SquareArea.SquareGeometry>
            <GeometryGroup>
              <PathGeometry>
                <PathFigure StartPoint="-3,0">
                  <LineSegment Point="3,3" />
                  <LineSegment Point="-3,6" />
                </PathFigure>
                <PathFigure StartPoint="6,0">
                  <LineSegment Point="12,3" />
                  <LineSegment Point="6,6" />
                </PathFigure>
              </PathGeometry>
            </GeometryGroup>
          </local:SquareArea.SquareGeometry>
        </local:SquareArea>
      </Canvas>
    </Canvas>
  </Border>
</local:HikROIBase>