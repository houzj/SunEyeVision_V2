<?xml version="1.0" encoding="utf-8"?>
<local:HikROIBase x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView.HikCircleCaliper" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView" xmlns:comm="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Name="userControl" Loaded="UserControl_Loaded" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave" MouseUp="UserControl_MouseUp" MouseLeftButtonDown="UserControl_MouseLeftButtonDown" Focusable="True" FocusVisualStyle="{x:Null}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VM.PcUI/imageview/roidictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:HikCoverCircleStyleConverter x:Key="hccStyleConverter" />
      <sys:Double x:Key="dwidth">8</sys:Double>
      <sys:Double x:Key="mwidth">32</sys:Double>
      <Style x:Key="squareAreaStyle" TargetType="{x:Type local:SquareArea}">
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsRadiusLimit, ElementName=userControl}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="bd" BorderThickness="1" Margin="-1" Style="{DynamicResource SelectedBorderStyle}">
    <Canvas Name="Gp">
      <TextBlock Name="tb" IsHitTestVisible="False" Foreground="{DynamicResource ROITextColor}" FontWeight="Bold" FontSize="14" Margin="3,3,0,0" Text="{Binding LableText, ElementName=userControl}" Canvas.Left="{Binding ElementName=rec1, Path=X}" Canvas.Top="{Binding ElementName=rec1, Path=Y}" />
      <Path Name="PathFillColor" Stretch="None" StrokeThickness="1" Opacity="1" Visibility="Visible" Cursor="SizeAll" Style="{Binding ROITypeUI, ElementName=userControl, Converter={StaticResource hccStyleConverter}}">
        <Path.Data>
          <GeometryGroup>
            <PathGeometry>
              <PathFigure IsClosed="False" StartPoint="{Binding ElementName=userControl, Path=StartPoint}">
                <ArcSegment Size="{Binding ElementName=userControl, Path=MaxSize}" Point="{Binding ElementName=userControl, Path=EndPoint}" IsLargeArc="{Binding ElementName=userControl, Path=IsLargeArc}" SweepDirection="{Binding ElementName=userControl, Path=ClockWise}" />
              </PathFigure>
            </PathGeometry>
          </GeometryGroup>
        </Path.Data>
      </Path>
      <Path Name="PathFillColor2" Stretch="None" StrokeThickness="1" Opacity="1" Cursor="SizeAll" Style="{Binding ROITypeUI, ElementName=userControl, Converter={StaticResource hccStyleConverter}}">
        <Path.Data>
          <GeometryGroup>
            <EllipseGeometry RadiusX="{Binding ElementName=userControl, Path=Radius}" RadiusY="{Binding ElementName=userControl, Path=Radius}" Center="{Binding ElementName=userControl, Path=MyCenterPoint}" />
          </GeometryGroup>
        </Path.Data>
      </Path>
      <Path Stretch="None" StrokeThickness="1" Opacity="0" Cursor="SizeAll" Style="{Binding ROITypeUI, ElementName=userControl, Converter={StaticResource hccStyleConverter}}">
        <Path.Data>
          <GeometryGroup>
            <EllipseGeometry RadiusX="{Binding ElementName=userControl, Path=CliperMaxRadius}" RadiusY="{Binding ElementName=userControl, Path=CliperMaxRadius}" Center="{Binding ElementName=userControl, Path=MyCenterPoint}" />
          </GeometryGroup>
        </Path.Data>
      </Path>
      <Canvas Background="#00FFFFFF">
        <local:SquareArea x:Name="moveRec2" Visibility="Collapsed" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Panel.ZIndex="1" />
        <local:SquareArea x:Name="moveRec1" Visibility="Collapsed" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="1" />
        <local:SquareArea x:Name="endAngle" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="YellowGreen" Panel.ZIndex="1" BorderAngle="{Binding ElementName=userControl, Path=EndAngle}" />
        <local:SquareArea x:Name="startAngle" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="YellowGreen" Panel.ZIndex="1" BorderAngle="{Binding ElementName=userControl, Path=StartAngle}" />
        <local:SquareArea x:Name="rec1" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="YellowGreen" Panel.ZIndex="1" />
        <local:SquareArea x:Name="rec2" Visibility="Collapsed" Opacity="0" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <local:SquareArea x:Name="startArrow" Visibility="Collapsed" Opacity="1" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="Transparent" IsHitTestVisible="False" X="{Binding ElementName=userControl, Path=StartArrowPoint.X}" Y="{Binding ElementName=userControl, Path=StartArrowPoint.Y}" Angle="{Binding ElementName=userControl, Path=StartArrowAngle}">
          <local:SquareArea.SquareGeometry>
            <GeometryGroup>
              <PathGeometry>
                <PathFigure StartPoint="0,0">
                  <LineSegment Point="6,6" />
                  <LineSegment Point="0,12" />
                </PathFigure>
              </PathGeometry>
            </GeometryGroup>
          </local:SquareArea.SquareGeometry>
        </local:SquareArea>
        <local:SquareArea x:Name="endArrow" Visibility="Collapsed" Opacity="1" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="Transparent" IsHitTestVisible="False" X="{Binding ElementName=userControl, Path=EndArrowPoint.X}" Y="{Binding ElementName=userControl, Path=EndArrowPoint.Y}" Angle="{Binding ElementName=userControl, Path=EndArrowAngle}">
          <local:SquareArea.SquareGeometry>
            <GeometryGroup>
              <PathGeometry>
                <PathFigure StartPoint="0,0">
                  <LineSegment Point="6,6" />
                  <LineSegment Point="0,12" />
                </PathFigure>
              </PathGeometry>
            </GeometryGroup>
          </local:SquareArea.SquareGeometry>
        </local:SquareArea>
        <local:SquareArea x:Name="radiusArrow" Visibility="Collapsed" Style="{StaticResource squareAreaStyle}" Opacity="1" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="Transparent" IsHitTestVisible="False" X="{Binding ElementName=userControl, Path=RadiusArrowPoint.X}" Y="{Binding ElementName=userControl, Path=RadiusArrowPoint.Y}" Angle="{Binding ElementName=userControl, Path=RadiusArrowAngle}">
          <local:SquareArea.SquareGeometry>
            <GeometryGroup>
              <PathGeometry>
                <PathFigure StartPoint="0,0">
                  <LineSegment Point="6,6" />
                  <LineSegment Point="0,12" />
                </PathFigure>
              </PathGeometry>
            </GeometryGroup>
          </local:SquareArea.SquareGeometry>
        </local:SquareArea>
        <local:SquareArea x:Name="minRadiusArrow" Visibility="Collapsed" Style="{StaticResource squareAreaStyle}" Opacity="1" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" SquareBordbrush="Transparent" IsHitTestVisible="False" X="{Binding ElementName=userControl, Path=MinRadiusArrowPoint.X}" Y="{Binding ElementName=userControl, Path=MinRadiusArrowPoint.Y}" Angle="{Binding ElementName=userControl, Path=RadiusArrowAngle}">
          <local:SquareArea.SquareGeometry>
            <GeometryGroup>
              <PathGeometry>
                <PathFigure StartPoint="0,0">
                  <LineSegment Point="6,6" />
                  <LineSegment Point="0,12" />
                </PathFigure>
              </PathGeometry>
            </GeometryGroup>
          </local:SquareArea.SquareGeometry>
        </local:SquareArea>
        <local:SquareArea x:Name="top_left" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
        <local:SquareArea x:Name="top_right" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
        <local:SquareArea x:Name="bottom_left" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
        <local:SquareArea x:Name="bottom_right" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
        <Border Name="box" Width="50" Height="50">
          <DockPanel>
            <Grid DockPanel.Dock="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <local:RectangleArea x:Name="top" Grid.Column="1" Opacity="0" VerticalAlignment="Top" Panel.ZIndex="1" />
            </Grid>
            <Grid DockPanel.Dock="Bottom">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <local:RectangleArea x:Name="bottom" Grid.Column="1" Opacity="0" VerticalAlignment="Bottom" Panel.ZIndex="1" />
            </Grid>
            <Grid DockPanel.Dock="Left">
              <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
              </Grid.RowDefinitions>
              <local:RectangleArea x:Name="left" Grid.RowSpan="2" Opacity="0" HorizontalAlignment="Left" Panel.ZIndex="1" />
            </Grid>
            <Grid DockPanel.Dock="Right">
              <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
              </Grid.RowDefinitions>
              <local:RectangleArea x:Name="right" Grid.RowSpan="2" Opacity="0" HorizontalAlignment="Right" Panel.ZIndex="1" />
            </Grid>
            <Rectangle Cursor="SizeAll" Fill="#00FFFFFF" />
          </DockPanel>
          <UIElement.RenderTransform>
            <RotateTransform x:Name="boxRt" />
          </UIElement.RenderTransform>
        </Border>
      </Canvas>
      <local:DrawingCanvas x:Name="drawCanvas" Top="0" Left="0" ZIndex="-1" IsHitTestVisible="True" />
    </Canvas>
  </Border>
</local:HikROIBase>