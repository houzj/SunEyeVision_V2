<?xml version="1.0" encoding="utf-8"?>
<local:HikROIBase x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView.HikCircleMeasure" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Name="circleControl" Loaded="circleControl_Loaded" MouseEnter="circleControl_MouseEnter" MouseLeave="circleControl_MouseLeave" MouseLeftButtonDown="UserControl_MouseLeftButtonDown" MouseLeftButtonUp="UserControl_MouseLeftButtonUp" Focusable="True" FocusVisualStyle="{x:Null}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VM.PcUI/imageview/roidictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <sys:Double x:Key="dwidth">8</sys:Double>
      <sys:Double x:Key="mwidth">32</sys:Double>
      <Style x:Key="EllipseStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Stroke" Value="{DynamicResource ROIBaseColor}" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static local:CustomROITypeUIEnum.Mul}" Binding="{Binding DataContext.Tag, ElementName=circleControl}">
            <Setter Property="FrameworkElement.ContextMenu" Value="{DynamicResource OperateMenu}" />
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True" Binding="{Binding IsSelected, ElementName=circleControl}" />
              <Condition Value="{x:Static local:CustomROITypeUIEnum.Mul}" Binding="{Binding DataContext.Tag, ElementName=circleControl}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Stroke" Value="{DynamicResource ROISelectedColor}" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Canvas Name="WorkView" Width="Auto" Height="Auto">
      <Ellipse Name="circle" StrokeThickness="1" Fill="#00FFFFFF" Style="{StaticResource EllipseStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="{Binding Width, ElementName=circleControl, Mode=TwoWay}" Height="{Binding Height, ElementName=circleControl, Mode=TwoWay}" />
      <local:MoveArea x:Name="Move" Opacity="1" Height="{DynamicResource mwidth}" Width="{DynamicResource mwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <local:SquareArea x:Name="rec1" Opacity="1" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <UIElement.RenderTransform>
        <TranslateTransform X="{Binding TLeftTopPoint.X, ElementName=circleControl, Mode=TwoWay}" Y="{Binding TLeftTopPoint.Y, ElementName=circleControl, Mode=TwoWay}" />
      </UIElement.RenderTransform>
    </Canvas>
  </Grid>
</local:HikROIBase>