<?xml version="1.0" encoding="utf-8"?>
<local:HikROIBase x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView.HikLineCaliper" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView" xmlns:control="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Name="userControl" MouseUp="UserControl_MouseUp" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave" Loaded="myControl_Loaded" MouseLeftButtonDown="UserControl_MouseLeftButtonDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VM.PcUI/imageview/roidictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <sys:Double x:Key="dwidth">8</sys:Double>
      <sys:Double x:Key="mwidth">32</sys:Double>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Canvas Name="WorkView">
    <control:Arrow x:Name="line" Stroke="{StaticResource ROIBaseColor}" Cursor="SizeAll" HeadHeight="6" HeadWidth="12" StrokeThickness="{Binding ElementName=userControl, Path=TStrokeThickness}" X1="{Binding X, ElementName=startpoint}" Y1="{Binding Y, ElementName=startpoint}" X2="{Binding X, ElementName=endpoint}" Y2="{Binding Y, ElementName=endpoint}" />
    <TextBlock Name="tb" IsHitTestVisible="False" Foreground="{DynamicResource ROITextColor}" FontWeight="Bold" FontSize="14" Margin="3,3,0,0" Text="{Binding LableText, ElementName=userControl}" Canvas.Left="{Binding X, ElementName=startpoint}" Canvas.Top="{Binding Y, ElementName=startpoint}" />
    <local:SquareArea x:Name="startpoint" Opacity="0" SquareBordbrush="YellowGreen" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
    <local:SquareArea x:Name="endpoint" Opacity="0" SquareBordbrush="YellowGreen" Height="{DynamicResource dwidth}" Width="{DynamicResource dwidth}" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
    <local:SquareArea x:Name="top_left" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
    <local:SquareArea x:Name="top_right" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
    <local:SquareArea x:Name="bottom_left" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
    <local:SquareArea x:Name="bottom_right" Width="{StaticResource dwidth}" Height="{StaticResource dwidth}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" />
    <Border Name="box" Width="50" Height="50">
      <DockPanel>
        <Grid DockPanel.Dock="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
          </Grid.ColumnDefinitions>
          <local:RectangleArea x:Name="top" Grid.Column="1" Opacity="0" VerticalAlignment="Top" Panel.ZIndex="1" />
        </Grid>
        <Grid DockPanel.Dock="Bottom">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
          </Grid.ColumnDefinitions>
          <local:RectangleArea x:Name="bottom" Grid.Column="1" Opacity="0" VerticalAlignment="Bottom" Panel.ZIndex="1" />
        </Grid>
        <Grid DockPanel.Dock="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <local:RectangleArea x:Name="left" Grid.RowSpan="2" Opacity="0" HorizontalAlignment="Left" Panel.ZIndex="1" />
          <Path Name="TarrowView0" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Stroke="{DynamicResource ROIBaseColor}" StrokeThickness="2" Fill="#00FFFFFF" Stretch="Uniform">
            <Path.Data>
              <GeometryGroup>
                <PathGeometry>
                  <PathFigure StartPoint="0,0">
                    <LineSegment Point="-6,6" />
                    <LineSegment Point="-12,0" />
                  </PathFigure>
                </PathGeometry>
              </GeometryGroup>
            </Path.Data>
          </Path>
        </Grid>
        <Grid DockPanel.Dock="Right">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <local:RectangleArea x:Name="right" Grid.RowSpan="2" Opacity="0" HorizontalAlignment="Right" Panel.ZIndex="1" />
          <Path Name="TarrowView1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Stroke="{DynamicResource ROIBaseColor}" StrokeThickness="2" Fill="#00FFFFFF" Stretch="Uniform">
            <Path.Data>
              <GeometryGroup>
                <PathGeometry>
                  <PathFigure StartPoint="0,0">
                    <LineSegment Point="-6,6" />
                    <LineSegment Point="-12,0" />
                  </PathFigure>
                </PathGeometry>
              </GeometryGroup>
            </Path.Data>
          </Path>
        </Grid>
        <Rectangle Cursor="SizeAll" Fill="#00FFFFFF" />
      </DockPanel>
      <UIElement.RenderTransform>
        <RotateTransform x:Name="boxRt" />
      </UIElement.RenderTransform>
    </Border>
    <local:DrawingCanvas x:Name="drawCanvas" Top="0" Left="0" ZIndex="-1" IsHitTestVisible="True" Cursor="SizeAll" />
  </Canvas>
</local:HikROIBase>