using System;
using System.ComponentModel;
using System.Windows.Media;
using SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView;

namespace SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Models;

public class HikShowCrossModel : INotifyPropertyChanged
{
	private HikImageView m_imageView;

	private int m_imageWidth;

	private int m_imageHeight;

	private double m_thick = 1.0;

	private Brush m_fillbrush;

	private int m_percentW;

	private int m_percentH;

	private int m_width;

	private int m_height;

	private double offsetX;

	private double offsetY;

	public Brush ColorBrush
	{
		get
		{
			return m_fillbrush;
		}
		set
		{
			m_fillbrush = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("ColorBrush"));
		}
	}

	public int Width
	{
		get
		{
			return m_width;
		}
		set
		{
			m_width = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("Width"));
		}
	}

	public int Height
	{
		get
		{
			return m_height;
		}
		set
		{
			m_height = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("Height"));
		}
	}

	public int PercentOfWidth
	{
		get
		{
			return m_percentW;
		}
		set
		{
			m_percentW = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("PercentOfWidth"));
			if (m_imageView != null)
			{
				Width = (int)((double)(m_percentW * m_imageWidth / 100) * m_imageView.Radio);
			}
		}
	}

	public int PercentOfHeight
	{
		get
		{
			return m_percentH;
		}
		set
		{
			m_percentH = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("PercentOfHeight"));
			if (m_imageView != null)
			{
				Height = (int)((double)(m_percentH * m_imageHeight / 100) * m_imageView.Radio);
			}
		}
	}

	public double Thickness
	{
		get
		{
			return m_thick;
		}
		set
		{
			m_thick = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("Thickness"));
		}
	}

	public double OffsetX
	{
		get
		{
			return offsetX;
		}
		set
		{
			offsetX = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("OffsetX"));
		}
	}

	public double OffsetY
	{
		get
		{
			return offsetY;
		}
		set
		{
			offsetY = value;
			Fire(PropertyChanged, this, new PropertyChangedEventArgs("OffsetY"));
		}
	}

	public event PropertyChangedEventHandler PropertyChanged;

	public HikShowCrossModel(HikImageView imageView)
	{
		m_imageView = imageView;
		m_imageHeight = imageView.ImageSourceHeight;
		m_imageWidth = imageView.ImageSourceWidth;
		m_fillbrush = new SolidColorBrush(Colors.Red);
		m_percentH = 10;
		m_percentW = 10;
		Thickness = 1.0;
		if (m_imageView != null)
		{
			Height = (int)((double)(m_percentH * m_imageHeight / 100) * m_imageView.Radio);
			Width = (int)((double)(m_percentW * m_imageWidth / 100) * m_imageView.Radio);
		}
	}

	public HikShowCrossModel()
	{
		m_imageHeight = 0;
		m_imageWidth = 0;
		m_fillbrush = new SolidColorBrush(Colors.Red);
		m_percentH = 10;
		m_percentW = 10;
		Height = 10;
		Width = 10;
		Thickness = 1.0;
	}

	public static void Fire(Delegate delegate1, params object[] paramObjects)
	{
		delegate1?.DynamicInvoke(paramObjects);
	}
}
