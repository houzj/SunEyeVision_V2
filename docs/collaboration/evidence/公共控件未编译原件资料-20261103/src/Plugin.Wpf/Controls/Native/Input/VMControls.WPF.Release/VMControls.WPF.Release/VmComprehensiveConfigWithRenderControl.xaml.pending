<?xml version="1.0" encoding="utf-8"?>
<local:VMWpfUserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.VmComprehensiveConfigWithRenderControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release" xmlns:vmWpf="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" x:Name="us">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <vmWpf:ComprehensiveConfigWithRenderControlBase Name="prControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SolutionSource="{Binding SolutionSource, ElementName=us}" ParamsConfigSource="{Binding ParamsConfig, ElementName=us}" />
  </ScrollViewer>
</local:VMWpfUserControl>