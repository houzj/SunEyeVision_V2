<Project>
  <!-- Machine-specific portable PowerShell paths do not belong in source control. -->
  <Import Project="$(MSBuildThisFileDirectory)Release.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Release.Local.props')" />
  <PropertyGroup>
    <ReleasePowerShellPath Condition="'$(ReleasePowerShellPath)'=='' And Exists('$(ProgramW6432)\PowerShell\7\pwsh.exe')">$(ProgramW6432)\PowerShell\7\pwsh.exe</ReleasePowerShellPath>
    <ReleasePowerShellPath Condition="'$(ReleasePowerShellPath)'=='' And Exists('$(ProgramFiles)\PowerShell\7\pwsh.exe')">$(ProgramFiles)\PowerShell\7\pwsh.exe</ReleasePowerShellPath>
    <ReleasePowerShellPath Condition="'$(ReleasePowerShellPath)'==''">pwsh</ReleasePowerShellPath>
  </PropertyGroup>
  <Target Name="ResolveReleasePowerShell">
    <Error Condition="'$(ReleasePowerShellPath)'!='pwsh' And !Exists('$(ReleasePowerShellPath)')"
           Text="PowerShell 7 路径不存在：$(ReleasePowerShellPath)。请修正 installer/Release.Local.props 中的 ReleasePowerShellPath。" />
    <Message Importance="High" Text="Release PowerShell: $(ReleasePowerShellPath)" />
  </Target>
  <!-- Capture SDK facts, including publish conflict winners, before signing. These
       build inputs stay outside app; Release.Common seals the final bytes once. -->
  <Target Name="CaptureReleaseFrameworkOrigin" AfterTargets="ComputeFilesToPublish"
          Condition="'$(MSBuildProjectName)'=='SunEyeVision.UI' And '$(DesignTimeBuild)'!='true'">
    <PropertyGroup>
      <ReleaseFrameworkOriginPath Condition="'$(ReleaseFrameworkOriginPath)'==''">$(IntermediateOutputPath)release-framework-origin.tsv</ReleaseFrameworkOriginPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(ReleaseFrameworkOriginPath)" Overwrite="true"
                      Lines="@(RuntimeFramework->'framework|%(Identity)|%(Version)|%(FrameworkName)|%(Profile)')" />
    <WriteLinesToFile File="$(ReleaseFrameworkOriginPath)" Overwrite="false"
                      Lines="@(RuntimePackAsset->'asset|%(FullPath)|%(DestinationSubPath)|%(NuGetPackageId)|%(NuGetPackageVersion)')" />
    <WriteLinesToFile File="$(ReleaseFrameworkOriginPath)" Overwrite="false"
                      Lines="@(ResolvedFileToPublish->'winner|%(FullPath)|%(RelativePath)')" />
  </Target>

  <Target Name="SealDevelopmentReleasePayload" AfterTargets="Build" DependsOnTargets="ResolveReleasePowerShell"
          Condition="'$(MSBuildProjectName)'=='SunEyeVision.UI' And '$(SelfContained)'!='true' And '$(DesignTimeBuild)'!='true' And '$(BuildingProject)'!='false'">
    <PropertyGroup>
      <_ReleaseSealSourceArgument Condition="'$(SourceRevisionId)'!=''">-SourceCommit &quot;$(SourceRevisionId)&quot;</_ReleaseSealSourceArgument>
    </PropertyGroup>
    <Exec Command="&quot;$(ReleasePowerShellPath)&quot; -NoProfile -File &quot;$(MSBuildThisFileDirectory)Seal-ReleasePayload.ps1&quot; -AppPath &quot;$(OutDir).&quot; $(_ReleaseSealSourceArgument)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_ReleaseSealExitCode" />
    </Exec>
    <Error Condition="'$(_ReleaseSealExitCode)'=='9009'"
           Text="构建进程找不到 PowerShell 7。请安装 PowerShell 7 并重新打开 VS，或在 installer/Release.Local.props 配置 ReleasePowerShellPath。" />
    <Error Condition="'$(_ReleaseSealExitCode)'!='0'" Text="Release 载荷封装失败，退出码 $(_ReleaseSealExitCode)。请查看上方脚本输出。" />
  </Target>
</Project>
