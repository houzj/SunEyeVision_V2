<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SunEyeVision.Plugin.SDK</RootNamespace>
    <AssemblyName>SunEyeVision.Plugin.SDK</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\SunEyeVision.Plugin.SDK.xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet包配置 -->
    <PackageId>SunEyeVision.Plugin.SDK</PackageId>
    <!-- SDK 随产品交付时使用产品版本；开发包版本由 Directory.Build.props 从 version.json 注入。 -->
    <Authors>SunEyeVision Team</Authors>
    <Company>SunEyeVision</Company>
    <Product>SunEyeVision Plugin SDK</Product>
    <Description>SunEyeVision Windows 插件 SDK，提供现行工作流、图像及运行支持合同。</Description>
    <Copyright>Copyright (c) 2026 SunEyeVision</Copyright>
    <PackageTags>vision;plugin;sdk;machine-vision;image-processing;wpf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 包输出配置 -->
    <PackageOutputPath>$(SolutionDir)nupkg\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- 源码链接支持 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SunEyeVision.Tool.Script" />
    <ProjectReference Include="../Tool.Kernels/SunEyeVision.Tool.Kernels.csproj" />
    <ProjectReference Include="../Plugin.Runtime/SunEyeVision.Plugin.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup><None Update="README.md" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Metadata\ToolGroups.xml" LogicalName="SunEyeVision.Plugin.SDK.Metadata.ToolGroups.xml" /></ItemGroup>
  <ItemGroup>
    <!-- Group/循环迁移暂停，源码保留但不纳入产品编译。 -->
    <Compile Remove="Execution/Parameters/SubroutineParameters.cs;Execution/Parameters/ISubroutineDebugService.cs;Execution/Parameters/SubroutineDebugServiceProvider.cs;Models/SubroutineLoopConfig.cs" />
  </ItemGroup>
</Project>
