<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.ImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
             Loaded="OnLoaded">
    
    <UserControl.Resources>
        <!-- 深色工具栏按钮样式 -->
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="IconContent"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                            <!-- 底部高亮指示器 -->
                            <Border x:Name="BottomIndicator"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Width="0"
                                    Background="{DynamicResource {x:Static themes:SdkThemeKeys.AccentBrush}}"
                                    CornerRadius="1"
                                    Margin="0,0,0,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ControlHoverBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextOnDarkBrush}}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.AccentBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextOnDarkBrush}}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextDisabledBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- 工具栏分隔线样式 -->
        <Style x:Key="ToolBarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- 工具栏下拉框样式 - 黑底白字 -->
        <Style x:Key="ToolBarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:SdkThemeKeys.InputBorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectionBoxItem}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="{TemplateBinding Padding}"
                                          Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                                  VerticalAlignment="Center"
                                                                                  TextElement.Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"
                                                                                  TextElement.FontSize="12"/>
                                                            <Path Grid.Column="1"
                                                                  Margin="6,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                                  Fill="{DynamicResource {x:Static themes:SdkThemeKeys.TextSecondaryBrush}}"
                                                                  Stretch="Uniform"
                                                                  Width="8" Height="5"
                                                                  x:Name="Arrow"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ControlHoverBackgroundBrush}}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ControlSelectedBackgroundBrush}}"/>
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value><ScaleTransform ScaleY="-1"/></Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              Visibility="Collapsed"/>
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200"
                                        Background="{DynamicResource {x:Static themes:SdkThemeKeys.ContextMenuBackgroundBrush}}"
                                        BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.InputBorderBrush}}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="2">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉列表项样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ContextMenuBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ControlHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.AccentBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextOnDarkBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border x:Name="ToolBar" Grid.Row="0" 
                Background="{DynamicResource {x:Static themes:SdkThemeKeys.ToolBarBackgroundBrush}}"
                Padding="4,2" 
                Height="32"
                BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- 左侧：图像源选择 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ComboBox x:Name="ImageSourceSelector" 
                              Width="160" Margin="0"
                              Style="{StaticResource ToolBarComboBoxStyle}"
                              SelectionChanged="ImageSourceSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DropdownDisplayText}" 
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding SourceNodeId}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- 右侧：缩放和全屏控制 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- 放大 - ZoomIn图标 -->
                    <Button Content="&#xE8A3;" 
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="ZoomIn_Click" ToolTip="放大 (Ctrl++)"/>
                    <!-- 缩小 - ZoomOut图标 -->
                    <Button Content="&#xE71F;" 
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="ZoomOut_Click" ToolTip="缩小 (Ctrl+-)"/>
                    <!-- 适应窗口 - 使用Unicode比例符号 -->
                    <Button Style="{StaticResource ToolBarButtonStyle}"
                            Click="FitToWindow_Click" ToolTip="适应窗口 (Ctrl+0)">
                        <TextBlock Text="1&#x2236;1" 
                                   FontFamily="Segoe UI"
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Border Style="{StaticResource ToolBarSeparator}"/>

                    <!-- 全屏 - 全屏图标 -->
                    <Button x:Name="FullscreenButton" 
                            Content="&#xE740;" 
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="ToggleFullscreen_Click" ToolTip="全屏 (F11)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 图像显示区域 - 使用Canvas实现平移缩放 -->
        <Grid Grid.Row="1">
            <!-- 棋盘格背景层 - 透明度指示：整体 DrawingBrush（随主题整体替换），SDK 层用字符串 key 引用 UI 主题字典 -->
            <Grid x:Name="ChessboardLayer" Background="{DynamicResource {x:Static themes:SdkThemeKeys.CheckerboardBackgroundBrush}}"/>

            <Canvas x:Name="MainCanvas"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseWheel="MainCanvas_MouseWheel"
                    MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                    MouseMove="MainCanvas_MouseMove"
                    MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                    SizeChanged="MainCanvas_SizeChanged">

            <!-- 图像容器 -->
            <Grid x:Name="ImageContainer"
                  Background="Transparent">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScaleTransform"/>
                        <TranslateTransform x:Name="ImageTranslateTransform"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="DisplayImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <!-- Layer 1: 算法结果层（DrawingContext渲染，高性能） -->
                <local:ResultRenderLayer x:Name="ResultRenderLayer"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"/>

                <!-- Layer 2: ROI 交互层（顶层，调试窗口生命周期） -->
                <Canvas x:Name="InteractionOverlayCanvas"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"/>
            </Grid>
        </Canvas>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar x:Name="StatusBar" Grid.Row="2" 
                   Background="{DynamicResource {x:Static themes:SdkThemeKeys.StatusBarBackgroundBrush}}"
                   Padding="8,2"
                   BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.StatusBarBorderBrush}}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="PositionText" 
                           Text="位置: (0, 0)" 
                           Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"
                           FontSize="11"/>
            </StatusBarItem>
            <Separator Background="{DynamicResource {x:Static themes:SdkThemeKeys.StatusBarBorderBrush}}"/>
            <StatusBarItem>
                <TextBlock x:Name="ImageSizeText" 
                           Text="图像: -" 
                           Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"
                           FontSize="11"/>
            </StatusBarItem>
            <Separator Background="{DynamicResource {x:Static themes:SdkThemeKeys.StatusBarBorderBrush}}"/>
            <StatusBarItem>
                <TextBlock x:Name="PixelValueText" 
                           Text="灰度: -" 
                           Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"
                           FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
