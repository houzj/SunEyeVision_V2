<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.Measure.Views.MeasureEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
             xmlns:measure="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Measure.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 检测区域 - 上下两行（类型标签一行 + 卡尺类型工具栏一行），对齐 RoiEditorControl 的"模式切换 + 形状工具栏"布局 -->
    <StackPanel>
        <!-- 类型标签（检测区域 - 检测蓝，对齐 RoiEditorControl 的 RegionTypeTitle） -->
        <Border CornerRadius="6" Background="{DynamicResource {x:Static themes:SdkThemeKeys.ToolBarBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
                BorderThickness="1" Padding="3" Margin="0,0,0,8">
            <StackPanel>
                <Border CornerRadius="4" Padding="8,3" Margin="4,0,4,4"
                        Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
                        BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.AccentBrush}}"
                        BorderThickness="1"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding EditorHeader, RelativeSource={RelativeSource AncestorType=measure:MeasureEditorControl}}"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.AccentBrush}}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 卡尺类型工具栏 -->
        <Border CornerRadius="6" Background="{DynamicResource {x:Static themes:SdkThemeKeys.ToolBarBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
                BorderThickness="1" Padding="3">
            <measure:MeasureToolBar x:Name="MeasureToolBarControl"
                                    HorizontalAlignment="Center"
                                    MeasureSelectionChanged="OnMeasureSelectionChanged"/>
        </Border>
    </StackPanel>
</UserControl>
