<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.Measure.Views.MeasurementEditorManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="clr-namespace:SunEyeVision.Plugin.SDK.UI.Constants"
             xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Views"
             xmlns:measure="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Measure.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- ★ 修复 StaticResource 异常：L24 Visibility 绑定需要 BooleanToVisibilityConverter（对齐 RoiEditorControl.xaml） -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <!-- 测量卡尺引导 -->
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{x:Static constants:ColorConstants.InspectionBlueBrush}" Padding="8" Margin="0,0,0,8">
            <measure:MeasureEditorControl x:Name="guideEditor"/>
        </Border>

        <!-- 引导几何参数面板（对齐 ROI 端 RoiEditorControl.xaml 的 Expander 范式：
             IsExpanded 默认 False（有引导几何时折叠，可手动展开查看参数）；
             Visibility 由 GuideGeometryVisible 控制（有引导几何时显示，对应 ROI 端 HasParametersVisible）） -->
        <Expander Header="引导几何参数" Margin="0,0,0,8" IsExpanded="False"
                  Visibility="{Binding GuideGeometryVisible, RelativeSource={RelativeSource AncestorType=measure:MeasurementEditorManagerControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                  BorderBrush="{x:Static constants:ColorConstants.InspectionBlueBrush}" BorderThickness="1">
            <!-- ★ Editor 在代码里直接关联（XAML Binding GuideEditor 会解析到 DataContext 而非控件属性，导致 Editor=null 面板空白） -->
            <measure:MeasureGuideParameterPanel x:Name="guideParameterPanel"/>
        </Expander>

        <!-- 屏蔽区域 - 橙色主题（复用 RoiEditorControl 多 ROI 能力） -->
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{x:Static constants:ColorConstants.MaskOrangeBrush}" Padding="8">
            <region:RoiEditorControl x:Name="maskEditor"
                                     DefaultRegionType="Mask"
                                     VerticalContentAlignment="Stretch"
                                     Height="auto"/>
        </Border>
    </StackPanel>
</UserControl>
