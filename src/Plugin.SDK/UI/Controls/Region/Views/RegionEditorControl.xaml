<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.Region.Views.RegionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views"
             xmlns:models="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Models"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 卡片区域样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0">

                <!-- 标题 + 模式切换（同一行） -->
                <Border CornerRadius="6" Background="#F0F0F0" BorderBrush="#DDD"
                        BorderThickness="1" Padding="3" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderTextBlock" Grid.Column="0"
                                   Text="{Binding HeaderText, ElementName=Root}"
                                   FontWeight="{Binding HeaderFontWeight, ElementName=Root}"
                                   Foreground="{Binding HeaderForeground, ElementName=Root}"
                                   VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <UniformGrid Grid.Column="1" Columns="2" HorizontalAlignment="Right">
                            <RadioButton Content="绘制"
                                         ToolTip="手动绘制区域形状"
                                         FontSize="12"
                                         FontWeight="Medium"
                                         HorizontalContentAlignment="Center"
                                         Padding="16,6"
                                         Style="{StaticResource SegmentedToggleStyle}"
                                         IsChecked="{Binding IsDrawingMode, Mode=TwoWay}"/>
                            <RadioButton Content="订阅"
                                         ToolTip="订阅其他节点输出的区域"
                                         FontSize="12"
                                         FontWeight="Medium"
                                         HorizontalContentAlignment="Center"
                                         Padding="16,6"
                                         Style="{StaticResource SegmentedToggleStyle}"
                                         IsChecked="{Binding IsSubscribeMode, Mode=TwoWay}"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- 形状选择（绘制模式显示） -->
                <local:ShapeSelectorControl x:Name="ShapeSelector"
                    Visibility="{Binding ShowShapeTypeSelector, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- 参数面板 - 绘制模式 -->
                <Expander Header="绘制参数"
                          Visibility="{Binding HasParametersVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsExpanded="False"
                          Margin="0,0,0,12">
                    <local:DrawingParameterPanel DataContext="{Binding}"/>
                </Expander>

                <!-- 参数面板 - 订阅模式 -->
                <Expander Header="参数订阅"
                          Visibility="{Binding IsSubscribeMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsExpanded="True"
                          Margin="0,0,0,12">
                    <local:RegionSubscribePanel DataContext="{Binding ParameterPanel}"
                                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource AncestorType={x:Type local:RegionEditorControl}}}"/>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
