<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.Region.Views.RegionEditorManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <!-- 检测区域 -->
        <region:RegionEditorControl x:Name="inspectionsEditor"
                                    HeaderText="检测区域"
                                    HeaderForeground="#4488FF"
                                    DefaultRegionType="Inspection"
                                    Margin="0,0,0,4"/>

        <!-- 屏蔽区域 -->
        <region:RegionEditorControl x:Name="masksEditor"
                                    HeaderText="屏蔽区域"
                                    HeaderForeground="#FFA500"
                                    DefaultRegionType="Mask"/>

    </StackPanel>
</UserControl>
