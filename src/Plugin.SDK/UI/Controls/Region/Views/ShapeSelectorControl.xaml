<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.Region.Views.ShapeSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 紧凑按钮样式 -->
            <Style x:Key="CompactShapeButtonStyle" TargetType="Button" BasedOn="{StaticResource ShapeButtonStyle}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <WrapPanel x:Name="ButtonPanel" HorizontalAlignment="Center" Orientation="Horizontal">
        <Button x:Name="RectangleButton" Style="{StaticResource CompactShapeButtonStyle}"
                ToolTip="矩形 (R)" Click="OnRectangleClick">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource ShapeIconBrush}"
                  StrokeThickness="1.5" Fill="Transparent"
                  Data="M2,1 L14,1 L14,15 L2,15 Z"/>
        </Button>
        <Button x:Name="CircleButton" Style="{StaticResource CompactShapeButtonStyle}"
                ToolTip="圆形 (C)" Click="OnCircleClick">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource ShapeIconBrush}"
                  StrokeThickness="1.5" Fill="Transparent"
                  Data="M8,1 A7,7 0 1,0 8,15 A7,7 0 1,0 8,1 Z"/>
        </Button>
        <Button x:Name="RotatedRectangleButton" Style="{StaticResource CompactShapeButtonStyle}"
                ToolTip="旋转矩形 (O)" Click="OnRotatedRectangleClick">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource ShapeIconBrush}"
                  StrokeThickness="1.5" Fill="Transparent"
                  Data="M3,3 L13,5 L11,14 L1,12 Z"/>
        </Button>
        <Button x:Name="LineButton" Style="{StaticResource CompactShapeButtonStyle}"
                ToolTip="直线 (L)" Click="OnLineClick">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource ShapeIconBrush}"
                  StrokeThickness="1.5" Fill="Transparent"
                  Data="M2,14 L14,2"/>
        </Button>
        <Button x:Name="PolygonButton" Style="{StaticResource CompactShapeButtonStyle}"
                ToolTip="多边形 (P)" Click="OnPolygonClick">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource ShapeIconBrush}"
                  StrokeThickness="1.5" Fill="Transparent"
                  Data="M8,1 L14,4 L14,12 L8,15 L2,12 L2,4 Z"/>
        </Button>
    </WrapPanel>
</UserControl>