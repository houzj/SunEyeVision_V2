<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.ResultPresentation.GraphicsDisplayEditorControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls"
             xmlns:component="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource x:Key="OrderedItems" Source="{Binding ItemsSource, ElementName=Root}">
            <CollectionViewSource.SortDescriptions>
                <component:SortDescription PropertyName="Order" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Expander Header="图形显示" IsExpanded="True" Margin="0,8,0,0"
              BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
              BorderThickness="1">
    <ItemsControl Margin="16,8" ItemsSource="{Binding Source={StaticResource OrderedItems}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:LabeledControl Label="{Binding Name}" ContentHorizontalAlignment="Left" Margin="0,2">
                    <controls:DispItemColorControl Item="{Binding Style, Mode=TwoWay}"
                                                   ContentHorizontalAlignment="Left"/>
                </controls:LabeledControl>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Expander>
</UserControl>
