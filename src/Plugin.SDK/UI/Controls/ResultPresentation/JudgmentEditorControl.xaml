<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.ResultPresentation.JudgmentEditorControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls"
             xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Converters"
             xmlns:component="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:JudgmentRangeVisibilityConverter x:Key="RangeVisibilityConverter"/>
        <CollectionViewSource x:Key="OrderedItems" Source="{Binding ItemsSource, ElementName=Root}">
            <CollectionViewSource.SortDescriptions>
                <component:SortDescription PropertyName="Order" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Expander Header="结果判断" IsExpanded="True" Margin="0,8,0,0"
              BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
              BorderThickness="1">
    <ItemsControl Margin="16,8" ItemsSource="{Binding Source={StaticResource OrderedItems}}">
        <ItemsControl.GroupStyle>
            <GroupStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="0,2,0,6">
                    <controls:LabeledControl Label="{Binding Name}" ContentHorizontalAlignment="Left">
                        <controls:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}"
                                               SwitchWidth="44" SwitchHeight="22"/>
                    </controls:LabeledControl>
                    <controls:LabeledControl Label="范围" Margin="0,2,0,0" d:Visibility="Visible">
                        <controls:LabeledControl.Visibility>
                            <MultiBinding Converter="{StaticResource RangeVisibilityConverter}">
                                <Binding Path="Enabled"/>
                                <Binding Path="RuleKind"/>
                            </MultiBinding>
                        </controls:LabeledControl.Visibility>
                        <controls:RangeInputControl MinValue="{Binding Min, Mode=TwoWay}"
                                                    MaxValue="{Binding Max, Mode=TwoWay}"
                                                    Minimum="{Binding AllowedMinimum}"
                                                    Maximum="{Binding AllowedMaximum}"
                                                    Unit="{Binding Unit}"
                                                    DecimalPlaces="{Binding DecimalPlaces}"
                                                    NumericWidth="120"
                                                    HorizontalAlignment="Left"/>
                    </controls:LabeledControl>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Expander>
</UserControl>
