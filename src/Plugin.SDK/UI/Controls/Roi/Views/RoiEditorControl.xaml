<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Views.RoiEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
             xmlns:local="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Views"
             xmlns:models="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Models"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 卡片区域样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0">

                <!-- 模式切换（绘制/订阅）+ 区域类型标识 -->
                <Border CornerRadius="6" Background="{DynamicResource {x:Static themes:SdkThemeKeys.ToolBarBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
                        BorderThickness="1" Padding="3" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 区域类型标签（颜色/文本由 DefaultRegionType 驱动） -->
                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="4,0"
                                Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
                                BorderBrush="{Binding RegionTypeTitleBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding RegionTypeTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding RegionTypeTitleBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>
                        <!-- 模式切换 -->
                        <UniformGrid Grid.Column="1" Columns="2" HorizontalAlignment="Center">
                            <RadioButton Content="绘制"
                                         Style="{StaticResource SegmentedToggleStyle}"
                                         IsChecked="{Binding IsDrawingMode, Mode=TwoWay}"/>
                            <RadioButton Content="订阅"
                                         Style="{StaticResource SegmentedToggleStyle}"
                                         IsChecked="{Binding IsSubscribeMode, Mode=TwoWay}"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- 形状选择工具栏（仅绘制模式可见）-->
                <Border CornerRadius="6" Background="{DynamicResource {x:Static themes:SdkThemeKeys.ToolBarBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
                        BorderThickness="1" Padding="3" Margin="0,0,0,12"
                        x:Name="ShapeSelectorPanel"
                        Visibility="{Binding ShowShapeTypeSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- 形状工具 - 数据驱动的 ShapeToolBar -->
                        <local:ShapeToolBar x:Name="ShapeToolBarControl"/>
                    </StackPanel>
                </Border>

                <!-- 参数面板 - 绘制模式（仅绘制模式且选中区域带本地几何时显示） -->
                <Expander Header="绘制参数"
                          Visibility="{Binding HasDrawingParametersVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsExpanded="False"
                          Margin="0,0,0,12">
                    <local:DrawingParameterPanel DataContext="{Binding}"/>
                </Expander>

                <!-- 参数面板 - 订阅模式 -->
                <Expander Header="参数订阅"
                          Visibility="{Binding IsSubscribeMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsExpanded="True"
                          Margin="0,0,0,12">
                    <local:RoiSubscribePanel DataContext="{Binding ParameterPanel}"
                                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource AncestorType={x:Type local:RoiEditorControl}}}"/>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
