<UserControl x:Class="SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Views.RoiSubscribePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Views"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls"
             xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Converters"
             xmlns:va="clr-namespace:SunEyeVision.Plugin.SDK.Vision.Contracts"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"/>
        </Style>
    </UserControl.Resources>

    <!-- 根 Grid 直接继承父级 DataContext（ParameterPanel），修复旧版自绑 SubscribeViewModel 导致的接线断裂 -->
    <StackPanel Margin="2">
        <TextBlock Text="区域订阅面板"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,12"/>

        <!-- 订阅方式选择 -->
        <GroupBox Header="订阅方式" Margin="0,0,0,12">
            <UniformGrid Columns="2" Margin="8">
                <RadioButton Content="订阅整个区域"
                             GroupName="SubscribeSubMode"
                             IsChecked="{Binding IsWholeRegionMode, Mode=TwoWay}"
                             Checked="WholeRegionRadio_Checked"
                             Margin="0,0,0,8"/>
                <RadioButton Content="订阅几何参数"
                             GroupName="SubscribeSubMode"
                             IsChecked="{Binding IsGeometricMode, Mode=TwoWay}"
                             Checked="GeometricRadio_Checked"
                             Margin="0,0,0,8"/>
            </UniformGrid>
        </GroupBox>

        <!-- 整区域订阅 -->
        <GroupBox Header="区域源" Margin="0,0,0,12"
                  Visibility="{Binding IsWholeRegionMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Margin="2">
                <controls:LabeledControl Label="区域源" LabelWidth="70" Margin="0,0,0,4">
                    <controls:ParamBinding x:Name="WholeRegionBinding"
                                           Width="200"
                                           ParameterName="WholeRegion"
                                           BindingSource="{Binding WholeRegionBindingPath, Mode=OneWay}"
                                           AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RoiSubscribePanel}}}"/>
                </controls:LabeledControl>
                <!-- 引导：字段级绑定需切换到「订阅几何参数」模式 -->
                <TextBlock Margin="78,2,0,0" FontStyle="Italic" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="字段级绑定（如圆心X/宽/角度）请切换到「订阅几何参数」" />
            </StackPanel>
        </GroupBox>

        <!-- 几何参数订阅 -->
        <GroupBox Header="几何参数" Margin="0,0,0,12"
                  Visibility="{Binding IsGeometricMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Margin="2">
                <ComboBox ItemsSource="{Binding AvailableShapeTypes}"
                          SelectedItem="{Binding CurrentShapeType}"
                          Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:LabeledControl Label="{Binding DisplayName}" LabelWidth="70" Margin="0,0,0,8">
                                <controls:ParamBinding Width="200"
                                                       ParameterName="{Binding ParameterName}"
                                                       DataType="{Binding DataType}"
                                                       BindingSource="{Binding BindingPath, Mode=TwoWay}"
                                                       AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RoiSubscribePanel}}}"/>
                            </controls:LabeledControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
