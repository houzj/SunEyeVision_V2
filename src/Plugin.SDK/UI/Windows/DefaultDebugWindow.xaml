<Window x:Class="SunEyeVision.Plugin.SDK.UI.Windows.DefaultDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands"
        xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes"
        xmlns:local="clr-namespace:SunEyeVision.Plugin.SDK.UI.Windows"
        xmlns:icons="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Icons"
        Title="工具调试窗口"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="300" MinHeight="450"
        Width="400" Height="550"
        WindowChrome.WindowChrome="{x:Static local:DefaultDebugWindow.DebugWindowChrome}">

    <!-- 窗口命令绑定 -->
    <Window.CommandBindings>
        <CommandBinding Command="commands:ToolCommands.Execute"
                        Executed="OnExecuteCommand"
                        CanExecute="CanExecuteCommand"/>
        <CommandBinding Command="commands:ToolCommands.Confirm"
                        Executed="OnConfirmCommand"/>
        <CommandBinding Command="commands:ToolCommands.ContinuousExecute"
                        Executed="OnContinuousExecuteCommand"
                        CanExecute="CanExecuteCommand"/>
    </Window.CommandBindings>

    <!-- 调试窗口底部按钮样式：显式引用，带主题悬停触发器（元素级 Background 优先级高于样式触发器，故用显式样式统一管理） -->
    <Window.Resources>
        <Style x:Key="DebugToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonTextBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonBorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonHoverBackgroundBrush}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonHoverBackgroundBrush}}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonPressedBackgroundBrush}}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:SdkThemeKeys.TextDisabledBrush}}"/>
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:SdkThemeKeys.ButtonDisabledBackgroundBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 外层容器：主题化背景 + 边框（无外阴影——原生窗口 WindowChrome 下 DropShadowEffect 不渲染） -->
    <Border Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
            CornerRadius="0"
            BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}"
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 标题栏 -->
                <RowDefinition Height="*"/>     <!-- 内容区 -->
                <RowDefinition Height="Auto"/>  <!-- 底部按钮栏（自适应内容，避免按钮下边框被裁切） -->
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarBackgroundBrush}}"
                    Height="32"
                    Padding="12,0,8,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                    MouseLeftButtonUp="OnTitleBarMouseLeftButtonUp">
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题文字 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:ToolIcon x:Name="TitleToolIcon" Key="{Binding ToolIconKey, RelativeSource={RelativeSource AncestorType=Window}}" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarTextBrush}}"/>
                    <TextBlock
                              x:Name="TitleTextBlock"
                              Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarTextBrush}}"
                              VerticalAlignment="Center"
                              FontSize="13"/>
                    </StackPanel>

                    <!-- 最大化/还原按钮（WindowChrome Caption 区域内可点击） -->
                    <Button Grid.Column="1"
                            x:Name="MaximizeButton"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarTextBrush}}"
                            BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeButtonClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarButtonHoverBrush}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 关闭按钮（WindowChrome.IsHitTestVisibleInChrome=True：Caption 区域内可点击） -->
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarTextBrush}}"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseButtonClick">
                        <Button.Content><TextBlock Text="✕" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarTextBrush}}" FontSize="14"/></Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static themes:SdkThemeKeys.TitleBarButtonHoverBrush}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区域 -->
            <ContentControl Grid.Row="1"
                           x:Name="ContentHost"
                           Focusable="False"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch"/>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2"
                    x:Name="FooterBar"
                    Background="{DynamicResource {x:Static themes:SdkThemeKeys.StatusBarBackgroundBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6,16,6">

                <DockPanel>
                <TextBlock x:Name="ExecutionMessage" DockPanel.Dock="Top" Visibility="Collapsed"
                           Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.ErrorBrush}}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Right">

                    <!-- 连续执行按钮 -->
                    <Button x:Name="ContinuousRunButton"
                            Content="连续执行"
                            Width="100"
                            Height="28"
                            Margin="0,0,8,0"
                            Style="{StaticResource DebugToolbarButtonStyle}"
                            Command="commands:ToolCommands.ContinuousExecute"/>

                    <!-- 执行按钮 -->
                    <Button x:Name="RunButton"
                            Content="执行"
                            Width="100"
                            Height="28"
                            Margin="0,0,8,0"
                            Style="{StaticResource DebugToolbarButtonStyle}"
                            Command="commands:ToolCommands.Execute"/>

                    <!-- 确定按钮 -->
                    <Button x:Name="ConfirmButton"
                            Content="确定"
                            Width="100"
                            Height="28"
                            Style="{StaticResource DebugToolbarButtonStyle}"
                            Command="commands:ToolCommands.Confirm"/>
                </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
