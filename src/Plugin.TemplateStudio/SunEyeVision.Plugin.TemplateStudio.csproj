<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <PackageId>SunEyeVision.Plugin.TemplateStudio</PackageId>
    <Description>模板训练共用层（对应原厂 FeatureMatchCommonControl）：共用面板控件 + 模板模型。两个及以上工具共用的部分才放这里。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plugin.Contracts\SunEyeVision.Plugin.Contracts.csproj" />
    <ProjectReference Include="..\Plugin.Wpf\SunEyeVision.Plugin.Wpf.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
