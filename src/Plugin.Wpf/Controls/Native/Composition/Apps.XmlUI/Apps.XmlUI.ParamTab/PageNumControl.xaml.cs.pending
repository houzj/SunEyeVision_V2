	public static readonly DependencyProperty PageDataCountProperty = DependencyProperty.Register("PageDataCount", typeof(int), typeof(PageNumControl), new PropertyMetadata(12, PageDataCountChanged));

	public static readonly DependencyProperty ShowingPageNumberCollectionProperty = DependencyProperty.Register("ShowingPageNumberCollection", typeof(ObservableCollection<NumInfo>), typeof(PageNumControl), new PropertyMetadata(null, null));

	public static readonly DependencyProperty CurrentPageNumberProperty = DependencyProperty.Register("CurrentPageNumber", typeof(int), typeof(PageNumControl), new PropertyMetadata(0, OnCurrentPageNumberChanged));

	public static readonly DependencyProperty MaxShownPageCountProperty = DependencyProperty.Register("MaxShownPageCount", typeof(int), typeof(PageNumControl), new PropertyMetadata(7, null));

	public static readonly DependencyProperty TotalDataCountProperty = DependencyProperty.Register("TotalDataCount", typeof(int), typeof(PageNumControl), new PropertyMetadata(0, OnTotalDataCountChanged));

	public static readonly DependencyProperty TotalPageCountProperty = DependencyProperty.Register("TotalPageCount", typeof(int), typeof(PageNumControl), new PropertyMetadata(0, null));

	public static readonly DependencyProperty SelectedPageBackgroundProperty = DependencyProperty.Register("SelectedPageBackground", typeof(Brush), typeof(PageNumControl), new PropertyMetadata(new SolidColorBrush(Colors.Orange), null));

	public static readonly DependencyProperty BtnCollapsedProperty = DependencyProperty.Register("BtnCollapsed", typeof(string), typeof(PageNumControl), new PropertyMetadata("Visible", null));

	public static readonly DependencyProperty DisplayTotalCountProperty = DependencyProperty.Register("DisplayTotalCount", typeof(string), typeof(PageNumControl), new PropertyMetadata("0", null));

	public static readonly DependencyProperty pageCountInfosProperty = DependencyProperty.Register("pageCountInfos", typeof(ObservableCollection<PageCountInfo>), typeof(PageNumControl), new PropertyMetadata(null, null));

	public static readonly DependencyProperty PageCountVisibleProperty = DependencyProperty.Register("PageCountVisible", typeof(string), typeof(PageNumControl), new PropertyMetadata("Collapsed", null));

