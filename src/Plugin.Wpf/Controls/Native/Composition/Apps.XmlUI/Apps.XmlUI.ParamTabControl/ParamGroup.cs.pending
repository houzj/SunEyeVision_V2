	public static readonly DependencyProperty ViewsProperty = DependencyProperty.Register("Views", typeof(ObservableCollection<object>), typeof(ParamGroup), new UIPropertyMetadata(null, OnDataGridColumnsPropertyChanged));

	public ObservableCollection<object> Views
	{
		get
		{
			return (ObservableCollection<object>)GetValue(ViewsProperty);
		}
		set
		{
			SetValue(ViewsProperty, value);
		}
	}

	private static void OnDataGridColumnsPropertyChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		try
		{
			ParamGroup paramGroup = d as ParamGroup;
			ObservableCollection<object> observableCollection = (ObservableCollection<object>)e.NewValue;
			if (observableCollection != null)
			{
				paramGroup.SetTemple(observableCollection);
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageButtons.Normal, MessageIcons.Error);
		}
	}

