using System.Windows;
using System.Windows.Controls;
using System.Windows.Markup;
using SunEyeVision.Plugin.Wpf.Native.Common.Localization;

namespace SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI;

public partial class ContainerFidScroller : ItemsControl, IComponentConnector
{
	private double CustomParamCHWidth = 120.0;

	public static readonly DependencyProperty CustomParamENWidthProperty = DependencyProperty.Register("CustomParamENWidth", typeof(double), typeof(ContainerFidScroller), new PropertyMetadata(200.0, CustomParamENWidthChanged));

	public static readonly DependencyProperty ChildLeftWidthProperty = DependencyProperty.Register("ChildLeftWidth", typeof(double), typeof(ContainerFidScroller), new PropertyMetadata(89.0));

	public static readonly DependencyProperty ChildMarginProperty = DependencyProperty.Register("ChildMargin", typeof(Thickness), typeof(ContainerFidScroller), new PropertyMetadata(new Thickness(32.0, 1.0, 32.0, 0.0)));

	public static readonly DependencyProperty ChildHeaderMarginProperty = DependencyProperty.Register("ChildHeaderMargin", typeof(Thickness), typeof(ContainerFidScroller), new PropertyMetadata(new Thickness(32.0, 0.0, 0.0, 8.0)));

	public object Instance => this;

	public double CustomParamENWidth
	{
		get
		{
			return (double)GetValue(CustomParamENWidthProperty);
		}
		set
		{
			SetValue(CustomParamENWidthProperty, value);
		}
	}

	public double ChildLeftWidth
	{
		get
		{
			return (double)GetValue(ChildLeftWidthProperty);
		}
		set
		{
			SetValue(ChildLeftWidthProperty, value);
		}
	}

	public Thickness ChildMargin
	{
		get
		{
			return (Thickness)GetValue(ChildMarginProperty);
		}
		set
		{
			SetValue(ChildMarginProperty, value);
		}
	}

	public Thickness ChildHeaderMargin
	{
		get
		{
			return (Thickness)GetValue(ChildHeaderMarginProperty);
		}
		set
		{
			SetValue(ChildHeaderMarginProperty, value);
		}
	}

	private static void CustomParamENWidthChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		if (d is ContainerFidScroller containerFidScroller)
		{
			double num = ((AppLocalizationService.GetLang("Language") == "English") ? containerFidScroller.CustomParamENWidth : containerFidScroller.CustomParamCHWidth);
			if (containerFidScroller.ChildLeftWidth != num)
			{
				containerFidScroller.ChildLeftWidth = num;
			}
		}
	}

	public ContainerFidScroller()
	{
		InitializeComponent();
		ChildLeftWidth = ((AppLocalizationService.GetLang("Language") == "English") ? CustomParamENWidth : CustomParamCHWidth);
	}
}
