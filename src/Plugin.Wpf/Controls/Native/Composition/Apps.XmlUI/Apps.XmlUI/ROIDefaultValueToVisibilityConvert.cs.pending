using System;
using System.Globalization;
using System.Linq;
using System.Windows;
using System.Windows.Data;
using Apps.XmlParser.ParamTab;

namespace SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI;

public class ROIDefaultValueToVisibilityConvert : IValueConverter
{
	public object Convert(object value, Type targetType, object parameter, CultureInfo culture)
	{
		if (parameter is RoiType)
		{
			parameter = parameter.ToString();
		}
		if (!string.IsNullOrEmpty(parameter as string) && !string.IsNullOrEmpty(value as string))
		{
			string[] source = (value as string).Split(';', ' ');
			if (source.Contains(parameter as string))
			{
				return Visibility.Visible;
			}
			return Visibility.Collapsed;
		}
		return Visibility.Collapsed;
	}

	public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture)
	{
		throw new NotImplementedException();
	}
}
