<UserControl x:Class="SunEyeVision.Plugin.Wpf.Controls.Native.Composition.ImageSources.ImageSourceInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rows="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTab"
             xmlns:localization="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <localization:LocalizationResources />
                <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceScrollBars.xaml" />
                <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceComboBoxes.xaml" />
                <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/ImageButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <TextBlock x:Key="CameraStatus" />
            <ComboBox x:Key="CameraPicker" Style="{StaticResource ListViewComboBoxStyle}"
                      DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="{StaticResource CameraStatus}" />
            <Button x:Key="OpenCameraButton" HorizontalAlignment="Right" ToolTip="{DynamicResource Lang_CameraSet}"
                    Style="{StaticResource Shared.ImageButtonStyle}">
                <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_modal_camera_normal.png" />
                <Button.Tag>
                    <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_modal_camera_click.png" />
                </Button.Tag>
            </Button>
        </ResourceDictionary>
    </UserControl.Resources>
    <rows:LeftRightControl Height="32">
        <rows:LeftRightControl.LeftContent>
            <TextBlock Text="{DynamicResource Relate Camera}" />
        </rows:LeftRightControl.LeftContent>
        <rows:LeftRightControl.RightContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{StaticResource CameraPicker}" />
                <ContentPresenter Grid.Column="1" Content="{StaticResource OpenCameraButton}" />
            </Grid>
        </rows:LeftRightControl.RightContent>
    </rows:LeftRightControl>
</UserControl>
