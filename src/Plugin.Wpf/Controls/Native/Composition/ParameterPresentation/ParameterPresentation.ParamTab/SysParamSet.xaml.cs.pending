using System.ComponentModel;
using System.Windows;
using System.Windows.Markup;
using Apps.Log;
using SunEyeVision.Plugin.Wpf.Native.Display.PresentationControls;
using SunEyeVision.Plugin.Wpf.Native.Numeric.Presentation.Controls;
using VM.PlatformSDKCS;

namespace SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTab;

public partial class SysParamSet : BaseWindow, INotifyPropertyChanged, IComponentConnector
{
	private uint ProcessID = 0u;

	public new event PropertyChangedEventHandler PropertyChanged;

	public SysParamSet(uint processID)
	{
		InitializeComponent();
		ProcessID = processID;
		Loaded += SysParamSet_Loaded;
	}

	protected new virtual void OnPropertyChanged(string proName)
	{
		if (PropertyChanged != null)
		{
			PropertyChanged(this, new PropertyChangedEventArgs(proName));
		}
	}

	private void SysParamSet_Loaded(object sender, RoutedEventArgs e)
	{
		try
		{
			uint nMilliSecond = 0u;
			try
			{
				ServerSDKManager.serverSDKManager.mProcessManager.GetContinousRunInterval(ProcessID, ref nMilliSecond);
				timeSpan.StartValue = nMilliSecond;
			}
			catch
			{
				NativeMessageBox.Show("Lang_SetCnfg", "Lang_GetParamError", MessageIcons.Error);
			}
		}
		catch
		{
			timeSpan.StartValue = 100.0;
			Close();
		}
	}

	private void ButtonApply_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			ServerSDKManager.serverSDKManager.mProcessManager.SetContinousRunInterval(ProcessID, (uint)timeSpan.StartValue);
			DialogResult = true;
		}
		catch (VmException ex)
		{
			string text = "IMVS_GetProcContinousRunInterval Failed!：" + ex.errorCode + ",:" + ex.errorMessage;
			LogHelper.objLog.Error(text);
			NativeMessageBox.Show(text, MessageIcons.Error);
			DialogResult = false;
		}
	}

	private void ButtonClose_Click(object sender, RoutedEventArgs e)
	{
		Close();
	}
}
