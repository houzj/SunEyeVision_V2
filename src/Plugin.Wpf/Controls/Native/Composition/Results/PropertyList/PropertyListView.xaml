<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SunEyeVision.Plugin.Wpf.Controls.Native.Composition.Results.PropertyList.PropertyListView" x:Name="View">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Results/PropertyList/Dark.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Results/PropertyList/PropertyListStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Name="resultGrid" Background="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="3" Background="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_Background}" Opacity="0.15" />
    <Grid Background="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_Title_Background}" Margin="2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1" />
      </Grid.ColumnDefinitions>
      <Rectangle Grid.Column="0" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" />
      <Rectangle Grid.Column="2" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" />
      <Rectangle Grid.Column="4" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" />
      <Rectangle Grid.Column="6" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="结果名称" Foreground="{DynamicResource Results.PropertyList.Col_DisplayImage_Foreground}" FontSize="14" Margin="10,0" ToolTip="{Binding Text, RelativeSource={RelativeSource self}}" />
      <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Text="当前值" Foreground="{DynamicResource Results.PropertyList.Col_DisplayImage_Foreground}" FontSize="14" Margin="10,0" ToolTip="{Binding Text, RelativeSource={RelativeSource self}}" />
      <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" Text="变量管理" Foreground="{DynamicResource Results.PropertyList.Col_DisplayImage_Foreground}" FontSize="14" Margin="10,0" ToolTip="{Binding Text, RelativeSource={RelativeSource self}}" />
    </Grid>
    <Grid Height="40" Background="{DynamicResource Results.PropertyList.TreeTabItemBaground}" Row="1">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Height="28" Width="28" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/result-warning.png" VerticalAlignment="Center" />
        <TextBlock ToolTipService.ShowDuration="10000" FontSize="16" Foreground="{DynamicResource Results.PropertyList.NoCameraForground}" VerticalAlignment="Center" Text="{Binding ErrorInfo, ElementName=View}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
      </StackPanel>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorInfo, ElementName=View}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Grid>
    <ScrollViewer Grid.Row="2" Style="{StaticResource Results.PropertyList.RecScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid Name="resgrid" Margin="2,0">
        <FrameworkElement.Resources>
          <ResourceDictionary>


                      </ResourceDictionary>
        </FrameworkElement.Resources>
        <TreeView Name="resultTreeView" Style="{StaticResource Results.PropertyList.ResultTreeViewStyle}" ItemContainerStyle="{StaticResource Results.PropertyList.ResultTreeViewItemStyle}" ItemsSource="{Binding ItemsSource, ElementName=View}" DataContext="{Binding ElementName=View}" SelectedItemChanged="TreeSelectionChanged" PreviewKeyDown="SelectionKeyDown" MaxWidth="{Binding ActualWidth, ElementName=resgrid}">
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource Results.PropertyList.ResultTreeViewItemStyle}" />
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
    </ScrollViewer>
    <Grid Height="40" Background="{DynamicResource Results.PropertyList.TreeTabItemBoBaground}" Opacity="0.5" Row="3">
      <TextBox Name="tbPath" IsReadOnly="True" BorderThickness="0" Background="#00FFFFFF" FontSize="14" Foreground="{DynamicResource Results.PropertyList.NoCameraForground}" VerticalAlignment="Center" Margin="12,0" ToolTip="所选结果的正式引用路径" Text="{Binding SelectedItemPath, ElementName=View}" />
      <Button HorizontalAlignment="Right" Width="30" Height="30" ToolTip="复制路径" Command="{Binding CopyPathCommand, ElementName=View}" CommandParameter="{Binding Text, ElementName=tbPath}">
        <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/path-copy-normal.png" />
        <FrameworkElement.Tag>
          <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/path-copy-hover.png" />
        </FrameworkElement.Tag>
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource Results.PropertyList.BaseImage_ButtonStyle}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding CopyPathCommand, ElementName=View}" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItemPath, ElementName=View}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Grid>
  </Grid>
</UserControl>
