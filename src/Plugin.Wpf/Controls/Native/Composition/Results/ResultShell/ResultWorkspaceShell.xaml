<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:display="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageViewport" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SunEyeVision.Plugin.Wpf.Controls.Native.Composition.Results.ResultShell.ResultWorkspaceShell" x:Name="View">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Results/ResultShell/Dark.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Results/ResultShell/ResultShellStyles.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Results/StandardTable.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/ImageSources/ImageSourceMenu.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Results.History.ContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource ImageSources.ContextMenuStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Results.Shell.Col_DisplayImage_Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Results.Shell.Col_ComboBox_BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource Results.Shell.Col_ComboBox_Popup}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Results.Shell.Col_DisplayImage_Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="2" />
      <RowDefinition x:Name="InfoRow" Height="235" MinHeight="40" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TabControl SelectedIndex="{Binding SelectedResultTabIndex, ElementName=View, Mode=TwoWay}" Background="{DynamicResource Results.Shell.Col_DisplayImage_Background}" BorderBrush="{DynamicResource Results.Shell.Col_DisplayImage_BorderBrush}">
        <TabItem Header="图像结果" Height="38" FontSize="14" Style="{StaticResource Results.Shell.FrequentTab}">
          <Grid Name="imageUnion">
            <Grid.RowDefinitions>
              <RowDefinition Height="40" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Name="colInput" Width="0" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Style="{StaticResource Results.Shell.RecScrollViewer}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
              <Grid VerticalAlignment="Top" Margin="8,3,0,0" MinWidth="260">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <ComboBox Style="{StaticResource Results.Shell.ImageListComboBox}" Height="32" Width="142" ItemsSource="{Binding InputItems, ElementName=View}" SelectedItem="{Binding SelectedInputItem, ElementName=View, Mode=TwoWay}" ToolTip="{Binding SelectedInputItem.DisplayName, ElementName=View}" DataContext="{Binding ElementName=View}">
                        </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ToggleButton Style="{StaticResource Results.Shell.DoubleImageToggleButton}" Width="35" Height="35" IsChecked="{Binding IsDoubleImage, ElementName=View, Mode=TwoWay}" />
                  <UniformGrid Columns="2" Width="75">
                    <Button Name="BtnToolRegionScaleIn" Width="34" Height="34" Style="{StaticResource Results.Shell.ClientOriginScaleBtn}" Content="1:1" Click="ResetClick" Tag="Input" />
                    <Button Name="BtnToolFullScreenIn" Width="34" Height="34" Content="全屏" Command="{Binding FullscreenCommand, ElementName=View}" CommandParameter="{Binding ElementName=imageViewIn}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.ClientFullScreenBtn}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding FullscreenCommand, ElementName=View}" Value="{x:Null}">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </ScrollViewer>
            <ScrollViewer Grid.Column="1" Style="{StaticResource Results.Shell.RecScrollViewer}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
              <Grid VerticalAlignment="Top" Margin="8,3,0,0" MinWidth="300">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <ComboBox Style="{StaticResource Results.Shell.ImageListComboBox}" Height="32" Width="142" ItemsSource="{Binding OutputItems, ElementName=View}" SelectedItem="{Binding SelectedOutputItem, ElementName=View, Mode=TwoWay}" ToolTip="{Binding SelectedOutputItem.DisplayName, ElementName=View}" DataContext="{Binding ElementName=View}">
                        </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <!-- 原件 ModuleResultView.xaml:87-101 comcor：坐标显示三态（图像坐标/物理坐标/同时显示），
                       直接驱动 ImageViewBox.CordinateShow（0/1/2，与原件 CorSelectIndex 语义一致，见 Cor2Pixel/PhysicalVisibleConverter）。 -->
                  <ComboBox Name="CoordinateMode" Height="30" Width="110" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="{DynamicResource Results.Shell.坐标类型}"
                            SelectedIndex="{Binding CordinateShow, ElementName=imageView, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource Results.Shell.图像坐标}" />
                    <ComboBoxItem Content="{DynamicResource Results.Shell.物理坐标}" />
                    <ComboBoxItem Content="{DynamicResource Results.Shell.两者显示}" />
                  </ComboBox>
                  <ToggleButton Style="{StaticResource Results.Shell.DoubleImageToggleButton}" Width="35" Height="35" IsChecked="{Binding IsDoubleImage, ElementName=View, Mode=TwoWay}" />
                  <StackPanel Orientation="Horizontal">
                    <Button Name="line" ToolTip="{DynamicResource Results.Shell.辅助线}" Command="{Binding CrossLinesCommand, ElementName=View}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.CrossLineStyle}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CrossLinesCommand, ElementName=View}" Value="{x:Null}">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource Results.Shell.DashedLineStroke}" />
                    <Button Width="34" Height="34" Content="{DynamicResource Results.Shell.放大}" Margin="1" Click="EnlargeClick" IsEnabled="{Binding EnableZoomOut, ElementName=imageView}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.ZoomEnlarge}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDoubleImage, ElementName=View}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Width="34" Height="34" Content="{DynamicResource Results.Shell.缩小}" Margin="1" Click="ShrinkClick" IsEnabled="{Binding EnableZoomIn, ElementName=imageView}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.ZoomShrink}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDoubleImage, ElementName=View}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource Results.Shell.ClientOriginScaleBtn}" Content="1:1" Click="ResetClick" Tag="Output" />
                    <Button Name="BtnToolFullScreen" Width="34" Height="34" Content="全屏" Command="{Binding FullscreenCommand, ElementName=View}" CommandParameter="{Binding ElementName=imageView}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.ClientFullScreenBtn}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding FullscreenCommand, ElementName=View}" Value="{x:Null}">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </ScrollViewer>
            <Grid Name="viewboxIn" Row="1" Margin="-1" Background="{DynamicResource Results.Shell.Col_DisplayImage_Control_BorderBrush}">
              <display:ImageViewBox x:Name="imageViewIn" Margin="1" IsDisplayPixelAuto="True">
                    </display:ImageViewBox>
            </Grid>
            <Grid Name="viewbox" Row="1" Column="1" Margin="-1" Background="{DynamicResource Results.Shell.Col_DisplayImage_Control_BorderBrush}">
              <display:ImageViewBox x:Name="imageView" Margin="1" IsDisplayPixelAuto="True" IsSaveRenderImageVisible="True">
                    </display:ImageViewBox>
            </Grid>
            <Button Name="btnLeft" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="26" Height="54" Panel.ZIndex="0" Command="{Binding PreviousImageCommand, ElementName=View}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.StyleLeft}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviousImageCommand, ElementName=View}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Name="btnRight" Grid.Row="1" Grid.ColumnSpan="2" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" VerticalAlignment="Center" Height="54" Width="26" Panel.ZIndex="0" UseLayoutRounding="True" SnapsToDevicePixels="True" Command="{Binding NextImageCommand, ElementName=View}">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="-1" />
              </UIElement.RenderTransform>
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Results.Shell.StyleLeft}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NextImageCommand, ElementName=View}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </Grid>
        </TabItem>
        <TabItem Header="模块结果" Height="38" FontSize="14" Style="{StaticResource Results.Shell.FrequentTab}">
          <ContentPresenter Content="{Binding PropertyListContent, ElementName=View}" />
        </TabItem>
      </TabControl>
      <ContentPresenter Grid.Row="1" Content="{Binding SourceStripContent, ElementName=View}" />
    </Grid>
    <GridSplitter Height="2" Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />
    <Grid Grid.Row="2">
      <Border BorderBrush="{DynamicResource Results.Shell.Col_DisplayImage_BorderBrush}" BorderThickness="0,1,0,1">
        <Grid>
          <TabControl x:Name="InfoTab" SelectionChanged="InfoTabSelectionChanged" Style="{StaticResource Results.Shell.ModuleViewTabControl}" Background="{DynamicResource Results.Shell.Col_DisplayImage_Background}" BorderBrush="{DynamicResource Results.Shell.Col_DisplayImage_BorderBrush}">
            <TabItem x:Name="CurrentResultTab" Header="当前结果" Height="40" FontSize="14">
              <TabItem.Style>
                <Style TargetType="TabItem" BasedOn="{StaticResource Results.Shell.FrequentTab}">
                  <Style.Triggers><DataTrigger Binding="{Binding CurrentResultContent, ElementName=View}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </TabItem.Style>
              <ContentPresenter Content="{Binding CurrentResultContent, ElementName=View}" />
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="历史结果" Height="40" FontSize="14" Style="{StaticResource Results.Shell.FrequentTab}" Tag="{Binding ElementName=View}">
              <TabItem.ContextMenu>
                  <ContextMenu Style="{StaticResource Results.History.ContextMenu}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="清空" Command="{Binding ClearHistoryCommand}" />
                    <MenuItem Header="保存" Command="{Binding SaveHistoryCommand}" />
                </ContextMenu>
              </TabItem.ContextMenu>
              <Grid>
                  <DataGrid x:Name="HistoryGrid" ColumnWidth="Auto" Style="{StaticResource ModuleViewDataGridStyle}" IsReadOnly="True"
                            ItemsSource="{Binding HistoryItems, ElementName=View}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="执行序号" MinWidth="30" CellStyle="{StaticResource Results.History.LeftCell}" Binding="{Binding RowIndex}" />
                    <DataGridTextColumn Header="时间" MinWidth="150" CellStyle="{StaticResource Results.History.LeftCell}" Binding="{Binding AddTime}" />
                    <DataGridTextColumn Header="模块数据" MinWidth="200" CellStyle="{StaticResource Results.History.LeftCell}" Binding="{Binding Content}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Header="帮助" Height="40" Width="90" FontSize="14" Style="{StaticResource Results.Shell.FrequentTab}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource Results.Shell.shrinkScrollViewer}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Results.Shell.Col_DisplayImage_Foreground}" Text="{Binding HelpContent, ElementName=View, TargetNullValue=未提供工具帮助, FallbackValue=未提供工具帮助}" />
              </ScrollViewer>
            </TabItem>
          </TabControl>
          <ToggleButton Style="{StaticResource Results.Shell.DisplayHideBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0" IsChecked="{Binding IsInfoExpanded, ElementName=View, Mode=TwoWay}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
