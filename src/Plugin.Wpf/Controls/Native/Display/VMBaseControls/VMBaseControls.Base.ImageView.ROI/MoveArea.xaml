<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI.MoveArea" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="eStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Stroke" Value="{StaticResource ROIBaseColor}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Fill" Value="{StaticResource AnchorFreeColor}" />
        <Setter Property="Margin" Value="{Binding RectMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
        <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Canvas Width="0" Height="0">
        <Ellipse Name="SizeRectX" Style="{StaticResource eStyle}" />
      </Canvas>
    </ControlTemplate>
  </Control.Template>
</Control>