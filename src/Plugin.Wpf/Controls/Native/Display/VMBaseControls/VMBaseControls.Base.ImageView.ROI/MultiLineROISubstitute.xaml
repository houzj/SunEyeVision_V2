<?xml version="1.0" encoding="utf-8"?>
<local:ROISubstitute x:Class="SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI.MultiLineROISubstitute" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Path Stroke="#0F6AF3" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="{Binding Points[0], RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <PolyLineSegment Points="{Binding Points, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            </PathFigure>
          </PathGeometry>
        </Path.Data>
      </Path>
    </ControlTemplate>
  </Control.Template>
</local:ROISubstitute>