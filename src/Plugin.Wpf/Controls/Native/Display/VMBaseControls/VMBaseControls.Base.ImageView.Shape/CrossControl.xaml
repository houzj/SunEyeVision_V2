<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.CrossControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape" IsVisibleChanged="Control_IsVisibleChanged">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type Control}">
      <Canvas IsHitTestVisible="True" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <Line X1="{Binding Line1Point1X}" Y1="{Binding Line1Point1Y}" X2="{Binding Line1Point2X}" Y2="{Binding Line1Point2Y}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThicknessR}" />
        <Line X1="{Binding Line2Point1X}" Y1="{Binding Line2Point1Y}" X2="{Binding Line2Point2X}" Y2="{Binding Line2Point2Y}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThicknessR}" />
        <Grid Name="move" Margin="{Binding MoveMargin}" Width="{Binding MoveWidth}" Height="{Binding MoveWidth}">
          <Rectangle StrokeThickness="0" Fill="#00FFFFFF" Width="{Binding MoveWidth}" Height="{Binding MoveWidth}" />
          <Line Name="line1" X1="0" X2="1" Stretch="Fill" HorizontalAlignment="Center" StrokeThickness="{Binding StrokeThicknessMove}" Stroke="{Binding Stroke}" />
          <Line Name="line2" Y1="0" Y2="1" Stretch="Fill" VerticalAlignment="Center" StrokeThickness="{Binding StrokeThicknessMove}" Stroke="{Binding Stroke}" />
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Grid}">
              <Setter Property="FrameworkElement.ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource Lang_Hide}" Command="{Binding PlacementTarget.TemplatedParent.DataContext.HideCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                    <MenuItem Header="{DynamicResource Lang_Locking}" Command="{Binding PlacementTarget.TemplatedParent.DataContext.LockCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" Visibility="{Binding PlacementTarget.TemplatedParent.LockVisibility, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                    <MenuItem Header="{DynamicResource Lang_Unlock}" Command="{Binding PlacementTarget.TemplatedParent.DataContext.UnLockCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" Visibility="{Binding PlacementTarget.TemplatedParent.UnLockVisibility, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                    <MenuItem Header="{DynamicResource Lang_Center}" Command="{Binding PlacementTarget.TemplatedParent.DataContext.CenterCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <Setter Property="UIElement.Opacity" Value="0" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="UIElement.Opacity" Value="1" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Grid>
      </Canvas>
    </ControlTemplate>
  </Control.Template>
</Control>