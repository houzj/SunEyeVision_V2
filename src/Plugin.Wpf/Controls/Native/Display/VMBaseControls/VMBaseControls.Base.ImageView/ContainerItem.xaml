<?xml version="1.0" encoding="utf-8"?>
<ListViewItem x:Class="SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ContainerItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls" x:Name="us" RenderTransformOrigin="0.5,0.5" Focusable="True" Padding="0" BorderThickness="0" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.BaseData">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <vm_port_1:MulParamsMultiplicationConverter x:Key="MC" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.InputBindings>
    <KeyBinding Gesture="Ctrl+C" Key="C" Command="{Binding ParentItemsControl.CopyRoiCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}">
      <InputBinding.CommandParameter>
        <MultiBinding Converter="{StaticResource MC}">
          <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:ContainerItem}}" />
          <Binding Path="ParentItemsControl.DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:ContainerItem}}" />
        </MultiBinding>
      </InputBinding.CommandParameter>
    </KeyBinding>
    <KeyBinding Gesture="Delete" Key="Delete" Command="{Binding ParentItemsControl.DeleteRoiCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}">
      <InputBinding.CommandParameter>
        <MultiBinding Converter="{StaticResource MC}">
          <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:ContainerItem}}" />
          <Binding Path="ParentItemsControl.DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:ContainerItem}}" />
        </MultiBinding>
      </InputBinding.CommandParameter>
    </KeyBinding>
    <KeyBinding Gesture="Left" Key="Left" CommandParameter="{x:Static local:ROIMoveDirection.Left}" Command="{Binding MoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}" />
    <KeyBinding Gesture="Right" Key="Right" CommandParameter="{x:Static local:ROIMoveDirection.Right}" Command="{Binding MoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}" />
    <KeyBinding Gesture="Up" Key="Up" CommandParameter="{x:Static local:ROIMoveDirection.Up}" Command="{Binding MoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}" />
    <KeyBinding Gesture="Down" Key="Down" CommandParameter="{x:Static local:ROIMoveDirection.Down}" Command="{Binding MoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}" />
    <KeyBinding Gesture="Ctrl+Left" Key="Left" CommandParameter="{x:Static local:ROIMoveDirection.LeftRotate}" Command="{Binding MoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}" />
    <KeyBinding Gesture="Ctrl+Right" Key="Right" CommandParameter="{x:Static local:ROIMoveDirection.RightRotate}" Command="{Binding MoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContainerItem}}" />
  </UIElement.InputBindings>
  <Control.Template>
    <ControlTemplate TargetType="{x:Type ListBoxItem}">
      <FrameworkTemplate.Resources>
        <ResourceDictionary>
          <vm_port_1:TypeFilterConverter x:Key="typeFilterConverter" />
        </ResourceDictionary>
      </FrameworkTemplate.Resources>
      <ContentPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
      <ControlTemplate.Triggers>
        <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROISelectable}}">
          <Setter Property="ListBoxItem.IsSelected" Value="{Binding Path=(vm_port_0:IROISelectable.IsSelected), Mode=TwoWay}" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
  <UIElement.RenderTransform>
    <TransformGroup>
      <RotateTransform Angle="{Binding Angle, ElementName=us}" />
      <SkewTransform AngleX="{Binding SkewAngleX, ElementName=us}" AngleY="{Binding SkewAngleY, ElementName=us}" />
    </TransformGroup>
  </UIElement.RenderTransform>
</ListViewItem>