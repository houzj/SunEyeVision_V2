<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.ImageViewBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls" xmlns:imageview="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" x:Name="us" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_0:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bv" />
      <local:NegateConverter x:Key="negate" />
      <local:Cor2PixelVisibleConverter x:Key="Cor2PixelVisibleConverter" />
      <local:Cor2PhysicalVisibleConverter x:Key="Cor2PhysicalVisibleConverter" />
      <local:Bool2CollapesdConverter x:Key="Bool2CollapesdConverter" />
      <local:AdditionTemplateSelector x:Key="AdditionSelector" />
      <local:AdditionWTemplateSelector x:Key="AdditionWSelector" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.InputBindings>
    <KeyBinding Gesture="Ctrl+V" Key="V" Command="{Binding PasteRoiCommand, ElementName=us}" />
  </UIElement.InputBindings>
  <Control.Template>
    <ControlTemplate>
      <Grid Name="mainGrid" UseLayoutRounding="False" SnapsToDevicePixels="False" ClipToBounds="True" Background="{DynamicResource Col_Image_DrawingBrush1}" SizeChanged="mainGrid_SizeChanged">
        <Canvas Name="mapcanvas" ClipToBounds="True" Visibility="{Binding SplotVis, Converter={StaticResource negate}, RelativeSource={RelativeSource Mode=TemplatedParent}}" MouseWheel="mapcanvas_MouseWheel">
          <Panel.Background>
            <DrawingBrush Stretch="Fill" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
              <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource Col_Image_DrawingBrush2}" Geometry="M0,2 L1,2 L1,3 L0,3 M1,1 L2,1 L2,2 L1,2" />
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Panel.Background>
          <Viewbox Name="viewbox" MouseMove="viewbox_MouseMove" SizeChanged="viewbox_SizeChanged" LayoutUpdated="Viewbox_LayoutUpdated" MouseLeave="viewbox_MouseLeave">
            <Grid Name="VGrid" PreviewMouseLeftButtonDown="mROIView_MouseLeftButtonDown">
              <Grid Name="ImageLayers" Width="{Binding ImageDesignWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                <Image Name="sImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="{Binding ImageMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" Source="{Binding Source, RelativeSource={RelativeSource Mode=TemplatedParent}}" MouseLeftButtonDown="mouseLBDown" MouseLeftButtonUp="mouseLBUp" MouseRightButtonDown="sImage_MouseRightButtonDown" />
              </Grid>
              <imageview:ShapeItemsPage x:Name="mShapeView" Margin="{Binding Path=ControlToImageRadio, Converter={x:Static local:ShapeAndRoiMarginCvt.Cvt}, RelativeSource={RelativeSource Mode=TemplatedParent}}" IsHitTestVisible="{Binding ShapeHitTestVisible, RelativeSource={RelativeSource Mode=TemplatedParent}}" ControlToImageRadio="{Binding ControlToImageRadio, RelativeSource={RelativeSource Mode=TemplatedParent}}" ThicknessScale="{Binding ThicknessScale, RelativeSource={RelativeSource Mode=TemplatedParent}}" ItemsSource="{Binding ShapeList, RelativeSource={RelativeSource Mode=TemplatedParent}}" ImageSourceWidth="{Binding ImageSourceWidth, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ImageSourceHeight="{Binding ImageSourceHeight, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ShapeConvertMatrix="{Binding ShapeConvertMatrix, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <imageview:ROIItemsPage x:Name="mROIView" DrawSubstituteComplete="MROIView_DrawSubstituteComplete" LostMouseCapture="mROIView_LostMouseCapture" Margin="{Binding Path=ControlToImageRadio, Converter={x:Static local:ShapeAndRoiMarginCvt.Cvt}, RelativeSource={RelativeSource Mode=TemplatedParent}}" IsHitTestVisible="{Binding ROIHitTestVisible, RelativeSource={RelativeSource Mode=TemplatedParent}}" ControlToImageRadio="{Binding ControlToImageRadio, RelativeSource={RelativeSource Mode=TemplatedParent}}" ThicknessScale="{Binding ThicknessScale, RelativeSource={RelativeSource Mode=TemplatedParent}}" ImageWidth="{Binding ImageSourceWidth, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ImageHeight="{Binding ImageSourceHeight, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ROIList="{Binding ROIList, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding ROIVisible, Converter={StaticResource bv}, RelativeSource={RelativeSource Mode=TemplatedParent}}" CopyRoiCommand="{Binding CopyRoiCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}" DeleteRoiCommand="{Binding DeleteRoiCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Canvas Name="mExtenView" ClipToBounds="True" />
            </Grid>
            <UIElement.RenderTransform>
              <TransformGroup x:Name="TG">
                <ScaleTransform x:Name="sfr" ScaleX="{Binding ImageScale, RelativeSource={RelativeSource Mode=TemplatedParent}}" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Mode=Self}}" Changed="sfr_Changed" />
                <TranslateTransform x:Name="tlt" X="{Binding ImageOffSetX, RelativeSource={RelativeSource Mode=TemplatedParent}}" Y="{Binding ImageOffSetY, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </TransformGroup>
            </UIElement.RenderTransform>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Setter Property="FrameworkElement.ContextMenu">
                  <Setter.Value>
                    <ContextMenu>
                      <MenuItem Header="{DynamicResource 保存原始图}" Command="{Binding PlacementTarget.TemplatedParent.SaveOriginalImageCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                      <MenuItem Header="{DynamicResource RunParam_RenderImgEnable}" Command="{Binding PlacementTarget.TemplatedParent.SaveRenderImageCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" Visibility="{Binding PlacementTarget.TemplatedParent.IsSaveRenderImageVisible, Converter={StaticResource bv}, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                      <MenuItem Header="{DynamicResource Lang_Paste}" Visibility="{Binding IsEnabled, Converter={StaticResource bv}, RelativeSource={RelativeSource Self}}" Command="{Binding PlacementTarget.TemplatedParent.PasteRoiCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                      <MenuItem Header="{DynamicResource Lang_RoiLock}" CommandParameter="False" Command="{Binding PlacementTarget.TemplatedParent.RoiEnableCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" IsEnabled="{Binding PlacementTarget.TemplatedParent.ROIHitTestVisible, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" Visibility="{Binding PlacementTarget.TemplatedParent.ROIVisible, Converter={StaticResource bv}, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                      <MenuItem Header="{DynamicResource Lang_RoiUnLock}" CommandParameter="True" Command="{Binding PlacementTarget.TemplatedParent.RoiEnableCommand, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" IsEnabled="{Binding PlacementTarget.TemplatedParent.ROIHitTestVisible, Converter={StaticResource negate}, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" Visibility="{Binding PlacementTarget.TemplatedParent.ROIVisible, Converter={StaticResource bv}, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding IsMenuVisible, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Viewbox>
        </Canvas>
        <Canvas Name="above" IsHitTestVisible="False" Visibility="{Binding GriddingVisibility, RelativeSource={RelativeSource Mode=TemplatedParent}}">
          <Path Stroke="#AF000000" StrokeThickness="0.5" Data="{Binding GriddingGeometry, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
        </Canvas>
        <Canvas Name="ExtenAbove">
          <Image Name="pointsImage" IsHitTestVisible="False" Stretch="None" SnapsToDevicePixels="True" />
        </Canvas>
        <Grid Name="MousePanel" IsHitTestVisible="False" Height="Auto" MinHeight="25" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
          <Panel.Background>
            <SolidColorBrush Color="Black" Opacity="0.25" />
          </Panel.Background>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Name="colImageName" Width="130" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
            <TextBlock Foreground="{DynamicResource LogForeground}" FontFamily="Microsoft YaHei" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap">
              <TextBlock.Text>
                <MultiBinding StringFormat=" {0} * {1}{2}{3}  | ">
                  <Binding Path="ImageSourceWidth" Mode="OneWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageSourceHeight" Mode="OneWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="PixelInfoLabel" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="PixelInfo" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource LogForeground}" FontFamily="Microsoft YaHei" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap">
              <TextBlock.Text>
                <MultiBinding StringFormat=" R:{0:D3}  G:{1:D3}  B:{2:D3}  ">
                  <Binding Path="PixelR" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="PixelG" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="PixelB" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource LogForeground}" FontFamily="Microsoft YaHei" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Visibility="{Binding CordinateShow, ElementName=us, Converter={StaticResource Cor2PixelVisibleConverter}}">
              <TextBlock.Text>
                <MultiBinding StringFormat="|  X,{0:D4}  Y,{1:D4}  ">
                  <Binding Path="PixelX" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="PixelY" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Grid.Column="1" Foreground="{DynamicResource LogForeground}" FontFamily="Microsoft YaHei" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" TextAlignment="Right" TextWrapping="Wrap" Visibility="{Binding CordinateShow, ElementName=us, Converter={StaticResource Cor2PhysicalVisibleConverter}}">
              <TextBlock.Text>
                <MultiBinding StringFormat="|  WX,{0}  WY,{1}  ">
                  <Binding Path="PhysicalX" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="PhysicalY" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource LogForeground}" FontFamily="Microsoft YaHei" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,0" TextAlignment="Right" Text="{Binding RangeValue, StringFormat=|  Value:{0:D}, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding IsShowRangeImage, Converter={StaticResource bv}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
          </StackPanel>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Grid}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding IsDisplayPixelAuto, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Grid>
        <TextBlock Foreground="{DynamicResource LogForeground}" FontFamily="Microsoft YaHei" FontSize="12" Height="22" MaxWidth="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,0" Text="{Binding ImageName, RelativeSource={RelativeSource Mode=TemplatedParent}}" ToolTip="{Binding Text, RelativeSource={RelativeSource self}}" />
        <Grid Visibility="{Binding SplotVis, Converter={StaticResource bv}, RelativeSource={RelativeSource Mode=TemplatedParent}}" PreviewMouseLeftButtonDown="mROIView_MouseLeftButtonDown" MouseLeftButtonDown="mouseLBDown2" MouseLeftButtonUp="mouseLBUp2" MouseRightButtonDown="sImage_MouseRightButtonDown2">
          <ContentControl Name="ContentControlW" ContentTemplateSelector="{StaticResource AdditionWSelector}" Content="{Binding}" />
        </Grid>
        <ContentControl Name="ContentControl" ContentTemplateSelector="{StaticResource AdditionSelector}" />
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Value="True" Binding="{Binding IsStateForDrawROI, RelativeSource={RelativeSource Mode=Self}}">
          <Setter TargetName="mROIView" Property="imageview:ROIItemsPage.IsHitTestVisibleOfHost" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ImageName, RelativeSource={RelativeSource Mode=Self}}" Value="{x:Null}">
          <Setter TargetName="colImageName" Property="ColumnDefinition.Width" Value="0" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Control>