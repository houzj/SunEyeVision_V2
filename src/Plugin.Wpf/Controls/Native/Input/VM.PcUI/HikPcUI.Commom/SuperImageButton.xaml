<?xml version="1.0" encoding="utf-8"?>
<Button x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom.SuperImageButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom" Background="#00FFFFFF">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type Button}">
      <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" BorderBrush="#00FFFFFF" BorderThickness="0">
        <ContentPresenter Name="con" Content="{Binding NormalConnent, RelativeSource={RelativeSource TemplatedParent}}" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="UIElement.IsMouseOver" Value="True">
          <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
          <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding MOverConnent, RelativeSource={RelativeSource TemplatedParent}}" />
        </Trigger>
        <Trigger Property="ButtonBase.IsPressed" Value="True">
          <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding PressedConnent, RelativeSource={RelativeSource TemplatedParent}}" />
        </Trigger>
        <Trigger Property="UIElement.IsEnabled" Value="False">
          <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding DisableConnent, RelativeSource={RelativeSource TemplatedParent}}" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Button>