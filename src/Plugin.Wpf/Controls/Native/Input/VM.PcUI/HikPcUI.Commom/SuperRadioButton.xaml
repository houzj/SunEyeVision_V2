<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom.SuperRadioButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="userControl" xmlns:commom="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom;assembly=SunEyeVision.Plugin.Wpf">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="superButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" Content="{Binding NormalConnent, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl}}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding MOverConnent, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl}}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding PressedConnent, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl}}}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding PressedConnent, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl}}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding DisableConnent, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl}}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <RadioButton Name="rb" Style="{StaticResource superButton}" GroupName="defaultGroupName" IsChecked="{Binding IsChecked, ElementName=userControl, Mode=TwoWay}" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked" />
  </Grid>
</UserControl>