<?xml version="1.0" encoding="utf-8"?>
<Grid x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Common.ImageViewController" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Common" xmlns:controls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
        <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF" Visibility="{Binding TitleVisible, ElementName=us}">
    <TextBox Name="itemName" VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="0" Width="75" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBox.Normal.Forground}" Background="#00FFFFFF" Text="{Binding Title, ElementName=us, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ContextMenuOpening="itemName_ContextMenuOpening" KeyDown="itemName_KeyDown" FocusableChanged="itemName_FocusableChanged" LostFocus="itemName_LostFocus">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBox}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Setter Property="UIElement.IsHitTestVisible" Value="False" />
          <Setter Property="Focusable" Value="False" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsReName, ElementName=us}">
              <Setter Property="Visibility" Value="Visible" />
              <Setter Property="UIElement.IsHitTestVisible" Value="True" />
              <Setter Property="Focusable" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBox>
    <TextBlock TextTrimming="CharacterEllipsis" MaxWidth="80" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Background="#00FFFFFF" IsHitTestVisible="False" FontSize="{Binding FontSize, ElementName=itemName}" Foreground="{Binding Foreground, ElementName=itemName}" Text="{Binding Title, ElementName=us}" ToolTip="{Binding Text}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsReName, ElementName=us}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <FrameworkElement.ContextMenu>
      <vm_port_1:HikContextMenu>
        <MenuItem Header="重命名" Click="OnModuleRename" />
      </vm_port_1:HikContextMenu>
    </FrameworkElement.ContextMenu>
  </Grid>
  <UniformGrid Name="g1" HorizontalAlignment="Left" />
  <UniformGrid Columns="4" Width="150" HorizontalAlignment="Right" Visibility="{Binding ZoomVisible, ElementName=us}">
    <controls:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookHikImageView="{Binding ImageView, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ImageViewController}}}" />
    <controls:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookHikImageView="{Binding ImageView, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ImageViewController}}}" />
    <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="zoomOrgBtn_Click" />
    <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="{DynamicResource 全屏}" Click="zoomFullBtn_Click" />
  </UniformGrid>
</Grid>