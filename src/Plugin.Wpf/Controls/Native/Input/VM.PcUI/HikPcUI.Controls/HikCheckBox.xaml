<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls.HikCheckBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" MouseLeftButtonDown="MouseLeftButtonClick">
  <Grid Name="mainGrid" Cursor="Hand">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="48" />
      <ColumnDefinition Width="auto" />
    </Grid.ColumnDefinitions>
    <Image Name="imgName" Width="48" Height="32" Grid.Column="0" Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VM.PcUI/resources/swith_off_dark.png" VerticalAlignment="Center" Margin="0,5,0,5" />
    <TextBlock Name="txtName" Grid.Column="1" Height="AUTO" VerticalAlignment="Center" Margin="5,5,0,5" Text="{Binding LblText, ElementName=us}" />
  </Grid>
</UserControl>