<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls.HikHistogram" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" x:Name="userControl" Background="#00FFFFFF" Margin="0,0,0,0" MouseLeftButtonUp="userControl_MouseLeftButtonUp" MouseMove="userControl_MouseMove" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <local:ComboxVisbileConverter x:Key="comboxVisbileConvert" />
      <SolidColorBrush x:Key="Black" Color="#1f0f01" />
      <Style x:Key="ComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#d9d9d9" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="30" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Rectangle Name="Rect" Grid.ColumnSpan="2" Height="0" StrokeThickness="1" Stroke="{DynamicResource Col_Theme}" VerticalAlignment="Bottom" Opacity="0.7" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#474747" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#474747" />
                        <Setter TargetName="Rect" Property="Height" Value="1" />
                        <Setter Property="Foreground" Value="#efefef" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Border Name="Border" Background="#FF474747" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="#1f0e01" CornerRadius="1" Visibility="Collapsed" />
                <TextBox Grid.Column="0" Focusable="False" Foreground="{TemplateBinding Control.Foreground}" FontSize="{TemplateBinding Control.FontSize}" Margin="11,0,0,0" Background="#00FFFFFF" Text="{TemplateBinding ComboBox.Text}" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{DynamicResource TextBoxStyle1}" />
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{DynamicResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#1f0e01" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#252525" />
                          <GradientStop Offset="0.15" Color="#252525" />
                          <GradientStop Offset="1" Color="#252525" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#1f0e01" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                      </UIElement.Effect>
                      <UIElement.RenderTransform>
                        <TranslateTransform X="-4" />
                      </UIElement.RenderTransform>
                      <ScrollViewer Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
                <Path Name="InnerShadow" Data="M166,181 L183,325" Margin="0,1,0,0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Stretch="Fill" Height="1" Stroke="#FFFFFFFF" Opacity="0.1" Visibility="Collapsed" Width="{Binding ActualWidth, ElementName=Border}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="{StaticResource Black}" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#474747" />
                  <Setter TargetName="Border" Property="Visibility" Value="Visible" />
                  <Setter TargetName="InnerShadow" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="{StaticResource Black}" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#474747" />
                  <Setter TargetName="InnerShadow" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ComboBox Name="cmbHistogramTypes" Style="{StaticResource ComboBoxStyle}" FontSize="12" MaxWidth="256" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,3" DisplayMemberPath="DisplayValue" SelectedValuePath="Key" Visibility="{Binding HistogramTypes.Count, ElementName=userControl, Converter={StaticResource comboxVisbileConvert}}" ItemsSource="{Binding HistogramTypes, ElementName=userControl, Mode=OneWay}" SelectionChanged="cmbHistogramTypes_SelectionChanged" DropDownOpened="cmbHistogramTypes_DropDownOpened" />
        <Grid Row="1" ZIndex="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="7" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#FF262829" BorderThickness="2" Grid.Row="0">
            <Viewbox Name="viewbox" Stretch="Fill" SizeChanged="Viewbox_SizeChanged">
              <Canvas Name="view" Width="256" Height="256" SnapsToDevicePixels="True" UseLayoutRounding="False">
                <Path Name="histogramData" Stretch="None" Fill="#67696D">
                  <Path.Data>
                    <GeometryGroup>
                      <PathGeometry>
                        <PathFigure x:Name="pathFigure" IsClosed="True">
                          <PolyLineSegment x:Name="polyLine" />
                          <LineSegment Point="256,0" />
                          <LineSegment Point="0,0" />
                        </PathFigure>
                      </PathGeometry>
                    </GeometryGroup>
                  </Path.Data>
                </Path>
                <Path Name="PointLine" StrokeThickness="2" Stroke="#0BA35A" Stretch="None">
                  <Path.Data>
                    <LineGeometry x:Name="PathLine" StartPoint="0,0" EndPoint="0,255" />
                  </Path.Data>
                </Path>
                <Path Name="PointCirle" Fill="#FFD201">
                  <Path.Data>
                    <EllipseGeometry x:Name="PathCirle" RadiusX="4" RadiusY="4" />
                  </Path.Data>
                </Path>
                <TextBlock Name="PointLable" Foreground="#E2E4E6" FontSize="15" Padding="6" TextOptions.TextFormattingMode="Ideal" SizeChanged="PointLable_SizeChanged">
                  <FrameworkElement.LayoutTransform>
                    <ScaleTransform ScaleY="-1" />
                  </FrameworkElement.LayoutTransform>
                  <UIElement.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="2" />
                  </UIElement.Effect>
                  <TextBlock.Background>
                    <SolidColorBrush Color="DarkGray" Opacity="0.5" />
                  </TextBlock.Background>
                </TextBlock>
                <localcontrol:SquareArea x:Name="move" Y="256" X="0" BorderBrush="#0BA35A" />
                <FrameworkElement.LayoutTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleY="-1" />
                  </TransformGroup>
                </FrameworkElement.LayoutTransform>
              </Canvas>
            </Viewbox>
            <Border.Background>
              <VisualBrush Stretch="None" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,14,14">
                <VisualBrush.Visual>
                  <Image Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VM.PcUI/resources/gridbrushimg.png" />
                </VisualBrush.Visual>
              </VisualBrush>
            </Border.Background>
          </Border>
          <Grid Row="1">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF000000" Offset="0" />
                <GradientStop Color="#FFE9EBF0" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
          </Grid>
          <TextBlock Grid.Row="2" HorizontalAlignment="Left" FontSize="13" VerticalAlignment="Center" Foreground="#99E2E4E6" FontFamily="Microsoft YaHei">0</TextBlock>
          <TextBlock Grid.Row="2" HorizontalAlignment="Right" FontSize="13" VerticalAlignment="Center" Foreground="#99E2E4E6" FontFamily="Microsoft YaHei">255</TextBlock>
        </Grid>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>