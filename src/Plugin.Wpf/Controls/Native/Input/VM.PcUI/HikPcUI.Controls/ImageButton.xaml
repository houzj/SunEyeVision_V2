<?xml version="1.0" encoding="utf-8"?>
<Button x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls.ImageButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" xmlns:ct="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Converts" x:Name="userControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ct:StringToImageSourceConverter x:Key="stringToImage" />
      <Style x:Key="{x:Type local:ImageButton}" TargetType="{x:Type local:ImageButton}">
        <Setter Property="Background" Value="#5B5E63" />
        <Setter Property="BorderBrush" Value="#242424" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#e6e6e6" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type local:ImageButton}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                  <Image Stretch="None" Source="{Binding Source, ElementName=userControl, Converter={StaticResource stringToImage}}" />
                  <ContentPresenter Margin="3 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Background" Value="#80D6D5D4" />
                  <Setter Property="BorderBrush" Value="#80B6B4B4" />
                  <Setter Property="Foreground" Value="#80666666" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
</Button>