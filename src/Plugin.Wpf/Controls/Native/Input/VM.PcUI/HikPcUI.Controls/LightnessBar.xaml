<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls.LightnessBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" x:Name="UC_Arrange" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}}" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Numeric/PcUi/SliderArrangeDictionary.xaml" />
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Numeric/PcUi/SliderArrangeDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SliderStyle1" TargetType="{x:Type Slider}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TickBar Name="TopTick" Fill="{TemplateBinding Control.Foreground}" Height="4" Placement="Top" Grid.Row="0" Visibility="Collapsed" />
                  <TickBar Name="BottomTick" Fill="{TemplateBinding Control.Foreground}" Height="4" Placement="Bottom" Grid.Row="2" Visibility="Collapsed" Opacity="0" />
                  <Border Name="TrackBackground" Visibility="Collapsed" BorderThickness="1" CornerRadius="1" Height="4.0" Margin="5,0" Grid.Row="1" VerticalAlignment="center" BorderBrush="{StaticResource HorizontalSliderTrackNormalBorder}" Background="{StaticResource HorizontalSliderTrackNormalBackground}">
                    <Canvas Margin="-6,-1">
                      <Rectangle Name="PART_SelectionRange" Height="4.0" Stroke="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" StrokeThickness="0" Visibility="Hidden" Fill="#FF4C4C4C" OpacityMask="{x:Null}" />
                    </Canvas>
                  </Border>
                  <Track Name="PART_Track" Grid.Row="1">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#FFD6CFCF" BorderBrush="#FFB8ADAD" Foreground="#FF807C7C" Visibility="Collapsed" BorderThickness="0" Cursor="Arrow" ClipToBounds="False" Style="{StaticResource SliderRepeatButtonStyle}" OpacityMask="{x:Null}" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}" Click="RepeatButton_Click" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static Slider.IncreaseLarge}" ClickMode="Press" Opacity="1" Visibility="Collapsed" Style="{StaticResource SliderRepeatButtonStyle}" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}" Click="RepeatButton_Click" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Name="Thumb" Visibility="Visible" Opacity="1" BorderThickness="2" Style="{StaticResource HorizontalSliderDownThumbStyle}" BorderBrush="{x:Null}" Foreground="{x:Null}" OpacityMask="{x:Null}" Background="{x:Null}" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}" PreviewMouseLeftButtonUp="Thumb_MouseLeftButtonUp" PreviewMouseLeftButtonDown="Thumb_MouseLeftButtonDown" />
                    </Track.Thumb>
                  </Track>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Slider.TickPlacement" Value="TopLeft">
                  <Setter TargetName="Thumb" Property="Style" Value="{StaticResource HorizontalSliderUpThumbStyle}" />
                  <Setter TargetName="TrackBackground" Property="Margin" Value="5,2,5,0" />
                </Trigger>
                <Trigger Property="Slider.TickPlacement" Value="BottomRight">
                  <Setter TargetName="Thumb" Property="Style" Value="{StaticResource HorizontalSliderDownThumbStyle}" />
                  <Setter TargetName="TrackBackground" Property="Margin" Value="5,0,5,2" />
                </Trigger>
                <Trigger Property="Slider.TickPlacement" Value="Both">
                  <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                  <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Slider.IsSelectionRangeEnabled" Value="True">
                  <Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Thumb" Property="Foreground" Value="#FF0000FF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Slider.Orientation" Value="Vertical">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                  <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition MinWidth="{TemplateBinding FrameworkElement.MinWidth}" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TickBar Name="TopTick" Grid.Column="0" Fill="{TemplateBinding Control.Foreground}" Placement="Left" Visibility="Collapsed" Width="4" />
                      <TickBar Name="BottomTick" Grid.Column="2" Fill="{TemplateBinding Control.Foreground}" Placement="Right" Visibility="Collapsed" Width="4" />
                      <Border Name="TrackBackground" Visibility="Collapsed" BorderThickness="1" Grid.Column="1" CornerRadius="1" HorizontalAlignment="center" Margin="0,5" Width="4.0" BorderBrush="{StaticResource VerticalSliderTrackNormalBorder}" Background="{StaticResource HorizontalSliderTrackNormalBackground}">
                        <Canvas Margin="-1,-6">
                          <Rectangle Name="PART_SelectionRange" Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Stroke="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" StrokeThickness="1.0" Visibility="Hidden" Width="4.0" />
                        </Canvas>
                      </Border>
                      <Track Name="PART_Track" Grid.Column="1">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Visibility="Collapsed" Style="{StaticResource SliderRepeatButtonStyle}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Visibility="Collapsed" Style="{StaticResource SliderRepeatButtonStyle}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                          <Thumb Name="Thumb" Style="{StaticResource VerticalSliderThumbStyle}" />
                        </Track.Thumb>
                      </Track>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="Slider.TickPlacement" Value="TopLeft">
                      <Setter TargetName="Thumb" Property="Style" Value="{StaticResource VerticalSliderLeftThumbStyle}" />
                      <Setter TargetName="TrackBackground" Property="Margin" Value="2,5,0,5" />
                    </Trigger>
                    <Trigger Property="Slider.TickPlacement" Value="BottomRight">
                      <Setter TargetName="Thumb" Property="Style" Value="{StaticResource VerticalSliderRightThumbStyle}" />
                      <Setter TargetName="TrackBackground" Property="Margin" Value="0,5,2,5" />
                    </Trigger>
                    <Trigger Property="Slider.TickPlacement" Value="Both">
                      <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                      <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="Slider.IsSelectionRangeEnabled" Value="True">
                      <Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                      <Setter TargetName="Thumb" Property="Foreground" Value="#FF0000FF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Name="imagGrid" Row="0" Margin="0,28,10,0">
          <Panel.Background>
            <ImageBrush ImageSource="{Binding BgImage, ElementName=UC_Arrange}" />
          </Panel.Background>
          <Viewbox Name="viewbox" Stretch="None">
            <Canvas Name="view" SnapsToDevicePixels="True" UseLayoutRounding="False" Width="{Binding ActualWidth, ElementName=imagGrid}" Height="{Binding ActualHeight, ElementName=imagGrid}">
              <Path Name="iLowPointLine" StrokeThickness="2" Stroke="#FFFFFF" Stretch="None">
                <Path.Data>
                  <LineGeometry x:Name="iLowPathLine" StartPoint="0,0" EndPoint="0,20" />
                </Path.Data>
              </Path>
              <Path Name="iHighPointLine" StrokeThickness="2" Stroke="#FFFFFF" Stretch="None">
                <Path.Data>
                  <LineGeometry x:Name="iHighPathLine" StartPoint="255,0" EndPoint="255,20" />
                </Path.Data>
              </Path>
              <FrameworkElement.LayoutTransform>
                <TransformGroup>
                  <ScaleTransform ScaleY="-1" />
                </TransformGroup>
              </FrameworkElement.LayoutTransform>
            </Canvas>
          </Viewbox>
        </Grid>
        <Grid Row="1" Margin="0,-10,0,0">
          <Slider Name="SL_Bat1" KeyboardNavigation.DirectionalNavigation="None" Minimum="0" Maximum="255" Margin="-10,0,0,0" Height="22" TickFrequency="1" IsSelectionRangeEnabled="True" TickPlacement="TopLeft" IsSnapToTickEnabled="True" VerticalAlignment="Center" Style="{DynamicResource SliderStyle1}" SmallChange="1" LargeChange="1" Background="#00FFFFFF" Value="{Binding ElementName=UC_Arrange, Path=ILow}" Width="{Binding Width, ElementName=UC_Arrange}" FocusVisualStyle="{x:Null}" Clip="{Binding ElementName=UC_Arrange, Path=StartRectClip}" ValueChanged="SL_Bat1_ValueChanged" />
          <Slider Name="SL_Bat2" Visibility="Visible" Minimum="0" Maximum="255" Margin="-10,0,0,0" Height="22" TickFrequency="1" IsSelectionRangeEnabled="True" TickPlacement="TopLeft" IsSnapToTickEnabled="True" VerticalAlignment="Center" SmallChange="1" LargeChange="1" Style="{DynamicResource SliderStyle1}" Background="#00FFFFFF" Value="{Binding ElementName=UC_Arrange, Path=IHigh}" Width="{Binding Width, ElementName=UC_Arrange}" FocusVisualStyle="{x:Null}" Clip="{Binding ElementName=UC_Arrange, Path=EndRectClip}" ValueChanged="SL_Bat2_ValueChanged" />
        </Grid>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>