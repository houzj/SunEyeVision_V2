	public double StrokeThicknessR => StrokeThickness / ScaleRatio;

	public double Line1Point1XR => (Line1Point1X + 0.5) * Ratio;

	public double Line1Point1YR => (Line1Point1Y + 0.5) * Ratio;

	public double Line1Point2XR => (Line1Point2X + 0.5) * Ratio;

	public double Line1Point2YR => (Line1Point2Y + 0.5) * Ratio;

	public double Line2Point1XR => (Line2Point1X + 0.5) * Ratio;

	public double Line2Point1YR => (Line2Point1Y + 0.5) * Ratio;

	public double Line2Point2XR => (Line2Point2X + 0.5) * Ratio;

	public double Line2Point2YR => (Line2Point2Y + 0.5) * Ratio;

	public double IntersectionXR => (IntersectionX + 0.5) * Ratio;

	public double IntersectionYR => (IntersectionY + 0.5) * Ratio;

