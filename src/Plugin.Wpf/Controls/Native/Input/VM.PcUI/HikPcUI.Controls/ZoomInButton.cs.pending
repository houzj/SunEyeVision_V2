using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView;

namespace SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls;

public class ZoomInButton : Button
{
	public static readonly DependencyProperty HookHikImageViewProperty;

	public static readonly DependencyProperty HookImageViewBoxProperty;

	public HikImageView HookHikImageView
	{
		get
		{
			return (HikImageView)GetValue(HookHikImageViewProperty);
		}
		set
		{
			SetValue(HookHikImageViewProperty, value);
		}
	}

	public FrameworkElement HookImageViewBox
	{
		get
		{
			return (FrameworkElement)GetValue(HookImageViewBoxProperty);
		}
		set
		{
			SetValue(HookImageViewBoxProperty, value);
		}
	}

	private static void CallBack(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		Button targetElement = d as Button;
		if (e.NewValue != null)
		{
			BindingHelper.BindingPath("EnableZoomIn", "IsEnabled", e.NewValue, BindingMode.TwoWay, targetElement);
		}
	}

	static ZoomInButton()
	{
		HookHikImageViewProperty = DependencyProperty.Register("HookHikImageView", typeof(HikImageView), typeof(ZoomInButton), new PropertyMetadata(null, CallBack));
		HookImageViewBoxProperty = DependencyProperty.Register("HookImageViewBox", typeof(FrameworkElement), typeof(ZoomInButton), new PropertyMetadata(null, CallBack));
		FrameworkElement.DefaultStyleKeyProperty.OverrideMetadata(typeof(ZoomInButton), new FrameworkPropertyMetadata(typeof(ZoomInButton)));
	}

	protected override void OnClick()
	{
		base.OnClick();
		if (HookHikImageView != null)
		{
			HookHikImageView.Shrink();
		}
		if (HookImageViewBox != null)
		{
			HookImageViewBox.GetType().GetMethod("Shrink")?.Invoke(HookImageViewBox, null);
		}
	}
}
