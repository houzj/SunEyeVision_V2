	}

	private static void OnStartPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).OnChangedStartPoint();
	}

	private void OnChangedStartPoint()
	{
		NotifyPropertyChanged("StartArrowPoint");
		ChangeRadiusArrowAngle();
	}

	private void ChangeRadiusArrowAngle()
	{
		Vector vector = new Vector(StartPoint.X - Radius, StartPoint.Y - Radius);
		Vector vector2 = new Vector(EndPoint.X - Radius, EndPoint.Y - Radius);
		double num = ((ClockWise == SweepDirection.Clockwise) ? Vector.AngleBetween(vector, vector2) : Vector.AngleBetween(vector2, vector));
		if (num < 0.0)
		{
			num += 360.0;
		}
		if (StartAngle == EndAngle)
		{
			num = 360.0;
		}
		RadiusArrowAngle = ((ClockWise == SweepDirection.Clockwise) ? (num * 2.0 / 3.0 + StartAngle + 90.0) : (StartAngle - num * 2.0 / 3.0 - 90.0));
	}

	private static void OnEndPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).OnChangedEndPoint();
	}

	private void OnChangedEndPoint()
	{
		NotifyPropertyChanged("EndArrowPoint");
		ChangeRadiusArrowAngle();
	}

	private static void OnStartAngleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).IsParamChanged = true;
		(d as HikCircleArc).OnChangStartAngle();
	}

	private void OnChangStartAngle()
	{
		if (StartAngle == EndAngle)
		{
			PathFillColor2.Visibility = Visibility.Visible;
		}
		else
		{
			PathFillColor2.Visibility = Visibility.Collapsed;
		}
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = StartAngle;
		StartPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		System.Windows.Point point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		startAngle.X = point.X;
		startAngle.Y = point.Y;
		ChangeLargeArc();
		Relocation_Rec12();
	}

	private void Relocation_Rec12()
	{
		Vector vector = new Vector(StartPoint.X - Radius, StartPoint.Y - Radius);
		Vector vector2 = new Vector(EndPoint.X - Radius, EndPoint.Y - Radius);
		double num = ((ClockWise == SweepDirection.Clockwise) ? Vector.AngleBetween(vector, vector2) : Vector.AngleBetween(vector2, vector));
		if (num < 0.0)
		{
			num += 360.0;
		}
		if (StartAngle == EndAngle)
		{
			num = 360.0;
		}
		RotateTransform rotateTransform = new RotateTransform();
		rotateTransform.CenterX = Radius;
		rotateTransform.CenterY = Radius;
		rotateTransform.Angle = ((ClockWise == SweepDirection.Clockwise) ? (num / 2.0) : ((0.0 - num) / 2.0));
		System.Windows.Point point = rotateTransform.Transform(StartPoint);
		rec1.X = point.X;
		rec1.Y = point.Y;
	}

	private static void OnEndAngleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).IsParamChanged = true;
		(d as HikCircleArc).OnChangEndAngle();
	}

	private void OnChangEndAngle()
	{
		if (StartAngle == EndAngle)
		{
			PathFillColor2.Visibility = Visibility.Visible;
		}
		else
		{
			PathFillColor2.Visibility = Visibility.Collapsed;
		}
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = EndAngle;
		EndPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		System.Windows.Point point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		endAngle.X = point.X;
		endAngle.Y = point.Y;
		ChangeLargeArc();
		Relocation_Rec12();
	}

	private void ChangeLargeArc()
	{
		double num = ((EndAngle <= 0.0) ? (0.0 - EndAngle) : (360.0 - EndAngle));
		double num2 = ((StartAngle < 0.0) ? (360.0 + StartAngle) : StartAngle);
		bool flag = (num2 + num) % 360.0 <= 180.0;
		if (ClockWise == SweepDirection.Counterclockwise)
		{
			flag = !flag;
		}
		IsLargeArc = flag;
	}

	private static void OnTCenterPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).IsParamChanged = true;
		System.Windows.Point centerPoint = (System.Windows.Point)e.NewValue;
		double radio = (d as HikCircleArc).owner.Radio;
		centerPoint.X = (centerPoint.X + 0.5) * radio;
		centerPoint.Y = (centerPoint.Y + 0.5) * radio;
		(d as HikCircleArc).CenterPoint = centerPoint;
	}

	private static void OnCenterPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).OnChangCenterPoint();
	}

	private void OnChangCenterPoint()
	{
		double radio = owner.Radio;
		TCenterPoint = new System.Windows.Point(CenterPoint.X / radio - 0.5, CenterPoint.Y / radio - 0.5);
		double num = CenterPoint.X - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = CenterPoint.Y - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
	}

	private static void OnTRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).IsParamChanged = true;
		(d as HikCircleArc).Radius = (double)e.NewValue * (d as HikCircleArc).owner.Radio;
	}

	private static void OnRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleArc).OnChangRadius((double)e.OldValue);
	}

	private void OnChangRadius(double oldRadius)
	{
		TRadius = Radius / owner.Radio;
		Width = 2.0 * Radius;
		Height = 2.0 * Radius;
		MyCenterPoint = new System.Windows.Point(Radius, Radius);
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = StartAngle;
		StartPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		tlt.Angle = EndAngle;
		EndPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		MaxSize = new System.Windows.Size(Radius, Radius);
		double num = CenterPoint.X - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = CenterPoint.Y - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
		tlt.Angle = StartAngle;
		tlt.Angle = EndAngle;
		tlt.Angle = EndAngle;
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		System.Windows.Point point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		endAngle.X = point.X;
		endAngle.Y = point.Y;
		tlt.Angle = StartAngle;
		point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		startAngle.X = point.X;
		startAngle.Y = point.Y;
		Relocation_Rec12();
		NotifyPropertyChanged("RadiusArrowPoint");
	}

	public static void OnDrawROISubstitute_MouseMove(object sender, MouseEventArgs e)
	{
		if (Owner != null && Owner.SourceImage.Source != null)
		{
			if (!IsMoved)
			{
				IsMoved = true;
			}
			System.Windows.Point position = e.GetPosition(Owner.SourceImage);
			if (position.X < 0.0)
			{
				position.X = 0.0;
			}
			if (position.Y < 0.0)
			{
				position.Y = 0.0;
			}
			if (position.X > Owner.SourceImage.Width)
			{
				position.X = Owner.SourceImage.Width;
			}
			if (position.Y > Owner.SourceImage.ActualHeight)
			{
				position.Y = Owner.SourceImage.ActualHeight;
			}
			double num = 0.0;
			double num2 = 0.0;
			if (position.X < MouseDownPoint.X)
			{
				num = position.X;
			}
			else
			{
				num = MouseDownPoint.X;
			}
			if (position.Y < MouseDownPoint.Y)
			{
				num2 = position.Y;
			}
			else
			{
				num2 = MouseDownPoint.Y;
			}
			ellipseGeometry.Center = MouseDownPoint;
			double num3 = Math.Sqrt(Math.Pow(position.X - MouseDownPoint.X, 2.0) + Math.Pow(position.Y - MouseDownPoint.Y, 2.0));
			ellipseGeometry.RadiusX = num3;
			ellipseGeometry.RadiusY = num3;
		}
	}

	public static void OnDrawROISubstitute_MouseUp(object sender, MouseEventArgs e)
	{
		if (Owner == null)
		{
			return;
		}
		Owner.IsDrawRoi = false;
		Owner.RemoveROIChild(substitute);
		Owner.SourceImage.ReleaseMouseCapture();
		HikImageView hikImageView = Owner;
		hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
		HikImageView hikImageView2 = Owner;
		hikImageView2.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView2.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
		HikImageView hikImageView3 = Owner;
		hikImageView3.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Remove(hikImageView3.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
		if (IsMoved)
		{
			HikCircleArcRoiParameter hikCircleArcRoiParameter = Owner.DoGetExtendROIParam(RoiUIType.HikCircleArcRoi) as HikCircleArcRoiParameter;
			if (hikCircleArcRoiParameter == null)
			{
				hikCircleArcRoiParameter = new HikCircleArcRoiParameter();
			}
			System.Windows.Point center = ellipseGeometry.Center;
			center.X = center.X / Owner.Radio - 0.5;
			center.Y = center.Y / Owner.Radio - 0.5;
			hikCircleArcRoiParameter.CenterPoint = center;
			hikCircleArcRoiParameter.Radius = ellipseGeometry.RadiusX / Owner.Radio;
			hikCircleArcRoiParameter.MinRadius = 0.0;
			Owner.RoiList.Add(hikCircleArcRoiParameter);
		}
		Owner = null;
		substitute = null;
		ellipseGeometry = null;
	}

	public void Doth(FrameworkElement rectangleArea, MouseEventArgs e)
	{
		IsParamChanged = false;
		isDragging = true;
		curType = rectangleArea.Name;
		curControl = rectangleArea as IArea;
		CaptureMouse();
	}

	private void UserControl_Loaded(object sender, RoutedEventArgs e)
	{
		if (parent == null)
		{
			parent = VisualTreeHelper.GetParent(this) as FrameworkElement;
			parent = VisualTreeHelper.GetParent(parent) as FrameworkElement;
			parent.MouseMove += zparent_MouseMove;
		}
	}

	private void Child_MouseMove(object sender, MouseEventArgs e)
	{
		string name = (sender as FrameworkElement).Name;
		if (name == "rec1" && (rec1.Tag == null || (double)rec1.Tag != EndAngle))
		{
			rec1.Tag = EndAngle;
			Bitmap rotateImage = GetRotateImage(image, (int)(StartAngle + EndAngle) / 2);
			if (rec1.Cursor != null)
			{
				rec1.Cursor.Dispose();
			}
			rec1.Cursor = BitmapCursor.CreateBmpCursor(rotateImage);
		}
	}

	private void zparent_MouseMove(object sender, MouseEventArgs e)
	{
		double num = 0.0;
		double num2 = 0.0;
		if (!isDragging)
		{
			return;
		}
		System.Windows.Point position = e.GetPosition(parent);
		switch (curType)
		{
		case "userControl":
			num = position.Y - CurPoint.Y + Height / 2.0;
			num2 = position.X - CurPoint.X + Width / 2.0;
			CenterPoint = new System.Windows.Point(num2, num);
			break;
		case "rec1":
		{
			System.Windows.Point point15 = position + new Vector(rec1.Width / 2.0 - rec1.CurPoint.X, rec1.Height / 2.0 - rec1.CurPoint.Y);
			System.Windows.Point point16 = new System.Windows.Point(rec1.X, rec1.Y);
			System.Windows.Point startPoint3 = StartPoint;
			System.Windows.Point endPoint3 = EndPoint;
			System.Windows.Point point17 = new System.Windows.Point(Canvas.GetLeft(this), Canvas.GetTop(this));
			System.Windows.Point point18 = StartPoint + new Vector(point17.X, point17.Y);
			System.Windows.Point point19 = EndPoint + new Vector(point17.X, point17.Y);
			Vector vector9 = new Vector(point19.X - point18.X, point19.Y - point18.Y);
			Vector vector10 = new Vector(point18.X - point15.X, point18.Y - point15.Y);
			Vector vector11 = new Vector(point19.X - point15.X, point19.Y - point15.Y);
			double num7 = 0.0;
			double num8 = 0.0;
			Vector vector12;
			if (vector9.Length == 0.0)
			{
				num7 = vector10.Length;
				if (num7 == 0.0)
				{
					break;
				}
				num8 = (num7 * num7 + Math.Pow(vector9.Length / 2.0, 2.0)) / (2.0 * num7);
				vector12 = -vector10;
				vector9 = new Vector(vector12.Y, 0.0 - vector12.X);
				if (Vector.CrossProduct(vector9, vector12) > 0.0 == (ClockWise == SweepDirection.Clockwise))
				{
					vector9 = -vector9;
				}
			}
			else
			{
				num7 = Math.Abs(Vector.CrossProduct(vector10, vector11) / vector9.Length);
				if (num7 == 0.0)
				{
					break;
				}
				num8 = (num7 * num7 + Math.Pow(vector9.Length / 2.0, 2.0)) / (2.0 * num7);
				vector12 = new Vector(vector9.Y, 0.0 - vector9.X);
				if (ClockWise == SweepDirection.Clockwise)
				{
					if (Vector.CrossProduct(vector12, vector9) < 0.0)
					{
						vector12 = -vector12;
					}
				}
				else if (Vector.CrossProduct(vector12, vector9) > 0.0)
				{
					vector12 = -vector12;
				}
			}
			Vector vector13 = vector10 + vector11;
			vector13.Normalize();
			if (Vector.CrossProduct(vector13, vector9) < 0.0 != (ClockWise == SweepDirection.Clockwise))
			{
				vector12 = -vector12;
				System.Windows.Point point20 = point18;
				point18 = point19;
				point19 = point20;
			}
			vector12.Normalize();
			double num9 = 10000.0 * owner.Radio;
			if (!(num8 >= num9))
			{
				Vector vector14 = vector12 * num7;
				System.Windows.Point point21 = new System.Windows.Point((point19.X + point18.X) / 2.0, (point19.Y + point18.Y) / 2.0) + vector14;
				CenterPoint = point21 + -vector12 * num8;
				Radius = num8;
				double num10 = Math.Atan2(point18.Y - CenterPoint.Y, point18.X - CenterPoint.X) * 180.0 / Math.PI;
				double num11 = Math.Atan2(point19.Y - CenterPoint.Y, point19.X - CenterPoint.X) * 180.0 / Math.PI;
				StartAngle = num10;
				EndAngle = num11;
			}
			break;
		}
		case "endAngle":
		{
			System.Windows.Point point8 = new System.Windows.Point(rec1.X, rec1.Y);
			System.Windows.Point startPoint2 = StartPoint;
			System.Windows.Point endPoint2 = EndPoint;
			System.Windows.Point point9 = new System.Windows.Point(Canvas.GetLeft(this), Canvas.GetTop(this));
			System.Windows.Point point10 = StartPoint + new Vector(point9.X, point9.Y);
			System.Windows.Point point11 = EndPoint + new Vector(point9.X, point9.Y);
			System.Windows.Point point12 = new System.Windows.Point((startPoint2.X + endPoint2.X) / 2.0, (startPoint2.Y + endPoint2.Y) / 2.0);
			double length2 = new Vector(point12.X - point8.X, point12.Y - point8.Y).Length;
			if (length2 == 0.0)
			{
				break;
			}
			System.Windows.Point point13 = position + new Vector(endAngle.Width / 2.0 - endAngle.CurPoint.X, endAngle.Height / 2.0 - endAngle.CurPoint.Y);
			Vector vector5 = new Vector(point13.X - point10.X, point13.Y - point10.Y);
			double num5 = (length2 * length2 + Math.Pow(vector5.Length / 2.0, 2.0)) / (2.0 * length2);
			double num6 = 10000.0 * owner.Radio;
			if (num5 >= num6)
			{
				break;
			}
			Vector vector7;
			if (vector5.Length == 0.0)
			{
				Vector vector6 = new Vector(point10.X - CenterPoint.X, point10.Y - CenterPoint.Y);
				vector7 = -vector6;
				vector5 = new Vector(vector7.Y, 0.0 - vector7.X);
				if (Vector.CrossProduct(vector5, vector7) > 0.0 == (ClockWise == SweepDirection.Clockwise))
				{
					vector5 = -vector5;
				}
			}
			else
			{
				vector7 = new Vector(vector5.Y, 0.0 - vector5.X);
			}
			if (Vector.CrossProduct(vector7, vector5) < 0.0 == (ClockWise == SweepDirection.Clockwise))
			{
				vector7 = -vector7;
			}
			vector7.Normalize();
			Vector vector8 = vector7 * length2;
			System.Windows.Point point14 = new System.Windows.Point((point13.X + point10.X) / 2.0, (point13.Y + point10.Y) / 2.0) + vector8;
			CenterPoint = point14 + -vector7 * num5;
			Radius = num5;
			StartAngle = Math.Atan2(point10.Y - CenterPoint.Y, point10.X - CenterPoint.X) * 180.0 / Math.PI;
			EndAngle = Math.Atan2(point13.Y - CenterPoint.Y, point13.X - CenterPoint.X) * 180.0 / Math.PI;
			DealAngleAfter(IsEnd: true);
			break;
		}
		case "startAngle":
		{
			System.Windows.Point point = new System.Windows.Point(rec1.X, rec1.Y);
			System.Windows.Point startPoint = StartPoint;
			System.Windows.Point endPoint = EndPoint;
			System.Windows.Point point2 = new System.Windows.Point(Canvas.GetLeft(this), Canvas.GetTop(this));
			System.Windows.Point point3 = StartPoint + new Vector(point2.X, point2.Y);
			System.Windows.Point point4 = EndPoint + new Vector(point2.X, point2.Y);
			System.Windows.Point point5 = new System.Windows.Point((startPoint.X + endPoint.X) / 2.0, (startPoint.Y + endPoint.Y) / 2.0);
			double length = new Vector(point5.X - point.X, point5.Y - point.Y).Length;
			if (length == 0.0)
			{
				break;
			}
			System.Windows.Point point6 = position + new Vector(startAngle.Width / 2.0 - startAngle.CurPoint.X, startAngle.Height / 2.0 - startAngle.CurPoint.Y);
			Vector vector = new Vector(point6.X - point4.X, point6.Y - point4.Y);
			double num3 = (length * length + Math.Pow(vector.Length / 2.0, 2.0)) / (2.0 * length);
			double num4 = 10000.0 * owner.Radio;
			if (num3 >= num4)
			{
				break;
			}
			Vector vector3;
			if (vector.Length == 0.0)
			{
				Vector vector2 = new Vector(point3.X - CenterPoint.X, point3.Y - CenterPoint.Y);
				vector3 = -vector2;
				vector = new Vector(vector3.Y, 0.0 - vector3.X);
				if (Vector.CrossProduct(vector, vector3) < 0.0 == (ClockWise == SweepDirection.Clockwise))
				{
					vector = -vector;
				}
			}
			else
			{
				vector3 = new Vector(vector.Y, 0.0 - vector.X);
			}
			if (Vector.CrossProduct(vector3, vector) > 0.0 == (ClockWise == SweepDirection.Clockwise))
			{
				vector3 = -vector3;
			}
			vector3.Normalize();
			Vector vector4 = vector3 * length;
			System.Windows.Point point7 = new System.Windows.Point((point6.X + point4.X) / 2.0, (point6.Y + point4.Y) / 2.0) + vector4;
			CenterPoint = point7 + -vector3 * num3;
			Radius = num3;
			StartAngle = Math.Atan2(point6.Y - CenterPoint.Y, point6.X - CenterPoint.X) * 180.0 / Math.PI;
			EndAngle = Math.Atan2(point4.Y - CenterPoint.Y, point4.X - CenterPoint.X) * 180.0 / Math.PI;
			DealAngleAfter(IsEnd: false);
			break;
		}
		}
	}

	private void DealAngleAfter(bool IsEnd)
	{
		if (Math.Abs(StartAngle) == 180.0 && Math.Abs(EndAngle) == 180.0)
		{
			if (IsEnd)
			{
				EndAngle = StartAngle;
			}
			else
			{
				StartAngle = EndAngle;
			}
		}
		else if (Math.Abs(EndAngle - StartAngle) < 2.0 * Scale)
		{
			if (IsEnd)
			{
				EndAngle = StartAngle;
			}
			else
			{
				StartAngle = EndAngle;
			}
		}
	}

	private void UserControl_MouseEnter(object sender, MouseEventArgs e)
	{
		rec1.Opacity = 1.0;
		startAngle.Opacity = 1.0;
		endAngle.Opacity = 1.0;
	}

	private void UserControl_MouseLeave(object sender, MouseEventArgs e)
	{
		rec1.Opacity = 0.0;
		startAngle.Opacity = 0.0;
		endAngle.Opacity = 0.0;
	}

	public void DoCallBack()
	{
		if (OnTheSizeChange != null)
		{
			OnTheSizeChange(DataContext);
		}
	}

	private void UserControl_MouseUp(object sender, MouseButtonEventArgs e)
	{
		if (isDragging)
		{
			if (curControl != null)
			{
				curControl.IsPressed = false;
			}
			isDragging = false;
			if (IsParamChanged)
			{
				DoCallBack();
			}
			ReleaseMouseCapture();
		}
	}

	private void UserControl_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (!DoDragROI(e))
		{
			if (ownerCanvas != null && ownerCanvas is ROIContainer rOIContainer)
			{
				rOIContainer.SelectionService.RoiSelected(DataContext);
			}
			else
			{
				owner.SelectionService.RoiSelected(DataContext);
			}
			Focus();
			if (!isDragging)
			{
				CurPoint = e.GetPosition(this);
				Doth(this, e);
				owner.DoRoiClick(this, e);
			}
		}
	}

	[DebuggerNonUserCode]
	[GeneratedCode("PresentationBuildTasks", "4.0.0.0")]
	internal Delegate _CreateDelegate(Type delegateType, string handler)
	{
		return Delegate.CreateDelegate(delegateType, this, handler);
	}
