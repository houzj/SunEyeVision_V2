	public double StartArrowAngle => Math.Atan2(StartPoint.Y - MinStartPoint.Y, StartPoint.X - MinStartPoint.X) * 180.0 / Math.PI;

	public double EndArrowAngle => Math.Atan2(EndPoint.Y - MinEndPoint.Y, EndPoint.X - MinEndPoint.X) * 180.0 / Math.PI;

	public System.Windows.Point StartArrowPoint
	{
		get
		{
			NotifyPropertyChanged("StartArrowAngle");
			return new System.Windows.Point((StartPoint.X + MinStartPoint.X) / 2.0, (StartPoint.Y + MinStartPoint.Y) / 2.0);
		}
	}

	public System.Windows.Point EndArrowPoint
	{
		get
		{
			NotifyPropertyChanged("EndArrowAngle");
			return new System.Windows.Point((EndPoint.X + MinEndPoint.X) / 2.0, (EndPoint.Y + MinEndPoint.Y) / 2.0);
		}
	}

	public double RadiusArrowAngle
	{
		get
		{
			return _RadiusArrowAngle;
		}
		set
		{
			if (_RadiusArrowAngle != value)
			{
				_RadiusArrowAngle = value;
				NotifyPropertyChanged("RadiusArrowPoint");
				NotifyPropertyChanged("MinRadiusArrowPoint");
				NotifyPropertyChanged("RadiusArrowAngle");
			}
		}
	}

	public System.Windows.Point RadiusArrowPoint
	{
		get
		{
			RotateTransform rotateTransform = new RotateTransform();
			rotateTransform.CenterX = Radius;
			rotateTransform.CenterY = Radius;
			rotateTransform.Angle = ((ClockWise == SweepDirection.Clockwise) ? (_RadiusArrowAngle - StartAngle - 90.0) : (StartAngle - _RadiusArrowAngle - 90.0));
			return (ClockWise == SweepDirection.Clockwise) ? rotateTransform.Transform(StartPoint) : rotateTransform.Inverse.Transform(StartPoint);
		}
	}

	public System.Windows.Point MinRadiusArrowPoint
	{
		get
		{
			RotateTransform rotateTransform = new RotateTransform();
			rotateTransform.CenterX = Radius;
			rotateTransform.CenterY = Radius;
			rotateTransform.Angle = ((ClockWise == SweepDirection.Clockwise) ? (_RadiusArrowAngle - StartAngle - 90.0) : (StartAngle - _RadiusArrowAngle - 90.0));
			return (ClockWise == SweepDirection.Clockwise) ? rotateTransform.Transform(MinStartPoint) : rotateTransform.Inverse.Transform(MinStartPoint);
		}
	}

