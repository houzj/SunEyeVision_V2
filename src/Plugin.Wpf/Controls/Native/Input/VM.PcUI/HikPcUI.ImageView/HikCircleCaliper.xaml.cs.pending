	public event PropertyChangedEventHandler PropertyChanged;

	public void NotifyPropertyChanged(string propertyName)
	{
		if (PropertyChanged != null)
		{
			PropertyChanged(this, new PropertyChangedEventArgs(propertyName));
		}
	}

	public void Dispose()
	{
		DeInit();
		if (parent != null)
		{
			parent.MouseMove -= zparent_MouseMove;
		}
	}

	public static void DoFinishSubstitute()
	{
		if (Owner != null)
		{
			Owner.IsDrawRoi = false;
			Owner.RemoveChild(substitute);
			Owner.SourceImage.ReleaseMouseCapture();
			HikImageView hikImageView = Owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
			HikImageView hikImageView2 = Owner;
			hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Remove(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
			HikImageView hikImageView3 = Owner;
			hikImageView3.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView3.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
			Owner = null;
			substitute = null;
			ellipseGeometry = null;
		}
	}

	public static void InitSubstitute(HikImageView view, System.Windows.Point mouseDownPoint)
	{
		Owner = view;
		HikImageView hikImageView = Owner;
		hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
		HikImageView hikImageView2 = Owner;
		hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Combine(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
		HikImageView hikImageView3 = Owner;
		hikImageView3.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Combine(hikImageView3.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
		MouseDownPoint = mouseDownPoint;
		substitute = new System.Windows.Shapes.Path();
		ellipseGeometry = new EllipseGeometry();
		substitute.Data = ellipseGeometry;
		substitute.Stroke = HikROIBase.SubstituteBrush;
		substitute.StrokeThickness = 1.0 / (Owner.ScaleTransform.ScaleX * Owner.ViewScale);
		IsMoved = false;
		Owner.AddROIChild(substitute);
	}

	public HikCircleCaliper()
	{
		InitializeComponent();
		Stream manifestResourceStream = GetType().Assembly.GetManifestResourceStream("VM.PcUI.Resources.鼠标双向箭头.png");
		image = (Bitmap)System.Drawing.Image.FromStream(manifestResourceStream);
		manifestResourceStream.Dispose();
		childControlList.Add(startAngle);
		childControlList.Add(endAngle);
		childControlList.Add(rec1);
		rec1.MouseMove += Child_MouseMove;
		childControlList.Add(rec2);
		rec2.MouseMove += Child_MouseMove;
		childControlList.Add(startArrow);
		childControlList.Add(endArrow);
		childControlList.Add(radiusArrow);
		childControlList.Add(minRadiusArrow);
		childControlList.Add(moveRec1);
		moveRec1.MouseMove += Child_MouseMove;
		childControlList.Add(moveRec2);
		moveRec2.MouseMove += Child_MouseMove;
		childControlList.Add(top_left);
		top_left.MouseMove += Child_MouseMove;
		childControlList.Add(top);
		top.MouseMove += Child_MouseMove;
		childControlList.Add(top_right);
		top_right.MouseMove += Child_MouseMove;
		childControlList.Add(left);
		left.MouseMove += Child_MouseMove;
		childControlList.Add(right);
		right.MouseMove += Child_MouseMove;
		childControlList.Add(bottom_left);
		bottom_left.MouseMove += Child_MouseMove;
		childControlList.Add(bottom);
		bottom.MouseMove += Child_MouseMove;
		childControlList.Add(bottom_right);
		bottom_right.MouseMove += Child_MouseMove;
		foreach (IArea childControl in childControlList)
		{
			childControl.Container = this;
		}
	}

	public void Init()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void DeInit()
	{
		Owner = null;
		substitute = null;
		ellipseGeometry = null;
		if (moveRec1.Cursor != null)
		{
			moveRec1.Cursor.Dispose();
			moveRec1.Cursor = null;
		}
		if (moveRec2.Cursor != null)
		{
			moveRec2.Cursor.Dispose();
			moveRec2.Cursor = null;
		}
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void OnScaleChange(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		double num2 = (TStrokeThickness = (Scale = 1.0 / ((sender as ScaleTransform).ScaleX * num)));
		PathFillColor.StrokeThickness = num2;
		PathFillColor2.StrokeThickness = num2;
		bd.BorderThickness = new Thickness(num2);
		bd.Margin = new Thickness(0.0 - num2);
		double num4 = 8.0 * num2;
		double num5 = num4 / 2.0;
		left.Width = num4;
		left.Margin = new Thickness(0.0, 0.0, 0.0 - num5, 0.0);
		right.Width = num4;
		right.Margin = new Thickness(0.0 - num5, 0.0, 0.0, 0.0);
		top.Height = num4;
		top.Margin = new Thickness(0.0, 0.0, 0.0, 0.0 - num5);
		bottom.Height = num4;
		bottom.Margin = new Thickness(0.0, 0.0 - num5, 0.0, 0.0);
		tb.FontSize = 14.0 * num2;
		DrawCaliper();
	}

	public static void OnScaleChangeSubstitute(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		substitute.StrokeThickness = 1.0 / ((sender as ScaleTransform).ScaleX * num);
	}

	private static void OnClockWiseChange(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).NotifyPropertyChanged("DeClockWise");
	}

	private static void OnMinEndPointChange(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).NotifyPropertyChanged("EndArrowPoint");
	}

	private static void OnMinStartPointChange(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).NotifyPropertyChanged("StartArrowPoint");
		(d as HikCircleCaliper).NotifyPropertyChanged("MinRadiusArrowPoint");
	}

	private static void OnTMinRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).IsParamChanged = true;
		(d as HikCircleCaliper).MinRadius = (double)e.NewValue * (d as HikCircleCaliper).owner.Radio;
	}

	private static void OnMinRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).OnChangMinRadius();
	}

	private void OnChangMinRadius()
	{
		TMinRadius = MinRadius / owner.Radio;
		MinSize = new System.Windows.Size(MinRadius, MinRadius);
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = StartAngle;
		MinStartPoint = tlt.Transform(new System.Windows.Point(MinRadius + Radius, Radius));
		tlt.Angle = EndAngle;
		MinEndPoint = tlt.Transform(new System.Windows.Point(MinRadius + Radius, Radius));
		Relocation_moveRec();
		Relocation_Rec2();
		NotifyPropertyChanged("MinRadiusArrowPoint");
	}

	private void Relocation_Rec2()
	{
		Vector vector = new Vector(StartPoint.X - Radius, StartPoint.Y - Radius);
		Vector vector2 = new Vector(EndPoint.X - Radius, EndPoint.Y - Radius);
		double num = ((ClockWise == SweepDirection.Clockwise) ? Vector.AngleBetween(vector, vector2) : Vector.AngleBetween(vector2, vector));
		if (num < 0.0)
		{
			num += 360.0;
		}
		if (StartAngle == EndAngle)
		{
			num = 360.0;
		}
		RotateTransform rotateTransform = new RotateTransform();
		rotateTransform.CenterX = Radius;
		rotateTransform.CenterY = Radius;
		rotateTransform.Angle = ((ClockWise == SweepDirection.Clockwise) ? (num / 2.0) : ((0.0 - num) / 2.0));
		System.Windows.Point point = rotateTransform.Transform(MinStartPoint);
		rec2.X = point.X;
		rec2.Y = point.Y;
	}

	private static void OnIsLargeArcChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).OnChangedIsLargeArc();
	}

	private void OnChangedIsLargeArc()
	{
	}

	private static void OnStartPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).OnChangedStartPoint();
	}

	private void OnChangedStartPoint()
	{
		NotifyPropertyChanged("StartArrowPoint");
		ChangeRadiusArrowAngle();
	}

	private void ChangeRadiusArrowAngle()
	{
		Vector vector = new Vector(StartPoint.X - Radius, StartPoint.Y - Radius);
		Vector vector2 = new Vector(EndPoint.X - Radius, EndPoint.Y - Radius);
		double num = ((ClockWise == SweepDirection.Clockwise) ? Vector.AngleBetween(vector, vector2) : Vector.AngleBetween(vector2, vector));
		if (num < 0.0)
		{
			num += 360.0;
		}
		if (StartAngle == EndAngle)
		{
			num = 360.0;
		}
		RadiusArrowAngle = ((ClockWise == SweepDirection.Clockwise) ? (num * 2.0 / 3.0 + StartAngle + 90.0) : (StartAngle - num * 2.0 / 3.0 - 90.0));
	}

	private static void OnEndPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).OnChangedEndPoint();
	}

	private void OnChangedEndPoint()
	{
		NotifyPropertyChanged("EndArrowPoint");
		ChangeRadiusArrowAngle();
	}

	private static void OnStartAngleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).IsParamChanged = true;
		(d as HikCircleCaliper).OnChangStartAngle();
	}

	private void OnChangStartAngle()
	{
		if (StartAngle == EndAngle)
		{
			PathFillColor2.Visibility = Visibility.Visible;
		}
		else
		{
			PathFillColor2.Visibility = Visibility.Collapsed;
		}
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = StartAngle;
		StartPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		MinStartPoint = tlt.Transform(new System.Windows.Point(MinRadius + Radius, Radius));
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		System.Windows.Point point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		startAngle.X = point.X;
		startAngle.Y = point.Y;
		Relocation_moveRec();
		ChangeLargeArc();
		Relocation_Rec12();
		DrawCaliper();
	}

	private void Relocation_Rec12()
	{
		Vector vector = new Vector(StartPoint.X - Radius, StartPoint.Y - Radius);
		Vector vector2 = new Vector(EndPoint.X - Radius, EndPoint.Y - Radius);
		double num = ((ClockWise == SweepDirection.Clockwise) ? Vector.AngleBetween(vector, vector2) : Vector.AngleBetween(vector2, vector));
		if (num < 0.0)
		{
			num += 360.0;
		}
		if (StartAngle == EndAngle)
		{
			num = 360.0;
		}
		RotateTransform rotateTransform = new RotateTransform();
		rotateTransform.CenterX = Radius;
		rotateTransform.CenterY = Radius;
		rotateTransform.Angle = ((ClockWise == SweepDirection.Clockwise) ? (num / 2.0) : ((0.0 - num) / 2.0));
		System.Windows.Point point = rotateTransform.Transform(StartPoint);
		rec1.X = point.X;
		rec1.Y = point.Y;
		point = rotateTransform.Transform(MinStartPoint);
		rec2.X = point.X;
		rec2.Y = point.Y;
	}

	private static void OnEndAngleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).IsParamChanged = true;
		(d as HikCircleCaliper).OnChangEndAngle();
	}

	private void OnChangEndAngle()
	{
		if (StartAngle == EndAngle)
		{
			PathFillColor2.Visibility = Visibility.Visible;
		}
		else
		{
			PathFillColor2.Visibility = Visibility.Collapsed;
		}
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = EndAngle;
		EndPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		MinEndPoint = tlt.Transform(new System.Windows.Point(MinRadius + Radius, Radius));
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		System.Windows.Point point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		endAngle.X = point.X;
		endAngle.Y = point.Y;
		Relocation_moveRec();
		ChangeLargeArc();
		Relocation_Rec12();
		DrawCaliper();
	}

	private void ChangeLargeArc()
	{
		double num = ((EndAngle <= 0.0) ? (0.0 - EndAngle) : (360.0 - EndAngle));
		double num2 = ((StartAngle < 0.0) ? (360.0 + StartAngle) : StartAngle);
		bool flag = (num2 + num) % 360.0 <= 180.0;
		if (ClockWise == SweepDirection.Counterclockwise)
		{
			flag = !flag;
		}
		IsLargeArc = flag;
	}

	private static void OnTCenterPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).IsParamChanged = true;
		System.Windows.Point centerPoint = (System.Windows.Point)e.NewValue;
		double radio = (d as HikCircleCaliper).owner.Radio;
		centerPoint.X = (centerPoint.X + 0.5) * radio;
		centerPoint.Y = (centerPoint.Y + 0.5) * radio;
		(d as HikCircleCaliper).CenterPoint = centerPoint;
	}

	private static void OnCenterPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).OnChangCenterPoint();
	}

	private void OnChangCenterPoint()
	{
		double radio = owner.Radio;
		TCenterPoint = new System.Windows.Point(CenterPoint.X / radio - 0.5, CenterPoint.Y / radio - 0.5);
		double num = CenterPoint.X - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = CenterPoint.Y - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
	}

	private static void OnTRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).IsParamChanged = true;
		(d as HikCircleCaliper).Radius = (double)e.NewValue * (d as HikCircleCaliper).owner.Radio;
	}

	private static void OnRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).OnChangRadius((double)e.OldValue);
	}

	private void OnChangRadius(double oldRadius)
	{
		TRadius = Radius / owner.Radio;
		Width = 2.0 * Radius;
		Height = 2.0 * Radius;
		MyCenterPoint = new System.Windows.Point(Radius, Radius);
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = StartAngle;
		StartPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		tlt.Angle = EndAngle;
		EndPoint = tlt.Transform(new System.Windows.Point(2.0 * Radius, Radius));
		MaxSize = new System.Windows.Size(Radius, Radius);
		double num = CenterPoint.X - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = CenterPoint.Y - Radius;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
		tlt.Angle = StartAngle;
		MinStartPoint = tlt.Transform(new System.Windows.Point(MinRadius + Radius, Radius));
		tlt.Angle = EndAngle;
		MinEndPoint = tlt.Transform(new System.Windows.Point(MinRadius + Radius, Radius));
		tlt.Angle = EndAngle;
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		System.Windows.Point point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		endAngle.X = point.X;
		endAngle.Y = point.Y;
		tlt.Angle = StartAngle;
		point = tlt.Transform(new System.Windows.Point(Width, Height * 0.5));
		startAngle.X = point.X;
		startAngle.Y = point.Y;
		Relocation_moveRec();
		Relocation_Rec12();
		DrawCaliper();
		NotifyPropertyChanged("MinRadiusArrowPoint");
		NotifyPropertyChanged("RadiusArrowPoint");
	}

	private void Relocation_moveRec()
	{
		RotateTransform rotateTransform = new RotateTransform();
		rotateTransform.CenterX = Width / 2.0;
		rotateTransform.CenterY = Height / 2.0;
		rotateTransform.Angle = StartAngle;
		double num = Math.Abs(Radius - MinRadius);
		double num2 = ((Radius < MinRadius) ? Radius : MinRadius);
		double num3 = ((ClockWise == SweepDirection.Clockwise) ? 1 : (-1));
		if (num3 < 0.0)
		{
			if (moveRec1.VerticalAlignment == VerticalAlignment.Top)
			{
				moveRec1.VerticalAlignment = VerticalAlignment.Bottom;
				moveRec2.VerticalAlignment = VerticalAlignment.Top;
			}
		}
		else if (moveRec1.VerticalAlignment == VerticalAlignment.Bottom)
		{
			moveRec1.VerticalAlignment = VerticalAlignment.Top;
			moveRec2.VerticalAlignment = VerticalAlignment.Bottom;
		}
		System.Windows.Point point = rotateTransform.Transform(new System.Windows.Point(num2 + Width / 2.0 + num / 2.0, Height * 0.5 + num3 * moveRec1.Height / 2.0));
		moveRec1.X = point.X;
		moveRec1.Y = point.Y;
		moveRec1.Angle = StartAngle;
		rotateTransform.Angle = EndAngle;
		point = rotateTransform.Transform(new System.Windows.Point(num2 + Width / 2.0 + num / 2.0, Height * 0.5 - num3 * moveRec2.Height / 2.0));
		moveRec2.X = point.X;
		moveRec2.Y = point.Y;
		moveRec2.Angle = EndAngle;
	}

	public static void OnDrawROISubstitute_MouseMove(object sender, MouseEventArgs e)
	{
		if (Owner != null && Owner.SourceImage.Source != null)
		{
			if (!IsMoved)
			{
				IsMoved = true;
			}
			System.Windows.Point position = e.GetPosition(Owner.SourceImage);
			if (position.X < 0.0)
			{
				position.X = 0.0;
			}
			if (position.Y < 0.0)
			{
				position.Y = 0.0;
			}
			if (position.X > Owner.SourceImage.Width)
			{
				position.X = Owner.SourceImage.Width;
			}
			if (position.Y > Owner.SourceImage.ActualHeight)
			{
				position.Y = Owner.SourceImage.ActualHeight;
			}
			double num = 0.0;
			double num2 = 0.0;
			if (position.X < MouseDownPoint.X)
			{
				num = position.X;
			}
			else
			{
				num = MouseDownPoint.X;
			}
			if (position.Y < MouseDownPoint.Y)
			{
				num2 = position.Y;
			}
			else
			{
				num2 = MouseDownPoint.Y;
			}
			ellipseGeometry.Center = MouseDownPoint;
			double num3 = Math.Sqrt(Math.Pow(position.X - MouseDownPoint.X, 2.0) + Math.Pow(position.Y - MouseDownPoint.Y, 2.0));
			ellipseGeometry.RadiusX = num3;
			ellipseGeometry.RadiusY = num3;
		}
	}

	public static void OnDrawROISubstitute_MouseUp(object sender, MouseEventArgs e)
	{
		if (Owner == null)
		{
			return;
		}
		Owner.IsDrawRoi = false;
		Owner.RemoveROIChild(substitute);
		Owner.SourceImage.ReleaseMouseCapture();
		HikImageView hikImageView = Owner;
		hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
		HikImageView hikImageView2 = Owner;
		hikImageView2.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView2.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
		HikImageView hikImageView3 = Owner;
		hikImageView3.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Remove(hikImageView3.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
		if (IsMoved)
		{
			HikCircleCaliperRoiParameter hikCircleCaliperRoiParameter = Owner.DoGetExtendROIParam(RoiUIType.HikCircleCaliperRoi) as HikCircleCaliperRoiParameter;
			if (hikCircleCaliperRoiParameter == null)
			{
				hikCircleCaliperRoiParameter = new HikCircleCaliperRoiParameter();
			}
			System.Windows.Point center = ellipseGeometry.Center;
			center.X = center.X / Owner.Radio - 0.5;
			center.Y = center.Y / Owner.Radio - 0.5;
			hikCircleCaliperRoiParameter.CenterPoint = center;
			hikCircleCaliperRoiParameter.Radius = ellipseGeometry.RadiusX / Owner.Radio;
			hikCircleCaliperRoiParameter.CaliperWidth = hikCircleCaliperRoiParameter.Radius / 3.0;
			hikCircleCaliperRoiParameter.CaliperHeight = hikCircleCaliperRoiParameter.CaliperWidth / 2.0;
			Owner.RoiList.Add(hikCircleCaliperRoiParameter);
		}
		Owner = null;
		substitute = null;
		ellipseGeometry = null;
	}

	public void Doth(FrameworkElement rectangleArea, MouseEventArgs e)
	{
		IsParamChanged = false;
		curType = rectangleArea.Name;
		curControl = rectangleArea as IArea;
		Distance = Radius - MinRadius;
		CaptureMouse();
		System.Windows.Point position = e.GetPosition(parent);
		System.Windows.Point point = rectangleArea.TranslatePoint(new System.Windows.Point(rectangleArea.ActualWidth / 2.0, rectangleArea.ActualHeight / 2.0), parent);
		XOffset = point.X - position.X;
		YOffset = point.Y - position.Y;
		isDragging = true;
	}

	private void UserControl_Loaded(object sender, RoutedEventArgs e)
	{
		NotifyPropertyChanged("IsRadiusLimit");
		if (parent == null)
		{
			parent = VisualTreeHelper.GetParent(this) as FrameworkElement;
			parent = VisualTreeHelper.GetParent(parent) as FrameworkElement;
			parent.MouseMove += zparent_MouseMove;
		}
	}

