	private void zparent_MouseMove(object sender, MouseEventArgs e)
	{
		double num = 0.0;
		double num2 = 0.0;
		if (!isDragging)
		{
			return;
		}
		System.Windows.Point position = e.GetPosition(parent);
		switch (curType)
		{
		case "userControl":
			num = position.Y - CurPoint.Y + Height / 2.0;
			num2 = position.X - CurPoint.X + Width / 2.0;
			CenterPoint = new System.Windows.Point(num2, num);
			break;
		case "rec1":
		{
			System.Windows.Point point8 = position + new Vector(rec1.Width / 2.0 - rec1.CurPoint.X, rec1.Height / 2.0 - rec1.CurPoint.Y);
			System.Windows.Point point9 = new System.Windows.Point(rec1.X, rec1.Y);
			System.Windows.Point startPoint2 = StartPoint;
			System.Windows.Point endPoint2 = EndPoint;
			System.Windows.Point point10 = new System.Windows.Point(Canvas.GetLeft(this), Canvas.GetTop(this));
			System.Windows.Point point11 = StartPoint + new Vector(point10.X, point10.Y);
			System.Windows.Point point12 = EndPoint + new Vector(point10.X, point10.Y);
			Vector vector5 = new Vector(point12.X - point11.X, point12.Y - point11.Y);
			Vector vector6 = new Vector(point11.X - point8.X, point11.Y - point8.Y);
			Vector vector7 = new Vector(point12.X - point8.X, point12.Y - point8.Y);
			double num9 = 0.0;
			double num10 = 0.0;
			Vector vector8;
			if (vector5.Length == 0.0)
			{
				num9 = vector6.Length;
				if (num9 == 0.0)
				{
					break;
				}
				num10 = (num9 * num9 + Math.Pow(vector5.Length / 2.0, 2.0)) / (2.0 * num9);
				vector8 = -vector6;
				vector5 = new Vector(vector8.Y, 0.0 - vector8.X);
				if (Vector.CrossProduct(vector5, vector8) > 0.0 == (ClockWise == SweepDirection.Clockwise))
				{
					vector5 = -vector5;
				}
			}
			else
			{
				num9 = Math.Abs(Vector.CrossProduct(vector6, vector7) / vector5.Length);
				if (num9 == 0.0)
				{
					break;
				}
				num10 = (num9 * num9 + Math.Pow(vector5.Length / 2.0, 2.0)) / (2.0 * num9);
				vector8 = new Vector(vector5.Y, 0.0 - vector5.X);
				if (ClockWise == SweepDirection.Clockwise)
				{
					if (Vector.CrossProduct(vector8, vector5) < 0.0)
					{
						vector8 = -vector8;
					}
				}
				else if (Vector.CrossProduct(vector8, vector5) > 0.0)
				{
					vector8 = -vector8;
				}
			}
			Vector vector9 = vector6 + vector7;
			vector9.Normalize();
			if (Vector.CrossProduct(vector9, vector5) < 0.0 != (ClockWise == SweepDirection.Clockwise))
			{
				vector8 = -vector8;
				if (!IsRadiusLimit)
				{
					ClockWise = DeClockWise;
				}
				else
				{
					System.Windows.Point point13 = point11;
					point11 = point12;
					point12 = point13;
				}
			}
			vector8.Normalize();
			double num11 = 10000.0 * owner.Radio;
			if (!(num10 >= num11) && !(num10 - Distance >= num11))
			{
				Vector vector10 = vector8 * num9;
				System.Windows.Point point14 = new System.Windows.Point((point12.X + point11.X) / 2.0, (point12.Y + point11.Y) / 2.0) + vector10;
				CenterPoint = point14 + -vector8 * num10;
				Radius = num10;
				double num12 = Math.Atan2(point11.Y - CenterPoint.Y, point11.X - CenterPoint.X) * 180.0 / Math.PI;
				double num13 = Math.Atan2(point12.Y - CenterPoint.Y, point12.X - CenterPoint.X) * 180.0 / Math.PI;
				StartAngle = num12;
				EndAngle = num13;
			}
			break;
		}
		case "rec2":
		{
			num = position.Y - rec2.CurPoint.Y + rec2.Height / 2.0;
			num2 = position.X - rec2.CurPoint.X + rec2.Width / 2.0;
			double num18 = Math.Sqrt(Math.Pow(num2 - CenterPoint.X, 2.0) + Math.Pow(num - CenterPoint.Y, 2.0));
			if (!IsRadiusLimit)
			{
				if (num18 < 5.0 * Scale)
				{
					num18 = 0.0;
				}
				MinRadius = num18;
			}
			else
			{
				if (num18 > Radius)
				{
					num18 = Radius;
				}
				MinRadius = num18;
			}
			break;
		}
		case "endAngle":
		{
			System.Windows.Point point15 = new System.Windows.Point(rec1.X, rec1.Y);
			System.Windows.Point startPoint3 = StartPoint;
			System.Windows.Point endPoint3 = EndPoint;
			System.Windows.Point point16 = new System.Windows.Point(Canvas.GetLeft(this), Canvas.GetTop(this));
			System.Windows.Point point17 = StartPoint + new Vector(point16.X, point16.Y);
			System.Windows.Point point18 = EndPoint + new Vector(point16.X, point16.Y);
			System.Windows.Point point19 = new System.Windows.Point((startPoint3.X + endPoint3.X) / 2.0, (startPoint3.Y + endPoint3.Y) / 2.0);
			double length2 = new Vector(point19.X - point15.X, point19.Y - point15.Y).Length;
			if (length2 == 0.0)
			{
				break;
			}
			System.Windows.Point point20 = position + new Vector(endAngle.Width / 2.0 - endAngle.CurPoint.X, endAngle.Height / 2.0 - endAngle.CurPoint.Y);
			Vector vector11 = new Vector(point20.X - point17.X, point20.Y - point17.Y);
			double num19 = (length2 * length2 + Math.Pow(vector11.Length / 2.0, 2.0)) / (2.0 * length2);
			double num20 = 10000.0 * owner.Radio;
			if (num19 >= num20 || num19 - Distance >= num20)
			{
				break;
			}
			Vector vector13;
			if (vector11.Length == 0.0)
			{
				Vector vector12 = new Vector(point17.X - CenterPoint.X, point17.Y - CenterPoint.Y);
				vector13 = -vector12;
				vector11 = new Vector(vector13.Y, 0.0 - vector13.X);
				if (Vector.CrossProduct(vector11, vector13) > 0.0 == (ClockWise == SweepDirection.Clockwise))
				{
					vector11 = -vector11;
				}
			}
			else
			{
				vector13 = new Vector(vector11.Y, 0.0 - vector11.X);
			}
			if (Vector.CrossProduct(vector13, vector11) < 0.0 == (ClockWise == SweepDirection.Clockwise))
			{
				vector13 = -vector13;
			}
			vector13.Normalize();
			Vector vector14 = vector13 * length2;
			System.Windows.Point point21 = new System.Windows.Point((point20.X + point17.X) / 2.0, (point20.Y + point17.Y) / 2.0) + vector14;
			CenterPoint = point21 + -vector13 * num19;
			Radius = num19;
			StartAngle = Math.Atan2(point17.Y - CenterPoint.Y, point17.X - CenterPoint.X) * 180.0 / Math.PI;
			EndAngle = Math.Atan2(point20.Y - CenterPoint.Y, point20.X - CenterPoint.X) * 180.0 / Math.PI;
			DealAngleAfter(IsEnd: true);
			break;
		}
		case "startAngle":
		{
			System.Windows.Point point = new System.Windows.Point(rec1.X, rec1.Y);
			System.Windows.Point startPoint = StartPoint;
			System.Windows.Point endPoint = EndPoint;
			System.Windows.Point point2 = new System.Windows.Point(Canvas.GetLeft(this), Canvas.GetTop(this));
			System.Windows.Point point3 = StartPoint + new Vector(point2.X, point2.Y);
			System.Windows.Point point4 = EndPoint + new Vector(point2.X, point2.Y);
			System.Windows.Point point5 = new System.Windows.Point((startPoint.X + endPoint.X) / 2.0, (startPoint.Y + endPoint.Y) / 2.0);
			double length = new Vector(point5.X - point.X, point5.Y - point.Y).Length;
			if (length == 0.0)
			{
				break;
			}
			System.Windows.Point point6 = position + new Vector(startAngle.Width / 2.0 - startAngle.CurPoint.X, startAngle.Height / 2.0 - startAngle.CurPoint.Y);
			Vector vector = new Vector(point6.X - point4.X, point6.Y - point4.Y);
			double num7 = (length * length + Math.Pow(vector.Length / 2.0, 2.0)) / (2.0 * length);
			double num8 = 10000.0 * owner.Radio;
			if (num7 >= num8 || num7 - Distance >= num8)
			{
				break;
			}
			Vector vector3;
			if (vector.Length == 0.0)
			{
				Vector vector2 = new Vector(point3.X - CenterPoint.X, point3.Y - CenterPoint.Y);
				vector3 = -vector2;
				vector = new Vector(vector3.Y, 0.0 - vector3.X);
				if (Vector.CrossProduct(vector, vector3) < 0.0 == (ClockWise == SweepDirection.Clockwise))
				{
					vector = -vector;
				}
			}
			else
			{
				vector3 = new Vector(vector.Y, 0.0 - vector.X);
			}
			if (Vector.CrossProduct(vector3, vector) > 0.0 == (ClockWise == SweepDirection.Clockwise))
			{
				vector3 = -vector3;
			}
			vector3.Normalize();
			Vector vector4 = vector3 * length;
			System.Windows.Point point7 = new System.Windows.Point((point6.X + point4.X) / 2.0, (point6.Y + point4.Y) / 2.0) + vector4;
			CenterPoint = point7 + -vector3 * num7;
			Radius = num7;
			StartAngle = Math.Atan2(point6.Y - CenterPoint.Y, point6.X - CenterPoint.X) * 180.0 / Math.PI;
			EndAngle = Math.Atan2(point4.Y - CenterPoint.Y, point4.X - CenterPoint.X) * 180.0 / Math.PI;
			DealAngleAfter(IsEnd: false);
			break;
		}
		case "moveRec1":
		{
			double num14 = ((Radius < MinRadius) ? Radius : MinRadius);
			double num15 = Math.Atan2(position.Y - CenterPoint.Y, position.X - CenterPoint.X) * 180.0 / Math.PI;
			double num16 = 0.0;
			double num17 = Math.Abs(Radius - MinRadius) / 2.0;
			if (ClockWise == SweepDirection.Clockwise)
			{
				num16 = Math.Atan2(moveRec1.CurPoint.Y, num14 + num17 - moveRec1.Width / 2.0 + moveRec1.CurPoint.X) * 180.0 / Math.PI;
				StartAngle = num15 - num16;
			}
			else
			{
				num16 = Math.Atan2(moveRec1.Height - moveRec1.CurPoint.Y, num14 + num17 - moveRec1.Width / 2.0 + moveRec1.CurPoint.X) * 180.0 / Math.PI;
				StartAngle = num15 + num16;
			}
			DealAngleAfter(IsEnd: false);
			break;
		}
		case "moveRec2":
		{
			double num3 = ((Radius < MinRadius) ? Radius : MinRadius);
			double num4 = Math.Atan2(position.Y - CenterPoint.Y, position.X - CenterPoint.X) * 180.0 / Math.PI;
			double num5 = 0.0;
			double num6 = Math.Abs(Radius - MinRadius) / 2.0;
			if (ClockWise == SweepDirection.Clockwise)
			{
				num5 = Math.Atan2(moveRec2.Height - moveRec2.CurPoint.Y, num3 + num6 - moveRec2.Width / 2.0 + moveRec2.CurPoint.X) * 180.0 / Math.PI;
				EndAngle = num4 + num5;
			}
			else
			{
				num5 = Math.Atan2(moveRec2.CurPoint.Y, num3 + num6 - moveRec2.Width / 2.0 + moveRec2.CurPoint.X) * 180.0 / Math.PI;
				EndAngle = num4 - num5;
			}
			DealAngleAfter(IsEnd: true);
			break;
		}
		case "top":
		case "bottom":
			SetCaliperSize(position, width: true, height: false);
			break;
		case "left":
		case "right":
			SetCaliperSize(position, width: false, height: true);
			break;
		case "top_left":
			SetCaliperSize(position, width: true, height: true);
			break;
		case "top_right":
			SetCaliperSize(position, width: true, height: true);
			break;
		case "bottom_left":
			SetCaliperSize(position, width: true, height: true);
			break;
		case "bottom_right":
			SetCaliperSize(position, width: true, height: true);
			break;
		}
	}

	private void SetCaliperSize(System.Windows.Point curPoint, bool width, bool height)
	{
		double y = curPoint.Y + YOffset;
		double x = curPoint.X + XOffset;
		curPoint = new System.Windows.Point(x, y);
		curPoint = parent.TranslatePoint(curPoint, this);
		Vector vector = new Vector(RectCenterPoint.X - MyCenterPoint.X, RectCenterPoint.Y - MyCenterPoint.Y);
		double num = Math.Abs(Vector.AngleBetween(vector2: new Vector(curPoint.X - RectCenterPoint.X, curPoint.Y - RectCenterPoint.Y), vector1: vector)) * Math.PI / 180.0;
		double distance = GetDistance(curPoint.X, curPoint.Y, RectCenterPoint.X, RectCenterPoint.Y);
		if (width)
		{
			CaliperWidth = 2.0 * distance * Math.Abs(Math.Cos(num));
		}
		if (height)
		{
			CaliperHeight = 2.0 * distance * Math.Abs(Math.Sin(num));
		}
	}

	private double GetDistance(double A_x, double A_y, double B_x, double B_y)
	{
		double num = Math.Abs(B_x - A_x);
		double num2 = Math.Abs(B_y - A_y);
		return Math.Sqrt(num * num + num2 * num2);
	}

	private void DealAngleAfter(bool IsEnd)
	{
		if (Math.Abs(StartAngle) == 180.0 && Math.Abs(EndAngle) == 180.0)
		{
			if (IsEnd)
			{
				EndAngle = StartAngle;
			}
			else
			{
				StartAngle = EndAngle;
			}
		}
		else if (Math.Abs(EndAngle - StartAngle) < 2.0 * Scale)
		{
			if (IsEnd)
			{
				EndAngle = StartAngle;
			}
			else
			{
				StartAngle = EndAngle;
			}
		}
	}

	private void UserControl_MouseEnter(object sender, MouseEventArgs e)
	{
		foreach (Control childControl in childControlList)
		{
			if (childControl != left && childControl != top && childControl != right && childControl != bottom && childControl != startArrow && childControl != endArrow && childControl != minRadiusArrow && childControl != radiusArrow)
			{
				childControl.Opacity = 1.0;
			}
		}
	}

	private void UserControl_MouseLeave(object sender, MouseEventArgs e)
	{
		foreach (Control childControl in childControlList)
		{
			if (childControl != startArrow && childControl != endArrow && childControl != minRadiusArrow && childControl != radiusArrow)
			{
				childControl.Opacity = 0.0;
			}
		}
	}

	public void DoCallBack()
	{
		if (OnTheSizeChange != null)
		{
			OnTheSizeChange(DataContext);
		}
	}

	private void UserControl_MouseUp(object sender, MouseButtonEventArgs e)
	{
		if (isDragging)
		{
			if (curControl != null)
			{
				curControl.IsPressed = false;
			}
			isDragging = false;
			DoCallBack();
			ReleaseMouseCapture();
		}
	}

	private void UserControl_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (!DoDragROI(e))
		{
			IsSelected = true;
			Focus();
			if (!isDragging)
			{
				CurPoint = e.GetPosition(this);
				Doth(this, e);
				owner.DoRoiClick(this, e);
			}
		}
	}

	private static void OnTCaliperHeightChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		double num = (double)e.NewValue;
		double radio = (d as HikCircleCaliper).owner.Radio;
		(d as HikCircleCaliper).CaliperHeight = num * radio;
	}

	private static void OnCaliperHeightChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		double num = (double)e.NewValue;
		double radio = (d as HikCircleCaliper).owner.Radio;
		(d as HikCircleCaliper).TCaliperHeight = num / radio;
		(d as HikCircleCaliper).DrawCaliper();
	}

	private static void OnTCaliperWidthChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		double num = (double)e.NewValue;
		double radio = (d as HikCircleCaliper).owner.Radio;
		(d as HikCircleCaliper).CaliperWidth = num * radio;
	}

	private static void OnCaliperWidthChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		double num = (double)e.NewValue;
		double radio = (d as HikCircleCaliper).owner.Radio;
		(d as HikCircleCaliper).TCaliperWidth = num / radio;
		(d as HikCircleCaliper).DrawCaliper();
	}

	private static void OnCaliperNumChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCircleCaliper).DrawCaliper();
	}

	private void DrawCaliper2()
	{
		foreach (UIElement shape in shapes)
		{
			Gp.Children.Remove(shape);
		}
		shapes.Clear();
		double num = EndAngle - StartAngle;
		if (num <= 0.0)
		{
			num += 360.0;
		}
		double num2 = num / (double)CaliperNum;
		for (int i = 1; i < CaliperNum + 1; i++)
		{
			double angle = num2 * (double)(i - 1) + num2 / 2.0;
			tlt.CenterX = Radius;
			tlt.CenterY = Radius;
			tlt.Angle = angle;
			System.Windows.Point point = tlt.Transform(StartPoint);
			System.Windows.Shapes.Rectangle rectangle = new System.Windows.Shapes.Rectangle();
			rectangle.Width = CaliperHeight;
			rectangle.Height = CaliperWidth;
			Panel.SetZIndex(rectangle, -1);
			Binding binding = new Binding();
			binding.Source = this;
			binding.Path = new PropertyPath("TStrokeThickness");
			rectangle.SetBinding(Shape.StrokeThicknessProperty, binding);
			rectangle.Fill = System.Windows.Media.Brushes.Transparent;
			rectangle.Stroke = (System.Windows.Media.Brush)FindResource("ROIBaseColor");
			rectangle.Cursor = Cursors.SizeAll;
			double num3 = point.Y - rectangle.Height / 2.0;
			double num4 = point.X - rectangle.Width / 2.0;
			rectangle.SetValue(Canvas.TopProperty, num3);
			rectangle.SetValue(Canvas.LeftProperty, num4);
			double rotate = GetRotate(point);
			RotateTransform rotateTransform = new RotateTransform();
			rotateTransform.CenterX = rectangle.Width / 2.0;
			rotateTransform.CenterY = rectangle.Height / 2.0;
			rotateTransform.Angle = rotate;
			rectangle.RenderTransform = rotateTransform;
			if ((double)i == Math.Ceiling((double)CaliperNum / 2.0))
			{
				CaliperRotateAngle = GetRotate(point);
				box.Width = CaliperHeight;
				box.Height = CaliperWidth;
				boxRt.Angle = CaliperRotateAngle;
				boxRt.CenterX = box.Width / 2.0;
				boxRt.CenterY = box.Height / 2.0;
				box.SetValue(Canvas.TopProperty, num3);
				box.SetValue(Canvas.LeftProperty, num4);
				top_left.X = num4;
				top_left.Y = num3;
				top_left.tlt.CenterX = (top_left.Width + rectangle.Width) / 2.0;
				top_left.tlt.CenterY = (top_left.Height + rectangle.Height) / 2.0;
				top_left.tlt.Angle = CaliperRotateAngle;
				top_right.X = num4 + rectangle.Width;
				top_right.Y = num3;
				top_right.tlt.CenterX = (top_left.Width - rectangle.Width) / 2.0;
				top_right.tlt.CenterY = (top_left.Height + rectangle.Height) / 2.0;
				top_right.tlt.Angle = CaliperRotateAngle;
				bottom_left.X = num4;
				bottom_left.Y = num3 + rectangle.Height;
				bottom_left.tlt.CenterX = (top_left.Width + rectangle.Width) / 2.0;
				bottom_left.tlt.CenterY = (top_left.Height - rectangle.Height) / 2.0;
				bottom_left.tlt.Angle = CaliperRotateAngle;
				bottom_right.X = num4 + rectangle.Width;
				bottom_right.Y = num3 + rectangle.Height;
				bottom_right.tlt.CenterX = (top_left.Width - rectangle.Width) / 2.0;
				bottom_right.tlt.CenterY = (top_left.Height - rectangle.Height) / 2.0;
				bottom_right.tlt.Angle = CaliperRotateAngle;
				RectCenterPoint = point;
			}
			else
			{
				shapes.Add(rectangle);
				Gp.Children.Add(rectangle);
			}
		}
	}

	private void DrawCaliper()
	{
		drawCanvas.ClearVisuals();
		if (TRadius <= 0.0)
		{
			top_left.Visibility = Visibility.Hidden;
			top_right.Visibility = Visibility.Hidden;
			bottom_left.Visibility = Visibility.Hidden;
			bottom_right.Visibility = Visibility.Hidden;
			return;
		}
		top_left.Visibility = Visibility.Visible;
		top_right.Visibility = Visibility.Visible;
		bottom_left.Visibility = Visibility.Visible;
		bottom_right.Visibility = Visibility.Visible;
		int num = 500;
		if (TCaliperHeight > (double)num)
		{
			(DataContext as HikCircleCaliperRoiParameter).CaliperHeight = num;
			return;
		}
		if (IsLimitFlag)
		{
			double num2 = 2.0 * TRadius;
			if (TCaliperWidth > num2)
			{
				(DataContext as HikCircleCaliperRoiParameter).CaliperWidth = num2;
				return;
			}
		}
		pen.Thickness = TStrokeThickness;
		if (pen.Brush == null)
		{
			pen.Brush = (System.Windows.Media.Brush)FindResource("ROIBaseColor");
		}
		double num3 = EndAngle - StartAngle;
		if (num3 <= 0.0)
		{
			num3 += 360.0;
		}
		double num4 = num3 / (double)CaliperNum;
		for (int i = 1; i < CaliperNum + 1; i++)
		{
			double angle = num4 * (double)(i - 1) + num4 / 2.0;
			tlt.CenterX = Radius;
			tlt.CenterY = Radius;
			tlt.Angle = angle;
			System.Windows.Point point = tlt.Transform(StartPoint);
			double caliperHeight = CaliperHeight;
			double caliperWidth = CaliperWidth;
			double num5 = point.Y - caliperWidth / 2.0;
			double num6 = point.X - caliperHeight / 2.0;
			double rotate = GetRotate(point);
			RotateTransform rotateTransform = new RotateTransform();
			rotateTransform.CenterX = num6 + caliperHeight / 2.0;
			rotateTransform.CenterY = num5 + caliperWidth / 2.0;
			rotateTransform.Angle = rotate;
			DrawingVisual drawingVisual = new DrawingVisual();
			using (DrawingContext drawingContext = drawingVisual.RenderOpen())
			{
				drawingContext.DrawRectangle(brush, pen, new Rect(new System.Windows.Point(num6, num5), new System.Windows.Size(caliperHeight, caliperWidth)));
			}
			drawingVisual.Transform = rotateTransform;
			if ((double)i == Math.Ceiling((double)(3 * CaliperNum) / 4.0))
			{
				CaliperRotateAngle = rotate;
				box.Width = caliperHeight;
				box.Height = caliperWidth;
				boxRt.Angle = CaliperRotateAngle;
				boxRt.CenterX = box.Width / 2.0;
				boxRt.CenterY = box.Height / 2.0;
				box.SetValue(Canvas.TopProperty, num5);
				box.SetValue(Canvas.LeftProperty, num6);
				top_left.X = num6;
				top_left.Y = num5;
				top_left.tlt.CenterX = (top_left.Width + caliperHeight) / 2.0;
				top_left.tlt.CenterY = (top_left.Height + caliperWidth) / 2.0;
				top_left.tlt.Angle = CaliperRotateAngle;
				top_right.X = num6 + caliperHeight;
				top_right.Y = num5;
				top_right.tlt.CenterX = (top_left.Width - caliperHeight) / 2.0;
				top_right.tlt.CenterY = (top_left.Height + caliperWidth) / 2.0;
				top_right.tlt.Angle = CaliperRotateAngle;
				bottom_left.X = num6;
				bottom_left.Y = num5 + caliperWidth;
				bottom_left.tlt.CenterX = (top_left.Width + caliperHeight) / 2.0;
				bottom_left.tlt.CenterY = (top_left.Height - caliperWidth) / 2.0;
				bottom_left.tlt.Angle = CaliperRotateAngle;
				bottom_right.X = num6 + caliperHeight;
				bottom_right.Y = num5 + caliperWidth;
				bottom_right.tlt.CenterX = (top_left.Width - caliperHeight) / 2.0;
				bottom_right.tlt.CenterY = (top_left.Height - caliperWidth) / 2.0;
				bottom_right.tlt.Angle = CaliperRotateAngle;
				RectCenterPoint = point;
			}
			drawCanvas.AddVisual(drawingVisual);
		}
		CliperMaxRadius = Radius + CaliperWidth / 2.0;
	}

	private double GetRotate(System.Windows.Point p)
	{
		Vector vector = new Vector(p.X - MyCenterPoint.X, p.Y - MyCenterPoint.Y);
		Vector vector2 = new Vector(0.0, 0.0 - p.Y);
		return Vector.AngleBetween(vector2, vector);
	}

