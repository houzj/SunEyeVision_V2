	public void Dispose()
	{
		DeInit();
		if (parent != null)
		{
			parent.MouseMove -= zparent_MouseMove;
		}
		if (PathFillColor.ContextMenu != null)
		{
			PathFillColor.ContextMenu.IsOpen = false;
		}
	}

	public static void DoFinishSubstitute()
	{
		if (Owner != null)
		{
			Owner.IsDrawRoi = false;
			Owner.RemoveChild(substitute);
			Owner.SourceImage.ReleaseMouseCapture();
			HikImageView hikImageView = Owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
			HikImageView hikImageView2 = Owner;
			hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Remove(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
			HikImageView hikImageView3 = Owner;
			hikImageView3.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView3.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
			Owner = null;
			substitute = null;
			ellipseGeometry = null;
		}
	}

	public static void InitSubstitute(HikImageView view, Point mouseDownPoint)
	{
		Owner = view;
		HikImageView hikImageView = Owner;
		hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
		HikImageView hikImageView2 = Owner;
		hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Combine(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
		HikImageView hikImageView3 = Owner;
		hikImageView3.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Combine(hikImageView3.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
		MouseDownPoint = mouseDownPoint;
		substitute = new Path();
		ellipseGeometry = new EllipseGeometry();
		substitute.Data = ellipseGeometry;
		substitute.Stroke = HikROIBase.SubstituteBrush;
		substitute.StrokeThickness = 1.0 / (Owner.sfr.ScaleX * Owner.ViewScale);
		IsMoved = false;
		Owner.AddROIChild(substitute);
	}

	public HikCoverCircle()
	{
		InitializeComponent();
		childControlList.Add(Move);
		childControlList.Add(startAngle);
		childControlList.Add(endAngle);
		childControlList.Add(rec1);
		childControlList.Add(rec2);
		foreach (IArea childControl in childControlList)
		{
			childControl.Container = this;
		}
	}

	public void Init()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void DeInit()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void OnScaleChange(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		double num2 = (Scale = 1.0 / ((sender as ScaleTransform).ScaleX * num));
		PathFillColor.StrokeThickness = num2;
		PathFillColor2.StrokeThickness = num2;
		bd.BorderThickness = new Thickness(num2);
		bd.Margin = new Thickness(0.0 - num2);
	}

	public static void OnScaleChangeSubstitute(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		substitute.StrokeThickness = 1.0 / ((sender as ScaleTransform).ScaleX * num);
	}

	private static void OnTMinRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCoverCircle).MinRadius = (double)e.NewValue * (d as HikCoverCircle).owner.Radio;
	}

	private static void OnMinRadiusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikCoverCircle).OnChangMinRadius();
	}

	private void OnChangMinRadius()
	{
		TMinRadius = MinRadius / owner.Radio;
		MinSize = new Size(MinRadius, MinRadius);
		tlt.CenterX = Radius;
		tlt.CenterY = Radius;
		tlt.Angle = StartAngle;
		MinStartPoint = tlt.Transform(new Point(MinRadius + Radius, Radius));
		tlt.Angle = EndAngle;
		MinEndPoint = tlt.Transform(new Point(MinRadius + Radius, Radius));
		if (!recInited2)
		{
			recInited2 = true;
			rec2.X = Width * (0.5 + Math.Sqrt(2.0) / 4.0 * MinRadius / Radius);
			rec2.Y = Height * (0.5 + Math.Sqrt(2.0) / 4.0 * MinRadius / Radius);
		}
		else
		{
			RelocationRec2();
		}
	}

	private void RelocationRec1(double oldRadius)
	{
		double num = rec1.X - oldRadius;
		double num2 = rec1.Y - oldRadius;
		if (oldRadius != 0.0)
		{
			double num3 = Radius / oldRadius;
			rec1.X = num * num3 + Radius;
			rec1.Y = num2 * num3 + Radius;
		}
		else
		{
			rec1.X = Width * (0.5 + Math.Sqrt(2.0) / 4.0);
			rec1.Y = Height * (0.5 + Math.Sqrt(2.0) / 4.0);
		}
	}

	private void RelocationRec2()
	{
		double num = rec2.X - Radius;
		double num2 = rec2.Y - Radius;
		double num3 = Math.Sqrt(num * num + num2 * num2);
		if (num3 != 0.0)
		{
			double num4 = MinRadius / num3;
			rec2.X = num * num4 + Radius;
			rec2.Y = num2 * num4 + Radius;
		}
		else
		{
			rec2.X = Width * (0.5 + Math.Sqrt(2.0) / 4.0 * MinRadius / Radius);
			rec2.Y = Height * (0.5 + Math.Sqrt(2.0) / 4.0 * MinRadius / Radius);
		}
	}

