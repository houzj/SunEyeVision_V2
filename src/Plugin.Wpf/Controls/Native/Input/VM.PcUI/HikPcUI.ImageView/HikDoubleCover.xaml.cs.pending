	public HikDoubleCover()
	{
		InitializeComponent();
		HikCover hikCover = box1;
		hikCover.OnTheSizeChange = (HikCover.SizeChange)Delegate.Combine(hikCover.OnTheSizeChange, new HikCover.SizeChange(OnBoxSizeChange));
		HikCover hikCover2 = box2;
		hikCover2.OnTheSizeChange = (HikCover.SizeChange)Delegate.Combine(hikCover2.OnTheSizeChange, new HikCover.SizeChange(OnBoxSizeChange));
	}

	private void OnBoxSizeChange(object Param)
	{
		OnTheSizeChange(DataContext);
	}

	public void DoCallBack()
	{
		if (OnTheSizeChange != null)
		{
			OnTheSizeChange(DataContext);
		}
	}

	public void Init()
