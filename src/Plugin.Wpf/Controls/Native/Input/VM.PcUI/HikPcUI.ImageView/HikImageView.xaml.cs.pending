	public double GetRatio()
	{
		if (Source == null)
		{
			return 1.0;
		}
		return ImageDesignWidth / (double)ImageSourceWidth;
	}

	public static double GetRatioBySourceWidth(double SourceWidth)
	{
		if (SourceWidth == 0.0)
		{
			return 1.0;
		}
		return ImageDesignWidth / SourceWidth;
	}

