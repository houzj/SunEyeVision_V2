	public static byte[] BitmapImageToByteArray(WriteableBitmap src, int bufferLenth)
	{
		byte[] array = new byte[bufferLenth];
		src.CopyPixels(array, src.PixelWidth * src.Format.BitsPerPixel / 8, 0);
		return array;
	}

	public void SaveAsCommandCmdExecute()
	{
		System.Windows.Forms.SaveFileDialog saveFileDialog = null;
		try
		{
			saveFileDialog = new System.Windows.Forms.SaveFileDialog
			{
				Filter = "Bitmap Image|*.bmp",
				Title = AppLocalizationService.GetLang("Lang_SaveAs")
			};
			saveFileDialog.ShowDialog();
			if (string.IsNullOrEmpty(saveFileDialog.FileName))
			{
				return;
			}
			using FileStream fileStream = new FileStream(saveFileDialog.FileName, FileMode.Create);
			BmpBitmapEncoder bmpBitmapEncoder = new BmpBitmapEncoder();
			bmpBitmapEncoder.Frames.Add(BitmapFrame.Create((BitmapSource)Source));
			bmpBitmapEncoder.Save(fileStream);
			fileStream.Flush();
		}
		catch (Exception ex)
		{
			System.Windows.Forms.MessageBox.Show(ex.Message);
		}
		finally
		{
			saveFileDialog?.Dispose();
		}
	}

	public void SaveRenderCmdExecute()
	{
		try
		{
			if (ImageDataSource != null)
			{
				ImageData imageDataSource = ImageDataSource;
				List<object> shapeDataList = ShapeDataList;
				Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog
				{
					Filter = "JPG|*.jpg|JPEG|*.jpeg|PNG|*.png|BMP|*.bmp",
					Title = AppLocalizationService.GetLang("Lang_SaveAs")
				};
				saveFileDialog.FileName = DateTime.Now.ToString("yyyyMMddHHmmss");
				bool? flag = saveFileDialog.ShowDialog();
				bool? flag2 = flag;
				bool flag3 = true;
				if (flag2 == true == flag3 && flag2.HasValue && !string.IsNullOrEmpty(saveFileDialog.FileName))
				{
					ImageSaveOpenCvHelper.SaveRoiImageSyn(saveFileDialog.FileName, imageDataSource, shapeDataList, null);
				}
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageIcons.Error);
		}
	}

	public void CtrlVCommandCmdExecute()
	{
		if (!PastCopyEnable || (ROITypeUI == ROITypeUIEnum.Transparent && !IsMulRolModule))
		{
			return;
		}
		if (OnPast != null)
		{
			OnPast(this, Past_List.Keys);
		}
		if (RoiList == null || sImage.Source == null)
		{
			return;
		}
		foreach (RoiParameter key in Past_List.Keys)
		{
			RoiParameter roiParameter = key.Clone() as RoiParameter;
			if (roiParameter is HikPointRoiParameter hikPointRoiParameter)
			{
				hikPointRoiParameter.CenterPoint = new System.Windows.Point(hikPointRoiParameter.CenterX + (double)OffSet, hikPointRoiParameter.CenterY + (double)OffSet);
				(key as HikPointRoiParameter).CenterPoint = hikPointRoiParameter.CenterPoint;
			}
			else if (roiParameter is HikCircleMesRoiParameter hikCircleMesRoiParameter)
			{
				hikCircleMesRoiParameter.CenterPoint = new System.Windows.Point(hikCircleMesRoiParameter.CenterX + (double)OffSet, hikCircleMesRoiParameter.CenterY + (double)OffSet);
				(key as HikCircleMesRoiParameter).CenterPoint = hikCircleMesRoiParameter.CenterPoint;
			}
			else if (roiParameter is HikLineRoiParameter hikLineRoiParameter)
			{
				hikLineRoiParameter.StartPoint = new System.Windows.Point(hikLineRoiParameter.StartPointX + (double)OffSet, hikLineRoiParameter.StartPointY + (double)OffSet);
				hikLineRoiParameter.EndPoint = new System.Windows.Point(hikLineRoiParameter.EndPointX + (double)OffSet, hikLineRoiParameter.EndPointY + (double)OffSet);
				(key as HikLineRoiParameter).StartPoint = hikLineRoiParameter.StartPoint;
				(key as HikLineRoiParameter).EndPoint = hikLineRoiParameter.EndPoint;
			}
			else if (roiParameter is HikCoverRoiParameter)
			{
				(roiParameter as HikCoverRoiParameter).OriginPoint = new System.Windows.Point((roiParameter as HikCoverRoiParameter).OriginPoint.X + (double)OffSet, (roiParameter as HikCoverRoiParameter).OriginPoint.Y + (double)OffSet);
				(key as HikCoverRoiParameter).OriginPoint = (roiParameter as HikCoverRoiParameter).OriginPoint;
			}
			else if (roiParameter is HikCoverCircleRoiParameter)
			{
				(roiParameter as HikCoverCircleRoiParameter).CenterPoint = new System.Windows.Point((roiParameter as HikCoverCircleRoiParameter).CenterPoint.X + (double)OffSet, (roiParameter as HikCoverCircleRoiParameter).CenterPoint.Y + (double)OffSet);
				(key as HikCoverCircleRoiParameter).CenterPoint = (roiParameter as HikCoverCircleRoiParameter).CenterPoint;
			}
			else if (roiParameter is HikPolygonRoiParameter)
			{
				HikPolygonRoiParameter hikPolygonRoiParameter = roiParameter as HikPolygonRoiParameter;
				foreach (PolygonPoint polygonPoint in hikPolygonRoiParameter.PolygonPoints)
				{
					polygonPoint.x += OffSet;
					polygonPoint.y += OffSet;
				}
				foreach (PolygonPoint polygonPoint2 in (key as HikPolygonRoiParameter).PolygonPoints)
				{
					polygonPoint2.x += OffSet;
					polygonPoint2.y += OffSet;
				}
			}
			roiParameter.Tag = key.Tag;
			RoiList.Add(roiParameter);
		}
	}

	public void CtrlCCommandCmdExecute()
	{
		if (PastCopyEnable && OnCopy != null)
		{
			OnCopy(this, Past_List.Keys);
		}
	}

	private void VGrid_Drop(object sender, System.Windows.DragEventArgs e)
	{
		try
		{
			if (e.Effects != System.Windows.DragDropEffects.Copy)
			{
				return;
			}
			System.Windows.IDataObject data = e.Data;
			if (!data.GetDataPresent(typeof(System.Windows.Controls.Button)) || !(data.GetData(typeof(System.Windows.Controls.Button)) is System.Windows.Controls.Button { Tag: object[] tag }) || tag.Count() <= 0)
			{
				return;
			}
			RoiParameter roiParameter = tag[0] as RoiParameter;
			System.Windows.Point point = (System.Windows.Point)tag[1];
			System.Windows.Point position = e.GetPosition(sImage);
			position.X -= point.X;
			position.Y -= point.Y;
			position.X /= Radio;
			position.Y /= Radio;
			object obj = roiParameter.Clone();
			if (obj is HikCoverRoiParameter)
			{
				HikCoverRoiParameter hikCoverRoiParameter = obj as HikCoverRoiParameter;
				hikCoverRoiParameter.OriginPoint = new System.Windows.Point(position.X, position.Y);
			}
			if (obj is HikCoverCircleRoiParameter)
			{
				HikCoverCircleRoiParameter hikCoverCircleRoiParameter = obj as HikCoverCircleRoiParameter;
				hikCoverCircleRoiParameter.CenterPoint = new System.Windows.Point(position.X + hikCoverCircleRoiParameter.Radius, position.Y + hikCoverCircleRoiParameter.Radius);
			}
			if (obj is HikPolygonRoiParameter)
			{
				HikPolygonRoiParameter hikPolygonRoiParameter = obj as HikPolygonRoiParameter;
				float num = hikPolygonRoiParameter.PolygonPoints.Min((PolygonPoint p) => p.x);
				float num2 = hikPolygonRoiParameter.PolygonPoints.Min((PolygonPoint p) => p.y);
				Vector vector = position - new System.Windows.Point(num, num2);
				foreach (PolygonPoint polygonPoint in hikPolygonRoiParameter.PolygonPoints)
				{
					polygonPoint.x += (float)vector.X;
					polygonPoint.y += (float)vector.Y;
				}
			}
			RoiList.Add(obj);
			e.Handled = true;
		}
		catch
		{
		}
	}

	public void SaveImage()
	{
		try
		{
			if (ImageDataSource != null)
			{
				ImageData imageDataSource = ImageDataSource;
				Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog
				{
					Filter = "JPG|*.jpg|JPEG|*.jpeg|PNG|*.png|BMP|*.bmp",
					Title = AppLocalizationService.GetLang("Lang_SaveAs")
				};
				saveFileDialog.FileName = DateTime.Now.ToString("yyyyMMddHHmmss");
				bool? flag = saveFileDialog.ShowDialog();
				bool? flag2 = flag;
				bool flag3 = true;
				if (flag2 == true == flag3 && flag2.HasValue && !string.IsNullOrEmpty(saveFileDialog.FileName))
				{
					ImageSaveOpenCvHelper.SaveRawImageSyn(saveFileDialog.FileName, imageDataSource);
				}
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageIcons.Error);
		}
	}

	public void CtrlACommandCmdExecute()
	{
		if (IsSelectMulRoiEnable)
		{
			SelectionService.SelectAll();
		}
	}

