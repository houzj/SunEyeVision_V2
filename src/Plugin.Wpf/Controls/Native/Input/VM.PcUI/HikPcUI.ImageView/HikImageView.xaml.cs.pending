	public object GetPropertieByClass(object model, string name)
	{
		Type type = model.GetType();
		object result = null;
		PropertyInfo[] properties = type.GetProperties();
		PropertyInfo[] array = properties;
		foreach (PropertyInfo propertyInfo in array)
		{
			if (propertyInfo.Name == name)
			{
				result = propertyInfo.GetValue(model, null);
				break;
			}
		}
		return result;
	}

	private void RoiList_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		switch (e.Action)
		{
		case NotifyCollectionChangedAction.Reset:
			foreach (object value in roiList.Values)
			{
				RemoveROIChild(value as FrameworkElement);
				RemoveChild(value as FrameworkElement);
			}
			roiList.Clear();
			break;
		case NotifyCollectionChangedAction.Add:
			DrawRoi(e.NewItems, needUpdate: true);
			break;
		case NotifyCollectionChangedAction.Replace:
			foreach (object oldItem in e.OldItems)
			{
				if (oldItem != null && roiList.ContainsKey(oldItem))
				{
					object obj2 = roiList[oldItem];
					RemoveROIChild(obj2 as FrameworkElement);
					RemoveChild(obj2 as FrameworkElement);
					roiList.Remove(oldItem);
				}
			}
			DrawRoi(e.NewItems, needUpdate: true);
			break;
		case NotifyCollectionChangedAction.Remove:
		{
			foreach (object oldItem2 in e.OldItems)
			{
				if (oldItem2 != null && roiList.ContainsKey(oldItem2))
				{
					object obj = roiList[oldItem2];
					RemoveROIChild(obj as FrameworkElement);
					RemoveChild(obj as FrameworkElement);
					roiList.Remove(oldItem2);
					ChangeRoiDeCount(oldItem2);
				}
			}
			break;
		}
		case NotifyCollectionChangedAction.Move:
			break;
		}
	}

	public void DrawRoi(IList proiList, bool needUpdate = false)
	{
		if (proiList == null)
		{
			return;
		}
		foreach (object proi in proiList)
		{
			if (!(proi is RoiParameter roiParameter))
			{
				continue;
			}
			FrameworkElement frameworkElement = null;
			if (roiParameter is HikCircleArcRoiParameter)
			{
				frameworkElement = new HikCircleArc();
				(frameworkElement as HikCircleArc).owner = this;
				(frameworkElement as HikCircleArc).Init();
				System.Windows.Data.Binding binding = new System.Windows.Data.Binding();
				binding.Mode = BindingMode.TwoWay;
				binding.Path = new PropertyPath("CenterPoint");
				(frameworkElement as HikCircleArc).SetBinding(HikCircleArc.TCenterPointProperty, binding);
				binding = new System.Windows.Data.Binding();
				binding.Mode = BindingMode.TwoWay;
				binding.Path = new PropertyPath("Radius");
				(frameworkElement as HikCircleArc).SetBinding(HikCircleArc.TRadiusProperty, binding);
				binding = new System.Windows.Data.Binding();
				binding.Mode = BindingMode.TwoWay;
				binding.Path = new PropertyPath("StartAngle");
				(frameworkElement as HikCircleArc).SetBinding(HikCircleArc.StartAngleProperty, binding);
				binding = new System.Windows.Data.Binding();
				binding.Mode = BindingMode.TwoWay;
				binding.Path = new PropertyPath("EndAngle");
				(frameworkElement as HikCircleArc).SetBinding(HikCircleArc.EndAngleProperty, binding);
				HikCircleArc obj = frameworkElement as HikCircleArc;
				obj.OnTheSizeChange = (HikCircleArc.SizeChange)Delegate.Combine(obj.OnTheSizeChange, new HikCircleArc.SizeChange(hikImageView_OnROIParamChanged));
				frameworkElement.DataContext = roiParameter;
				(frameworkElement as HikCircleArc).SetROITypeUI(ROITypeUI);
			}
			else if (roiParameter is HikIndexPointRoiParameter)
			{
				frameworkElement = new HikIndexPoint();
				(frameworkElement as HikIndexPoint).owner = this;
				(frameworkElement as HikIndexPoint).Init();
				System.Windows.Data.Binding binding = new System.Windows.Data.Binding();
				binding.Mode = BindingMode.TwoWay;
				binding.Path = new PropertyPath("CenterPoint");
				(frameworkElement as HikIndexPoint).SetBinding(HikIndexPoint.TCenterPointProperty, binding);
