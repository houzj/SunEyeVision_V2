	public string CoorInfo
	{
		get
		{
			string text = "";
			if (IsShowRangeImage)
			{
				text = "  |  Value:" + RangeValue;
			}
			return PixelInfoLabel + PixelInfo + " X," + $"{PixelX:D4}" + "  Y," + $"{PixelY:D4}" + "  |  R:" + $"{PixelR:D3}" + "  G:" + $"{PixelG:D3}" + "  B:" + $"{PixelB:D3}" + text;
		}
	}

