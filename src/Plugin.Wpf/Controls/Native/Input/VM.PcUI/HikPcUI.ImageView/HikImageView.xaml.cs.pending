	private void mouseLBDown(object sender, MouseButtonEventArgs e)
	{
		if (IsSelectMulRoiEnable)
		{
			SelectionService.ClearSelection();
		}
		mouseOffset = e.GetPosition(mapcanvas);
		isDragging = true;
		mView.RaiseEvent(e);
		foreach (ROIContainer item in VGrid.Children.OfType<ROIContainer>())
		{
			item.mouseLBDown(sender, e);
		}
		if (PrepareRoiType != RoiUIType.Default)
		{
			isDragging = false;
			if (OnDrawRoi_MouseDownChange != null)
			{
				OnDrawRoi_MouseDownChange(sender, e);
			}
			if (!_IsDrawRoi)
			{
				switch (PrepareRoiType)
				{
				case RoiUIType.HikCoverRoi:
					IsDrawRoi = true;
					HikCover.InitSubstitute(this, mROIView, e.GetPosition(sImage));
					break;
				case RoiUIType.HikCoverCircleRoi:
					IsDrawRoi = true;
					HikCoverCircle.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikCoverCircleRoi2:
					IsDrawRoi = true;
					HikCoverCircle2.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikPolygonRoi:
					IsDrawRoi = true;
					HikPolygon.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikPath:
					IsDrawRoi = true;
					HikPath.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikCircleArcRoi:
					IsDrawRoi = true;
					HikCircleArc.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikIndexPointRoi:
					IsDrawRoi = true;
					HikIndexPoint.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikPointRoi:
					IsDrawRoi = true;
					HikPoint.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikLineRoi:
					IsDrawRoi = true;
					HikLine.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikCircleMesRoi:
					IsDrawRoi = true;
					HikCircleMeasure.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikXY:
					IsDrawRoi = true;
					HikXY.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikLineCaliperRoi:
					IsDrawRoi = true;
					HikLineCaliper.InitSubstitute(this, e.GetPosition(sImage));
					break;
				case RoiUIType.HikCircleCaliperRoi:
					IsDrawRoi = true;
					HikCircleCaliper.InitSubstitute(this, e.GetPosition(sImage));
					break;
				}
				(sender as FrameworkElement).CaptureMouse();
				return;
			}
		}
		theTop = (double)viewbox.GetValue(Canvas.TopProperty);
		theLeft = (double)viewbox.GetValue(Canvas.LeftProperty);
		(sender as FrameworkElement).CaptureMouse();
	}

	public void CancelRoiDraw()
	{
		if (IsDrawRoi)
		{
			switch (PrepareRoiType)
			{
			case RoiUIType.HikCoverRoi:
				HikCover.DoFinishSubstitute();
				break;
			case RoiUIType.HikXY:
				HikXY.DoFinishSubstitute();
				break;
			case RoiUIType.HikCoverCircleRoi:
				HikCoverCircle.DoFinishSubstitute();
				break;
			case RoiUIType.HikPolygonRoi:
				HikPolygon.DoFinishSubstitute();
				break;
			case RoiUIType.HikPath:
				HikPath.DoFinishSubstitute();
				break;
			case RoiUIType.HikCircleArcRoi:
				HikCircleArc.DoFinishSubstitute();
				break;
			case RoiUIType.HikIndexPointRoi:
				HikIndexPoint.DoFinishSubstitute();
				break;
			case RoiUIType.HikPointRoi:
				HikPoint.DoFinishSubstitute();
				break;
			case RoiUIType.HikLineRoi:
				HikLine.DoFinishSubstitute();
				break;
			case RoiUIType.HikCircleMesRoi:
				HikCircleMeasure.DoFinishSubstitute();
				break;
			}
			IsDrawRoi = false;
		}
	}

