	public void SetPixelInfo(int X, int Y, int R, int G, int B, int value)
	{
		PixelX = X;
		PixelY = Y;
		PixelG = G;
		PixelR = R;
		PixelB = B;
		RangeValue = value;
		PixelInfoLabel = ImageDataSource.PixelInfoLabel;
		if (!(ImageDataSource.PixelFormat == PixelFormats.Gray8) || ImageDataSource.PixelExtraInfo.Keys.Count == 0 || ImageDataSource.ImageBuffer == null)
		{
			return;
		}
		try
		{
			string key = ImageDataSource.ImageBuffer[Y * ImageDataSource.Width + X].ToString();
			if (ImageDataSource.PixelExtraInfo.ContainsKey(key))
			{
				PixelInfo = ImageDataSource.PixelExtraInfo[key];
			}
			else
			{
				PixelInfo = "";
			}
		}
		catch
		{
		}
	}

	public static void SourceChanged(DependencyObject sender, DependencyPropertyChangedEventArgs e)
	{
		if (!(sender is HikImageView hikImageView))
		{
			return;
		}
		ImageSource imageSource = e.OldValue as ImageSource;
		ImageSource imageSource2 = e.NewValue as ImageSource;
		if (e.NewValue == null)
		{
			hikImageView.SetCurrentValue(ImageDataSourceProperty, null);
			hikImageView.ImageSourceWidth = 0;
			hikImageView.ImageSourceHeight = 0;
		}
		hikImageView.IsSourceDataCompressed = hikImageView.DataFlag == 0;
		if (hikImageView.IsSourceDataCompressed)
		{
			if (hikImageView.ImageDataSource != null)
			{
				hikImageView.ImageSourceWidth = hikImageView.ImageDataSource.Width;
				hikImageView.ImageSourceHeight = hikImageView.ImageDataSource.Height;
			}
		}
		else
		{
			WriteableBitmap writeableBitmap = null;
			BitmapImage bitmapImage = null;
			if (hikImageView.Source is WriteableBitmap writeableBitmap2)
			{
				hikImageView.ImageSourceWidth = writeableBitmap2.PixelWidth;
				hikImageView.ImageSourceHeight = writeableBitmap2.PixelHeight;
			}
			else if (hikImageView.Source is BitmapImage bitmapImage2)
			{
				hikImageView.ImageSourceWidth = bitmapImage2.PixelWidth;
				hikImageView.ImageSourceHeight = bitmapImage2.PixelHeight;
			}
			else
			{
				hikImageView.ImageSourceWidth = 0;
				hikImageView.ImageSourceHeight = 0;
			}
		}
		hikImageView.DataFlag = -1;
		hikImageView.lastysfr = hikImageView.sfr.ScaleY;
		hikImageView.sImage.Source = e.NewValue as ImageSource;
		hikImageView.needFlash = true;
		hikImageView.PixelInfoLabel = "";
		hikImageView.PixelInfo = "";
		if (hikImageView.curImageX >= 0 && hikImageView.curImageY >= 0 && hikImageView.curImageX < hikImageView.ImageSourceWidth && hikImageView.curImageX < hikImageView.ImageSourceHeight)
		{
			hikImageView.CallChangePixel(hikImageView.curImageX, hikImageView.curImageY);
		}
	}

	private static void ImageSourceChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		HikImageView hikImageView = d as HikImageView;
		hikImageView.DoImageSourceChanged();
		hikImageView.ImageSourceChangeEvent?.Invoke(e.OldValue as ImageData, e.NewValue as ImageData);
		hikImageView.NotifyPropertyChanged("IsShowRangeImage");
	}

	private void DoImageSourceChanged()
	{
		try
		{
			SetImageSource();
		}
		catch (Exception)
		{
		}
		finally
		{
			OnSetImageEnd?.Invoke(this, null);
		}
	}

	public void SetImageDataSource(ImageData imageData)
	{
		ImageDataSource = imageData;
	}

	private void SetImageSource()
	{
		try
		{
			if (IsLoaded)
			{
				UpdateImageSize();
			}
			if (ImageDataSource == null && !IsBindSource)
			{
				Source = null;
			}
			else
			{
				if (double.IsNaN(_imageSize.Width) || double.IsNaN(_imageSize.Height))
				{
					return;
				}
				double scaleX = sfr.ScaleX;
				Size size = new Size((int)(_imageSize.Width * scaleX), (int)(_imageSize.Height * scaleX));
				double num = size.Width / (double)ImageDataSource.Width;
				if (num > 0.5)
				{
					num = 1.0;
				}
				if (num < 1.0 && size.Width != 0.0 && size.Height != 0.0)
				{
					DataFlag = 0;
					if (_byte2Image.ImageAddition == null)
					{
						Source = _byte2Image.BuiltImageSourceA(ImageDataSource, (int)size.Width, (int)size.Height);
					}
					else
					{
						Source = _byte2Image.ImageAddition.BuiltImageSourceA(ImageDataSource, (int)size.Width, (int)size.Height, IsAutoMode, MinValue3D, MaxValue3D) as ImageSource;
					}
					_imageViewWidth = size.Width;
					_imageViewHeight = size.Height;
				}
				else
				{
					if (_byte2Image.ImageAddition == null)
					{
						Source = _byte2Image.BuiltImageSourceA(ImageDataSource);
					}
					else
					{
						Source = ((ImageDataSource == null) ? null : (_byte2Image.ImageAddition.BuiltImageSourceA(ImageDataSource, IsAutoMode, MinValue3D, MaxValue3D) as ImageSource));
					}
					_imageViewWidth = ((ImageDataSource != null) ? ImageDataSource.Width : 0);
					_imageViewHeight = ((ImageDataSource != null) ? ImageDataSource.Height : 0);
				}
			}
		}
		catch
		{
		}
	}

	public double GetImageViewWidth()
	{
		return _imageViewWidth;
	}

	public double GetImageViewHeight()
	{
		return _imageViewHeight;
	}

	private void UpdateImageSize()
	{
		if (ImageDataSource == null)
		{
			return;
		}
		try
		{
			double num = (double)ImageDataSource.Width / (double)ImageDataSource.Height;
			double num2 = viewbox.Width / viewbox.Height;
			if (num > num2)
			{
				double width = viewbox.Width;
				double height = width / num;
				_imageSize = new Size(width, height);
			}
			else
			{
				double height2 = viewbox.Height;
				double width2 = num * height2;
				_imageSize = new Size(width2, height2);
			}
		}
		catch
		{
		}
	}

	public void SetImageLockData(ImageLockData imageLockData)
	{
		_imageLockData = imageLockData;
	}

	public void LockImageShow()
	{
		if (!_imageLockData._bLocked || double.IsNaN(_imageSize.Width) || double.IsNaN(_imageSize.Height) || !_imageLockData.CheckDataValid())
		{
			return;
		}
		Size lastImageSize = new Size((int)_imageSize.Width, (int)_imageSize.Height);
		if (lastImageSize.Width != 0.0 && lastImageSize.Height != 0.0)
		{
			double num = (double)viewbox.GetValue(Canvas.LeftProperty);
			double num2 = (double)viewbox.GetValue(Canvas.TopProperty);
			double x = curPoint.X;
			double y = curPoint.Y;
			if ((sfr.ScaleX != _imageLockData._dScale || Math.Abs(num - _imageLockData._offsetPoint.X) > 0.01 || Math.Abs(num2 - _imageLockData._offsetPoint.Y) > 0.01 || Math.Abs(x - _imageLockData._centerPonit.X) > 0.01 || Math.Abs(y - _imageLockData._centerPonit.Y) > 0.01 || lastImageSize.Width != _lastImageSize.Width || lastImageSize.Height != _lastImageSize.Height) && !double.IsNaN(_imageLockData._offsetPoint.X) && !double.IsNaN(_imageLockData._offsetPoint.Y) && !double.IsNaN(_imageLockData._centerPonit.X) && !double.IsNaN(_imageLockData._centerPonit.Y))
			{
				Init();
				System.Windows.Point offsetPoint = _imageLockData._offsetPoint;
				System.Windows.Point tltOffset = _imageLockData._tltOffset;
				offsetPoint.X = (offsetPoint.X + tltOffset.X) * _imageSize.Width / _imageLockData._imageSize.Width;
				offsetPoint.Y = (offsetPoint.Y + tltOffset.Y) * _imageSize.Width / _imageLockData._imageSize.Width;
				viewbox.SetValue(Canvas.LeftProperty, offsetPoint.X);
				viewbox.SetValue(Canvas.TopProperty, offsetPoint.Y);
				double dScale = _imageLockData._dScale;
				curPoint = new System.Windows.Point(0.0, 0.0);
				System.Windows.Point centerPoint = new System.Windows.Point(_imageLockData._centerPonit.X * _imageSize.Width / _imageLockData._imageSize.Width, _imageLockData._centerPonit.Y * _imageSize.Width / _imageLockData._imageSize.Width);
				ChangeSize(centerPoint, dScale);
				_lastImageSize = lastImageSize;
			}
		}
	}

	public ImageLockData GetImageLockData()
	{
		System.Windows.Point offsetPoint = new System.Windows.Point((double)viewbox.GetValue(Canvas.LeftProperty), (double)viewbox.GetValue(Canvas.TopProperty));
		Size size = new Size(viewbox.Width, viewbox.Height);
		return new ImageLockData(bLocked: false, sfr.ScaleX, offsetPoint, curPoint, offset, _imageSize);
	}

	public void Init()
	{
		sfr.ScaleX = 1.0;
		sfr.ScaleY = 1.0;
		tlt.X = 0.0;
		tlt.Y = 0.0;
		offset.X = 0.0;
		offset.Y = 0.0;
		above.Opacity = 0.0;
		gridWidth = 0.0;
		viewbox.SetValue(Canvas.LeftProperty, 0.0);
		viewbox.SetValue(Canvas.TopProperty, 0.0);
		needFlashPoint = true;
	}

