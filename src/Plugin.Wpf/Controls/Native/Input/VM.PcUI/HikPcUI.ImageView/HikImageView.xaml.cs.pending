	private static void IsShowAssistCrossChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikImageView).OnIsShowAssistCrossChanged();
	}

	private void OnIsShowAssistCrossChanged()
	{
		if (IsShowAssistCross)
		{
			myHorizontalLine = new System.Windows.Shapes.Line
			{
				X1 = 0.0,
				X2 = 1.0,
				Stretch = Stretch.Fill,
				StrokeThickness = 1.0,
				Stroke = (Brush)new BrushConverter().ConvertFromString("#FFFF3C00"),
				IsHitTestVisible = false,
				HorizontalAlignment = System.Windows.HorizontalAlignment.Center
			};
			myVerticalLine = new System.Windows.Shapes.Line
			{
				Y1 = 0.0,
				Y2 = 1.0,
				Stretch = Stretch.Fill,
				StrokeThickness = 1.0,
				Stroke = (Brush)new BrushConverter().ConvertFromString("#FFFF3C00"),
				IsHitTestVisible = false,
				HorizontalAlignment = System.Windows.HorizontalAlignment.Center
			};
			AddGridChild(myHorizontalLine);
			AddGridChild(myVerticalLine);
		}
		else
		{
			RemoveGridChild(myHorizontalLine);
			RemoveGridChild(myVerticalLine);
			myHorizontalLine = null;
			myVerticalLine = null;
		}
	}

	private static void OnIsAutoModeChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		HikImageView hikImageView = d as HikImageView;
		object oldValue = e.OldValue;
		object newValue = e.NewValue;
		if (hikImageView != null && hikImageView.IsShowRangeImage && oldValue != newValue)
		{
			hikImageView.SetImageSource();
		}
	}

	protected void ValueChangedCmdExecute()
	{
		if (IsShowRangeImage && (OldMinValue != MinValue3D || OldMaxValue != MaxValue3D))
		{
			OldMinValue = MinValue3D;
			OldMaxValue = MaxValue3D;
			SetImageSource();
		}
	}

	private static void OnDrawRoiUITypeCahnged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		HikImageView hikImageView = (HikImageView)d;
		RoiUIType roiUIType = (RoiUIType)e.OldValue;
		RoiUIType roiUIType2 = (RoiUIType)e.NewValue;
		if (roiUIType2 == RoiUIType.Default)
		{
			hikImageView.UnPrepareRawRoi();
		}
		else
		{
			hikImageView.PrepareRawRoi(roiUIType2);
		}
	}

