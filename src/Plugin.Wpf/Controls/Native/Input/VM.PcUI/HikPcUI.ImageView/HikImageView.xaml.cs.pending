	public static void OnPointsDataChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		if (e.OldValue != null)
		{
			CollectionChangedEventManager.RemoveHandler(e.OldValue as INotifyCollectionChanged, (d as HikImageView).PointsData_CollectionChanged);
		}
		(d as HikImageView).PointsDataRegister();
		HikImageView view = d as HikImageView;
		ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT> newList = e.NewValue as ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT>;
		ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT> oldList = e.OldValue as ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT>;
		RefreshLargePointList(view, newList, oldList);
	}

	private static void RefreshLargePointList(HikImageView view, ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT> newList, ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT> oldList)
	{
		IEnumerable<MVBPATMATCH_EDGEPOINT_OUT> enumerable = null;
		IEnumerable<MVBPATMATCH_EDGEPOINT_OUT> enumerable2 = null;
		if (oldList != null && newList != null)
		{
			enumerable = newList.Except(oldList);
			enumerable2 = oldList.Except(newList);
		}
		else
		{
			if (oldList != null)
			{
				view.ClearLargePointSet();
				view.CreatPointK();
				return;
			}
			enumerable = newList;
		}
		if (view != null)
		{
			view.ClearLargePointSet();
			AddPointSet(view, newList);
			view.CreatPointK();
		}
	}

	private static void AddPointSet(HikImageView view, ObservableCollection<MVBPATMATCH_EDGEPOINT_OUT> newList)
	{
		if (newList == null)
		{
			return;
		}
		foreach (MVBPATMATCH_EDGEPOINT_OUT @new in newList)
		{
			uint num = 0u;
			view.AddNewPointK(color: (@new.score_flag != 0) ? ((@new.score_flag != 1) ? (-65536) : (-256)) : (-16711936), x: @new.x, y: @new.y);
		}
	}

	private static void ChangePointSet(HikImageView view, IEnumerable<MVBPATMATCH_EDGEPOINT_OUT> addList, IEnumerable<MVBPATMATCH_EDGEPOINT_OUT> delList)
	{
		if (addList != null)
		{
			foreach (MVBPATMATCH_EDGEPOINT_OUT add in addList)
			{
				uint num = 0u;
				view.AddNewPointK(color: (add.score_flag != 0) ? ((add.score_flag != 1) ? (-65536) : (-256)) : (-16711936), x: add.x, y: add.y);
			}
		}
		if (delList != null)
		{
			foreach (MVBPATMATCH_EDGEPOINT_OUT del in delList)
			{
				view.DeletePointK(del.x, del.y);
			}
		}
		view.CreatPointK();
	}

	private static void ChangePointSet(HikImageView view, IList addList, IList delList)
	{
		if (addList != null)
		{
			foreach (MVBPATMATCH_EDGEPOINT_OUT add in addList)
			{
				uint num = 0u;
				view.AddNewPointK(color: (add.score_flag != 0) ? ((add.score_flag != 1) ? (-65536) : (-256)) : (-16711936), x: add.x, y: add.y);
			}
		}
		if (delList != null)
		{
			foreach (MVBPATMATCH_EDGEPOINT_OUT del in delList)
			{
				view.DeletePointK(del.x, del.y);
			}
		}
		view.CreatPointK();
	}

