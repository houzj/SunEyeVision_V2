	public void CreateOutLineE(List<System.Windows.Point> ptList, int color, double opacity, string tips)
	{
		if (sImage.Source == null)
		{
			return;
		}
		double ratio = GetRatio();
		pointWidth = PointWidthBase / (sfr.ScaleX * viewScal);
		GeometryGroup geometryGroup = null;
		geometryGroup = new GeometryGroup();
		for (int i = 0; i < ptList.Count; i += 2)
		{
			if (i + 1 < ptList.Count && Math.Abs(ptList[i].X - ptList[i + 1].X) < 2.0 && Math.Abs(ptList[i].Y - ptList[i + 1].Y) < 2.0)
			{
				GeometryGroup geometryGroup2 = new GeometryGroup();
				LineGeometry value = new LineGeometry(new System.Windows.Point(ptList[i].X * ratio, ptList[i].Y * ratio), new System.Windows.Point(ptList[i + 1].X * ratio, ptList[i + 1].Y * ratio));
				geometryGroup.Children.Add(value);
				geometryGroup2.Children.Add(value);
				this.geometryGroup.Children.Add(geometryGroup2);
			}
		}
		System.Windows.Shapes.Path path = new System.Windows.Shapes.Path();
		path.Stroke = GetColorFromInt(color);
		path.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
		path.IsHitTestVisible = false;
		path.Opacity = opacity;
		path.Data = geometryGroup;
		mView.Children.Add(path);
		shapeListE.Add(path);
		pointPathE.Add(path);
	}

	public void CreatCharacter(string text, double fStartX, double fStartY, double fAngle)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			TextBlock textBlock = new TextBlock();
			textBlock.Foreground = Brushes.LightGreen;
			textBlock.Text = text;
			textBlock.IsHitTestVisible = false;
			textBlock.SetValue(Canvas.TopProperty, fStartY * ratio);
			textBlock.SetValue(Canvas.LeftProperty, fStartX * ratio);
			if (fAngle >= -180.0 && fAngle <= 180.0)
			{
				RotateTransform rotateTransform = new RotateTransform(fAngle);
				rotateTransform.CenterX = textBlock.ActualWidth / 2.0;
				rotateTransform.CenterY = textBlock.ActualHeight / 2.0;
				textBlock.RenderTransform = rotateTransform;
			}
			mView.Children.Add(textBlock);
			shapeList.Add(textBlock);
		}
	}

	private double CalculateMaxWidthFontSize(double width, double endFontSize, string text, FontFamily fontFamily, FontStyle fontStyle, FontWeight fontWeight, FontStretch fontStretch)
	{
		if (double.IsNaN(width))
		{
			return endFontSize;
		}
		if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, endFontSize).WidthIncludingTrailingWhitespace < width)
		{
			return endFontSize;
		}
		double num = 0.0;
		while (endFontSize > 0.0)
		{
			double num2 = (endFontSize + num) / 2.0;
			if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2).WidthIncludingTrailingWhitespace < width && MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2 + space).WidthIncludingTrailingWhitespace > width)
			{
				return num2;
			}
			if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2).WidthIncludingTrailingWhitespace < width)
			{
				num = num2 + space;
				continue;
			}
			if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2).WidthIncludingTrailingWhitespace > width)
			{
				endFontSize = num2 - space;
				continue;
			}
			return num2;
		}
		return FontSize;
	}

	private double CalculateMaxHeightFontSize(double height, double endFontSize, string text, FontFamily fontFamily, FontStyle fontStyle, FontWeight fontWeight, FontStretch fontStretch)
	{
		if (double.IsNaN(height))
		{
			return endFontSize;
		}
		if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, endFontSize).Height < height)
		{
			return endFontSize;
		}
		double num = 0.0;
		while (endFontSize > 0.0)
		{
			double num2 = (endFontSize + num) / 2.0;
			if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2).Height < height && MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2 + space).Height > height)
			{
				return num2;
			}
			if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2).Height < height)
			{
				num = num2 + space;
				continue;
			}
			if (MeasureText(text, fontFamily, fontStyle, fontWeight, fontStretch, num2).Height > height)
			{
				endFontSize = num2 - space;
				continue;
			}
			return num2;
		}
		return endFontSize;
	}

	public double CreatCharacterE(string text, double startX, double startY, double angle, int fontSize, string color, double opacity, double nextPos = 0.0, double width = 0.0, double height = 0.0, string tip = "", bool needTip = false, object dataSource = null)
	{
		if (sImage.Source == null)
		{
			return 0.0;
		}
		if (startX > GetImageWidth() || startY > GetImageHeight())
		{
			return nextPos;
		}
		if (text == (AppLocalizationService.GetLang("Lang_ModuleErr") ?? "模块执行异常"))
		{
			return 0.0;
		}
		if (fontSize == 0 || fontSize > 1000)
		{
			fontSize = 10;
		}
		double ratio = GetRatio();
		TextBlock textBlock = new TextBlock
		{
			DataContext = dataSource
		};
		textBlock.IsHitTestVisible = false;
		textBlock.TextWrapping = TextWrapping.Wrap;
		textBlock.Text = text;
		textBlock.SetValue(Canvas.TopProperty, startY * ratio);
		textBlock.SetValue(Canvas.LeftProperty, startX * ratio);
		textBlock.MaxWidth = sImage.Width;
		if (width != 0.0 && height != 0.0)
		{
			textBlock.FontSize = Math.Min(CalculateMaxWidthFontSize(width * ratio, fontSize, textBlock.Text, textBlock.FontFamily, textBlock.FontStyle, textBlock.FontWeight, textBlock.FontStretch), CalculateMaxHeightFontSize(height * ratio, fontSize, textBlock.Text, textBlock.FontFamily, textBlock.FontStyle, textBlock.FontWeight, textBlock.FontStretch));
		}
		else
		{
			textBlock.FontSize = fontSize;
		}
		textBlock.Foreground = GetBrushByString(color);
		textBlock.Opacity = opacity;
		textBlock.ToolTip = tip;
		if ((tip != "" && tip != text) & needTip)
		{
			textBlock.IsHitTestVisible = true;
		}
		if (angle >= -180.0 && angle <= 180.0)
		{
			RotateTransform renderTransform = new RotateTransform(angle);
			textBlock.RenderTransform = renderTransform;
		}
		mView.Children.Add(textBlock);
		shapeListE.Add(textBlock);
		return GetTextDisplayWidth(textBlock.Text, textBlock.FontFamily, textBlock.FontStyle, textBlock.FontWeight, textBlock.FontStretch, textBlock.FontSize).Height / ratio + (startY + 0.5);
	}

	public void ClearShapesByData(object dataSource)
	{
		if (dataSource == null)
		{
			return;
		}
		IEnumerable<FrameworkElement> source = shapeListE.Where((FrameworkElement p) => p.DataContext == dataSource);
		if (source.Count() > 0)
		{
			source.ToList().ForEach((FrameworkElement p) =>
			{
				mView.Children.Remove(p);
				shapeListE.Remove(p);
			});
		}
	}

	private static SolidColorBrush GetColorFromInt(int nColor)
	{
		if (Convert.ToByte((nColor >> 24) & 0xFF) == 0)
		{
			return new SolidColorBrush(Color.FromArgb(Convert.ToByte(255), Convert.ToByte((nColor >> 16) & 0xFF), Convert.ToByte((nColor >> 8) & 0xFF), Convert.ToByte(nColor & 0xFF)));
		}
		return new SolidColorBrush(Color.FromArgb(Convert.ToByte((nColor >> 24) & 0xFF), Convert.ToByte((nColor >> 16) & 0xFF), Convert.ToByte((nColor >> 8) & 0xFF), Convert.ToByte(nColor & 0xFF)));
	}

	public void CreatAxis(float fCenterX, float fCenterY, float VectorX_X, float VectorX_Y, float VectorY_X, float VectorY_Y, string tips, string color, double opacity)
	{
		if (sImage.Source != null)
		{
			float axisLenth = (float)((double)ImageSourceWidth * 0.05);
			System.Windows.Point centerPoint = new System.Windows.Point(fCenterX, fCenterY);
			DrawAxis("X", centerPoint, VectorX_X, VectorX_Y, axisLenth, tips, color, opacity);
			DrawAxis("Y", centerPoint, VectorY_X, VectorY_Y, axisLenth, tips, color, opacity);
		}
	}

	private void DrawAxis(string text, System.Windows.Point CenterPoint, float Vector_X, float Vector_Y, float AxisLenth, string tips, string color, double opacity)
	{
		int num = 7;
		float num2 = (float)GetRatio();
		Vector vector = new Vector(Vector_X, Vector_Y);
		vector.Normalize();
		if (double.IsNaN(vector.X) || double.IsNaN(vector.Y))
		{
			return;
		}
		System.Windows.Point point = CenterPoint + vector * AxisLenth;
		CreateArrowE(CenterPoint.X, CenterPoint.Y, point.X, point.Y, color, tips, needLabel: true, opacity, singleDir: true);
		Size textDisplayWidth = GetTextDisplayWidth(text, FontFamily, FontStyle, FontWeight, FontStretch, num);
		System.Windows.Point point2 = point;
		Vector vector2 = new Vector(0f - Vector_Y, Vector_X);
		vector2.Normalize();
		if (!double.IsNaN(vector2.X) && !double.IsNaN(vector2.Y))
		{
			if (Vector.CrossProduct(vector, vector2) < 0.0)
			{
				vector2 = -vector2;
			}
			System.Windows.Point point3 = point2 + vector2 * textDisplayWidth.Width / num2 / 2.0;
			double angle = Vector.AngleBetween(new Vector(0.0, 1.0), vector);
			CreatCharacterE(text, point3.X, point3.Y, angle, num, color, opacity);
		}
	}

	public static Size GetTextDisplayWidth(string str, FontFamily fontFamily, FontStyle fontStyle, FontWeight fontWeight, FontStretch fontStretch, double FontSize)
	{
		FormattedText formattedText = MeasureText(str, fontFamily, fontStyle, fontWeight, fontStretch, FontSize);
		return new Size(formattedText.Width, formattedText.Height);
	}

	private static FormattedText MeasureText(string str, FontFamily fontFamily, FontStyle fontStyle, FontWeight fontWeight, FontStretch fontStretch, double FontSize)
	{
		return new FormattedText(str, CultureInfo.CurrentUICulture, System.Windows.FlowDirection.LeftToRight, new Typeface(fontFamily, fontStyle, fontWeight, fontStretch), FontSize, Brushes.Black);
	}

	public void CreateArrowE(double fStartX, double fStartY, double fEndX, double fEndY, string nColor, string tips, bool needLabel, double opacity, bool singleDir = false, bool IsThroughLine = false, double strokeThickness = 1.0, bool isDashed = false)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			System.Windows.Shapes.Line line = new System.Windows.Shapes.Line();
			line.X1 = (fStartX + 0.5) * ratio;
			line.Y1 = (fStartY + 0.5) * ratio;
			line.X2 = (fEndX + 0.5) * ratio;
			line.Y2 = (fEndY + 0.5) * ratio;
			line.Stroke = GetBrushByString(nColor);
			line.IsHitTestVisible = true;
			line.Opacity = opacity;
			line.ToolTip = tips;
			line.StrokeThickness = 1.0 * strokeThickness / (sfr.ScaleX * viewScal);
			mView.Children.Add(line);
			shapeListE.Add(line);
			float num = 10f;
			double num2 = Math.Atan2(fStartY - fEndY, fStartX - fEndX);
			num2 = num2 * 180.0 / Math.PI;
			RotateTransform rotateTransform = new RotateTransform
			{
				CenterX = fEndX,
				CenterY = fEndY,
				Angle = num2
			};
			System.Windows.Point point = new System.Windows.Point(fEndX + (double)num, fEndY);
			point = rotateTransform.Transform(point);
			rotateTransform = new RotateTransform
			{
				CenterX = fEndX,
				CenterY = fEndY,
				Angle = 45.0
			};
			System.Windows.Point point2 = rotateTransform.Transform(point);
			CreateLineE(fEndX, fEndY, point2.X, point2.Y, nColor, tips, needTips: true, needLabel: false, opacity, singleDir: true, IsThroughLine: false, strokeThickness);
			rotateTransform = new RotateTransform
			{
				CenterX = fEndX,
				CenterY = fEndY,
				Angle = -45.0
			};
			System.Windows.Point point3 = rotateTransform.Transform(point);
			CreateLineE(fEndX, fEndY, point3.X, point3.Y, nColor, tips, needTips: true, needLabel: false, opacity, singleDir: true, IsThroughLine: false, strokeThickness);
		}
	}

	private System.Windows.Point getEllipsePointByAngle(double rWidth, double rHeight, double dAngle, double dCenterX, double dCenterY)
	{
		System.Windows.Point result = default;
		dAngle %= 360.0;
		double num = Math.PI * dAngle / 180.0;
		if ((num >= 0.0 && num < Math.PI / 2.0) || (num > 4.71238898038469 && num < Math.PI * 2.0))
		{
			result.X = rWidth * rHeight / Math.Sqrt(rHeight * rHeight + rWidth * rWidth * Math.Tan(num) * Math.Tan(num));
			result.Y = rWidth * rHeight * Math.Tan(num) / Math.Sqrt(rHeight * rHeight + rWidth * rWidth * Math.Tan(num) * Math.Tan(num));
		}
		else if (num > Math.PI / 2.0 && num < 4.71238898038469)
		{
			result.X = (0.0 - rWidth) * rHeight / Math.Sqrt(rHeight * rHeight + rWidth * rWidth * Math.Tan(num) * Math.Tan(num));
			result.Y = (0.0 - rWidth) * rHeight * Math.Tan(num) / Math.Sqrt(rHeight * rHeight + rWidth * rWidth * Math.Tan(num) * Math.Tan(num));
		}
		else if (num == Math.PI / 2.0)
		{
			result.X = 0.0;
			result.Y = rHeight;
		}
		else if (num == 4.71238898038469)
		{
			result.X = 0.0;
			result.Y = 0.0 - rHeight;
		}
		result.X += dCenterX;
		result.Y += dCenterY;
		return result;
	}

	public void CreateArc(double rWidth, double rHeight, double fCenterX, double fCenterY, double fStartAngle, double fEndAngle, double fRotateAngle, string tips, int color, double opacity, float StrokeThickness = 1f)
	{
		if (fEndAngle == fStartAngle)
		{
			return;
		}
		if (Math.Abs(fEndAngle - fStartAngle) % 360.0 == 0.0)
		{
			CreateAngleCircle(rWidth, rHeight, fCenterX, fCenterY, fRotateAngle, tips, color, opacity, StrokeThickness);
		}
		else if (sImage.Source != null && !(rWidth < 0.0) && !(rHeight < 0.0))
		{
			double ratio = GetRatio();
			System.Windows.Shapes.Path path = new System.Windows.Shapes.Path();
			double num = rWidth * ratio * 2.0;
			double num2 = rHeight * ratio * 2.0;
			fCenterX += 0.5;
			fCenterY += 0.5;
			fCenterX *= ratio;
			fCenterY *= ratio;
			path.SetValue(Canvas.TopProperty, fCenterY - num2 / 2.0);
			path.SetValue(Canvas.LeftProperty, fCenterX - num / 2.0);
			path.Stroke = GetColorFromInt(color);
			path.IsHitTestVisible = true;
			System.Windows.Controls.ToolTip toolTip = new System.Windows.Controls.ToolTip();
			toolTip.Content = tips;
			toolTip.StaysOpen = true;
			path.ToolTip = toolTip;
			path.Opacity = opacity;
			System.Windows.Point ellipsePointByAngle = getEllipsePointByAngle(num / 2.0, num2 / 2.0, fStartAngle, num / 2.0, num2 / 2.0);
			System.Windows.Point ellipsePointByAngle2 = getEllipsePointByAngle(num / 2.0, num2 / 2.0, fEndAngle, num / 2.0, num2 / 2.0);
			int num3 = ((Math.Abs(fEndAngle - fStartAngle) > 180.0) ? 1 : 0);
			string value = $"M {ellipsePointByAngle.X},{ellipsePointByAngle.Y} A {num / 2.0},{num2 / 2.0} 0 {num3} 1 {ellipsePointByAngle2.X},{ellipsePointByAngle2.Y}";
			path.StrokeThickness = (double)StrokeThickness / (sfr.ScaleX * viewScal);
			path.Width = num + path.StrokeThickness;
			path.Height = num2 + path.StrokeThickness;
			TypeConverter converter = TypeDescriptor.GetConverter(typeof(Geometry));
			path.Data = (Geometry)converter.ConvertFrom(value);
			if (fRotateAngle >= -180.0 && fRotateAngle <= 180.0)
			{
				RotateTransform rotateTransform = new RotateTransform(fRotateAngle);
				rotateTransform.CenterX = path.Width / 2.0;
				rotateTransform.CenterY = path.Height / 2.0;
				path.RenderTransform = rotateTransform;
			}
			mView.Children.Add(path);
			shapeListE.Add(path);
		}
	}

	public void CreateAngleCircle(double rWidth, double rHeight, double fCenterX, double fCenterY, double fRotateAngle, string tips, int color, double opacity, float StrokeThickness = 1f)
	{
		if (sImage.Source != null && !(rWidth < 0.0) && !(rHeight < 0.0))
		{
			double ratio = GetRatio();
			System.Windows.Shapes.Ellipse ellipse = new System.Windows.Shapes.Ellipse();
			ellipse.Width = rWidth * ratio * 2.0;
			ellipse.Height = rHeight * ratio * 2.0;
			fCenterX += 0.5;
			fCenterY += 0.5;
			fCenterX *= ratio;
			fCenterY *= ratio;
			ellipse.SetValue(Canvas.TopProperty, fCenterY - ellipse.Height / 2.0);
			ellipse.SetValue(Canvas.LeftProperty, fCenterX - ellipse.Width / 2.0);
			ellipse.Stroke = GetColorFromInt(color);
			ellipse.IsHitTestVisible = true;
			System.Windows.Controls.ToolTip toolTip = new System.Windows.Controls.ToolTip();
			toolTip.Content = tips;
			toolTip.StaysOpen = true;
			ellipse.ToolTip = toolTip;
			ellipse.Opacity = opacity;
			ellipse.StrokeThickness = (double)StrokeThickness / (sfr.ScaleX * viewScal);
			if (fRotateAngle >= -180.0 && fRotateAngle <= 180.0 && fRotateAngle != 0.0)
			{
				RotateTransform rotateTransform = new RotateTransform(fRotateAngle);
				rotateTransform.CenterX = ellipse.Width / 2.0;
				rotateTransform.CenterY = ellipse.Height / 2.0;
				ellipse.RenderTransform = rotateTransform;
			}
			mView.Children.Add(ellipse);
			shapeListE.Add(ellipse);
		}
	}

	private static Brush GetBrushByString(string color)
	{
		if (color != null)
		{
			try
			{
				return brushConverter.ConvertFromString(color) as Brush;
			}
			catch
			{
			}
		}
		return null;
	}

	public void CreatCircleE(double rWidth, double rHeight, double fCenterX, double fCenterY, string tips, string color, double opacity, double strokeThickness = 1.0, string fill = null)
	{
		if (sImage.Source != null && !(rWidth < 0.0) && !(rHeight < 0.0))
		{
			double ratio = GetRatio();
			System.Windows.Shapes.Ellipse ellipse = new System.Windows.Shapes.Ellipse();
			ellipse.Width = rWidth * ratio * 2.0;
			ellipse.Height = rHeight * ratio * 2.0;
			fCenterX += 0.5;
			fCenterY += 0.5;
			fCenterX *= ratio;
			fCenterY *= ratio;
			ellipse.SetValue(Canvas.TopProperty, fCenterY - ellipse.Height / 2.0);
			ellipse.SetValue(Canvas.LeftProperty, fCenterX - ellipse.Width / 2.0);
			ellipse.Stroke = GetBrushByString(color);
			ellipse.IsHitTestVisible = true;
			System.Windows.Controls.ToolTip toolTip = new System.Windows.Controls.ToolTip();
			toolTip.Content = tips;
			toolTip.StaysOpen = true;
			ellipse.ToolTip = toolTip;
			ellipse.Opacity = opacity;
			ellipse.Fill = GetBrushByString(fill);
			ellipse.StrokeThickness = 1.0 * strokeThickness / (sfr.ScaleX * viewScal);
			ellipse.Tag = strokeThickness;
			mView.Children.Add(ellipse);
			shapeListE.Add(ellipse);
		}
	}

	public void CreatCircle(double rWidth, double rHeight, double fCenterX, double fCenterY)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			System.Windows.Shapes.Ellipse ellipse = new System.Windows.Shapes.Ellipse();
			ellipse.Width = rWidth * ratio * 2.0;
			ellipse.Height = rHeight * ratio * 2.0;
			fCenterX += 0.5;
			fCenterY += 0.5;
			fCenterX *= ratio;
			fCenterY *= ratio;
			ellipse.SetValue(Canvas.TopProperty, fCenterY - ellipse.Height / 2.0);
			ellipse.SetValue(Canvas.LeftProperty, fCenterX - ellipse.Width / 2.0);
			ellipse.Stroke = Brushes.LawnGreen;
			ellipse.IsHitTestVisible = false;
			ellipse.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
			mView.Children.Add(ellipse);
			shapeList.Add(ellipse);
		}
	}

	public void CreatAnnularSector(double rInnner, double rOuter, double fCenterX, double fCenterY, double fStartAngle, double fAngleRange, string tips, string color, double opacity, string fill = null, double strokeThickness = 1.0)
	{
		if (sImage.Source != null && !(rInnner < 0.0) && !(rOuter < rInnner))
		{
			double ratio = GetRatio();
			RotateTransform rotateTransform = new RotateTransform();
			System.Windows.Shapes.Path path = new System.Windows.Shapes.Path();
			PathGeometry pathGeometry = new PathGeometry();
			PathFigure pathFigure = new PathFigure();
			fCenterX += 0.5;
			fCenterY += 0.5;
			fCenterX *= ratio;
			fCenterY *= ratio;
			rInnner *= ratio;
			rOuter *= ratio;
			if (fAngleRange == 360.0)
			{
				fAngleRange -= 1E-05;
			}
			rotateTransform.CenterX = fCenterX;
			rotateTransform.CenterY = fCenterY;
			rotateTransform.Angle = fStartAngle;
			pathFigure.StartPoint = rotateTransform.Transform(new System.Windows.Point(fCenterX + rInnner, fCenterY));
			rotateTransform.Angle = fStartAngle + fAngleRange;
			System.Windows.Point point = rotateTransform.Transform(new System.Windows.Point(fCenterX + rInnner, fCenterY));
			pathFigure.Segments.Add(new ArcSegment
			{
				Size = new Size(rInnner, rInnner),
				IsLargeArc = (fAngleRange > 180.0),
				SweepDirection = SweepDirection.Clockwise,
				Point = new System.Windows.Point(point.X, point.Y)
			});
			point = rotateTransform.Transform(new System.Windows.Point(fCenterX + rOuter, fCenterY));
			pathFigure.Segments.Add(new LineSegment
			{
				Point = new System.Windows.Point(point.X, point.Y),
				IsStroked = false
			});
			rotateTransform.Angle = fStartAngle;
			point = rotateTransform.Transform(new System.Windows.Point(fCenterX + rOuter, fCenterY));
			pathFigure.Segments.Add(new ArcSegment
			{
				Size = new Size(rOuter, rOuter),
				IsLargeArc = (fAngleRange > 180.0),
				Point = new System.Windows.Point(point.X, point.Y)
			});
			pathFigure.Segments.Add(new LineSegment
			{
				Point = new System.Windows.Point(pathFigure.StartPoint.X, pathFigure.StartPoint.Y)
			});
			pathGeometry.Figures.Add(pathFigure);
			path.Data = pathGeometry;
			path.Stroke = GetBrushByString(color);
			path.IsHitTestVisible = true;
			System.Windows.Controls.ToolTip toolTip = new System.Windows.Controls.ToolTip();
			toolTip.Content = tips;
			toolTip.StaysOpen = true;
			path.ToolTip = toolTip;
			path.Opacity = opacity;
			path.Fill = GetBrushByString(fill);
			path.StrokeThickness = 1.0 * strokeThickness / (sfr.ScaleX * viewScal);
			mView.Children.Add(path);
			shapeListE.Add(path);
		}
	}

	public void CreatPolygon(List<System.Windows.Point> points, string tips, string color, double opacity, string fill = null, double strokeThickness = 1.0)
	{
		if (sImage.Source == null || points == null || points.Count <= 0)
		{
			return;
		}
		double ratio = GetRatio();
		System.Windows.Shapes.Polygon polygon = new System.Windows.Shapes.Polygon();
		foreach (System.Windows.Point point in points)
		{
			double x = point.X * ratio;
			double y = point.Y * ratio;
			polygon.Points.Add(new System.Windows.Point(x, y));
		}
		polygon.Stroke = GetBrushByString(color);
		polygon.IsHitTestVisible = true;
		System.Windows.Controls.ToolTip toolTip = new System.Windows.Controls.ToolTip();
		toolTip.Content = tips;
		toolTip.StaysOpen = true;
		polygon.ToolTip = toolTip;
		polygon.Opacity = opacity;
		polygon.Fill = GetBrushByString(fill);
		polygon.StrokeThickness = 1.0 * strokeThickness / (sfr.ScaleX * viewScal);
		polygon.Tag = strokeThickness;
		mView.Children.Add(polygon);
		shapeListE.Add(polygon);
	}

	public void CreatLine(double fStartX, double fStartY, double fEndX, double fEndY, int nColor)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			System.Windows.Shapes.Line line = new System.Windows.Shapes.Line();
			line.X1 = (fStartX + 0.5) * ratio;
			line.Y1 = (fStartY + 0.5) * ratio;
			line.X2 = (fEndX + 0.5) * ratio;
			line.Y2 = (fEndY + 0.5) * ratio;
			line.Stroke = GetColorFromInt(nColor);
			line.IsHitTestVisible = false;
			line.Opacity = 1.0;
			line.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
			mView.Children.Add(line);
			shapeList.Add(line);
		}
	}

	public void CreatDotLineX(double fStartX, double fEndX, double fY, double increase, double empty, int nColor)
	{
		if (sImage.Source == null)
		{
			return;
		}
		while (!(fStartX >= fEndX))
		{
			if (fStartX + increase < fEndX)
			{
				CreatLine(fStartX, fY, fStartX + increase, fY, nColor);
				fStartX = fStartX + increase + empty;
			}
			else
			{
				CreatLine(fStartX, fY, fEndX, fY, nColor);
				fStartX = fStartX + increase + empty;
			}
		}
	}

	public void CreatDotLineY(double fStartY, double fEndY, double fX, double increase, double empty, int nColor)
	{
		if (sImage.Source == null)
		{
			return;
		}
		while (!(fStartY >= fEndY))
		{
			if (fStartY + increase < fEndY)
			{
				CreatLine(fX, fStartY, fX, fStartY + increase, nColor);
				fStartY = fStartY + increase + empty;
			}
			else
			{
				CreatLine(fX, fStartY, fX, fEndY, nColor);
				fStartY = fStartY + increase + empty;
			}
		}
	}

	private System.Windows.Controls.ToolTip GetToolTip(string name, string remark)
	{
		StackPanel stackPanel = new StackPanel();
		System.Windows.Controls.Label label = new System.Windows.Controls.Label();
		label.FontWeight = FontWeights.Bold;
		label.Background = Brushes.Blue;
		label.Foreground = Brushes.White;
		label.Content = name + "检测结果";
		stackPanel.Children.Add(label);
		TextBlock textBlock = new TextBlock();
		textBlock.Padding = new Thickness(10.0);
		textBlock.TextWrapping = TextWrapping.WrapWithOverflow;
		textBlock.Width = 200.0;
		textBlock.Text = name + "\r" + remark;
		stackPanel.Children.Add(textBlock);
		System.Windows.Shapes.Line line = new System.Windows.Shapes.Line();
		line.Stroke = Brushes.Black;
		line.StrokeThickness = 1.0;
		line.X2 = 200.0;
		stackPanel.Children.Add(line);
		StackPanel stackPanel2 = new StackPanel();
		stackPanel2.Orientation = System.Windows.Controls.Orientation.Horizontal;
		System.Windows.Controls.Label label2 = new System.Windows.Controls.Label();
		label2.FontWeight = FontWeights.Bold;
		label2.Content = "右键菜单显示路由信息";
		stackPanel2.Children.Add(label2);
		stackPanel.Children.Add(stackPanel2);
		System.Windows.Controls.ToolTip toolTip = new System.Windows.Controls.ToolTip();
		toolTip.Content = stackPanel;
		return toolTip;
	}

	public void CreateLineE(double fStartX, double fStartY, double fEndX, double fEndY, string nColor, string tips, bool needTips, bool needLabel, double opacity, bool singleDir = false, bool IsThroughLine = false, double strokeThickness = 1.0, bool isDashed = false)
	{
		if (sImage.Source == null)
		{
			return;
		}
		double ratio = GetRatio();
		System.Windows.Shapes.Line line = new System.Windows.Shapes.Line();
		if (IsThroughLine && ImageDataSource != null)
		{
			if (CalBoderPoint(new System.Windows.Point(fStartX, fStartY), new System.Windows.Point(fEndX, fEndY), ImageDataSource.Width, ImageDataSource.Height, out var borderPoint, out var borderPoint2))
			{
				line.X1 = (borderPoint.X + 0.5) * ratio;
				line.Y1 = (borderPoint.Y + 0.5) * ratio;
				line.X2 = (borderPoint2.X + 0.5) * ratio;
				line.Y2 = (borderPoint2.Y + 0.5) * ratio;
			}
			else
			{
				line.X1 = (fStartX + 0.5) * ratio;
				line.Y1 = (fStartY + 0.5) * ratio;
				line.X2 = (fEndX + 0.5) * ratio;
				line.Y2 = (fEndY + 0.5) * ratio;
			}
		}
		else
		{
			line.X1 = (fStartX + 0.5) * ratio;
			line.Y1 = (fStartY + 0.5) * ratio;
			line.X2 = (fEndX + 0.5) * ratio;
			line.Y2 = (fEndY + 0.5) * ratio;
		}
		line.Stroke = GetBrushByString(nColor);
		line.IsHitTestVisible = true;
		line.Opacity = opacity;
		if (needTips)
		{
			line.ToolTip = tips;
		}
		double num = sfr.ScaleX * viewScal;
		if (isDashed)
		{
			line.StrokeDashArray = new DoubleCollection
			{
				2.0 * num,
				3.0 * num
			};
		}
		line.Tag = strokeThickness;
		line.StrokeThickness = 1.0 * strokeThickness / num;
		line.Tag = strokeThickness;
		mView.Children.Add(line);
		shapeListE.Add(line);
		if (needLabel)
		{
			CreateArrowE(fStartX, fStartY, fEndX, fEndY, nColor, tips, needLabel, opacity, singleDir, IsThroughLine, strokeThickness, isDashed);
		}
	}

	public void CreatRectangle(double fCenterX, double fCenterY, double fWidth, double fHeight, double fAngle, int nColor)
	{
		if (sImage.Source != null && !(fWidth < 0.0) && !(fHeight < 0.0))
		{
			double ratio = GetRatio();
			Rectangle rectangle = new Rectangle();
			double num = fCenterX - fWidth / 2.0 + 0.5;
			double num2 = fCenterY - fHeight / 2.0 + 0.5;
			rectangle.Width = fWidth * ratio;
			rectangle.Height = fHeight * ratio;
			num *= ratio;
			num2 *= ratio;
			rectangle.Stroke = GetColorFromInt(nColor);
			rectangle.SetValue(Canvas.TopProperty, num2);
			rectangle.SetValue(Canvas.LeftProperty, num);
			rectangle.IsHitTestVisible = false;
			rectangle.Opacity = 1.0;
			rectangle.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
			if (fAngle >= -180.0 && fAngle <= 180.0)
			{
				RotateTransform rotateTransform = new RotateTransform(fAngle);
				rotateTransform.CenterX = rectangle.Width / 2.0;
				rotateTransform.CenterY = rectangle.Height / 2.0;
				rectangle.RenderTransform = rotateTransform;
			}
			mView.Children.Add(rectangle);
			shapeList.Add(rectangle);
		}
	}

	public void CreatRectangleE(double fCenterX, double fCenterY, double fWidth, double fHeight, double fAngle, string nColor, string tips, double opacity, double fSkewAngleX = 0.0, double strokeThickness = 1.0, double fSkewAngleY = 0.0, string fill = null)
	{
		if (sImage.Source != null && !(fWidth < 0.0) && !(fHeight < 0.0))
		{
			double ratio = GetRatio();
			Rectangle rectangle = new Rectangle();
			double num = fCenterX - fWidth / 2.0 + 0.5;
			double num2 = fCenterY - fHeight / 2.0 + 0.5;
			rectangle.Width = fWidth * ratio;
			rectangle.Height = fHeight * ratio;
			num *= ratio;
			num2 *= ratio;
			rectangle.Stroke = GetBrushByString(nColor);
			rectangle.SetValue(Canvas.TopProperty, num2);
			rectangle.SetValue(Canvas.LeftProperty, num);
			rectangle.IsHitTestVisible = true;
			rectangle.Opacity = opacity;
			rectangle.ToolTip = tips;
			rectangle.StrokeThickness = 1.0 * strokeThickness / (sfr.ScaleX * viewScal);
			rectangle.Tag = strokeThickness;
			TransformGroup renderTransform = new TransformGroup
			{
				Children = new TransformCollection
				{
					new SkewTransform
					{
						AngleX = fSkewAngleX,
						AngleY = fSkewAngleY,
						CenterX = rectangle.Width / 2.0,
						CenterY = rectangle.Height / 2.0
					},
					new RotateTransform
					{
						Angle = fAngle,
						CenterX = rectangle.Width / 2.0,
						CenterY = rectangle.Height / 2.0
					}
				}
			};
			rectangle.RenderTransform = renderTransform;
			rectangle.IsHitTestVisible = !string.IsNullOrEmpty(tips);
			rectangle.Fill = GetBrushByString(fill);
			mView.Children.Add(rectangle);
			shapeListE.Add(rectangle);
		}
	}

	public void CreatHeighLightRectangle(double fCenterX, double fCenterY, double fWidth, double fHeight, double fAngle)
	{
		if (sImage.Source != null && !(fWidth < 0.0) && !(fHeight < 0.0))
		{
			double ratio = GetRatio();
			Rectangle rectangle = new Rectangle();
			double num = fCenterX - fWidth / 2.0 + 0.5;
			double num2 = fCenterY - fHeight / 2.0 + 0.5;
			rectangle.Width = fWidth * ratio;
			rectangle.Height = fHeight * ratio;
			num *= ratio;
			num2 *= ratio;
			rectangle.SetValue(Canvas.TopProperty, num2);
			rectangle.SetValue(Canvas.LeftProperty, num);
			rectangle.Stroke = new SolidColorBrush(Color.FromArgb(byte.MaxValue, 238, 140, 74));
			rectangle.IsHitTestVisible = false;
			rectangle.Opacity = 1.0;
			rectangle.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
			if (fAngle >= -180.0 && fAngle <= 180.0)
			{
				RotateTransform rotateTransform = new RotateTransform(fAngle);
				rotateTransform.CenterX = rectangle.Width / 2.0;
				rotateTransform.CenterY = rectangle.Height / 2.0;
				rectangle.RenderTransform = rotateTransform;
			}
			mView.Children.Add(rectangle);
			shapeList.Add(rectangle);
		}
	}

	public void CreatAngle(LineAngle shape, string tips, string nColor, double opacity)
	{
		if (sImage.Source != null)
		{
			LineAndAngle lineAndAngle = new LineAndAngle();
			lineAndAngle.SetBinding(LineAndAngle.Line1Point1XProperty, "StartLine1XA");
			lineAndAngle.SetBinding(LineAndAngle.Line1Point1YProperty, "StartLine1YA");
			lineAndAngle.SetBinding(LineAndAngle.Line1Point2XProperty, "EndLine1XA");
			lineAndAngle.SetBinding(LineAndAngle.Line1Point2YProperty, "EndLine1YA");
			lineAndAngle.SetBinding(LineAndAngle.IntersectionXProperty, "IntersectionXA");
			lineAndAngle.SetBinding(LineAndAngle.IntersectionYProperty, "IntersectionYA");
			lineAndAngle.SetBinding(LineAndAngle.Line2Point1XProperty, "StartLine2XA");
			lineAndAngle.SetBinding(LineAndAngle.Line2Point1YProperty, "StartLine2YA");
			lineAndAngle.SetBinding(LineAndAngle.Line2Point2XProperty, "EndLine2XA");
			lineAndAngle.SetBinding(LineAndAngle.Line2Point2YProperty, "EndLine2YA");
			lineAndAngle.SetBinding(LineAndAngle.AngleProperty, "AngleA");
			lineAndAngle.SetBinding(LineAndAngle.ScaleRatioProperty, new System.Windows.Data.Binding("ScaleRate")
			{
				Source = this
			});
			lineAndAngle.Stroke = GetBrushByString(nColor);
			lineAndAngle.StrokeThickness = 1.0;
			lineAndAngle.Opacity = opacity;
			lineAndAngle.Ratio = GetRatio();
			lineAndAngle.DataContext = shape;
			lineAndAngle.SetCurrentValue(LineAndAngle.ScaleRatioProperty, ScaleRate);
			mView.Children.Add(lineAndAngle);
		}
	}

