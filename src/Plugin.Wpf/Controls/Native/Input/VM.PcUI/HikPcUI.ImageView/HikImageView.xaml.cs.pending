	private void PointsData_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		if (e.Action == NotifyCollectionChangedAction.Reset)
		{
			ClearLargePointSet();
			return;
		}
		IList newItems = e.NewItems;
		IList oldItems = e.OldItems;
		ChangePointSet(this, newItems, oldItems);
	}

