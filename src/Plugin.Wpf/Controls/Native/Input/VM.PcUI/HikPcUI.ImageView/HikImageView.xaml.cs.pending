	public void DoRoiClick(object Sender, System.Windows.Input.MouseEventArgs e)
	{
		if (OnRoi_Click != null)
		{
			OnRoi_Click(Sender, e);
		}
	}

	public void ChangeSelectedBaseROI(object data)
	{
		if (OnSelectedBaseROIChange != null)
		{
			OnSelectedBaseROIChange(this, data);
		}
		RoiSelectedEvent?.Invoke(this, new RoiEventArgs(data));
	}

	public void ChangeRoiDeCount(object data)
	{
		if (OnRoiDeCountChanged != null)
		{
			OnRoiDeCountChanged(data);
		}
		RoiDeleteEvent?.Invoke(this, new RoiEventArgs(data));
	}

	public void ChangeRoiCount(object data)
	{
		if (OnRoiCountChanged != null)
		{
			OnRoiCountChanged(data);
		}
		RoiAddEvent?.Invoke(this, new RoiEventArgs(data));
	}

	public void hikImageView_OnROIParamChanged(object Param)
	{
		if (OnRoiParamChange != null)
		{
			OnRoiParamChange(Param);
		}
		RoiParamChangeEvent?.Invoke(this, new RoiEventArgs(Param));
	}

	public void SetSizePanelVisible(Visibility visibility)
	{
		SizePanel.Visibility = visibility;
	}

	public void SetMousePanelVisible(Visibility visibility)
	{
		MousePanel.Visibility = visibility;
	}

	public HikImageView()
	{
		try
		{
			InitializeComponent();
			above.IsHitTestVisible = false;
			GreenPath.Stroke = Brushes.LawnGreen;
			GreenPath.IsHitTestVisible = false;
			YellowPath.Stroke = Brushes.Yellow;
			YellowPath.IsHitTestVisible = false;
			RedPath.Stroke = Brushes.Red;
			RedPath.IsHitTestVisible = false;
			GreenPath.Data = greenGeometryGroup;
			YellowPath.Data = yellowGeometryGroup;
			RedPath.Data = redGeometryGroup;
			mView.Children.Add(GreenPath);
			mView.Children.Add(YellowPath);
			mView.Children.Add(RedPath);
			InitGrid();
			viewbox.LayoutUpdated += viewbox_LayoutUpdated;
			Loaded += (object s, RoutedEventArgs e) =>
			{
				topwindow = Window.GetWindow(this);
				if (topwindow != null)
				{
					topwindow.Activated += Window_Activated;
				}
			};
			Unloaded += (object s, RoutedEventArgs e) =>
			{
				if (topwindow != null)
				{
					topwindow.Activated -= Window_Activated;
					topwindow = null;
				}
			};
		}
		catch (Exception ex)
		{
			string message = ex.Message;
		}
	}

	private void Window_Activated(object sender, EventArgs e)
	{
		isDragging = false;
	}

	public void hikFrame_OnFremeMouseLeftButtonDown(MouseButtonEventArgs e)
	{
		mouseLBDown(sImage, e);
	}

	private void InitGrid()
	{
		path.Stroke = Brushes.Black;
		path.StrokeThickness = 1.0;
		above.Children.Add(path);
	}

	private void SetAboveCanvas()
	{
		if (sImage.Source == null)
		{
			return;
		}
		System.Windows.Point point = sImage.TranslatePoint(new System.Windows.Point(0.0, 0.0), mapcanvas);
		System.Windows.Point point2 = sImage.TranslatePoint(new System.Windows.Point(0.0, 0.0), viewbox);
		double num = (viewbox.ActualWidth - point2.X * 2.0) * sfr.ScaleX;
		double num2 = (viewbox.ActualHeight - point2.X * 2.0) * sfr.ScaleY;
		double num3 = num / (double)ImageSourceWidth;
		if (num3 > 50.0)
		{
			gridWidth = num3;
			GeometryGroup geometryGroup = new GeometryGroup();
			int num4 = (int)Math.Ceiling((0.0 - point.Y) / gridWidth);
			int num5 = (int)Math.Ceiling((above.ActualHeight - point.Y) / gridWidth);
			if (num4 < 0)
			{
				num4 = 0;
			}
			if ((double)num5 > num2 / gridWidth)
			{
				num5 = (int)Math.Ceiling(num2 / gridWidth);
			}
			for (int i = num4; i < num5; i++)
			{
				LineGeometry value = new LineGeometry(new System.Windows.Point(point.X, point.Y + gridWidth * (double)i), new System.Windows.Point(point.X + num, point.Y + gridWidth * (double)i));
				geometryGroup.Children.Add(value);
			}
			num4 = (int)Math.Ceiling((0.0 - point.X) / gridWidth);
			num5 = (int)Math.Ceiling((above.ActualWidth - point.X) / gridWidth);
			if (num4 < 0)
			{
				num4 = 0;
			}
			if ((double)num5 > num / gridWidth)
			{
				num5 = (int)Math.Ceiling(num / gridWidth);
			}
			for (int j = num4; j < num5; j++)
			{
				LineGeometry value2 = new LineGeometry(new System.Windows.Point(point.X + gridWidth * (double)j, point.Y), new System.Windows.Point(point.X + gridWidth * (double)j, point.Y + num2));
				geometryGroup.Children.Add(value2);
			}
			path.Data = geometryGroup;
			above.Opacity = 1.0;
		}
		else
		{
			above.Opacity = 0.0;
		}
	}

	private void viewbox_LayoutUpdated(object sender, EventArgs e)
	{
		if (!IsLoaded)
		{
			return;
		}
		if (needFlash)
		{
			needFlash = false;
			SetAboveCanvas();
		}
		if (!needFlashPoint)
		{
			return;
		}
		try
		{
			needFlashPoint = false;
			CreatPointK();
			if (OnFreshExtendContent != null)
			{
				OnFreshExtendContent(this, null);
			}
		}
		catch (Exception)
		{
		}
	}

	public double GetViewBoxWidth()
	{
		return viewbox.ActualWidth;
	}

	public double GetViewBoxHeight()
	{
		return viewbox.ActualHeight;
	}

	private void hikFrame_OnTheSizeChange(RoiDate Date)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			if (OnRoiSizeChange != null)
			{
				RoiDate date = new RoiDate
				{
					Width = Date.Width / ratio
				};
				date.Width /= ImageSourceWidth;
				date.Height = Date.Height / ratio;
				date.Height /= ImageSourceHeight;
				date.CenterX = Date.CenterX / ratio;
				date.CenterX = date.CenterX / (double)ImageSourceWidth + date.Width / 2.0;
				date.CenterY = Date.CenterY / ratio;
				date.CenterY = date.CenterY / (double)ImageSourceHeight + date.Height / 2.0;
				date.Angle = Date.Angle;
				OnRoiSizeChange(date);
			}
		}
	}

	private void hikCircle_OnTheSizeChange(RoiDate Date)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			if (OnRoiSizeChange != null)
			{
				Date.MaxRadius /= ratio;
				Date.MinRadius /= ratio;
				Date.Width = 2.0 * Date.MaxRadius / (double)ImageSourceWidth;
				Date.Height = 2.0 * Date.MaxRadius / (double)ImageSourceHeight;
				Date.CenterX /= ratio;
				Date.CenterX /= ImageSourceWidth;
				Date.CenterY /= ratio;
				Date.CenterY /= ImageSourceHeight;
				OnRoiSizeChange(Date);
			}
		}
	}

	public void Enlarge()
	{
		if (sImage.Source != null)
		{
			System.Windows.Point centerPoint = sImage.TranslatePoint(new System.Windows.Point(0.0, 0.0), mapcanvas);
			centerPoint.X = mapcanvas.ActualWidth / 2.0 - centerPoint.X;
			centerPoint.Y = mapcanvas.ActualHeight / 2.0 - centerPoint.Y;
			centerPoint.X /= sfr.ScaleX;
			centerPoint.Y /= sfr.ScaleY;
			ChangeSize(centerPoint, 1.5);
		}
	}

	public void Shrink()
	{
		if (sImage.Source != null)
		{
			System.Windows.Point centerPoint = sImage.TranslatePoint(new System.Windows.Point(0.0, 0.0), mapcanvas);
			centerPoint.X = mapcanvas.ActualWidth / 2.0 - centerPoint.X;
			centerPoint.Y = mapcanvas.ActualHeight / 2.0 - centerPoint.Y;
			centerPoint.X /= sfr.ScaleX;
			centerPoint.Y /= sfr.ScaleY;
			ChangeSize(centerPoint, 0.5);
		}
	}

	public void SetPointWidthBase(double pointWidthBase)
	{
		PointWidthBase = pointWidthBase;
	}

	public void CreatePointList(List<System.Windows.Point> ptList)
	{
		if (sImage.Source == null)
		{
			return;
		}
		double ratio = GetRatio();
		pointWidth = PointWidthBase / (sfr.ScaleX * viewScal);
		this.geometryGroup.Children.Clear();
		foreach (System.Windows.Point pt in ptList)
		{
			GeometryGroup geometryGroup = new GeometryGroup();
			LineGeometry value = new LineGeometry(new System.Windows.Point((pt.X + 0.5) * ratio - pointWidth, (pt.Y + 0.5) * ratio - pointWidth), new System.Windows.Point((pt.X + 0.5) * ratio + pointWidth, (pt.Y + 0.5) * ratio + pointWidth));
			LineGeometry value2 = new LineGeometry(new System.Windows.Point((pt.X + 0.5) * ratio - pointWidth, (pt.Y + 0.5) * ratio + pointWidth), new System.Windows.Point((pt.X + 0.5) * ratio + pointWidth, (pt.Y + 0.5) * ratio - pointWidth));
			geometryGroup.Children.Add(value);
			geometryGroup.Children.Add(value2);
			this.geometryGroup.Children.Add(geometryGroup);
		}
		System.Windows.Shapes.Path path = new System.Windows.Shapes.Path();
		path.Stroke = Brushes.LawnGreen;
		path.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
		path.IsHitTestVisible = false;
		path.Data = this.geometryGroup;
		mView.Children.Add(path);
		shapeList.Add(path);
		pointPath.Add(path);
	}

	public void AddNewPointK(float x, float y, int color)
	{
		if (PointX_Buffer == null)
		{
			NeedLargePoints = true;
		}
		if (PointLenth >= PointX_Buffer.Length)
		{
			int num = PointX_Buffer.Length;
			float[] pointX_Buffer = PointX_Buffer;
			float[] pointY_Buffer = PointY_Buffer;
			int[] pointColor_Buffer = PointColor_Buffer;
			PointX_Buffer = new float[num + 100000];
			PointY_Buffer = new float[num + 100000];
			PointColor_Buffer = new int[num + 100000];
			Buffer.BlockCopy(pointX_Buffer, 0, PointX_Buffer, 0, pointX_Buffer.Length * 4);
			Buffer.BlockCopy(pointY_Buffer, 0, PointY_Buffer, 0, pointY_Buffer.Length * 4);
			Buffer.BlockCopy(pointColor_Buffer, 0, PointColor_Buffer, 0, pointColor_Buffer.Length * 4);
		}
		PointX_Buffer[PointLenth] = x;
		PointY_Buffer[PointLenth] = y;
		PointColor_Buffer[PointLenth] = color;
		PointLenth++;
	}

	public void DeletePointK(float x, float y)
	{
		if (PointsData == null)
		{
			return;
		}
		for (int i = 0; i < PointX_Buffer.Length && (PointX_Buffer[i] != 0f || PointY_Buffer[i] != 0f); i++)
		{
			if (PointX_Buffer[i] == x && PointY_Buffer[i] == y)
			{
				PointX_Buffer[i] = -1f;
			}
		}
	}

	public void DeletePointK(int index)
	{
		PointX_Buffer[index] = -1f;
	}

	public void CreatePoint(System.Windows.Point pt, int color, double opacity, string tips)
	{
		if (sImage.Source != null)
		{
			double ratio = GetRatio();
			pointWidth = PointWidthBase / (sfr.ScaleX * viewScal);
			GeometryGroup geometryGroup = new GeometryGroup();
			double num = (pt.X + 0.5) * ratio;
			double num2 = (pt.Y + 0.5) * ratio;
			LineGeometry value = new LineGeometry(new System.Windows.Point(num, num2 - pointWidth), new System.Windows.Point(num, num2 + pointWidth));
			LineGeometry value2 = new LineGeometry(new System.Windows.Point(num - pointWidth, num2), new System.Windows.Point(num + pointWidth, num2));
			geometryGroup.Children.Add(value);
			geometryGroup.Children.Add(value2);
			this.geometryGroup.Children.Add(geometryGroup);
			System.Windows.Shapes.Path path = new System.Windows.Shapes.Path();
			path.Stroke = GetColorFromInt(color);
			path.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
			if (tips != "")
			{
				path.ToolTip = tips;
				path.IsHitTestVisible = true;
			}
			else
			{
				path.IsHitTestVisible = false;
			}
			path.Opacity = opacity;
			path.Data = geometryGroup;
			mView.Children.Add(path);
			shapeList.Add(path);
			pointPath.Add(path);
		}
	}

	public unsafe void CreatPointK()
	{
		if (sImage.Source == null)
		{
			return;
		}
		if (PointLenth <= 0 && (ExternPoint_Buffer == null || ExternPoint_Buffer.Count == 0) && (ShapeList == null || ShapeList.Count == 0))
		{
			b2SConvertor.Clear();
			pointsImage.Source = null;
			return;
		}
		System.Windows.Point point = new System.Windows.Point((mapcanvas.ActualWidth - viewbox.ActualWidth) / 2.0 + Canvas.GetLeft(viewbox) + tlt.X, (mapcanvas.ActualHeight - viewbox.ActualHeight) / 2.0 + Canvas.GetTop(viewbox) + tlt.Y);
		double num = viewbox.ActualWidth * sfr.ScaleX;
		if (num == 0.0)
		{
			return;
		}
		double temp = num / (double)ImageSourceWidth;
		int num2 = 0;
		int num3 = 0;
		int num4 = (int)mapcanvas.ActualWidth;
		int num5 = (int)mapcanvas.ActualHeight;
		if (num4 == 0 || num5 == 0)
		{
			return;
		}
		WriteableBitmap writeableBitmap = b2SConvertor.Init(num4, num5, PixelFormats.Bgra32);
		if (writeableBitmap == null)
		{
			return;
		}
		pointsImage.Source = writeableBitmap;
		writeableBitmap.Lock();
		byte* ptr = (byte*)writeableBitmap.BackBuffer.ToPointer();
		int wwe_Stride = writeableBitmap.BackBufferStride / 4;
		int* ztemp = (int*)ptr;
		writeableBitmap.Clear();
		double fx = 0.5 + point.X / temp;
		double fy = 0.5 + point.Y / temp;
		if (ShapeList != null && ShapeList.Count > 0)
		{
			int[] array = new int[10];
			foreach (IRect item in ShapeList.OfType<IRect>())
			{
				hu.CenterX = ((double)item.CenterX + fx) * temp;
				hu.CenterY = ((double)item.CenterY + fy) * temp;
				hu.Angle = item.Angle;
				double num6 = (double)item.Width * temp;
				double num7 = (double)item.Height * temp;
				System.Windows.Point point2 = new System.Windows.Point(hu.CenterX - num6 / 2.0, hu.CenterY - num7 / 2.0);
				System.Windows.Point point3 = new System.Windows.Point(point2.X + num6, point2.Y);
				System.Windows.Point point4 = new System.Windows.Point(point3.X, point2.Y + num7);
				System.Windows.Point point5 = new System.Windows.Point(point2.X, point4.Y);
				if (hu.Angle != 0.0)
				{
					point2 = hu.Transform(point2);
					point3 = hu.Transform(point3);
					point4 = hu.Transform(point4);
					point5 = hu.Transform(point5);
				}
				array[0] = (int)point2.X;
				array[1] = (int)point2.Y;
				array[2] = (int)point3.X;
				array[3] = (int)point3.Y;
				array[4] = (int)point4.X;
				array[5] = (int)point4.Y;
				array[6] = (int)point5.X;
				array[7] = (int)point5.Y;
				array[8] = array[0];
				array[9] = array[1];
				writeableBitmap.DrawPolyline(array, Colors.Blue);
			}
		}
		fixed (float* pointX_Buffer = PointX_Buffer)
		{
			fixed (float* pointY_Buffer = PointY_Buffer)
			{
				fixed (int* pointColor_Buffer = PointColor_Buffer)
				{
					int Weeh = num4 - 4;
					int Heeh = num5 - 4;
					if (ExternPoint_Buffer != null)
					{
						int num8 = Marshal.SizeOf<IMVS_PATMATCH_POINT_INFO>();
						for (int i = 0; i < ExternPoint_Buffer.Count; i++)
						{
							int num9 = ((ExternPoint_Buffer_OkColor.Count > i) ? (ExternPoint_Buffer_OkColor[i] & 0xFFFFFF) : DefaultOkColor);
							int num10 = ((ExternPoint_Buffer_NgColor.Count > i) ? (ExternPoint_Buffer_NgColor[i] & 0xFFFFFF) : DefaultNgColor);
							double num11 = ((ExternPoint_Buffer_Opacity.Count > i) ? ((double)ExternPoint_Buffer_Opacity[i]) : ExternOpacity);
							int num12 = (int)(num11 * 255.0) << 24;
							int greenColor = num12 | num9;
							int yellowColor = num12 | 0xFFFF00;
							int redColor = num12 | num10;
							byte[] array2 = ExternPoint_Buffer[i];
							if (array2 == null)
							{
								continue;
							}
							int num13 = array2.Length;
							fixed (byte* ptr2 = array2)
							{
								IMVS_PATMATCH_POINT_INFO* tempExternPoint_Bufferptr = (IMVS_PATMATCH_POINT_INFO*)ptr2;
								int toExclusive = num13 / num8;
								Parallel.For(0, toExclusive, (int num15) =>
								{
									IMVS_PATMATCH_POINT_INFO iMVS_PATMATCH_POINT_INFO = tempExternPoint_Bufferptr[num15];
									int num16 = (int)(((double)iMVS_PATMATCH_POINT_INFO.MatchOutlineX + fx) * temp);
									if (num16 >= 0 && num16 <= Weeh)
									{
										int num17 = (int)(((double)iMVS_PATMATCH_POINT_INFO.MatchOutlineY + fy) * temp);
										if (num17 >= 0 && num17 <= Heeh)
										{
											float matchOutlineScore = iMVS_PATMATCH_POINT_INFO.MatchOutlineScore;
											float obj = matchOutlineScore;
											int num18 = (0f.Equals(obj) ? greenColor : ((!1f.Equals(obj)) ? redColor : yellowColor));
											int* ptr5 = ztemp + num17 * wwe_Stride + num16;
											*ptr5 = num18;
											ptr5++;
											*ptr5 = num18;
											ptr5 += wwe_Stride;
											*ptr5 = num18;
											ptr5--;
											*ptr5 = num18;
										}
									}
								});
							}
						}
					}
					for (int num14 = 0; num14 < PointLenth; num14++)
					{
						if (pointX_Buffer[num14] < 0f)
						{
							continue;
						}
						num2 = (int)(((double)pointX_Buffer[num14] + fx) * temp);
						if (num2 >= 0 && num2 <= Weeh)
						{
							num3 = (int)(((double)pointY_Buffer[num14] + fy) * temp);
							if (num3 >= 0 && num3 <= Heeh)
							{
								int* ptr3 = pointColor_Buffer + num14;
								int* ptr4 = ztemp + num3 * wwe_Stride + num2;
								*ptr4 = *ptr3;
								ptr4++;
								*ptr4 = *ptr3;
								ptr4 += wwe_Stride;
								*ptr4 = *ptr3;
								ptr4--;
								*ptr4 = *ptr3;
							}
						}
					}
				}
			}
		}
		writeableBitmap.AddDirtyRect(new Int32Rect(0, 0, writeableBitmap.PixelWidth, writeableBitmap.PixelHeight));
		writeableBitmap.Unlock();
	}

