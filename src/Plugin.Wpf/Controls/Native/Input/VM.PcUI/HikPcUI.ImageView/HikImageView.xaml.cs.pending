	public class ImageLockData
	{
		public bool _bLocked;

		public double _dScale;

		public System.Windows.Point _tltOffset;

		public System.Windows.Point _offsetPoint;

		public System.Windows.Point _centerPonit;

		public Size _imageSize;

		public ImageLockData()
		{
			_bLocked = false;
			_dScale = 1.0;
			_tltOffset = default;
			_offsetPoint = default;
			_centerPonit = default;
			_imageSize = default;
		}

		public ImageLockData(bool bLocked, double dScale, System.Windows.Point offsetPoint, System.Windows.Point centerPoint, System.Windows.Point tltOffset, Size imageSize)
		{
			_bLocked = bLocked;
			_dScale = dScale;
			_tltOffset = tltOffset;
			_offsetPoint = offsetPoint;
			_centerPonit = centerPoint;
			_imageSize = imageSize;
		}

		public bool CheckDataValid()
		{
			return _imageSize.Width > 0.0 && _imageSize.Height > 0.0;
		}
	}

