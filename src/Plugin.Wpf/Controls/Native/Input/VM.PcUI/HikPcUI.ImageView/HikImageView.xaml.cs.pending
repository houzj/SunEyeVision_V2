	private void Viewbox_MouseWheel(object sender, MouseWheelEventArgs e)
	{
		if (sImage.Source != null)
		{
			System.Windows.Point position = e.GetPosition(viewbox);
			double num = Math.Round((double)e.Delta / 120.0, MidpointRounding.AwayFromZero) * 0.5;
			double val = 1.0 + num;
			ChangeSize(position, val);
		}
	}

	public void ChangeSize(System.Windows.Point centerPoint, double val)
	{
		if (val != 1.0 && (!(val > 1.0) || EnableZoomOut) && (!(val < 1.0) || EnableZoomIn))
		{
			if (sfr.ScaleX * val < 0.3)
			{
				val = 0.3 / sfr.ScaleX;
			}
			if (Math.Abs(curPoint.X - centerPoint.X) > 0.001 || Math.Abs(curPoint.Y - centerPoint.Y) > 0.001)
			{
				offset = new System.Windows.Point(offset.X + (centerPoint.X - curPoint.X) * (sfr.ScaleX - 1.0), offset.Y + (centerPoint.Y - curPoint.Y) * (sfr.ScaleY - 1.0));
			}
			curPoint.X = centerPoint.X;
			curPoint.Y = centerPoint.Y;
			System.Windows.Point point = TG.Inverse.Transform(centerPoint);
			sfr.ScaleX *= val;
			sfr.ScaleY *= val;
			tlt.X = -1.0 * (centerPoint.X * sfr.ScaleX - centerPoint.X) + offset.X;
			tlt.Y = -1.0 * (centerPoint.Y * sfr.ScaleY - centerPoint.Y) + offset.Y;
			SetAboveCanvas();
			needFlashPoint = true;
		}
	}

