	public bool IsShowRangeImage
	{
		get
		{
			IRangeImageData imageDataSource;
			if ((imageDataSource = ImageDataSource) != null && imageDataSource.RangeBuffer != null)
			{
				return true;
			}
			ImageData imageDataSource2;
			if ((imageDataSource2 = ImageDataSource) != null)
			{
				return imageDataSource2.DetailedPixelFormat == 17825976;
			}
			return false;
		}
	}

	public ICommand ValueChangedCommand
	{
		get
		{
			//IL_001b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0025: Expected Obj, but got Unknown
			if (_ValueChangedCommand == null)
			{
				_ValueChangedCommand = new DelegateCommand((Action)ValueChangedCmdExecute);
			}
			return (ICommand)_ValueChangedCommand;
		}
	}

