	private void viewbox_MouseMove(object sender, System.Windows.Input.MouseEventArgs e)
	{
		if (sImage.Source == null)
		{
			return;
		}
		foreach (ROIContainer item in VGrid.Children.OfType<ROIContainer>())
		{
			item.viewbox_MouseMove(sender, e);
		}
		if (PrepareRoiType != RoiUIType.Default)
		{
			if (OnDrawRoi_MouseMoveChange != null)
			{
				OnDrawRoi_MouseMoveChange(sender, e);
			}
		}
		else if (isDragging)
		{
			System.Windows.Point position = e.GetPosition(mapcanvas);
			viewbox.SetValue(Canvas.TopProperty, position.Y - mouseOffset.Y + theTop);
			viewbox.SetValue(Canvas.LeftProperty, position.X - mouseOffset.X + theLeft);
			pointsImage.Source = null;
			object obj = new object();
			WaitObj = obj;
			needFlash = true;
			Task.Run(() =>
			{
				Thread.Sleep(30);
				if (WaitObj.Equals(obj))
				{
					Dispatcher.Invoke(() =>
					{
						CreatPointK();
					});
				}
			});
			if (OnFreshExtendContent != null)
			{
				OnFreshExtendContent(this, null);
			}
			if (e.LeftButton != MouseButtonState.Pressed)
			{
				isDragging = false;
				sImage.ReleaseMouseCapture();
			}
		}
		double ratio = GetRatio();
		System.Windows.Point position2 = e.GetPosition(sImage);
		position2.X = Math.Floor(position2.X / ratio);
		position2.Y = Math.Floor(position2.Y / ratio);
		if (position2.X < 0.0 || position2.X >= (double)ImageSourceWidth || position2.Y < 0.0 || position2.Y >= (double)ImageSourceHeight)
		{
			curImageX = -1;
			curImageY = -1;
		}
		else if ((double)curImageX != position2.X || (double)curImageY != position2.Y)
		{
			curImageX = (int)position2.X;
			curImageY = (int)position2.Y;
			CallChangePixel(curImageX, curImageY);
		}
	}

	public void CallChangePixel(int X, int Y)
	{
		if (OnPixelChange != null)
		{
			OnPixelChange(X, Y);
		}
		else if (IsDisplayPixelAuto)
		{
			ChangePixel(X, Y);
		}
	}

	private unsafe void ChangePixel(int X, int Y)
	{
		int r = 0;
		int g = 0;
		int b = 0;
		short value = 0;
		if (IsSourceDataCompressed)
		{
			if (ImageDataSource != null && ImageDataSource.ImageBuffer != null)
			{
				int num = ImageDataSource.Width * ImageDataSource.PixelFormat.BitsPerPixel / 8;
				int num2 = 0;
				switch (ImageData.GetPixelFormatCode(ImageDataSource.PixelFormat))
				{
				case MPixelFormat.Gray8:
					num2 = Y * num + X;
					if (num2 >= 0 && num2 < ImageDataSource.ImageBuffer.Length)
					{
						byte b2 = ImageDataSource.ImageBuffer[num2];
						r = b2;
						g = b2;
						b = b2;
					}
					break;
				case MPixelFormat.Rgb24:
					num2 = Y * num + ImageDataSource.PixelFormat.BitsPerPixel * X / 8;
					if (num2 >= 0 && num2 + 2 < ImageDataSource.ImageBuffer.Length)
					{
						r = ImageDataSource.ImageBuffer[num2];
						g = ImageDataSource.ImageBuffer[num2 + 1];
						b = ImageDataSource.ImageBuffer[num2 + 2];
					}
					break;
				}
			}
		}
		else if (Source != null)
		{
			if (!(Source is WriteableBitmap writeableBitmap))
			{
				return;
			}
			_ = writeableBitmap.BackBuffer;
			if (false)
			{
				return;
			}
			byte* ptr = (byte*)writeableBitmap.BackBuffer.ToPointer();
			int backBufferStride = writeableBitmap.BackBufferStride;
			int num3 = 0;
			int num4 = backBufferStride * writeableBitmap.PixelHeight;
			switch (ImageData.GetPixelFormatCode(writeableBitmap.Format))
			{
			case MPixelFormat.Gray8:
				num3 = Y * backBufferStride + X;
				if (num3 >= 0 && num3 < num4)
				{
					byte b3 = ptr[num3];
					r = b3;
					g = b3;
					b = b3;
				}
				break;
			case MPixelFormat.Rgb24:
				num3 = Y * backBufferStride + writeableBitmap.Format.BitsPerPixel * X / 8;
				if (num3 >= 0 && num3 + 2 < num4)
				{
					r = ptr[num3];
					g = (ptr + num3)[1];
					b = (ptr + num3)[2];
				}
				break;
			}
			IRangeImageData imageDataSource;
			if ((imageDataSource = ImageDataSource) != null && imageDataSource.RangeBuffer != null)
			{
				fixed (byte* rangeBuffer = imageDataSource.RangeBuffer)
				{
					short* ptr2 = (short*)rangeBuffer;
					num3 = Y * backBufferStride + X;
					if (num3 >= 0 && num3 < imageDataSource.RangeBuffer.Length / 2)
					{
						value = ptr2[num3];
					}
				}
			}
		}
		SetPixelInfo(X, Y, r, g, b, value);
	}

	private void sImage_MouseLeave(object sender, System.Windows.Input.MouseEventArgs e)
	{
		curImageX = -1;
		curImageY = -1;
		if (OnPixelChange != null)
		{
			OnPixelChange(curImageX, curImageY);
		}
	}

	private void sfr_Changed(object sender, EventArgs e)
	{
		try
		{
			if (sImage.Source != null && lastysfr != sfr.ScaleY)
			{
				lastysfr = sfr.ScaleY;
				if (OnScaleChange != null)
				{
					OnScaleChange(sender, viewScal);
				}
				while (scales.Count > 1)
				{
					scales.RemoveAt(0);
				}
				scales.Add(sfr.ScaleX);
				SetImageSource();
				ResizeByScale();
				if (scales.Count != 1 && !scales[0].Equals(scales[1]))
				{
					EnableZoomIn = sfr.ScaleX > 0.3;
					System.Windows.Point point = sImage.TranslatePoint(new System.Windows.Point(0.0, 0.0), viewbox);
					double num = (viewbox.ActualWidth - point.X * 2.0) * sfr.ScaleX;
					double num2 = num / (double)ImageSourceWidth;
					EnableZoomOut = !(num2 > 200.0) || !(scales[1] > scales[0]);
				}
			}
		}
		catch
		{
		}
	}

	private void ResizeByScale()
	{
		NotifyPropertyChanged("ScaleRate");
		foreach (FrameworkElement shape2 in shapeList)
		{
			if (shape2 is System.Windows.Shapes.Shape)
			{
				(shape2 as System.Windows.Shapes.Shape).StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
			}
		}
		foreach (FrameworkElement item in shapeListE)
		{
			if (item is System.Windows.Shapes.Shape { Tag: var tag } shape)
			{
				if (tag is double)
				{
					double num = 1.0;
					num = (double)shape.Tag;
					double num2 = sfr.ScaleX * viewScal;
					shape.StrokeThickness = 1.0 * num / num2;
				}
				else
				{
					shape.StrokeThickness = 1.0 / (sfr.ScaleX * viewScal);
				}
			}
		}
		double newpointWidth = PointWidthBase / (sfr.ScaleX * viewScal);
		foreach (GeometryGroup child in geometryGroup.Children)
		{
			ChangeLinePoint(newpointWidth, child);
		}
		foreach (GeometryGroup child2 in greenGeometryGroup.Children)
		{
			ChangeLinePoint(newpointWidth, child2);
		}
		foreach (GeometryGroup child3 in yellowGeometryGroup.Children)
		{
			ChangeLinePoint(newpointWidth, child3);
		}
		foreach (GeometryGroup child4 in redGeometryGroup.Children)
		{
			ChangeLinePoint(newpointWidth, child4);
		}
		foreach (System.Windows.Shapes.Path item2 in pointPath)
		{
			item2.StrokeThickness = 1.0 * rate / (sfr.ScaleX * viewScal);
		}
		foreach (System.Windows.Shapes.Path item3 in pointPathE)
		{
			item3.StrokeThickness = 1.0 * rate / (sfr.ScaleX * viewScal);
		}
		GreenPath.StrokeThickness = 1.0 * rate / (sfr.ScaleX * viewScal);
		RedPath.StrokeThickness = 1.0 * rate / (sfr.ScaleX * viewScal);
		YellowPath.StrokeThickness = 1.0 * rate / (sfr.ScaleX * viewScal);
		pointWidth = newpointWidth;
	}

	private void ChangeLinePoint(double newpointWidth, GeometryGroup gp)
	{
		if (gp.Children.Count > 1)
		{
			System.Windows.Point startPoint = (gp.Children[0] as LineGeometry).StartPoint;
			(gp.Children[0] as LineGeometry).StartPoint = new System.Windows.Point(startPoint.X, startPoint.Y - (0.0 - pointWidth + newpointWidth));
			startPoint = (gp.Children[0] as LineGeometry).EndPoint;
			(gp.Children[0] as LineGeometry).EndPoint = new System.Windows.Point(startPoint.X, startPoint.Y + (0.0 - pointWidth + newpointWidth));
			startPoint = (gp.Children[1] as LineGeometry).StartPoint;
			(gp.Children[1] as LineGeometry).StartPoint = new System.Windows.Point(startPoint.X - (0.0 - pointWidth + newpointWidth), startPoint.Y);
			startPoint = (gp.Children[1] as LineGeometry).EndPoint;
			(gp.Children[1] as LineGeometry).EndPoint = new System.Windows.Point(startPoint.X + (0.0 - pointWidth + newpointWidth), startPoint.Y);
		}
	}

	private void viewbox_SizeChanged(object sender, SizeChangedEventArgs e)
	{
		if (Source == null)
		{
			return;
		}
		viewScal = viewbox.ActualWidth / sImage.Width;
		if (viewScal != 0.0)
		{
			ResizeByScale();
			if (OnScaleChange != null)
			{
				OnScaleChange(sfr, viewScal);
			}
			needFlashPoint = true;
		}
	}

