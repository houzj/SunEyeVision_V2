	private void DrawShape(IList proiList)
	{
		if (proiList == null)
		{
			return;
		}
		foreach (object proi in proiList)
		{
			if (!(proi is ShapeParameter shapeParameter))
			{
				continue;
			}
			FrameworkElement frameworkElement = null;
			if (shapeParameter is HikRectangleShapeParameter)
			{
			}
			AddChild(frameworkElement);
			if (!shapeHashtable.ContainsKey(proi))
			{
				shapeHashtable.Add(proi, frameworkElement);
				if (viewScal != 0.0 && OnScaleChange != null)
				{
					OnScaleChange(sfr, viewScal);
				}
			}
		}
	}

	private static void OnRoiListChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		if (e.OldValue != null)
		{
			CollectionChangedEventManager.RemoveHandler(e.OldValue as INotifyCollectionChanged, (d as HikImageView).RoiList_CollectionChanged);
		}
		foreach (object value in (d as HikImageView).roiList.Values)
		{
			(d as HikImageView).RemoveChild(value as FrameworkElement);
			(d as HikImageView).RemoveROIChild(value as FrameworkElement);
		}
		(d as HikImageView).roiList.Clear();
		(d as HikImageView).DrawRoi((d as HikImageView).RoiList);
		(d as HikImageView).RoiListRegister();
	}

