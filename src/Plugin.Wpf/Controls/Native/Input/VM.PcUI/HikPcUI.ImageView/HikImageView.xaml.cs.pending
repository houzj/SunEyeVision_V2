	public bool NeedLargePoints
	{
		get
		{
			if (PointX_Buffer != null)
			{
				return PointX_Buffer.Length >= 100000;
			}
			return false;
		}
		set
		{
			if (value)
			{
				PointX_Buffer = new float[100000];
				PointY_Buffer = new float[100000];
				PointColor_Buffer = new int[100000];
			}
		}
	}

	public System.Windows.Point ImageOffset => new System.Windows.Point((mapcanvas.ActualWidth - viewbox.ActualWidth) / 2.0 + Canvas.GetLeft(viewbox) + tlt.X, (mapcanvas.ActualHeight - viewbox.ActualHeight) / 2.0 + Canvas.GetTop(viewbox) + tlt.Y);

	public double OnePixelWidth
	{
		get
		{
			if (sImage.Source != null)
			{
				return viewbox.ActualWidth * sfr.ScaleX / (double)ImageSourceWidth;
			}
			return 0.0;
		}
	}

	public double ViewWidth => mapcanvas.ActualWidth;

