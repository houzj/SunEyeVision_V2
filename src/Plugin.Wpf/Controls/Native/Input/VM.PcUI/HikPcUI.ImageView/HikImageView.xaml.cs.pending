				binding.Mode = BindingMode.TwoWay;
				binding.Path = new PropertyPath("Index");
				(frameworkElement as HikIndexPoint).SetBinding(HikIndexPoint.IndexProperty, binding);
				HikIndexPoint obj2 = frameworkElement as HikIndexPoint;
