using System;
using System.CodeDom.Compiler;
using System.ComponentModel;
using System.Diagnostics;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Markup;
using System.Windows.Media;

namespace SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView;

public partial class HikIndexPoint : HikROIBase, RectangleRoi, IDisposable, INotifyPropertyChanged, IComponentConnector
{
	public delegate void SizeChange(object Param);

	public static readonly DependencyProperty TCenterPointProperty = DependencyProperty.Register("TCenterPoint", typeof(Point), typeof(HikIndexPoint), new PropertyMetadata(new Point(0.0, 0.0), OnTCenterPointChanged));

	public static readonly DependencyProperty CenterPointProperty = DependencyProperty.Register("CenterPoint", typeof(Point), typeof(HikIndexPoint), new PropertyMetadata(new Point(0.0, 0.0), OnCenterPointChanged));

	public static readonly DependencyProperty IndexProperty = DependencyProperty.Register("Index", typeof(int), typeof(HikIndexPoint), new PropertyMetadata(0, null));

	public SizeChange OnTheSizeChange;

	private string curType = "";

	private IArea curControl = null;

	private double Scale = 1.0;

	private double InitWidth;

	public static HikImageView Owner { get; set; }

	private static Point MouseDownPoint { get; set; }

	private static bool IsMoved { get; set; }

	public new FrameworkElement parent { get; set; }

	public Point TCenterPoint
	{
		get
		{
			return (Point)GetValue(TCenterPointProperty);
		}
		set
		{
			SetValue(TCenterPointProperty, value);
		}
	}

	public Point CenterPoint
	{
		get
		{
			return (Point)GetValue(CenterPointProperty);
		}
		set
		{
			SetValue(CenterPointProperty, value);
		}
	}

	public int Index
	{
		get
		{
			return (int)GetValue(IndexProperty);
		}
		set
		{
			SetValue(IndexProperty, value);
		}
	}

	public Point CurPoint { get; set; }

	public event PropertyChangedEventHandler PropertyChanged;

	public void NotifyPropertyChanged(string propertyName)
	{
		if (PropertyChanged != null)
		{
			PropertyChanged(this, new PropertyChangedEventArgs(propertyName));
		}
	}

	public HikIndexPoint()
	{
		InitializeComponent();
	}

	public static void DoFinishSubstitute()
	{
		if (Owner != null)
		{
			Owner.IsDrawRoi = false;
			Owner.SourceImage.ReleaseMouseCapture();
			HikImageView hikImageView = Owner;
			hikImageView.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
			Owner = null;
		}
	}

	public static void InitSubstitute(HikImageView view, Point mouseDownPoint)
	{
		Owner = view;
		HikImageView hikImageView = Owner;
		hikImageView.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Combine(hikImageView.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
		MouseDownPoint = mouseDownPoint;
		IsMoved = false;
	}

	public static void OnDrawROISubstitute_MouseUp(object sender, MouseEventArgs e)
	{
		if (Owner != null)
		{
			Owner.IsDrawRoi = false;
			Owner.SourceImage.ReleaseMouseCapture();
			HikImageView hikImageView = Owner;
			hikImageView.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(OnDrawROISubstitute_MouseUp));
			HikPointRoiParameter hikPointRoiParameter = new HikPointRoiParameter();
			Point position = e.GetPosition(Owner.SourceImage);
			position.X = position.X / Owner.Radio - 0.5;
			position.Y = position.Y / Owner.Radio - 0.5;
			hikPointRoiParameter.CenterPoint = position;
			Owner.RoiList.Add(hikPointRoiParameter);
			Owner = null;
		}
	}

	private void pointControl_Loaded(object sender, RoutedEventArgs e)
	{
		if (parent == null)
		{
			parent = VisualTreeHelper.GetParent(this) as FrameworkElement;
			parent = VisualTreeHelper.GetParent(parent) as FrameworkElement;
			parent.MouseMove += zparent_MouseMove;
		}
		InitWidth = Width;
		if (view.Width == 0.0)
		{
			if (double.IsInfinity(Width / Scale))
			{
				view.Width = Width;
			}
			else
			{
				view.Width = Width / Scale;
			}
		}
		if (double.IsInfinity(Height / Scale))
		{
			view.Height = Height;
		}
		else
		{
			view.Height = Height / Scale;
		}
	}

	private void zparent_MouseMove(object sender, MouseEventArgs e)
	{
		double num = 0.0;
		double num2 = 0.0;
		if (!isDragging)
		{
			return;
		}
		Point position = e.GetPosition(parent);
		string text = curType;
		if (text == "userControl")
		{
			num = position.Y - CurPoint.Y + Height / 2.0;
			num2 = position.X - CurPoint.X + Width / 2.0;
			if (num < 0.0)
			{
				num = 0.0;
			}
			if (num2 < 0.0)
			{
				num2 = 0.0;
			}
			if (num > parent.ActualHeight)
			{
				num = parent.ActualHeight;
			}
			if (num2 > parent.ActualWidth)
			{
				num2 = parent.ActualWidth;
			}
			CenterPoint = new Point(num2, num);
		}
	}

	private static void OnTCenterPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		Point centerPoint = (Point)e.NewValue;
		double radio = (d as HikIndexPoint).owner.Radio;
		centerPoint.X = (centerPoint.X + 0.5) * radio;
		centerPoint.Y = (centerPoint.Y + 0.5) * radio;
		(d as HikIndexPoint).CenterPoint = centerPoint;
	}

	private static void OnCenterPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikIndexPoint).OnChangCenterPoint();
	}

	private void OnChangCenterPoint()
	{
		double radio = owner.Radio;
		TCenterPoint = new Point(CenterPoint.X / radio - 0.5, CenterPoint.Y / radio - 0.5);
		double num = CenterPoint.X - Width / 2.0;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = CenterPoint.Y - Height / 2.0;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
	}

	public void DoCallBack()
	{
		if (OnTheSizeChange != null)
		{
			OnTheSizeChange(DataContext);
		}
	}

	private void UserControl_MouseUp(object sender, MouseButtonEventArgs e)
	{
		if (isDragging)
		{
			isDragging = false;
			DoCallBack();
			ReleaseMouseCapture();
		}
	}

	public void Doth(FrameworkElement rectangleArea, MouseEventArgs e)
	{
		isDragging = true;
		curType = rectangleArea.Name;
		curControl = rectangleArea as IArea;
		CaptureMouse();
	}

	public void Init()
	{
		if (owner != null)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
		}
	}

	public void OnScaleChange(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		double scale = (sender as ScaleTransform).ScaleX * num;
		Scale = scale;
		if (Scale != 0.0)
		{
			cview.StrokeThickness = 2.0 / Scale;
			view.Width = InitWidth / Scale;
			view.Height = view.Width;
		}
	}

	private void UserControl_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (!DoDragROI(e))
		{
			if (ownerCanvas != null && ownerCanvas is ROIContainer rOIContainer)
			{
				rOIContainer.SelectionService.RoiSelected(DataContext);
			}
			else
			{
				owner.SelectionService.RoiSelected(DataContext);
			}
			Focus();
			if (!isDragging)
			{
				CurPoint = e.GetPosition(this);
				Doth(this, e);
			}
		}
	}

	public void Dispose()
	{
		Owner = null;
		if (owner != null)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
		}
		if (parent != null)
		{
			parent.MouseMove -= zparent_MouseMove;
		}
	}

	[DebuggerNonUserCode]
	[GeneratedCode("PresentationBuildTasks", "4.0.0.0")]
	internal Delegate _CreateDelegate(Type delegateType, string handler)
	{
		return Delegate.CreateDelegate(delegateType, this, handler);
	}
}
