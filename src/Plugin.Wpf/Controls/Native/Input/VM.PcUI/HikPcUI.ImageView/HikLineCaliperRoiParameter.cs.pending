using System.Windows;

namespace SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView;

public class HikLineCaliperRoiParameter : RoiParameter
{
	public Point _StartPoint = new Point(0.0, 0.0);

	public Point _EndPoint = new Point(0.0, 0.0);

	public uint _CaliperNum = 6u;

	public double _CaliperWidth = 20.0;

	public double _CaliperHeight = 200.0;

	public double _CaliperRotateAngle = 0.0;

	public string Name { get; set; } = "直线卡尺";

	public Point StartPoint
	{
		get
		{
			return _StartPoint;
		}
		set
		{
			if (_StartPoint != value)
			{
				_StartPoint = value;
				NotifyPropertyChanged("StartPoint");
				NotifyPropertyChanged("StartPointX");
				NotifyPropertyChanged("StartPointY");
			}
		}
	}

	public double StartPointX
	{
		get
		{
			return StartPoint.X;
		}
		set
		{
			StartPoint = new Point(value, StartPoint.Y);
			NotifyPropertyChanged("StartPointX");
		}
	}

	public double StartPointY
	{
		get
		{
			return StartPoint.Y;
		}
		set
		{
			StartPoint = new Point(StartPoint.X, value);
			NotifyPropertyChanged("StartPointY");
		}
	}

	public Point EndPoint
	{
		get
		{
			return _EndPoint;
		}
		set
		{
			if (_EndPoint != value)
			{
				_EndPoint = value;
				NotifyPropertyChanged("EndPoint");
				NotifyPropertyChanged("EndPointX");
				NotifyPropertyChanged("EndPointY");
			}
		}
	}

	public double EndPointX
	{
		get
		{
			return EndPoint.X;
		}
		set
		{
			EndPoint = new Point(value, EndPoint.Y);
			NotifyPropertyChanged("EndPointX");
		}
	}

	public double EndPointY
	{
		get
		{
			return EndPoint.Y;
		}
		set
		{
			EndPoint = new Point(EndPoint.X, value);
			NotifyPropertyChanged("EndPointY");
		}
	}

	public uint CaliperNum
	{
		get
		{
			return _CaliperNum;
		}
		set
		{
			if (_CaliperNum != value)
			{
				_CaliperNum = value;
				NotifyPropertyChanged("CaliperNum");
			}
		}
	}

	public double CaliperWidth
	{
		get
		{
			return _CaliperWidth;
		}
		set
		{
			if (_CaliperWidth != value)
			{
				_CaliperWidth = value;
				NotifyPropertyChanged("CaliperWidth");
			}
		}
	}

	public double CaliperHeight
	{
		get
		{
			return _CaliperHeight;
		}
		set
		{
			if (_CaliperHeight != value)
			{
				_CaliperHeight = value;
				NotifyPropertyChanged("CaliperHeight");
			}
		}
	}

	public double CaliperRotateAngle
	{
		get
		{
			return _CaliperRotateAngle;
		}
		set
		{
			if (_CaliperRotateAngle != value)
			{
				_CaliperRotateAngle = value;
				NotifyPropertyChanged("CaliperRotateAngle");
			}
		}
	}
}
