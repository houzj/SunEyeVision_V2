	public void Dispose()
	{
		DeInit();
		if (parent != null)
		{
			parent.MouseMove -= zparent_MouseMove;
		}
		if (squareAreas == null || owner == null)
		{
			return;
		}
		foreach (SquareArea squareArea in squareAreas)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(squareArea.OnScaleChange));
		}
	}

	[DllImport("user32.dll")]
	public static extern int GetDoubleClickTime();

	public static void InitSubstitute(HikImageView view, Point mouseDownPoint)
	{
		doubleClickTime = GetDoubleClickTime();
		Owner = view;
		HikImageView hikImageView = Owner;
		hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
		HikImageView hikImageView2 = Owner;
		hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Combine(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
		HikImageView hikImageView3 = Owner;
		hikImageView3.OnDrawRoi_MouseDownChange = (HikImageView.DrawRoi_MouseDownChange)Delegate.Combine(hikImageView3.OnDrawRoi_MouseDownChange, new HikImageView.DrawRoi_MouseDownChange(OnDrawROISubstitute_MouseDown));
		HikImageView hikImageView4 = Owner;
		hikImageView4.OnDrawRoi_RightMouseUpChange = (HikImageView.DrawRoi_RightMouseUpChange)Delegate.Combine(hikImageView4.OnDrawRoi_RightMouseUpChange, new HikImageView.DrawRoi_RightMouseUpChange(OnDrawROISubstitute_RightMouseUp));
		MouseDownPoint = mouseDownPoint;
		substitute.Points.Clear();
		substitute.Stroke = HikROIBase.SubstituteBrush;
		substitute.StrokeThickness = 1.0 / (Owner.sfr.ScaleX * Owner.ViewScale);
		substitute.Opacity = 1.0;
		if (Owner != null)
		{
			maxPathPointNum = Owner.MaxPolygonPointNum;
		}
		substitute.Points.Add(MouseDownPoint);
		substitute.Points.Add(MouseDownPoint);
		PointNum = 1;
		IsMoved = false;
		Owner.AddROIChild(substitute);
	}

	public void Init()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void DeInit()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void OnScaleChange(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		double num2 = 1.0 / ((sender as ScaleTransform).ScaleX * num);
		bottomText.FontSize = textSize * num2;
		bd.BorderThickness = new Thickness(num2);
		bd.Margin = new Thickness(0.0 - num2);
		Path.StrokeThickness = num2;
		Pathf.StrokeThickness = 6.0 * num2;
		if (num < 1.0)
		{
			num = 1.0;
		}
		double num3 = recWidth / ((sender as ScaleTransform).ScaleX * num);
		angle.view.Width = angleWidth / ((sender as ScaleTransform).ScaleX * num);
		angle.view.Height = angleHeight / ((sender as ScaleTransform).ScaleX * num);
		left.view.Width = num3;
		top.view.Height = num3;
		right.view.Width = num3;
		bottom.view.Height = num3;
		top_left.view.Width = num3;
		top_left.view.Height = num3;
		top_right.view.Width = num3;
		top_right.view.Height = num3;
		bottom_left.view.Width = num3;
		bottom_left.view.Height = num3;
		bottom_right.view.Width = num3;
		bottom_right.view.Height = num3;
		if (IsShowArrow)
		{
			pathArrow.SetScaleUI(owner.sfr.ScaleX);
		}
	}

	public static void OnDrawROISubstitute_MouseMove(object sender, MouseEventArgs e)
	{
		if (Owner != null && Owner.SourceImage.Source != null)
		{
			if (!IsMoved)
			{
				IsMoved = true;
			}
			Point position = e.GetPosition(Owner.SourceImage);
			if (position.X < 0.0)
			{
				position.X = 0.0;
			}
			if (position.Y < 0.0)
			{
				position.Y = 0.0;
			}
			if (position.X > Owner.SourceImage.Width)
			{
				position.X = Owner.SourceImage.Width;
			}
			if (position.Y > Owner.SourceImage.ActualHeight)
			{
				position.Y = Owner.SourceImage.ActualHeight;
			}
			if (PointNum < substitute.Points.Count && PointNum >= 0)
			{
				substitute.Points[PointNum] = position;
			}
		}
	}

	public static void OnDrawROISubstitute_MouseDown(object sender, MouseEventArgs e)
	{
		if (Owner == null || !(e is MouseButtonEventArgs))
		{
			return;
		}
		if ((e as MouseButtonEventArgs).ClickCount < 2)
		{
			obj = new object();
			new Thread(() =>
			{
				object obj = HikPath.obj;
				IsDoubleClick = false;
				Thread.Sleep(doubleClickTime);
				if (obj == HikPath.obj && Owner != null)
				{
					Owner.Dispatcher.Invoke(() =>
					{
						if (!IsDoubleClick && substitute.Points.Count >= maxPathPointNum + 2)
						{
							if (Owner.OnControlAlert != null)
							{
								Owner.OnControlAlert(Owner, AppLocalizationService.GetLang("多边形点数不超过") + " " + maxPathPointNum);
								Owner.SourceImage?.CaptureMouse();
							}
							if (substitute.Points.Count > 1)
							{
								PointNum--;
								substitute.Points.RemoveAt(substitute.Points.Count - 2);
							}
						}
					});
				}
			}).Start();
			if (substitute.Points.Count >= maxPathPointNum + 3)
			{
				return;
			}
			int num = substitute.Points.Count - 2;
			if (num >= 0)
			{
				Point point = substitute.Points.Last();
				Point point2 = substitute.Points[num];
				if (new Vector(point.X - point2.X, point.Y - point2.Y).Length < 1.0 * Owner.Radio)
				{
					return;
				}
			}
			Point value = default;
			if (PointNum >= 0 && PointNum < substitute.Points.Count)
			{
				value = substitute.Points[PointNum];
			}
			PointNum++;
			substitute.Points.Add(value);
			return;
		}
		IsDoubleClick = true;
		if (PointNum == 1)
		{
			while (substitute.Points.Count > 0)
			{
				substitute.Points.RemoveAt(substitute.Points.Count - 1);
				PointNum--;
			}
			DoFinishSubstitute();
			return;
		}
		while (substitute.Points.Count > maxPathPointNum + 1)
		{
			substitute.Points.RemoveAt(substitute.Points.Count - 1);
			PointNum--;
		}
		if (IsMoved && PointNum > 1)
		{
			HikPolylineRoiParameter hikPolylineRoiParameter = Owner.DoGetExtendROIParam(RoiUIType.HikPath) as HikPolylineRoiParameter;
			if (hikPolylineRoiParameter == null)
			{
				hikPolylineRoiParameter = new HikPolylineRoiParameter();
			}
			substitute.Points.RemoveAt(substitute.Points.Count - 1);
			foreach (Point point3 in substitute.Points)
			{
				PolygonPoint item = new PolygonPoint
				{
					x = (float)(point3.X / Owner.Radio - 0.5),
					y = (float)(point3.Y / Owner.Radio - 0.5)
				};
				hikPolylineRoiParameter.PathPoints.Add(item);
			}
			hikPolylineRoiParameter.Name = "轨迹";
			Owner.RoiList.Add(hikPolylineRoiParameter);
		}
		DoFinishSubstitute();
	}

	public static void OnDrawROISubstitute_RightMouseUp(object sender, MouseEventArgs e)
	{
		if (PointNum > 0)
		{
			PointNum--;
			substitute.Points.RemoveAt(PointNum);
		}
		if (PointNum == 0)
		{
			DoFinishSubstitute();
		}
	}

	public static void DoFinishSubstitute()
	{
		if (Owner != null)
		{
			Owner.IsDrawRoi = false;
			Owner.RemoveROIChild(substitute);
			Owner.SourceImage.ReleaseMouseCapture();
			HikImageView hikImageView = Owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
			HikImageView hikImageView2 = Owner;
			hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Remove(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
			HikImageView hikImageView3 = Owner;
			hikImageView3.OnDrawRoi_MouseDownChange = (HikImageView.DrawRoi_MouseDownChange)Delegate.Remove(hikImageView3.OnDrawRoi_MouseDownChange, new HikImageView.DrawRoi_MouseDownChange(OnDrawROISubstitute_MouseDown));
			HikImageView hikImageView4 = Owner;
			hikImageView4.OnDrawRoi_RightMouseUpChange = (HikImageView.DrawRoi_RightMouseUpChange)Delegate.Remove(hikImageView4.OnDrawRoi_RightMouseUpChange, new HikImageView.DrawRoi_RightMouseUpChange(OnDrawROISubstitute_RightMouseUp));
			Owner = null;
		}
	}

	public static void OnScaleChangeSubstitute(object sender, object e)
	{
		substitute.StrokeThickness = 1.0 / (sender as ScaleTransform).ScaleX;
	}

	private static void OnPathPointsChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPath).PointsDataDrawT((d as HikPath).PathPoints);
		(d as HikPath).OnChangeOnPathPoints();
	}

	private void PointsDataDrawE(IList list, bool IsChangeStructure)
	{
		tlt.Angle = 0.0;
		foreach (PolygonPoint item in list)
		{
			if (min_x > ((double)item.x + 0.5) * owner.Radio)
			{
				min_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (max_x < ((double)item.x + 0.5) * owner.Radio)
			{
				max_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (min_y > ((double)item.y + 0.5) * owner.Radio)
			{
				min_y = ((double)item.y + 0.5) * owner.Radio;
			}
			if (max_y < ((double)item.y + 0.5) * owner.Radio)
			{
				max_y = ((double)item.y + 0.5) * owner.Radio;
			}
		}
		OriginPoint = new Point(min_x, min_y);
		for (int i = 0; i < squareAreas.Count; i++)
		{
			PolygonPoint polygonPoint2 = (PolygonPoint)list[i];
			squareAreas[i].X = ((double)polygonPoint2.X + 0.5) * owner.Radio - OriginPoint.X;
			squareAreas[i].Y = ((double)polygonPoint2.Y + 0.5) * owner.Radio - OriginPoint.Y;
			Point value = new Point
			{
				X = ((double)polygonPoint2.x + 0.5) * owner.Radio - min_x,
				Y = ((double)polygonPoint2.y + 0.5) * owner.Radio - min_y
			};
			Path.Points[i] = value;
			if (IsChangeStructure)
			{
				squareAreas[i].OldRateX = value.X / (max_x - min_x);
				squareAreas[i].OldRateY = value.Y / (max_y - min_y);
			}
		}
		DrawArrowPoint();
		ZWidth = max_x - min_x;
		ZHeight = max_y - min_y;
	}

	private void PointsDataDrawT(IList list)
	{
		tlt.Angle = 0.0;
		Path.Points.Clear();
		foreach (SquareArea squareArea in squareAreas)
		{
			WokeView.Children.Remove(squareArea);
		}
		squareAreas.Clear();
		PointsDataDraw(list);
	}

	private void PointsDataDraw(IList list)
	{
		if (owner == null)
		{
			return;
		}
		foreach (PolygonPoint item in list)
		{
			if (min_x > ((double)item.x + 0.5) * owner.Radio)
			{
				min_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (max_x < ((double)item.x + 0.5) * owner.Radio)
			{
				max_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (min_y > ((double)item.y + 0.5) * owner.Radio)
			{
				min_y = ((double)item.y + 0.5) * owner.Radio;
			}
			if (max_y < ((double)item.y + 0.5) * owner.Radio)
			{
				max_y = ((double)item.y + 0.5) * owner.Radio;
			}
		}
		foreach (PolygonPoint item2 in list)
		{
			Point value = new Point
			{
				X = ((double)item2.x + 0.5) * owner.Radio - min_x,
				Y = ((double)item2.y + 0.5) * owner.Radio - min_y
			};
			Path.Points.Add(value);
			SquareArea squareArea = new SquareArea
			{
				HorizontalAlignment = HorizontalAlignment.Center,
				VerticalAlignment = VerticalAlignment.Center
			};
			squareArea.Width = recWidth;
			squareArea.Height = recWidth;
			squareArea.Opacity = 0.0;
			squareArea.view.SetResourceReference(FrameworkElement.ContextMenuProperty, "OperateMenuHikPathSquare");
			squareArea.SetBinding(SquareArea.TXProperty, new Binding("X")
			{
				Mode = BindingMode.TwoWay
			});
			squareArea.SetBinding(SquareArea.TYProperty, new Binding("Y")
			{
				Mode = BindingMode.TwoWay
			});
			squareArea.SetBinding(SquareArea.SelectedItemProperty, new Binding("SelectItem")
			{
				Mode = BindingMode.TwoWay,
				Source = DataContext
			});
			squareArea.SelectedEnable = true;
			squareArea.Container = this;
			squareArea.DataContext = item2;
			squareArea.Index = Path.Points.Count - 1;
			squareArea.OldRateX = value.X / (max_x - min_x);
			squareArea.OldRateY = value.Y / (max_y - min_y);
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(squareArea.OnScaleChange));
			if (owner != null)
			{
				squareArea.SetScaleUI(owner.sfr.ScaleX * owner.viewScal);
			}
			else
			{
				squareArea.SetScaleUI(owner.sfr.ScaleX);
			}
			WokeView.Children.Add(squareArea);
			squareAreas.Add(squareArea);
		}
		OriginPoint = new Point(min_x, min_y);
		DrawArrowPoint();
		ZWidth = max_x - min_x;
		ZHeight = max_y - min_y;
	}

	private void OnChangeOnPathPoints()
	{
		CollectionChangedEventManager.AddHandler(PathPoints, PathPoints_CollectionChanged);
	}

	private void PathPoints_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		if (e.NewItems == null)
		{
		}
	}

	private static void OnTAngleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPath).OnChangeAngle();
	}

	private void OnChangeAngle()
	{
		tlt.Angle = TAngle;
	}

	private static void OnTWidthChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPath).OnChangeWidth();
	}

	private void OnChangeWidth()
	{
		if (TWidth >= 0.0)
		{
			Width = TWidth + recWidth * 2.0;
			tlt.CenterX = Width / 2.0;
		}
	}

	private static void OnTHeightChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPath).OnChangHeight();
	}

	private void OnChangHeight()
	{
		if (THeight >= 0.0)
		{
			Height = THeight + recWidth * 2.0;
			tlt.CenterY = Height / 2.0;
		}
	}

	private static void OnTOriginPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPath).OnChangOriginPoint();
	}

	private void OnChangOriginPoint()
	{
		double num = TOriginPoint.X - recWidth;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = TOriginPoint.Y - recWidth;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
	}

	private void DrawArrowPoint()
	{
		if (Path.Points.Count >= 2)
		{
			int count = Path.Points.Count;
			Point point = Path.Points[count - 2];
			Point point2 = Path.Points[count - 1];
			ArrowPoint = new Point((point.X + point2.X) / 2.0, (point.Y + point2.Y) / 2.0);
			double num = Math.Atan2(point2.Y - point.Y, point2.X - point.X);
			ArrowAngle = num * 180.0 / Math.PI;
		}
	}

	public HikPath()
	{
		InitializeComponent();
		childControlList.Add(move);
		childControlList.Add(top_left);
		childControlList.Add(top);
		childControlList.Add(top_right);
		childControlList.Add(left);
		childControlList.Add(right);
		childControlList.Add(bottom_left);
		childControlList.Add(bottom);
		childControlList.Add(bottom_right);
		childControlList.Add(angle);
		foreach (IArea childControl in childControlList)
		{
			childControl.Container = this;
		}
		SetValue(Canvas.LeftProperty, 10.0);
		SetValue(Canvas.TopProperty, 10.0);
		if (IsShowArrow)
		{
			pathArrow.Opacity = 1.0;
		}
	}

	private void UserControl_MouseEnter(object sender, MouseEventArgs e)
	{
		move.Opacity = 1.0;
		foreach (SquareArea squareArea in squareAreas)
		{
			squareArea.Opacity = 1.0;
		}
	}

	private void UserControl_MouseLeave(object sender, MouseEventArgs e)
	{
		move.Opacity = 0.0;
		foreach (SquareArea squareArea in squareAreas)
		{
			HikPolylineRoiParameter hikPolylineRoiParameter = DataContext as HikPolylineRoiParameter;
			if (squareArea.DataContext != hikPolylineRoiParameter?.SelectItem)
			{
				squareArea.Opacity = 0.0;
			}
		}
	}

	public void Doth(FrameworkElement rectangleArea, MouseEventArgs e)
	{
		isDragging = true;
		curType = rectangleArea.Name;
		if (rectangleArea is IArea)
		{
			curControl = rectangleArea as IArea;
		}
		oldHeight = Height;
		oldWeight = Width;
		CaptureMouse();
	}

	private void UserControl_Loaded(object sender, RoutedEventArgs e)
	{
		if (parent == null)
		{
			DependencyObject dependencyObject = VisualTreeHelper.GetParent(this);
			while (!(dependencyObject is Canvas))
			{
				dependencyObject = VisualTreeHelper.GetParent(dependencyObject);
			}
			parent = dependencyObject as Canvas;
			parent.MouseMove += zparent_MouseMove;
		}
	}

	private void zparent_MouseMove(object sender, MouseEventArgs e)
	{
		double temp = 0.0;
		double temp2 = 0.0;
		double num = 0.0;
		double num2 = 0.0;
		double num3 = 0.0;
		double num4 = 0.0;
		double num5 = 0.0;
		if (!isDragging)
		{
			return;
		}
		if (curControl is SquareArea)
		{
			Point position = e.GetPosition(WokeView);
			Point point = new Point(position.X + min_x - curControl.CurPoint.X + recWidth / 2.0, position.Y + min_y - curControl.CurPoint.Y + recWidth / 2.0);
			SquareArea squareArea = curControl as SquareArea;
			squareArea.X = position.X - curControl.CurPoint.X + recWidth / 2.0;
			squareArea.Y = position.Y - curControl.CurPoint.Y + recWidth / 2.0;
			Point value = new Point(squareArea.X, squareArea.Y);
			Path.Points[squareArea.Index] = value;
			return;
		}
		Point position2 = e.GetPosition(parent);
		Point framePoint = new Point((double)GetValue(Canvas.LeftProperty), (double)GetValue(Canvas.TopProperty));
		double num6 = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num7 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		hu.Angle = tlt.Angle;
		hu.CenterX = framePoint.X + Width / 2.0;
		hu.CenterY = framePoint.Y + Height / 2.0;
		position2 = hu.Inverse.Transform(position2);
		num = Width;
		num2 = Height;
		num3 = tlt.Angle;
		hu2.Angle = tlt.Angle;
		hu2.CenterX = 0.0;
		hu2.CenterY = 0.0;
		theTemp1 = 0.0;
		theTemp2 = 0.0;
		switch (curType)
		{
		case "userControl":
			temp = position2.X - framePoint.X - CurPoint.X;
			temp2 = position2.Y - framePoint.Y - CurPoint.Y;
			CPoint = hu2.Transform(new Point(temp, temp2));
			theTemp1 += CPoint.X;
			theTemp2 += CPoint.Y;
			break;
		case "move":
		{
			temp = position2.X - framePoint.X - curControl.CurPoint.X + (move.Width - Width) / 2.0;
			temp2 = position2.Y - framePoint.Y - curControl.CurPoint.Y + (move.Height - Height) / 2.0;
			CPoint = hu2.Transform(new Point(temp, temp2));
			Point point4 = new Point(0.0, 0.0);
			point4.X = framePoint.X + CPoint.X / 2.0 + Width / 2.0;
			point4.Y = framePoint.Y + CPoint.Y / 2.0 + Height / 2.0;
			double num9 = 0.0;
			if (point4.X < 0.0)
			{
				num9 = 0.0 - point4.X;
				CPoint.X += num9 * 2.0;
			}
			if (point4.X > parent.ActualWidth)
			{
				num9 = parent.ActualWidth - point4.X;
				CPoint.X += num9 * 2.0;
			}
			if (point4.Y < 0.0)
			{
				num9 = 0.0 - point4.Y;
				CPoint.Y += num9 * 2.0;
			}
			if (point4.Y > parent.ActualHeight)
			{
				num9 = parent.ActualHeight - point4.Y;
				CPoint.Y += num9 * 2.0;
			}
			hu.CenterX = framePoint.X + CPoint.X / 2.0 + Width / 2.0;
			hu.CenterY = framePoint.Y + CPoint.Y / 2.0 + Height / 2.0;
			num4 = framePoint.X + CPoint.X / 2.0;
			num5 = framePoint.Y + CPoint.Y / 2.0;
			double defHMax2 = 0.0;
			double defWMax2 = 0.0;
			Point point5 = new Point(num4 + recWidth, num5 + recWidth);
			point5 = hu.Transform(point5);
			if (!JudgeBorderByPoint(point5))
			{
				JudgeBorderM(point5, ref defHMax2, ref defWMax2);
			}
			point5 = new Point(num4 + Width - recWidth, num5 + recWidth);
			point5 = hu.Transform(point5);
			if (!JudgeBorderByPoint(point5))
			{
				JudgeBorderM(point5, ref defHMax2, ref defWMax2);
			}
			point5 = new Point(num4 + recWidth, num5 + Height - recWidth);
			point5 = hu.Transform(point5);
			if (!JudgeBorderByPoint(point5))
			{
				JudgeBorderM(point5, ref defHMax2, ref defWMax2);
			}
			point5 = new Point(num4 + Width - recWidth, num5 + Height - recWidth);
			point5 = hu.Transform(point5);
			if (!JudgeBorderByPoint(point5))
			{
				JudgeBorderM(point5, ref defHMax2, ref defWMax2);
			}
			num2 = ((Height - defHMax2 * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (Height - defHMax2 * 2.0));
			num = ((Width - defWMax2 * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (Width - defWMax2 * 2.0));
			theTemp1 += CPoint.X;
			theTemp2 += CPoint.Y;
			break;
		}
		case "top_left":
			InitTop(position2, framePoint, ref temp2, ref num2, 0.5);
			InitLeft(position2, framePoint, ref temp, ref num, 0.5);
			break;
		case "top":
			InitTop(position2, framePoint, ref temp2, ref num2, 1.0);
			break;
		case "top_right":
			InitTop(position2, framePoint, ref temp2, ref num2, 0.5);
			InitRight(position2, framePoint, ref temp, ref num, 0.5);
			break;
		case "left":
			InitLeft(position2, framePoint, ref temp, ref num, 1.0);
			break;
		case "right":
			InitRight(position2, framePoint, ref temp, ref num, 1.0);
			break;
		case "bottom_left":
			InitBottom(position2, framePoint, ref temp2, ref num2, 0.5);
			InitLeft(position2, framePoint, ref temp, ref num, 0.5);
			break;
		case "bottom":
			InitBottom(position2, framePoint, ref temp2, ref num2, 1.0);
			break;
		case "bottom_right":
			InitBottom(position2, framePoint, ref temp2, ref num2, 0.5);
			InitRight(position2, framePoint, ref temp, ref num, 0.5);
			break;
		case "angle":
		{
			CPoint = new Point(framePoint.X + Width / 2.0, framePoint.Y + Height / 2.0);
			Point point2 = new Point(position2.X - curControl.CurPoint.X + angleWidth / 2.0, position2.Y - curControl.CurPoint.Y + angleHeight / 2.0);
			point2 = hu.Transform(point2);
			double num8 = Math.Atan2(point2.Y - CPoint.Y, point2.X - CPoint.X);
			num3 = num8 * 180.0 / Math.PI;
			double defHMax = 0.0;
			double defWMax = 0.0;
			RotateTransform rotateTransform = new RotateTransform
			{
				CenterX = hu.CenterX,
				CenterY = hu.CenterY,
				Angle = num3
			};
			Point point3 = new Point(CPoint.X - oldWeight / 2.0 + recWidth, CPoint.Y - oldHeight / 2.0 + recWidth);
			point3 = rotateTransform.Transform(point3);
			if (!JudgeBorderByPoint(point3))
			{
				JudgeBorderAngle(point3, ref defHMax, ref defWMax);
			}
			point3 = new Point(CPoint.X + oldWeight / 2.0 - recWidth, CPoint.Y - oldHeight / 2.0 + recWidth);
			point3 = rotateTransform.Transform(point3);
			if (!JudgeBorderByPoint(point3))
			{
				JudgeBorderAngle(point3, ref defHMax, ref defWMax);
			}
			point3 = new Point(CPoint.X - oldWeight / 2.0 + recWidth, CPoint.Y + oldHeight / 2.0 - recWidth);
			point3 = rotateTransform.Transform(point3);
			if (!JudgeBorderByPoint(point3))
			{
				JudgeBorderAngle(point3, ref defHMax, ref defWMax);
			}
			point3 = new Point(CPoint.X + oldWeight / 2.0 - recWidth, CPoint.Y + oldHeight / 2.0 - recWidth);
			point3 = rotateTransform.Transform(point3);
			if (!JudgeBorderByPoint(point3))
			{
				JudgeBorderAngle(point3, ref defHMax, ref defWMax);
			}
			num2 = ((oldHeight - defHMax * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (oldHeight - defHMax * 2.0));
			num = ((oldWeight - defWMax * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (oldWeight - defWMax * 2.0));
			break;
		}
		}
		num4 = framePoint.X + (Width + theTemp1 - num) / 2.0;
		num5 = framePoint.Y + (Height + theTemp2 - num2) / 2.0;
		bool flag = false;
		if (num != Width)
		{
			Width = num;
			flag = true;
		}
		if (num2 != Height)
		{
			Height = num2;
			flag = true;
		}
		if (num3 != tlt.Angle)
		{
			tlt.Angle = num3;
		}
		if (num4 != (double)GetValue(Canvas.LeftProperty))
		{
			SetValue(Canvas.LeftProperty, num4);
		}
		if (num5 != (double)GetValue(Canvas.TopProperty))
		{
			SetValue(Canvas.TopProperty, num5);
		}
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		for (int i = 0; i < squareAreas.Count; i++)
		{
			squareAreas[i].TX = (float)((squareAreas[i].X + OriginPoint.X) / owner.Radio - 0.5);
			squareAreas[i].TY = (float)((squareAreas[i].Y + OriginPoint.Y) / owner.Radio - 0.5);
		}
		if (flag)
		{
			double num10 = Width - recWidth * 2.0;
			double num11 = Height - recWidth * 2.0;
			for (int j = 0; j < squareAreas.Count; j++)
			{
				squareAreas[j].X = squareAreas[j].OldRateX * num10;
				squareAreas[j].Y = squareAreas[j].OldRateY * num11;
				Point value2 = new Point(squareAreas[j].X, squareAreas[j].Y);
				Path.Points[j] = value2;
			}
			min_x = num4 + recWidth;
			min_y = num5 + recWidth;
			max_x = num10 + min_x;
			max_y = num11 + min_y;
		}
	}

	public void DoCallBack()
	{
		if (OnTheSizeChange != null)
		{
			OnTheSizeChange(DataContext);
		}
	}

	private bool JudgeBorderByPoint(Point newframePoint)
	{
		if (newframePoint.X < 0.0 || newframePoint.X >= parent.ActualWidth || newframePoint.Y < 0.0 || newframePoint.Y >= parent.ActualHeight)
		{
			return false;
		}
		return true;
	}

	private void InitRight(Point point, Point framePoint, ref double temp, ref double tempWidth, double component)
	{
		temp = point.X - framePoint.X - curControl.CurPoint.X + recWidth - Width;
		tempWidth = ((temp + Width < recWidth * 2.0) ? (recWidth * 2.0) : (temp + Width));
		CPoint = hu2.Transform(new Point(temp, 0.0));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void InitBottom(Point point, Point framePoint, ref double temp, ref double tempHeight, double component)
	{
		temp = point.Y - framePoint.Y - curControl.CurPoint.Y + recWidth - Height;
		tempHeight = ((temp + Height < recWidth * 2.0) ? (recWidth * 2.0) : (temp + Height));
		CPoint = hu2.Transform(new Point(0.0, temp));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void InitLeft(Point point, Point framePoint, ref double temp, ref double tempWidth, double component)
	{
		temp = point.X - framePoint.X - curControl.CurPoint.X;
		tempWidth = ((Width - temp < recWidth * 2.0) ? (recWidth * 2.0) : (Width - temp));
		CPoint = hu2.Transform(new Point(temp, 0.0));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void InitTop(Point point, Point framePoint, ref double temp, ref double tempHeight, double component)
	{
		temp = point.Y - framePoint.Y - curControl.CurPoint.Y;
		tempHeight = ((Height - temp < recWidth * 2.0) ? (recWidth * 2.0) : (Height - temp));
		CPoint = hu2.Transform(new Point(0.0, temp));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void JudgeBorderM(Point newframePoint, ref double defHMax, ref double defWMax)
	{
		double num = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num2 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		double num3 = 0.0;
		double num4 = 0.0;
		if (newframePoint.X < 0.0)
		{
			num3 = Math.Abs(newframePoint.X * num);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs(newframePoint.X * num2);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.X > parent.ActualWidth)
		{
			num3 = Math.Abs((parent.ActualWidth - newframePoint.X) * num);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((parent.ActualWidth - newframePoint.X) * num2);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y < 0.0)
		{
			num3 = Math.Abs(newframePoint.Y * num2);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs(newframePoint.Y * num);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y > parent.ActualHeight)
		{
			num3 = Math.Abs((parent.ActualHeight - newframePoint.Y) * num2);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((parent.ActualHeight - newframePoint.Y) * num);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
	}

	private void JudgeBorderAngle(Point newframePoint, ref double defHMax, ref double defWMax)
	{
		double num = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num2 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		double num3 = 0.0;
		double num4 = 0.0;
		if (newframePoint.X < 0.0)
		{
			num3 = Math.Abs((0.0 - newframePoint.X) * (oldHeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.X + CPoint.X)));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((0.0 - newframePoint.X) * (oldWeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.X + CPoint.X)));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.X > parent.ActualWidth)
		{
			num3 = Math.Abs((newframePoint.X - parent.ActualWidth) * (oldHeight - recWidth * 2.0) / (2.0 * (newframePoint.X - parent.ActualWidth + (parent.ActualWidth - CPoint.X))));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((newframePoint.X - parent.ActualWidth) * (oldWeight - recWidth * 2.0) / (2.0 * (newframePoint.X - parent.ActualWidth + (parent.ActualWidth - CPoint.X))));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y < 0.0)
		{
			num3 = Math.Abs((0.0 - newframePoint.Y) * (oldHeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.Y + CPoint.Y)));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((0.0 - newframePoint.Y) * (oldWeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.Y + CPoint.Y)));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y > parent.ActualHeight)
		{
			num3 = Math.Abs((newframePoint.Y - parent.ActualHeight) * (oldHeight - recWidth * 2.0) / (2.0 * (newframePoint.Y - parent.ActualHeight + (parent.ActualHeight - CPoint.Y))));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((newframePoint.Y - parent.ActualHeight) * (oldWeight - recWidth * 2.0) / (2.0 * (newframePoint.Y - parent.ActualHeight + (parent.ActualHeight - CPoint.Y))));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
	}

	private void JudgeBorder(Point newframePoint, ref double defMax, ref double defMin, string dir)
	{
		double num = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num2 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		int num3 = 1;
		int num4 = 1;
		double num5 = 1.0;
		double num6 = 1.0;
		switch (dir)
		{
		case "Right":
		case "Left":
			num3 = -1;
			num4 = -1;
			num5 = num2;
			num6 = num;
			break;
		case "Bottom":
		case "Top":
			num3 = 1;
			num4 = -1;
			num5 = num;
			num6 = num2;
			break;
		}
		newframePoint = hu.Transform(newframePoint);
		if (!(newframePoint.X < 0.0) && !(newframePoint.X >= parent.ActualWidth) && !(newframePoint.Y < 0.0) && !(newframePoint.Y >= parent.ActualHeight))
		{
			return;
		}
		double num7 = 0.0;
		if (newframePoint.X < 0.0)
		{
			num7 = (double)num3 * newframePoint.X / num5;
			if (Math.Abs(num5) > 0.0001)
			{
				if (num7 > defMax)
				{
					defMax = num7;
				}
				if (num7 < defMin)
				{
					defMin = num7;
				}
			}
		}
		if (newframePoint.X >= parent.ActualWidth)
		{
			num7 = (double)num3 * (newframePoint.X - parent.ActualWidth) / num5;
			if (Math.Abs(num5) > 0.0001)
			{
				if (num7 > defMax)
				{
					defMax = num7;
				}
				if (num7 < defMin)
				{
					defMin = num7;
				}
			}
		}
		if (newframePoint.Y < 0.0)
		{
			num7 = (double)num4 * newframePoint.Y / num6;
			if (Math.Abs(num6) > 0.0001)
			{
				if (num7 > defMax)
				{
					defMax = num7;
				}
				if (num7 < defMin)
				{
					defMin = num7;
				}
			}
		}
		if (!(newframePoint.Y >= parent.ActualHeight))
		{
			return;
		}
		num7 = (double)num4 * (newframePoint.Y - parent.ActualHeight) / num6;
		if (Math.Abs(num6) > 0.0001)
		{
			if (num7 > defMax)
			{
				defMax = num7;
			}
			if (num7 < defMin)
			{
				defMin = num7;
			}
		}
	}

	private void UserControl_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (ownerCanvas != null && ownerCanvas is ROIContainer rOIContainer)
		{
			rOIContainer.SelectionService.RoiSelected(DataContext);
		}
		else
		{
			owner.SelectionService.RoiSelected(DataContext);
		}
		HikPolylineRoiParameter roi = DataContext as HikPolylineRoiParameter;
		if (roi != null)
		{
			SquareArea squareArea = squareAreas.FirstOrDefault((SquareArea p) => p.DataContext == roi.SelectItem);
			if (squareArea != null && !squareArea.IsPressed)
			{
				(DataContext as HikPolylineRoiParameter).SelectItem = null;
			}
		}
		Focus();
		if (!isDragging)
		{
			CurPoint = e.GetPosition(mainGrid);
			Doth(this, e);
			owner.DoRoiClick(this, e);
		}
	}

	private void UserControl_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)
	{
		if (!isDragging)
		{
			return;
		}
		double num = 1.0;
		if (owner != null)
		{
			num = owner.Radio;
		}
		isDragging = false;
		TWidth = Width - recWidth * 2.0;
		THeight = Height - recWidth * 2.0;
		double num2 = (double)GetValue(Canvas.LeftProperty);
		double num3 = (double)GetValue(Canvas.TopProperty);
		TAngle = tlt.Angle;
		if (curControl != null)
		{
			curControl.IsPressed = false;
			if (curControl is SquareArea)
			{
				min_x = double.MaxValue;
				max_x = 0.0;
				min_y = double.MaxValue;
				max_y = 0.0;
				PointsDataDrawE(PathPoints, IsChangeStructure: true);
			}
			else
			{
				FrameworkElement frameworkElement = curControl as FrameworkElement;
				string name = frameworkElement.Name;
				min_x = double.MaxValue;
				max_x = 0.0;
				min_y = double.MaxValue;
				max_y = 0.0;
				PointsDataDrawE(PathPoints, IsChangeStructure: false);
			}
		}
		curControl = null;
		DoCallBack();
		ReleaseMouseCapture();
	}

	private void Path_MouseRightButtonDown(object sender, MouseButtonEventArgs e)
	{
		Point position = e.GetPosition(owner.SourceImage);
		if (position.X < 0.0)
		{
			position.X = 0.0;
		}
		if (position.Y < 0.0)
		{
			position.Y = 0.0;
		}
		if (position.X > owner.SourceImage.Width)
		{
			position.X = owner.SourceImage.Width;
		}
		if (position.Y > owner.SourceImage.ActualHeight)
		{
			position.Y = owner.SourceImage.ActualHeight;
		}
		RightMouseUpPoint = new PolygonPoint
		{
			x = (float)(position.X / owner.Radio - 0.5),
			y = (float)(position.Y / owner.Radio - 0.5)
		};
		roiParamer = DataContext as HikPolylineRoiParameter;
	}

	protected override void OnPreviewKeyDown(KeyEventArgs e)
	{
		if ((e.Key == Key.Delete || e.Key == Key.Back) && GetSelectIndex() >= 0)
		{
			DeletePoint();
			e.Handled = true;
		}
		else
		{
			base.OnPreviewKeyDown(e);
		}
	}

	public void DeletePoint()
	{
		int selectIndex = GetSelectIndex();
		if (selectIndex < 0)
		{
			return;
		}
		if (roiParamer.PathPoints.Count <= 2)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PolyLineMinPointLimit"), MessageIcons.Error);
			return;
		}
		HikPolylineRoiParameter hikPolylineRoiParameter = roiParamer.Clone() as HikPolylineRoiParameter;
		hikPolylineRoiParameter.PathPoints.RemoveAt(selectIndex);
		int index = owner.RoiList.IndexOf(roiParamer);
		owner.RoiList[index] = hikPolylineRoiParameter;
		if (roiParamer.PathPoints.Count > 0)
		{
			owner.ChangeSelectedBaseROI(roiParamer);
		}
	}

	public void CloseTraj()
	{
		roiParamer.PathPoints.Insert(roiParamer.PathPoints.Count, new PolygonPoint
		{
			X = roiParamer.PathPoints[0].X,
			Y = roiParamer.PathPoints[0].Y,
			Index = (uint)roiParamer.PathPoints.Count
		});
		owner.RoiList.Remove(roiParamer);
		owner.RoiList.Add(roiParamer);
		owner.ChangeSelectedBaseROI(roiParamer);
	}

	private int GetSelectIndex()
	{
		roiParamer = DataContext as HikPolylineRoiParameter;
		if (roiParamer != null && roiParamer.SelectItem != null)
		{
			for (int i = 0; i < squareAreas.Count; i++)
			{
				SquareArea squareArea = squareAreas[i];
				if (squareArea.DataContext == roiParamer.SelectItem)
				{
					return i;
				}
			}
		}
		return -1;
	}

	public void InsertPoint()
	{
		int index = GetIndex();
		if (index > 0)
		{
			HikPolylineRoiParameter hikPolylineRoiParameter = roiParamer.Clone() as HikPolylineRoiParameter;
			hikPolylineRoiParameter.PathPoints.Insert(index, RightMouseUpPoint);
			int index2 = owner.RoiList.IndexOf(roiParamer);
			owner.RoiList[index2] = hikPolylineRoiParameter;
			owner.ChangeSelectedBaseROI(roiParamer);
		}
	}

	private int GetIndex()
	{
		roiParamer = DataContext as HikPolylineRoiParameter;
		Dictionary<int, Tuple<PolygonPoint, PolygonPoint>> dictionary = new Dictionary<int, Tuple<PolygonPoint, PolygonPoint>>();
		Dictionary<int, double> dictionary2 = new Dictionary<int, double>();
		for (int i = 0; i < roiParamer.PathPoints.Count - 1; i++)
		{
			dictionary.Add(i + 1, new Tuple<PolygonPoint, PolygonPoint>(roiParamer.PathPoints[i], roiParamer.PathPoints[i + 1]));
		}
		foreach (KeyValuePair<int, Tuple<PolygonPoint, PolygonPoint>> item in dictionary)
		{
			double value = PointToSegDist(item.Value.Item1, item.Value.Item2);
			dictionary2.Add(item.Key, value);
		}
		double num = dictionary2.Values.Min();
		foreach (KeyValuePair<int, double> item2 in dictionary2)
		{
			if (item2.Value == num)
			{
				return item2.Key;
			}
		}
		return -1;
	}

	public double PointToSegDist(PolygonPoint Point1, PolygonPoint Point2)
	{
		double x = RightMouseUpPoint.X;
		double y = RightMouseUpPoint.Y;
		double x2 = Point1.X;
		double y2 = Point1.Y;
		double x3 = Point2.X;
		double y3 = Point2.Y;
		Vector vector = new Vector(x2, y2);
		Vector vector2 = new Vector(x3, y3);
		Vector vector3 = new Vector(x, y);
		Vector vector4 = vector2 - vector;
		Vector vector5 = vector3 - vector;
		Vector vector6 = vector3 - vector2;
		double d = Math.Abs(Vector.AngleBetween(vector4, vector5)) * Math.PI / 180.0;
		double num = vector4.Length * vector5.Length * Math.Cos(d) / (vector4.Length * vector4.Length);
		if (num <= 0.0)
		{
			return vector5.Length;
		}
		if (num >= 1.0)
		{
			return vector6.Length;
		}
		return GetMinDistance(Point1, Point2, RightMouseUpPoint);
	}

	public static double GetMinDistance(PolygonPoint pt1, PolygonPoint pt2, PolygonPoint pt3)
	{
		double num = 0.0;
		if (pt1.X == pt2.X)
		{
			return Math.Abs(pt3.X - pt1.X);
		}
		double num2 = (pt2.Y - pt1.Y) / (pt2.X - pt1.X);
		double num3 = (pt2.X * pt1.Y - pt1.X * pt2.Y) / (pt2.X - pt1.X);
		return Math.Abs(num2 * (double)pt3.X - (double)pt3.Y + num3) / Math.Sqrt(num2 * num2 + 1.0);
	}

	[DebuggerNonUserCode]
	[GeneratedCode("PresentationBuildTasks", "4.0.0.0")]
	internal Delegate _CreateDelegate(Type delegateType, string handler)
	{
		return Delegate.CreateDelegate(delegateType, this, handler);
	}
