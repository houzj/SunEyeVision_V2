	{
		(d as HikPolygon).OnChangeAngle();
	}

	private void OnChangeAngle()
	{
		tlt.Angle = TAngle;
	}

	private static void OnTWidthChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPolygon).OnChangeWidth();
	}

	private void OnChangeWidth()
	{
		if (TWidth >= 0.0)
		{
			Width = TWidth + recWidth * 2.0;
			tlt.CenterX = Width / 2.0;
		}
	}

	private static void OnTHeightChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPolygon).OnChangHeight();
	}

	private void OnChangHeight()
	{
		if (THeight >= 0.0)
		{
			Height = THeight + recWidth * 2.0;
			tlt.CenterY = Height / 2.0;
		}
	}

	private static void OnTOriginPointChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPolygon).OnChangOriginPoint();
	}

	private void OnChangOriginPoint()
	{
		double num = TOriginPoint.X - recWidth;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.LeftProperty, num);
		}
		num = TOriginPoint.Y - recWidth;
		if (!double.IsInfinity(num))
		{
			SetValue(Canvas.TopProperty, num);
		}
	}

	public HikPolygon()
	{
		InitializeComponent();
		childControlList.Add(move);
		childControlList.Add(top_left);
		childControlList.Add(top);
		childControlList.Add(top_right);
		childControlList.Add(left);
		childControlList.Add(right);
		childControlList.Add(bottom_left);
		childControlList.Add(bottom);
		childControlList.Add(bottom_right);
		childControlList.Add(angle);
		foreach (IArea childControl in childControlList)
		{
			childControl.Container = this;
		}
		SetValue(Canvas.LeftProperty, 10.0);
		SetValue(Canvas.TopProperty, 10.0);
	}

	private void UserControl_MouseEnter(object sender, MouseEventArgs e)
	{
		move.Opacity = 1.0;
		foreach (SquareArea squareArea in squareAreas)
		{
			squareArea.Opacity = 1.0;
		}
	}

	private void UserControl_MouseLeave(object sender, MouseEventArgs e)
	{
		move.Opacity = 0.0;
		foreach (SquareArea squareArea in squareAreas)
		{
			squareArea.Opacity = 0.0;
		}
	}

	public void Doth(FrameworkElement rectangleArea, MouseEventArgs e)
	{
		IsParamChanged = false;
		isDragging = true;
		curType = rectangleArea.Name;
		if (rectangleArea is IArea)
		{
			curControl = rectangleArea as IArea;
		}
		oldHeight = Height;
		oldWeight = Width;
		CaptureMouse();
	}

	private void UserControl_Loaded(object sender, RoutedEventArgs e)
	{
		if (parent == null)
		{
			DependencyObject dependencyObject = VisualTreeHelper.GetParent(this);
			while (!(dependencyObject is Canvas))
			{
				dependencyObject = VisualTreeHelper.GetParent(dependencyObject);
			}
			parent = dependencyObject as Canvas;
			parent.MouseMove += zparent_MouseMove;
		}
	}

	private void zparent_MouseMove(object sender, MouseEventArgs e)
	{
		if (!isDragging)
		{
			return;
		}
		if (curControl is SquareArea)
		{
			Point position = e.GetPosition(WokeView);
			SquareArea squareArea = curControl as SquareArea;
			double x = squareArea.X;
			double y = squareArea.Y;
			double num = position.X - curControl.CurPoint.X + recWidth / 2.0;
			double num2 = position.Y - curControl.CurPoint.Y + recWidth / 2.0;
			if (Math.Abs(x - num) > 0.0001 || Math.Abs(y - num2) > 0.0001)
			{
				squareArea.X = num;
				squareArea.Y = num2;
				Point value = new Point(squareArea.X, squareArea.Y);
				polygon.Points[squareArea.Index] = value;
				IsParamChanged = true;
			}
			return;
		}
		double temp = 0.0;
		double temp2 = 0.0;
		double num3 = 0.0;
		double num4 = 0.0;
		double num5 = 0.0;
		double num6 = 0.0;
		double num7 = 0.0;
		Point position2 = e.GetPosition(parent);
		Point framePoint = new Point((double)GetValue(Canvas.LeftProperty), (double)GetValue(Canvas.TopProperty));
		double num8 = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num9 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		hu.Angle = tlt.Angle;
		hu.CenterX = framePoint.X + Width / 2.0;
		hu.CenterY = framePoint.Y + Height / 2.0;
		position2 = hu.Inverse.Transform(position2);
		num3 = Width;
		num4 = Height;
		num5 = tlt.Angle;
		hu2.Angle = tlt.Angle;
		hu2.CenterX = 0.0;
		hu2.CenterY = 0.0;
		theTemp1 = 0.0;
		theTemp2 = 0.0;
		switch (curType)
		{
		case "userControl":
			temp = position2.X - framePoint.X - CurPoint.X;
			temp2 = position2.Y - framePoint.Y - CurPoint.Y;
			if (Math.Abs(temp) > 0.0001 || Math.Abs(temp2) > 0.0001)
			{
				CPoint = hu2.Transform(new Point(temp, temp2));
				theTemp1 += CPoint.X;
				theTemp2 += CPoint.Y;
				IsParamChanged = true;
			}
			break;
		case "move":
		{
			temp = position2.X - framePoint.X - curControl.CurPoint.X + (move.Width - Width) / 2.0;
			temp2 = position2.Y - framePoint.Y - curControl.CurPoint.Y + (move.Height - Height) / 2.0;
			CPoint = hu2.Transform(new Point(temp, temp2));
			Point point3 = new Point(0.0, 0.0);
			point3.X = framePoint.X + CPoint.X / 2.0 + Width / 2.0;
			point3.Y = framePoint.Y + CPoint.Y / 2.0 + Height / 2.0;
			double num11 = 0.0;
			if (point3.X < 0.0)
			{
				num11 = 0.0 - point3.X;
				CPoint.X += num11 * 2.0;
			}
			if (point3.X > parent.ActualWidth)
			{
				num11 = parent.ActualWidth - point3.X;
				CPoint.X += num11 * 2.0;
			}
			if (point3.Y < 0.0)
			{
				num11 = 0.0 - point3.Y;
				CPoint.Y += num11 * 2.0;
			}
			if (point3.Y > parent.ActualHeight)
			{
				num11 = parent.ActualHeight - point3.Y;
				CPoint.Y += num11 * 2.0;
			}
			hu.CenterX = framePoint.X + CPoint.X / 2.0 + Width / 2.0;
			hu.CenterY = framePoint.Y + CPoint.Y / 2.0 + Height / 2.0;
			num6 = framePoint.X + CPoint.X / 2.0;
			num7 = framePoint.Y + CPoint.Y / 2.0;
			double defHMax2 = 0.0;
			double defWMax2 = 0.0;
			Point point4 = new Point(num6 + recWidth, num7 + recWidth);
			point4 = hu.Transform(point4);
			if (!JudgeBorderByPoint(point4))
			{
				JudgeBorderM(point4, ref defHMax2, ref defWMax2);
			}
			point4 = new Point(num6 + Width - recWidth, num7 + recWidth);
			point4 = hu.Transform(point4);
			if (!JudgeBorderByPoint(point4))
			{
				JudgeBorderM(point4, ref defHMax2, ref defWMax2);
			}
			point4 = new Point(num6 + recWidth, num7 + Height - recWidth);
			point4 = hu.Transform(point4);
			if (!JudgeBorderByPoint(point4))
			{
				JudgeBorderM(point4, ref defHMax2, ref defWMax2);
			}
			point4 = new Point(num6 + Width - recWidth, num7 + Height - recWidth);
			point4 = hu.Transform(point4);
			if (!JudgeBorderByPoint(point4))
			{
				JudgeBorderM(point4, ref defHMax2, ref defWMax2);
			}
			num4 = ((Height - defHMax2 * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (Height - defHMax2 * 2.0));
			num3 = ((Width - defWMax2 * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (Width - defWMax2 * 2.0));
			theTemp1 += CPoint.X;
			theTemp2 += CPoint.Y;
			break;
		}
		case "top_left":
			InitTop(position2, framePoint, ref temp2, ref num4, 0.5);
			InitLeft(position2, framePoint, ref temp, ref num3, 0.5);
			break;
		case "top":
			InitTop(position2, framePoint, ref temp2, ref num4, 1.0);
			break;
		case "top_right":
			InitTop(position2, framePoint, ref temp2, ref num4, 0.5);
			InitRight(position2, framePoint, ref temp, ref num3, 0.5);
			break;
		case "left":
			InitLeft(position2, framePoint, ref temp, ref num3, 1.0);
			break;
		case "right":
			InitRight(position2, framePoint, ref temp, ref num3, 1.0);
			break;
		case "bottom_left":
			InitBottom(position2, framePoint, ref temp2, ref num4, 0.5);
			InitLeft(position2, framePoint, ref temp, ref num3, 0.5);
			break;
		case "bottom":
			InitBottom(position2, framePoint, ref temp2, ref num4, 1.0);
			break;
		case "bottom_right":
			InitBottom(position2, framePoint, ref temp2, ref num4, 0.5);
			InitRight(position2, framePoint, ref temp, ref num3, 0.5);
			break;
		case "angle":
		{
			CPoint = new Point(framePoint.X + Width / 2.0, framePoint.Y + Height / 2.0);
			Point point = new Point(position2.X - curControl.CurPoint.X + angleWidth / 2.0, position2.Y - curControl.CurPoint.Y + angleHeight / 2.0);
			point = hu.Transform(point);
			double num10 = Math.Atan2(point.Y - CPoint.Y, point.X - CPoint.X);
			num5 = num10 * 180.0 / Math.PI;
			double defHMax = 0.0;
			double defWMax = 0.0;
			RotateTransform rotateTransform = new RotateTransform
			{
				CenterX = hu.CenterX,
				CenterY = hu.CenterY,
				Angle = num5
			};
			Point point2 = new Point(CPoint.X - oldWeight / 2.0 + recWidth, CPoint.Y - oldHeight / 2.0 + recWidth);
			point2 = rotateTransform.Transform(point2);
			if (!JudgeBorderByPoint(point2))
			{
				JudgeBorderAngle(point2, ref defHMax, ref defWMax);
			}
			point2 = new Point(CPoint.X + oldWeight / 2.0 - recWidth, CPoint.Y - oldHeight / 2.0 + recWidth);
			point2 = rotateTransform.Transform(point2);
			if (!JudgeBorderByPoint(point2))
			{
				JudgeBorderAngle(point2, ref defHMax, ref defWMax);
			}
			point2 = new Point(CPoint.X - oldWeight / 2.0 + recWidth, CPoint.Y + oldHeight / 2.0 - recWidth);
			point2 = rotateTransform.Transform(point2);
			if (!JudgeBorderByPoint(point2))
			{
				JudgeBorderAngle(point2, ref defHMax, ref defWMax);
			}
			point2 = new Point(CPoint.X + oldWeight / 2.0 - recWidth, CPoint.Y + oldHeight / 2.0 - recWidth);
			point2 = rotateTransform.Transform(point2);
			if (!JudgeBorderByPoint(point2))
			{
				JudgeBorderAngle(point2, ref defHMax, ref defWMax);
			}
			num4 = ((oldHeight - defHMax * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (oldHeight - defHMax * 2.0));
			num3 = ((oldWeight - defWMax * 2.0 < recWidth * 2.0) ? (recWidth * 2.0) : (oldWeight - defWMax * 2.0));
			break;
		}
		}
		num6 = framePoint.X + (Width + theTemp1 - num3) / 2.0;
		num7 = framePoint.Y + (Height + theTemp2 - num4) / 2.0;
		bool flag = false;
		if (num3 != Width)
		{
			Width = num3;
			flag = true;
		}
		if (num4 != Height)
		{
			Height = num4;
			flag = true;
		}
		if (num5 != tlt.Angle)
		{
			tlt.Angle = num5;
		}
		if (num6 != (double)GetValue(Canvas.LeftProperty))
		{
			SetValue(Canvas.LeftProperty, num6);
		}
		if (num7 != (double)GetValue(Canvas.TopProperty))
		{
			SetValue(Canvas.TopProperty, num7);
		}
		tlt.CenterX = Width / 2.0;
		tlt.CenterY = Height / 2.0;
		for (int i = 0; i < squareAreas.Count; i++)
		{
			squareAreas[i].TX = (float)((squareAreas[i].X + OriginPoint.X) / owner.Radio - 0.5);
			squareAreas[i].TY = (float)((squareAreas[i].Y + OriginPoint.Y) / owner.Radio - 0.5);
		}
		if (flag)
		{
			double num12 = Width - recWidth * 2.0;
			double num13 = Height - recWidth * 2.0;
			for (int j = 0; j < squareAreas.Count; j++)
			{
				squareAreas[j].X = squareAreas[j].OldRateX * num12;
				squareAreas[j].Y = squareAreas[j].OldRateY * num13;
				Point value2 = new Point(squareAreas[j].X, squareAreas[j].Y);
				polygon.Points[j] = value2;
			}
			min_x = num6 + recWidth;
			min_y = num7 + recWidth;
			max_x = num12 + min_x;
			max_y = num13 + min_y;
		}
	}

	public void DoCallBack()
	{
		if (OnTheSizeChange != null)
		{
			OnTheSizeChange(DataContext);
		}
	}

	private bool JudgeBorderByPoint(Point newframePoint)
	{
		if (newframePoint.X < 0.0 || newframePoint.X >= parent.ActualWidth || newframePoint.Y < 0.0 || newframePoint.Y >= parent.ActualHeight)
		{
			return false;
		}
		return true;
	}

	private void InitRight(Point point, Point framePoint, ref double temp, ref double tempWidth, double component)
	{
		temp = point.X - framePoint.X - curControl.CurPoint.X + recWidth - Width;
		tempWidth = ((temp + Width < recWidth * 2.0) ? (recWidth * 2.0) : (temp + Width));
		CPoint = hu2.Transform(new Point(temp, 0.0));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void InitBottom(Point point, Point framePoint, ref double temp, ref double tempHeight, double component)
	{
		temp = point.Y - framePoint.Y - curControl.CurPoint.Y + recWidth - Height;
		tempHeight = ((temp + Height < recWidth * 2.0) ? (recWidth * 2.0) : (temp + Height));
		CPoint = hu2.Transform(new Point(0.0, temp));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void InitLeft(Point point, Point framePoint, ref double temp, ref double tempWidth, double component)
	{
		temp = point.X - framePoint.X - curControl.CurPoint.X;
		tempWidth = ((Width - temp < recWidth * 2.0) ? (recWidth * 2.0) : (Width - temp));
		CPoint = hu2.Transform(new Point(temp, 0.0));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void InitTop(Point point, Point framePoint, ref double temp, ref double tempHeight, double component)
	{
		temp = point.Y - framePoint.Y - curControl.CurPoint.Y;
		tempHeight = ((Height - temp < recWidth * 2.0) ? (recWidth * 2.0) : (Height - temp));
		CPoint = hu2.Transform(new Point(0.0, temp));
		theTemp1 += CPoint.X;
		theTemp2 += CPoint.Y;
	}

	private void JudgeBorderM(Point newframePoint, ref double defHMax, ref double defWMax)
	{
		double num = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num2 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		double num3 = 0.0;
		double num4 = 0.0;
		if (newframePoint.X < 0.0)
		{
			num3 = Math.Abs(newframePoint.X * num);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs(newframePoint.X * num2);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.X > parent.ActualWidth)
		{
			num3 = Math.Abs((parent.ActualWidth - newframePoint.X) * num);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((parent.ActualWidth - newframePoint.X) * num2);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y < 0.0)
		{
			num3 = Math.Abs(newframePoint.Y * num2);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs(newframePoint.Y * num);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y > parent.ActualHeight)
		{
			num3 = Math.Abs((parent.ActualHeight - newframePoint.Y) * num2);
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((parent.ActualHeight - newframePoint.Y) * num);
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
	}

	private void JudgeBorderAngle(Point newframePoint, ref double defHMax, ref double defWMax)
	{
		double num = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num2 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		double num3 = 0.0;
		double num4 = 0.0;
		if (newframePoint.X < 0.0)
		{
			num3 = Math.Abs((0.0 - newframePoint.X) * (oldHeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.X + CPoint.X)));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((0.0 - newframePoint.X) * (oldWeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.X + CPoint.X)));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.X > parent.ActualWidth)
		{
			num3 = Math.Abs((newframePoint.X - parent.ActualWidth) * (oldHeight - recWidth * 2.0) / (2.0 * (newframePoint.X - parent.ActualWidth + (parent.ActualWidth - CPoint.X))));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((newframePoint.X - parent.ActualWidth) * (oldWeight - recWidth * 2.0) / (2.0 * (newframePoint.X - parent.ActualWidth + (parent.ActualWidth - CPoint.X))));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y < 0.0)
		{
			num3 = Math.Abs((0.0 - newframePoint.Y) * (oldHeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.Y + CPoint.Y)));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((0.0 - newframePoint.Y) * (oldWeight - recWidth * 2.0) / (2.0 * (0.0 - newframePoint.Y + CPoint.Y)));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
		if (newframePoint.Y > parent.ActualHeight)
		{
			num3 = Math.Abs((newframePoint.Y - parent.ActualHeight) * (oldHeight - recWidth * 2.0) / (2.0 * (newframePoint.Y - parent.ActualHeight + (parent.ActualHeight - CPoint.Y))));
			if (num3 > defHMax)
			{
				defHMax = num3;
			}
			num4 = Math.Abs((newframePoint.Y - parent.ActualHeight) * (oldWeight - recWidth * 2.0) / (2.0 * (newframePoint.Y - parent.ActualHeight + (parent.ActualHeight - CPoint.Y))));
			if (num4 > defWMax)
			{
				defWMax = num4;
			}
		}
	}

	private void JudgeBorder(Point newframePoint, ref double defMax, ref double defMin, string dir)
	{
		double num = Math.Sin(tlt.Angle * Math.PI / 180.0);
		double num2 = Math.Cos(tlt.Angle * Math.PI / 180.0);
		int num3 = 1;
		int num4 = 1;
		double num5 = 1.0;
		double num6 = 1.0;
		switch (dir)
		{
		case "Right":
		case "Left":
			num3 = -1;
			num4 = -1;
			num5 = num2;
			num6 = num;
			break;
		case "Bottom":
		case "Top":
			num3 = 1;
			num4 = -1;
			num5 = num;
			num6 = num2;
			break;
		}
		newframePoint = hu.Transform(newframePoint);
		if (!(newframePoint.X < 0.0) && !(newframePoint.X >= parent.ActualWidth) && !(newframePoint.Y < 0.0) && !(newframePoint.Y >= parent.ActualHeight))
		{
			return;
		}
		double num7 = 0.0;
		if (newframePoint.X < 0.0)
		{
			num7 = (double)num3 * newframePoint.X / num5;
			if (Math.Abs(num5) > 0.0001)
			{
				if (num7 > defMax)
				{
					defMax = num7;
				}
				if (num7 < defMin)
				{
					defMin = num7;
				}
			}
		}
		if (newframePoint.X >= parent.ActualWidth)
		{
			num7 = (double)num3 * (newframePoint.X - parent.ActualWidth) / num5;
			if (Math.Abs(num5) > 0.0001)
			{
				if (num7 > defMax)
				{
					defMax = num7;
				}
				if (num7 < defMin)
				{
					defMin = num7;
				}
			}
		}
		if (newframePoint.Y < 0.0)
		{
			num7 = (double)num4 * newframePoint.Y / num6;
			if (Math.Abs(num6) > 0.0001)
			{
				if (num7 > defMax)
				{
					defMax = num7;
				}
				if (num7 < defMin)
				{
					defMin = num7;
				}
			}
		}
		if (!(newframePoint.Y >= parent.ActualHeight))
		{
			return;
		}
		num7 = (double)num4 * (newframePoint.Y - parent.ActualHeight) / num6;
		if (Math.Abs(num6) > 0.0001)
		{
			if (num7 > defMax)
			{
				defMax = num7;
			}
			if (num7 < defMin)
			{
				defMin = num7;
			}
		}
	}

	private void UserControl_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (!DoDragROI(e))
		{
			if (ownerCanvas != null && ownerCanvas is ROIContainer rOIContainer)
			{
				rOIContainer.SelectionService.RoiSelected(DataContext);
			}
			else
			{
				owner.SelectionService.RoiSelected(DataContext);
			}
			Focus();
			if (!isDragging)
			{
				CurPoint = e.GetPosition(mainGrid);
				Doth(this, e);
				owner.DoRoiClick(this, e);
			}
		}
	}

	private void UserControl_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)
	{
		if (!isDragging)
		{
			return;
		}
		double num = 1.0;
		if (owner != null)
		{
			num = owner.Radio;
		}
		isDragging = false;
		TWidth = Width - recWidth * 2.0;
		THeight = Height - recWidth * 2.0;
		double num2 = (double)GetValue(Canvas.LeftProperty);
		double num3 = (double)GetValue(Canvas.TopProperty);
		TAngle = tlt.Angle;
		if (curControl != null)
		{
			curControl.IsPressed = false;
			if (curControl is SquareArea)
			{
				min_x = double.MaxValue;
				max_x = 0.0;
				min_y = double.MaxValue;
				max_y = 0.0;
				PointsDataDrawE(PolygonPoints, IsChangeStructure: true);
			}
			else
			{
				FrameworkElement frameworkElement = curControl as FrameworkElement;
				string name = frameworkElement.Name;
				min_x = double.MaxValue;
				max_x = 0.0;
				min_y = double.MaxValue;
				max_y = 0.0;
				PointsDataDrawE(PolygonPoints, IsChangeStructure: false);
			}
		}
		curControl = null;
		if (IsParamChanged)
		{
			HikPolygonRoiParameter hikPolygonRoiParameter = DataContext as HikPolygonRoiParameter;
			IPolygonROI polygonROI = hikPolygonRoiParameter;
			for (int i = 0; i < hikPolygonRoiParameter._PolygonPoints.Count; i++)
			{
				if (polygonROI.PolygonPoints.Count < i + 1)
				{
					polygonROI.PolygonPoints.Add(new Point(hikPolygonRoiParameter._PolygonPoints[i].x, hikPolygonRoiParameter._PolygonPoints[i].y));
				}
				else if ((double)hikPolygonRoiParameter._PolygonPoints[i].x != polygonROI.PolygonPoints[i].X || (double)hikPolygonRoiParameter._PolygonPoints[i].y != polygonROI.PolygonPoints[i].Y)
				{
					polygonROI.PolygonPoints[i] = new Point(hikPolygonRoiParameter._PolygonPoints[i].x, hikPolygonRoiParameter._PolygonPoints[i].y);
				}
			}
			DoCallBack();
		}
		ReleaseMouseCapture();
	}

}
