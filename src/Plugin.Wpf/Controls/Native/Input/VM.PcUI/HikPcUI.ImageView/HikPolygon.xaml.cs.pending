	public void Dispose()
	{
		DeInit();
		if (parent != null)
		{
			parent.MouseMove -= zparent_MouseMove;
		}
		if (squareAreas != null && owner != null)
		{
			foreach (SquareArea squareArea in squareAreas)
			{
				HikImageView hikImageView = owner;
				hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(squareArea.OnScaleChange));
			}
		}
		if (polygon.ContextMenu != null)
		{
			polygon.ContextMenu.IsOpen = false;
		}
	}

	[DllImport("user32.dll")]
	public static extern int GetDoubleClickTime();

	public static void InitSubstitute(HikImageView view, Point mouseDownPoint)
	{
		doubleClickTime = GetDoubleClickTime();
		Owner = view;
		HikImageView hikImageView = Owner;
		hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
		HikImageView hikImageView2 = Owner;
		hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Combine(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
		HikImageView hikImageView3 = Owner;
		hikImageView3.OnDrawRoi_MouseDownChange = (HikImageView.DrawRoi_MouseDownChange)Delegate.Combine(hikImageView3.OnDrawRoi_MouseDownChange, new HikImageView.DrawRoi_MouseDownChange(OnDrawROISubstitute_MouseDown));
		HikImageView hikImageView4 = Owner;
		hikImageView4.OnDrawRoi_RightMouseUpChange = (HikImageView.DrawRoi_RightMouseUpChange)Delegate.Combine(hikImageView4.OnDrawRoi_RightMouseUpChange, new HikImageView.DrawRoi_RightMouseUpChange(OnDrawROISubstitute_RightMouseUp));
		MouseDownPoint = mouseDownPoint;
		substitute.Points.Clear();
		substitute.Stroke = HikROIBase.SubstituteBrush;
		substitute.StrokeThickness = 1.0 / (Owner.sfr.ScaleX * Owner.ViewScale);
		substitute.Opacity = 1.0;
		if (Owner != null)
		{
			maxPolygonPointNum = Owner.MaxPolygonPointNum;
		}
		substitute.Points.Add(MouseDownPoint);
		substitute.Points.Add(MouseDownPoint);
		PointNum = 1;
		IsMoved = false;
		Owner.AddROIChild(substitute);
	}

	public void Init()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void DeInit()
	{
		if (owner == null)
		{
			return;
		}
		foreach (IArea childControl in childControlList)
		{
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(childControl.OnScaleChange));
		}
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChange));
	}

	public void OnScaleChange(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		double num2 = 1.0 / ((sender as ScaleTransform).ScaleX * num);
		bottomText.FontSize = textSize * num2;
		bd.BorderThickness = new Thickness(num2);
		bd.Margin = new Thickness(0.0 - num2);
		polygon.StrokeThickness = num2;
		if (num < 1.0)
		{
			num = 1.0;
		}
		double num3 = recWidth / ((sender as ScaleTransform).ScaleX * num);
		angle.view.Width = angleWidth / ((sender as ScaleTransform).ScaleX * num);
		angle.view.Height = angleHeight / ((sender as ScaleTransform).ScaleX * num);
		left.view.Width = num3;
		top.view.Height = num3;
		right.view.Width = num3;
		bottom.view.Height = num3;
		top_left.view.Width = num3;
		top_left.view.Height = num3;
		top_right.view.Width = num3;
		top_right.view.Height = num3;
		bottom_left.view.Width = num3;
		bottom_left.view.Height = num3;
		bottom_right.view.Width = num3;
		bottom_right.view.Height = num3;
	}

	public static void OnDrawROISubstitute_MouseMove(object sender, MouseEventArgs e)
	{
		if (Owner != null && Owner.SourceImage.Source != null)
		{
			if (!IsMoved)
			{
				IsMoved = true;
			}
			Point position = e.GetPosition(Owner.SourceImage);
			if (position.X < 0.0)
			{
				position.X = 0.0;
			}
			if (position.Y < 0.0)
			{
				position.Y = 0.0;
			}
			if (position.X > Owner.SourceImage.Width)
			{
				position.X = Owner.SourceImage.Width;
			}
			if (position.Y > Owner.SourceImage.ActualHeight)
			{
				position.Y = Owner.SourceImage.ActualHeight;
			}
			if (PointNum < substitute.Points.Count && PointNum >= 0)
			{
				substitute.Points[PointNum] = position;
			}
		}
	}

	public static void OnDrawROISubstitute_MouseDown(object sender, MouseEventArgs e)
	{
		try
		{
			if (Owner == null || !(e is MouseButtonEventArgs))
			{
				return;
			}
			if ((e as MouseButtonEventArgs).ClickCount < 2)
			{
				obj = new object();
				new Thread(() =>
				{
					try
					{
						object obj = HikPolygon.obj;
						IsDoubleClick = false;
						Thread.Sleep(doubleClickTime);
						if (obj == HikPolygon.obj && Owner != null)
						{
							Owner.Dispatcher.Invoke(() =>
							{
								try
								{
									if (!IsDoubleClick && substitute.Points.Count >= maxPolygonPointNum + 2)
									{
										if (Owner.OnControlAlert != null)
										{
											Owner.OnControlAlert(Owner, AppLocalizationService.GetLang("多边形点数不超过") + " " + maxPolygonPointNum);
											Owner.SourceImage?.CaptureMouse();
										}
										if (substitute.Points.Count > 1)
										{
											PointNum--;
											substitute.Points.RemoveAt(substitute.Points.Count - 2);
										}
									}
								}
								catch (Exception ex3)
								{
									LogHelper.Error("Message:" + ex3.Message + "StackTrace:" + ex3.StackTrace);
								}
							});
						}
					}
					catch (Exception ex2)
					{
						LogHelper.Error("Message:" + ex2.Message + "StackTrace:" + ex2.StackTrace);
					}
				}).Start();
				if (substitute.Points.Count >= maxPolygonPointNum + 3)
				{
					return;
				}
				int num = substitute.Points.Count - 2;
				if (num >= 0)
				{
					Point point = substitute.Points.Last();
					Point point2 = substitute.Points[num];
					if (new Vector(point.X - point2.X, point.Y - point2.Y).Length < 1.0 * Owner.Radio)
					{
						return;
					}
				}
				Point value = default;
				if (PointNum >= 0 && PointNum < substitute.Points.Count)
				{
					value = substitute.Points[PointNum];
				}
				PointNum++;
				substitute.Points.Add(value);
				return;
			}
			IsDoubleClick = true;
			if (PointNum == 2)
			{
				while (substitute.Points.Count > 0)
				{
					substitute.Points.RemoveAt(substitute.Points.Count - 1);
					PointNum--;
				}
				DoFinishSubstitute();
				return;
			}
			while (substitute.Points.Count > maxPolygonPointNum + 1)
			{
				substitute.Points.RemoveAt(substitute.Points.Count - 1);
				PointNum--;
			}
			if (IsMoved && PointNum > 2)
			{
				HikPolygonRoiParameter hikPolygonRoiParameter = Owner.DoGetExtendROIParam(RoiUIType.HikPolygonRoi) as HikPolygonRoiParameter;
				if (hikPolygonRoiParameter == null)
				{
					hikPolygonRoiParameter = new HikPolygonRoiParameter();
				}
				substitute.Points.RemoveAt(substitute.Points.Count - 1);
				foreach (Point point3 in substitute.Points)
				{
					PolygonPoint item = new PolygonPoint
					{
						x = (float)(point3.X / Owner.Radio - 0.5),
						y = (float)(point3.Y / Owner.Radio - 0.5)
					};
					hikPolygonRoiParameter.PolygonPoints.Add(item);
					((IPolygonROI)hikPolygonRoiParameter).PolygonPoints.Add(new Point(point3.X / Owner.Radio - 0.5, point3.Y / Owner.Radio - 0.5));
				}
				hikPolygonRoiParameter.Name = "多边形";
				hikPolygonRoiParameter.Sign = true;
				Owner.RoiList.Add(hikPolygonRoiParameter);
			}
			DoFinishSubstitute();
		}
		catch (Exception ex)
		{
			LogHelper.Error("Message:" + ex.Message + "StackTrace:" + ex.StackTrace);
		}
	}

	public static void OnDrawROISubstitute_RightMouseUp(object sender, MouseEventArgs e)
	{
		if (PointNum > 0)
		{
			PointNum--;
			substitute.Points.RemoveAt(PointNum);
		}
		if (PointNum == 0)
		{
			DoFinishSubstitute();
		}
	}

	public static void DoFinishSubstitute()
	{
		if (Owner != null)
		{
			Owner.IsDrawRoi = false;
			Owner.RemoveROIChild(substitute);
			Owner.SourceImage.ReleaseMouseCapture();
			HikImageView hikImageView = Owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Remove(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(OnScaleChangeSubstitute));
			HikImageView hikImageView2 = Owner;
			hikImageView2.OnDrawRoi_MouseMoveChange = (HikImageView.DrawRoi_MouseMoveChange)Delegate.Remove(hikImageView2.OnDrawRoi_MouseMoveChange, new HikImageView.DrawRoi_MouseMoveChange(OnDrawROISubstitute_MouseMove));
			HikImageView hikImageView3 = Owner;
			hikImageView3.OnDrawRoi_MouseDownChange = (HikImageView.DrawRoi_MouseDownChange)Delegate.Remove(hikImageView3.OnDrawRoi_MouseDownChange, new HikImageView.DrawRoi_MouseDownChange(OnDrawROISubstitute_MouseDown));
			HikImageView hikImageView4 = Owner;
			hikImageView4.OnDrawRoi_RightMouseUpChange = (HikImageView.DrawRoi_RightMouseUpChange)Delegate.Remove(hikImageView4.OnDrawRoi_RightMouseUpChange, new HikImageView.DrawRoi_RightMouseUpChange(OnDrawROISubstitute_RightMouseUp));
			Owner = null;
		}
	}

	public static void OnScaleChangeSubstitute(object sender, object e)
	{
		substitute.StrokeThickness = 1.0 / (sender as ScaleTransform).ScaleX;
	}

	private static void OnPolygonPointsChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikPolygon).PointsDataDrawT((d as HikPolygon).PolygonPoints);
		(d as HikPolygon).OnChangeOnPolygonPoints();
	}

	private void PointsDataDrawE(IList list, bool IsChangeStructure)
	{
		tlt.Angle = 0.0;
		foreach (PolygonPoint item in list)
		{
			if (min_x > ((double)item.x + 0.5) * owner.Radio)
			{
				min_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (max_x < ((double)item.x + 0.5) * owner.Radio)
			{
				max_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (min_y > ((double)item.y + 0.5) * owner.Radio)
			{
				min_y = ((double)item.y + 0.5) * owner.Radio;
			}
			if (max_y < ((double)item.y + 0.5) * owner.Radio)
			{
				max_y = ((double)item.y + 0.5) * owner.Radio;
			}
		}
		OriginPoint = new Point(min_x, min_y);
		for (int i = 0; i < squareAreas.Count; i++)
		{
			PolygonPoint polygonPoint2 = (PolygonPoint)list[i];
			squareAreas[i].X = ((double)polygonPoint2.X + 0.5) * owner.Radio - OriginPoint.X;
			squareAreas[i].Y = ((double)polygonPoint2.Y + 0.5) * owner.Radio - OriginPoint.Y;
			Point value = new Point
			{
				X = ((double)polygonPoint2.x + 0.5) * owner.Radio - min_x,
				Y = ((double)polygonPoint2.y + 0.5) * owner.Radio - min_y
			};
			polygon.Points[i] = value;
			if (IsChangeStructure)
			{
				squareAreas[i].OldRateX = value.X / (max_x - min_x);
				squareAreas[i].OldRateY = value.Y / (max_y - min_y);
			}
		}
		ZWidth = max_x - min_x;
		ZHeight = max_y - min_y;
	}

	private void PointsDataDrawT(IList list)
	{
		tlt.Angle = 0.0;
		polygon.Points.Clear();
		foreach (SquareArea squareArea in squareAreas)
		{
			WokeView.Children.Remove(squareArea);
		}
		squareAreas.Clear();
		PointsDataDraw(list);
	}

	private void PointsDataDraw(IList list)
	{
		if (owner == null)
		{
			return;
		}
		foreach (PolygonPoint item in list)
		{
			if (min_x > ((double)item.x + 0.5) * owner.Radio)
			{
				min_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (max_x < ((double)item.x + 0.5) * owner.Radio)
			{
				max_x = ((double)item.x + 0.5) * owner.Radio;
			}
			if (min_y > ((double)item.y + 0.5) * owner.Radio)
			{
				min_y = ((double)item.y + 0.5) * owner.Radio;
			}
			if (max_y < ((double)item.y + 0.5) * owner.Radio)
			{
				max_y = ((double)item.y + 0.5) * owner.Radio;
			}
		}
		foreach (PolygonPoint item2 in list)
		{
			Point value = new Point
			{
				X = ((double)item2.x + 0.5) * owner.Radio - min_x,
				Y = ((double)item2.y + 0.5) * owner.Radio - min_y
			};
			polygon.Points.Add(value);
			SquareArea squareArea = new SquareArea
			{
				HorizontalAlignment = HorizontalAlignment.Center,
				VerticalAlignment = VerticalAlignment.Center
			};
			squareArea.Width = recWidth;
			squareArea.Height = recWidth;
			squareArea.Opacity = 0.0;
			squareArea.SetBinding(SquareArea.TXProperty, new Binding("X")
			{
				Mode = BindingMode.TwoWay
			});
			squareArea.SetBinding(SquareArea.TYProperty, new Binding("Y")
			{
				Mode = BindingMode.TwoWay
			});
			squareArea.Container = this;
			squareArea.DataContext = item2;
			squareArea.Index = polygon.Points.Count - 1;
			squareArea.OldRateX = value.X / (max_x - min_x);
			squareArea.OldRateY = value.Y / (max_y - min_y);
			HikImageView hikImageView = owner;
			hikImageView.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView.OnScaleChange, new HikImageView.ScaleChanged(squareArea.OnScaleChange));
			if (owner != null)
			{
				squareArea.SetScaleUI(owner.sfr.ScaleX * owner.viewScal);
			}
			else
			{
				squareArea.SetScaleUI(owner.sfr.ScaleX);
			}
			WokeView.Children.Add(squareArea);
			squareAreas.Add(squareArea);
		}
		OriginPoint = new Point(min_x, min_y);
		ZWidth = max_x - min_x;
		ZHeight = max_y - min_y;
	}

	private void OnChangeOnPolygonPoints()
	{
		CollectionChangedEventManager.AddHandler(PolygonPoints, PolygonPoints_CollectionChanged);
	}

	private void PolygonPoints_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		if (e.NewItems == null)
		{
		}
	}

