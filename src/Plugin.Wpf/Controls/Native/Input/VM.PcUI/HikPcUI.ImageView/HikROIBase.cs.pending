using System;
using System.Drawing;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Media;
using SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom;
using Mvvm.Commands;

namespace SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView;

public class HikROIBase : UserControl
{
	public const double MinMoveDistance = 0.0001;

	private static SolidColorBrush brush = new SolidColorBrush((System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString("#0F6AF3"));

	private static SolidColorBrush Backbrush = new SolidColorBrush((System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString("#0F6AF3"))
	{
		Opacity = 0.5
	};

	public static readonly DependencyProperty SignProperty = DependencyProperty.Register("Sign", typeof(bool?), typeof(HikROIBase), new PropertyMetadata(true));

	public static readonly DependencyProperty IsSelectedProperty = DependencyProperty.Register("IsSelected", typeof(bool), typeof(HikROIBase), new PropertyMetadata(false, OnPropertyChangedCallback));

	protected static readonly DependencyProperty ROITypeUIProperty = DependencyProperty.Register("ROITypeUI", typeof(ROITypeUIEnum), typeof(HikROIBase), new PropertyMetadata(ROITypeUIEnum.Cover));

	public static readonly DependencyProperty TIsVisibleProperty = DependencyProperty.Register("TIsVisible", typeof(bool), typeof(HikROIBase), new PropertyMetadata(true, OnIsVisibleChanged));

	public static readonly DependencyProperty LableTextProperty = DependencyProperty.Register("LableText", typeof(string), typeof(HikROIBase), new PropertyMetadata(null));

	private DelegateCommand _CtrlCCommand = null;

	protected bool IsParamChanged { get; set; }

	public HikImageView owner { get; set; }

	public Canvas ownerCanvas { get; set; }

	protected bool isDragging { get; set; }

	public FrameworkElement parent { get; set; }

	public static SolidColorBrush SubstituteBrush => brush;

	public static SolidColorBrush SubstituteBackBrush => Backbrush;

	public bool? Sign
	{
		get
		{
			return (bool?)GetValue(SignProperty);
		}
		set
		{
			SetValue(SignProperty, value);
		}
	}

	public bool IsSelected
	{
		get
		{
			return (bool)GetValue(IsSelectedProperty);
		}
		set
		{
			SetValue(IsSelectedProperty, value);
		}
	}

	protected ROITypeUIEnum ROITypeUI
	{
		get
		{
			return (ROITypeUIEnum)GetValue(ROITypeUIProperty);
		}
		set
		{
			SetValue(ROITypeUIProperty, value);
		}
	}

	public bool TIsVisible
	{
		get
		{
			return (bool)GetValue(TIsVisibleProperty);
		}
		set
		{
			SetValue(TIsVisibleProperty, value);
		}
	}

	public string LableText
	{
		get
		{
			return (string)GetValue(LableTextProperty);
		}
		set
		{
			SetValue(LableTextProperty, value);
		}
	}

	public ICommand CtrlCCommand
	{
		get
		{
			//IL_001c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0026: Expected Obj, but got Unknown
			if (_CtrlCCommand == null)
			{
				_CtrlCCommand = new DelegateCommand((Action)CtrlCCommandCmdExecute);
			}
			return (ICommand)_CtrlCCommand;
		}
	}

	public HikROIBase()
	{
		KeyBinding inputBinding = new KeyBinding(CtrlCCommand, new KeyGesture(Key.C, ModifierKeys.Control, "Ctrl+C"));
		InputBindings.Add(inputBinding);
	}

	private static void OnPropertyChangedCallback(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		HikROIBase hikROIBase = d as HikROIBase;
		if ((bool)e.NewValue)
		{
			hikROIBase.Focus();
		}
	}

	private static void OnIsVisibleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikROIBase).ChangeIsVisible();
	}

	private void ChangeIsVisible()
	{
		if (TIsVisible)
		{
			Visibility = Visibility.Visible;
		}
		else
		{
			Visibility = Visibility.Collapsed;
		}
	}

	protected override void OnPreviewKeyDown(KeyEventArgs e)
	{
		base.OnPreviewKeyDown(e);
		RoiParameter roiParameter = DataContext as RoiParameter;
		if ((ROITypeUI != ROITypeUIEnum.Transparent || (roiParameter != null && roiParameter.Tag != null && roiParameter.Tag.ToString() != CustomROITypeUIEnum.Single)) && e.Key == Key.Delete)
		{
			DeleteSelf();
			e.Handled = true;
		}
	}

	public void DeleteSelf()
	{
		if (owner != null && owner.RoiList != null && owner.RoiList.Contains(DataContext))
		{
			owner.SelectionService.DeleteItem(DataContext as RoiParameter);
			owner.Focus();
		}
		else if (ownerCanvas is ROIContainer && (ownerCanvas as ROIContainer).RoiList != null)
		{
			(ownerCanvas as ROIContainer).SelectionService.DeleteItem(DataContext as RoiParameter);
		}
	}

	public Rectangle GetRotateRectangle(int width, int height, float angle)
	{
		double num = (double)angle * Math.PI / 180.0;
		double num2 = Math.Cos(num);
		double num3 = Math.Sin(num);
		int width2 = (int)Math.Max(Math.Abs((double)width * num2 - (double)height * num3), Math.Abs((double)width * num2 + (double)height * num3));
		int height2 = (int)Math.Max(Math.Abs((double)width * num3 - (double)height * num2), Math.Abs((double)width * num3 + (double)height * num2));
		return new Rectangle(0, 0, width2, height2);
	}

	public Bitmap GetRotateImage(Bitmap sr, int angle)
	{
		Bitmap bitmap = new Bitmap(sr);
		angle %= 360;
		int width = bitmap.Width;
		int height = bitmap.Height;
		Rectangle rotateRectangle = GetRotateRectangle(width, height, angle);
		int width2 = rotateRectangle.Width;
		int height2 = rotateRectangle.Height;
		Bitmap bitmap2 = null;
		Graphics graphics = null;
		try
		{
			bitmap2 = new Bitmap(width2, height2);
			graphics = Graphics.FromImage(bitmap2);
			System.Drawing.Point point = new System.Drawing.Point(width2 / 2, height2 / 2);
			graphics.TranslateTransform(point.X, point.Y);
			graphics.RotateTransform(angle);
			graphics.TranslateTransform(-point.X, -point.Y);
			System.Drawing.Point point2 = new System.Drawing.Point((width2 - width) / 2, (height2 - height) / 2);
			graphics.DrawImage(bitmap, new Rectangle(point2.X, point2.Y, width, height));
			graphics.ResetTransform();
			graphics.Save();
		}
		catch (Exception ex)
		{
			throw ex;
		}
		finally
		{
			graphics?.Dispose();
		}
		return bitmap2;
	}

	public void SetROITypeUI(ROITypeUIEnum ROITypeUI)
	{
		this.ROITypeUI = ROITypeUI;
	}

	public void CtrlCCommandCmdExecute()
	{
		if (owner != null && DataContext is RoiParameter && parent != null)
		{
			object tag = (DataContext as RoiParameter).Tag;
			if (owner.ROITypeUI != ROITypeUIEnum.Transparent || (tag != null && !(tag?.ToString() != CustomROITypeUIEnum.Mul)))
			{
				owner.Past_List.Clear();
				RoiParameter roiParameter = (DataContext as RoiParameter).Clone<RoiParameter>();
				roiParameter.Tag = tag;
				System.Windows.Point position = Mouse.GetPosition(parent);
				owner.Past_List.Add(roiParameter, new System.Windows.Point(position.X / owner.Radio, position.Y / owner.Radio));
				owner.NotifyPropertyChanged("Past_Enable");
			}
		}
	}

	public bool DoDragROI(MouseButtonEventArgs e)
	{
		if (owner != null && owner.DragCopyEanble && (Keyboard.Modifiers & ModifierKeys.Control) == ModifierKeys.Control)
		{
			CommomDragHelper commomDragHelper = new CommomDragHelper(this, parent.Parent as FrameworkElement);
			MouseButtonEventArgs e2 = new MouseButtonEventArgs(e.MouseDevice, e.Timestamp, e.ChangedButton);
			e2.RoutedEvent = Mouse.PreviewMouseDownEvent;
			RaiseEvent(e2);
			isDragging = false;
			commomDragHelper.Dispose();
			return true;
		}
		return false;
	}
}
