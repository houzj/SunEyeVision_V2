using System;
using System.Collections.Generic;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Input;
using System.Windows.Markup;
using System.Windows.Media;
using SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Models;

namespace SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView;

public partial class HikShowCross : UserControl, IComponentConnector
{
	private HikImageView owner;

	private double width = 30.0;

	private double height = 30.0;

	private bool IsAdded = false;

	private double scale = 1.0;

	private List<bool> dragstatus;

	public static readonly DependencyProperty ThickProperty = DependencyProperty.Register("Thick", typeof(double), typeof(HikShowCross), new PropertyMetadata(1.0, OnThicknessChanged));

	public static readonly DependencyProperty PhysicsThickProperty = DependencyProperty.Register("PhysicsThick", typeof(double), typeof(HikShowCross), new PropertyMetadata(1.0, OnPhysicsThickChanged));

	public static readonly DependencyProperty CenterXOffProperty = DependencyProperty.Register("CenterXOff", typeof(double), typeof(HikShowCross), new PropertyMetadata(0.0, OnCenterXOffChanged));

	public static readonly DependencyProperty CenterYOffProperty = DependencyProperty.Register("CenterYOff", typeof(double), typeof(HikShowCross), new PropertyMetadata(0.0, OnCenterYOffChanged));

	public static readonly DependencyProperty FillBrushProperty = DependencyProperty.Register("FillBrush", typeof(Brush), typeof(HikShowCross), new PropertyMetadata(new SolidColorBrush(Colors.Red)));

	public double Thick
	{
		get
		{
			return (double)GetValue(ThickProperty);
		}
		set
		{
			SetValue(ThickProperty, value);
		}
	}

	public double PhysicsThick
	{
		get
		{
			return (double)GetValue(PhysicsThickProperty);
		}
		private set
		{
			SetValue(PhysicsThickProperty, value);
		}
	}

	public double CenterXOff
	{
		get
		{
			return (double)GetValue(CenterXOffProperty);
		}
		set
		{
			SetValue(CenterXOffProperty, value);
		}
	}

	public double CenterYOff
	{
		get
		{
			return (double)GetValue(CenterYOffProperty);
		}
		set
		{
			SetValue(CenterYOffProperty, value);
		}
	}

	public Brush FillBrush
	{
		get
		{
			return (Brush)GetValue(FillBrushProperty);
		}
		set
		{
			SetValue(FillBrushProperty, value);
		}
	}

	private static void OnThicknessChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikShowCross).UpdateCross();
	}

	private static void OnPhysicsThickChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikShowCross).UpdateCross();
	}

	private static void OnCenterXOffChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikShowCross).UpdateCross();
	}

	private static void OnCenterYOffChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as HikShowCross).UpdateCross();
	}

	public HikShowCross()
	{
		InitializeComponent();
		dragstatus = new List<bool>();
		Width = width;
		Height = height;
		SizeChanged += HikShowCross_SizeChanged;
	}

	private void HikShowCross_SizeChanged(object sender, SizeChangedEventArgs e)
	{
		Width = e.NewSize.Width;
		Height = e.NewSize.Height;
		UpdateCross();
	}

	public void RegisterRoi(HikImageView imageView)
	{
		owner = imageView;
		if (owner == null)
		{
			return;
		}
		owner.PrepareRawRoi(RoiUIType.HikShowTool);
		HikImageView hikImageView = owner;
		hikImageView.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Combine(hikImageView.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(owner_OnDrawRoi_MouseUpChange));
		HikImageView hikImageView2 = owner;
		hikImageView2.OnScaleChange = (HikImageView.ScaleChanged)Delegate.Combine(hikImageView2.OnScaleChange, new HikImageView.ScaleChanged(owner_OnScaleChange));
		owner.MouseLeftButtonUp += owner_MouseLeftButtonUp;
		owner.MouseMove += (object s, MouseEventArgs e) =>
		{
			if (e.LeftButton == MouseButtonState.Pressed)
			{
				while (dragstatus.Count > 2)
				{
					dragstatus.RemoveAt(0);
				}
				dragstatus.Add(item: true);
			}
		};
		if (!IsAdded)
		{
			owner.AddChild(this);
			IsAdded = true;
		}
	}

	public void UnRegisterRoi()
	{
		if (owner != null)
		{
			owner.UnPrepareRawRoi();
			HikImageView hikImageView = owner;
			hikImageView.OnDrawRoi_MouseUpChange = (HikImageView.DrawRoi_MouseUpChange)Delegate.Remove(hikImageView.OnDrawRoi_MouseUpChange, new HikImageView.DrawRoi_MouseUpChange(owner_OnDrawRoi_MouseUpChange));
		}
	}

	public void UpdateCross()
	{
		PhysicsThick = Thick / scale;
		if (owner != null)
		{
			double radio = owner.Radio;
			if (owner.SourceImage.Source == null)
			{
				SetValue(Canvas.LeftProperty, (owner.ActualWidth / 2.0 + CenterXOff - Width / 2.0) * radio);
				SetValue(Canvas.TopProperty, (owner.ActualHeight / 2.0 + CenterYOff - Height / 2.0) * radio);
			}
			else
			{
				SetValue(Canvas.LeftProperty, ((double)owner.ImageSourceWidth / 2.0 + CenterXOff) * radio - Width / 2.0);
				SetValue(Canvas.TopProperty, ((double)owner.ImageSourceHeight / 2.0 + CenterYOff) * radio - Height / 2.0);
			}
		}
		else
		{
			SetValue(Canvas.LeftProperty, CenterXOff - Width / 2.0);
			SetValue(Canvas.TopProperty, CenterYOff - Height / 2.0);
		}
	}

	public void BindingModel(HikShowCrossModel model)
	{
		if (model != null)
		{
			BindingHelper.BindingPath("ColorBrush", "FillBrush", model, BindingMode.TwoWay, this);
			BindingHelper.BindingPath("Thickness", "Thick", model, BindingMode.TwoWay, this);
			BindingHelper.BindingPath("Height", "Height", model, BindingMode.TwoWay, this);
			BindingHelper.BindingPath("Width", "Width", model, BindingMode.TwoWay, this);
			BindingHelper.BindingPath("OffsetX", "CenterXOff", model, BindingMode.TwoWay, this);
			BindingHelper.BindingPath("OffsetY", "CenterYOff", model, BindingMode.TwoWay, this);
		}
	}

	private void owner_OnScaleChange(object sender, object Tag)
	{
		double num = 1.0;
		if (Tag is double)
		{
			num = (double)Tag;
		}
		scale = (sender as ScaleTransform).ScaleX * num;
		UpdateCross();
	}

	private void owner_OnDrawRoi_MouseUpChange(object sender, MouseEventArgs e)
	{
		owner.SourceImage.ReleaseMouseCapture();
	}

	private void owner_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)
	{
		dragstatus.Add(item: false);
		while (dragstatus.Count > 2)
		{
			dragstatus.RemoveAt(0);
		}
		if (owner.SourceImage.Source != null && !dragstatus.Contains(item: true))
		{
			double actualWidth = owner.SourceImage.ActualWidth;
			double actualHeight = owner.SourceImage.ActualHeight;
			Point position = e.GetPosition(owner.SourceImage);
			if (position.X < 0.0)
			{
				position.X = 0.0;
			}
			if (position.Y < 0.0)
			{
				position.Y = 0.0;
			}
			if (position.X > owner.SourceImage.ActualWidth)
			{
				position.X = owner.SourceImage.ActualWidth;
			}
			if (position.Y > owner.SourceImage.ActualHeight)
			{
				position.Y = owner.SourceImage.ActualHeight;
			}
			double radio = owner.Radio;
			CenterXOff = (position.X - actualWidth / 2.0) / radio;
			CenterYOff = (position.Y - actualHeight / 2.0) / radio;
		}
	}
}
