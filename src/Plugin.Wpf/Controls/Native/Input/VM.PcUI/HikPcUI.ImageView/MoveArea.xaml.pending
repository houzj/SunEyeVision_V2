<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView.MoveArea" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="UserControl" Width="19" Height="19" xmlns:imageview="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VM.PcUI/imageview/roidictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid HorizontalAlignment="{Binding HorizontalAlignment, ElementName=UserControl}" VerticalAlignment="{Binding VerticalAlignment, ElementName=UserControl}">
    <Canvas Name="view" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Name="cview" StrokeThickness="1" Fill="#00FFFFFF" Stretch="Uniform" Height="{Binding Height, ElementName=view}" Width="{Binding Width, ElementName=view}" MouseDown="view_MouseDown">
        <Path.Data>
          <GeometryGroup>
            <EllipseGeometry RadiusX="6.5" RadiusY="6.5" Center="9.5,9.5" />
            <LineGeometry StartPoint="0,9.5" EndPoint="3,9.5" />
            <LineGeometry StartPoint="16,9.5" EndPoint="19,9.5" />
            <LineGeometry StartPoint="9.5,0" EndPoint="9.5,3" />
            <LineGeometry StartPoint="9.5,16" EndPoint="9.5,19" />
          </GeometryGroup>
        </Path.Data>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Path}">
            <Setter Property="Stroke" Value="{DynamicResource ROIBaseColor}" />
            <Style.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter Property="FrameworkElement.Cursor" Value="SizeAll" />
              </Trigger>
              <DataTrigger Value="true" Binding="{Binding IsPressed, ElementName=UserControl}">
                <Setter Property="Stroke" Value="{DynamicResource ROIMouseOverColor}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Path>
    </Canvas>
  </Grid>
  <UIElement.RenderTransform>
    <RotateTransform x:Name="tlt" />
  </UIElement.RenderTransform>
</UserControl>