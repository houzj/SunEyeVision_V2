<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView.Rubber2" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:imageview="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ImageView">
  <Grid>
    <Border Name="bd" BorderThickness="2" BorderBrush="#FF000000" IsHitTestVisible="False" Visibility="Collapsed">
      <Border.Background>
        <SolidColorBrush Color="White" Opacity="0.5" />
      </Border.Background>
    </Border>
  </Grid>
</UserControl>