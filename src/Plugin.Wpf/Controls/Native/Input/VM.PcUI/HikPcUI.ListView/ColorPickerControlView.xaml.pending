<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ListView.ColorPickerControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:CustomWPFColorPicker="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ListView" xmlns:PCCommon="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom" xmlns:PCControls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" x:Name="myControl" Height="Auto" Width="Auto" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_0:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <PCCommon:NegateConverter x:Key="negateConverter" />
      <PCCommon:Brush2ColorConverter x:Key="brush2ColorConverter" />
      <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#F9F9F9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Name="ColumnDefinition0" />
                  <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Name="RowDefinition0" Height="Auto" />
                  <RowDefinition Name="RowDefinition1" Height="*" />
                </Grid.RowDefinitions>
                <Border BorderThickness="1" BorderBrush="#d1d5da" />
                <Grid Row="0" Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <TabPanel Name="HeaderPanel" Focusable="False" Grid.Column="0" IsItemsHost="True" Margin="10,4,2,0" Grid.Row="0" KeyboardNavigation.TabIndex="1" ZIndex="1" />
                </Grid>
                <Border Name="ContentPanel" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local" Visibility="Visible">
                  <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="TabControl.TabStripPlacement" Value="Bottom">
                  <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="1" />
                  <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                  <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="Auto" />
                  <Setter TargetName="HeaderPanel" Property="Margin" Value="2,0,2,2" />
                </Trigger>
                <Trigger Property="TabControl.TabStripPlacement" Value="Left">
                  <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0" />
                  <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                  <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="Auto" />
                  <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="*" />
                  <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                  <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Margin" Value="2,2,0,2" />
                </Trigger>
                <Trigger Property="TabControl.TabStripPlacement" Value="Right">
                  <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="1" />
                  <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                  <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="*" />
                  <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="Auto" />
                  <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                  <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
                  <Setter TargetName="HeaderPanel" Property="Margin" Value="0,2,2,2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#FF666666" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Grid>
                <Border Name="bd" HorizontalAlignment="Center" VerticalAlignment="Center" Height="28" Width="76" Background="#FFFAFAFC">
                  <ContentPresenter Name="Content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" Focusable="False" />
                </Border>
                <Rectangle Name="line" Height="2" Fill="{DynamicResource Col_Theme}" Visibility="Hidden" VerticalAlignment="Bottom" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="bd" Value="{DynamicResource Col_Theme_Light}" Property="Border.Background" />
                  <Setter Property="FontWeight" Value="Bold" />
                  <Setter Property="Foreground" Value="#FF4D4D4D" />
                  <Setter TargetName="line" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="line" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type PCControls:PopupButton}" TargetType="{x:Type PCControls:PopupButton}">
        <Setter Property="PCControls:PopupButton.ButtonStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ToggleButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="bd" Margin="0,2,0,2" Background="#00FFFFFF" BorderThickness="1,1,1,1" BorderBrush="#CCCCCD">
                      <StackPanel Orientation="Horizontal">
                        <Border Margin="4" Width="24" Background="{Binding Path=CurrentColor}" />
                        <TextBlock FontFamily="{TemplateBinding Control.FontFamily}" FontSize="{TemplateBinding Control.FontSize}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{TemplateBinding Control.Foreground}" Visibility="{Binding TextVisibility}" Text="{Binding Path=CurrentColor, Converter={StaticResource brush2ColorConverter}}" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <PCControls:PopupButton DataContext="{Binding ElementName=myControl}">
      <PCControls:PopupButton.SubContent>
        <DataTemplate>
          <Border BorderThickness="0" BorderBrush="#FFA9A9A9">
            <Grid Background="#FFFFFFFF">
              <TabControl Focusable="False">
                <TabItem Header="{DynamicResource 默认}" Content="{Binding FirstItem, Mode=OneTime}" />
                <TabItem Header="{DynamicResource 更多}" Content="{Binding SecondItem, Mode=OneTime}" />
              </TabControl>
            </Grid>
          </Border>
        </DataTemplate>
      </PCControls:PopupButton.SubContent>
    </PCControls:PopupButton>
  </Grid>
</UserControl>