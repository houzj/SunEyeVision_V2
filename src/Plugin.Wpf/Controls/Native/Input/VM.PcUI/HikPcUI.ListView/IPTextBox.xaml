<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns:nativeNumeric0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.HikPcUI.ListView" x:Class="SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ListView.IPTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ListView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type nativeNumeric0:NumbericTextBox}" TargetType="{x:Type nativeNumeric0:NumbericTextBox}">
        <Style.Setters>
          <Setter Property="MinWidth" Value="14" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type nativeNumeric0:NumbericTextBox}">
                <Border Name="border" CornerRadius="4" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                  <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="TextBoxBase.IsReadOnly" Value="False" />
                      <Condition Property="UIElement.IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="TextBoxBase.IsReadOnly" Value="False" />
                      <Condition Property="UIElement.IsKeyboardFocused" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="UIElement.Opacity" Value="0.56" />
                  </Trigger>
                  <Trigger Property="TextBoxBase.IsReadOnly" Value="True">
                    <Setter TargetName="border" Property="Border.Background" Value="#00FFFFFF" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="nativeNumeric0:NumbericTextBox.MaxValue" Value="255" />
          <Setter Property="nativeNumeric0:NumbericTextBox.MinValue" Value="0" />
          <Setter Property="Foreground" Value="#808080" />
          <Setter Property="nativeNumeric0:NumbericTextBox.Precision" Value="0" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style.Setters>
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Style.Setters>
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0" />
          <Setter Property="DockPanel.Dock" Value="Right" />
          <Setter Property="Text" Value="・" />
          <Setter Property="Foreground">
            <Setter.Value>
              <SolidColorBrush Color="Black" Opacity="0.9" />
            </Setter.Value>
          </Setter>
        </Style.Setters>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UniformGrid Columns="4" GotFocus="TextBox_OnGotFocus">
    <DockPanel Margin="0">
      <TextBlock />
      <nativeNumeric0:NumbericTextBox x:Name="IPPart1" />
    </DockPanel>
    <DockPanel Margin="0">
      <TextBlock />
      <nativeNumeric0:NumbericTextBox x:Name="IPPart2" />
    </DockPanel>
    <DockPanel Margin="0">
      <TextBlock />
      <nativeNumeric0:NumbericTextBox x:Name="IPPart3" />
    </DockPanel>
    <nativeNumeric0:NumbericTextBox x:Name="IPPart4" Margin="0" />
  </UniformGrid>
</UserControl>