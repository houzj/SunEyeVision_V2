using System;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Markup;
using System.Windows.Media;
using VMControls.Interface;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.Front;

/// <summary>
/// Controller.xaml 的交互逻辑
/// </summary>
/// <summary>
/// Controller
/// </summary>
public partial class Controller : ContentControl, IComponentConnector
{
	public bool AutoStrechA
	{
		get
		{
			return PART_Control.AutoStrechA;
		}
		set
		{
			PART_Control.AutoStrechA = value;
		}
	}

	public bool FitSize
	{
		get
		{
			return PART_Control.FitSize;
		}
		set
		{
			PART_Control.FitSize = value;
		}
	}

	public Size Size
	{
		get
		{
			return PART_Control.Size;
		}
		set
		{
			PART_Control.Size = value;
		}
	}

	public Brush ButtonColor
	{
		get
		{
			return PART_Control.ButtonColor;
		}
		set
		{
			PART_Control.ButtonColor = value;
		}
	}

	public Brush IconColor
	{
		get
		{
			return PART_Control.IconColor;
		}
		set
		{
			PART_Control.IconColor = value;
		}
	}

	public object DataSource
	{
		get
		{
			return PART_Control.DataSource;
		}
		set
		{
			if (value is IVMRun dataSource)
			{
				PART_Control.DataSource = dataSource;
				return;
			}
			throw new ArgumentException("DataSource Type Error!");
		}
	}

	public object ControlTypeSource
	{
		get
		{
			return PART_Control.ControlTypeSource;
		}
		set
		{
			if (value != null)
			{
				if (true)
				{
					PART_Control.ControlTypeSource = value;
					return;
				}
			}
			throw new ArgumentException("ControlTypeSource Type Error!");
		}
	}

	public string CellAlign
	{
		get
		{
			return PART_Control.CellAlign;
		}
		set
		{
			PART_Control.CellAlign = value;
		}
	}

	public Controller()
	{
		InitializeComponent();
	}
}
