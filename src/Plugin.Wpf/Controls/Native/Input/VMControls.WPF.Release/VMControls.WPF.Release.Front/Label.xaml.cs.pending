		}
	}

	public object ValueTypeSource
	{
		get
		{
			return PART_Control.ValueTypeSource;
		}
		set
		{
			if (value != null)
			{
				if (true)
				{
					PART_Control.ValueTypeSource = value;
					return;
				}
			}
			throw new ArgumentException("ValueTypeSource Type Error!");
		}
	}

	public object TextDataSource
	{
		get
		{
			return PART_Control.TextDataSource;
		}
		set
		{
			if (value != null)
			{
				if (true)
				{
					PART_Control.TextDataSource = value;
					return;
				}
			}
			throw new ArgumentException("TextDataSource Type Error!");
		}
	}

