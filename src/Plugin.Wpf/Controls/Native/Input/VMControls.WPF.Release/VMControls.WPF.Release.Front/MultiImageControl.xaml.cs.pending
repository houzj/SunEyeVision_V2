	{
		get
		{
			return PART_Control.CrossBrush;
		}
		set
		{
			PART_Control.CrossBrush = value;
		}
	}

	public bool IsNeedLoadOrUnLoad
	{
		get
		{
			return PART_Control.IsNeedLoadOrUnLoad;
		}
		set
		{
			PART_Control.IsNeedLoadOrUnLoad = value;
		}
	}

	public object MultiImageDataSource
	{
		get
		{
			return PART_Control.MultiImageDataSource;
		}
		set
		{
			if (value != null)
			{
				if (true)
				{
					PART_Control.MultiImageDataSource = value;
					return;
				}
			}
			throw new ArgumentException("MultiImageDataSource Type Error!");
		}
	}

	public object NumberOfScreensSource
	{
		get
