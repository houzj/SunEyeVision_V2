			if (value != null)
			{
				if (true)
				{
					PART_Control.NumberOfScreensSource = value;
					return;
				}
			}
			throw new ArgumentException("NumberOfScreensSource Type Error!");
		}
	}

	public string CellAlign
	{
		get
		{
			return PART_Control.CellAlign;
		}
		set
		{
			PART_Control.CellAlign = value;
		}
	}

	public MultiImageControl()
	{
		InitializeComponent();
	}
