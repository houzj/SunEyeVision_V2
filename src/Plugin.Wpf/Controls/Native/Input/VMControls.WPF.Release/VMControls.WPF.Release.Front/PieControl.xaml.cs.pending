using System;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Markup;
using System.Windows.Media;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.Front;

/// <summary>
/// PieControl.xaml 的交互逻辑
/// </summary>
/// <summary>
/// PieControl
/// </summary>
public partial class PieControl : ContentControl, IComponentConnector
{
	public bool FitSize
	{
		get
		{
			return PART_Control.FitSize;
		}
		set
		{
			PART_Control.FitSize = value;
		}
	}

	public Size Size
	{
		get
		{
			return PART_Control.Size;
		}
		set
		{
			PART_Control.Size = value;
		}
	}

	public object BindingPathSource
	{
		get
		{
			return PART_Control.BindingPathSource;
		}
		set
		{
			if (value != null)
			{
				if (true)
				{
					PART_Control.BindingPathSource = value;
					return;
				}
			}
			throw new ArgumentException("BindingPathSource Type Error!");
		}
	}

	public string Title
	{
		get
		{
			return PART_Control.Title;
		}
		set
		{
			PART_Control.Title = value;
		}
	}

	/// <summary>
	/// 标题行颜色
	/// </summary>
	public Brush TitleColor
	{
		get
		{
			return PART_Control.TitleColor;
		}
		set
		{
			PART_Control.TitleColor = value;
		}
	}

	/// <summary>
	/// 标题行文本颜色
	/// </summary>
	public Brush TitleTextColor
	{
		get
		{
			return PART_Control.TitleTextColor;
		}
		set
		{
			PART_Control.TitleTextColor = value;
		}
	}

	/// <summary>
	/// 标题栏显示控制
	/// </summary>
	public bool ShowTitleBar
	{
		get
		{
			return PART_Control.ShowTitleBar;
		}
		set
		{
			PART_Control.ShowTitleBar = value;
		}
	}

	/// <summary>
	/// 背景色
	/// </summary>
	public Brush ControlBackground
	{
		get
		{
			return PART_Control.ControlBackground;
		}
		set
		{
			PART_Control.ControlBackground = value;
		}
	}

	/// <summary>
	/// 参数类型
	/// </summary>
	public object ParamTypeSource
	{
		get
		{
			return PART_Control.ParamTypeSource;
		}
		set
		{
			if (value != null)
			{
				if (true)
				{
					PART_Control.ParamTypeSource = value;
					return;
				}
			}
			throw new ArgumentException("ParamTypeSource Type Error!");
		}
	}

	public bool AutoStrechA
	{
		get
		{
			return PART_Control.AutoStrechA;
		}
		set
		{
			PART_Control.AutoStrechA = value;
		}
	}

	public string CellAlign
	{
		get
		{
			return PART_Control.CellAlign;
		}
		set
		{
			PART_Control.CellAlign = value;
		}
	}

	public PieControl()
	{
		InitializeComponent();
	}
}
