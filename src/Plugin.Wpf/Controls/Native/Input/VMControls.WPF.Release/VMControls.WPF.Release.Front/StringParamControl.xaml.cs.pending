using System.Drawing;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Markup;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.Front;

/// <summary>
/// StringParamControl.xaml 的交互逻辑
/// </summary>
/// <summary>
/// StringParamControl
/// </summary>
public partial class StringParamControl : ContentControl, IComponentConnector
{
	public Font Font
	{
		get
		{
			return PART_Control.Font;
		}
		set
		{
			PART_Control.Font = value;
		}
	}

	public bool FitSize
	{
		get
		{
			return PART_Control.FitSize;
		}
		set
		{
			PART_Control.FitSize = value;
		}
	}

	public System.Windows.Size Size
	{
		get
		{
			return PART_Control.Size;
		}
		set
		{
			PART_Control.Size = value;
		}
	}

	public object TextSource
	{
		get
		{
			return PART_Control.TextSource;
		}
		set
		{
			PART_Control.TextSource = value;
		}
	}

	public string CellAlign
	{
		get
		{
			return PART_Control.CellAlign;
		}
		set
		{
			PART_Control.CellAlign = value;
		}
	}

	public StringParamControl()
	{
		InitializeComponent();
	}

	/// <summary>
	/// 高设为自动
	/// </summary>
	/// <param name="sizeInfo"></param>
	protected override void OnRenderSizeChanged(SizeChangedInfo sizeInfo)
	{
		base.OnRenderSizeChanged(sizeInfo);
		Height = double.NaN;
	}
}
