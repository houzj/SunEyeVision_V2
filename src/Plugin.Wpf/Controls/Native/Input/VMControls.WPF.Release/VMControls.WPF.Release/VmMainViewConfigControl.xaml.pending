<?xml version="1.0" encoding="utf-8"?>
<local:VMWpfUserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.VmMainViewConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release" xmlns:wpf="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF;assembly=SunEyeVision.Plugin.Wpf" x:Name="us">
  <wpf:MainViewControl Name="mainViewControl" IsLockWorkArea="{Binding IsLockWorkArea, ElementName=us}" IsOpenParams="{Binding IsOpenParams, Mode=TwoWay, ElementName=us}" IsShowProgressMask="{Binding IsShowProgressMask, Mode=TwoWay, ElementName=us}" ZoomIndex="{Binding ZoomIndex, ElementName=us, Mode=TwoWay}" IsParamsEditState="{Binding IsParamsEditState, Mode=OneWay, ElementName=us}" />
</local:VMWpfUserControl>