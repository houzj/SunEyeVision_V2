using System.Windows;
using System.Windows.Input;
using System.Windows.Media;
using System.Windows.Shapes;
using Apps.UIHelper.Service;
using SunEyeVision.Plugin.Wpf.Native.Dependencies.VM.Utility;
using SunEyeVision.Plugin.Wpf.Native.Display.VMUtility;
using SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.ExternServer;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.ExternAdorner;

/// <summary>
/// 给模块绘制虚线
/// </summary>
[ExtensionFor(typeof(DiagramItem))]
[ExtensionServer(typeof(MouseDragExtensionServer))]
public class DrawDottedLineForMouseDrag : AdornerProvider
{
	private readonly AdornerPanel adornerPanel;

	private PathFigure figure;

	private UIElement context;

	public DrawDottedLineForMouseDrag()
	{
		adornerPanel = new AdornerPanelAttachToWorkArea();
		Adorners.Add(adornerPanel);
		Path path = new Path
		{
			StrokeThickness = 2.0,
			Stroke = new SolidColorBrush(Color.FromRgb(byte.MaxValue, 167, 15)),
			StrokeDashArray = new DoubleCollection { 5.0, 2.5 },
			StrokeLineJoin = PenLineJoin.Round
		};
		PathGeometry pathGeometry = new PathGeometry();
		figure = new PathFigure();
		pathGeometry.Figures.Add(figure);
		path.Data = pathGeometry;
		adornerPanel.Children.Add(path);
	}

	protected override void OnInitialized()
	{
		context = ExtendedItem.ExtensionDecorator.Services.GetService<IExtensionProvidePanel>() as UIElement;
		context.PreviewMouseMove += Layer_PreviewMouseMove;
		if (ExtendedItem is DiagramItem diagramItem)
		{
			ZoomArea parent = diagramItem.GetParent<ZoomArea>();
			adornerPanel.WorkAreaElement = parent;
			Point point = diagramItem.TranslatePoint(default, parent);
		}
		base.OnInitialized();
	}

	private void Layer_PreviewMouseMove(object sender, MouseEventArgs e)
	{
		figure.Segments.Clear();
		figure.Segments.Add(new PolyLineSegment(new Point[1] { e.GetPosition(adornerPanel.WorkAreaElement) }, isStroked: true));
	}

	protected override void OnRemove()
	{
		context.PreviewMouseMove -= Layer_PreviewMouseMove;
		base.OnRemove();
	}
}
