<?xml version="1.0" encoding="utf-8"?>
<Shape x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.Connection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" AllowDrop="True" DragDrop.Drop="Shape_Drop" DragDrop.DragEnter="Shape_DragEnter" DragDrop.DragLeave="Shape_DragLeave" LostFocus="connectionUserControl_LostFocus" MouseMove="connectionUserControl_MouseMove" MouseLeftButtonUp="connectionUserControl_MouseLeftButtonUp">
  <UIElement.InputBindings>
    <KeyBinding Key="Delete" Command="{Binding DeleteConnectionCommand}" />
  </UIElement.InputBindings>
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="OnInsertItem">
      <UIHelper:ParamsEventCommand Command="{Binding InsertItemCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
</Shape>