	public event PropertyChangedEventHandler PropertyChanged;

	public virtual void OnPropertyChanged(string name)
	{
		PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
	}

	private static void OnProcedureChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		DiagramArea diagramArea = (DiagramArea)d;
		object oldValue = e.OldValue;
		object newValue = e.NewValue;
		if (newValue != null && newValue is VmProcedureDecorator vmProcedureDecorator)
		{
			if (!(vmProcedureDecorator.DecorateSource is IVmProcedure vmProcedure))
			{
				return;
			}
			if (vmProcedure.CalibrationData != null)
			{
				if (vmProcedure.CalibrationData is byte[] data)
				{
					CalibrationGuideData calibrationGuideData = new CalibrationGuideData();
					calibrationGuideData.loadXml(data);
					vmProcedure.CalibrationData = calibrationGuideData;
					calibrationGuideData.Parent = vmProcedure;
				}
				if (vmProcedure.IsBootMode)
				{
					Control guidePageControl = CalibHelper.GetGuidePageControl();
					if (diagramArea.Guide != null && guidePageControl != null && guidePageControl is IGuidePage)
					{
						(guidePageControl as IGuidePage).Owner = diagramArea;
						(guidePageControl as IGuidePage).CurDiagram = vmProcedureDecorator;
						for (int i = 0; i < diagramArea.Guide.Children.Count; i++)
						{
							if (diagramArea.Guide.Children[i] is IDisposable disposable)
							{
								disposable.Dispose();
								IDisposable disposable2 = null;
							}
						}
						diagramArea.Guide.Children.Clear();
						GC.Collect();
						diagramArea.Guide.Children.Add(guidePageControl);
					}
					if (diagramArea.ProcessModeButton != null)
					{
						diagramArea.ProcessModeButton.Visibility = Visibility.Visible;
						Binding binding = new Binding
						{
							Source = guidePageControl,
							Path = new PropertyPath("CanChangeMode"),
							Mode = BindingMode.TwoWay
						};
						diagramArea.ProcessModeButton.SetBinding(UIElement.IsEnabledProperty, binding);
					}
					if (diagramArea.BootModeButton != null)
					{
						diagramArea.BootModeButton.Visibility = Visibility.Collapsed;
					}
					return;
				}
				if (diagramArea.Guide != null)
				{
					for (int j = 0; j < diagramArea.Guide.Children.Count; j++)
					{
						if (diagramArea.Guide.Children[j] is IDisposable disposable3)
						{
							disposable3.Dispose();
							IDisposable disposable4 = null;
						}
					}
					diagramArea.Guide.Children.Clear();
					GC.Collect();
				}
				if (diagramArea.ProcessModeButton != null)
				{
					diagramArea.ProcessModeButton.Visibility = Visibility.Collapsed;
				}
				if (diagramArea.BootModeButton != null)
				{
					diagramArea.BootModeButton.Visibility = Visibility.Visible;
				}
				return;
			}
			if (diagramArea.Guide != null)
			{
				for (int k = 0; k < diagramArea.Guide.Children.Count; k++)
				{
					if (diagramArea.Guide.Children[k] is IDisposable disposable5)
					{
						disposable5.Dispose();
						IDisposable disposable6 = null;
					}
				}
				diagramArea.Guide.Children.Clear();
			}
			if (diagramArea.ProcessModeButton != null)
			{
				diagramArea.ProcessModeButton.Visibility = Visibility.Collapsed;
			}
			if (diagramArea.BootModeButton != null)
			{
				diagramArea.BootModeButton.Visibility = Visibility.Collapsed;
			}
			return;
		}
		if (diagramArea.Guide != null)
		{
			for (int l = 0; l < diagramArea.Guide.Children.Count; l++)
			{
				if (diagramArea.Guide.Children[l] is IDisposable disposable7)
				{
					disposable7.Dispose();
					IDisposable disposable8 = null;
				}
			}
			diagramArea.Guide.Children.Clear();
		}
		if (diagramArea.ProcessModeButton != null)
		{
			diagramArea.ProcessModeButton.Visibility = Visibility.Collapsed;
		}
		if (diagramArea.BootModeButton != null)
		{
			diagramArea.BootModeButton.Visibility = Visibility.Collapsed;
		}
	}

	private static void OnZoomIndexPropertyChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		DiagramArea diagramArea = d as DiagramArea;
		double num = (double)e.OldValue;
		double item = (double)e.NewValue;
		int num2 = StatusBar._ZoomTicks.IndexOf(item);
		if (num2 >= 0 && num2 < StatusBar._ZoomTicks.Count && num2 != diagramArea.statusBar.ZoomIndex)
		{
			diagramArea.statusBar.ZoomIndex = num2;
		}
	}

	private static void OnIsLockWorkAreaChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		DiagramArea ic = d as DiagramArea;
		bool flag = (bool)e.OldValue;
		if ((bool)e.NewValue)
		{
			WindowLockModeTipsView windowLockModeTipsView = new WindowLockModeTipsView();
			windowLockModeTipsView.HorizontalAlignment = HorizontalAlignment.Right;
			windowLockModeTipsView.VerticalAlignment = VerticalAlignment.Top;
			ic.View.Children.Add(windowLockModeTipsView);
		}
		else
		{
			ic.View.Children.OfType<WindowLockModeTipsView>().ToList().ForEach((WindowLockModeTipsView p) =>
			{
				ic.View.Children.Remove(p);
			});
		}
	}

	private void ConfigParamsCommandExecute(object obj)
	{
		VmModuleBaseDecorator obj2 = obj as VmModuleBaseDecorator;
		if (obj2 == null || !obj2.IsForbidden)
		{
			VmModuleBaseDecorator obj3 = obj as VmModuleBaseDecorator;
			if (obj3 != null && obj3.IsLoadFailed == true)
			{
				HikMessageBox.Show(AppLocalizationService.GetLang(((obj as VmModuleBaseDecorator).DecorateSource as IVmModule).ModuleTypeName) + AppLocalizationService.GetLang("Lang_ModuleLoadErr"), MessageButtons.Normal, MessageIcons.Warning);
			}
			else if (obj is VmGroupDecorator)
			{
				ItemDoubleClick?.Invoke(this, new ObjectEventArgs
				{
					Param = obj
				});
			}
			else
			{
				ItemDoubleClick?.Invoke(this, new ObjectEventArgs
				{
					Param = obj
				});
			}
		}
	}

	public override void OnApplyTemplate()
	{
		base.OnApplyTemplate();
		View = Template.FindName("m_DiagramGrid", this) as Grid;
		Guide = Template.FindName("m_GuideGrid", this) as Grid;
		BootModeButton = Template.FindName("btnBootMode", this) as Button;
		ProcessModeButton = Template.FindName("btnProcessMode", this) as Button;
		statusBar = Template.FindName("statusBar", this) as StatusBar;
		UpdateCalibGuide();
	}

	public DiagramArea()
	{
		InitializeComponent();
	}

	/// <summary>
	/// 更新一键标定配置界面
	/// </summary>
	private void UpdateCalibGuide()
	{
		if (!(Procedure is VmProcedureDecorator { DecorateSource: IVmProcedure decorateSource } vmProcedureDecorator))
		{
			return;
		}
		if (decorateSource.CalibrationData != null)
		{
			if (decorateSource.CalibrationData is byte[] data)
			{
				CalibrationGuideData calibrationGuideData = new CalibrationGuideData();
				calibrationGuideData.loadXml(data);
				decorateSource.CalibrationData = calibrationGuideData;
				calibrationGuideData.Parent = decorateSource;
			}
			if (decorateSource.IsBootMode)
			{
				Control guidePageControl = CalibHelper.GetGuidePageControl();
				if (Guide != null && guidePageControl != null && guidePageControl is IGuidePage)
				{
					(guidePageControl as IGuidePage).Owner = this;
					(guidePageControl as IGuidePage).CurDiagram = vmProcedureDecorator;
					for (int i = 0; i < Guide.Children.Count; i++)
					{
						if (Guide.Children[i] is IDisposable disposable)
						{
							disposable.Dispose();
							IDisposable disposable2 = null;
						}
					}
					Guide.Children.Clear();
					GC.Collect();
					Guide.Children.Add(guidePageControl);
				}
				if (ProcessModeButton != null)
				{
					ProcessModeButton.Visibility = Visibility.Visible;
					Binding binding = new Binding
					{
						Source = guidePageControl,
						Path = new PropertyPath("CanChangeMode"),
						Mode = BindingMode.TwoWay
					};
					ProcessModeButton.SetBinding(UIElement.IsEnabledProperty, binding);
				}
				if (BootModeButton != null)
				{
					BootModeButton.Visibility = Visibility.Collapsed;
				}
			}
			else
			{
				if (ProcessModeButton != null)
				{
					ProcessModeButton.Visibility = Visibility.Collapsed;
				}
				if (BootModeButton != null)
				{
					BootModeButton.Visibility = Visibility.Visible;
				}
			}
			return;
		}
		if (Guide != null)
		{
			for (int j = 0; j < Guide.Children.Count; j++)
			{
				if (Guide.Children[j] is IDisposable disposable3)
				{
					disposable3.Dispose();
					IDisposable disposable4 = null;
				}
			}
			Guide.Children.Clear();
		}
		if (ProcessModeButton != null)
		{
			ProcessModeButton.Visibility = Visibility.Collapsed;
		}
		if (BootModeButton != null)
		{
			BootModeButton.Visibility = Visibility.Collapsed;
		}
	}

	private void btnBootMode_Click(object sender, RoutedEventArgs e)
	{
		if (!(Procedure is VmProcedureDecorator { DecorateSource: IVmProcedure decorateSource } vmProcedureDecorator))
		{
			return;
		}
		decorateSource.IsBootMode = true;
		Control guidePageControl = CalibHelper.GetGuidePageControl();
		if (Guide != null && guidePageControl != null && guidePageControl is IGuidePage)
		{
			(guidePageControl as IGuidePage).Owner = this;
			(guidePageControl as IGuidePage).CurDiagram = vmProcedureDecorator;
			for (int i = 0; i < Guide.Children.Count; i++)
			{
				if (Guide.Children[i] is IDisposable disposable)
				{
					disposable.Dispose();
					IDisposable disposable2 = null;
				}
			}
			Guide.Children.Clear();
			GC.Collect();
			Guide.Children.Add(guidePageControl);
		}
		if (BootModeButton != null)
		{
			BootModeButton.Visibility = Visibility.Collapsed;
		}
		if (ProcessModeButton != null)
		{
			ProcessModeButton.Visibility = Visibility.Visible;
			Binding binding = new Binding
			{
				Source = guidePageControl,
				Path = new PropertyPath("CanChangeMode"),
				Mode = BindingMode.TwoWay
			};
			ProcessModeButton.SetBinding(UIElement.IsEnabledProperty, binding);
		}
	}

	private void btnProcessMode_Click(object sender, RoutedEventArgs e)
	{
		if (!(Procedure is VmProcedureDecorator { DecorateSource: IVmProcedure decorateSource }))
		{
			return;
		}
		decorateSource.IsBootMode = false;
		if (Guide != null)
		{
			for (int i = 0; i < Guide.Children.Count; i++)
			{
				if (Guide.Children[i] is IDisposable disposable)
				{
					disposable.Dispose();
					IDisposable disposable2 = null;
				}
			}
			GC.Collect();
			Guide.Children.Clear();
		}
		if (BootModeButton != null)
		{
			BootModeButton.Visibility = Visibility.Visible;
		}
		if (ProcessModeButton != null)
		{
			ProcessModeButton.Visibility = Visibility.Collapsed;
		}
	}
}
