	public static readonly DependencyProperty IsLockWorkAreaProperty = DependencyProperty.Register("IsLockWorkArea", typeof(bool), typeof(DiagramArea), new PropertyMetadata(false, OnIsLockWorkAreaChanged));

	public static readonly DependencyProperty IsOpenParamsProperty = DependencyProperty.Register("IsOpenParams", typeof(bool), typeof(DiagramArea), new PropertyMetadata(false));

	public static readonly DependencyProperty ItemsSourceProperty = DependencyProperty.Register("ItemsSource", typeof(IList), typeof(DiagramArea), new PropertyMetadata(null));

