<?xml version="1.0" encoding="utf-8"?>
<ComboBox x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.DiagramGroupListUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:PControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Controls" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:DataForUI="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.DataForUI" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" x:Name="UserControl" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMUtility.Convert">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <vm_port_1:LeftMarginMultiplierConverter x:Key="lengthConverter" Length="14" />
      <Style x:Key="TreeViewItemFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TreeViewStyle1" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TreeView}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer Name="_tv_scrollviewer_" Background="{TemplateBinding Control.Background}" CanContentScroll="False" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" Style="{StaticResource RecScrollViewer}">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
                  <Setter TargetName="_tv_scrollviewer_" Property="ScrollViewer.CanContentScroll" Value="True" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <local:IndentConverter x:Key="indentConverter" />
      <local:VMDataVisibleConverter x:Key="vmDataVisibleConverter" />
      <Style x:Key="TreeViewItemStyle1" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Padding" Value="1,0,0,0" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource TreeViewItemFocusVisual}" />
        <Setter Property="Visibility" Value="{Binding Converter={StaticResource vmDataVisibleConverter}}" />
        <Setter Property="TreeViewItem.IsExpanded" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TreeViewItem}">
              <Grid Name="gd" Background="#00FFFFFF" MouseLeftButtonDown="Gd_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Name="Back" Background="#00FFFFFF">
                  <Grid Margin="{Binding ElementName=gd, Converter={StaticResource indentConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition MinWidth="19" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Name="Expander" ClickMode="Press" Style="{StaticResource ExpandCollapseToggleStyle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Name="bd" Width="156" Height="30" Grid.Column="1" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True" TextBlock.Foreground="{DynamicResource Col_ProcessBar_Selected_Popup_Foreground}">
                      <ContentPresenter Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                    </Border>
                  </Grid>
                </Grid>
                <Rectangle Name="line" IsHitTestVisible="False" Grid.ColumnSpan="2" SnapsToDevicePixels="False" Height="1" Fill="{DynamicResource Col_Theme}" VerticalAlignment="Bottom" Visibility="Hidden" />
                <ItemsPresenter Name="ItemsHost" Grid.Row="1" />
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="MouseLeftButtonDown">
                    <UIHelper:ParamsEventCommand Command="{Binding SkipToModuleCommand}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="TreeViewItem.IsExpanded" Value="False">
                  <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="ItemsControl.HasItems" Value="False">
                  <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsMouseOver, ElementName=Back}">
                  <Setter TargetName="Back" Property="Panel.Background">
                    <Setter.Value>
                      <SolidColorBrush Color="#FFF2F4F6" Opacity="0.15" />
                    </Setter.Value>
                  </Setter>
                  <Setter TargetName="line" Property="Visibility" Value="Visible" />
                  <Setter TargetName="PART_Header" Property="TextBlock.Foreground" Value="#FFFCFCFA" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate TargetType="{x:Type ComboBox}">
      <Grid>
        <ToggleButton Name="toggle" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ToggleButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                      <Image Name="icon" Stretch="None" Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_tab_downarrow_normal.png" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_tab_downarrow_disable.png" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_tab_downarrow_hover.png" />
                      </Trigger>
                      <Trigger Property="ToggleButton.IsChecked" Value="true">
                        <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_tab_downarrow_click.png" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </FrameworkElement.Style>
        </ToggleButton>
        <Border Margin="0,24,0,0" SnapsToDevicePixels="True">
          <Popup Name="Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Grid>
              <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Col_ProcessBar_Selected_Popup_BorderBrush}" Background="{DynamicResource Col_ProcessBar_Selected_Popup_Background}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="7" Direction="305" Opacity="0.45" ShadowDepth="3" Color="Black" />
                </UIElement.Effect>
              </Border>
              <TreeView Name="PART_View" Style="{StaticResource TreeViewStyle1}" MaxHeight="320" BorderThickness="0" Background="#00FFFFFF" FontSize="14" Foreground="#808080" ItemContainerStyle="{StaticResource TreeViewItemStyle1}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type DataForUI:DecoratorBase}}" DataType="{x:Type DataForUI:DecoratorBase}" ItemsSource="{Binding DecorateChildren}">
                      <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Binding ShowName}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                    </HierarchicalDataTemplate>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </TreeView>
            </Grid>
          </Popup>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
          <Setter TargetName="toggle" Property="Control.Background" Value="#3F85E4" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</ComboBox>