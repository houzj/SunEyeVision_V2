	protected override int VisualChildrenCount => 2;

	private static void OnCommentSourceChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		DiagramPage diagramPage = (DiagramPage)d;
		IEnumerable enumerable = (IEnumerable)e.OldValue;
		IEnumerable enumerable2 = (IEnumerable)e.NewValue;
		if (enumerable != null)
		{
			CollectionChangedEventManager.RemoveHandler(enumerable as INotifyCollectionChanged, diagramPage.CommentSource_CollectionChanged);
			diagramPage.RemoveCommentBoxs(enumerable);
		}
		if (enumerable2 != null)
		{
			CollectionChangedEventManager.AddHandler(enumerable2 as INotifyCollectionChanged, diagramPage.CommentSource_CollectionChanged);
			diagramPage.AddCommentBoxs(enumerable2);
		}
	}

	private void CommentSource_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		switch (e.Action)
		{
		case NotifyCollectionChangedAction.Add:
			AddCommentBoxs(e.NewItems);
			break;
		case NotifyCollectionChangedAction.Remove:
			RemoveCommentBoxs(e.OldItems);
			break;
		}
	}

	private void RemoveCommentBoxs(IEnumerable oldValue)
	{
		if (Child == null)
		{
			return;
		}
		foreach (object item in oldValue)
		{
			CommentBox commentBox = (Child as Panel).Children.OfType<CommentBox>().FirstOrDefault((CommentBox x) => x.Name == (item as VMCommentInfo).Name);
			(Child as Panel).Children.Remove(commentBox);
			commentBox.Dispose();
		}
	}

	protected override void SetCommentBoxShow(bool isVisible)
	{
		if (Child != null)
		{
			(Child as Panel).Children.OfType<CommentBox>()?.ToList().ForEach((CommentBox x) =>
			{
				x.Visibility = ((!isVisible) ? Visibility.Collapsed : Visibility.Visible);
			});
		}
	}

	private void AddCommentBoxs(IEnumerable newValue)
	{
		if (Child == null)
		{
			return;
		}
		foreach (object item in newValue)
		{
			VMCommentInfo vMCommentInfo = item as VMCommentInfo;
			CommentBox commentBox = new CommentBox(vMCommentInfo);
			commentBox.Visibility = ((!IsCommentShowModel) ? Visibility.Collapsed : Visibility.Visible);
			(Child as Panel).Children.Insert(0, commentBox);
			Canvas.SetLeft(commentBox, vMCommentInfo.OriginPoint.X);
			Canvas.SetTop(commentBox, vMCommentInfo.OriginPoint.Y);
			commentBox.UpIndexStatus = vMCommentInfo.ZIndex;
			(commentBox.DataContext as DecoratorBase).DecorateSource = (DataContext as VmModuleBaseDecorator)?.DecorateSource;
			commentBox.SetCommentStatusComplate();
		}
	}

	private void ClearCommentsExecute()
	{
		DialogResult dialogResult = HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ClearComments"), AppLocalizationService.GetLang("Lang_ClearCommentsInfo"), MessageButtons.YesOrNo, MessageIcons.Question);
		if (dialogResult == DialogResult.Yes)
		{
			((DataContext as VmModuleBaseDecorator)?.DecorateSource as IVmModuleSet)?.DeleteCommentSource();
		}
	}

	private void UpCommentsExecute()
	{
		if (Child != null)
		{
			(Child as Panel).Children.OfType<CommentBox>()?.ToList().ForEach((CommentBox x) =>
			{
				x.UpIndexStatus = 1;
			});
		}
	}

	private void DownCommentsExecute()
	{
		if (Child != null)
		{
			(Child as Panel).Children.OfType<CommentBox>()?.ToList().ForEach((CommentBox x) =>
			{
				x.UpIndexStatus = 0;
			});
		}
	}

	public DiagramPage()
	{
		Width = DiagramPageWidth;
		Height = DiagramPageWidth;
		InitializeComponent();
		DataContextChanged += DiagramPage_DataContextChanged;
		AddVisualChild(_adornerLayer);
		SetBinding(ToolBoxItemsSourceProperty, new Binding("ToolSource")
		{
			Source = ViewData
		});
		Loaded += (object s, RoutedEventArgs e) =>
		{
			if (!hasAddedTransformAdorner)
			{
				System.Windows.Documents.AdornerLayer.GetAdornerLayer(this).Add(TransformAdorner);
				hasAddedTransformAdorner = true;
			}
		};
	}

	private void DiagramPage_DataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
	{
		if (DataContext == null)
		{
			return;
		}
		if (!(DataContext is IDecorate))
		{
			IsGlobleMode = DataContext is IVmSolution;
			if (DataContext is IVmSolution)
			{
				DataContext = new VmSolutionDecorator
				{
					DecorateSource = e.NewValue
				};
			}
			else if (e.NewValue is IVMGroup)
			{
				DataContext = new VmGroupDecorator
				{
					DecorateSource = e.NewValue
				};
			}
			else
			{
				DataContext = new VmProcedureDecorator
				{
					DecorateSource = e.NewValue
				};
			}
		}
		else
		{
			IsGlobleMode = (DataContext as IDecorate).DecorateSource is IVmSolution;
		}
	}

	/// <summary> Create or identify the element used to display the given item. </summary>
	protected override DependencyObject GetContainerForItemOverride()
	{
		return new DiagramItem
		{
			HostPanel = hostPanal,
			ConnectionPanel = _adornerLayer,
			ItemDiagramPage = this
		};
	}

	protected override List<DiagramItem> GetItemsByRect(Rect rect)
	{
		ItemsPresenter reference = (Child as Panel).Children.OfType<ItemsPresenter>().First();
		Canvas canvas = VisualTreeHelper.GetChild(reference, 0) as Canvas;
		return (from p in canvas.Children.OfType<DiagramItem>()
			where rect.Contains(new Rect(p.Position, new Vector(p.ActualWidth, p.ActualHeight)))
			select p).ToList();
	}

