<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.HoverPot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" HorizontalAlignment="Left" VerticalAlignment="Top" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base;assembly=SunEyeVision.Plugin.Wpf" MouseLeftButtonDown="UserControl_MouseLeftButtonDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource Col_EditProcess_Selected_Ligature}" />
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="HMouseLeftButtonDown">
      <i:InvokeCommandAction Command="{Binding MouseDownCommand}" CommandParameter="{Binding}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
</UserControl>