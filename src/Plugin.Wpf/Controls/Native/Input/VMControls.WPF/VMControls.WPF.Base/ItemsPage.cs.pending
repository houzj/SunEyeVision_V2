	private void ToolItemGrid_PreviewMouseMove(object sender, MouseEventArgs e)
	{
		try
		{
			PreviewMouseMove -= ToolItemGrid_PreviewMouseMove;
			if (!IsMouseDown)
			{
				return;
			}
			if (e.LeftButton != MouseButtonState.Pressed)
			{
				ToolItemGrid_PreviewMouseUp(sender, null);
				return;
			}
			context = this.GetParent<IExtensionProvidePanel>() as UIElement;
			if (context != null)
			{
				context.CaptureMouse();
				context.PreviewMouseMove += AttachedDiagramItem_PreviewMouseMove;
				context.PreviewMouseLeftButtonUp += ToolItemGrid_PreviewMouseUp;
				adornerPanel = new AdornerPanelAttachToWorkArea();
				adornerPanel.SetAdornedElement(this, null);
				adornerPanel.WorkAreaElement = this.GetParent<ZoomArea>();
				System.Windows.Shapes.Path path = new System.Windows.Shapes.Path
				{
					StrokeThickness = 1.0,
					Stroke = Brushes.LightSlateGray,
					StrokeDashArray = new DoubleCollection { 2.0, 1.0 },
					StrokeLineJoin = PenLineJoin.Round
				};
				PathGeometry pathGeometry = new PathGeometry();
				figure = new PathFigure
				{
					IsClosed = true
				};
				figure.StartPoint = startPoint;
				pathGeometry.Figures.Add(figure);
				path.Data = pathGeometry;
				path.IsHitTestVisible = false;
				adornerPanel.Children.Add(path);
				(context as IExtensionProvidePanel)?.AdornerLayer.Children.Add(adornerPanel);
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message + ex.StackTrace);
		}
	}

	private void AttachedDiagramItem_PreviewMouseMove(object sender, MouseEventArgs e)
	{
		try
		{
			if (figure == null)
			{
				throw new Exception("figure null");
			}
			if (this.GetParent<ZoomArea>() == null)
			{
				throw new Exception("ZoomArea null");
			}
			if (figure.Segments == null)
			{
				throw new Exception("Segments null");
			}
			figure.Segments.Clear();
			Point position = e.GetPosition(this.GetParent<ZoomArea>());
			Point[] points = new Point[3]
			{
				new Point(position.X, startPoint.Y),
				position,
				new Point(startPoint.X, position.Y)
			};
			Console.WriteLine($"点1{position.X},{startPoint.Y},点2{position.X},{position.Y},点3{startPoint.X},{position.Y}");
			figure.Segments.Add(new PolyLineSegment(points, isStroked: true));
		}
		catch (Exception ex)
		{
			if (context != null)
			{
				context.PreviewMouseMove -= AttachedDiagramItem_PreviewMouseMove;
				ToolItemGrid_PreviewMouseUp(null, null);
			}
			LogHelper.Error(ex.Message);
		}
	}
}
