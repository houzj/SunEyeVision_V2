	/// <summary>
	/// 当前被框选的项
	/// </summary>
	public List<DiagramItem> CurBoxOfItems
	{
		get
		{
			return curBoxOfItems;
		}
		set
		{
			if (curBoxOfItems == value)
			{
				return;
			}
			curBoxOfItems = value;
			if (curBoxOfItems != null)
			{
				SetValue(CurBoxOfItemsOfDataProperty, curBoxOfItems.Select((DiagramItem p) => p.DataContext).ToList());
			}
			else
			{
				SetValue(CurBoxOfItemsOfDataProperty, null);
			}
			if (DataContext is VmModuleSetDecorator vmModuleSetDecorator && curBoxOfItems != null)
			{
				bool flag = curBoxOfItems.Any((DiagramItem p) => (p.DataContext as VmModuleBaseDecorator).IsForbidden);
				if (!curBoxOfItems.Any((DiagramItem p) => (p.DataContext as VmModuleBaseDecorator).IsForbidden))
				{
					vmModuleSetDecorator.IsCollapsedEnableItems = true;
					vmModuleSetDecorator.IsCollapsedForbiddenItems = false;
				}
				else if (!curBoxOfItems.Any((DiagramItem p) => !(p.DataContext as VmModuleBaseDecorator).IsForbidden))
				{
					vmModuleSetDecorator.IsCollapsedEnableItems = false;
					vmModuleSetDecorator.IsCollapsedForbiddenItems = true;
				}
				else
				{
					vmModuleSetDecorator.IsCollapsedEnableItems = false;
					vmModuleSetDecorator.IsCollapsedForbiddenItems = false;
				}
			}
		}
	}

