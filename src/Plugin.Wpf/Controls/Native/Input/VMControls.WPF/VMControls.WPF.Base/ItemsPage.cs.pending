	protected override void OnMouseLeftButtonDown(MouseButtonEventArgs e)
	{
		if (!IsLockWorkArea && !IsOpenParams && CodeManager.GetInstance().IsAdmin)
		{
			startPoint = e.GetPosition(this.GetParent<ZoomArea>());
			startPointofPage = e.GetPosition(this);
			IsMouseDown = true;
			PreviewMouseMove += ToolItemGrid_PreviewMouseMove;
			PreviewMouseLeftButtonUp += ToolItemGrid_PreviewMouseUp;
		}
	}

	private static void OnIsShowRectDragPanalChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ItemsPage itemsPage = (ItemsPage)d;
		bool flag = (bool)e.OldValue;
		if (!(bool)e.NewValue)
		{
			itemsPage.CurBoxOfItems = null;
		}
	}

	protected Rect GetBoxRect()
	{
		Rect result = new Rect(new Point(CurBoxOfItems.Min((DiagramItem p) => p.Position.X), CurBoxOfItems.Min((DiagramItem p) => p.Position.Y)), new Point(CurBoxOfItems.Max((DiagramItem p) => p.Position.X + p.ActualWidth), CurBoxOfItems.Max((DiagramItem p) => p.Position.Y + p.ActualHeight)));
		result.Inflate(10.0, 10.0);
		return result;
	}

	private void ToolItemGrid_PreviewMouseUp(object sender, MouseButtonEventArgs e)
	{
		PreviewMouseMove -= ToolItemGrid_PreviewMouseMove;
		PreviewMouseLeftButtonUp -= ToolItemGrid_PreviewMouseUp;
		if (context != null)
		{
			context.PreviewMouseLeftButtonUp -= ToolItemGrid_PreviewMouseUp;
			context.PreviewMouseMove -= AttachedDiagramItem_PreviewMouseMove;
			context.ReleaseMouseCapture();
			int num = 0;
			try
			{
				if (!(context is IExtensionProvidePanel))
				{
					throw new Exception("类型不对");
				}
				if ((context as IExtensionProvidePanel).AdornerLayer == null)
				{
					throw new Exception("没有装饰");
				}
				(context as IExtensionProvidePanel)?.AdornerLayer.Children.Remove(adornerPanel);
				Rect rect = new Rect(startPointofPage, e.GetPosition(this));
				if (IsEditCommentModel)
				{
					if (rect.Width >= CommentBox.MinWidth && rect.Height >= CommentBox.MinHeight)
					{
						AddCommentBox(rect);
					}
					IsEditCommentModel = false;
					return;
				}
				List<DiagramItem> itemsByRect = GetItemsByRect(rect);
				num++;
				if (itemsByRect.Count > 0)
				{
					num++;
					CurBoxOfItems = itemsByRect;
					num++;
					RectDragPanalRect = GetBoxRect();
					num++;
					IsShowRectDragPanal = true;
				}
			}
			catch (Exception ex)
			{
				LogHelper.Error(ex.Message + " " + num);
				throw ex;
			}
		}
		adornerPanel = null;
		figure = null;
		context = null;
		if (IsMouseDown)
		{
			IsMouseDown = false;
		}
	}

	private void AddCommentBox(Rect targetRect)
	{
		VMCommentInfo vMCommentInfo = new VMCommentInfo();
		vMCommentInfo.Width = targetRect.Width;
		vMCommentInfo.Height = targetRect.Height;
		vMCommentInfo.Text = AppLocalizationService.GetLang(CommentBox.CommentDefaultText);
		vMCommentInfo.ZIndex = 0;
		vMCommentInfo.OriginPoint = new Point(targetRect.X, targetRect.Y);
		((DataContext as VmModuleBaseDecorator)?.DecorateSource as IVmModuleSet)?.AddCommentSource(vMCommentInfo);
	}

	private void Box_PreviewMouseDown(object sender, MouseButtonEventArgs e)
	{
		IsMouseDown = true;
		(sender as UIElement).PreviewMouseMove += ItemsPage_PreviewMouseMove;
		e.Handled = true;
	}

	private void ItemsPage_PreviewMouseMove(object sender, MouseEventArgs e)
	{
		(sender as UIElement).PreviewMouseMove -= ItemsPage_PreviewMouseMove;
		if (IsMouseDown && e.LeftButton == MouseButtonState.Pressed)
		{
		}
	}

