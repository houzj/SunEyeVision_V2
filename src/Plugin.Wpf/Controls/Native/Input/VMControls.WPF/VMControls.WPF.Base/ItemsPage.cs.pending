	/// <summary>
	/// 获取需要放置模块的信息
	/// </summary>
	/// <param name="point"></param>
	/// <param name="diagramItems"></param>
	/// <returns></returns>
	protected List<object[]> GetDropItems(Point point, List<DiagramItem> diagramItems, DiagramItem module = null)
	{
		double num = diagramItems.Min((DiagramItem p) => p.Position.X);
		double num2 = diagramItems.Min((DiagramItem p) => p.Position.Y);
		List<object[]> list = new List<object[]>();
		foreach (DiagramItem diagramItem in diagramItems)
		{
			Point point2 = default;
			point.X = Math.Round(point.X / 5.0) * 5.0;
			point.Y = Math.Round(point.Y / 5.0) * 5.0;
			Point point3 = new Point(Math.Min(Math.Max(point.X - point2.X + (diagramItem.Position.X - num), 0.0), (int)(DiagramPage.DiagramPageWidth - diagramItem.ActualWidth)), Math.Min(Math.Max(point.Y - point2.Y + (diagramItem.Position.Y - num2), 0.0), (int)(DiagramPage.DiagramPageWidth - diagramItem.ActualHeight)));
			if (module != null)
			{
				list.Add(new object[3] { diagramItem.DataContext, point3, module.DataContext });
			}
			else
			{
				list.Add(new object[2] { diagramItem.DataContext, point3 });
			}
		}
		return list;
	}

	protected void DoDropItems(List<object[]> res)
	{
		OnDropItems?.Invoke(this, new ObjectEventArgs
		{
			Param = res
		});
	}

	/// <summary>
	/// 可拖动元素或选取的文本放置在目标区域时触发,创建Item并添加到界面
	/// </summary>
	/// <param name="e"></param>
	protected override void OnDrop(DragEventArgs e)
	{
		IDataObject data = e.Data;
		if (data == null)
		{
			return;
		}
		Array array = (Array)data.GetData(DataFormats.FileDrop);
		if (array != null)
		{
			string path = array.GetValue(0).ToString();
			if (File.Exists(path))
			{
				OnLoadSolution?.Invoke(path);
				return;
			}
		}
		if (data.GetData(typeof(Point)) == null)
		{
			return;
		}
		Point point = (Point)data.GetData(typeof(Point));
		if (data.GetData(typeof(HotRegionInfo)) is HotRegionInfo hotRegionInfo && !(hotRegionInfo?.CanHotVisible ?? false))
		{
			return;
		}
		List<DiagramItem> list = data.GetData(typeof(List<DiagramItem>)) as List<DiagramItem>;
		AutoConnect autoConnect = data.GetData(typeof(AutoConnect)) as AutoConnect;
		if (list != null)
		{
			List<object[]> dropItems = GetDropItems(point, list, autoConnect?.SourceItem);
			if (e.Effects == DragDropEffects.Move)
			{
				DoDropItems(dropItems);
			}
			else if (e.KeyStates == DragDropKeyStates.ControlKey && e.AllowedEffects.HasFlag(DragDropEffects.Copy))
			{
				Point point2 = (Point)dropItems.First()[1];
				DiagramEventArgs e2 = new DiagramEventArgs
				{
					Param = dropItems,
					Point = point2
				};
				OnCopyItems?.Invoke(this, e2);
				OnPasteItems?.Invoke(this, e2);
			}
		}
	}

