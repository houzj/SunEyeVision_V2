		IsLockWorkAreaProperty = DependencyProperty.Register("IsLockWorkArea", typeof(bool), typeof(ItemsPage), new PropertyMetadata(false));
		IsEditCommentModelProperty = DependencyProperty.Register("IsEditCommentModel", typeof(bool), typeof(ItemsPage), new PropertyMetadata(false));
		IsCommentShowModelProperty = DependencyProperty.Register("IsCommentShowModel", typeof(bool), typeof(ItemsPage), new PropertyMetadata(false, OnCommentModelChanged));
		IsOpenParamsProperty = DependencyProperty.Register("IsOpenParams", typeof(bool), typeof(ItemsPage), new PropertyMetadata(false));
		SelectedModuleProperty = DependencyProperty.Register("SelectedModule", typeof(object), typeof(ItemsPage), new PropertyMetadata(null, OnSelectedModuleChanged));
		IsShowRectDragPanalProperty = DependencyProperty.Register("IsShowRectDragPanal", typeof(bool), typeof(ItemsPage), new PropertyMetadata(false, OnIsShowRectDragPanalChanged));
		RectDragPanalRectProperty = DependencyProperty.Register("RectDragPanalRect", typeof(Rect), typeof(ItemsPage), new PropertyMetadata(default(Rect)));
		CurBoxOfItemsOfDataProperty = DependencyProperty.Register("CurBoxOfItemsOfData", typeof(IList), typeof(ItemsPage), new PropertyMetadata(null));
		FrameworkElement.DefaultStyleKeyProperty.OverrideMetadata(typeof(ItemsPage), new FrameworkPropertyMetadata(typeof(ItemsPage)));
	}

