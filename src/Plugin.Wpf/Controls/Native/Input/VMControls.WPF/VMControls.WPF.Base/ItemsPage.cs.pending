	protected void PasteMenuItem_Click(object sender, RoutedEventArgs e)
	{
		if (ContextMenu != null)
		{
			Point drawPointByRoughPoint = GetDrawPointByRoughPoint(ptPos);
			DoPaste(drawPointByRoughPoint);
		}
	}

	private void DoPaste(Point point)
	{
		if (OnPasteItems != null)
		{
			DiagramEventArgs e = new DiagramEventArgs
			{
				Point = point
			};
			OnPasteItems(this, e);
		}
	}

	protected void KeyVdown(object sender, KeyEventArgs e)
	{
		if (!IsLockWorkArea)
		{
			base.OnKeyDown(e);
			if ((Keyboard.Modifiers & ModifierKeys.Control) == ModifierKeys.Control && e.Key == Key.V)
			{
				Point point = new Point(0.0, 0.0);
				DoPaste(point);
			}
			if ((Keyboard.Modifiers & ModifierKeys.Control) == ModifierKeys.Control && e.Key == Key.F && DataContext is VmModuleBaseDecorator { IsShowImportGroup: not false })
			{
				SearchOperation();
			}
		}
	}

	/// <summary>
	/// 根据初始点位得到归一化的点位
	/// </summary>
	/// <param name="ptPos">初始点位</param>
	/// <returns>归一化后的点位(Item中心的位置)</returns>
	private Point GetDrawPointByRoughPoint(Point ptPos)
	{
		int num = Math.Max(0, (int)Math.Round(ptPos.X / 5.0) * 5);
		int num2 = Math.Max(0, (int)Math.Round(ptPos.Y / 5.0) * 5);
		return new Point(num, num2);
	}

	protected void SearchModule_Click(object sender, RoutedEventArgs e)
	{
		if (ContextMenu != null)
		{
			SearchOperation();
		}
	}

	private void SearchOperation()
	{
		IList<SearchPathInfo> path = new List<SearchPathInfo>();
		bool? flag = ShowSearchWin(path);
		if (flag.HasValue && flag.Value)
		{
			SearchTargetModule(path);
			path = null;
		}
	}

	private bool? ShowSearchWin(IList<SearchPathInfo> path)
	{
		SearchModuleView searchModuleView = new SearchModuleView(path);
		searchModuleView.Owner = Application.Current?.MainWindow;
		bool? result = searchModuleView.ShowDialog();
		searchModuleView = null;
		return result;
	}

	private void SearchTargetModule(IList<SearchPathInfo> path)
	{
		if (OnSearchModule != null)
		{
			DiagramEventArgs e = new DiagramEventArgs();
			e.Param = path;
			OnSearchModule(this, e);
		}
	}

