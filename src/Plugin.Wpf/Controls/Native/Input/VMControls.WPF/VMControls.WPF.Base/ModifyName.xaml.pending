<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.ModifyName" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" Title="{DynamicResource Lang_Rename}" Height="150" Width="370" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/VM.Controls;component/Styles/ButtonsStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid VerticalAlignment="Center">
    <Grid.RowDefinitions>
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <StackPanel Height="28" Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource Lang_ModuleName}" />
        <Border BorderBrush="#CCCCCD" BorderThickness="1" Margin="20,0,0,0" CornerRadius="2">
          <TextBox Name="ModuleID" BorderThickness="0" Width="100" VerticalContentAlignment="Center" Background="{DynamicResource ListViewComboBoxBackground}" Text="{Binding Name}" />
        </Border>
        <Button Margin="40,0,0,0" Style="{StaticResource BlueButtonStyle}" Width="56" Content="{DynamicResource Confirm}" Click="SearchClick" />
      </StackPanel>
    </Grid>
  </Grid>
</vm_port_0:BaseWindow>