using System;
using System.Collections.Generic;
using System.Windows;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base;

internal class PathFinder
{
	/// <summary>
	/// 钝化程度
	/// </summary>
	private const int dcint = 2;

	/// <summary>
	/// 减少不必要的拐点
	/// </summary>
	/// <param name="linePoints"></param>
	public static void RechargeLinePoints(List<Point> linePoints, List<Rect> allRects)
	{
		List<int> list = new List<int>(new int[linePoints.Count]);
		for (int i = 1; i < linePoints.Count - 1; i++)
		{
			list[i] = GetVectAngle(new Vector(linePoints[i].X - linePoints[i - 1].X, linePoints[i].Y - linePoints[i - 1].Y), new Vector(linePoints[i + 1].X - linePoints[i].X, linePoints[i + 1].Y - linePoints[i].Y));
		}
		bool flag;
		do
		{
			flag = false;
			for (int j = 1; j < linePoints.Count - 1; j++)
			{
				if (IsNeedPointCharge(j, linePoints, allRects, list))
				{
					flag = true;
					if (linePoints[j - 1].X == linePoints[j].X)
					{
						linePoints[j] = new Point(linePoints[j + 1].X, linePoints[j - 1].Y);
					}
					else
					{
						linePoints[j] = new Point(linePoints[j - 1].X, linePoints[j + 1].Y);
					}
					list[j] = ((list[j] <= 0) ? 1 : (-1));
					linePoints.RemoveAt(j + 1);
					linePoints.RemoveAt(j - 1);
					list.RemoveAt(j + 1);
					list.RemoveAt(j - 1);
					break;
				}
			}
		}
		while (flag);
		Passivation(linePoints);
	}

	public static void Passivation(IList<Point> linePoints)
	{
		for (int num = linePoints.Count - 2; num > 0; num--)
		{
			Point point = linePoints[num];
			if (linePoints[num].X == linePoints[num - 1].X)
			{
				int num2 = ((linePoints[num].X > linePoints[num + 1].X) ? (-2) : 2);
				int num3 = ((linePoints[num].Y > linePoints[num - 1].Y) ? (-2) : 2);
				linePoints.RemoveAt(num);
				linePoints.Insert(num, new Point(point.X + (double)num2, point.Y));
				linePoints.Insert(num, new Point(point.X, point.Y + (double)num3));
			}
			else
			{
				int num4 = ((linePoints[num].Y > linePoints[num + 1].Y) ? (-2) : 2);
				int num5 = ((linePoints[num].X > linePoints[num - 1].X) ? (-2) : 2);
				linePoints.RemoveAt(num);
				linePoints.Insert(num, new Point(point.X, point.Y + (double)num4));
				linePoints.Insert(num, new Point(point.X + (double)num5, point.Y));
			}
		}
	}

	/// <summary>
	/// 判断拐点是否需要翻转
	/// </summary>
	/// <param name="i"></param>
	/// <param name="linePoints"></param>
	/// <returns></returns>
	private static bool IsNeedPointCharge(int i, List<Point> linePoints, List<Rect> allRects, List<int> angle)
	{
		if (angle[i - 1] != 0 && angle[i] != 0 && angle[i + 1] != 0 && angle[i - 1] != angle[i] && angle[i + 1] != angle[i])
		{
			return IsPointVisible(linePoints[i - 1], linePoints[i + 1], allRects);
		}
		return false;
	}

	/// <summary>
	/// 计算拐点方向
	/// </summary>
	/// <param name="p1"></param>
	/// <param name="p1"></param>
	/// <returns></returns>
	private static int GetVectAngle(Vector p1, Vector p2)
	{
		double num = Vector.CrossProduct(p1, p2);
		if (num == 0.0)
		{
			return 0;
		}
		return (num > 0.0) ? 1 : (-1);
	}

	/// <summary>
	/// 获取所有拐弯
	/// </summary>
	/// <param name="linePoints"></param>
	/// <returns></returns>
	public static List<Point> GetTurnPoints(List<Point> linePoints)
	{
		if (linePoints.Count < 3)
		{
			return linePoints;
		}
		List<Point> list = new List<Point>();
		List<Point> list2 = new List<Point>(linePoints);
		Point point = list2[0];
		int num = 0;
		for (int i = 1; i < list2.Count; i++)
		{
			if (list2[i] == point)
			{
				linePoints.RemoveAt(i + num);
				num++;
			}
			else
			{
				point = list2[i];
			}
		}
		for (int j = 1; j < linePoints.Count - 1; j++)
		{
			if (GetVectAngle(new Vector(linePoints[j].X - linePoints[j - 1].X, linePoints[j].Y - linePoints[j - 1].Y), new Vector(linePoints[j + 1].X - linePoints[j].X, linePoints[j + 1].Y - linePoints[j].Y)) != 0)
			{
				list.Add(linePoints[j]);
			}
		}
		list.Insert(0, linePoints[0]);
		list.Add(linePoints[linePoints.Count - 1]);
		return list;
	}

	/// <summary>
	/// 优化点集(去除冗余点集)
	/// </summary>
	/// <param name="linePoints"></param>
	/// <param name="rectangles"></param>
	/// <param name="sourceOrientation"></param>
	/// <param name="sinkOrientation"></param>
	/// <returns></returns>
	public static List<Point> OptimizeLinePoints(List<Point> linePoints, List<Rect> rectangles, List<Rect> allRects, ConnectorOrientation sourceOrientation, ConnectorOrientation sinkOrientation)
	{
		List<Point> list = new List<Point>();
		int num = 0;
		for (int i = 0; i < linePoints.Count; i++)
		{
			if (i < num)
			{
				continue;
			}
			for (int num2 = linePoints.Count - 1; num2 > i; num2--)
			{
				if (IsPointVisible(linePoints[i], linePoints[num2], rectangles) && linePoints[i].X != linePoints[num2].X && linePoints[i].Y != linePoints[num2].Y)
				{
					num = num2;
					break;
				}
			}
			list.Add(linePoints[i]);
		}
		for (int j = 0; j < list.Count - 1; j++)
		{
			if (list[j].X == list[j + 1].X || list[j].Y == list[j + 1].Y)
			{
				continue;
			}
			ConnectorOrientation connectorOrientation = ((j != 0) ? GetOrientation(list[j], list[j - 1]) : sourceOrientation);
			ConnectorOrientation connectorOrientation2;
			if (j == list.Count - 2)
			{
				connectorOrientation2 = sinkOrientation;
			}
			else
			{
				Point p = list[j + 1];
				Point p2 = list[j + 2];
				if (p.X != p2.X && p.Y != p2.Y)
				{
					Point point = list[j];
					if (point.X == p.X)
					{
						p = new Point(point.X, p2.Y);
					}
					else
					{
						if (point.Y != p.Y)
						{
							return linePoints;
						}
						p = new Point(p2.X, point.Y);
					}
				}
				connectorOrientation2 = GetOrientation(p, p2);
			}
			if ((connectorOrientation == ConnectorOrientation.Left || connectorOrientation == ConnectorOrientation.Right) && (connectorOrientation2 == ConnectorOrientation.Left || connectorOrientation2 == ConnectorOrientation.Right))
			{
				double x = Math.Min(list[j].X, list[j + 1].X) + (double)((int)Math.Round(Math.Abs(list[j].X - list[j + 1].X) / 10.0) * 5);
				if (IsPointVisible(new Point(x, list[j].Y), list[0], allRects) && IsPointVisible(list[list.Count - 1], new Point(x, list[j + 1].Y), allRects) && IsPointVisible(new Point(x, list[j].Y), new Point(x, list[j + 1].Y), allRects))
				{
					list.Insert(j + 1, new Point(x, list[j].Y));
					list.Insert(j + 2, new Point(x, list[j + 2].Y));
					if (list.Count - 1 > j + 3)
					{
						list.RemoveAt(j + 3);
					}
					return list;
				}
				return linePoints;
			}
			if ((connectorOrientation == ConnectorOrientation.Top || connectorOrientation == ConnectorOrientation.Bottom) && (connectorOrientation2 == ConnectorOrientation.Top || connectorOrientation2 == ConnectorOrientation.Bottom))
			{
				double y = Math.Min(list[j].Y, list[j + 1].Y) + (double)((int)Math.Round(Math.Abs(list[j].Y - list[j + 1].Y) / 10.0) * 5);
				if (IsPointVisible(new Point(list[j].X, y), list[0], allRects) && IsPointVisible(list[list.Count - 1], new Point(list[j + 1].X, y), allRects) && IsPointVisible(new Point(list[j].X, y), new Point(list[j + 1].X, y), allRects))
				{
					list.Insert(j + 1, new Point(list[j].X, y));
					list.Insert(j + 2, new Point(list[j + 2].X, y));
					if (list.Count - 1 > j + 3)
					{
						list.RemoveAt(j + 3);
					}
					return list;
				}
				return linePoints;
			}
			if ((connectorOrientation == ConnectorOrientation.Left || connectorOrientation == ConnectorOrientation.Right) && (connectorOrientation2 == ConnectorOrientation.Top || connectorOrientation2 == ConnectorOrientation.Bottom))
			{
				return linePoints;
			}
			if ((connectorOrientation == ConnectorOrientation.Top || connectorOrientation == ConnectorOrientation.Bottom) && (connectorOrientation2 == ConnectorOrientation.Left || connectorOrientation2 == ConnectorOrientation.Right))
			{
				return linePoints;
			}
		}
		return list;
	}

	private static ConnectorOrientation GetOrientation(Point p1, Point p2)
	{
		if (p1.X == p2.X)
		{
			if (p1.Y >= p2.Y)
			{
				return ConnectorOrientation.Bottom;
			}
			return ConnectorOrientation.Top;
		}
		if (p1.Y == p2.Y)
		{
			if (p1.X >= p2.X)
			{
				return ConnectorOrientation.Right;
			}
			return ConnectorOrientation.Left;
		}
		throw new Exception("Failed to retrieve orientation");
	}

	public static bool IsPointVisible(Point fromPoint, Point targetPoint, List<Rect> rectangles)
	{
		foreach (Rect rectangle in rectangles)
		{
			if (RectangleIntersectsLine(rectangle, fromPoint, targetPoint))
			{
				return false;
			}
		}
		return true;
	}

	private static bool RectangleIntersectsLine(Rect rect, Point startPoint, Point endPoint)
	{
		rect.Inflate(-1.0, -1.0);
		return rect.IntersectsWith(new Rect(startPoint, endPoint));
	}

	public static Point GetNearestNeighborSource(ConnectorOrientation sourceOrientation, Point endPoint, Rect rectSource, out bool flag)
	{
		GetNeighborCorners(sourceOrientation, rectSource, out var n, out var n2);
		if (Distance(n, endPoint) <= Distance(n2, endPoint))
		{
			flag = true;
			return n;
		}
		flag = false;
		return n2;
	}

	private static double Distance(Point p1, Point p2)
	{
		return Point.Subtract(p1, p2).Length;
	}

	private static void GetNeighborCorners(ConnectorOrientation orientation, Rect rect, out Point n1, out Point n2)
	{
		switch (orientation)
		{
		case ConnectorOrientation.Left:
			n1 = rect.TopLeft;
			n2 = rect.BottomLeft;
			break;
		case ConnectorOrientation.Top:
			n1 = rect.TopLeft;
			n2 = rect.TopRight;
			break;
		case ConnectorOrientation.Right:
			n1 = rect.TopRight;
			n2 = rect.BottomRight;
			break;
		case ConnectorOrientation.Bottom:
			n1 = rect.BottomLeft;
			n2 = rect.BottomRight;
			break;
		default:
			throw new Exception("No neighour corners found!");
		}
	}

	public static void GetOppositeCorners(ConnectorOrientation orientation, Rect rect, out Point n1, out Point n2)
	{
		switch (orientation)
		{
		case ConnectorOrientation.Left:
			n1 = rect.TopRight;
			n2 = rect.BottomRight;
			break;
		case ConnectorOrientation.Top:
			n1 = rect.BottomLeft;
			n2 = rect.BottomRight;
			break;
		case ConnectorOrientation.Right:
			n1 = rect.TopLeft;
			n2 = rect.BottomLeft;
			break;
		case ConnectorOrientation.Bottom:
			n1 = rect.TopLeft;
			n2 = rect.TopRight;
			break;
		default:
			throw new Exception("No opposite corners found!");
		}
	}

	public static ConnectorOrientation GetOpositeOrientation(ConnectorOrientation connectorOrientation)
	{
		return connectorOrientation switch
		{
			ConnectorOrientation.Left => ConnectorOrientation.Right, 
			ConnectorOrientation.Top => ConnectorOrientation.Bottom, 
			ConnectorOrientation.Right => ConnectorOrientation.Left, 
			ConnectorOrientation.Bottom => ConnectorOrientation.Top, 
			_ => ConnectorOrientation.Top, 
		};
	}

	/// <summary>
	/// 优化点集(去除冗余点集),只保留拐点
	/// </summary>
	/// <param name="linePoints"></param>
	/// <param name="rectangles"></param>
	/// <param name="sourceOrientation"></param>
	/// <param name="sinkOrientation"></param>
	/// <returns></returns>
	public static void OptimizeLinePoints(List<Point> linePoints)
	{
		for (int i = 0; i < 2; i++)
		{
			List<Point> list = new List<Point>(linePoints);
			List<Point> list2 = new List<Point>(linePoints);
			for (int j = 0; j < list.Count - 1; j++)
			{
				if (list[j].X == list[j + 1].X && list[j].Y == list[j + 1].Y)
				{
					linePoints.Remove(list[j]);
					list2.Remove(list[j]);
				}
			}
			for (int k = 0; k < list2.Count - 2; k++)
			{
				if (list2[k].X == list2[k + 1].X && list2[k + 1].X == list2[k + 2].X)
				{
					linePoints.Remove(list2[k + 1]);
				}
				else if (list2[k].Y == list2[k + 1].Y && list2[k + 1].Y == list2[k + 2].Y)
				{
					linePoints.Remove(list2[k + 1]);
				}
			}
		}
	}

	/// <summary>
	/// 优化点集(去除冗余点集)
	/// </summary>
	/// <param name="linePoints"></param>
	/// <param name="rectangles"></param>
	/// <param name="sourceOrientation"></param>
	/// <param name="sinkOrientation"></param>
	/// <returns></returns>
	public static List<Point> OptimizeLinePoints2(List<Point> linePoints, List<Rect> rectangles, ConnectorOrientation sourceOrientation, ConnectorOrientation sinkOrientation)
	{
		List<Point> list = new List<Point>();
		int num = 0;
		for (int i = 0; i < linePoints.Count; i++)
		{
			if (i < num)
			{
				continue;
			}
			for (int num2 = linePoints.Count - 1; num2 > i; num2--)
			{
				if (IsPointVisible(linePoints[i], linePoints[num2], rectangles))
				{
					num = num2;
					break;
				}
			}
			list.Add(linePoints[i]);
		}
		for (int j = 0; j < list.Count - 1; j++)
		{
			if (list[j].X == list[j + 1].X || list[j].Y == list[j + 1].Y)
			{
				continue;
			}
			ConnectorOrientation connectorOrientation = ((j != 0) ? GetOrientation(list[j], list[j - 1]) : sourceOrientation);
			ConnectorOrientation connectorOrientation2 = ((j != list.Count - 2) ? GetOrientation(list[j + 1], list[j + 2]) : sinkOrientation);
			if ((connectorOrientation == ConnectorOrientation.Left || connectorOrientation == ConnectorOrientation.Right) && (connectorOrientation2 == ConnectorOrientation.Left || connectorOrientation2 == ConnectorOrientation.Right))
			{
				double x = Math.Min(list[j].X, list[j + 1].X) + Math.Abs(list[j].X - list[j + 1].X) / 2.0;
				list.Insert(j + 1, new Point(x, list[j].Y));
				list.Insert(j + 2, new Point(x, list[j + 2].Y));
				if (list.Count - 1 > j + 3)
				{
					list.RemoveAt(j + 3);
				}
				return list;
			}
			if ((connectorOrientation == ConnectorOrientation.Top || connectorOrientation == ConnectorOrientation.Bottom) && (connectorOrientation2 == ConnectorOrientation.Top || connectorOrientation2 == ConnectorOrientation.Bottom))
			{
				double y = Math.Min(list[j].Y, list[j + 1].Y) + Math.Abs(list[j].Y - list[j + 1].Y) / 2.0;
				list.Insert(j + 1, new Point(list[j].X, y));
				list.Insert(j + 2, new Point(list[j + 2].X, y));
				if (list.Count - 1 > j + 3)
				{
					list.RemoveAt(j + 3);
				}
				return list;
			}
			if ((connectorOrientation == ConnectorOrientation.Left || connectorOrientation == ConnectorOrientation.Right) && (connectorOrientation2 == ConnectorOrientation.Top || connectorOrientation2 == ConnectorOrientation.Bottom))
			{
				list.Insert(j + 1, new Point(list[j + 1].X, list[j].Y));
				return list;
			}
			if ((connectorOrientation == ConnectorOrientation.Top || connectorOrientation == ConnectorOrientation.Bottom) && (connectorOrientation2 == ConnectorOrientation.Left || connectorOrientation2 == ConnectorOrientation.Right))
			{
				list.Insert(j + 1, new Point(list[j].X, list[j + 1].Y));
				return list;
			}
		}
		return list;
	}

	/// <summary>
	/// 连线调用的方法
	/// </summary>
	/// <param name="source"></param>
	/// <param name="sinkPoint"></param>
	/// <param name="preferredOrientation"></param>
	/// <returns></returns>
	public static List<Point> GetConnectionLine(DiagramItem sourceItem, Point sinkPoint, int sourceIndex)
	{
		List<Point> list = new List<Point>();
		Point item = sourceItem.AnchorPoint(sourceIndex);
		double num = 5.0;
		Rect rectWithMargin = sourceItem.GetRectWithMargin(num);
		Point offsetPoint = sourceItem.GetOffsetPoint(sourceIndex, num);
		list.Add(offsetPoint);
		Point fromPoint = offsetPoint;
		if (!rectWithMargin.Contains(sinkPoint))
		{
			if (IsPointVisible(fromPoint, sinkPoint, new List<Rect> { rectWithMargin }))
			{
				list.Add(sinkPoint);
			}
			else
			{
				Point nearestNeighborSource = GetNearestNeighborSource(DiagramItem.GetOrientation(sourceIndex), sinkPoint, rectWithMargin, out var flag);
				list.Add(nearestNeighborSource);
				fromPoint = nearestNeighborSource;
				if (IsPointVisible(fromPoint, sinkPoint, new List<Rect> { rectWithMargin }))
				{
					list.Add(sinkPoint);
				}
				else
				{
					GetOppositeCorners(DiagramItem.GetOrientation(sourceIndex), rectWithMargin, out var n, out var n2);
					if (flag)
					{
						list.Add(n);
					}
					else
					{
						list.Add(n2);
					}
					list.Add(sinkPoint);
				}
			}
		}
		else
		{
			list.Add(sinkPoint);
		}
		ConnectorOrientation connectorOrientation = ConnectorOrientation.Left;
		list = ((connectorOrientation == ConnectorOrientation.None) ? OptimizeLinePoints2(list, new List<Rect> { rectWithMargin }, DiagramItem.GetOrientation(sourceIndex), GetOpositeOrientation(DiagramItem.GetOrientation(sourceIndex))) : OptimizeLinePoints2(list, new List<Rect> { rectWithMargin }, DiagramItem.GetOrientation(sourceIndex), connectorOrientation));
		list.Insert(0, item);
		list.Add(sinkPoint);
		OptimizeLinePoints(list);
		return list;
	}
}
