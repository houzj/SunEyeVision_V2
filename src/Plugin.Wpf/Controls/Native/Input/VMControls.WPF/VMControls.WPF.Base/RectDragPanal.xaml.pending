<?xml version="1.0" encoding="utf-8"?>
<local:RectDragPanalBase x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.RectDragPanal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" KeyDown="RectDragPanalBase_KeyDown" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="MenuItemEnableStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsCollapsedEnableItems}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Value="False" Binding="{Binding IsShowImportGroup}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="MenuItemFiddenStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsCollapsedForbiddenItems}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Value="False" Binding="{Binding IsShowImportGroup}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.ContextMenu>
    <vm_port_0:HikContextMenu>
      <MenuItem Header="{DynamicResource Lang_Delet}" Click="menuDeleteClick" />
      <MenuItem Header="{DynamicResource Lang_Copy}" Click="menuCopyClick" />
      <MenuItem Header="{DynamicResource Lang_Forbidden}" Style="{StaticResource MenuItemFiddenStyle}" Click="menuForbiddenClick" />
      <MenuItem Header="{DynamicResource Lang_Enabled}" Style="{StaticResource MenuItemEnableStyle}" Click="menuActivateClick" />
      <Separator Margin="4,0" />
      <MenuItem Header="{DynamicResource Lang_Align}">
        <MenuItem Name="LeftAlg" Click="menuAlgClick">
          <HeaderedItemsControl.Header>
            <StackPanel Orientation="Horizontal">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_align_left_normal.png" />
              <TextBlock Text="{DynamicResource Lang_LeftAlg}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedItemsControl.Header>
        </MenuItem>
        <MenuItem Name="HorizonCenterAlg" Click="menuAlgClick">
          <HeaderedItemsControl.Header>
            <StackPanel Orientation="Horizontal">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_align_center_normal.png" />
              <TextBlock Text="{DynamicResource Lang_HorizonCenterAlg}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedItemsControl.Header>
        </MenuItem>
        <MenuItem Name="RightAlg" Click="menuAlgClick">
          <HeaderedItemsControl.Header>
            <StackPanel Orientation="Horizontal">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_align_right_normal.png" />
              <TextBlock Text="{DynamicResource Lang_RightAlg}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedItemsControl.Header>
        </MenuItem>
        <Separator Margin="4,0" />
        <MenuItem Name="TopAlg" Click="menuAlgClick">
          <HeaderedItemsControl.Header>
            <StackPanel Orientation="Horizontal">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_align_top_normal.png" />
              <TextBlock Text="{DynamicResource Lang_TopAlg}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedItemsControl.Header>
        </MenuItem>
        <MenuItem Name="VerticalCenterAlg" Click="menuAlgClick">
          <HeaderedItemsControl.Header>
            <StackPanel Orientation="Horizontal">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_align_middle_normal.png" />
              <TextBlock Text="{DynamicResource Lang_VerticalCenterAlg}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedItemsControl.Header>
        </MenuItem>
        <MenuItem Name="BtmAlg" Click="menuAlgClick">
          <HeaderedItemsControl.Header>
            <StackPanel Orientation="Horizontal">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_align_bottom_normal.png" />
              <TextBlock Text="{DynamicResource Lang_BtmAlg}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedItemsControl.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{DynamicResource Lang_Layout}">
        <MenuItem Name="HorLay" Header="{DynamicResource Lang_HorLay}" Click="menuLayoutClick" />
        <MenuItem Name="VerLay" Header="{DynamicResource Lang_VerLay}" Click="menuLayoutClick" />
      </MenuItem>
    </vm_port_0:HikContextMenu>
  </FrameworkElement.ContextMenu>
  <Control.Template>
    <ControlTemplate>
      <Grid Background="#00FFFFFF" />
    </ControlTemplate>
  </Control.Template>
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="OnDeleteItems">
      <UIHelper:ParamsEventCommand Command="{Binding DeleteItemsCommand}" CommandParameter="{Binding CurBoxOfItemsOfData, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}" />
    </i:EventTrigger>
    <i:EventTrigger EventName="OnCopyItems">
      <UIHelper:ParamsEventCommand Command="{Binding CopyItemsCommand}" CommandParameter="{Binding CurBoxOfItemsOfData, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}" />
    </i:EventTrigger>
    <i:EventTrigger EventName="OnForbiddenItems">
      <UIHelper:ParamsEventCommand Command="{Binding ForbiddenItemsCommand}" CommandParameter="{Binding CurBoxOfItemsOfData, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}" />
    </i:EventTrigger>
    <i:EventTrigger EventName="OnActivateItems">
      <UIHelper:ParamsEventCommand Command="{Binding ActivateItemsCommand}" CommandParameter="{Binding CurBoxOfItemsOfData, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
</local:RectDragPanalBase>