	public static readonly DependencyProperty IsDisplayAllProperty;

	public static readonly DependencyProperty JumpCommandProperty;

	public static readonly DependencyProperty SelectedProIDProperty;

	public static readonly DependencyProperty IsSearchShowProperty;

	public static readonly DependencyProperty IsDisposeNotifyProperty;

	private DelegateCommand<object> _SelectionChangedCommand = null;

	private List<FullMoudleInfo> allFullModuleList;

