<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.StatusBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:dataForUI="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.DataForUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="ProcessTemplate">
        <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource Col_ProcessTimeConsuming_Foreground}">
          <Button Click="ShowTimeClick">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <StackPanel Orientation="Horizontal" Background="#00FFFFFF" TextBlock.Foreground="{DynamicResource Col_ProcessTimeConsuming_Foreground}">
                        <TextBlock Text="{DynamicResource Lang_Process}" Margin="0,0,2,0" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding ProcessTime, Mode=OneWay, StringFormat=N2}" />
                        <TextBlock Text="ms" VerticalAlignment="Center" />
                        <Image Name="icon" Stretch="None" Margin="5,0,0,0" Source="/Apps.Style;component/Resources/ic_bottom bar_flow view_normal.png" />
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_bottom bar_flow view_click.png" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource Col_ProcessTimeConsuming_Foreground}" Margin="20,0" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="TimeTemplate">
        <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource Col_ProcessTimeConsuming_Foreground}">
          <ContentPresenter Name="cp" ContentTemplate="{StaticResource ProcessTemplate}" Content="{Binding SelectedItemSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:StatusBar}}" />
          <TextBlock Margin="0,0,2,0" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Lang_Modu}" Margin="0,0,2,0" VerticalAlignment="Center" />
          <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=SelectedItemSource.ModuleTime, Mode=OneWay, StringFormat=N2, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:StatusBar}}" />
          <TextBlock Text="ms" VerticalAlignment="Center" />
          <Rectangle Width="1" Fill="{DynamicResource Col_ProcessTimeConsuming_Foreground}" Margin="20,0" />
          <TextBlock Text="{DynamicResource 算法}" VerticalAlignment="Center" />
          <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=SelectedItemSource.AlgorithmTime, Mode=OneWay, StringFormat=N2, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:StatusBar}}" />
          <TextBlock Text="ms" VerticalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding SelectedItemSource.Root, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:StatusBar}}" Value="{x:Null}">
            <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{x:Null}" />
            <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{x:Null}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="ProcessTimeTemplate">
        <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource Col_ProcessTimeConsuming_Foreground}">
          <ContentPresenter Name="cp" ContentTemplate="{StaticResource ProcessTemplate}" Content="{Binding SelectedItemSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:StatusBar}}" />
        </StackPanel>
      </DataTemplate>
      <Style x:Key="HorizontalSliderDownThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#FF808080" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Canvas SnapsToDevicePixels="True">
                <UIElement.RenderTransform>
                  <TranslateTransform X="0" Y="0" />
                </UIElement.RenderTransform>
                <Border BorderBrush="{DynamicResource Col_ProcessTimeConsuming_Thumb_BorderBrush}" BorderThickness="1" Background="{DynamicResource Col_ProcessTimeConsuming_Thumb_Fill}" Width="6" Height="12" />
              </Canvas>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SliderRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Rectangle Fill="#00FFFFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SliderStyle1" TargetType="{x:Type Slider}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Border SnapsToDevicePixels="True">
                <Grid>
                  <Rectangle Height="10" Width="2" HorizontalAlignment="Center" Fill="{DynamicResource Col_ProcessTimeConsuming_Thumb_Background}" />
                  <Border Name="TrackBackground" BorderBrush="#00FFFFFF" BorderThickness="0" Background="{DynamicResource Col_ProcessTimeConsuming_Thumb_Background}" CornerRadius="0" Height="2.0" />
                  <Track Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{DynamicResource StatusBarButtonBg}" BorderBrush="{DynamicResource StatusBarButtonBB}" Foreground="{DynamicResource StatusBarButtonFg}" Visibility="Visible" BorderThickness="1" Cursor="Arrow" ClipToBounds="False" Style="{StaticResource SliderRepeatButtonStyle}" OpacityMask="{x:Null}" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static Slider.IncreaseLarge}" ClickMode="Press" Opacity="1" Visibility="Visible" Style="{StaticResource SliderRepeatButtonStyle}" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Name="Thumb" Visibility="Visible" Opacity="1" BorderThickness="2" Style="{StaticResource HorizontalSliderDownThumbStyle}" BorderBrush="{x:Null}" Foreground="{x:Null}" OpacityMask="{x:Null}" Background="{x:Null}" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                    </Track.Thumb>
                  </Track>
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <StatusBar Name="m_StatusBar" BorderThickness="0,1,0,0" Background="{DynamicResource Col_ProcessTimeConsuming_Background}" BorderBrush="{DynamicResource Col_ProcessTimeConsuming_BorderBorush}" Foreground="{DynamicResource Col_ProcessTimeConsuming_Title}" FontFamily="Microsoft YaHei" FontSize="13">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type StatusBarItem}" TargetType="{x:Type StatusBarItem}">
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <StatusBarItem HorizontalAlignment="Left">
          <Image Name="PART_StatusBg" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,-1" />
        </StatusBarItem>
        <StatusBarItem HorizontalAlignment="Left">
          <TextBlock Name="PART_StatusInfo" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,-1" Text="{Binding Path=StatusInfo, RelativeSource={RelativeSource TemplatedParent}}" />
        </StatusBarItem>
        <StatusBarItem HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal">
            <ContentControl>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentControl}">
                  <Setter Property="Content" Value="{x:Null}" />
                  <Setter Property="ContentTemplate" Value="{x:Null}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsModule, RelativeSource={RelativeSource AncestorType=local:StatusBar}}">
                      <Setter Property="ContentTemplate" Value="{StaticResource TimeTemplate}" />
                      <Setter Property="Content" Value="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=local:StatusBar}}" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding IsProcedure, RelativeSource={RelativeSource AncestorType=local:StatusBar}}">
                      <Setter Property="ContentTemplate" Value="{StaticResource ProcessTimeTemplate}" />
                      <Setter Property="Content" Value="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=local:StatusBar}}" />
                    </DataTrigger>
                    <DataTrigger Value="false" Binding="{Binding Path=SelectedItemSource.(VMInterface:IVMRun.RunEnable), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:StatusBar}}">
                      <Setter Property="Content" Value="{x:Null}" />
                      <Setter Property="ContentTemplate" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentControl>
            <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource Col_ProcessTimeConsuming_Foreground}" Margin="0,0,5,0">
              <Slider Style="{DynamicResource SliderStyle1}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" Value="{Binding ZoomIndex, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Maximum="{Binding ZoomTicksCount, RelativeSource={RelativeSource TemplatedParent}}" />
              <Image Source="/Apps.Style;component/Resources/ic_放大镜.png" Stretch="None" RenderOptions.EdgeMode="Aliased" Margin="2,0,1,0" />
              <Button VerticalAlignment="Center" Background="#00FFFFFF" Width="48" Cursor="Hand" Click="ZoomCallBackClick">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" BorderBrush="#00FFFFFF" BorderThickness="1" TextBlock.Foreground="{DynamicResource Col_ProcessTimeConsuming_Foreground}">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" Text="{Binding ZoomValueE, Mode=OneWay, StringFormat='{}{0:####}%', RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type local:StatusBar}}}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Value="{DynamicResource Col_ProcessTimeConsuming_Background}" Property="Border.Background" />
                              <Setter TargetName="bd" Value="{DynamicResource Col_ProcessTimeConsuming_BorderBorush}" Property="Border.BorderBrush" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </FrameworkElement.Style>
              </Button>
            </StackPanel>
          </StackPanel>
        </StatusBarItem>
      </StatusBar>
      <ControlTemplate.Triggers>
        <DataTrigger Value="Ready" Binding="{Binding Path=StatusSymbol, RelativeSource={RelativeSource Self}}">
          <Setter TargetName="PART_StatusBg" Property="Image.Source" Value="/Apps.Style;component/Resources/bottombar_run.png" />
          <Setter TargetName="PART_StatusInfo" Value="{DynamicResource 组件配置完成}" Property="TextBlock.Text" />
        </DataTrigger>
        <DataTrigger Value="NOItem" Binding="{Binding Path=StatusSymbol, RelativeSource={RelativeSource Self}}">
          <Setter TargetName="PART_StatusBg" Property="Image.Source" Value="/Apps.Style;component/Resources/bottombar_config.png" />
          <Setter TargetName="PART_StatusInfo" Value="{DynamicResource 等待添加组件}" Property="TextBlock.Text" />
        </DataTrigger>
        <DataTrigger Value="WaitConfig" Binding="{Binding Path=StatusSymbol, RelativeSource={RelativeSource Self}}">
          <Setter TargetName="PART_StatusBg" Property="Image.Source" Value="/Apps.Style;component/Resources/bottombar_abnormal.png" />
          <Setter TargetName="m_StatusBar" Value="{DynamicResource StatusBarFg}" Property="Control.Foreground" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Control>