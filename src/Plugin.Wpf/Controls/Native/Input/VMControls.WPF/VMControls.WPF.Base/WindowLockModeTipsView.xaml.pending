<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base.WindowLockModeTipsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Border Width="Auto" MinWidth="134" Height="40" Margin="0 60 16 0" BorderThickness="1" SnapsToDevicePixels="True" BorderBrush="{DynamicResource Col_Theme}" CornerRadius="2" Background="#504B47">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Name="icon" Stretch="None" Source="/Apps.Style;component/Resources/ic_lock.png" />
          <TextBlock Text="{DynamicResource Lang_LockModeTips}" VerticalAlignment="Center" FontFamily="Microsoft YaHei" Foreground="#EBEBEB" FontSize="14" Margin="5 0" />
        </StackPanel>
      </Border>
    </ControlTemplate>
  </Control.Template>
</Control>