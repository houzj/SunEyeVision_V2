	/// <summary>
	/// 结束符序号0-\r,1-\n,2-\r\n
	/// </summary>
	public int EndIndex
	{
		get
		{
			return _EndIndex;
		}
		set
		{
			if (_EndIndex != value)
			{
				_EndIndex = value;
				OnPropertyChanged("EndIndex");
			}
		}
	}

