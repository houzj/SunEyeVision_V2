	/// 当前引导步骤
	/// </summary>
	public int GuideStep
	{
		get
		{
			return _GuideStep;
		}
		set
		{
			if (_GuideStep != value)
			{
				_GuideStep = value;
				OnPropertyChanged("GuideStep");
			}
		}
	}

	/// <summary>
	/// 是否需要开启所有模块结果回调
	/// </summary>
	public bool NeedGetAllModulesCallBack
	{
		get
		{
			return _NeedGetAllModulesCallBack;
		}
		set
		{
			if (_NeedGetAllModulesCallBack != value)
			{
				_NeedGetAllModulesCallBack = value;
				OnPropertyChanged("NeedGetAllModulesCallBack");
				if (Parent != null && Parent is IVmProcedure vmProcedure)
				{
					vmProcedure.NeedGetAllModulesCallBack = _NeedGetAllModulesCallBack;
				}
			}
		}
	}

	public object Parent
	{
		get
		{
			return _Parent;
		}
		set
		{
			if (_Parent != value)
			{
				_Parent = value;
				OnPropertyChanged("Parent");
				if (_Parent != null && Parent is VmProcedure vmProcedure)
				{
					vmProcedure.SaveCalibDataToUserData = (VmProcedure.SaveCalibrationData)Delegate.Remove(vmProcedure.SaveCalibDataToUserData, new VmProcedure.SaveCalibrationData(SaveData));
					vmProcedure.SaveCalibDataToUserData = (VmProcedure.SaveCalibrationData)Delegate.Combine(vmProcedure.SaveCalibDataToUserData, new VmProcedure.SaveCalibrationData(SaveData));
				}
			}
		}
	}

	private void SaveData()
	{
		if (Parent != null && Parent is VmProcedure vmProcedure)
		{
			vmProcedure.UserData["CalibData"] = ByteUtil.GetBytes(ToXmlStringWithHead());
		}
	}
}
