			return _imageNum;
		}
		set
		{
			if (_imageNum != value)
			{
				_imageNum = value;
				OnPropertyChanged("ImageNum");
			}
		}
	}

	public int LostPackgeNum
	{
		get
		{
			return _LostPackgeNum;
		}
		set
		{
			if (_LostPackgeNum != value)
			{
				_LostPackgeNum = value;
				OnPropertyChanged("LostPackgeNum");
			}
		}
	}

	public ImageData ImageSource
	{
		get
		{
			return imageSource;
		}
		set
