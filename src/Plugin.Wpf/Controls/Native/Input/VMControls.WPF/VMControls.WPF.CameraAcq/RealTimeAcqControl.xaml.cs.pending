namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.CameraAcq;

/// <summary>
/// CameraPreviewControl.xaml 的交互逻辑
/// </summary>
/// <summary>
/// RealTimeAcqControl
/// </summary>
public partial class RealTimeAcqControl : UserControl, IDisposable, INotifyPropertyChanged, IComponentConnector
{
	public static readonly DependencyProperty ModuleSourceProperty = DependencyProperty.Register("ModuleSource", typeof(IVmModule), typeof(RealTimeAcqControl), new PropertyMetadata(null, OnModuleSourceChanged));

	public static readonly DependencyProperty IsShowButtonProperty = DependencyProperty.Register("IsShowButton", typeof(bool), typeof(RealTimeAcqControl), new PropertyMetadata(true, OnVisibleChanged));

	private static bool needPopLostPacketWarning = true;

	private object popLock = new object();

	public int _imageNum = 0;

	private int _LostPackgeNum;

	private ImageData imageSource;

	private string serialNumber = "";

	private MyCamera.cbOutputExdelegate m_cbImage = null;

	private MyCamera.MV_CC_DEVICE_INFO_LIST m_stDeviceList = default;

	private const uint MV_GVSP_PIX_ID_MASK = 65535u;

	private const uint MV_GVSP_PIX_COLOR_MASK = 4278190080u;

	private const uint MV_GVSP_PIX_COLOR = 33554432u;

	private MyCamera device;

	private string ipTemp = "";

	private ushort portTemp;

	/// <summary>
	/// 数据源模块
	/// </summary>
