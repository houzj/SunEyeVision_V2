	{
	}

	private void SelectedCommandExecute(object param)
	{
		if (param is IVmFrameBase { FullName: var text })
		{
			while (text.Contains("%"))
			{
				text = text.Remove(text.IndexOf('%'), 1);
			}
			SelectedItemPath = text;
		}
	}

	private void CopyPathCommandExecute(object param)
	{
		if (!(param is string text))
		{
			return;
		}
		IDataObject dataObject = System.Windows.Clipboard.GetDataObject();
		if (dataObject.GetDataPresent(DataFormats.Text))
		{
			string text2 = (string)dataObject.GetData(DataFormats.Text);
			if (text2 == text)
			{
				return;
			}
		}
		System.Windows.Clipboard.SetText(text);
		HikMessageBox msgBox = HikMessageBox.CreateMessageBox(AppLocalizationService.GetLang("Lang_CopySuccess"), MessageIcons.Ok, MessageButtons.NoButton);
		Task.Run(() =>
		{
			ParentUI.Dispatcher.Invoke(() =>
			{
				msgBox.Show();
			});
			Thread.Sleep(1500);
			ParentUI.Dispatcher.Invoke(() =>
			{
				msgBox.Close();
				msgBox = null;
			});
		});
	}

	private void RelatedGlobalVarCommandExecute(object param)
	{
		if (VmSolution.Instance.IsRunning)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PlzLoopStop"), MessageIcons.Error);
			return;
		}
		LogHelper.Info("Begin RelatedGlobalVarCommandExecute");
		if (!(param is IVmIO vmIO))
		{
			return;
		}
		GlobalVariableSelectDlg globalVariableSelectDlg = new GlobalVariableSelectDlg(isAllowRepeatedSelection: true);
		IVmModule localVarModule = vmIO.Owner.GetLocalVarModule(isInput: true);
		globalVariableSelectDlg.Type = new string[1] { vmIO.TypeName };
		globalVariableSelectDlg.DecorateSource = localVarModule;
		globalVariableSelectDlg.ShowDialog();
		if (!globalVariableSelectDlg.IsConfirm || !(globalVariableSelectDlg.SelectedVarItem is VarItem { Name: var name } varItem) || !(name != (vmIO.Tag as IVariable)?.Name))
		{
			return;
		}
		try
		{
			vmIO.BindingGlobalVariable(varItem.Name, varItem.Owner);
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("绑定失败"), ex.Message, MessageIcons.Error);
		}
	}

	private void UnRelatedGlobalVarCommandExecute(object param)
	{
		if (VmSolution.Instance.IsRunning)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PlzLoopStop"), MessageIcons.Error);
			return;
		}
		LogHelper.Info("Begin UnRelatedGlobalVarCommandExecute");
		if (!(param is IVmIO vmIO))
		{
			return;
		}
		try
		{
			vmIO.UnBindingGlobalVariable();
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("解除绑定失败"), ex.Message, MessageIcons.Error);
		}
	}

	/// <summary>
	/// 刷新模块输出与全局变量的绑定关系
	/// </summary>
	private void RefreshGlobalBindingRelation(IVmModule VMModule)
	{
		RefreshVarBindingRelation(VmModuleExtern.GetGlobalVarModule());
		IVmModule localVarModule = VMModule.GetLocalVarModule(isInput: true);
		RefreshVarBindingRelation(localVarModule as VmModule);
	}

	/// <summary>
	/// 获取绑定
	/// </summary>
	private bool GetCombinBind(ref VmIO combinIO, ref VmIO varIO)
	{
		if (varIO == null || combinIO == null)
		{
			return false;
		}
		while (varIO.CombinRoot != null)
		{
			varIO = varIO.CombinRoot;
		}
		if (varIO.TypeName == combinIO.TypeName)
		{
			return true;
		}
		while (combinIO.CombinRoot != null)
		{
			combinIO = combinIO.CombinRoot;
			if (varIO.TypeName == combinIO.TypeName)
			{
				return true;
			}
		}
		return false;
	}

	private void RefreshVarBindingRelation(VmModule module)
	{
		if (module == null)
		{
			return;
		}
		ImvsSdkDefine.IMVS_BIND_GLOBALVAR_PARAM_INFO[] bindGlobalVarParam = ServerSDKManager.serverSDKManager.mGlobalModuleManager.GetBindGlobalVarParam(module.ID);
		for (int i = 0; i < bindGlobalVarParam.Length; i++)
		{
			ImvsSdkDefine.IMVS_SUBSCRIBE_MODULE_PARAM_INFO stModuleParam = bindGlobalVarParam[i].stBindValue.stVariableValue.stModuleParam;
			if (VMModule.ID != stModuleParam.nModuleId || !((VMModule as VmFrameTreeBase)?[VM.PlatformSDKCS.StringUtil.UTF8GetString(stModuleParam.byParamName)] is VmIO { CombinRoot: var combinIO } vmIO))
			{
				continue;
			}
			VmIO varIO = module?[VM.PlatformSDKCS.StringUtil.UTF8GetString(bindGlobalVarParam[i].strParamName)] as VmIO;
			if (varIO == null)
			{
				continue;
			}
			if (combinIO == null || (vmIO?.TypeName == varIO?.TypeName && varIO?.CombinRoot == null))
			{
				vmIO.Tag = new VarItem
				{
					Owner = module,
					Name = VM.PlatformSDKCS.StringUtil.UTF8GetString(bindGlobalVarParam[i].strParamName)
				};
			}
			else if (GetCombinBind(ref combinIO, ref varIO))
			{
				if (combinIO != null && varIO != null)
				{
					combinIO.Tag = new VarItem
					{
						Name = varIO.Name,
						Owner = module
					};
				}
			}
			else
			{
				vmIO.Tag = new VarItem
				{
					Owner = module,
					Name = VM.PlatformSDKCS.StringUtil.UTF8GetString(bindGlobalVarParam[i].strParamName)
				};
			}
		}
	}

	private void SelectImageCommandExecute(object param)
	{
		int num = ImageViewList.Count((ImageViewItem p) => p.IsCheck);
		if (!(param is ImageViewItem imageViewItem))
		{
			return;
		}
		IVmProcedure vmProcedure = (VMModule as IVmProcedure) ?? (VMModule.Root as IVmProcedure);
		if ((vmProcedure as IVMRun).IsRunning)
		{
			imageViewItem.IsCheck = !imageViewItem.IsCheck;
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PlzLoopStop"), MessageIcons.Warning);
			return;
		}
		if (num > 4)
		{
			imageViewItem.IsCheck = false;
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_OverlyingImageLimitTip") + " : " + 4, MessageIcons.Warning);
			return;
		}
		if (ImageDataSource == null && num >= 2 && imageViewItem.IsCheck)
		{
			imageViewItem.IsCheck = false;
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_BackgroundImageEmptyTip"), MessageIcons.Warning);
			return;
		}
		if (num > 1 && ImageViewList.Count((ImageViewItem p) => p.IsBackgroundImage) == 0 && SelectedImage != null)
		{
			SelectedImage.IsBackgroundImage = true;
			SelectedImage.IsEnable = true;
		}
		if (imageViewItem.IsCheck)
		{
			if (!imageViewItem.IsCallBackEnable && imageViewItem.DisplayObject is Apps.XmlParser.Object obj)
			{
				obj.SetOutputFilter();
				WeakEventManager<Apps.XmlParser.Object, EventArgs>.RemoveHandler(obj, "ValueChanged", ParentUI.P_ValueChanged);
				WeakEventManager<Apps.XmlParser.Object, EventArgs>.AddHandler(obj, "ValueChanged", ParentUI.P_ValueChanged);
				imageViewItem.IsCallBackEnable = true;
			}
			ImageData imageData = null;
			if (imageViewItem.DisplayObject != null)
			{
				imageData = (imageViewItem.DisplayObject as Apps.XmlParser.Object).GetValue(ParentUI.ExecuteCount) as ImageData;
			}
			if (imageData == null)
			{
				imageViewItem.IsCheck = false;
				if (imageViewItem.IsCallBackEnable && imageViewItem.DisplayObject is Apps.XmlParser.Object obj2)
				{
					obj2.RemoveOutputFilter();
					WeakEventManager<Apps.XmlParser.Object, EventArgs>.RemoveHandler(obj2, "ValueChanged", ParentUI.P_ValueChanged);
					imageViewItem.IsCallBackEnable = false;
				}
				if (num == 2 && SelectedImage != null)
				{
					SelectedImage.IsBackgroundImage = false;
					SelectedImage.IsEnable = false;
				}
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_CheckImageEmptyTip"), MessageIcons.Warning);
				return;
			}
			ParentUI.AddCheckImage(imageData, imageViewItem.DisplayName);
		}
		else
		{
			if (imageViewItem.IsBackgroundImage)
			{
				ImageViewItem imageViewItem2 = ImageViewList.FirstOrDefault((ImageViewItem p) => p.IsCheck);
				if (imageViewItem2 != null)
				{
					ParentUI.RemoveCheckImage(imageViewItem2.DisplayName);
					if (num > 1)
					{
						imageViewItem.IsBackgroundImage = false;
						imageViewItem2.IsBackgroundImage = true;
						if (imageViewItem2 != SelectedImage)
						{
							SelectedImage = imageViewItem2;
						}
						else
						{
							foreach (Image checkImage in ParentUI.checkImageList)
							{
								checkImage.Visibility = Visibility.Visible;
							}
						}
					}
					else if (SelectedImage == imageViewItem)
					{
						imageViewItem2.IsEnable = false;
						SelectedImage = imageViewItem2;
					}
					else
					{
						imageViewItem2.IsCheck = false;
					}
				}
			}
			else
			{
				ParentUI.RemoveCheckImage(imageViewItem.DisplayName);
			}
			if (imageViewItem.IsCallBackEnable && imageViewItem.DisplayObject is Apps.XmlParser.Object obj3)
			{
				obj3.RemoveOutputFilter();
				WeakEventManager<Apps.XmlParser.Object, EventArgs>.RemoveHandler(obj3, "ValueChanged", ParentUI.P_ValueChanged);
				imageViewItem.IsCallBackEnable = false;
			}
		}
		if (num == 1)
		{
			ImageViewItem imageViewItem3 = ImageViewList.FirstOrDefault((ImageViewItem p) => p.IsBackgroundImage);
			if (imageViewItem3 != null)
			{
				imageViewItem3.IsBackgroundImage = false;
				if (imageViewItem3 != SelectedImage)
				{
					imageViewItem3.IsCheck = false;
					imageViewItem3.IsEnable = true;
				}
				if (SelectedImage != null)
				{
					SelectedImage.IsCheck = true;
					SelectedImage.IsEnable = false;
				}
			}
		}
		RecordCheckedImages();
	}

	private void ClickImageCommandExecute(object param)
	{
		if (param == null)
		{
			return;
		}
		IVmProcedure vmProcedure = (VMModule as IVmProcedure) ?? (VMModule.Root as IVmProcedure);
		if ((vmProcedure as IVMRun).IsRunning)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PlzLoopStop"), MessageIcons.Warning);
		}
		else
		{
			if (!(param is ImageViewItem imageViewItem) || ImageViewList.Count((ImageViewItem p) => p.IsBackgroundImage) == 0 || !imageViewItem.IsCheck || imageViewItem.IsBackgroundImage)
			{
				return;
			}
			DialogResult dialogResult = HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ChangeBackgroundImageTip"), MessageButtons.YesOrNo, MessageIcons.Question);
			if (dialogResult != DialogResult.Yes)
			{
				return;
			}
			ImageViewItem imageViewItem2 = ImageViewList.FirstOrDefault((ImageViewItem p) => p.IsBackgroundImage);
			if (imageViewItem2 != null)
			{
				ParentUI.RemoveCheckImage(imageViewItem.DisplayName);
				imageViewItem2.IsBackgroundImage = false;
				imageViewItem.IsBackgroundImage = true;
				if (imageViewItem != SelectedImage)
				{
					SelectedImage = imageViewItem;
				}
				else
				{
					foreach (Image checkImage in ParentUI.checkImageList)
					{
						checkImage.Visibility = Visibility.Visible;
					}
				}
				ImageData imageData = null;
				imageData = ((imageViewItem2.DisplayObject == null) ? ((imageViewItem2.DisplayValue as IVmIO).GetCombinationValueByType(ParentUI.ExecuteCount) as ImageData) : ((imageViewItem2.DisplayObject as Apps.XmlParser.Object).GetValue(ParentUI.ExecuteCount) as ImageData));
				ParentUI.AddCheckImage(imageData, imageViewItem2.DisplayName);
			}
			RecordCheckedImages();
		}
	}
}
