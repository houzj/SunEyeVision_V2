	/// <summary>
	/// 是否可以绘制ROI
	/// </summary>
	public bool IsCanDrawROI
	{
		get
		{
			ImageViewItem imageViewItem = (IsDoubleImageMode ? SelectedInputImage : SelectedImage);
			if (imageViewItem == null)
			{
				return false;
			}
			if ((VMModule.Params as IData).Data is AlgorithmTabRoot algorithmTabRoot)
			{
				bool flag = CheckStatus(algorithmTabRoot);
				if (!flag)
				{
					return flag;
				}
				if (algorithmTabRoot.GetItem((NameValueItem p) => p is AddList_EdgeInspGroup)?.FirstOrDefault() is AddList_EdgeInspGroup { CurItem: not null } addList_EdgeInspGroup)
				{
					flag = CheckStatus(addList_EdgeInspGroup.CurItem.info.AlgorithmRoot);
					if (!flag)
					{
						return flag;
					}
				}
			}
			VmIO vmIO = imageViewItem.DisplayValue as VmIO;
			bool returnVal = false;
			IDecoratorAddition mosuleDecoratorAddition = MosuleDecoratorAddition;
			if (mosuleDecoratorAddition != null && mosuleDecoratorAddition.IsCanDrawROIOut(vmIO, vmIO.Root, ImageInputs, out returnVal))
			{
				return returnVal;
			}
			return ImageInputs.Contains(vmIO.FullName);
		}
	}

	/// <summary>
	/// 模块输入图片的订阅集合
	/// </summary>
	private List<string> ImageInputs
	{
		get
		{
			List<VmIO> list = (VMModule.GetVmIOByType("Inputs", "IMAGE", "PIXELIMAGE", "STEREOIMAGE", "POINTCLOUD") as List<VmIO>)?.Select((VmIO p) => p.RelateIO)?.Where((VmIO p) => p != null)?.ToList();
			if (list != null && list.Count > 0)
			{
				for (int num = 0; num < list.Count; num++)
				{
					if (list[num].Parent is VmIO { TypeName: "PIXELIMAGE" } vmIO)
					{
						list[num] = vmIO;
					}
				}
				foreach (ImageViewItem imageView in ImageViewList)
				{
					object displayValue = imageView.DisplayValue;
					IEnumerable<object> source = InputImageViewList.Select((ImageViewItem p) => p.DisplayValue);
					if (list.Contains(displayValue) && !source.Contains(displayValue))
					{
						InputImageViewList.Add(imageView.Clone());
					}
				}
			}
			return InputImageViewList.Select((ImageViewItem p) => (p.DisplayValue as VmIO)?.FullName).ToList();
		}
	}

