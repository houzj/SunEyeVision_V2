using System;
using SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.Interface;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.DataForUI;

public class ReNameUnRedoOperation : DisplayNotify, IUnRedoActionOperation, IUnRedoOperation, IDisposable, IUnRedoDataDone<UnRedo_NameData>
{
	public bool IsPart { get; set; } = true;

	public UnRedo_NameData Data { get; set; }

	public IUnRedoParams Params { get; set; }

	public IBuilder ParentNode { get; set; }

	public Action<UnRedo_NameData, IUnRedoParams> RedoAction { get; set; }

	public Action<UnRedo_NameData, IUnRedoParams> UndoAction { get; set; }

	public Action<UnRedo_NameData> UpdateAction { get; set; }

	public bool IsDataComplete { get; set; } = true;

	public ExecutePriority ExecutePriority { get; set; }

	public ReNameUnRedoOperation(Action<UnRedo_NameData, IUnRedoParams> redoAction, Action<UnRedo_NameData, IUnRedoParams> undoAction, UnRedo_NameData data)
	{
		RedoAction = redoAction;
		UndoAction = undoAction;
		Data = data;
	}

	public void Redo()
	{
		RedoAction(Data, Params);
	}

	public void Undo()
	{
		UndoAction(Data, Params);
	}

	public void Update()
	{
	}

	public void Dispose()
	{
		RedoAction = null;
		UndoAction = null;
		UpdateAction = null;
		Data = null;
	}
}
