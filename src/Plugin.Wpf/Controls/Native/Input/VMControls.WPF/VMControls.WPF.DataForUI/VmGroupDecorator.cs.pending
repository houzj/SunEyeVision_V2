	private void ConfigParamsCommandExecute()
	{
		if (IsPasswordEnabledA)
		{
			PasswordCheckWindow passwordCheckWindow = new PasswordCheckWindow();
			passwordCheckWindow.OriginalPassword = PasswordA;
			passwordCheckWindow.ShowInTaskbar = false;
			passwordCheckWindow.ShowDialog();
			if (passwordCheckWindow.IsPasswordOK)
			{
				ParamsTabControlBase paramsTabControlBase = new ParamsTabControlBase();
				paramsTabControlBase.ParamsConfig = VMModule.Params;
				paramsTabControlBase.ShowDialog();
			}
		}
		else
		{
			ParamsTabControlBase paramsTabControlBase2 = new ParamsTabControlBase();
			paramsTabControlBase2.ParamsConfig = VMModule.Params;
			paramsTabControlBase2.ShowDialog();
		}
	}

	public static int GetLevel(IVMGroup vMGroup)
	{
		int num = 0;
		for (IVMGroup iVMGroup = vMGroup.Parent as IVMGroup; iVMGroup != null; iVMGroup = iVMGroup.Parent as IVMGroup)
		{
			num++;
		}
		return num;
	}

	private void ImportGroupCommandExecute(DiagramEventArgs args)
	{
		DecoratorBase.ImportGroup(DecorateSource as IVMGroup, args.Point);
	}

	private void ImportGroupRemoteCommandExecute(DiagramEventArgs args)
	{
		DecoratorBase.ImportGroup(DecorateSource as IVMGroup, args.Point, isRemoteMode: true);
	}

	private void ExportGroupCommandExecute()
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("Lang_ExportGroup") ?? "");
		LogHelper.Info("Export group.");
		string initDir = ConfigurationHelper.INIGetStringValue("OpenGroup");
		string path = ((DecorateSource is IVMGroup iVMGroup) ? iVMGroup.ExportFile(null, null, isExportAs: true, initDir) : null);
		if (File.Exists(path))
		{
			ConfigurationHelper.INISetStringValue("OpenGroup", Path.GetDirectoryName(path));
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ExportSuccess"), MessageIcons.Ok);
		}
	}

	private void ExportGroupRemoteCommandExecute()
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("导出Group") ?? "");
		LogHelper.Info("Export group.");
		string initialDirectory = ConfigurationHelper.INIGetStringValue("OpenGroupRemote");
		string text = null;
		SaveFileDialog saveFileDialog = new SaveFileDialog
		{
			Filter = "Group文件|*.grox",
			InitialDirectory = initialDirectory
		};
		if (saveFileDialog.ShowDialog() == true)
		{
			text = saveFileDialog.FilePath;
		}
		if (text != null)
		{
			text = ((DecorateSource is IVMGroup iVMGroup) ? iVMGroup.ExportFile(text, null, isExportAs: true) : null);
			if (!ServerSDKAPI.FtpCheckFileName(CVmObjectBase.mhandle, text))
			{
				string directoryName = saveFileDialog.GetDirectoryName();
				ConfigurationHelper.INISetStringValue("OpenGroupRemote", directoryName);
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ExportSuccess"), MessageIcons.Ok);
			}
		}
	}

	private void SaveGroupCommandExecute()
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("Lang_Save_Group") ?? "");
		LogHelper.Info("Save group.");
		if (DecorateSource is IVMGroup iVMGroup)
		{
			iVMGroup.ExportFile();
		}
	}

	private void ForbiddenItemExecute()
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("模块禁用") + AppLocalizationService.GetPunctuation("：") + VMModule?.FullName);
		IsForbidden = true;
	}

	private void ActivateItemExecute()
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("模块启用") + AppLocalizationService.GetPunctuation("：") + VMModule?.FullName);
		IsForbidden = false;
	}

	private void ForbiddenItemsExecute(IList obj)
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("多模块禁用") + string.Join(AppLocalizationService.GetPunctuation("，"), from x in obj.OfType<VmModuleBaseDecorator>().ToList()
			select x.VMModule?.FullName));
		obj.OfType<VmModuleBaseDecorator>().ToList().ForEach((VmModuleBaseDecorator p) =>
		{
			p.IsForbidden = true;
		});
	}

	private void ActivateItemsExecute(IList obj)
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("多模块启用") + string.Join(AppLocalizationService.GetPunctuation("，"), from x in obj.OfType<VmModuleBaseDecorator>().ToList()
			select x.VMModule?.FullName));
		obj.OfType<VmModuleBaseDecorator>().ToList().ForEach((VmModuleBaseDecorator p) =>
		{
			p.IsForbidden = false;
		});
	}

	private void EnablePasswordCommandExecute()
	{
		try
		{
			PasswordSetWindow passwordSetWindow = new PasswordSetWindow();
			passwordSetWindow.ShowDialog();
			if (passwordSetWindow.IsPasswordOK)
			{
				UILogManager.logCreate("信息", "启用密码");
				PasswordA = passwordSetWindow.Password;
				IsPasswordEnabledA = true;
			}
		}
		catch (Exception ex)
		{
			LogHelper.objLog.Error(ex.ToString());
		}
	}

	private void EditPasswordCommandExecute()
	{
		try
		{
			PasswordModifyWindow passwordModifyWindow = new PasswordModifyWindow(PasswordA);
			passwordModifyWindow.ShowDialog();
			if (passwordModifyWindow.IsPasswordOK)
			{
				UILogManager.logCreate("信息", "修改密码");
				PasswordA = passwordModifyWindow.ModifiedPassword;
			}
		}
		catch (Exception ex)
		{
			LogHelper.objLog.Error(ex.ToString());
		}
	}

	private void CancelPasswordCommandExecute()
	{
		try
		{
			PasswordCheckWindow passwordCheckWindow = new PasswordCheckWindow();
			passwordCheckWindow.OriginalPassword = PasswordA;
			passwordCheckWindow.ShowDialog();
			if (passwordCheckWindow.IsPasswordOK)
			{
				UILogManager.logCreate("信息", "取消密码");
				PasswordA = "";
				IsPasswordEnabledA = false;
			}
		}
		catch (Exception ex)
		{
			LogHelper.objLog.Error(ex.ToString());
		}
	}

	private void CreateXml(string toolName, string toolPath, int count)
	{
		XmlDocument xmlDocument = new XmlDocument();
		XmlDeclaration newChild = xmlDocument.CreateXmlDeclaration("1.0", "UTF-8", null);
		xmlDocument.AppendChild(newChild);
		XmlElement newChild2 = xmlDocument.CreateElement("", "ToolBoxItemData", "");
		xmlDocument.AppendChild(newChild2);
		XmlNode xmlNode = xmlDocument.SelectSingleNode("ToolBoxItemData");
		XmlElement xmlElement = xmlDocument.CreateElement("name");
		xmlElement.InnerText = "%" + toolName + "%";
		xmlNode.AppendChild(xmlElement);
		XmlElement xmlElement2 = xmlDocument.CreateElement("priority");
		xmlElement2.InnerText = count.ToString();
		xmlNode.AppendChild(xmlElement2);
		XmlElement xmlElement3 = xmlDocument.CreateElement("toolTip");
		xmlElement3.InnerText = "%" + toolName + "%";
		xmlNode.AppendChild(xmlElement3);
		string filename = toolPath + "\\ToolItemInfo.xml";
		xmlDocument.Save(filename);
	}

	private void AddToToolboxCommandExecute()
	{
		string currentPath = CurrentPathHelper.Instance.GetCurrentPath();
		string text = currentPath + "\\Module(sp)\\x64\\GroupTools";
		string[] directories = Directory.GetDirectories(text);
		string name = Name;
		string text2 = text + "\\" + name;
		if (Directory.Exists(text2))
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PmNameExited"), MessageIcons.Error);
			return;
		}
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("添加自定义工具") ?? "");
		try
		{
			Directory.CreateDirectory(text2);
		}
		catch (Exception)
		{
			HikMessageBox.Show("添加不成功，请修改命名不要包含特殊字符！", MessageIcons.Error);
			return;
		}
		string text3 = "ImageEnable.png";
		string sourceFileName = text + "\\" + text3;
		string destFileName = text2 + "\\" + name + text3;
		File.Copy(sourceFileName, destFileName);
		string text4 = "." + AppFileExtension.Group;
		string path = text2 + "\\" + name + text4;
		if (string.IsNullOrEmpty((DecorateSource is IVMGroup iVMGroup) ? iVMGroup.ExportFile(path) : null))
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_GroupExportFail"), MessageIcons.Error);
			UILogManager.logCreate("告警", "导出失败");
			Directory.Delete(text2);
		}
		else
		{
			CreateXml(name, text2, directories.Count());
			ToolBoxData.AddToolItem(text2);
		}
	}
}
