	public bool IsPasswordEnabledA
	{
		get
		{
			byte[] array = VMModule.UserData["IsPasswordEnabledA"];
			if (array != null)
			{
				isPasswordEnabled = ExternalCallHelper.BytesToStruct<bool>(array, 0, array.Length);
			}
			return isPasswordEnabled;
		}
		set
		{
			if (value != isPasswordEnabled)
			{
				isPasswordEnabled = value;
				VMModule.UserData["IsPasswordEnabledA"] = ExternalCallHelper.StructToBytes(value);
				OnPropertyChanged("IsPasswordEnabledA");
			}
		}
	}

	public string ShowName => $"{VMModule.ID} {Name}";

	public string PasswordA
	{
		get
		{
			byte[] array = VMModule.UserData["PasswordA"];
			if (array != null)
			{
				password = StringUtil.UTF8GetString(array);
			}
			return password;
		}
		set
		{
			if (value != password)
			{
				password = value;
				VMModule.UserData["PasswordA"] = StringUtil.UTF8GetBytes(value);
				OnPropertyChanged("PasswordA");
			}
		}
	}

	public bool UpEnable => true;

