	/// <summary>
	/// 子项
	/// </summary>
	public IList DecorateChildren
	{
		get
		{
			if (decorateChildren == null && DecorateSource is IVmModuleSet vmModuleSet)
			{
				decorateChildren = new ObservableCollection<DecoratorBase>();
				CollectionChangedEventManager.AddHandler(vmModuleSet.Children as INotifyCollectionChanged, OnCollectionChanged);
				List<IVmModuleSet> list = vmModuleSet.Children.OfType<IVmModuleSet>().ToList();
				list.ForEach((IVmModuleSet p) =>
				{
					AddChild(p);
				});
			}
			return decorateChildren;
		}
	}

	/// <summary>
	/// 模块显示方式
	/// </summary>
	public virtual ModuleDisplayType DisplayType
	{
		get
		{
			if (!displayType.HasValue && VMModule != null)
			{
				if (displayTypeDic.ContainsKey(VMModule.ModuleTypeName))
				{
					displayType = displayTypeDic[VMModule.ModuleTypeName];
				}
				else
				{
					string text = VMModule.ModuleDir + "\\ToolItemInfo.xml";
					if (File.Exists(text))
					{
						ToolBoxItemData toolBoxItemData = new ToolBoxItemData();
						toolBoxItemData.loadXml(text);
						string value = toolBoxItemData.DisplayType.Replace("ADORNER", "");
						ModuleDisplayType result;
						if (string.IsNullOrEmpty(value))
						{
							displayType = ModuleDisplayType.NORMAL;
						}
						else if (Enum.TryParse<ModuleDisplayType>(toolBoxItemData.DisplayType.Replace("ADORNER", ""), out result))
						{
							displayType = result;
						}
						else
						{
							displayType = ModuleDisplayType.NORMAL;
						}
					}
					else
					{
						displayType = ModuleDisplayType.NORMAL;
					}
					if (!displayTypeDic.ContainsKey(VMModule.ModuleTypeName))
					{
						displayTypeDic.Add(VMModule.ModuleTypeName, displayType ?? ModuleDisplayType.NORMAL);
					}
				}
			}
			return displayType ?? ModuleDisplayType.DEFAULT;
		}
		set
		{
			if (value != displayType)
			{
				displayType = value;
				OnPropertyChanged("DisplayType");
			}
		}
	}

	public DiagramItemSubDisplayEnum TargetDisplayType
	{
		get
		{
			if (!_targetDisplayType.HasValue)
			{
				switch (DisplayType)
				{
				case ModuleDisplayType.IMAGE:
				case ModuleDisplayType.IMAGEADORNER:
				{
					DiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.IMAGE);
					return diagramItemSubDisplayEnum.Value;
				}
				case ModuleDisplayType.IFBRANCH:
				case ModuleDisplayType.IFBRANCHADORNER:
				{
					DiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.IFBRANCH);
					return diagramItemSubDisplayEnum.Value;
				}
				case ModuleDisplayType.FUNCTION:
				case ModuleDisplayType.FUNCTIONADORNER:
				{
					DiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.FUNCTION);
					return diagramItemSubDisplayEnum.Value;
				}
				case ModuleDisplayType.TIMER:
				case ModuleDisplayType.TIMERADORNER:
				{
					DiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.TIMER);
					return diagramItemSubDisplayEnum.Value;
				}
				case ModuleDisplayType.SHELL:
				case ModuleDisplayType.SHELLADORNER:
				{
					DiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.SHELL);
					return diagramItemSubDisplayEnum.Value;
				}
				case ModuleDisplayType.COMMUNCATION:
				case ModuleDisplayType.COMMUNCATIONADORNER:
				{
					DiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.COMMUNCATION);
					return diagramItemSubDisplayEnum.Value;
				}
				default:
					return DiagramItemSubDisplayEnum.DEFAULT;
				}
			}
			return _targetDisplayType.Value;
		}
	}

	public bool IsShowImportGroup => true;

	public bool IsSingleProcedure
	{
		get
		{
			if (VMModule.Root == null)
			{
				return false;
			}
			return true;
		}
	}

	/// <summary>
	/// 用来记录模块的位置
	/// </summary>
	public Point Position
	{
		get
		{
			if (VMModule is IMVSGroup || VMModule is VmProcedure)
			{
				byte[] array = VMModule.UserData["Position"];
				if (array != null)
				{
					position = ExternalCallHelper.BytesToStruct<Point>(array, 0, array.Length);
					VMModule.Position = position;
				}
				return position;
			}
			if (VMModule.Position is Point result)
			{
				return result;
			}
			byte[] array2 = VMModule.UserData["Position"];
			if (array2 != null)
			{
				position = ExternalCallHelper.BytesToStruct<Point>(array2, 0, array2.Length);
				VMModule.Position = position;
			}
			return position;
		}
		set
		{
			if (value != position)
			{
				VMModule.Position = (position = value);
				VMModule.UserData["Position"] = ExternalCallHelper.StructToBytes(value);
				OnPropertyChanged("Position");
			}
		}
	}

	public bool? IsLoadFailed
