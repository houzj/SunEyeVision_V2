	/// <summary>
	/// 模块是否禁用
	/// </summary>
	public bool IsForbidden
	{
		get
		{
			return VMModule?.IsForbidden ?? false;
		}
		set
		{
			if (VMModule.IsForbidden != value)
			{
				try
				{
					string displayName = (value ? string.Format("{0}:{1}, {2}", AppLocalizationService.GetLang("Lang_Forbidden"), VMModule.Name, value) : string.Format("{0}:{1}, {2}", AppLocalizationService.GetLang("Lang_Enabled"), VMModule.Name, value));
					Ioc.Get<IUnRedoService>()?.Register(new ForbidSetUnRedoOperation(SetNewForbid, SetOldForbid, new UnRedo_ForbidData(VMModule.FullName, VMModule.IsForbidden, value)), displayName);
					VMModule.IsForbidden = value;
					OnPropertyChanged("IsForbidden");
				}
				catch
				{
				}
			}
		}
	}

