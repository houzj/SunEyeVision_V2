	public VmProcedureDecorator()
	{
		displayModuleSet = this;
	}

	private void SelectionChangedCommandExecute()
	{
	}

	private void ImportGroupCommandExecute(DiagramEventArgs args)
	{
		DecoratorBase.ImportGroup(DecorateSource as IVmProcedure, args.Point);
	}

	private void ImportGroupRemoteCommandExecute(DiagramEventArgs args)
	{
		DecoratorBase.ImportGroup(DecorateSource as IVmProcedure, args.Point, isRemoteMode: true);
	}

	private void ProcessExportCommandExe()
	{
		if (!DecoratorBase.CheckRunning(DecorateSource as IVMRun))
		{
			return;
		}
		LogHelper.Info("Export procedure.");
		string initDir = ConfigurationHelper.INIGetStringValue("OpenProcess");
		IVmProcedure vmProcedure = DecorateSource as IVmProcedure;
		try
		{
			string path = vmProcedure.ExportFile(null, null, isExportAs: true, initDir);
			if (File.Exists(path))
			{
				ConfigurationHelper.INISetStringValue("OpenProcess", Path.GetDirectoryName(path));
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ExportSuccess"), MessageIcons.Ok);
			}
		}
		catch (VmException ex)
		{
			string text = AppLocalizationService.GetLang("errCode:") + $"{ex.errorCode:X}" + "\r\n";
			text = text + AppLocalizationService.GetLang("errInfo:") + ErrorCodeInfo.GetErrorInfo(ex.errorCode);
			HikMessageBox.Show(text, MessageIcons.Error);
		}
	}

	private void ProcessExportRemoteCommandExe()
	{
		if (DecoratorBase.CheckRunning(DecorateSource as IVMRun))
		{
			LogHelper.Info("Export procedure.");
			string text = ConfigurationHelper.INIGetStringValue("OpenProcessRemote");
			IVmProcedure vmProcedure = DecorateSource as IVmProcedure;
			SaveFileDialog saveFileDialog = new SaveFileDialog
			{
				Filter = AppLocalizationService.GetLang("Lang_ProcessFile") + "|*.prcx"
			};
			if (saveFileDialog.ShowDialog() == true)
			{
				vmProcedure.ExportFile(saveFileDialog.FilePath, null, isExportAs: true);
				string directoryName = saveFileDialog.GetDirectoryName();
				ConfigurationHelper.INISetStringValue("OpenProcessRemote", directoryName);
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ExportSuccess"), MessageIcons.Ok);
			}
		}
	}

	private void CopyCommandExe()
	{
		IVmProcedure vmProcedure = DecorateSource as IVmProcedure;
		Ioc.Get<IUnRedoService>()?.Register(new RootOperation(), AppLocalizationService.GetLang("复制流程") ?? "");
		vmProcedure.CopyProcedure();
	}

	private void SetIntervalCommandExe()
	{
		SysParamSet sysParamSet = new SysParamSet((DecorateSource as IVmModule).ID);
		sysParamSet.ShowDialog();
	}

	private void SetTimeOutCommandExe()
	{
		TimeOutSet timeOutSet = new TimeOutSet((DecorateSource as IVmModule).ID);
		timeOutSet.ShowDialog();
	}

	private void RunOnceCommandExe()
	{
		if (!RunCheck())
		{
			return;
		}
		VmProcedure vmProcedure = DecorateSource as VmProcedure;
		try
		{
			vmProcedure.Run(null, bIsWait: false);
		}
		catch (VmException ex)
		{
			string strMsg = (DecorateSource as IVmProcedure).FullName + ":" + ErrorCodeInfo.GetErrorInfo(ex.errorCode);
			HikMessageBox.Show(strMsg, MessageIcons.Error);
		}
	}

	/// <summary>
	/// 是否可执行检查
	/// </summary>
	/// <returns></returns>
	private bool RunCheck()
	{
		if (WorkState != StatusBarSymbol.Ready)
		{
			string strMsg = VMProcedure.Name + ":" + WorkStateInfo;
			HikMessageBox.Show(strMsg, MessageIcons.Error);
			return false;
		}
		return true;
	}

	private void RunContinuousCommandExe()
	{
		IVMRun iVMRun = DecorateSource as IVMRun;
		if (!iVMRun.ContinuousRunEnable && !RunCheck())
		{
			return;
		}
		try
		{
			iVMRun.ContinuousRunEnable = !iVMRun.ContinuousRunEnable;
		}
		catch (Exception ex)
		{
			if (ex is VmException ex2)
			{
				string strMsg = (DecorateSource as IVmProcedure).FullName + ":" + ErrorCodeInfo.GetErrorInfo(ex2.errorCode);
				HikMessageBox.Show(strMsg, MessageIcons.Error);
			}
		}
	}

	private void ForbiddenItemsExecute(IList obj)
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("多模块禁用") + AppLocalizationService.GetPunctuation("：") + string.Join(AppLocalizationService.GetPunctuation("，"), from x in obj.OfType<VmModuleBaseDecorator>().ToList()
			where !x.IsForbidden
			select x.VMModule?.FullName));
		obj.OfType<VmModuleBaseDecorator>().ToList().ForEach((VmModuleBaseDecorator p) =>
		{
			p.IsForbidden = true;
		});
	}

	private void ActivateItemsExecute(IList obj)
	{
		UILogManager.logCreate("信息", AppLocalizationService.GetLang("多模块启用") + AppLocalizationService.GetPunctuation("：") + string.Join(AppLocalizationService.GetPunctuation("，"), from x in obj.OfType<VmModuleBaseDecorator>().ToList()
			where x.IsForbidden
			select x.VMModule?.FullName));
		obj.OfType<VmModuleBaseDecorator>().ToList().ForEach((VmModuleBaseDecorator p) =>
		{
			p.IsForbidden = false;
		});
	}

	internal void OpenGroupCommandExecute(IDecorate obj)
	{
		if (obj is VmGroupDecorator vmGroupDecorator)
		{
			if (vmGroupDecorator.IsForbidden || !((!vmGroupDecorator.IsLoadFailed) ?? true))
			{
				return;
			}
			if (vmGroupDecorator.IsPasswordEnabledA)
			{
				PasswordCheckWindow passwordCheckWindow = new PasswordCheckWindow();
				passwordCheckWindow.OriginalPassword = vmGroupDecorator.PasswordA;
				passwordCheckWindow.ShowInTaskbar = false;
				passwordCheckWindow.ShowDialog();
				if (passwordCheckWindow.IsPasswordOK)
				{
					DisplayModuleSet = obj;
				}
			}
			else
			{
				DisplayModuleSet = obj;
			}
		}
		else
		{
			DisplayModuleSet = obj;
		}
	}

	internal void SearchModulePopupCommand(SearchPopupModel ts)
	{
		IList<string> list = ts.FullPath.Split('.');
		if (list.Count() > 1)
		{
			DisplayModuleSet = GetTargetDisplay(this, list, 1) as IDecorate;
		}
		else
		{
			DisplayModuleSet = this;
		}
		VmModule vmModule = (DisplayModuleSet.DecorateSource as VmModuleSet).Modules.FirstOrDefault((VmModule x) => x.ID.ToString() == ts.Id);
		IVmModule vmModule2;
		if ((vmModule2 = vmModule) != null)
		{
			SearchModel searchModel = new SearchModel();
			searchModel.Source = vmModule2;
			searchModel.targetPosition = ((vmModule2.Position is Point point) ? point : GetTargetPoint(vmModule2));
			SearchModel searchModel2 = searchModel;
			SelectedModule = searchModel2;
			searchModel2 = null;
			SelectedModule = null;
		}
	}

	private object GetTargetDisplay(VmModuleBaseDecorator decorator, IList<string> currentPath, int i)
	{
		object targetCurrentDisplay = GetTargetCurrentDisplay(decorator, currentPath[i]);
		if (i == currentPath.Count() - 1 || targetCurrentDisplay == null)
		{
			return targetCurrentDisplay;
		}
		return GetTargetDisplay(targetCurrentDisplay as VmModuleBaseDecorator, currentPath, ++i);
	}

	private object GetTargetCurrentDisplay(VmModuleBaseDecorator decorator, string path)
	{
		foreach (object decorateChild in decorator.DecorateChildren)
		{
			if (((decorateChild as VmModuleBaseDecorator)?.DecorateSource as IVmModule)?.Name == path)
			{
				return decorateChild;
			}
		}
		return null;
	}

	internal void SearchModuleCommandExecute(DiagramEventArgs ts)
	{
		IList<SearchPathInfo> currentPath = (ts.Param as IList<SearchPathInfo>).Reverse().ToList();
		if (currentPath.Count() > 2)
		{
			DisplayModuleSet = GetTargetDecorator(this, currentPath, currentPath.Count() - 1) as IDecorate;
		}
		else
		{
			DisplayModuleSet = this;
		}
		VmModule vmModule = (DisplayModuleSet.DecorateSource as VmModuleSet).Modules.FirstOrDefault((VmModule x) => x.ID == currentPath[currentPath.Count() - 1].nodeID);
		IVmModule vmModule2;
		if ((vmModule2 = vmModule) != null)
		{
			SearchModel searchModel = new SearchModel();
			searchModel.Source = vmModule2;
			searchModel.targetPosition = ((vmModule2.Position is Point point) ? point : GetTargetPoint(vmModule2));
			SearchModel searchModel2 = searchModel;
			SelectedModule = searchModel2;
			searchModel2 = null;
			SelectedModule = null;
		}
	}

	private Point GetTargetPoint(IVmModule module)
	{
		byte[] array = module.UserData["Position"];
		if (array != null)
		{
			return ExternalCallHelper.BytesToStruct<Point>(array, 0, array.Length);
		}
		return new Point(0.0, 0.0);
	}

	private object GetTargetDecorator(VmModuleBaseDecorator decorator, IList<SearchPathInfo> currentPath, int i)
	{
		object targetObject = GetTargetObject(decorator, currentPath[currentPath.Count() - i].nodeID);
		if (targetObject == null || i == 2)
		{
			return targetObject;
		}
		return GetTargetDecorator(targetObject as VmModuleBaseDecorator, currentPath, --i);
	}

	private object GetTargetObject(VmModuleBaseDecorator decorator, uint targetID)
	{
		foreach (object decorateChild in decorator.DecorateChildren)
		{
			IVmModule obj = (decorateChild as VmModuleBaseDecorator)?.DecorateSource as IVmModule;
			if (obj != null && obj.ID == targetID)
			{
				return decorateChild;
			}
		}
		return null;
	}

	private void UpCommandExecute()
	{
		object parent = (displayModuleSet.DecorateSource as IVmFrameBase).Parent;
		if (parent == DecorateSource)
		{
			DisplayModuleSet = this;
			return;
		}
		DisplayModuleSet = new VmGroupDecorator
		{
			DecorateSource = parent
		};
	}
}
