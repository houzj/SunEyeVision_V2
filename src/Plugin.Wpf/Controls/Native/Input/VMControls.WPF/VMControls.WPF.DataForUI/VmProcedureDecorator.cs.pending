				OnPropertyChanged("IsShowAtSingleProcedureMode");
			}
		}
	}

	/// <summary>
	/// 是否受全局按钮控制
	/// </summary>
	public bool IsEnabled
	{
		get
		{
			return !VMProcedure.IsForbidden;
		}
		set
		{
			if (VMProcedure.IsForbidden != !value)
			{
				VMProcedure.IsForbidden = !value;
				OnPropertyChanged("IsEnable");
			}
		}
	}

