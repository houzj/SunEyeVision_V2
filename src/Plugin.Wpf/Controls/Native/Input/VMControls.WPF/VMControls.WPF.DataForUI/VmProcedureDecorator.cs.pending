	/// <summary>
	/// 当前显示的数据
	/// </summary>
	public IDecorate DisplayModuleSet
	{
		get
		{
			return displayModuleSet;
		}
		set
		{
			IsSelected = true;
			if (value != displayModuleSet)
			{
				displayModuleSet = value;
				OnPropertyChanged("DisplayModuleSet");
				OnPropertyChanged("IsProcedure");
				OnPropertyChanged("IsDependentGroup");
			}
		}
	}

	public bool IsProcedure => DisplayModuleSet.DecorateSource is IVmProcedure;

	public bool IsDependentGroup => (VMProcedure as IVmModule).ID == 100000 && (DisplayModuleSet.DecorateSource as IVmModule).Parent == VMProcedure;

	/// <summary>
	/// 是否选中
	/// </summary>
