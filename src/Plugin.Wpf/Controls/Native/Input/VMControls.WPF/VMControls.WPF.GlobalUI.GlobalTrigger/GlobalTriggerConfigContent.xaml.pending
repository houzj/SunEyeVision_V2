<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI.GlobalTrigger.GlobalTriggerConfigContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:control="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:PCommon="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:localInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:tools="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localXmlParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:behavior="clr-namespace:VM.Utility;assembly=VM.Controls" xmlns:globaltrigger="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI.GlobalTrigger" xmlns:globalUI="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="source" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/CheckBoxStyle/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TabControlStyle/TabControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/PasswordBoxStyle/PasswordBoxStyle.xaml" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <globalUI:BoolToBackVisiableConverter x:Key="BoolBackToEnable" />
      <globaltrigger:LocalModuleToFullNameConverter x:Key="LocalToFullName" />
      <system:Double x:Key="TabItemHeight">36</system:Double>
      <system:Double x:Key="TabItemWidth">90</system:Double>
      <Style x:Key="TabItemTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12px" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      <Style x:Key="TabStackPanel" TargetType="{x:Type Grid}">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14px" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="OpenFileButton" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border BorderBrush="#B8B6B6" CornerRadius="2">
                <Image Name="icon" Height="32" Width="32" Source="/Apps.Style;component/Resources/ic_文件路径_normal.png" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_文件路径_hover.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ComboboxTree">
        <Border Name="Border" BorderThickness="1" BorderBrush="{DynamicResource ListViewComboBoxBordBrush}" CornerRadius="2" Background="{DynamicResource ListViewComboBoxBackground}">
          <localParamTab:TreeViewCombobox Height="30" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" ToggleButtonStyle="{StaticResource ComboxStyleBtn}" ItemsSource="{Binding EnumEntrysA}" ExternSelectedItem="{Binding TriggerSelectedObject, Mode=TwoWay}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localInterface:IVmModule}}" DataType="{x:Type localInterface:IVmModule}" ItemsSource="{Binding EnumEntrysA}">
                  <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16" FontWeight="Normal" Text="{Binding Name}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                </HierarchicalDataTemplate>
                <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localXmlParserTab:EnumEntry}}" DataType="{x:Type localXmlParserTab:EnumEntry}" ItemsSource="{Binding EnumEntrysA}">
                  <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Binding DisplayNameA}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                </HierarchicalDataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <localParamTab:TreeViewCombobox.ExternSelectedItemTemplate>
              <DataTemplate>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" FontSize="14" Text="{Binding ReservedProperty.FullName, Converter={StaticResource LocalToFullName}}" />
              </DataTemplate>
            </localParamTab:TreeViewCombobox.ExternSelectedItemTemplate>
          </localParamTab:TreeViewCombobox>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="GlobalTriggerItem">
        <Grid Margin="15,5,0,0" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Index}" />
          <StackPanel Name="stackEvent" Grid.Column="1" Margin="0,0,0,0" Orientation="Horizontal" Visibility="{Binding IsEventTrigger, Converter={StaticResource bool2VisibilityConverter}}">
            <ComboBox Width="209" Height="32" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding ReceiveEventList}" SelectedValue="{Binding CurEventIndex, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            <Button Name="btnOpenparam" Margin="5,0,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding OpenParamCommand}">
              <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_查看_normal.png" />
              <FrameworkElement.Tag>
                <Image Stretch="None" Source="/Apps.Style;component/Resources/ic_查看_click.png" />
              </FrameworkElement.Tag>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsStrTrigger, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBox Name="txtTrigger" Width="125" Margin="0,0,10,0" input:InputMethod.IsInputMethodEnabled="False" Style="{StaticResource NormalTextBoxStyle}" Text="{Binding TriggerString, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" TextChanged="TxtTrigger_TextChanged" />
            <ComboBox Height="32" Width="113" Margin="0,0,10,0" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding SelectMatchModes}" SelectedValue="{Binding MatchMode, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
          <ComboBox Name="cmbCommand" Grid.Column="2" Height="32" Width="113" Margin="0,0,10,0" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding SelectCommandTypes}" SelectedValue="{Binding Command, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
          <StackPanel Name="cmbProcess" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
            <ComboBox Name="cmbTriggerPro" Width="340" Height="32" DisplayMemberPath="DisplayNameA" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA}" SelectedValue="{Binding TriggerPeocessID, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            <ContentControl Name="conTriggerStr" Margin="5,0,0,0" Width="116" Tag="{DynamicResource TriggerString}" ContentTemplate="{StaticResource ButtonSelecter_Simple_tag_sub}" Content="{Binding ProTriggerSelector}" />
          </StackPanel>
          <ContentControl Name="cmbModule" Grid.Column="3" Visibility="Collapsed" Width="460" HorizontalAlignment="Left" ContentTemplate="{StaticResource ComboboxTree}" Content="{Binding}" />
          <StackPanel Name="cmbModuleAction" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
            <ContentControl Width="340" ContentTemplate="{StaticResource ComboboxTree}" Content="{Binding}" />
            <ComboBox Width="116" Height="32" Margin="5,0,0,0" DisplayMemberPath="DisplayNameALang" SelectedValuePath="StrValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding TriggerActionsA}" SelectedValue="{Binding ParamName, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
          <StackPanel Name="stackSolut" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox Width="340" Height="32" Padding="3,0,16,0" BorderBrush="#CCCCCC" Tag="{DynamicResource Lang_SolutionPath}" IsReadOnly="True" Style="{StaticResource NormalInput}" Text="{Binding SolutionPath}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
              <Button Height="32" Margin="-32,0,0,0" VerticalAlignment="Top" Style="{StaticResource OpenFileButton}" Command="{Binding PathSelectCommand}" />
            </StackPanel>
            <PasswordBox BorderBrush="#CCCCCC" Width="116" Height="32" Margin="5,0,0,0" IsEnabled="True" tools:PasswordBoxBindingHelper.Attach="True" input:InputMethod.IsInputMethodEnabled="False" Tag="{DynamicResource SubWindowPassword}" Background="#FFFFFFFF" Style="{StaticResource passwordBoxStyle}" tools:PasswordBoxBindingHelper.Password="{Binding Path=SolutionPasswd, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" />
          </StackPanel>
          <Button Grid.Column="4" Margin="-30,0,0,0" HorizontalAlignment="Center" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsAllowOperat, ElementName=source}">
            <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_normal.png" />
            <FrameworkElement.Tag>
              <Image Stretch="None" Source="/Apps.Style;component/Resources/delete_click.png" />
            </FrameworkElement.Tag>
          </Button>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Value="0" Binding="{Binding Command}">
            <Setter TargetName="cmbProcess" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbModule" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="stackSolut" Property="UIElement.Visibility" Value="Visible" />
            <Setter TargetName="cmbModuleAction" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Value="1" Binding="{Binding Command}">
            <Setter TargetName="cmbProcess" Property="UIElement.Visibility" Value="Visible" />
            <Setter TargetName="cmbModule" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="stackSolut" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbModuleAction" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Value="2" Binding="{Binding Command}">
            <Setter TargetName="cmbProcess" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbModule" Property="UIElement.Visibility" Value="Visible" />
            <Setter TargetName="stackSolut" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbModuleAction" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Value="3" Binding="{Binding Command}">
            <Setter TargetName="cmbProcess" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbModule" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="stackSolut" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbModuleAction" Property="UIElement.Visibility" Value="Visible" />
          </DataTrigger>
          <DataTrigger Value="false" Binding="{Binding IsEventTrigger}">
            <Setter TargetName="txtTrigger" Property="UIElement.Visibility" Value="Visible" />
            <Setter TargetName="stackEvent" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="conTriggerStr" Property="UIElement.Visibility" Value="Collapsed" />
            <Setter TargetName="cmbTriggerPro" Property="FrameworkElement.Width" Value="460" />
          </DataTrigger>
          <DataTrigger Value="2" Binding="{Binding MatchMode}">
            <Setter TargetName="cmbCommand" Property="UIElement.IsEnabled" Value="False" />
            <Setter TargetName="txtTrigger" Property="UIElement.IsEnabled" Value="False" />
          </DataTrigger>
          <DataTrigger Value="-1" Binding="{Binding CurEventIndex}">
            <Setter TargetName="btnOpenparam" Property="UIElement.IsEnabled" Value="False" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <Style x:Key="showTipLabel" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14px" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Label}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                  <Image Name="icon1" Margin="2,0,0,0" Height="18" Width="18" Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_help_normal.png">
                    <FrameworkElement.ToolTip>
                      <TextBlock Text="{TemplateBinding FrameworkElement.Tag}" Width="200" TextWrapping="Wrap" />
                    </FrameworkElement.ToolTip>
                  </Image>
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Back" Background="#00FFFFFF" Margin="2,0,2,0" Focusable="False">
                <ContentPresenter Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Back" Property="Border.Background" Value="#00FFFFFF" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Back" Property="Border.Background" Value="#00FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ScrollViewer}" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource RecScrollViewer}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource GlobalHeadGrid}">
    <TabControl Grid.Row="0" BorderThickness="0,1,0,0" BorderBrush="#E0DFDE" Background="{DynamicResource GlobalMouseOverBg}" Foreground="#FFF0F8FF" Margin="0,0,0,0" SelectedIndex="{Binding EventSelected, Mode=TwoWay}" MouseDown="TabControl_MouseDown">
      <TabItem Width="{StaticResource TabItemWidth}" Height="{StaticResource TabItemHeight}" Style="{StaticResource NorTablItemStyle}">
        <HeaderedContentControl.Header>
          <Grid Style="{StaticResource TabStackPanel}">
            <TextBlock Text="{DynamicResource Lang_EventTrigger}" Style="{StaticResource TabItemTextStyle}" />
          </Grid>
        </HeaderedContentControl.Header>
        <Grid IsEnabled="{Binding Path=SolutionData.(VMInterface:IVMRun.IsRunning), ElementName=source, Converter={StaticResource BoolBackToEnable}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Height="30" Margin="20,5,5,0" Background="{DynamicResource GlobalMouseOverBg}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50" />
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Lang_GlobalVariableIndex}" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Lnag_TriggerEvent}" />
            <TextBlock Grid.Column="2" Text="{DynamicResource CommandType}" />
            <TextBlock Grid.Column="3" Text="{DynamicResource Lang_TriggerOperate}" />
            <TextBlock Grid.Column="4" Text="{DynamicResource Lang_Operate}" />
          </Grid>
          <ListBox Grid.Row="1" UseLayoutRounding="True" BorderThickness="0" HorizontalContentAlignment="Stretch" MaxHeight="510" ItemTemplate="{StaticResource GlobalTriggerItem}" Background="{DynamicResource GlobalMouseOverBg}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ItemContainerStyle="{StaticResource ListBoxItemStyle}" ItemsSource="{Binding CommEventTriggerA}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <i:Interaction.Behaviors>
              <behavior:ListBoxBehavior />
            </i:Interaction.Behaviors>
          </ListBox>
          <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="20,10,0,20" Height="32" Style="{StaticResource addButton}" FontSize="14px" CommandParameter="0" Command="{Binding AddCommand}" IsEnabled="{Binding IsAllowOperat, ElementName=source}" />
        </Grid>
      </TabItem>
      <TabItem Width="{StaticResource TabItemWidth}" Height="{StaticResource TabItemHeight}" Style="{StaticResource NorTablItemStyle}">
        <HeaderedContentControl.Header>
          <Grid Style="{StaticResource TabStackPanel}">
            <TextBlock Text="{DynamicResource Lang_CharacterTrigger}" Style="{StaticResource TabItemTextStyle}" />
          </Grid>
        </HeaderedContentControl.Header>
        <Grid IsEnabled="{Binding Path=SolutionData.(VMInterface:IVMRun.IsRunning), ElementName=source, Converter={StaticResource BoolBackToEnable}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Height="30" Margin="20,5,5,0" Background="{DynamicResource GlobalMouseOverBg}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Lang_GlobalVariableIndex}" />
            <TextBlock Grid.Column="1" Text="{DynamicResource TriggerString}" />
            <Label Grid.Column="2" Content="{DynamicResource MatchMode}" Style="{StaticResource showTipLabel}" Tag="{DynamicResource Lang_GlobalTriggerMatch}" />
            <TextBlock Grid.Column="3" Text="{DynamicResource CommandType}" />
            <TextBlock Grid.Column="4" Text="{DynamicResource Lang_TriggerOperate}" />
            <TextBlock Grid.Column="5" Text="{DynamicResource Lang_Operate}" />
          </Grid>
          <ListBox Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="510" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" Style="{StaticResource listboxItemStyle1}" ItemTemplate="{StaticResource GlobalTriggerItem}" Background="{DynamicResource GlobalMouseOverBg}" ItemContainerStyle="{StaticResource ListBoxItemStyle}" ItemsSource="{Binding CommStrTriggerA}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <i:Interaction.Behaviors>
              <behavior:ListBoxBehavior />
            </i:Interaction.Behaviors>
          </ListBox>
          <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="20,10,0,20" Height="32" Style="{StaticResource addButton}" FontSize="14px" CommandParameter="1" Command="{Binding AddCommand}" IsEnabled="{Binding IsAllowOperat, ElementName=source}" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>