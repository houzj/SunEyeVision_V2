<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI.AddLightSourceDeviceDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:AppParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="paramWindow" Height="420" Width="370" xmlns:globalui="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI" Loaded="paramWindow_Loaded" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:vm_port_2="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <x:StaticExtension Member="vm_port_2:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="MyInteger">
        <vm_port_1:LeftRightControl Height="32" ChildLeftWidth="{Binding LeftTextWidth, ElementName=paramWindow}">
          <vm_port_1:LeftRightControl.LeftContent>
            <Control Template="{StaticResource TextLeft}" />
          </vm_port_1:LeftRightControl.LeftContent>
          <vm_port_1:LeftRightControl.RightContent>
            <ContentControl ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding}" />
          </vm_port_1:LeftRightControl.RightContent>
        </vm_port_1:LeftRightControl>
      </DataTemplate>
      <DataTemplate x:Key="MyEnumeration">
        <vm_port_1:LeftRightControl Height="32" ChildLeftWidth="{Binding LeftTextWidth, ElementName=paramWindow}">
          <vm_port_1:LeftRightControl.LeftContent>
            <Control Template="{StaticResource TextLeft}" />
          </vm_port_1:LeftRightControl.LeftContent>
          <vm_port_1:LeftRightControl.RightContent>
            <ContentControl ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding}" />
          </vm_port_1:LeftRightControl.RightContent>
        </vm_port_1:LeftRightControl>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource GlobalMouseOverBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <ScrollViewer Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" Tag="1">
      <StackPanel Focusable="True" Margin="8,0,0,0">
        <Grid Visibility="{Binding IsAdd, ElementName=paramWindow, Converter={StaticResource bool2VisibilityConverter}}">
          <StackPanel>
            <TextBlock Margin="10,10,0,0" Text="{DynamicResource Tab_Basic Params}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ModuleForeground}" />
            <Grid Margin="34,8,40,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftTextWidth, ElementName=paramWindow}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="8" />
                <RowDefinition Height="32" />
                <RowDefinition Height="8" />
                <RowDefinition Height="32" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Lang_Brand}" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding BrandsA, Mode=OneWay}" SelectedItem="{Binding DisplayBrandA}" />
              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource ProtocolType}" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" />
              <ComboBox Grid.Row="2" Grid.Column="1" IsEnabled="False" ItemsSource="{Binding CommTypesA, Mode=OneWay}" SelectedItem="{Binding CommTypeA}" />
              <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource 设备名称}" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" />
              <TextBox Grid.Row="4" Grid.Column="1" MaxLength="128" FontSize="14" Style="{StaticResource NormalTextBoxStyle}" Text="{Binding NameA}" />
            </Grid>
            <Rectangle Margin="10,10,20,0" StrokeThickness="0" Height="1" Fill="{DynamicResource GlobalRectFill}" />
            <TextBlock Margin="10,10,0,0" Text="{DynamicResource Tab_Com Param}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ModuleForeground}" />
            <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding ComName}" />
            <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" IsEnabled="False" Content="{Binding BaudRate}" />
            <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" IsEnabled="False" Content="{Binding DataBits}" />
            <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" IsEnabled="False" Content="{Binding ParityBit}" />
            <ContentControl Margin="34,8,40,8" ContentTemplate="{StaticResource MyEnumeration}" IsEnabled="False" Content="{Binding StopBit}" />
          </StackPanel>
        </Grid>
        <Grid Margin="34,8,40,0" Visibility="{Binding IsReName, ElementName=paramWindow, Converter={StaticResource bool2VisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftTextWidth, ElementName=paramWindow}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="32" />
            <RowDefinition Height="24" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource 设备名称}" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" />
          <TextBox Name="tbName" Grid.Row="1" Grid.Column="1" MaxLength="64" FontSize="14" Style="{StaticResource NormalTextBoxStyle}" Text="{Binding ConfigName, ElementName=paramWindow}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderThickness="0" Background="{DynamicResource GlobalBorderBg}">
      <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Confirm_Click" />
    </Border>
  </Grid>
</vm_port_0:BaseWindow>