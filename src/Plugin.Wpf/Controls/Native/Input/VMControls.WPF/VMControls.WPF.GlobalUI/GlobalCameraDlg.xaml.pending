<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI.GlobalCameraDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:commomcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI" x:Name="GlobalModuleWindow" Height="480" Width="680" Title="{vm_port_0_:LangResource Lang_CameraSet}" Closed="GlobalModuleWindow_Closed" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:vm_port_2="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:interactivity="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:core="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <vm_port_0:BaseWindow.TitleBar>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Foreground="{DynamicResource Col_SubForm_HeaderBrush_Foreground}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" FontWeight="Bold" Text="{vm_port_0_:LangResource Lang_CameraSet}" />
      <Button Margin="8,0" ToolTip="{DynamicResource Lang_Help}" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ElementName=GlobalModuleWindow, Path=OpenHelpCommand}">
        <ContentControl.Content>
          <Image Name="img" Width="14" Height="14" Stretch="Uniform" Source="/Apps.Style;component/Resources/btn_help.png" />
        </ContentControl.Content>
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="border" Width="30" Height="26" Background="#00FFFFFF" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Value="{DynamicResource Col_Menubar_Shortcut_Selected_Background}" Property="Border.Background" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
    </StackPanel>
  </vm_port_0:BaseWindow.TitleBar>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <x:StaticExtension Member="vm_port_2:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
          <Style.Setters>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                  <Border Name="bd" SnapsToDevicePixels="True" BorderThickness="0" Background="#00FFFFFF" Height="35px" Padding="{TemplateBinding Control.Padding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{Binding ID}" />
                      <TextBlock Name="tbName" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Background="#00FFFFFF" Width="110" Text="{Binding Name}" ToolTip="{Binding Name}" />
                    </Grid>
                    <FrameworkElement.ContextMenu>
                      <vm_port_0:HikContextMenu>
                        <MenuItem Name="menuItem_RenameDev" Header="{DynamicResource Lang_Rename}" Command="{Binding ReNameDevCommand, Source={x:Static local:GlobalCameraManager.Instance}}" />
                        <MenuItem Name="menuItem_DeleteDev" Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteItemCommand, Source={x:Static local:GlobalCameraManager.Instance}}" IsEnabled="{Binding Path=IsAllowOperate, Source={x:Static local:GlobalCameraManager.Instance}}" />
                      </vm_port_0:HikContextMenu>
                    </FrameworkElement.ContextMenu>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter Value="{DynamicResource GlobalMouseOverBg}" TargetName="bd" Property="Border.Background" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Value="{DynamicResource GlobalMouseOverBg}" TargetName="bd" Property="Border.Background" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="{Binding IsVisibleInGlobalModuleManager, Converter={StaticResource bool2VisibilityConverter}}" />
          </Style.Setters>
        </Style>
        <Style x:Key="MoreToggleButtonStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="Height" Value="20" />
          <Setter Property="Width" Value="20" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid>
                  <Image Name="icon" Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
                  <Popup Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False" IsOpen="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="#FCFCFC" MinWidth="132" MinHeight="124" CornerRadius="0" BorderThickness="1" BorderBrush="#CCCCCD">
                      <ItemsControl Margin="5" ItemsSource="{Binding Path=CameraListA}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="ItemsPanel">
                              <Setter.Value>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                              </Setter.Value>
                            </Setter>
                            <Setter Property="ItemTemplate">
                              <Setter.Value>
                                <DataTemplate>
                                  <Grid>
                                    <FrameworkElement.Resources>
                                      <ResourceDictionary>
                                        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
                                          <Setter Property="Foreground" Value="#808080" />
                                          <Setter Property="FontSize" Value="12px" />
                                          <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                          <Setter Property="HorizontalAlignment" Value="Center" />
                                          <Setter Property="VerticalAlignment" Value="Center" />
                                          <Setter Property="Template">
                                            <Setter.Value>
                                              <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid>
                                                  <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition Height="1" />
                                                  </Grid.RowDefinitions>
                                                  <Border Name="Border" Background="#00FFFFFF" Padding="24,0">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                  </Border>
                                                  <Border Name="bd" Grid.Row="1" Background="#F76900" Visibility="Hidden" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Border.Background" Value="#E7E5E4" />
                                                    <Setter TargetName="bd" Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="#4D4D4D" />
                                                  </Trigger>
                                                </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                            </Setter.Value>
                                          </Setter>
                                        </Style>
                                      </ResourceDictionary>
                                    </FrameworkElement.Resources>
                                    <Button HorizontalAlignment="Stretch" Height="28" Content="{vm_port_0_:ResourceBinding Type}">
                                      <interactivity:Interaction.Triggers>
                                        <interactivity:EventTrigger EventName="Click">
                                          <commomcontrol:ParamsEventCommand Command="{Binding ClickCommand, Source={x:Static local:GlobalCameraManager.Instance}}" CommandParameter="{Binding}" />
                                          <core:ChangePropertyAction PropertyName="IsOpen" Value="false" interactivity:TargetedTriggerAction.TargetObject="{Binding ElementName=Popup}" />
                                        </interactivity:EventTrigger>
                                      </interactivity:Interaction.Triggers>
                                    </Button>
                                  </Grid>
                                </DataTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </FrameworkElement.Style>
                      </ItemsControl>
                    </Border>
                  </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/add_click.png" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/add_click.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <ControlTemplate x:Key="TextBoxControlTemplate1" TargetType="{x:Type TextBox}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="0" Background="#00FFFFFF" Focusable="False" Uid="Border_17">
            <ScrollViewer Name="PART_ContentHost" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" Uid="ScrollViewer_1" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Background="{DynamicResource GlobalGridBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource 设备列表}" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="14" FontWeight="Bold" />
        <ToggleButton Name="btnAddDevice" Grid.Column="1" Margin="0,0,14,0" Style="{DynamicResource MoreToggleButtonStyle}" HorizontalAlignment="Right" IsEnabled="{Binding IsAllowOperate}" Command="{Binding AddDevCommand}" />
      </Grid>
      <Grid Row="1">
        <ScrollViewer Name="scrViewDevList" Style="{StaticResource RecScrollViewer}" Tag="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ListView Name="DevList" Background="{DynamicResource GlobalGridBg}" Margin="0,0,-1,0" BorderThickness="0" ItemsSource="{Binding ItemsA}" SelectedItem="{Binding CurDeviceA, Mode=TwoWay}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Column="1" Background="{DynamicResource GlobalMouseOverBg}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Root, Source={x:Static local:GlobalCameraManager.Instance}}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid Background="{DynamicResource GlobalHeadGrid}" />
      <vm_port_1:ParamsTabUserControl Name="paramstab" ChildMargin="32,1,145,0" Grid.RowSpan="2" DataContext="{Binding Root, Source={x:Static local:GlobalCameraManager.Instance}}" />
      <Grid Name="windowShadow" Background="{DynamicResource WindowShadow}" Visibility="{Binding IsMaskVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource GlobalBorderBg}">
      <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Confirm_Click" />
    </Border>
  </Grid>
</vm_port_0:BaseWindow>