using System.Collections.Generic;
using Apps.XmlParser.ParamTab;
using Hik.Util;
using VM.Controls;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI;

public class GlobalTriggerStrItem(ITriggerConfig triggerConfig) : ComTriggerItem(triggerConfig)
{
	private int _matchMode = 0;

	private string _triggerString = null;

	public virtual List<EnumEntry> SelectMatchModes => new List<EnumEntry>
	{
		new EnumEntry
		{
			DisplayNameA = "ExactMatch",
			ValueA = 0
		},
		new EnumEntry
		{
			DisplayNameA = "PartialMatch",
			ValueA = 1
		},
		new EnumEntry
		{
			DisplayNameA = "NoneMatch",
			ValueA = 2
		}
	};

	public int MatchMode
	{
		get
		{
			return _matchMode;
		}
		set
		{
			if (_matchMode != value)
			{
				_matchMode = value;
				OnPropertyChanged("MatchMode");
				if (_matchMode == 2)
				{
					Command = 1;
				}
			}
		}
	}

	public string TriggerString
	{
		get
		{
			return _triggerString;
		}
		set
		{
			if (_triggerString != value)
			{
				int byteCount = StringUtil.GetByteCount(value);
				if (byteCount > 128)
				{
					HikMessageBox.Show("Lang_ParamNameErr", "Lang_PmNameLong", MessageIcons.Error, isTranslate: true);
					return;
				}
				_triggerString = value;
				OnPropertyChanged("TriggerString");
			}
		}
	}
}
