	private void TextBox_PreviewKeyDown(object sender, KeyEventArgs e)
	{
		if (e.Key == Key.Space && sender != null && sender is TextBox { Name: "itemNameTxt" })
		{
			e.Handled = true;
		}
		else if (e.Key == Key.Return)
		{
			txtFocus.Focus();
		}
	}

	/// <summary>
	/// 置顶操作，交换操作，需要通知动态io重新下发至底层，否则保存后加载会有问题
	/// 这里需要通知到发送数据和接收数据 模块进行更改
	/// </summary>
	private void SetHeadIndex(int currentIndex)
	{
		IsMoveItem = true;
		GlobalVariableItem globalVariableItem = Items.FirstOrDefault((GlobalVariableItem x) => x.Index == currentIndex);
		if (globalVariableItem == null)
		{
			return;
		}
		List<GlobalVariableItem> list = (from p in Items
			where p.VarGroupInfo == SelectGroupItem.Name
			orderby p.Index
			select p).ToList();
		int index = list[0].Index;
		for (int num = 0; num < Items.Count; num++)
		{
			if (index <= Items[num].Index && Items[num].Index < currentIndex)
			{
				Items[num].Index = Items[num].Index + 1;
			}
		}
		int index2 = globalVariableItem.Index;
		globalVariableItem.Index = index;
		varManager.ModifyIndex(globalVariableItem.Name, globalVariableItem.Index, bSetTop: true, index);
		int currentPageNum = CurrentPageNum;
		int num2 = -1;
		if (IsSearchState)
		{
			num2 = iSearchCount.FindIndex((int x) => x == currentIndex);
			for (int num3 = 0; num3 < num2; num3++)
			{
				iSearchCount[num3] += 1;
			}
			if (num2 > -1)
			{
				iSearchCount[num2] = 1;
			}
			iSearchCount = iSearchCount.OrderBy((int x) => x).ToList();
		}
		CurrentPageNum = 1;
		if (currentPageNum == CurrentPageNum)
		{
			if (!IsSearchState)
			{
				SetBindData();
			}
			else
			{
				SetBindSearchData();
			}
		}
		LogHelper.Info($"SetHeadIndex varName:{globalVariableItem.Name} sourceindex:{index2},index:{index}");
		varManager.ChangeToSendReceiveData(currentIndex, index, isDel: false, isReset: false, isSetTop: true);
		UpdateBtnEnable();
		IsMoveItem = false;
	}

	/// <summary>
	/// 交换全局变量的位置
	/// </summary>
	private void SwapIndex(int souceIndex, int destIndex, int destGroupIndex)
	{
		if (souceIndex < 0 || destIndex < 0)
		{
			return;
		}
		IsMoveItem = true;
		GlobalVariableItem globalVariableItem = Items.FirstOrDefault((GlobalVariableItem x) => x.Index == souceIndex);
		if (globalVariableItem == null)
		{
			return;
		}
		GlobalVariableItem globalVariableItem2 = Items.FirstOrDefault((GlobalVariableItem x) => x.Index == destIndex);
		if (globalVariableItem2 == null)
		{
			return;
		}
		varManager.ModifyIndex(globalVariableItem.Name, destIndex);
		varManager.ModifyIndex(globalVariableItem2.Name, souceIndex);
		globalVariableItem2.Index = souceIndex;
		globalVariableItem.Index = destIndex;
		int currentPageNum = CurrentPageNum;
		int num = (IsSearchState ? iSearchCount.Count() : Items.Count((GlobalVariableItem x) => x.VarGroupInfo == SelectGroupItem.Name));
		int num2 = num / PageCount + 1;
		int num3 = -1;
		if (IsSearchState)
		{
			num3 = iSearchCount.FindIndex((int x) => x == souceIndex);
			int num4 = iSearchCount.FindIndex((int x) => x == destIndex);
			if (num3 > -1)
			{
				iSearchCount[num3] = destIndex;
			}
			if (num4 > -1)
			{
				iSearchCount[num4] = souceIndex;
			}
			iSearchCount = iSearchCount.OrderBy((int x) => x).ToList();
		}
		CurrentPageNum = (IsSearchState ? (num3 / PageCount + 1) : (destGroupIndex / PageCount + 1));
		if (currentPageNum == CurrentPageNum)
		{
			if (!IsSearchState)
			{
				SetBindData();
			}
			else
			{
				SetBindSearchData();
			}
		}
		LogHelper.Info($"SwapIndex srcVarName:{globalVariableItem.Name} sourceindex:{souceIndex},dstVarName:{globalVariableItem2.Name} dstindex:{destIndex}");
		varManager.ChangeToSendReceiveData(souceIndex, destIndex, isDel: false);
		UpdateBtnEnable();
		IsMoveItem = false;
	}

	private void GridGlob_MouseDown(object sender, MouseButtonEventArgs e)
	{
		if ((sender as FrameworkElement).DataContext is GlobalVariableItem globalVariableItem)
		{
			globalVariableItem.IsSelected = true;
			if (oldSelectedItem != null && oldSelectedItem.Name != globalVariableItem.Name)
			{
				oldSelectedItem.IsSelected = false;
			}
			oldSelectedItem = globalVariableItem;
			UpdateBtnEnable();
		}
	}

	private void UpdateBtnEnable()
	{
		List<GlobalVariableItem> list = (from p in Items
			where p.VarGroupInfo == SelectGroupItem.Name
			orderby p.Index
			select p).ToList();
		int num = list.IndexOf(oldSelectedItem);
		if (oldSelectedItem == null || list.Count == 1)
		{
			btnTop.IsEnabled = false;
			btnUp.IsEnabled = false;
			btnDown.IsEnabled = false;
		}
		else if (num == 0)
		{
			btnTop.IsEnabled = false;
			btnUp.IsEnabled = false;
			btnDown.IsEnabled = true;
		}
		else if (num == list.Count - 1)
		{
			btnDown.IsEnabled = false;
			btnTop.IsEnabled = true;
			btnUp.IsEnabled = true;
		}
		else
		{
			btnTop.IsEnabled = true;
			btnUp.IsEnabled = true;
			btnDown.IsEnabled = true;
		}
	}

	/// <summary>
	/// 上移
	/// </summary>
	private void BtnUp_Click(object sender, RoutedEventArgs e)
	{
		if (oldSelectedItem == null)
		{
			return;
		}
		int destIndex = 0;
		int destGroupIndex = 0;
		List<GlobalVariableItem> list = (from p in Items
			where p.VarGroupInfo == SelectGroupItem.Name
			orderby p.Index
			select p).ToList();
		for (int num = 0; num < list.Count; num++)
		{
			if (list[num].Index == oldSelectedItem.Index)
			{
				destIndex = list[num - 1].Index;
				destGroupIndex = num - 1;
				break;
			}
		}
		SwapIndex(oldSelectedItem.Index, destIndex, destGroupIndex);
		_selectedVarItem = oldSelectedItem;
		OnPropertyChanged("SelectedVarItem");
	}

	/// <summary>
	/// 下移
	/// </summary>
	private void BtnDown_Click(object sender, RoutedEventArgs e)
	{
		if (oldSelectedItem == null)
		{
			return;
		}
		int destIndex = 0;
		int destGroupIndex = 0;
		List<GlobalVariableItem> list = (from p in Items
			where p.VarGroupInfo == SelectGroupItem.Name
			orderby p.Index
			select p).ToList();
		for (int num = 0; num < list.Count; num++)
		{
			if (list[num].Index == oldSelectedItem.Index)
			{
				destIndex = list[num + 1].Index;
				destGroupIndex = num + 1;
				break;
			}
		}
		SwapIndex(oldSelectedItem.Index, destIndex, destGroupIndex);
		_selectedVarItem = oldSelectedItem;
		OnPropertyChanged("SelectedVarItem");
	}

	/// <summary>
	/// 置顶
	/// </summary>
	private void BtnTop_Click(object sender, RoutedEventArgs e)
	{
		if (oldSelectedItem != null)
		{
			SetHeadIndex(oldSelectedItem.Index);
			_selectedVarItem = oldSelectedItem;
			OnPropertyChanged("SelectedVarItem");
		}
	}

	private void BtnImport_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			if (DecorateSource == null)
			{
				return;
			}
			if (!RemoteOperate.IsRemoteMode)
			{
				Microsoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();
				openFileDialog.CheckFileExists = true;
				openFileDialog.CheckPathExists = true;
				openFileDialog.Filter = "*.gvar|*.gvar";
				bool? flag = openFileDialog.ShowDialog();
				string fileName = openFileDialog.FileName;
				if (flag.Value && (Items.Count <= 0 || HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImportSure"), AppLocalizationService.GetLang("Lang_ImportEmpty"), MessageButtons.YesOrNo, MessageIcons.Question) == SunEyeVision.Plugin.Wpf.Native.Display.VMControls.DialogResult.Yes))
				{
					long length = new FileInfo(fileName).Length;
					ProcessbarMessage = AppLocalizationService.GetLang("Lang_Import");
					IsShowProcessbar = "Visible";
					ImportGlobalVar(fileName);
				}
			}
			else
			{
				PopImport.IsOpen = true;
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_LoadFail"));
			LogHelper.objLog.Error("全局变量导入失败，ex:" + ex.ToString());
		}
	}

	private async void ImportGlobalVar(string filePath)
	{
		int nRet = 0;
		Task importTask = Task.Factory.StartNew(() =>
		{
			try
			{
				Dictionary<string, VarRunParamInfo[]> varRunParamDict = new Dictionary<string, VarRunParamInfo[]>();
				Dispatcher?.Invoke(() =>
				{
					foreach (GlobalVariableItem item in Items)
					{
						varRunParamDict.Add(item.Name, GlobalVarExtern.GetLinkModuleInfoByRunParams(item.SelectedRunParams));
					}
				});
				varManager.ImportVar(filePath, isFromUI: true, varRunParamDict, () =>
				{
					Dispatcher?.Invoke(() =>
					{
						if (DecorateSource is VmModule vmModule)
						{
							for (int num = vmModule.Outputs.Count - 1; num >= 0; num--)
							{
								vmModule.Outputs[num].Dispose();
							}
						}
					});
				});
			}
			catch (Exception ex)
			{
				Dispatcher.Invoke(() =>
				{
					IsShowProcessbar = "Collapsed";
					HikMessageBox.Show(AppLocalizationService.GetLang("Lang_LoadFail"), MessageIcons.Error);
				});
				LogHelper.objLog.Error("导入失败:" + ex.ToString());
				return;
			}
			if (nRet == 0)
			{
				oldSelectedItem = null;
				Dispatcher.Invoke(() =>
				{
					SelectGroupItem?.Clear();
					SelectGroupItem = null;
					VarItemGroups?.Clear();
					Items.Clear();
					CurrentPageNum = 0;
					ItemsTotalCount = 0;
					UpdateBtnEnable();
					bFirstGetData = true;
					GetVarGroupMsg();
					VariableManager.IMVS_VARIABLE[] vARIABLEs = new VariableManager.IMVS_VARIABLE[0];
					varManager.GetAllVar(ref vARIABLEs);
					GetData(vARIABLEs);
				});
			}
			string msg = ((nRet == 0) ? AppLocalizationService.GetLang("Lang_LoadSuccess") : AppLocalizationService.GetLang("Lang_LoadFail"));
			Dispatcher.Invoke(() =>
			{
				IsShowProcessbar = "Collapsed";
				HikMessageBox.Show(msg, (nRet == 0) ? MessageIcons.Ok : MessageIcons.Error);
			});
		});
		await importTask;
	}

	private void BtnExport_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			if (DecorateSource == null || Items.Count <= 0)
			{
				return;
			}
			if (!RemoteOperate.IsRemoteMode)
			{
				Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog();
				saveFileDialog.Filter = "*.gvar|*.gvar";
				saveFileDialog.FilterIndex = 1;
				saveFileDialog.RestoreDirectory = true;
				if (saveFileDialog.ShowDialog() == true)
				{
					ExportGlobalVar(saveFileDialog.FileName);
				}
			}
			else
			{
				PopExport.IsOpen = true;
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ExportFailed"));
			LogHelper.objLog.Error("全局变量导出失败，ex:" + ex.ToString());
		}
	}

	private async void ExportGlobalVar(string filePath, string downLoadPath = "")
	{
		Task exportTask = Task.Factory.StartNew(() =>
		{
			int nRet = 0;
			try
			{
				varManager.ExportVar(filePath);
			}
			catch (Exception ex)
			{
				Dispatcher.Invoke(() =>
				{
					HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ExportFailed"), MessageIcons.Error);
				});
				LogHelper.objLog.Error("导出全局变量失败:" + ex.ToString());
				return;
			}
			if (downLoadPath != "")
			{
				if (!ServerSDKAPI.FtpDownloadFile(CVmObjectBase.mhandle, downLoadPath, filePath, bCover: true) || !File.Exists(downLoadPath))
				{
					LogHelper.objLog.Error("Down load file error, local file path = " + downLoadPath + ", remote file path = " + filePath + ".");
					HikMessageBox.Show(AppLocalizationService.GetLang("导出失败"), MessageIcons.Error);
					return;
				}
				ServerSDKAPI.FtpRemoveFile(CVmObjectBase.mhandle, filePath);
			}
			string msg = ((nRet == 0) ? "Lang_ExportSuccess" : "导出失败");
			Dispatcher.Invoke(() =>
			{
				HikMessageBox.Show(AppLocalizationService.GetLang(msg), (nRet == 0) ? MessageIcons.Ok : MessageIcons.Error);
			});
		});
		await exportTask;
	}

	private void Sv_ScrollChanged(object sender, ScrollChangedEventArgs e)
	{
		if (!CanScroll)
		{
			CanScroll = true;
		}
		else if (!CanScroll)
		{
		}
	}

	/// <summary>
	/// 获取默认的分组名
	/// </summary>
	/// <returns></returns>
	private string GetUniqueName(string startName)
	{
		IEnumerable<string> enumerable = VarItemGroups.Select((VarGroupItem p) => p.Name);
		string text = startName;
		int num = 0;
		while (true)
		{
			text = startName + num;
			if (!enumerable.Contains(text))
			{
				break;
			}
			num++;
		}
		return text;
	}

	/// <summary>
	/// 添加一个分组
	/// </summary>
	private void AddNewVarGroup()
	{
		if (VarItemGroups.Count() >= 10)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("添加") + AppLocalizationService.GetLang("超限") + ":" + 10, MessageButtons.Normal, MessageIcons.Warning);
			return;
		}
		string uniqueName = GetUniqueName(AppLocalizationService.GetLang("Lang_VarGroup"));
		varManager.AddGroup(uniqueName);
		VarItemGroups.Add(new VarGroupItem(uniqueName, this));
		SelectGroupItem = VarItemGroups[VarItemGroups.Count - 1];
	}

	private void AddVarGroup_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			AddNewVarGroup();
		}
		catch (Exception)
		{
			LogHelper.Error("AddNewVarGroup is exception:" + e.ToString());
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_AddGroup") + AppLocalizationService.GetLang("失败"), MessageButtons.Normal);
		}
	}

	private void DelVarGroup_Click(object sender, RoutedEventArgs e)
	{
		if (HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ConfirmDelete"), "", MessageButtons.YesOrNo, MessageIcons.Question) == SunEyeVision.Plugin.Wpf.Native.Display.VMControls.DialogResult.Yes)
		{
			object dataContext = (sender as MenuItem).DataContext;
			if (dataContext is VarGroupItem varGroup)
			{
				ProcessbarMessage = AppLocalizationService.GetLang("Lang_DeleteGroup");
				IsShowProcessbar = "Visible";
				DelVarGroup(varGroup);
			}
		}
	}

	/// <summary>
	/// 删除分组信息
	/// </summary>
	private async void DelVarGroup(VarGroupItem varGroup)
	{
		Task delTask = Task.Factory.StartNew(() =>
		{
			try
			{
				VmModule vmModule = DecorateSource as VmModule;
				varManager.DeleteGroup(varGroup.Name);
				List<GlobalVariableItem> tmplist = new List<GlobalVariableItem>();
				Dispatcher.Invoke(() =>
				{
					tmplist = Items.Where((GlobalVariableItem x) => x.VarGroupInfo == SelectGroupItem?.Name).ToList();
				});
				foreach (GlobalVariableItem item in tmplist)
				{
					varManager.DeleteVarFromGroup(item.Name, isFromUI: true, GlobalVarExtern.GetLinkModuleInfoByRunParams(item.SelectedRunParams));
				}
				Dispatcher.Invoke(() =>
				{
					tmplist.ForEach((GlobalVariableItem x) =>
					{
						Items.Remove(x);
					});
					tmplist.ForEach((GlobalVariableItem p) =>
					{
						vmModule.Outputs[p.Name]?.RemoveSelf();
					});
				});
				List<VarItem> allVarList = new List<VarItem>();
				varManager.GetAllVar(ref allVarList);
				Dispatcher.Invoke(() =>
				{
					allVarList.ForEach((VarItem m) =>
					{
						GlobalVariableItem globalVariableItem = Items.FirstOrDefault((GlobalVariableItem p) => p.Name == m.Name);
						if (globalVariableItem != null)
						{
							globalVariableItem.Index = m.Index;
						}
					});
				});
				string msg = AppLocalizationService.GetLang("Lang_DeleteSucceed");
				Dispatcher.Invoke(() =>
				{
					IsShowProcessbar = "Collapsed";
					HikMessageBox.Show(msg, MessageIcons.Ok);
				});
			}
			catch (Exception ex)
			{
				LogHelper.Error("DelVarGroup is exception:" + ex.ToString());
				string msg2 = AppLocalizationService.GetLang("Lang_DeleteFail");
				Dispatcher.Invoke(() =>
				{
					IsShowProcessbar = "Collapsed";
					HikMessageBox.Show(msg2, MessageIcons.Error);
				});
			}
		});
		await delTask;
		if (VarItemGroups.Count > 1)
		{
			SelectGroupItem = VarItemGroups[VarItemGroups.Count - 2];
		}
		else
		{
			SelectGroupItem = null;
		}
		if (VarItemGroups.Contains(varGroup))
		{
			VarItemGroups.Remove(varGroup);
		}
	}

	/// <summary>
	/// 下发分组信息
	/// </summary>
	public bool SetVarGroupMsg()
	{
		try
		{
			StringBuilder stringBuilder = new StringBuilder();
			foreach (VarGroupItem varItemGroup in VarItemGroups)
			{
				stringBuilder.Append(varItemGroup.Name).Append("\r");
			}
			if (stringBuilder.Length > 0)
			{
				(DecorateSource as VmModule).Params["VarGroupInfo"] = stringBuilder.ToString();
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error("SetVarGroupMsg is error:" + ex.ToString());
			return false;
		}
		return true;
	}

	/// <summary>
	/// 获取分组信息
	/// </summary>
	public bool GetVarGroupMsg()
	{
		try
		{
			List<string> list = new List<string>();
			varManager.GetGroupInfo(list);
			if (list.Count > 0)
			{
				Array.ForEach(list.ToArray(), (string x) =>
				{
					if (!string.IsNullOrEmpty(x))
					{
						VarItemGroups.Add(new VarGroupItem(x, this));
					}
				});
				SelectGroupItem = VarItemGroups[0];
			}
			else
			{
				AddNewVarGroup();
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error("GetVarGroupMsg is error:" + ex.ToString());
			return false;
		}
		return true;
	}

	/// <summary>
	/// 重命名
	/// </summary>
	/// <returns></returns>
	public bool ReName(string oldName, string newName)
	{
		try
		{
			if (VarItemGroups.FirstOrDefault((VarGroupItem x) => x.Name == newName) != null)
			{
				HikMessageBox.Show("Lang_ParamNameErr", "Lang_PmNameExited", MessageIcons.Error, isTranslate: true);
				return false;
			}
			IEnumerable<GlobalVariableItem> enumerable = Items.Where((GlobalVariableItem x) => x.VarGroupInfo == oldName);
			foreach (GlobalVariableItem item in enumerable)
			{
				item.VarGroupInfo = newName;
			}
			varManager.ReNameGroup(oldName, newName);
			return true;
		}
		catch (Exception ex)
		{
			LogHelper.Error("ReName is ecxeption:" + oldName + "," + newName + "," + ex.ToString());
			return false;
		}
	}

	private void LocalImport_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			Microsoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();
			openFileDialog.CheckFileExists = true;
			openFileDialog.CheckPathExists = true;
			openFileDialog.Filter = "*.gvar|*.gvar";
			bool? flag = openFileDialog.ShowDialog();
			string filePath = (flag.Value ? "/root/vmtempfiles/ftp/ModelFiles/temp.gvar" : "");
			if (flag.Value)
			{
				if (!ServerSDKAPI.FtpUploadFile(CVmObjectBase.mhandle, openFileDialog.FileName, "/root/vmtempfiles/ftp/ModelFiles/temp.gvar", bCreatDir: true, bCover: true))
				{
					HikMessageBox.Show(AppLocalizationService.GetLang("Lang_LoadFail"));
					LogHelper.objLog.Error("Upload local file " + openFileDialog.FileName + " to remote path /root/vmtempfiles/ftp/ModelFiles/temp.gvar fail");
				}
				else if (Items.Count <= 0 || HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImportSure"), AppLocalizationService.GetLang("Lang_ImportEmpty"), MessageButtons.YesOrNo, MessageIcons.Question) == SunEyeVision.Plugin.Wpf.Native.Display.VMControls.DialogResult.Yes)
				{
					ImportGlobalVar(filePath);
				}
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_LoadFail"));
			LogHelper.objLog.Error("全局变量导入失败，ex:" + ex.ToString());
		}
	}

	private void RemoteImport_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			DirectoryBrowser.OpenFileDialog openFileDialog = new DirectoryBrowser.OpenFileDialog();
			openFileDialog.Filter = "*.gvar|*.gvar";
			openFileDialog.CheckFileExists = true;
			bool? flag = openFileDialog.ShowDialog();
			string filePath = (flag.Value ? openFileDialog.FileNames[0] : "");
			if (flag.Value && (Items.Count <= 0 || HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImportSure"), AppLocalizationService.GetLang("Lang_ImportEmpty"), MessageButtons.YesOrNo, MessageIcons.Question) == SunEyeVision.Plugin.Wpf.Native.Display.VMControls.DialogResult.Yes))
			{
				ImportGlobalVar(filePath);
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_LoadFail"));
			LogHelper.objLog.Error("全局变量导入失败，ex:" + ex.ToString());
		}
	}

	private void LocalExport_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog();
			saveFileDialog.Filter = "*.gvar|*.gvar";
			saveFileDialog.FilterIndex = 1;
			saveFileDialog.RestoreDirectory = true;
			if (saveFileDialog.ShowDialog() == true)
			{
				ServerSDKAPI.FtpCreatDir(CVmObjectBase.mhandle, "/root/vmtempfiles/ftp/ModelFiles/");
				ExportGlobalVar("/root/vmtempfiles/ftp/ModelFiles/temp.gvar", saveFileDialog.FileName);
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("导出失败"));
			LogHelper.objLog.Error("全局变量导出失败，ex:" + ex.ToString());
		}
	}

	private void RemoteExport_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			DirectoryBrowser.SaveFileDialog saveFileDialog = new DirectoryBrowser.SaveFileDialog();
			saveFileDialog.Filter = "*.gvar|*.gvar";
			if (saveFileDialog.ShowDialog() == true)
			{
				ExportGlobalVar(saveFileDialog.FilePath);
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("导出失败"));
			LogHelper.objLog.Error("全局变量导出失败，ex:" + ex.ToString());
		}
	}

	private void varDataGrid_AutoGeneratedColumns(object sender, EventArgs e)
	{
		if (sender == null || !(sender is DataGrid dataGrid))
		{
			return;
		}
		for (int i = 0; i < dataGrid.Columns.Count; i++)
		{
			if (i == 7)
			{
				dataGrid.Columns[i].Visibility = ((!IsVisibleComInit) ? Visibility.Collapsed : Visibility.Visible);
			}
			if (dataGrid.Columns[i].Header is string)
			{
				dataGrid.Columns[i].Visibility = Visibility.Collapsed;
			}
		}
	}
}
