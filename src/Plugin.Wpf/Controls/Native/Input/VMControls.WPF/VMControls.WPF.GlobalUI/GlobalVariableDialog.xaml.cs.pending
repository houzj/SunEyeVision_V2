	/// <summary>
	/// 构造函数
	/// </summary>
	public GlobalVariableDialog()
	{
		InitializeComponent();
		Items = new ObservableCollection<GlobalVariableItem>();
		bool init = false;
		Loaded += (object s, RoutedEventArgs e) =>
		{
			varManager = new VariableManager(DecorateSource);
			if (!init)
			{
				VmModule obj = DecorateSource as VmModule;
				if (obj != null && obj.Outputs.Where((VmIO x) => x.CustomVisibleA).Count() > 0)
				{
					ProcessbarMessage = AppLocalizationService.GetLang("Lang_VarLoading");
					EmptyStatus = "Collapsed";
					IsShowProcessbar = "Visible";
				}
				if (DecorateSource != null)
				{
					GetDataAsync();
					init = true;
				}
				else
				{
					string lang = AppLocalizationService.GetLang("Lang_VarLoadFailed");
					HikMessageBox.Show(lang, MessageIcons.Error);
				}
			}
		};
		GetAuthority();
	}

	private void VarValueReportEvent(object sender, EventArgs e)
	{
		if (IsChangeVarValue || !(e is ValueEventArgs e2))
		{
			return;
		}
		VarItem varItem = (VarItem)e2.Value;
		if (varItem == null)
		{
			return;
		}
		Dispatcher.BeginInvoke((Action)(() =>
		{
			GlobalVariableItem globalVariableItem = Items.FirstOrDefault((GlobalVariableItem x) => x.Name == varItem.Name && x.Type == varItem.Type);
			if (globalVariableItem != null && varItem.ValueArray != null)
			{
				WeakEventManager<GlobalVariableItem, PropertyChangedEventArgs>.RemoveHandler(globalVariableItem, "PropertyChanged", ValueChanged);
				if (varItem.ValueArray is string[] array && array.Length != 0)
				{
					if (array.Length <= 1)
					{
						globalVariableItem.Value = array[0];
					}
					else
					{
						globalVariableItem.UpdateArrayValue(array);
					}
				}
				WeakEventManager<GlobalVariableItem, PropertyChangedEventArgs>.AddHandler(globalVariableItem, "PropertyChanged", ValueChanged);
			}
		}));
	}

	private void GetAuthority()
	{
		AccessUser loginUser = CodeManager.GetInstance().GetLoginUser();
		if (loginUser == AccessUser.Tech)
		{
			IsAllowOperat = false;
		}
		else
		{
			IsAllowOperat = true;
		}
	}

	/// <summary>
	/// 获取默认名称
	/// </summary>
	/// <returns></returns>
	public string GetDefaultName(StringBuilder stringBuilder)
	{
		if (stringBuilder == null)
		{
			stringBuilder = new StringBuilder(5);
			stringBuilder.Append("var");
			stringBuilder.Append(_variableIndex);
		}
		else
		{
			int num = _variableIndex;
			int num2 = 0;
			while (num > 0)
			{
				num /= 10;
				num2++;
			}
			if (num2 == 0)
			{
				num2 = 1;
			}
			stringBuilder.Remove("var".Length, num2);
			_variableIndex++;
			stringBuilder.Append(_variableIndex);
		}
		return Items.Any((GlobalVariableItem p) => p.Name == "%" + stringBuilder.ToString() + "%") ? GetDefaultName(stringBuilder) : stringBuilder.ToString();
	}

	private void AddNewItem(GlobalVariableItem item, bool isAddBind = false)
	{
		if (item == null)
		{
			return;
		}
		item.Parent = Items;
		if (isAddBind)
		{
			try
			{
				varManager.AddVar(item.Name, item.Type, "", SelectGroupItem.Name);
			}
			catch (Exception ex)
			{
				LogHelper.Error("添加变量异常:" + item.Name + ",exception:" + VmSolution.GetVmException(ex).ToString());
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_GlobalVariableAdd") + ":Failed", MessageIcons.Error);
				return;
			}
			Items.Add(item);
			SelectGroupItem.AddItem(item);
		}
		else
		{
			sortItemsList.Add(item);
		}
		VmIO vmIO = varManager.CheckVarAddIO(item.Name, item.Type, item.Index);
		if (vmIO != null)
		{
			item.DecorateSource = vmIO;
			vmIO.Index = item.Index;
		}
		item.SetVarManager(varManager);
		WeakEventManager<GlobalVariableItem, PropertyChangedEventArgs>.AddHandler(item, "PropertyChanged", ValueChanged);
	}

	/// <summary>
	///             过滤属性
	/// </summary>
	/// <returns></returns>
	private bool ExcudePropertyName(string PropertyName)
	{
		if (ExcudePropertyNameList.FindIndex((string x) => x == PropertyName) >= 0)
		{
			return true;
		}
		return false;
	}

	/// <summary>
	/// 参数值变化事件
	/// </summary>
	private void ValueChanged(object sender, PropertyChangedEventArgs e)
	{
		if (ExcudePropertyName(e.PropertyName))
		{
			return;
		}
		if (e.PropertyName == "Type")
		{
			GlobalVariableItem globalVariableItem = sender as GlobalVariableItem;
			try
			{
				varManager.ModifyType(globalVariableItem.Name, globalVariableItem.Type, isFromUI: true, GlobalVarExtern.GetLinkModuleInfoByRunParams(globalVariableItem.SelectedRunParams));
				globalVariableItem.ResetBindStr();
				return;
			}
			catch (Exception ex)
			{
				VmException vmException = VmSolution.GetVmException(ex);
				if (vmException != null)
				{
					LogHelper.Error("modify type [" + globalVariableItem.Type + "]  is exception:" + vmException.errorMessage);
				}
				else
				{
					LogHelper.Error("modify type [" + globalVariableItem.Type + "] is exception:" + ex.ToString());
				}
				LogHelper.Error(ex.StackTrace);
				return;
			}
		}
		if (e.PropertyName == "Name")
		{
			GlobalVariableItem globalVariableItem2 = sender as GlobalVariableItem;
			try
			{
				varManager.ModifyVarName(globalVariableItem2.strOldName, globalVariableItem2.Name, GlobalVarExtern.GetLinkModuleInfoByRunParams(globalVariableItem2.SelectedRunParams));
				return;
			}
			catch (Exception ex2)
			{
				VmException vmException2 = VmSolution.GetVmException(ex2);
				if (vmException2 != null)
				{
					LogHelper.Error("modify name [" + globalVariableItem2.strOldName + "] to [" + globalVariableItem2.Name + "] is exception:" + vmException2.errorMessage);
				}
				else
				{
					LogHelper.Error("modify name [" + globalVariableItem2.strOldName + "] to [" + globalVariableItem2.Name + "] is exception:" + ex2.ToString());
				}
				LogHelper.Error(ex2.StackTrace);
				return;
			}
		}
		if (e.PropertyName == "RemarkInfo")
		{
			GlobalVariableItem globalVariableItem3 = sender as GlobalVariableItem;
			varManager.ModifyRemark(globalVariableItem3.Name, globalVariableItem3.RemarkInfo);
		}
		else if (e.PropertyName == "Value")
		{
			IsChangeVarValue = true;
			GlobalVariableItem globalVariableItem4 = sender as GlobalVariableItem;
			try
			{
				if (globalVariableItem4.Type == "int")
				{
					varManager.SetVarIntValue(globalVariableItem4.Name, new int[1] { int.Parse(globalVariableItem4.Value) });
				}
				else if (globalVariableItem4.Type == "float")
				{
					varManager.SetVarFloatValue(globalVariableItem4.Name, new float[1] { float.Parse(globalVariableItem4.Value) });
				}
				else if (globalVariableItem4.Type == "string")
				{
					varManager.SetVarStringValue(globalVariableItem4.Name, new string[1] { globalVariableItem4.Value });
				}
				else if (globalVariableItem4.Type == "byte")
				{
					byte[] bytes = null;
					if (StringUtil.CheckByteString(globalVariableItem4.Value, ref bytes))
					{
						varManager.SetVarByteValue(globalVariableItem4.Name, bytes);
					}
				}
			}
			catch (Exception ex3)
			{
				VmException vmException3 = VmSolution.GetVmException(ex3);
				if (vmException3 != null)
				{
					LogHelper.Error("modify value is exception:" + globalVariableItem4.Name + "," + vmException3.errorMessage);
				}
				else
				{
					LogHelper.Error("modify value is exception:" + globalVariableItem4.Name + "," + ex3.ToString());
				}
			}
			IsChangeVarValue = false;
		}
		else if (e.PropertyName == "SelectedRunParams")
		{
			GlobalVariableItem globalVariableItem5 = sender as GlobalVariableItem;
			VarRunParamInfo[] linkModuleInfoByRunParams = GlobalVarExtern.GetLinkModuleInfoByRunParams(globalVariableItem5.SelectedRunParams);
			varManager.ModifyLinkModuleForSub(globalVariableItem5.Name, globalVariableItem5.Type, globalVariableItem5.GetOldSelectedRunParams(), linkModuleInfoByRunParams);
		}
		else if (e.PropertyName == "CommInit")
		{
			GlobalVariableItem globalVariableItem6 = sender as GlobalVariableItem;
			varManager.ModifyVarCommInit(globalVariableItem6.Name, globalVariableItem6.CommInit);
		}
	}

	/// <summary>
	/// 更新页码数据 add by zhouriwen 2020-03-13
	/// </summary>
	private void UpdatePageData(PageShowType type = PageShowType.ImmediateChange)
	{
		lock (_lock)
		{
			int num = (IsSearchState ? iSearchCount.Count() : Items.Count((GlobalVariableItem x) => x.VarGroupInfo == SelectGroupItem.Name));
			if (num > 0)
			{
				if (!IsSearchState)
				{
					EmptyStatus = "Collapsed";
				}
				PageNumShowStatus = "Visible";
			}
			else if (num == 0)
			{
				EmptyStatus = "Visible";
				PageNumShowStatus = "Collapsed";
			}
			if (ItemsTotalCount == num)
			{
				return;
			}
			int num2 = 0;
			ItemsTotalCount = num;
			if (PageCount > 0)
			{
				num2 = ((ItemsTotalCount % PageCount <= 0) ? (ItemsTotalCount / PageCount) : (ItemsTotalCount / PageCount + 1));
			}
			totalPageNum = num2;
			if (type == PageShowType.ShowFirstPage && num2 > 0)
			{
				CurrentPageNum = 1;
			}
			else if (type == PageShowType.NoChange)
			{
				if (CurrentPageNum > num2)
				{
					CurrentPageNum = num2;
				}
			}
			else
			{
				CurrentPageNum = num2;
			}
		}
	}

	/// <summary>
	/// 查询全局变量 add by zhouriwen 2020-03-13
	/// </summary>
	private void SeearchItem(string searchName)
	{
		lock (_lock)
		{
			if (string.IsNullOrEmpty(searchName))
			{
				if (IsSearchState)
				{
					IsSearchState = false;
					iSearchCount.Clear();
					CurrentPageNum = 0;
					ItemsTotalCount = 0;
					UpdatePageData(PageShowType.ShowFirstPage);
					if (oldSelectedItem != null)
					{
						oldSelectedItem.IsSelected = false;
					}
					oldSelectedItem = null;
					UpdateBtnEnable();
				}
				return;
			}
			IsSearchState = true;
			List<int> list = (from x in Items
				where x.Name.Contains(searchName) && x.VarGroupInfo == SelectGroupItem.Name
				select x.Index).ToList();
			if (list.Count > 0)
			{
				CurrentPageNum = 0;
				ItemsTotalCount = 0;
				iSearchCount = list;
				UpdatePageData(PageShowType.ShowFirstPage);
				EmptyStatus = "Collapsed";
			}
			else
			{
				SelectGroupItem.Clear();
				iSearchCount.Clear();
				ItemsTotalCount = 0;
				EmptyStatus = "Visible";
				PageNumShowStatus = "Collapsed";
			}
			if (oldSelectedItem != null && iSearchCount.FindIndex((int x) => x == oldSelectedItem.Index) < 0)
			{
				oldSelectedItem.IsSelected = false;
				oldSelectedItem = null;
				UpdateBtnEnable();
			}
		}
	}

	/// <summary>
	/// 重新设置界面绑定显示的数据
	/// </summary>
	private void SetBindData()
	{
		if (CurrentPageNum > 0 && SelectGroupItem != null)
		{
			int num = (CurrentPageNum - 1) * PageCount;
			IOrderedEnumerable<GlobalVariableItem> orderedEnumerable = from p in Items
				where p.VarGroupInfo == SelectGroupItem.Name
				orderby p.Index
				select p;
			int endIndex = ((CurrentPageNum < totalPageNum) ? (num + PageCount) : orderedEnumerable.Count());
			SelectGroupItem.UpdateBindItems(num, endIndex, orderedEnumerable);
		}
	}

	/// <summary>
	/// 搜寻状态下绑定显示的数据
	/// </summary>
	private void SetBindSearchData()
	{
		if (CurrentPageNum > 0 && SelectGroupItem != null)
		{
			int num = (CurrentPageNum - 1) * PageCount;
			int endIndex = ((CurrentPageNum < totalPageNum) ? (num + PageCount) : iSearchCount.Count());
			SelectGroupItem.UpdateBindItems(Items, iSearchCount.ToArray(), num, endIndex);
		}
	}

	/// <summary>
	/// 定时器任务
	/// </summary>
	public void GetDataAsync()
	{
		Task.Run(async () =>
		{
			try
			{
				LogHelper.Error("GetDataAsync start");
				if (IsLoading)
				{
					LogHelper.Info("solution is loading");
				}
				else
				{
					varManager.SetReportState(isEnable: true);
					VariableManager.IMVS_VARIABLE[] vARIABLEs = new VariableManager.IMVS_VARIABLE[0];
					varManager.GetAllVar(ref vARIABLEs);
					if (IsLoading)
					{
						LogHelper.Info("solution is loading");
					}
					else
					{
						varManager.GetGlobalBindingRelation(vARIABLEs);
						if (IsLoading)
						{
							LogHelper.Info("solution is loading");
						}
						else
						{
							Dispatcher.Invoke((Func<bool>)GetVarGroupMsg);
							if (IsLoading)
							{
								LogHelper.Info("solution is loading");
							}
							else
							{
								Dispatcher.Invoke(() =>
								{
									GetData(vARIABLEs);
								});
								(DecorateSource as IVarModule).VarValueReportEvent += VarValueReportEvent;
								LogHelper.Error("GetDataAsync start end");
							}
						}
					}
				}
			}
			catch (Exception ex)
			{
				Exception ex2 = ex;
				IsShowProcessbar = "Collapsed";
				string errorMsg = AppLocalizationService.GetLang("Lang_VarLoadFailed");
				VmException vmex = VmSolution.GetVmException(ex2);
				errorMsg = ((vmex == null) ? (errorMsg + "\r\n" + ex2.ToString()) : (errorMsg + "\r\n" + vmex.errorMessage));
				LogHelper.Error("GetDataAsync is error:" + errorMsg);
				HikMessageBox.Show(errorMsg, MessageIcons.Error);
			}
		});
	}

	/// <summary>
	/// 关闭按钮
	/// </summary>
	protected override void OnClosing(CancelEventArgs e)
	{
		base.OnClosing(e);
		varManager.SetReportState(isEnable: false);
		varManager.ClearCache();
		(DecorateSource as IVarModule).VarValueReportEvent -= VarValueReportEvent;
	}

	/// <summary>
	/// 初始化对象
	/// </summary>
	private void GetData(VariableManager.IMVS_VARIABLE[] vARIABLEs)
	{
		try
		{
			lock (_lock)
			{
				if (DecorateSource == null || !(DecorateSource is IVmModule) || vARIABLEs == null)
				{
					return;
				}
				VmIOCollection inputs = (DecorateSource as VmModule).Inputs;
				sortItemsList.Clear();
				if (Items.Count > vARIABLEs.Length)
				{
					Items.Clear();
				}
				List<string> list = new List<string>();
				for (int i = 0; i < vARIABLEs.Length; i++)
				{
					if (IsLoading)
					{
						LogHelper.Info("solution is loading");
						return;
					}
					GlobalVariableItem globalVariableItem = GlobalVarExtern.StructToGlobalVarItem(vARIABLEs[i]);
					AddNewItem(globalVariableItem);
					list.Add(globalVariableItem.Name);
				}
				sortItemsList.Sort((GlobalVariableItem b1, GlobalVariableItem b2) => Comparer<int>.Default.Compare(b1.Index, b2.Index));
				Items = new ObservableCollection<GlobalVariableItem>(sortItemsList);
				foreach (GlobalVariableItem item2 in Items)
				{
					item2.Parent = Items;
				}
				VmModule vmModule = DecorateSource as VmModule;
				List<string> list2 = vmModule.Outputs.Select((VmIO p) => p.Name).ToList();
				foreach (string item in list2)
				{
					if (!VmModule.fTimeStamp.Contains(item) && list.FindIndex((string x) => x == item) < 0)
					{
						vmModule.Outputs.GetIO(item)?.Dispose();
					}
				}
				if (bFirstGetData)
				{
					bFirstGetData = false;
					if (SelectGroupItem != null && Items.Count((GlobalVariableItem x) => string.IsNullOrEmpty(x.VarGroupInfo)) == Items.Count && Items.Count > 0)
					{
						foreach (GlobalVariableItem item3 in Items)
						{
							item3.VarGroupInfo = SelectGroupItem.Name;
						}
						varManager.SetDefaultGroupInfo(SelectGroupItem.Name);
					}
					UpdatePageData(PageShowType.ShowFirstPage);
					ProcessbarMessage = AppLocalizationService.GetLang("Lang_Import");
					IsShowProcessbar = "Collapsed";
				}
				else
				{
					UpdatePageData(PageShowType.NoChange);
				}
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error("GetData is error:" + ex.ToString());
			IsShowProcessbar = "Collapsed";
			string text = AppLocalizationService.GetLang("Lang_VarLoadFailed");
			VmException vmException = VmSolution.GetVmException(ex);
			if (vmException != null)
			{
				text = text + "\r\n" + vmException.errorMessage;
			}
			HikMessageBox.Show(text, MessageIcons.Error);
		}
	}

	/// <summary>
	/// 初始化一次输出IO
	/// </summary>
	private void InitDynamicIO()
	{
		try
		{
			if (DecorateSource == null || !(DecorateSource is IVmModule))
			{
				return;
			}
			VariableManager.IMVS_VARIABLE[] vARIABLEs = new VariableManager.IMVS_VARIABLE[0];
			varManager?.GetAllVar(ref vARIABLEs);
			if (vARIABLEs.Length == 0)
			{
				return;
			}
			for (int i = 0; i < vARIABLEs.Length; i++)
			{
				string varname = StringUtil.UTF8GetString(vARIABLEs[i].chszValueName);
				string typeName = StringUtil.UTF8GetString(vARIABLEs[i].chszValueType);
				VmIO vmIO = (DecorateSource as VmModule).Outputs.FirstOrDefault((VmIO x) => x.Name == varname);
				if (vmIO == null)
				{
					DynamicVmIO dynamicVmIO = new DynamicVmIO
					{
						Name = varname,
						TypeName = typeName,
						Root = (VmModule)DecorateSource,
						Index = i + 1
					};
					dynamicVmIO.Parent = dynamicVmIO.Root;
					(DecorateSource as VmModule).Outputs.Add(dynamicVmIO);
				}
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error("GetData is error:" + ex.ToString());
		}
	}

	private void Delete_OnHandler(object sender, RoutedEventArgs e)
	{
		if (!(sender is Button { DataContext: GlobalVariableItem dataContext }))
		{
			return;
		}
		dataContext.Parent = null;
		WeakEventManager<GlobalVariableItem, PropertyChangedEventArgs>.RemoveHandler(dataContext, "PropertyChanged", ValueChanged);
		try
		{
			varManager.DeleteVar(dataContext.Name, isFromUI: true, GlobalVarExtern.GetLinkModuleInfoByRunParams(dataContext.SelectedRunParams));
		}
		catch (Exception ex)
		{
			LogHelper.Error("删除变量异常:" + dataContext.Name + ",exception:" + VmSolution.GetVmException(ex).ToString());
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_VariableDelete") + ":Failed", MessageIcons.Error);
			WeakEventManager<GlobalVariableItem, PropertyChangedEventArgs>.AddHandler(dataContext, "PropertyChanged", ValueChanged);
			return;
		}
		int nDelIndex = dataContext.Index;
		lock (_lock)
		{
			if (oldSelectedItem != null && oldSelectedItem.Index == nDelIndex)
			{
				oldSelectedItem = null;
			}
			foreach (GlobalVariableItem item in Items)
			{
				if (item.Index > nDelIndex)
				{
					item.Index--;
				}
			}
			if (IsSearchState)
			{
				if (iSearchCount.Contains(nDelIndex))
				{
					iSearchCount.Remove(dataContext.Index);
				}
				iSearchCount.ForEach((int x) =>
				{
					if (x > nDelIndex)
					{
						x--;
					}
				});
			}
			if (Items.Contains(dataContext))
			{
				Items.Remove(dataContext);
			}
			if (SelectGroupItem.BindItems.Contains(dataContext))
			{
				SelectGroupItem.BindItems.Remove(dataContext);
			}
			if (CurrentPageNum < totalPageNum)
			{
				int nAddIndex = CurrentPageNum * PageCount - 1;
				if (!IsSearchState)
				{
					IEnumerable<GlobalVariableItem> enumerable = Items.Where((GlobalVariableItem x) => x.VarGroupInfo == SelectGroupItem.Name);
					if (enumerable.Count() > nAddIndex)
					{
						SelectGroupItem.BindItems.Add(enumerable.ElementAt(nAddIndex));
					}
				}
				else
				{
					GlobalVariableItem globalVariableItem = Items.FirstOrDefault((GlobalVariableItem p) => p.Index == iSearchCount[nAddIndex]);
					if (globalVariableItem != null)
					{
						SelectGroupItem.BindItems.Add(globalVariableItem);
					}
				}
			}
			UpdatePageData(PageShowType.NoChange);
			UpdateBtnEnable();
		}
	}

	private void SearchItem_OnClick(object sender, RoutedEventArgs e)
	{
		string text = SearchText.Text;
		SeearchItem(text);
	}

	private void AddItem_OnClick(object sender, RoutedEventArgs e)
	{
		if (SelectGroupItem == null)
		{
			return;
		}
		int count = Items.Count;
		if (count >= 2048)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("添加") + AppLocalizationService.GetLang("超限") + ":" + 2048, MessageButtons.Normal, MessageIcons.Warning);
			return;
		}
		if (IsSearchState)
		{
			SearchText.Text = "";
		}
		GlobalVariableItem item = new GlobalVariableItem
		{
			Name = "%" + GetDefaultName(null) + "%",
			Type = "int",
			Value = "0",
			Index = count + 1,
			VarGroupInfo = SelectGroupItem.Name
		};
		AddNewItem(item, isAddBind: true);
		UpdatePageData();
		if (SelectGroupItem.Count <= 0)
		{
			return;
		}
		GlobalVariableItem item2 = SelectGroupItem.GetItem();
		if (item2 != null)
		{
			item2.IsSelected = true;
			if (oldSelectedItem != null && oldSelectedItem.Name != item2.Name)
			{
				oldSelectedItem.IsSelected = false;
			}
			oldSelectedItem = item2;
			UpdateBtnEnable();
		}
	}

	private void LightSave_Click(object sender, RoutedEventArgs e)
	{
		if (ItemsTotalCount <= 0)
		{
			return;
		}
		if (string.IsNullOrEmpty(VmSolution.Instance.SolutionPath))
		{
			HikMessageBox.Show(DisplayName + " " + AppLocalizationService.GetLang("Lang_SaveSuccess"), MessageIcons.Ok, MessageButtons.NoButton, 1000u);
			return;
		}
		try
		{
			ServerSDKManager.serverSDKManager.mVmInterfaceManager.LightSaveSolutionEx();
			HikMessageBox.Show(DisplayName + " " + AppLocalizationService.GetLang("Lang_SaveSuccess"), MessageIcons.Ok, MessageButtons.NoButton, 1000u);
		}
		catch (VmException ex)
		{
			LogHelper.objLog.Info("全局变量保存文件数据失败，错误码为:" + ex.errorCode);
			HikMessageBox.Show(AppLocalizationService.GetLang("保存文件数据失败"), MessageIcons.Error);
		}
	}

