	/// <summary>
	/// 绑定模块结果 add by zhouriwen 2020-03-13
	/// </summary>
	public string BindString
	{
		get
		{
			string[] array = variableManager?.GetBindGlobalVariableItem(Name, Type);
			if (array == null || array.Length == 0)
			{
				OnPropertyChanged("IsBindMoudleResult");
				return _bindString;
			}
			StringBuilder sb = new StringBuilder();
			Array.ForEach(array, (string x) =>
			{
				sb.Append(x + ";");
			});
			_bindString = sb.ToString();
			_bindString = _bindString.Substring(0, _bindString.Length - 1);
			DisplayTooltipBindString = _bindString.Replace(";", "\r\n");
			OnPropertyChanged("IsBindMoudleResult");
			return _bindString;
		}
		set
		{
			if (!(_bindString == value))
			{
				_bindString = value;
				OnPropertyChanged("BindString");
			}
		}
	}

