	/// <summary>
	/// 名称
	/// </summary>
	public string Name
	{
		get
		{
			return _name;
		}
		set
		{
			if (_name != null && _name == AppLocalizationService.UnDoTranslate(value))
			{
				return;
			}
			if (string.IsNullOrEmpty(value))
			{
				HikMessageBox.Show("Lang_ParamNameErr", "Lang_PmValueEptErr", MessageIcons.Error, isTranslate: true);
				OnPropertyChanged("Name");
				return;
			}
			if (StringUtil.GetByteCountWithZero(value) > 126)
			{
				HikMessageBox.Show("Lang_ParamNameErr", "Lang_PmNameLong", MessageIcons.Error, isTranslate: true);
				OnPropertyChanged("Name");
				return;
			}
			if (value.Contains('?') || value.Contains(';') || value.Contains('.') || value.Contains('/') || value.Contains('\\') || value.Contains('`') || value.Contains('{') || value.Contains('}') || value.Contains('[') || value.Contains(']') || value.Contains('<') || value.Contains('>') || value.Contains('(') || value.Contains(')'))
			{
				HikMessageBox.Show("Lang_SetCnfg", "Lang_Containsillegal", MessageIcons.Error, isTranslate: true);
				OnPropertyChanged("Name");
				return;
			}
			if (Parent != null)
			{
				IList<GlobalVariableItem> source = Parent as IList<GlobalVariableItem>;
				string translateValue = AppLocalizationService.UnDoTranslate(value);
				bool flag = DecorateSource != null && ((IVmModule)(DecorateSource as VmIO).Root).IsExistName(translateValue);
				if (source.Any((GlobalVariableItem p) => p.Name == translateValue) | flag)
				{
					HikMessageBox.Show("Lang_ParamNameErr", "Lang_PmNameExited", MessageIcons.Error, isTranslate: true);
					OnPropertyChanged("Name");
					return;
				}
			}
			strOldName = _name;
			_name = ((_name == null) ? value : AppLocalizationService.UnDoTranslate(value));
			if (string.IsNullOrEmpty(_name))
			{
				CommInit = false;
			}
			OnPropertyChanged("Name");
		}
	}

	/// <summary>
	/// 名称修改命令
	/// </summary>
	public ICommand TextChangedCommand => (ICommand)(_TextChangedCommand ?? (_TextChangedCommand = new DelegateCommand<string>((Action<string>)TextChangedExecute)));

	/// <summary>
	/// 显示类型
	/// </summary>
	public string DisplayType
	{
		get
		{
			if (string.IsNullOrEmpty(_displayType))
			{
				if (Type == "ROIANNULUS")
				{
					_displayType = "ANNULUS";
				}
				else if (Type == "ROIPOLYGON")
				{
					_displayType = "POLYGON";
				}
				else if (Type == "Rect")
				{
					_displayType = "RECT";
				}
				else if (Type == "ROIBOX")
				{
					_displayType = "BOX";
				}
				else
				{
					_displayType = Type;
				}
			}
			return _displayType;
		}
		set
		{
			if (value != _displayType)
			{
				_displayType = value;
				switch (value)
				{
				case "ANNULUS":
					Type = "ROIANNULUS";
					break;
				case "POLYGON":
					Type = "ROIPOLYGON";
					break;
				case "RECT":
					Type = "Rect";
					break;
				case "BOX":
					Type = "ROIBOX";
					break;
				default:
					Type = value;
					break;
				}
				OnPropertyChanged("DisplayType");
			}
		}
	}

	/// <summary>
	/// 类型
	/// </summary>
	public string Type
	{
		get
		{
			return _type;
		}
		set
		{
			string value2 = Value;
			if (_type == value)
			{
				return;
			}
			_type = value;
			switch (Type)
			{
			case "int":
			{
				if (!int.TryParse(Value, out var _))
				{
					value2 = "0";
				}
				break;
			}
			case "float":
			{
				if (!float.TryParse(Value, out var _))
				{
					value2 = "0.0";
				}
				break;
			}
			case "string":
				value2 = "";
				break;
			case "double":
			{
				if (!double.TryParse(Value, out var _))
				{
					value2 = "0.0";
				}
				break;
			}
			}
			OnPropertyChanged("Type");
			Value = value2;
			IsArrayValue = false;
			OnPropertyChanged("Value");
			OnPropertyChanged("IsVarValueVisibility");
			OnPropertyChanged("IsBindMoudleResult");
			OnPropertyChanged("IsComInitEnable");
			if (!IsComInitEnable)
			{
				CommInit = false;
			}
		}
	}

	/// <summary>
	/// 数组信息-todo zrw 暂定
	/// </summary>
	public string[] ArrayValue { get; set; }

	/// <summary>
	/// 初始值
	/// </summary>
	public string Value
	{
		get
		{
			return _value;
		}
		set
		{
			if (_value == value)
			{
				return;
			}
			string value2 = value;
			switch (Type)
			{
			case "int":
			{
				if (!int.TryParse(value, out var result3))
				{
					return;
				}
				value2 = result3.ToString("D");
				break;
			}
			case "float":
			{
				if (!float.TryParse(value, out var result2))
				{
					return;
				}
				value2 = result2.ToString();
				break;
			}
			case "byte":
			{
				byte[] bytes = null;
				if (StringUtil.CheckByteString(value, ref bytes))
				{
					value2 = value;
					break;
				}
				return;
			}
			case "double":
			{
				if (!double.TryParse(value, out var result))
				{
					return;
				}
				value2 = result.ToString();
				break;
			}
			}
			_value = value2;
			OnPropertyChanged("Value");
		}
	}

