	private void TextChangedExecute(string newName)
	{
		Name = newName;
	}

	/// <summary>
	/// 重置绑定字符串
	/// </summary>
	public void ResetBindStr()
	{
		BindString = "    ------    ";
		SelectedRunParams = new List<RunParamsBaseNode>();
	}

	/// <summary>
	/// 获取旧的绑定参数关系
	/// </summary>
	public VarRunParamInfo[] GetOldSelectedRunParams()
	{
		return _OldSelectedRunParams;
	}

	private void ModifyRunParamsExecute()
	{
		_OldSelectedRunParams = null;
		_OldSelectedRunParams = GlobalVarExtern.GetLinkModuleInfoByRunParams(SelectedRunParams);
		if (DecorateSource == null)
		{
			LogHelper.Error("DecorateSource is null");
			return;
		}
		RunParamsSelectData runParamsSelectData = new RunParamsSelectData();
		runParamsSelectData.DecorateSource = (DecorateSource as VmIO).Root;
		RunParamsSelectData paramsData = runParamsSelectData;
		List<RunParamsBaseNode> list = new List<RunParamsBaseNode>();
		if (Parent != null && Parent is IList<GlobalVariableItem> list2)
		{
			foreach (GlobalVariableItem item in list2)
			{
				if (item.Name != Name && item.SelectedRunParams != null)
				{
					list.AddRange(item.SelectedRunParams);
				}
			}
		}
		RunParamsSelectWindow runParamsSelectWindow = new RunParamsSelectWindow(SelectedRunParams, list, paramsData, Type);
		if (runParamsSelectWindow.ShowDialog() == true)
		{
			SelectedRunParams = runParamsSelectWindow.GetSelectedParams();
		}
	}

	private void DisplayValueArrayExecute()
	{
		string title = AppLocalizationService.GetLang((DecorateSource as VmIO)?.Root.StrModuleName) + "." + AppLocalizationService.GetLang(Name);
		arrayDisplay = new ArrayDisplayWindow(title, ArrayValue);
		arrayDisplay.ShowDialog();
	}

	/// <summary>
	/// 更新数组界面
	/// </summary>
	public void UpdateArrayValue(string[] arryValue)
	{
		ArrayValue = arryValue;
		if (arrayDisplay != null && arrayDisplay.IsVisible)
		{
			arrayDisplay.UpdateArrayValue(ArrayValue);
		}
	}

	T IVmFrameBase.GetParent<T>()
	{
		if (!(this is T result))
		{
			if (Parent != null)
			{
				return (Parent as IVmFrameBase).GetParent<T>();
			}
			return null;
		}
		return result;
	}

	/// <summary>
	/// 设置varmanager类
	/// </summary>
	public void SetVarManager(VariableManager manager)
	{
		variableManager = manager;
	}
}
