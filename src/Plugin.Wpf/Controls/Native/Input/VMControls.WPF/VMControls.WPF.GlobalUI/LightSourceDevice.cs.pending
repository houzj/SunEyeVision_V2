	/// <summary>
	/// 参数修改下发底层
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	private void ParamValueChanged(object sender, EventArgs e)
	{
		IsParamError = false;
		bool flag = false;
		if (sender == brand)
		{
			flag = true;
			List<object> source = LightSourceManager.Instance.ItemsA.Where((object p) => (p as LightSourceDevice).LightType == 108).ToList();
			if (source.Count() > 1)
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_GPIONumLimit"), MessageIcons.Warning);
				(sender as Enumeration).CurValueA = 0;
				IsParamError = true;
				return;
			}
			SetChannelShowStates();
			TriggerProcedure.ChangeIOTotalNumber(TriggerProcedure_IO_Number);
		}
		if (IsNeedSetParam)
		{
			int num = -1;
			num = LightSourceManager.Instance.SetData();
			if (num != 0)
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_InfoTips"), AppLocalizationService.GetLang("Lang_ParamSetFail"), MessageButtons.Normal, MessageIcons.Error);
			}
			else if (flag)
			{
				TriggerProcedure.SetProcessList();
			}
		}
	}

	/// <summary>
	/// 从底层获取通道参数
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	public void GetChannelParam()
	{
		string paramName = "LightDeviceParamGet-" + IndexA + "-" + Guid;
		int binaryData = ServerSDKManager.serverSDKManager.mModuleManager.GetBinaryData((uint)LightSourceManager.Instance.ModuleID, paramName, out var data);
		try
		{
			if (binaryData > 0)
			{
				ST_LIGHT_CONFIG_ID sT_LIGHT_CONFIG_ID = Marshal.PtrToStructure<ST_LIGHT_CONFIG_ID>(data);
				if (sT_LIGHT_CONFIG_ID.chszDeviceGuid == Guid)
				{
					IsNeedSetParam = false;
					(ChannelsA[0] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel1);
					(ChannelsA[1] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel2);
					(ChannelsA[2] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel3);
					(ChannelsA[3] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel4);
					(ChannelsA[4] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel5);
					(ChannelsA[5] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel6);
					(ChannelsA[6] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel7);
					(ChannelsA[7] as LightChannel).InitParamValue(sT_LIGHT_CONFIG_ID.stLightConfig.channel8);
					IsNeedSetParam = true;
				}
			}
			else if (binaryData == -1)
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_GetLightParamERR"), MessageIcons.Error);
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageIcons.Error);
		}
		finally
		{
			if (data != IntPtr.Zero)
			{
				Marshal.FreeHGlobal(data);
				data = IntPtr.Zero;
			}
		}
	}

	/// <summary>
	/// 通道参数下发底层
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	private int SetChannelParam(ST_LIGHT_CONFIG_ID param)
	{
		int result = -1;
		int num = Marshal.SizeOf<ST_LIGHT_CONFIG_ID>();
		IntPtr intPtr = Marshal.AllocHGlobal(num);
		try
		{
			Marshal.StructureToPtr(param, intPtr, fDeleteOld: true);
			result = ServerSDKManager.serverSDKManager.mModuleManager.SetBinaryData((uint)LightSourceManager.Instance.ModuleID, "LightDeviceParamSet", intPtr, num);
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageIcons.Error);
		}
		finally
		{
			if (intPtr != IntPtr.Zero)
			{
				Marshal.FreeHGlobal(intPtr);
				intPtr = IntPtr.Zero;
			}
		}
		return result;
	}

	/// <summary>
	/// 设置通道参数
	/// </summary>
	/// <returns></returns>
	public int SetChannelConfig()
	{
		int num = -1;
		ST_LIGHT_CONFIG_ID channelParam = ConvertToST_LIGHT_CONFIG_ID();
		num = SetChannelParam(channelParam);
		if (num != 0)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_InfoTips"), AppLocalizationService.GetLang("Lang_ParamSetFail"), MessageButtons.Normal, MessageIcons.Error);
		}
		return num;
	}

	/// <summary>
