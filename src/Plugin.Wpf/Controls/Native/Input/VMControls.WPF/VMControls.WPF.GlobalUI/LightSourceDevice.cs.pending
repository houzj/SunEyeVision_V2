	public EnumerationCom ComName
	{
		get
		{
			if (comName == null)
			{
				comName = new EnumerationCom
				{
					DisplayName = "Port Number",
					Description = "Port Number",
					AccessMode = "O",
					CurValue = 0,
					DefaultValue = 0
				};
				if (IsLocalMode)
				{
					comName.Initers = new ObservableCollection<object>();
					Setter setter = new Setter
					{
						TargetName = "EnumEntrys",
						OperationName = "GetSerialPortListOperation"
					};
					setter.CreatOperateInstance();
					comName.Initers.Add(setter);
					setter.SetParentNode(comName);
					comName.InniterBusiness();
				}
				else
				{
					comName.CurValue = 1;
					comName.DefaultValue = 1;
					comName.EnumEntrysA = new ObservableCollection<object>
					{
						new EnumEntry
						{
							Description = "/dev/ttyS1",
							DisplayName = "/dev/ttyS1",
							Value = 1
						}
					};
				}
			}
			return comName;
		}
	}

