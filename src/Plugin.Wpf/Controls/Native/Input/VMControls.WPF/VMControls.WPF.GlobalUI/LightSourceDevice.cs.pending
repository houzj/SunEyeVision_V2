	public static byte[] GetBytes_UTF8(uint bytesLen, string strValue)
	{
		byte[] array = new byte[bytesLen];
		try
		{
			byte[] bytes = Encoding.UTF8.GetBytes(strValue);
			Array.Copy(bytes, 0, array, 0, bytes.Length);
		}
		catch
		{
		}
		return array;
	}

	private void ServerManager_OnReportDataToVM(ImvsSdkDefine.IMVS_ALGORITHM_INIT_RESULT_INFO algResultInfor)
	{
		CurrentUIHelper.Instance.Dispatcher.BeginInvoke((Action)(() =>
		{
			if (algResultInfor.nModuleID == (uint)LightSourceManager.Instance.ModuleID && algResultInfor.nType == 2952790016u)
			{
				string[] array = algResultInfor.strTransData.Split('-');
				if (array.Length == 2 && int.Parse(array[0]) == Index)
				{
					if (array[1] == "0")
					{
						IsConnected = false;
					}
					else if (array[1] == "1")
					{
						IsConnected = true;
						GetChannelParam();
					}
				}
			}
		}));
	}

	private void ConnectDevCommandExecute()
	{
		int num = ((!isConnected) ? 1 : 0);
		string strParamName = "LightDeviceOpen";
		string strParamValue = Index + "-" + num;
		try
		{
			ServerSDKManager.serverSDKManager.mModuleManager.SetParamValue((uint)LightSourceManager.Instance.ModuleID, strParamName, strParamValue, bThrowException: true);
		}
		catch
		{
			IsConnected = !IsConnected;
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_LightLinkFail"), MessageIcons.Error);
			return;
		}
		GetChannelParam();
	}

	private void ReNameDevCommandExecute()
	{
		string name = Name;
		AddLightSourceDeviceDlg addLightSourceDeviceDlg = new AddLightSourceDeviceDlg
		{
			Title = AppLocalizationService.GetLang("Lang_Rename"),
			IsReName = true,
			ConfigName = Name
		};
		addLightSourceDeviceDlg.ShowDialog();
		if (addLightSourceDeviceDlg.IsConfirm && LightSourceManager.Instance.CheckName(addLightSourceDeviceDlg.ConfigName, isShow: true))
		{
			Name = addLightSourceDeviceDlg.ConfigName;
			int num = LightSourceManager.Instance.SetData();
			if (num != 0)
			{
				Name = name;
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ReNameFail"), MessageIcons.Error);
			}
			else
			{
				OnPropertyChanged("NameA");
				LightSourceManager.Instance.UpdateLightModule();
			}
		}
	}

	private void DelDevCommandExecute()
	{
		if (HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ConfirmDelete"), MessageButtons.OkOrCancel, MessageIcons.Question) == DialogResult.Ok)
		{
			string strParamName = "LightDeviceDelete";
			string strParamValue = Index.ToString();
			try
			{
				ServerSDKManager.serverSDKManager.mModuleManager.SetParamValue((uint)LightSourceManager.Instance.ModuleID, strParamName, strParamValue);
			}
			catch
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_DeleteFail"), MessageIcons.Error);
				return;
			}
			LightSourceManager.Instance.DeleteDevice(this);
			ServerSDKManager.serverSDKManager.mSolutionManager.OnReportDataToVM -= ServerManager_OnReportDataToVM;
		}
	}
}
