			break;
		}
		case 103:
			foreach (object item2 in ChannelsA)
			{
				if ((item2 as LightChannel).ChannelNumA == 1)
				{
					(item2 as LightChannel).IsShowDurationTime = false;
					(item2 as LightChannel).IsShowLightState = true;
					(item2 as LightChannel).IsShowTriggerEdge = false;
					(item2 as LightChannel).LightStateA.EnumEntrysA = new ObservableCollection<object>
					{
						new EnumEntry
						{
							Description = "RunParam_LightStateOnVB",
							DisplayName = "RunParam_LightStateOnVB",
							Value = 1
