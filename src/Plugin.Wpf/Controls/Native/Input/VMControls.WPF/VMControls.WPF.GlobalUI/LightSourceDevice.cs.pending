	/// <summary>
	/// 可以触发流程执行的IO数量
	/// </summary>
	internal int TriggerProcedure_IO_Number
	{
		get
		{
			switch (LightType)
			{
			case 103:
			case 104:
				return 4;
			case 105:
			case 106:
			case 110:
				return 8;
			case 114:
				return 8;
			default:
				return 0;
			}
		}
	}

	/// <summary>
	/// 设备类型
	/// </summary>
	public int LightType
	{
		get
		{
			int result = 101;
			switch (Brand.CurValueA)
			{
			case 0:
				result = 0;
				break;
			case 4:
				result = 103;
				break;
			case 5:
				result = 107;
				break;
			case 6:
				result = 106;
				break;
			case 7:
				result = 110;
				break;
			case 8:
				result = 108;
				break;
			case 9:
				result = 8917764;
				break;
			case 10:
				result = 104;
				break;
			case 11:
				result = 105;
				break;
			case 12:
				result = 109;
				break;
			case 15:
				result = 114;
				break;
			}
			return result;
		}
	}

