			//IL_0023: Expected Obj, but got Unknown
			DelegateCommand val = connectDevCommand;
			if (val == null)
			{
				DelegateCommand val2 = new DelegateCommand((Action)ConnectDevCommandExecute);
				DelegateCommand val3 = val2;
				connectDevCommand = val2;
				val = val3;
