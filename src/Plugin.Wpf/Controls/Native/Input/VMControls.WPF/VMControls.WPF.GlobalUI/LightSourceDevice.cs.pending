	public event PropertyChangedEventHandler PropertyChanged;

	public LightSourceDevice()
	{
		Guid = UIHelper.GenerateUniqueText();
		CommType = "COM";
		ServerSDKManager.serverSDKManager.mSolutionManager.OnReportDataToVM += ServerManager_OnReportDataToVM;
	}

	/// <summary>
	/// 通知属性变化
	/// </summary>
	/// <param name="name"></param>
	public void OnPropertyChanged(string name)
	{
		if (PropertyChanged != null)
		{
			PropertyChanged(this, new PropertyChangedEventArgs(name));
		}
	}

	public void AddParamValueChangedHandle()
	{
		comName.OnCurValueChanged -= ParamValueChanged;
		comName.OnCurValueChanged += ParamValueChanged;
	}

	/// <summary>
	/// 光源设备转换为结构体
	/// </summary>
	/// <returns></returns>
	public IMVS_LIGHT_DEVICE ConvertToIMVS_LIGHT_DEVICE()
	{
		string strValue = (Brand.EnumEntrysA.FirstOrDefault((object p) => (p as EnumEntry)?.ValueA == Brand.CurValueA) as EnumEntry)?.StrValue ?? "None";
		IMVS_LIGHT_DEVICE result = new IMVS_LIGHT_DEVICE
		{
			chszBrandName = GetBytes_UTF8(256u, strValue),
			chszDeviceName = GetBytes_UTF8(256u, Name),
			chszDeviceGuid = Guid,
			nIndex = Index,
			nDeviceType = LightType,
			bConnected = IsConnected,
			bReConnect = IsReConnect.CurValueA,
			stComParam = new COM_PARAM
			{
				nComNum = (uint)ComName.CurValueA,
				nBaudRate = (uint)BaudRate.CurValueA,
				nDataBits = (uint)DataBits.CurValueA,
				nParity = (uint)ParityBit.CurValueA,
				nStopBits = (uint)StopBit.CurValueA
			},
			stIOPARAM = new IO_PARAM
			{
				nOutType = (uint)Device_IO.IOOutType.CurValueA,
				nOutputPolarity = (uint)Device_IO.OutputPolarity.CurValueA,
				nSendInterval = (uint)Device_IO.SendInterval.CurValueA,
				nPollingEnable = Device_IO.PollingEnable.CurValueA,
				nPollingInterval = (uint)Device_IO.PollingInterval.CurValueA,
				nDelayTime = (uint)Device_IO.DelayTime.CurValueA,
				nDurationTime = new uint[20],
				nElectricalLevel = new uint[20]
			}
		};
		for (int num = 0; num < 20; num++)
		{
			result.stIOPARAM.nDurationTime[num] = (uint)Device_IO.DurationTimes[num];
			result.stIOPARAM.nElectricalLevel[num] = (uint)Device_IO.ElectricalLevels[num];
		}
		return result;
	}

	/// <summary>
	/// 解析从底层获取的IO参数
	/// </summary>
	public void GetIOParam(IO_PARAM param)
	{
		IsNeedSetParam = false;
		Device_IO.IOOutType.CurValueA = (int)param.nOutType;
		Device_IO.OutputPolarity.CurValueA = (int)param.nOutputPolarity;
		Device_IO.SendInterval.CurValueA = (int)param.nSendInterval;
		Device_IO.PollingEnable.CurValueA = param.nPollingEnable;
		Device_IO.PollingInterval.CurValueA = (int)param.nPollingInterval;
		Device_IO.DelayTime.CurValueA = (int)param.nDelayTime;
		for (int i = 0; i < 20; i++)
		{
			Device_IO.DurationTimes[i] = (int)param.nDurationTime[i];
			Device_IO.ElectricalLevels[i] = (int)param.nElectricalLevel[i];
		}
		Device_IO.DurationTime.CurValueA = Device_IO.DurationTimes[0];
		IsNeedSetParam = true;
	}

	/// <summary>
	/// 通道参数转换为结构体
	/// </summary>
	/// <returns></returns>
	public ST_LIGHT_CONFIG_ID ConvertToST_LIGHT_CONFIG_ID()
	{
		return new ST_LIGHT_CONFIG_ID
		{
			nIndex = Index,
			nDeviceType = LightType,
			chszDeviceGuid = Guid,
			stLightConfig = new ST_LIGHT_CONFIG
			{
				channel1 = new LIGHT_CHANNEL_PARAM
				{
					nChannelNum = (Channels[0] as LightChannel).ChannelNumA,
					bChannelEnable = true,
					nLightBrightness = (Channels[0] as LightChannel).LightBrightnessA.CurValueA,
					nLightState = (Channels[0] as LightChannel).LightStateA.CurValueA,
					nTriggerEdge = (Channels[0] as LightChannel).TriggerEdgeA.CurValueA,
					nDurationTime = (Channels[0] as LightChannel).DurationTimeA.CurValueA,
					nLightSource = (Channels[0] as LightChannel).LightSourceA.CurValueA
				},
				channel2 = new LIGHT_CHANNEL_PARAM
				{
					nChannelNum = (Channels[1] as LightChannel).ChannelNumA,
					bChannelEnable = true,
					nLightBrightness = (Channels[1] as LightChannel).LightBrightnessA.CurValueA,
					nLightState = (Channels[1] as LightChannel).LightStateA.CurValueA,
					nTriggerEdge = (Channels[1] as LightChannel).TriggerEdgeA.CurValueA,
					nDurationTime = (Channels[1] as LightChannel).DurationTimeA.CurValueA,
					nLightSource = (Channels[0] as LightChannel).LightSourceA.CurValueA
				},
				channel3 = new LIGHT_CHANNEL_PARAM
				{
					nChannelNum = (Channels[2] as LightChannel).ChannelNumA,
					bChannelEnable = true,
					nLightBrightness = (Channels[2] as LightChannel).LightBrightnessA.CurValueA,
