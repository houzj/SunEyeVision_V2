	public void SetChannelShowStates()
	{
		Device_IO.HiddenPort(needHidden: false, 4);
		switch (LightType)
		{
		case 101:
		{
			foreach (object item in ChannelsA)
			{
				if ((item as LightChannel).ChannelNumA >= 5)
				{
					(item as LightChannel).IsShow = false;
					continue;
				}
				(item as LightChannel).IsShowDurationTime = false;
				(item as LightChannel).IsShowLightState = false;
				(item as LightChannel).IsShowTriggerEdge = false;
				(item as LightChannel).LightBrightnessA.MaxValueA = 255;
				(item as LightChannel).IsShow = true;
