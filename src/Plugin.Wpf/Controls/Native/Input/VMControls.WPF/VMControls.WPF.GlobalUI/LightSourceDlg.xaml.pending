<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI.LightSourceDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" x:Name="lightDlg" Title="{DynamicResource Lang_ControllerSet}" Height="448" Width="680" Loaded="lightDlg_Loaded" Closed="lightDlg_Closed" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="boolean" TargetType="{x:Type ToggleButton}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Image Name="Image" Source="/Apps.Style;component/Resources/swith_off.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Image" Property="Image.Source" Value="/Apps.Style;component/Resources/swith_on.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="MyInteger">
        <vm_port_1:LeftRightControl Height="32" ChildLeftWidth="{Binding LeftTextWidth, ElementName=lightDlg}">
          <vm_port_1:LeftRightControl.LeftContent>
            <Control Template="{StaticResource TextLeft}" />
          </vm_port_1:LeftRightControl.LeftContent>
          <vm_port_1:LeftRightControl.RightContent>
            <ContentControl ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding}" />
          </vm_port_1:LeftRightControl.RightContent>
        </vm_port_1:LeftRightControl>
      </DataTemplate>
      <DataTemplate x:Key="MyBoolean">
        <vm_port_1:LeftRightControl Height="32" ChildLeftWidth="{Binding LeftTextWidth, ElementName=lightDlg}">
          <vm_port_1:LeftRightControl.LeftContent>
            <Control Template="{StaticResource TextLeft}" />
          </vm_port_1:LeftRightControl.LeftContent>
          <vm_port_1:LeftRightControl.RightContent>
            <ContentControl ContentTemplate="{StaticResource Boolean_sub}" Content="{Binding}" />
          </vm_port_1:LeftRightControl.RightContent>
        </vm_port_1:LeftRightControl>
      </DataTemplate>
      <DataTemplate x:Key="MyEnumeration">
        <vm_port_1:LeftRightControl Height="32" ChildLeftWidth="{Binding LeftTextWidth, ElementName=lightDlg}">
          <vm_port_1:LeftRightControl.LeftContent>
            <Control Template="{StaticResource TextLeft}" />
          </vm_port_1:LeftRightControl.LeftContent>
          <vm_port_1:LeftRightControl.RightContent>
            <ContentControl ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding}" />
          </vm_port_1:LeftRightControl.RightContent>
        </vm_port_1:LeftRightControl>
      </DataTemplate>
      <DataTemplate x:Key="MyCommand">
        <vm_port_1:LeftRightControl Height="32" ChildLeftWidth="{Binding LeftTextWidth, ElementName=lightDlg}">
          <vm_port_1:LeftRightControl.LeftContent>
            <Control Template="{StaticResource TextLeft}" />
          </vm_port_1:LeftRightControl.LeftContent>
          <vm_port_1:LeftRightControl.RightContent>
            <Button Padding="4,0,4,0" Width="80" HorizontalAlignment="Left" Style="{StaticResource BottomButtonStyle}" Content="{vm_port_0_:ResourceBinding DisplayNameA}" Command="{Binding DataContext.ClickCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=StackPanel}}" />
          </vm_port_1:LeftRightControl.RightContent>
        </vm_port_1:LeftRightControl>
      </DataTemplate>
      <DataTemplate x:Key="Channel">
        <Grid Visibility="{Binding IsShow, Converter={StaticResource bool2VisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftTextWidth, ElementName=lightDlg}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="8" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Text="{Binding BrightString}" />
          <ContentControl Grid.Row="0" Grid.Column="1" ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding LightBrightnessA}" />
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
            <ContentControl ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding LightStateA}" Visibility="{Binding IsShowLightState, Converter={StaticResource bool2VisibilityConverter}}" />
            <ContentControl Margin="0,8" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding TriggerEdgeA}" Visibility="{Binding IsShowTriggerEdge, Converter={StaticResource bool2VisibilityConverter}}" />
            <ContentControl ContentTemplate="{StaticResource MyInteger}" Content="{Binding DurationTimeA}" Visibility="{Binding IsShowDurationTime, Converter={StaticResource bool2VisibilityConverter}}" />
            <ContentControl ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding LightSourceA}" Visibility="{Binding IsShowLightSource, Converter={StaticResource bool2VisibilityConverter}}" />
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource GlobalMouseOverBg}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ListView}" TargetType="{x:Type ListView}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
          <Setter Property="ScrollViewer.PanningMode" Value="Both" />
          <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListView}">
                <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="1,1,0,1" SnapsToDevicePixels="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="{TemplateBinding Control.Padding}" Style="{StaticResource RecScrollViewer}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  </ScrollViewer>
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="ItemsControl.IsGrouping" Value="True" />
                      <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
          <Style.Setters>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                  <Border Name="bd" SnapsToDevicePixels="True" Height="40px" Padding="{TemplateBinding Control.Padding}" Background="{x:Null}">
                    <Grid Margin="10,0,8,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ModuleForeground}" Text="{Binding IndexA}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="110" FontSize="14" Foreground="{DynamicResource ModuleForeground}" Text="{Binding NameA}" ToolTip="{Binding NameA}" />
                      <ToggleButton Grid.Column="2" Style="{StaticResource boolean}" IsChecked="{Binding IsConnected}" Command="{Binding ConnectDevCommand}" />
                    </Grid>
                    <FrameworkElement.ContextMenu>
                      <vm_port_0:HikContextMenu>
                        <MenuItem Name="menuItem_RenameDev" Header="{DynamicResource Lang_Rename}" Command="{Binding ReNameDevCommand}" />
                        <MenuItem Name="menuItem_DeleteDev" Header="{DynamicResource Lang_Delet}" Command="{Binding DelDevCommand}" IsEnabled="{Binding IsDeleteEnabled}" />
                      </vm_port_0:HikContextMenu>
                    </FrameworkElement.ContextMenu>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter Value="{DynamicResource GlobalMouseOverBg}" TargetName="bd" Property="Border.Background" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Value="{DynamicResource GlobalMouseOverBg}" TargetName="bd" Property="Border.Background" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style.Setters>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Background="{DynamicResource GlobalGridBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="15,10,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource 设备列表}" Foreground="{DynamicResource ModuleForeground}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
        <Button Name="btnAddDevice" Grid.Column="1" Style="{StaticResource BaseImage_ButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Command="{Binding AddDevCommand}" IsEnabled="{Binding IsAddEnabled}">
          <Image Stretch="None" Source="/Apps.Style;component/Resources/add_normal.png" />
          <FrameworkElement.Tag>
            <Image Stretch="None" Source="/Apps.Style;component/Resources/add_click.png" />
          </FrameworkElement.Tag>
        </Button>
      </Grid>
      <Grid Row="1" Margin="0,5">
        <ListView Name="DevList" ItemsSource="{Binding ItemsA}" SelectedItem="{Binding CurLightDeviceA}" />
      </Grid>
    </Grid>
    <Grid Column="1" Margin="15,0,5,0" DataContext="{Binding CurLightDeviceA}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <Trigger Property="FrameworkElement.DataContext" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <ScrollViewer Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto" Tag="1">
        <StackPanel Focusable="True">
          <Grid Margin="5,10,5,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="32" />
              <RowDefinition Height="8" />
              <RowDefinition Height="32" />
              <RowDefinition Height="8" />
              <RowDefinition Height="32" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Tab_Basic Params}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="34,0,40,0" BorderBrush="#FFFF0000">
              <ContentControl ContentTemplate="{StaticResource Enumeration}" Content="{Binding Brand}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentControl}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsConnected}">
                        <Setter Property="IsEnabled" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContentControl>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="BorderThickness" Value="0" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsParamError}">
                      <Setter Property="BorderThickness" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Border>
            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource ProtocolType}" ToolTip="{DynamicResource ProtocolType}" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Margin="34,0,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ParamsTabForeground}" Margin="5,0" Text="{Binding CommTypeA}" />
            <ContentControl Grid.Row="5" Grid.ColumnSpan="2" Margin="34,0,0,0" ContentTemplate="{StaticResource MyBoolean}" Content="{Binding IsReConnect}" />
          </Grid>
          <Rectangle Height="1" Margin="5" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
          <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Tab_Com Param}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Name="SerialPortSettingPanel" Grid.Row="1">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Enumeration}" Content="{Binding ComName}" IsEnabled="{Binding IsLocalMode}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Enumeration}" IsEnabled="False" Content="{Binding BaudRate}" Visibility="{Binding IsLocalMode, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Enumeration}" IsEnabled="False" Content="{Binding DataBits}" Visibility="{Binding IsLocalMode, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Enumeration}" IsEnabled="False" Content="{Binding ParityBit}" Visibility="{Binding IsLocalMode, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Enumeration}" IsEnabled="False" Content="{Binding StopBit}" Visibility="{Binding IsLocalMode, Converter={StaticResource bool2VisibilityConverter}}" />
              <Rectangle Height="1" Margin="0,10,0,0" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                  <DataTrigger Value="0" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="8" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="14" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_IOParams}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1" DataContext="{Binding Device_IO}">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding IOOutType}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding OutputPolarity}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="6" Binding="{Binding Parent.Brand.CurValueA}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Value="12" Binding="{Binding Parent.Brand.CurValueA}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Value="15" Binding="{Binding Parent.Brand.CurValueA}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContentControl>
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding SendInterval}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="14" Binding="{Binding Parent.Brand.CurValueA}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContentControl>
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding CurPort}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="14" Binding="{Binding Parent.Brand.CurValueA}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContentControl>
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding DurationTime}" Visibility="{Binding IsShowPortParam, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding IOEnableElectricalLevel}" Visibility="{Binding IsShowPortParam, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyBoolean}" Content="{Binding PollingEnable}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding PollingInterval}" Visibility="{Binding PollingEnable.CurValueA, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding DelayTime}" />
              <Rectangle Height="1" Margin="0,10,0,0" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="4" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="6" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="7" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="9" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="10" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="11" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="12" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="14" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="15" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Tab_Light Param}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[0]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[1]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[2]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[3]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[4]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[5]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[6]}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource Channel}" Content="{Binding ChannelsA[7]}" />
              <Rectangle Height="1" Margin="0,10,0,0" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="0" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="6" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="8" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_IOParams}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1" DataContext="{Binding Device_IO}">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding IOOutType}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding OutputPolarity}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding DurationTime}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyBoolean}" Content="{Binding PollingEnable}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding PollingInterval}" Visibility="{Binding PollingEnable.CurValueA, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding DelayTime}" />
              <Rectangle Height="1" Margin="0,10,0,0" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="8" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,-10,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_IOOutputParams}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1" DataContext="{Binding Device_IOOutput}">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding CurOutput}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding Source}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyBoolean}" Content="{Binding Invert}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyBoolean}" IsEnabled="False" Content="{Binding Status}" />
              <Rectangle Height="1" Margin="5" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="9" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_IOInputParams}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1" DataContext="{Binding Device_IOInput}">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding CurInput}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyBoolean}" Content="{Binding Invert}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyBoolean}" IsEnabled="False" Content="{Binding Status}" />
              <Rectangle Height="1" Margin="5" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="9" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_TimerParams}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1" DataContext="{Binding Device_Timer}">
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding CurTimer}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding Duration}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding Delay}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding Mode}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyInteger}" Content="{Binding BurstCount}" Visibility="{Binding IsShowDisContinueParam, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding TriggerSource}" Visibility="{Binding IsShowDisContinueParam, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyEnumeration}" Content="{Binding TriggerActivation}" Visibility="{Binding IsShowTriggerActivationParam, Converter={StaticResource bool2VisibilityConverter}}" />
              <ContentControl Margin="34,8,40,0" ContentTemplate="{StaticResource MyCommand}" Content="{Binding Run}" Visibility="{Binding IsShowRun, Converter={StaticResource bool2VisibilityConverter}}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="9" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
          <Grid Margin="5,-10,5,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_TriggerOperate}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ModuleForeground}" />
            <StackPanel Grid.Row="1">
              <ContentControl Content="{Binding TriggerProcedure}" />
              <Rectangle Height="1" Margin="0,10,0,0" StrokeThickness="0" Fill="{DynamicResource GlobalRectFill}" />
            </StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="4" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="6" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="7" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="10" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="11" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="12" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="15" Binding="{Binding Brand.CurValueA}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsConnected}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource GlobalBorderBg}">
      <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Confirm_Click" />
    </Border>
  </Grid>
</vm_port_0:BaseWindow>