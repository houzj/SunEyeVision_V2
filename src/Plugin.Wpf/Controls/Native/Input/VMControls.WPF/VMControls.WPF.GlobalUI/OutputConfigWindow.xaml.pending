<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI.OutputConfigWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:PCommom="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:paramTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" Title="{DynamicResource Lang_OutputConfig}" Height="584" Width="836" xmlns:globalui="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.GlobalUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:vm_port_2="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <Grid Background="{DynamicResource GlobalMouseOverBg}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
          <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
          <x:StaticExtension Member="vm_port_2:ColorThemesResourceDictionary.Instance" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="SearchButton" TargetType="{x:Type Button}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border BorderBrush="{DynamicResource LogicTypeButtonBB}" CornerRadius="2">
                  <Image Name="icon" Height="32" Width="32" Source="/Apps.Style;component/Resources/ic_search_normal.png" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_search_hover.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="delete" TargetType="{x:Type Button}" BasedOn="{StaticResource deleteButton}">
          <EventSetter Event="Click" Handler="Delete_OnHandler" />
        </Style>
        <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
          <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
          <Setter Property="ItemsPanel">
            <Setter.Value>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ItemTemplate">
            <Setter.Value>
              <DataTemplate DataType="OutputFilterList">
                <Border BorderThickness="1" Visibility="{Binding OutputEnabled, Converter={StaticResource bool2VisibilityConverter}}">
                  <Grid Height="32">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="15*" />
                      <ColumnDefinition Width="10*" />
                      <ColumnDefinition Width="5*" />
                      <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Width="185" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" Grid.Column="0" FontSize="14" FontFamily="Microsoft YaHei" ToolTip="{Binding FullNameA}" Text="{Binding FullNameA}" />
                    <TextBox Margin="1" Width="130" Grid.Column="1" Foreground="{DynamicResource ParamsTabForeground}" Height="28" VerticalAlignment="Center" Style="{StaticResource input}" ToolTip="{Binding CustomName}" Text="{Binding CustomName}" />
                    <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="2" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource ParamsTabForeground}" Text="{Binding ValueTypeA}" ToolTip="{Binding ValueTypeA}" />
                    <Button HorizontalAlignment="Left" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource delete}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="cbx" TargetType="{x:Type ToggleButton}">
          <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
          <Setter Property="IsTabStop" Value="False" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="ButtonBase.ClickMode" Value="Press" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
                  <Image Name="icon" Height="16" Width="16" Source="/Apps.Style;component/Resources/combo_ic_triangle_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/combo_ic_triangle_click.png" />
                  </Trigger>
                  <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                    <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/combo_ic_triangle_click.png" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="combobox" TargetType="{x:Type ComboBox}">
          <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
          <Setter Property="Foreground" Value="{DynamicResource TextBox.Normal.Forground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
          <Setter Property="Background" Value="{DynamicResource ListViewComboBoxBackground}" />
          <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
          <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Height" Value="30" />
          <Setter Property="ItemContainerStyle">
            <Setter.Value>
              <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                      <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="Back" Value="{DynamicResource ListViewComboBoxIsSelected}" Property="Border.Background" />
                        </Trigger>
                        <Trigger Property="ListBoxItem.IsSelected" Value="True">
                          <Setter TargetName="Back" Value="{DynamicResource ListViewComboBoxIsSelected}" Property="Border.Background" />
                          <Setter Value="{DynamicResource TitleColor}" Property="Foreground" />
                        </Trigger>
                        <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                          <Setter TargetName="Back" Value="{DynamicResource OutputHighlightBackground}" Property="Border.Background" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Setter.Value>
          </Setter>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ComboBox}">
                <Grid Background="{TemplateBinding Control.Background}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                  </Grid.ColumnDefinitions>
                  <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                    <Grid>
                      <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="{DynamicResource ListViewComboBoxBackground}" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                        <Border.Background>
                          <LinearGradientBrush>
                            <GradientStop Offset="0.0" Color="#FCFCFC" />
                            <GradientStop Offset="0.15" Color="#FCFCFC" />
                            <GradientStop Offset="1" Color="#F7F7F7" />
                          </LinearGradientBrush>
                        </Border.Background>
                        <UIElement.Effect>
                          <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                        </UIElement.Effect>
                        <UIElement.RenderTransform>
                          <TranslateTransform X="-4" />
                        </UIElement.RenderTransform>
                        <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                        </ScrollViewer>
                      </Border>
                    </Grid>
                  </Popup>
                  <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{StaticResource cbx}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Grid Column="0" Margin="11,0,0,0">
                    <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                    <ContentPresenter />
                  </Grid>
                  <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  </Trigger>
                  <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                    <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                  </DataTrigger>
                  <Trigger Property="ComboBox.IsEditable" Value="True">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Name="LeftPanel" Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="284" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Margin="10" BorderBrush="{DynamicResource GlobalRectFill}" BorderThickness="1">
        <Grid Background="{DynamicResource TabPanalLight}">
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="32" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Foreground="{DynamicResource ModuleForeground}" Margin="12,15,0,0" Text="{DynamicResource Lang_SelectList}" FontFamily="Microsoft YaHei" FontWeight="Bold" TextAlignment="Left" FontSize="14" />
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="162" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="SearchComboBox" SelectedIndex="0" Grid.Column="0" Margin="12,0,0,0" Style="{StaticResource combobox}" Height="32">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                  <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding ElementName=SearchComboBox}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
              <ComboBoxItem Content="{DynamicResource All_Type}" />
              <ComboBoxItem Content="{DynamicResource Lang_Number}" />
              <ComboBoxItem Content="{DynamicResource Lang_Integer}" />
              <ComboBoxItem Content="{DynamicResource Lang_Float}" />
              <ComboBoxItem Content="{DynamicResource Lang_String}" />
              <ComboBoxItem Content="{DynamicResource ImageData}" />
              <ComboBoxItem Content="{DynamicResource Lang_PointSet}" />
            </ComboBox>
            <StackPanel Name="StackPanel" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
              <TextBox Name="SearchText" FontSize="14" Width="142" Style="{StaticResource input}" Tag="{DynamicResource All_Type}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="TextChanged">
                    <i:InvokeCommandAction Command="{Binding SearchTextChangedCommand}" CommandParameter="{Binding ElementName=SearchText}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </TextBox>
              <Button Width="32" Height="32" Margin="-32,0,0,0" VerticalAlignment="Center" Style="{StaticResource SearchButton}" Command="{Binding SearchCommand}" />
            </StackPanel>
          </Grid>
          <Grid Row="2">
            <vm_port_1:OutputConfigTreeView Name="outputConfigTreeView" Margin="10" ItemsSource="{Binding EnumEntrysA}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                  <PCommom:ParamsEventCommand Command="{Binding ClickCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </vm_port_1:OutputConfigTreeView>
          </Grid>
        </Grid>
      </Border>
      <Grid Column="2" Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="10,15,0,0" Text="{DynamicResource Lang_OutputParam}" FontFamily="Microsoft YaHei" FontWeight="Bold" TextAlignment="Left" FontSize="14" />
        <Button Content="{DynamicResource Clear}" HorizontalAlignment="Right" Style="{StaticResource BottomButtonStyle}" Width="66" Height="24" Margin="0,14,15,0" Command="{Binding ClearCommand}" />
        <Grid Row="1">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="Foreground" Value="{DynamicResource ModuleForeground}" />
                <Setter Property="FontSize" Value="14px" />
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="5*" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="10,0,0,0" Grid.Column="0" Text="{DynamicResource Lang_Name}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Lang_CustomName}" />
          <TextBlock Grid.Column="2" Text="{DynamicResource Lang_Type}" />
          <TextBlock Grid.Column="3" Text="{DynamicResource Lang_Operate}" />
        </Grid>
        <Grid Row="2" VerticalAlignment="Top" Height="430">
          <ScrollViewer Name="ScrollViewer" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding Path=Height, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}">
            <ItemsControl ItemsSource="{Binding FiltersA}" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource GlobalBorderBg}">
      <Button Content="{DynamicResource Confirm}" HorizontalAlignment="Right" Style="{StaticResource BottomButtonStyle}" Width="66" Height="24" Margin="0,0,15,0" Click="Close_OnClick" />
    </Border>
  </Grid>
</vm_port_0:BaseWindow>