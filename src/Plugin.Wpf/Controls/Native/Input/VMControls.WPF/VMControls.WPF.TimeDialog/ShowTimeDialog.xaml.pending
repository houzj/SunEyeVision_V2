<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.TimeDialog.ShowTimeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls" xmlns:paramtab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" Title="{DynamicResource Lang_TimeView}" Height="420" Width="370" xmlns:timedialog="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.TimeDialog" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMUtility.Convert" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Controls;component/Styles/BaseWindowStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <vm_port_1:LongTextConvert x:Key="LongTextConvert" FontSize="13" MaxLen="95" FontFamily="Microsoft YaHei" />
      <Style x:Key="TimeListViewStyle" TargetType="{x:Type ListView}">
        <Setter Property="ItemsControl.AlternationCount" Value="2" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <ScrollViewer Tag="1" Style="{StaticResource RecScrollViewer}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </ScrollViewer>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
        <Style.Setters>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListViewItem}">
                <Border Name="bd" SnapsToDevicePixels="True" Height="34px" Padding="0" BorderThickness="1,0" BorderBrush="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="119" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" MaxWidth="108" Text="{Binding Name, Converter={StaticResource LongTextConvert}}" ToolTip="{Binding Name}" />
                    <Rectangle Grid.Column="1" Width="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
                    <TextBlock Name="tbTool" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" Text="{Binding ModuleTime, Mode=OneWay, StringFormat=N2}" />
                    <Rectangle Grid.Column="3" Width="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
                    <TextBlock Name="tbAlgorithm" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" Text="{Binding AlgorithmTime, Mode=OneWay, StringFormat=N2}" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="False" Binding="{Binding IsShowModuleLastExcuteTime}">
                    <Setter TargetName="tbTool" Property="TextBlock.Text" Value="0.00" />
                    <Setter TargetName="tbAlgorithm" Property="TextBlock.Text" Value="0.00" />
                  </DataTrigger>
                  <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter TargetName="bd" Value="{DynamicResource Col_ProcessTimeConsuming_Subfrom_AlternationIndex1}" Property="Border.Background" />
                  </Trigger>
                  <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter TargetName="bd" Value="{DynamicResource Col_ProcessTimeConsuming_Subfrom_AlternationIndex2}" Property="Border.Background" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style.Setters>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource Col_SubForm_Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="35" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{DynamicResource Lang_FlowTime}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" Margin="20,0,0,0" VerticalAlignment="Center" />
      <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=ProcessTime, Mode=OneWay, StringFormat=N2}" />
      <TextBlock Text="ms" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Row="1" Margin="18,0,18,13">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Title}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Lang_ModuleName}" ToolTip="{DynamicResource Lang_ModuleName}" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
        <Rectangle Grid.Column="1" Width="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
        <TextBlock Grid.Column="2" Text="{DynamicResource Lang_ToolTime}" ToolTip="{DynamicResource Lang_ToolTime}" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
        <Rectangle Grid.Column="3" Width="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
        <TextBlock Grid.Column="4" Text="{DynamicResource Lang_AlgorithmTime}" ToolTip="{DynamicResource Lang_AlgorithmTime}" Foreground="{DynamicResource Col_ProcessTimeConsuming_Subfrom_Forebackground}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
      <StackPanel Grid.Row="1">
        <ListView Style="{StaticResource TimeListViewStyle}" MaxHeight="300" ItemsSource="{Binding Modules}" />
        <Rectangle Height="1" StrokeThickness="0" Fill="{DynamicResource Col_ProcessTimeConsuming_Subfrom_BorderBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</vm_port_0:BaseWindow>