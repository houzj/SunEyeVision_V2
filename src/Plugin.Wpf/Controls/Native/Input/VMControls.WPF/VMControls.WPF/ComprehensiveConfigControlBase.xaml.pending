<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.ComprehensiveConfigControlBase" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:AppsxmlUI="clr-namespace:Apps.XmlUI;assembly=Apps.XmlUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI">
  <Control.Template>
    <ControlTemplate>
      <vm_port_0:ParamsTabUserControl Name="paramstab" ROIPartUI="{Binding ROIPartUI, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" IsEditState="{Binding IsEditState, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    </ControlTemplate>
  </Control.Template>
</Control>