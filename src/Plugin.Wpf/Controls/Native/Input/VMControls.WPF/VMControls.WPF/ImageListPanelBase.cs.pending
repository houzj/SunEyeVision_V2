	/// <summary>
	/// 刷新当前图像操作
	/// </summary>
	/// <param name="d"></param>
	/// <param name="e"></param>
	public static void TargetValueChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ImageListPanelBase imageListPanelBase = d as ImageListPanelBase;
		string path = e.NewValue as string;
		if (imageListPanelBase == null || !imageListPanelBase.IsTimeRefreshView())
		{
			imageListPanelBase.needSelectImagePath = path;
		}
		else
		{
			imageListPanelBase.GetModuleSel(path);
		}
	}

	private static void CurSelectedModuleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		if (d is ImageListPanelBase imageListPanelBase)
		{
			imageListPanelBase.NotifyPropertyChanged("IsImageSourceModule");
		}
	}

	private static void DoFreshImageListChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		(d as ImageListPanelBase).RefreshImageList();
	}

	public ImageListPanelBase()
	{
		if (!DesignerProperties.GetIsInDesignMode(this))
		{
			Loaded += ImageListPanel_Loaded;
			Unloaded += ImageListPanel_Unloaded;
		}
	}

	private void ImageListPanel_Loaded(object sender, RoutedEventArgs e)
	{
		refreshImageThreadAlive = true;
		LogHelper.Info("设置refreshImageThreadAlive = true");
		if (refreshImageThread == null || !refreshImageThread.IsAlive)
		{
			LogHelper.Info("ImageListPanelBase控件创建缩略图刷新线程");
			refreshImageThread = new Thread(() =>
			{
				try
				{
					while (refreshImageThreadAlive)
					{
						if (dataNumForReceiveStore > 0)
						{
							LogHelper.Info($"mutexrefreshImageThread:dataNumForReceiveStore={dataNumForReceiveStore}");
							int[] array = forSendStore;
							lock (mutexrefreshImageThread)
							{
								forSendStore = forReceiveStore;
								dataNumForSendStore = dataNumForReceiveStore;
								dataNumForReceiveStore = 0;
								forReceiveStore = array;
							}
							for (int i = 0; i < dataNumForSendStore; i++)
							{
								int index = forSendStore[i];
								LoadThumbnailImage(index);
								forSendStore[i] = -1;
							}
							dataNumForSendStore = 0;
						}
						if (needSelectImagePath != null)
						{
							Dispatcher.Invoke(() =>
							{
								GetModuleSel(needSelectImagePath);
							});
						}
						Thread.Sleep(100);
					}
					LogHelper.Info("ImageListPanelBase控件停止刷新缩略图");
				}
				catch (ThreadAbortException)
				{
					LogHelper.Info("ImageListPanelBase控件停止数据读取");
				}
			})
			{
				IsBackground = true,
				Priority = ThreadPriority.BelowNormal
			};
			refreshImageThread.Start();
		}
		PropertyManager.Register("ExcuteType");
		PropertyManager.UpdateDisplayStatus -= OnUpdateExcuteType;
		PropertyManager.UpdateDisplayStatus += OnUpdateExcuteType;
		VmSolution.OnReportModuleData += VmSolution_OnReportModuleData;
	}

	private void ImageListPanel_Unloaded(object sender, RoutedEventArgs e)
	{
		if (refreshImageThread != null)
		{
			refreshImageThreadAlive = false;
			LogHelper.Info("设置refreshImageThreadAlive = false");
		}
		PropertyManager.UpdateDisplayStatus -= OnUpdateExcuteType;
		PropertyManager.UnRegister("ExcuteType");
		VmSolution.OnReportModuleData -= VmSolution_OnReportModuleData;
	}

	/// <summary>
	/// 同步更新是否选中执行
	/// </summary>
	/// <param name="name"></param>
	/// <param name="value"></param>
	private void OnUpdateExcuteType(string name, string value)
	{
		if (name == "ExcuteType" && value != GetHashCode().ToString())
		{
			ButtonSelecter_ImageList imageList = DataContext as ButtonSelecter_ImageList;
			UpdateExcuteType(imageList);
		}
	}

	private void UpdateExcuteType(ButtonSelecter_ImageList imageList)
	{
		if (imageList != null)
		{
			IsSelectMode = imageList.SelectEnable;
			GetModuleSelectMode();
		}
	}

	public void OnExcuteTypeParamChanged()
	{
		PropertyManager.DisplayExecute("ExcuteType", GetHashCode().ToString());
	}

	private void OnSubscribeFolderModeChanged(object sender, EventArgs e)
	{
		if (DataContext is ButtonSelecter_ImageList buttonSelecter_ImageList)
		{
			buttonSelecter_ImageList.SelectEnable = false;
			UpdateExcuteType(buttonSelecter_ImageList);
		}
	}

	/// <summary>
	/// 底层模块上报数据到主界面，用于订阅文件夹时刷新图像
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="args"></param>
	private void VmSolution_OnReportModuleData(object sender, ObjectEventArgs args)
	{
		if (args.Param is ImvsSdkDefine.IMVS_ALGORITHM_INIT_RESULT_INFO iMVS_ALGORITHM_INIT_RESULT_INFO)
		{
			IVmModule vMModule = GetVMModule();
			if (vMModule != null && vMModule.ID == iMVS_ALGORITHM_INIT_RESULT_INFO.nModuleID && iMVS_ALGORITHM_INIT_RESULT_INFO.nType == 268439552)
			{
				needReflashImages = true;
			}
		}
	}

	private bool IsTimeRefreshView(int timeSpan = 50)
	{
		bool flag = (DateTime.Now - curTime).TotalMilliseconds > (double)timeSpan;
		if (flag)
		{
			curTime = DateTime.Now;
		}
		return flag;
	}

	private void RefreshImageList()
	{
		Dispatcher.BeginInvoke((Action)(() =>
		{
			try
			{
				string value = "";
				if (GetVMModule() != null)
				{
					value = ((IUserStringData)GetVMModule().Params)["ImageNumber"];
				}
				if (!string.IsNullOrEmpty(value))
				{
					int num = Convert.ToInt32(value);
					if (num == 0)
					{
						ImageList.Clear();
					}
					List<string> list = new List<string>();
					foreach (ImageEntity image in ImageList)
					{
						list.Add(image.ImagePath);
					}
					for (int i = 0; i < num; i++)
					{
						string text = "";
						if (GetVMModule() != null)
						{
							text = ((IUserStringData)GetVMModule().Params)["ImagePath" + i];
						}
						AddImageToList(text);
						if (list.Contains(text))
						{
							list.Remove(text);
						}
					}
					if (list.Count() > 0)
					{
						int j;
						for (j = 0; j < list.Count(); j++)
						{
							ImageList.Remove(ImageList.FirstOrDefault((ImageEntity p) => p.ImagePath == list[j]));
						}
					}
				}
				GetModuleSelectMode();
				GetModuleSel();
				UpdateImageListSource();
			}
			catch (Exception ex)
			{
				LogHelper.Error("图像列表初始化异常:" + ex.Message);
			}
		}));
	}

	/// <summary>
	/// 根据底层当前图像刷新图像列表Selitem
	/// </summary>
	private void GetModuleSel(string path = null)
	{
		try
		{
			string text = null;
			if (path == null)
			{
				if (GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList)
				{
					object obj = ((GetVMModule() as VmModule)?["CurImagePath.Value"] as Array)?.GetValue(0);
					if (obj is ImvsSdkDefine.IMVS_MODULE_STRING_VALUE_EX)
					{
						text = ((ImvsSdkDefine.IMVS_MODULE_STRING_VALUE_EX)obj).strValue;
					}
				}
			}
			else
			{
				text = path;
			}
			if (text == null)
			{
				return;
			}
			foreach (ImageEntity image in ImageList)
			{
				if (image.ImagePath == text.ToString())
				{
					CurImageIndex = ImageList.IndexOf(image);
					CurImageIndexT = CurImageIndex + 1;
				}
			}
			if (CurImageIndexT != 0)
			{
				needSelectionTrigger = false;
				CurSelectedIndex = CurImageIndex;
				needSelectionTrigger = true;
			}
			IsReturnFirstForce = false;
			int curSelectedIndex = CurSelectedIndex;
			int num = curSelectedIndex - (int)Math.Floor(curActualWidth / 76.0) + 1;
			if (num < 0)
			{
				num = 0;
			}
			if (curScrollOffset < num || curScrollOffset > curSelectedIndex)
			{
				scrollViewer?.ScrollToHorizontalOffset(num);
			}
			needSelectImagePath = null;
		}
		catch (Exception ex)
		{
			LogHelper.Error("图像刷新错误GetModuleSel():" + ex.Message);
		}
	}

	public void NotifyPropertyChanged(string propertyName)
	{
		if (PropertyChanged != null)
		{
			PropertyChanged(this, new PropertyChangedEventArgs(propertyName));
		}
	}

	/// <summary>
	/// 图像删除按钮响应
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void BtnDelete_Click(object sender, RoutedEventArgs e)
	{
		Ioc.Get<IUnRedoService>()?.Register(new RootOperation
		{
			RootOperType = "ModifyConfig"
		}, AppLocalizationService.GetLang("修改配置") + ": " + GetVMModule().Name);
		byte[] value = new byte[4];
		try
		{
			((IUserBytesData)GetVMModule().Params)["UseModel"] = value;
		}
		catch (Exception)
		{
			return;
		}
		Button button = sender as Button;
		object tag = button.Tag;
		ImageEntity imageEntity = (ImageEntity)tag;
		int num = ImageList.IndexOf(imageEntity);
		if (CurImageIndex == num)
		{
			CurImageIndexT = 0;
		}
		ImageList.Remove((ImageEntity)tag);
		if (GetVMModule() != null)
		{
			try
			{
				((IUserStringData)GetVMModule().Params)["DeleteImage"] = imageEntity.ImagePath;
			}
			catch (Exception)
			{
			}
		}
		if (num < CurImageIndex)
		{
			CurImageIndexT--;
		}
		UpdateImageListSource();
		Ioc.Get<IUnRedoService>()?.RemoveEmptyOperation();
		(GetRoot()?.FindBaseNodeByName("CurrentImagePath") as ButtonSelecter_ImageList).FreshImageListFlag++;
	}

	/// <summary>
	/// 控制图像列表中图像名grid 鼠标移入时的显示
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void Grid_MouseEnter(object sender, MouseEventArgs e)
	{
		if (IsImageSourceModule)
		{
			NameValueItem nameValueItem = IsSubscribeFolderMode as NameValueItem;
			if (!(nameValueItem.Value == "True"))
			{
				Grid grid = sender as Grid;
				Button button = grid.Tag as Button;
				button.Visibility = Visibility.Visible;
			}
		}
	}

	/// <summary>
	/// 控制图像列表中图像名grid 鼠标移出时的隐藏
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void Grid_MouseLeave(object sender, MouseEventArgs e)
	{
		if (IsImageSourceModule && sender is Grid { Tag: Button tag })
		{
			tag.Visibility = Visibility.Collapsed;
		}
	}

	/// <summary>
	/// 获取模块信息
	/// </summary>
	/// <returns></returns>
	public IVmModule GetVMModule()
	{
		if (OwnerModule == null)
		{
			AlgorithmTabRoot algorithmTabRoot = GetRoot();
			if (algorithmTabRoot == null)
			{
				return null;
			}
			OwnerModule = algorithmTabRoot.Owner as IVmModule;
			return OwnerModule;
		}
		return OwnerModule;
	}

	private AlgorithmTabRoot GetRoot()
	{
		if (root == null)
		{
			Dispatcher.Invoke(() =>
			{
				if (DataContext is ButtonSelecter_ImageList buttonSelecter_ImageList)
				{
					root = buttonSelecter_ImageList.GetTopBaseNode() as AlgorithmTabRoot;
				}
			});
		}
		return root;
	}

	/// <summary>
	/// 图像清空按钮响应
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void BtnImageClear_Click(object sender, RoutedEventArgs e)
	{
		Ioc.Get<IUnRedoService>()?.Register(new RootOperation
		{
			RootOperType = "ModifyConfig"
		}, AppLocalizationService.GetLang("修改配置") + ": " + GetVMModule().Name);
		byte[] value = new byte[4];
		try
		{
			((IUserBytesData)GetVMModule().Params)["UseModel"] = value;
		}
		catch (Exception)
		{
			return;
		}
		ImageList.Clear();
		CurImageIndexT = 0;
		if (GetVMModule() != null)
		{
			try
			{
				((IUserStringData)GetVMModule().Params)["ClearImage"] = "";
			}
			catch (Exception)
			{
			}
		}
		NotifyPropertyChanged("ImageCount");
		Ioc.Get<IUnRedoService>()?.RemoveEmptyOperation();
		(GetRoot()?.FindBaseNodeByName("CurrentImagePath") as ButtonSelecter_ImageList).FreshImageListFlag++;
	}

	/// <summary>
	/// 添加图片按钮响应
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void BtnImageAdd_Click(object sender, RoutedEventArgs e)
	{
		if (Islocal)
		{
			isWindowsPicture = true;
			Microsoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();
			openFileDialog.CheckFileExists = true;
			openFileDialog.CheckPathExists = true;
			openFileDialog.Multiselect = true;
			string text = "|*.bmp;*.jpeg;*.jpg;*.png;*.tif;*.tiff";
			if (GetVMModule()?.ModuleTypeName == "ImageSource3DModule")
			{
				text = "|*.raw";
			}
			string filter = (openFileDialog.Filter = AppLocalizationService.GetLang("图像文件") + text);
			openFileDialog.Filter = filter;
			string path = ConfigurationHelper.INIGetDefaultOpenPath(GetVMModule()?.ModuleDir);
			SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.UIHelper.Extern.UIHelper.CheckInitDirectory(openFileDialog, path);
			if (openFileDialog.ShowDialog() == false)
			{
				return;
			}
			DoAddImages(openFileDialog.FileNames);
			if (File.Exists(openFileDialog.FileName))
			{
				ConfigurationHelper.INISetDefaultOpenPath(Path.GetDirectoryName(openFileDialog.FileName), GetVMModule()?.ModuleDir);
			}
		}
		(GetRoot()?.FindBaseNodeByName("CurrentImagePath") as ButtonSelecter_ImageList).FreshImageListFlag++;
	}

	protected void LocalImage_Click(object sender, RoutedEventArgs e)
	{
		isWindowsPicture = true;
		Microsoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();
		openFileDialog.CheckFileExists = true;
		openFileDialog.CheckPathExists = true;
		openFileDialog.Multiselect = true;
		openFileDialog.Filter = AppLocalizationService.GetLang("图像文件") + "|*.bmp;*.jpeg;*.jpg;*.png;*.tif;*.tiff";
		string path = ConfigurationHelper.INIGetDefaultOpenPath(GetVMModule()?.ModuleDir);
		SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.UIHelper.Extern.UIHelper.CheckInitDirectory(openFileDialog, path);
		if (openFileDialog.ShowDialog() != false)
		{
			DoAddImages(openFileDialog.FileNames);
			if (File.Exists(openFileDialog.FileName))
			{
				ConfigurationHelper.INISetDefaultOpenPath(Path.GetDirectoryName(openFileDialog.FileName), GetVMModule()?.ModuleDir);
			}
		}
	}

	protected void LinuxImage_Click(object sender, RoutedEventArgs e)
	{
		isWindowsPicture = false;
		DirectoryBrowser.OpenFileDialog openFileDialog = new DirectoryBrowser.OpenFileDialog();
		openFileDialog.CheckFileExists = true;
		openFileDialog.Filter = AppLocalizationService.GetLang("图像文件") + "|*.bmp;*.jpeg;*.jpg;*.png;*.tif;*.tiff";
		string initialDirectory = ConfigurationHelper.INIGetDefaultOpenRemotePath(GetVMModule()?.ModuleDir);
		openFileDialog.InitialDirectory = initialDirectory;
		if (openFileDialog.ShowDialog() != false)
		{
			DoAddImages(openFileDialog.FileNames);
			string directoryName = openFileDialog.GetDirectoryName();
			ConfigurationHelper.INISetDefaultOpenRemotePath(directoryName, GetVMModule()?.ModuleDir);
		}
	}

	private void DoAddImages(string[] fileNames)
	{
		Ioc.Get<IUnRedoService>()?.Register(new RootOperation
		{
			RootOperType = "ModifyConfig"
		}, AppLocalizationService.GetLang("修改配置") + ": " + GetVMModule().Name);
		byte[] value = new byte[4];
		try
		{
			((IUserBytesData)GetVMModule().Params)["UseModel"] = value;
		}
		catch (Exception)
		{
			return;
		}
		for (int i = 0; i < fileNames.Length; i++)
		{
			string path = "/Picture/";
			if (Islocal)
			{
				if (!AddImageLocal(fileNames[i]))
				{
					break;
				}
			}
			else if (!AddImage(fileNames[i], path))
			{
				break;
			}
		}
		UpdateImageListSource();
		Ioc.Get<IUnRedoService>()?.RemoveEmptyOperation();
	}

	private bool AddImage(string fileName, string path)
	{
		if (isWindowsPicture)
		{
			if (!AddImageToLinux(fileName, path))
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_ImagePathError"), MessageIcons.Error);
				return false;
			}
		}
		else
		{
			if (!AddImageToServer(fileName))
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_ImagePathError"), MessageIcons.Error);
				return false;
			}
			if (!AddImageToList(fileName))
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_LocalImageNeed"), MessageIcons.Error);
				return false;
			}
		}
		return true;
	}

	private bool AddImageLocal(string fileName)
	{
		try
		{
			if (!AddImageToServer(fileName))
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_ImagePathError"), MessageIcons.Error);
				return false;
			}
			if (!AddImageToList(fileName))
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_LocalImageNeed"), MessageIcons.Error);
				return false;
			}
		}
		catch (Exception ex)
		{
			if (ex is VmException ex2)
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), ErrorCodeInfo.GetErrorInfo(ex2.errorCode), MessageIcons.Error);
			}
			else
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), ex.Message, MessageIcons.Error);
			}
			return false;
		}
		return true;
	}

	private bool AddImageToLinux(string fileName, string strRemoteFile)
	{
		if (!ServerSDKAPI.FtpCreatDir(CVmObjectBase.mhandle, strRemoteFile))
		{
		}
		string path = fileName;
		bool flag = ServerSDKAPI.FtpCheckFileName(CVmObjectBase.mhandle, strRemoteFile + Path.GetFileName(fileName));
		string text = fileName.GetHashCode().ToString();
		if (!flag)
		{
			path = ((!Path.GetDirectoryName(fileName).EndsWith("\\")) ? (Path.GetDirectoryName(fileName) + "\\" + Path.GetFileNameWithoutExtension(fileName) + "_" + text + Path.GetExtension(fileName)) : (Path.GetDirectoryName(fileName) + Path.GetFileNameWithoutExtension(fileName) + "_" + text + Path.GetExtension(fileName)));
		}
		string text2 = "/root/vmtempfiles/ftp";
		string text3 = strRemoteFile + Path.GetFileName(path);
		flag = ServerSDKAPI.FtpUploadFile(ptr, fileName, text3, bCreatDir: true, bCover: true);
		string text4 = text2 + text3;
		if (AddImageToServer(text4) && AddImageToList(text4))
		{
			return true;
		}
		return false;
	}

	private bool AddImageToServer(string fileName)
	{
		if (GetVMModule() != null && ImageList.FirstOrDefault((ImageEntity x) => x.ImagePath == fileName) == null)
		{
			((IUserStringData)GetVMModule().Params)["AddImage"] = fileName;
		}
		return true;
	}

	/// <summary>
	/// 根据图像名称获取列表中的图像实例
	/// </summary>
	/// <param name="ImagePath"></param>
	/// <returns></returns>
	private ImageEntity GetImageEntitybyPath(string ImagePath)
	{
		foreach (ImageEntity image in ImageList)
		{
			if (image.ImagePath == ImagePath)
			{
				return image;
			}
		}
		return null;
	}

	/// <summary>
	/// 添加路径中的所有图像
	/// </summary>
	/// <param name="dir">文件夹路径</param>
	/// <returns></returns>
	private void AddImageByDir(string dir, int folderLayer = 1)
	{
		Ioc.Get<IUnRedoService>()?.Register(new RootOperation
		{
			RootOperType = "ModifyConfig"
		}, AppLocalizationService.GetLang("修改配置") + ": " + GetVMModule().Name);
		byte[] value = new byte[4];
		try
		{
			((IUserBytesData)GetVMModule().Params)["UseModel"] = value;
		}
		catch (Exception)
		{
			return;
		}
		try
		{
			if (!Directory.Exists(dir))
			{
				return;
			}
			string[] array = (from x in Directory.GetFileSystemEntries(dir)
				orderby x.Length, x
				select x).ToArray();
			string[] array2 = array;
			foreach (string text in array2)
			{
				if (File.Exists(text))
				{
					if (GetVMModule()?.ModuleTypeName == "ImageSourceModule")
					{
						if (Path.GetExtension(text).ToUpper() != ".JPG" && Path.GetExtension(text).ToUpper() != ".JPEG" && Path.GetExtension(text).ToUpper() != ".BMP" && Path.GetExtension(text).ToUpper() != ".PNG" && Path.GetExtension(text).ToUpper() != ".TIF" && Path.GetExtension(text).ToUpper() != ".TIFF")
						{
							continue;
						}
					}
					else if (GetVMModule()?.ModuleTypeName == "ImageSource3DModule" && Path.GetExtension(text).ToUpper() != ".RAW")
					{
						continue;
					}
					string path = "/Picture/";
					if (Islocal)
					{
						if (!AddImageLocal(text))
						{
							break;
						}
					}
					else if (!AddImage(text, path))
					{
						break;
					}
				}
				else if (folderLayer <= 1)
				{
					AddImageByDir(text, folderLayer + 1);
				}
			}
		}
		catch (Exception ex2)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_ReadImageFail"), MessageIcons.Error);
			LogHelper.Error("Message:" + ex2.Message + "StackTrace:" + ex2.StackTrace);
		}
	}

	/// <summary>
	/// 添加图像至图像列表
	/// </summary>
	/// <param name="strResult">图像文件路径</param>
	private bool AddImageToList(string strResult)
	{
		if (string.IsNullOrEmpty(strResult))
		{
			return false;
		}
		if (ImageList.FirstOrDefault((ImageEntity x) => x.ImagePath == strResult) == null)
		{
			ImageList.Add(new ImageEntity
			{
				ImagePath = strResult
			});
		}
		return true;
	}

