	/// <summary>
	/// 获取当前文件夹下所有文件（夹）集合字符串信息
	/// </summary>
	/// <param name="fileName"></param>
	/// <returns></returns>
	protected string GetFiles(string fileName)
	{
		int nDataLength = 0;
		byte[] dataByte = new byte[0];
		string empty = string.Empty;
		bool flag = ServerSDKAPI.FtpRemoteList(CVmObjectBase.mhandle, fileName, ref nDataLength, ref dataByte);
		if (!flag && nDataLength > 0)
		{
			dataByte = new byte[nDataLength];
			flag = ServerSDKAPI.FtpRemoteList(CVmObjectBase.mhandle, fileName, ref nDataLength, ref dataByte);
		}
		if (flag)
		{
			return Encoding.UTF8.GetString(dataByte);
		}
		return string.Empty;
	}

	protected void LinuxImageFolder_Click(object sender, RoutedEventArgs e)
	{
		isWindowsPicture = false;
		List<string> list = new List<string>();
		FolderBrowserDialog folderBrowserDialog = new FolderBrowserDialog();
		if (folderBrowserDialog.ShowDialog() != true)
		{
			return;
		}
		Ioc.Get<IUnRedoService>()?.Register(new RootOperation
		{
			RootOperType = "ModifyConfig"
		}, AppLocalizationService.GetLang("修改配置") + ": " + GetVMModule().Name);
		byte[] value = new byte[4];
		try
		{
			((IUserBytesData)GetVMModule().Params)["UseModel"] = value;
		}
		catch (Exception)
		{
			return;
		}
		try
		{
			string text = folderBrowserDialog.FilePath.Trim();
			string text2 = "";
			text2 = ((!(text.Substring(0, 21) == "/root/vmtempfiles/ftp")) ? (text + "//") : (text.Remove(0, 21) + "//"));
			ImvsSdkDefine.FTP_REMOTE_FILE_LIST_INFO ftpFileInfo = default;
			if (ServerSDKAPI.FtpRemoteFileList(CVmObjectBase.mhandle, text2, ref ftpFileInfo))
			{
				for (int i = 0; i < ftpFileInfo.FileNum; i++)
				{
					ImvsSdkDefine.FTP_REMOTE_FILE_INFO fTP_REMOTE_FILE_INFO = (ImvsSdkDefine.FTP_REMOTE_FILE_INFO)Marshal.PtrToStructure(ftpFileInfo.FTPFileInfos + i * Marshal.SizeOf(typeof(ImvsSdkDefine.FTP_REMOTE_FILE_INFO)), typeof(ImvsSdkDefine.FTP_REMOTE_FILE_INFO));
					string text3 = Encoding.UTF8.GetString(fTP_REMOTE_FILE_INFO.FileName).TrimEnd(default(char));
					string text4 = Encoding.UTF8.GetString(fTP_REMOTE_FILE_INFO.FileTime).TrimEnd(default(char));
					string text5 = Encoding.UTF8.GetString(fTP_REMOTE_FILE_INFO.FilePermission).TrimEnd(default(char));
					if (text5.StartsWith("d"))
					{
						string strRemoteDir = text.Remove(0, 21) + "/" + text3 + "//";
						ImvsSdkDefine.FTP_REMOTE_FILE_LIST_INFO ftpFileInfo2 = default;
						if (ServerSDKAPI.FtpRemoteFileList(CVmObjectBase.mhandle, strRemoteDir, ref ftpFileInfo2))
						{
							for (int j = 0; j < ftpFileInfo2.FileNum; j++)
							{
								ImvsSdkDefine.FTP_REMOTE_FILE_INFO fTP_REMOTE_FILE_INFO2 = (ImvsSdkDefine.FTP_REMOTE_FILE_INFO)Marshal.PtrToStructure(ftpFileInfo2.FTPFileInfos + j * Marshal.SizeOf(typeof(ImvsSdkDefine.FTP_REMOTE_FILE_INFO)), typeof(ImvsSdkDefine.FTP_REMOTE_FILE_INFO));
								string text6 = Encoding.UTF8.GetString(fTP_REMOTE_FILE_INFO2.FileName).TrimEnd(default(char));
								string item = text3 + "/" + text6;
								list.Add(item);
							}
						}
						if (IntPtr.Zero != ftpFileInfo2.FTPFileInfos)
						{
							Marshal.FreeHGlobal(ftpFileInfo2.FTPFileInfos);
							ftpFileInfo2.FTPFileInfos = IntPtr.Zero;
						}
					}
					else
					{
						list.Add(text3);
					}
				}
				foreach (string item2 in list)
				{
					string text7 = item2.Split('.').LastOrDefault().ToUpper();
					if (!(text7 != "JPG") || !(text7 != "JPEG") || !(text7 != "BMP") || !(text7 != "PNG") || !(text7 != "TIF") || !(text7 != "TIFF"))
					{
						string fileName = text + "/" + item2;
						if (!AddImage(fileName, ""))
						{
							break;
						}
					}
				}
				UpdateImageListSource();
			}
			if (IntPtr.Zero != ftpFileInfo.FTPFileInfos)
			{
				Marshal.FreeHGlobal(ftpFileInfo.FTPFileInfos);
				ftpFileInfo.FTPFileInfos = IntPtr.Zero;
			}
		}
		catch (Exception ex2)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), AppLocalizationService.GetLang("Lang_ReadImageFail"), MessageIcons.Error);
			LogHelper.Error("Message:" + ex2.Message + "StackTrace:" + ex2.StackTrace);
		}
	}

	/// <summary>
	/// 耗时操作同时处理界面事件
	/// </summary>
	public void DoEvents()
	{
		DispatcherFrame dispatcherFrame = new DispatcherFrame();
		Dispatcher.CurrentDispatcher.BeginInvoke(DispatcherPriority.Background, (DispatcherOperationCallback)((object f) =>
		{
			((DispatcherFrame)f).Continue = false;
			return (object)null;
		}), dispatcherFrame);
		Dispatcher.PushFrame(dispatcherFrame);
	}

	/// <summary>
	/// 判断子控件是否在父控件中可见
	/// </summary>
	/// <param name="child">子控件</param>
	/// <param name="parent">父控件</param>
	/// <returns></returns>
	private bool IsChildVisibleInParent(FrameworkElement child, FrameworkElement parent)
	{
		Rect rect = child.TransformToAncestor(parent)?.TransformBounds(new Rect(new Point(0.0, 0.0), child.RenderSize)) ?? new Rect(new Point(0.0, 0.0), child.RenderSize);
		return new Rect(new Point(0.0, 0.0), parent.RenderSize).IntersectsWith(rect);
	}

	/// <summary>
	/// 界面刷新图像源列表
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	public void InterfaceUpdateImageList(object sender, EventArgs e)
	{
		Dispatcher.Invoke(() =>
		{
			ImageList.Clear();
			if (GetRoot()?.FindBaseNodeByName("AutoPlay") is Apps.XmlParser.ParamTab.Boolean boolean)
			{
				boolean.CurValueA = Convert.ToBoolean(((IUserStringData)GetVMModule().Params)["AutoPlay"]);
			}
		});
		RefreshImageList();
	}

	/// <summary>
	/// 更新当前图像列表的缩略图
	/// </summary>
	private void UpdateImageListSource()
	{
		try
		{
			int num = curScrollOffset;
			int num2 = num + (int)Math.Ceiling(curActualWidth / 76.0);
			if (num2 > ImageList.Count)
			{
				num2 = ImageList.Count;
			}
			LogHelper.Info($"startIndex={num},endIndex={num2},ImageList.Count={ImageList.Count}");
			for (int i = num; i < num2; i++)
			{
				lock (mutexrefreshImageThread)
				{
					if (dataNumForReceiveStore < maxStoreLen)
					{
						forReceiveStore[dataNumForReceiveStore] = i;
						dataNumForReceiveStore++;
					}
				}
			}
			NotifyPropertyChanged("ImageCount");
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message);
		}
	}

	private void LoadThumbnailImage(int index)
	{
		try
		{
			LogHelper.Info($"LoadThumbnailImage:{index}");
			int num = curScrollOffset;
			int num2 = num + (int)Math.Ceiling(curActualWidth / 76.0);
			LogHelper.Info($"index={index},startIndex={num},endIndex={num2},ImageList.Count={ImageList.Count}");
			if (index < num || index >= num2 || index >= ImageList.Count)
			{
				return;
			}
			ImageEntity imageEntity = ImageList[index];
			if (imageEntity == null || imageEntity.ImageSource != null)
			{
				return;
			}
			ImageData imageData = null;
			if (Islocal)
			{
				imageData = ((!(Path.GetExtension(imageEntity.ImagePath)?.ToLower() == ".raw")) ? ImageData.GetImageDataFromFile(imageEntity.ImagePath, 72, 52) : ImageData.GetImageDataFrom3DFile(imageEntity.ImagePath, 72, 52));
				if (imageData != null)
				{
					LogHelper.Info("GetImageDataFromFile successfully");
					imageEntity.ImageSource = imageData;
				}
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message);
		}
	}

	/// <summary>
	/// 图像列表选项改变响应
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void lst_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		CurImageIndexT = CurSelectedIndex + 1;
		if (0 > CurImageIndex || !needSelectionTrigger || GetVMModule() == null)
		{
			return;
		}
		bool flag = GetRoot()?.FindBaseNodeByName("AutoPlay") is Apps.XmlParser.ParamTab.Boolean boolean && boolean.CurValueA;
		if (!(GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList buttonSelecter_ImageList))
		{
			return;
		}
		try
		{
			if (buttonSelecter_ImageList.SelectEnable && !ImageList[CurImageIndex].IsCheck)
			{
				GetModuleSel();
			}
			List<ImageEntity> list = (buttonSelecter_ImageList.SelectEnable ? ImageList.Where((ImageEntity p) => p.IsCheck).ToList() : ImageList.ToList());
			int num = list.IndexOf(ImageList[CurImageIndex]);
			int index = ((num == 0) ? (list.Count - 1) : (num - 1));
			string value = (flag ? list[index].ImagePath : list[num].ImagePath);
			((IUserStringData)GetVMModule().Params)["CurrentImagePath"] = value;
			VmProcedure vmProcedure = (GetVMModule() as VmModule).Root;
			if (vmProcedure != null && !vmProcedure.IsVirtual)
			{
				string workStateInfo = "";
				if (!vmProcedure.RunCheck(ref workStateInfo))
				{
					string strMsg = vmProcedure.Name + ":" + workStateInfo;
					HikMessageBox.Show(strMsg, MessageIcons.Error);
				}
				else
				{
					vmProcedure.Run(null, bIsWait: false);
				}
			}
		}
		catch (VmException ex)
		{
			string errorInfo = ErrorCodeInfo.GetErrorInfo(ex.errorCode);
			HikMessageBox.Show(errorInfo, MessageIcons.Error);
		}
		catch (Exception)
		{
		}
	}

	public void OnPreduceResultCallBackArrived(object sender, EventArgs e)
	{
		if (!(e is ValueEventArgs { Value: var value }) || !(value is ImvsSdkDefine.IMVS_MODULE_WORK_STAUS { nWorkStatus: 0u, nExecuteCount: >0u }))
		{
			return;
		}
		Task.Run(() =>
		{
			if (e is ValueEventArgs)
			{
				DoRefreshLocalImage();
			}
		});
	}

	private void DoRefreshLocalImage()
	{
		try
		{
			if (GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList buttonSelecter_ImageList)
			{
				string curValueA = null;
				object obj = ((GetVMModule() as VmModule)?["CurImagePath.Value"] as Array)?.GetValue(0);
				if (obj is ImvsSdkDefine.IMVS_MODULE_STRING_VALUE_EX)
				{
					curValueA = ((ImvsSdkDefine.IMVS_MODULE_STRING_VALUE_EX)obj).strValue;
				}
				buttonSelecter_ImageList.CurValueA = curValueA;
			}
			if (GetRoot()?.FindBaseNodeByName("RefreshImage") is Apps.XmlParser.ParamTab.Boolean { CustomVisibleA: not false, CurValueA: not false } && needReflashImages)
			{
				RefreshImageList();
			}
			needReflashImages = false;
		}
		catch (Exception ex)
		{
			LogHelper.Error("图像刷新错误DoRefreshLocalImage():" + ex.Message);
		}
	}

	protected void lst_ScrollChanged(object sender, ScrollChangedEventArgs e)
	{
		try
		{
			if (!(sender is ListBox listBox))
			{
				return;
			}
			int num = (int)e.HorizontalOffset;
			double actualWidth = listBox.ActualWidth;
			if (num != curScrollOffset || actualWidth != curActualWidth)
			{
				int num2 = num + (int)Math.Ceiling(actualWidth / 76.0);
				if (num2 > ImageList.Count)
				{
					num2 = ImageList.Count;
				}
				LogHelper.Info($"startIndex={num},endIndex={num2},ImageList.Count={ImageList.Count}");
				for (int i = 0; i < ImageList.Count; i++)
				{
					if (i >= num && i < num2)
					{
						lock (mutexrefreshImageThread)
						{
							if (dataNumForReceiveStore < maxStoreLen)
							{
								forReceiveStore[dataNumForReceiveStore] = i;
								dataNumForReceiveStore++;
							}
						}
					}
					else if (i >= num2 || i < num)
					{
						ImageList[i].ImageSource = null;
					}
				}
				curScrollOffset = (int)e.HorizontalOffset;
				curActualWidth = listBox.ActualWidth;
			}
			if (scrollViewer == null)
			{
				ScrollViewer child = SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.UIHelper.Extern.UIHelper.GetChild<ScrollViewer>(this);
				if (child != null)
				{
					scrollViewer = child;
				}
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message);
		}
	}

	private void JudgeDrage(DragEventArgs e)
	{
		Array array = (Array)(e.Data?.GetData(DataFormats.FileDrop));
		if (array == null)
		{
			return;
		}
		foreach (object item in array)
		{
			string path = item.ToString();
			string text = Path.GetExtension(path).ToLower();
			if (!File.Exists(path) || (text != ".bmp" && text != ".jpeg" && text != ".jpg" && text != ".png" && text != ".tif" && text != ".tiff"))
			{
				e.Effects = DragDropEffects.None;
				e.Handled = true;
				break;
			}
		}
	}

	protected void lst_DragEnter(object sender, DragEventArgs e)
	{
		JudgeDrage(e);
	}

	protected void lst_DragOver(object sender, DragEventArgs e)
	{
		JudgeDrage(e);
	}

	protected void lst_Drop(object sender, DragEventArgs e)
	{
		Array array = (Array)(e.Data?.GetData(DataFormats.FileDrop));
		if (array == null)
		{
			return;
		}
		List<string> list = new List<string>();
		foreach (object item in array)
		{
			list.Add(item.ToString());
		}
		DoAddImages(list.ToArray());
	}

	protected void ImagePanel_DataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
	{
		ImageListPanelBase imageListPanelBase = sender as ImageListPanelBase;
		ButtonSelecter_ImageList buttonSelecter_ImageList = e.OldValue as ButtonSelecter_ImageList;
		ButtonSelecter_ImageList buttonSelecter_ImageList2 = e.NewValue as ButtonSelecter_ImageList;
		IVmModule vmModule = (buttonSelecter_ImageList?.GetTopBaseNode() as AlgorithmTabRoot)?.Owner as IVmModule;
		IVmModule vmModule2 = (buttonSelecter_ImageList2?.GetTopBaseNode() as AlgorithmTabRoot)?.Owner as IVmModule;
		if (imageListPanelBase == null)
		{
			return;
		}
		if (vmModule != null)
		{
			vmModule.SubscribeCount--;
			if (vmModule.Root != null)
			{
				WeakEventManager<IVmProcedure, EventArgs>.RemoveHandler(vmModule.Root as IVmProcedure, "OnWorkEndStatusCallBack", OnPreduceResultCallBackArrived);
			}
			WeakEventManager<IImageSourceNode, EventArgs>.RemoveHandler(vmModule2 as IImageSourceNode, "ModelChanged", InterfaceUpdateImageList);
			ChangeShadowDataSource(null);
			if (IsSubscribeFolderMode is NameValueItem nameValueItem)
			{
				nameValueItem.OnCurValueChanged -= OnSubscribeFolderModeChanged;
			}
			_IsSubscribeFolderMode = null;
			OwnerModule = null;
			root = null;
		}
		ImageList.Clear();
		if (vmModule2 != null)
		{
			vmModule2.SubscribeCount++;
			root = buttonSelecter_ImageList2.GetTopBaseNode() as AlgorithmTabRoot;
			if (vmModule2.Root != null)
			{
				WeakEventManager<IVmProcedure, EventArgs>.AddHandler(vmModule2.Root as IVmProcedure, "OnWorkEndStatusCallBack", OnPreduceResultCallBackArrived);
			}
			WeakEventManager<IImageSourceNode, EventArgs>.AddHandler(vmModule2 as IImageSourceNode, "ModelChanged", InterfaceUpdateImageList);
			IVmModuleSet vmModuleSet = vmModule2.Root;
			if (vmModuleSet != null)
			{
				ChangeShadowDataSource(vmModuleSet);
			}
		}
		RefreshImageList();
		NotifyPropertyChanged("IsSubscribeFolderMode");
	}

	protected virtual void ChangeShadowDataSource(object source)
	{
	}

	protected void CheckBox_Click(object sender, RoutedEventArgs e)
	{
		if (sender is CheckBox { Tag: ImageEntity tag } && needSetSelectImage)
		{
			ChangedExecutePic(tag);
		}
	}

	protected void Grid_MouseDown(object sender, MouseButtonEventArgs e)
	{
		if (!IsSelectMode || !(sender is Grid { DataContext: ImageEntity dataContext }) || e.ChangedButton != MouseButton.Left)
		{
			return;
		}
		if (Keyboard.IsKeyDown(Key.LeftCtrl) || Keyboard.IsKeyDown(Key.RightCtrl))
		{
			dataContext.IsCheck = !dataContext.IsCheck;
			ChangedExecutePic(dataContext);
			e.Handled = true;
		}
		else
		{
			if (CurImageIndex < 0 || (!Keyboard.IsKeyDown(Key.LeftShift) && !Keyboard.IsKeyDown(Key.RightShift)))
			{
				return;
			}
			int val = ImageList.IndexOf(dataContext);
			int num = Math.Min(CurImageIndex, val);
			int num2 = Math.Max(CurImageIndex, val);
			if (num2 <= num)
			{
				return;
			}
			for (int i = 0; i < ImageList.Count; i++)
			{
				if (i < num || i > num2)
				{
					if (ImageList[i].IsCheck)
					{
						ImageList[i].IsCheck = false;
						ChangedExecutePic(ImageList[i]);
					}
				}
				else if (!ImageList[i].IsCheck)
				{
					ImageList[i].IsCheck = true;
					ChangedExecutePic(ImageList[i]);
				}
			}
			e.Handled = true;
		}
	}

	/// <summary>
	/// 重新下发待执行图像列表
	/// </summary>
	/// <param name="image"></param>
	private void ChangedExecutePic(ImageEntity image)
	{
		try
		{
			if (image.IsCheck)
			{
				((IUserStringData)GetVMModule().Params)["SelectExecutePic"] = image.ImagePath;
			}
			else
			{
				((IUserStringData)GetVMModule().Params)["CancelExecutePic"] = image.ImagePath;
			}
			OnExcuteTypeParamChanged();
		}
		catch (Exception ex)
		{
			string text = ex.Message;
			if (ex is VmException ex2)
			{
				text = ErrorCodeInfo.GetErrorInfo(ex2.errorCode);
			}
			HikMessageBox.Show(text, MessageIcons.Error);
			LogHelper.Error(text);
		}
	}

	/// <summary>
	/// 获取当前是否选中模式，若是则获取选中项
	/// </summary>
	public void GetModuleSelectMode()
	{
		needSetSelectImage = false;
		try
		{
			if (!(DataContext is ButtonSelecter_ImageList { SelectEnable: not false }))
			{
				return;
			}
			string[] array = ((IUserStringData)GetVMModule().Params)["GetAllExecutePic"]?.Split('|');
			if (array == null || array.Length == 0)
			{
				return;
			}
			foreach (ImageEntity image in ImageList)
			{
				if (array.Contains(image.ImagePath))
				{
					image.IsCheck = true;
				}
				else
				{
					image.IsCheck = false;
				}
			}
		}
		catch (Exception ex)
		{
			string text = ex.Message;
			if (ex is VmException ex2)
			{
				text = ErrorCodeInfo.GetErrorInfo(ex2.errorCode);
			}
			LogHelper.Error("刷新选中模式失败：" + text);
		}
		finally
		{
			needSetSelectImage = true;
		}
	}

	protected void FirstImage_Click(object sender, RoutedEventArgs e)
	{
		if (ImageList.Count == 0)
		{
			return;
		}
		if (IsSelectMode)
		{
			List<ImageEntity> list = ImageList.Where((ImageEntity p) => p.IsCheck).ToList();
			if (list.Count == 0)
			{
				return;
			}
			if (GetRoot()?.FindBaseNodeByName("AutoPlay") is Apps.XmlParser.ParamTab.Boolean boolean)
			{
				if (!boolean.CurValue)
				{
					((IUserStringData)GetVMModule().Params)["CurrentImagePath"] = list[0].ImagePath;
					if (GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList buttonSelecter_ImageList)
					{
						buttonSelecter_ImageList.CurValueA = list[0].ImagePath;
					}
				}
				else if (boolean.CurValue)
				{
					((IUserStringData)GetVMModule().Params)["CurrentImagePath"] = list[list.Count - 1].ImagePath;
					if (GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList buttonSelecter_ImageList2)
					{
						buttonSelecter_ImageList2.CurValueA = list[list.Count - 1].ImagePath;
					}
				}
			}
		}
		else if (GetRoot()?.FindBaseNodeByName("AutoPlay") is Apps.XmlParser.ParamTab.Boolean boolean2)
		{
			if (!boolean2.CurValue)
			{
				((IUserStringData)GetVMModule().Params)["CurrentImagePath"] = ImageList[0].ImagePath;
				if (GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList buttonSelecter_ImageList3)
				{
					buttonSelecter_ImageList3.CurValueA = ImageList[0].ImagePath;
				}
			}
			else if (boolean2.CurValue)
			{
				((IUserStringData)GetVMModule().Params)["CurrentImagePath"] = ImageList[ImageCount - 1].ImagePath;
				if (GetRoot()?.FindBaseNodeByName("CurrentImagePath") is ButtonSelecter_ImageList buttonSelecter_ImageList4)
				{
					buttonSelecter_ImageList4.CurValueA = ImageList[ImageCount - 1].ImagePath;
				}
			}
		}
		IsReturnFirstForce = true;
		Dispatcher.BeginInvoke(DispatcherPriority.Normal, (Action)(() =>
		{
			scrollViewer?.ScrollToLeftEnd();
		}));
	}

	protected void MenuItem_Click(object sender, RoutedEventArgs e)
	{
		string imagePath = ImageList[CurImageIndex].ImagePath;
		if (Directory.Exists(imagePath))
		{
			Process.Start("Explorer.exe", "/select," + imagePath);
			return;
		}
		IntPtr intPtr = ILCreateFromPathW(imagePath);
		if (!(intPtr != IntPtr.Zero))
		{
			return;
		}
		try
		{
			Marshal.ThrowExceptionForHR(SHOpenFolderAndSelectItems(intPtr, 0u, IntPtr.Zero, 0u));
		}
		finally
		{
			ILFree(intPtr);
		}
	}

	/// <summary>
	/// 3D新增，导入RP文件夹
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	protected void BtnImageAddRpFolder_Click(object sender, RoutedEventArgs e)
	{
		//IL_0001: Unknown result type (might be due to invalid IL or missing references)
		//IL_0007: Expected Obj, but got Unknown
		//IL_0018: Unknown result type (might be due to invalid IL or missing references)
		//IL_001d: Unknown result type (might be due to invalid IL or missing references)
		//IL_001f: Unknown result type (might be due to invalid IL or missing references)
		//IL_0021: Invalid comparison between Unknown and I4
		CommonOpenFileDialog val = new CommonOpenFileDialog();
		val.IsFolderPicker = true;
		val.Multiselect = false;
		CommonFileDialogResult val2 = ((CommonFileDialog)val).ShowDialog();
		try
		{
			if ((int)val2 == 2)
			{
				return;
			}
			string value = ((CommonFileDialog)val).FileName.Trim();
			try
			{
				((IUserStringData)GetVMModule().Params)["AddRpDir"] = value;
				string text = ((IUserStringData)GetVMModule().Params)["RpRawDir"];
				if (Directory.Exists(text))
				{
					AddImageByDir(text);
					UpdateImageListSource();
				}
			}
			catch (VmException ex)
			{
				string text2 = AppLocalizationService.GetLang("errCode:") + $"{ex.errorCode:X}" + "\r\n";
				text2 = text2 + AppLocalizationService.GetLang("errInfo:") + ErrorCodeInfo.GetErrorInfo(ex.errorCode);
				HikMessageBox.Show(AppLocalizationService.GetLang("Lang_ImageAdd"), text2, MessageIcons.Error);
			}
		}
		catch
		{
		}
		finally
		{
			((CommonFileDialog)val).Dispose();
		}
	}
}
