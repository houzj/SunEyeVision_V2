<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.LocalImageListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:localcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.ListView" xmlns:localParamTab="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="UserControl" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/ParamTabControl/ParamTabUI/FrequentlyStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="Boolean_sub">
        <localcontrol:BooleanControl Margin="5,4,0,0" IsChecked="{Binding CurValueA, Mode=TwoWay}">
          <localcontrol:BooleanControl.OffContent>
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_off_dark.png" />
          </localcontrol:BooleanControl.OffContent>
          <localcontrol:BooleanControl.OnContent>
            <Image Stretch="None" Source="/Apps.XmlUI;component/Resources/swith_on_dark.png" />
          </localcontrol:BooleanControl.OnContent>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="OnCheckedChange">
              <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </localcontrol:BooleanControl>
      </DataTemplate>
      <DataTemplate x:Key="Boolean">
        <StackPanel Height="40" Width="auto" HorizontalAlignment="Right" Orientation="Horizontal" Margin="{Binding MarginA}">
          <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Col_DisplayImage_ImageSource_Foreground}" Margin="5,1,-5,0" Text="{vm_port_0_:ResourceBinding DisplayNameA}" ToolTip="{vm_port_0_:ResourceBinding DescriptionA}" />
          <ContentControl Margin="20,0,0,0" ContentTemplate="{StaticResource Boolean_sub}" Content="{Binding}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Name="MainGrid">
        <StackPanel Margin="0,0,0,0" Background="{DynamicResource Col_DisplayImage_ImageSource_Background}">
          <Grid Height="40">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource Boolean}" HorizontalAlignment="Right" Content="{Binding AutoPlay, ElementName=UserControl}" Visibility="{Binding IsExpanded, ElementName=UserControl, Converter={StaticResource bool2VisibilityConverter}}" />
            <ComboBox Name="cbx" Grid.Column="1" Width="90" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="20,5" SelectedIndex="0" ItemsSource="{Binding ImageModes, ElementName=UserControl}" SelectedValue="{Binding IsSelectMode, ElementName=UserControl}" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource self}}" SelectionChanged="cbxMode_SelectionChanged">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource ListViewComboBoxGrayStyle}" TargetType="{x:Type ComboBox}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Value="True" Binding="{Binding IsExpanded, ElementName=UserControl}" />
                        <Condition Value="False" Binding="{Binding IsSubscribeFolderMode.CurValueA, ElementName=list}" />
                      </MultiDataTrigger.Conditions>
                      <MultiDataTrigger.Setters>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ComboBox>
            <Border Grid.Column="2">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Width" Value="0" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Value="True" Binding="{Binding IsImageSourceModule, ElementName=list}" />
                        <Condition Value="False" Binding="{Binding IsSubscribeFolderMode.CurValueA, ElementName=list}" />
                      </MultiDataTrigger.Conditions>
                      <MultiDataTrigger.Setters>
                        <Setter Property="Width" Value="130" />
                      </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Border>
            <ToggleButton Grid.Column="3" Style="{StaticResource DisplayHideBtnStyle}" IsChecked="{Binding IsExpanded, ElementName=UserControl}" />
          </Grid>
          <local:ImageListPanel x:Name="list" Margin="5,-40,5,5" CurSelectedModule="{Binding DataContext.DecorateSource, ElementName=UserControl}" TargetValue="{Binding CurValueA, Mode=TwoWay}" IsSelectMode="{Binding IsSelectMode, Mode=TwoWay, ElementName=UserControl}" DataContext="{Binding CurrentImagePath, ElementName=UserControl}" IsExpanded="{Binding IsExpanded, ElementName=UserControl}" DoFreshImageList="{Binding FreshImageListFlag}" />
        </StackPanel>
      </Grid>
    </ControlTemplate>
  </Control.Template>
  <FrameworkElement.Style>
    <Style TargetType="{x:Type Control}">
      <Setter Property="Height" Value="125" />
      <Style.Triggers>
        <DataTrigger Value="False" Binding="{Binding IsExpanded, ElementName=UserControl}">
          <Setter Property="Height" Value="40" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
</Control>