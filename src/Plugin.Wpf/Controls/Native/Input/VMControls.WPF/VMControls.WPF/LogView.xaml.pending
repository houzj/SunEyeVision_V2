<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.LogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="myLogView" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <x:StaticExtension Member="vm_port_0:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <local:TimeConvertor x:Key="timeConvertor" />
      <local:LogManageTypeImageConvert x:Key="logTypeImageConvert" />
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Visibility" Value="Collapsed" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Style.Triggers>
          <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource Col_LogBar_View_BorderBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="contentCenterStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="contentLeftStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <DataTemplate x:Key="contentImageStyle">
        <Image Source="{Binding LogType, Converter={StaticResource logTypeImageConvert}}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Border CornerRadius="2" Opacity="1" BorderThickness="1" BorderBrush="{DynamicResource Col_LogBar_BorderBrush}" Background="{DynamicResource Col_LogBar_Popup_Background}">
        <ScrollViewer Name="scrollViewer" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Focusable="False" SnapsToDevicePixels="True" CanContentScroll="True" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
          <Grid Background="#00FFFFFF" Margin="0,0,15,15">
            <DataGrid Name="logshow" BorderThickness="0" GridLinesVisibility="None" AlternatingRowBackground="#00FFFFFF" IsReadOnly="True" SelectionUnit="FullRow" CanUserAddRows="False" CanUserSortColumns="True" CanUserResizeRows="False" CanUserResizeColumns="False" RowHeight="20" RowHeaderWidth="0" AutoGenerateColumns="False" FontSize="12" RowBackground="#00FFFFFF" Foreground="{DynamicResource Col_LogBar_Popup_Foreground}" Background="#00FFFFFF" FontFamily="Microsoft YaHei" ItemsSource="{Binding LogSource, ElementName=myLogView}" SizeChanged="Logshow_SizeChanged">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="30" Header="{DynamicResource 类别}" x:Name="DataGridType" CellTemplate="{StaticResource contentImageStyle}" />
                <DataGridTextColumn Width="75" Header="{DynamicResource Lang_Time}" ElementStyle="{StaticResource contentCenterStyle}" Binding="{Binding LogInfoTime, Converter={StaticResource timeConvertor}}" />
                <DataGridTextColumn Width="Auto" Header="{DynamicResource 事件}" ElementStyle="{StaticResource contentLeftStyle}" Binding="{Binding Path=LogEvent}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </ScrollViewer>
      </Border>
    </ControlTemplate>
  </Control.Template>
</Control>