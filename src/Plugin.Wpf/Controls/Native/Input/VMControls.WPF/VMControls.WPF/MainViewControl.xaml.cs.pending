public partial class MainViewControl : Control, INotifyPropertyChanged, IDisposable, IComponentConnector, IStyleConnector
{
	public static readonly DependencyProperty SolutionProperty = DependencyProperty.Register("Solution", typeof(IVmSolution), typeof(MainViewControl), new PropertyMetadata(null, OnSolutionChanged));

	public static readonly DependencyProperty SelectedModuleProperty = DependencyProperty.Register("SelectedModule", typeof(IVmModule), typeof(MainViewControl), new PropertyMetadata(null, OnSelectedModuleChanged));

	public static readonly DependencyProperty IsLoadingFlagProperty = DependencyProperty.Register("IsLoadingFlag", typeof(bool), typeof(MainViewControl), new PropertyMetadata(false, null));

	public static readonly DependencyProperty IsShowProgressMaskProperty = DependencyProperty.Register("IsShowProgressMask", typeof(bool), typeof(MainViewControl), new PropertyMetadata(false, OnIsShowProgressMaskChanged));

	public static readonly DependencyProperty ProgressProperty = DependencyProperty.Register("Progress", typeof(double), typeof(MainViewControl), new PropertyMetadata(0.0));

	public static readonly DependencyProperty MaskMessageProperty = DependencyProperty.Register("MaskMessage", typeof(string), typeof(MainViewControl), new PropertyMetadata(null));

	private ProgressMask progressMask;

	public static readonly DependencyProperty ZoomIndexProperty = DependencyProperty.Register("ZoomIndex", typeof(double), typeof(MainViewControl), new PropertyMetadata(1.0));

	public static readonly DependencyProperty IsLockWorkAreaProperty = DependencyProperty.Register("IsLockWorkArea", typeof(bool), typeof(MainViewControl), new PropertyMetadata(false));

	public static readonly DependencyProperty IsOpenParamsProperty = DependencyProperty.Register("IsOpenParams", typeof(bool), typeof(MainViewControl), new PropertyMetadata(false));

	/// <summary>
	/// 参数列表编辑状态属性
	/// </summary>
	public static readonly DependencyProperty IsParamsEditStateProperty = DependencyProperty.Register("IsParamsEditState", typeof(bool), typeof(MainViewControl), new PropertyMetadata(true));

	private Grid View;

	private Grid workarea;

	private ColumnDefinition columnDefinition1;

	private ColumnDefinition columnDefinition2;

	private ColumnDefinition columnDefinition3;

	private ModuleResultView mrv;

	private ProcedureConfigControl proConfig;

	private Grid moduleViewHost;

	private Grid workareaConfig;

	private static string logType = "";

	private string currentLogTime = string.Empty;

	private string currentLogContent = string.Empty;

	private string currentLogType = string.Empty;

	private bool _isLogFold = true;

	/// <summary>
	/// 打开日志浮窗命令
	/// </summary>
	private DelegateCommand<object> logCommand = null;

	private DelegateCommand<object> logTypeCommand = null;

	public object ROIPartUI => mrv;

	public object WorkAreaGrid => workarea;

	public object ModuleViewHost => moduleViewHost;

	public object ProcedureConfigUI => proConfig;

	public IVmSolution Solution
	{
