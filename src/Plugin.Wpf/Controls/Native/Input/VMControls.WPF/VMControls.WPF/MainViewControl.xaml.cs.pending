	public ICommand LogCommand => (ICommand)(logCommand ?? (logCommand = new DelegateCommand<object>((Action<object>)LogCommandExecute)));

	public ICommand LogTypeCommand => (ICommand)(logTypeCommand ?? (logTypeCommand = new DelegateCommand<object>((Action<object>)LogTypeCommandExecute)));

	public event ToolItemGrid.GetToolItemBackgroudData SelectionChanged;

	public event PropertyChangedEventHandler PropertyChanged;

	public virtual void OnPropertyChanged(string name)
	{
		PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
	}

	private static void OnSolutionChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		MainViewControl mainViewControl = (MainViewControl)d;
		IVmSolution vmSolution = (IVmSolution)e.OldValue;
		IVmSolution vmSolution2 = (IVmSolution)e.NewValue;
	}

	private static void OnSelectedModuleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		MainViewControl mainViewControl = (MainViewControl)d;
		mainViewControl.SelectionChanged?.Invoke(mainViewControl, new ObjectEventArgs
		{
			Param = e.NewValue
		});
	}

	private static void OnIsShowProgressMaskChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		MainViewControl mainViewControl = (MainViewControl)d;
		if ((bool)e.NewValue)
		{
			mainViewControl.AddMask();
		}
		else
		{
			mainViewControl.RemoveMask();
		}
	}

	private void RemoveMask()
	{
		View?.Children?.Remove(progressMask);
		progressMask = null;
	}

	private void AddMask()
	{
		progressMask = new ProgressMask();
		progressMask.SetBinding(ProgressMask.MessageProperty, new Binding("MaskMessage")
		{
			Source = this
		});
		progressMask.SetBinding(ProgressMask.ValueProperty, new Binding("Progress")
		{
			Source = this
		});
		progressMask.SetValue(Grid.ColumnSpanProperty, 2);
		View?.Children?.Add(progressMask);
	}

	public MainViewControl()
	{
		InitializeComponent();
		if (!this.IsInDesignMode())
		{
			DataContext = ViewData;
			CurrentUIHelper.Instance.Dispatcher.Invoke(() =>
			{
			});
		}
		Loaded += MainViewControl_Loaded;
		Unloaded += MainViewControl_Unloaded;
	}

	private void MainViewControl_Loaded(object sender, RoutedEventArgs e)
	{
		UILogManager.logInfoShow.CollectionChanged -= LogInfoShow_CollectionChanged;
		UILogManager.logInfoShow.CollectionChanged += LogInfoShow_CollectionChanged;
	}

	private void MainViewControl_Unloaded(object sender, RoutedEventArgs e)
	{
		UILogManager.logInfoShow.CollectionChanged -= LogInfoShow_CollectionChanged;
	}

	private void LogInfoShow_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		if (e.Action == NotifyCollectionChangedAction.Add && e.NewItems[0] is LogContect logContect)
		{
			CurrentLogContent = logContect.LogEvent;
			CurrentLogTime = logContect.LogInfoTime;
			CurrentLogType = logContect.LogType;
		}
		OnPropertyChanged("LogData");
	}

	public override void OnApplyTemplate()
	{
		base.OnApplyTemplate();
		View = GetTemplateChild("PART_View") as Grid;
		workarea = GetTemplateChild("workarea") as Grid;
		mrv = GetTemplateChild("m_ModuleView") as ModuleResultView;
		proConfig = GetTemplateChild("m_ProcedureConfig") as ProcedureConfigControl;
		moduleViewHost = GetTemplateChild("ModuleViewHost") as Grid;
		columnDefinition1 = GetTemplateChild("columnDefinition1") as ColumnDefinition;
		columnDefinition2 = GetTemplateChild("columnDefinition2") as ColumnDefinition;
		columnDefinition3 = GetTemplateChild("columnDefinition3") as ColumnDefinition;
		workareaConfig = GetTemplateChild("workareaConfig") as Grid;
		if (AppDataFactory.Instance().IsRightLayout && columnDefinition1 != null)
		{
			columnDefinition1.MinWidth = 400.0;
			Grid.SetColumn(workareaConfig, 2);
			Grid.SetColumn(moduleViewHost, 0);
		}
	}

	private void GridSplitter_DragStarted(object sender, DragStartedEventArgs e)
	{
		if (columnDefinition1 != null && columnDefinition3 != null)
		{
			if (AppDataFactory.Instance().IsRightLayout)
			{
				columnDefinition1.MaxWidth = workarea.ActualWidth - 65.0;
			}
			else
			{
				columnDefinition3.MaxWidth = workarea.ActualWidth - 65.0;
			}
		}
	}

	public void Dispose()
	{
		if (mrv != null)
		{
			mrv.ModuleSource = null;
		}
	}

	private void LogCommandExecute(object param)
	{
		if (param is bool flag)
		{
			IsLogFold = !flag;
			if (logType != "")
			{
				logType = "";
				OnPropertyChanged("LogData");
			}
		}
	}

	private void LogTypeCommandExecute(object param)
	{
		if (param as string == "1")
		{
			logType = "";
		}
		else if (param as string == "2")
		{
			logType = "警告";
		}
		else if (param as string == "3")
		{
			logType = "错误";
		}
		else if (param as string == "4")
		{
			logType = "信息";
		}
		OnPropertyChanged("LogData");
	}
}
