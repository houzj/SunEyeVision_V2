	public object LogData
	{
		get
		{
			if (logType != "")
			{
				return from p in UILogManager.logInfoShow.ToObservableCollection()
					where p.LogType == logType
					select p;
			}
			return UILogManager.logInfoShow.ToObservableCollection();
		}
	}

	public string VersionInfo => AppDataFactory.Instance().VersionInfo;

	public bool IsSdkMode => CVmObjectBase.GetIsSDKMode();

	public string CurrentLogTime
	{
		get
		{
			return currentLogTime;
		}
		set
		{
			if (currentLogTime != value)
			{
				currentLogTime = value;
				OnPropertyChanged("CurrentLogTime");
			}
		}
	}

	public string CurrentLogContent
	{
		get
		{
			return currentLogContent;
		}
		set
		{
			if (currentLogContent != value)
			{
				currentLogContent = value;
				OnPropertyChanged("CurrentLogContent");
			}
		}
	}

