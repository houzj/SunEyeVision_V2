	private void m_btnFullScreen_Click(object sender, RoutedEventArgs e)
	{
		FullScreen instance = FullScreen.Instance;
		instance.DataContext = viewbox.DataContext;
		viewbox.Children.Remove(imageView);
		imageUnion.Children.Remove(btnLeft);
		imageUnion.Children.Remove(btnRight);
		instance.SetChild(imageView);
		instance.SetChild(btnLeft);
		instance.SetChild(btnRight);
		instance.ShowDialog();
		instance.RemoveChild();
		instance.DataContext = null;
		viewbox.Children.Add(imageView);
		imageUnion.Children.Add(btnLeft);
		imageUnion.Children.Add(btnRight);
	}

	private void btnLeft_Click(object sender, RoutedEventArgs e)
	{
		if (m_CurrentInfo == null || ModuleSource == null || !(ownerProcedure is VmProcedure vmProcedure))
		{
			return;
		}
		string workStateInfo = "";
		if (!vmProcedure.RunCheck(ref workStateInfo))
		{
			string strMsg = vmProcedure.Name + ":" + workStateInfo;
			HikMessageBox.Show(strMsg, MessageIcons.Error);
			return;
		}
		if (vmProcedure.IsRunning)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_PlzLoopStop"), MessageIcons.Error);
			return;
		}
		List<VmModule> list = new List<VmModule>();
		vmProcedure.GetAllModuleByType(list, "ImageSourceModule", isCurrentLevel: true);
		foreach (VmModule item in list)
		{
			try
			{
				((IUserStringData)item.Params)["LastImage"] = "";
			}
			catch (Exception)
			{
			}
		}
		try
		{
			vmProcedure.Run(null, bIsWait: false);
		}
		catch (VmException ex2)
		{
			string strMsg2 = vmProcedure.FullName + ":" + ErrorCodeInfo.GetErrorInfo(ex2.errorCode);
			HikMessageBox.Show(strMsg2, MessageIcons.Error);
		}
	}

