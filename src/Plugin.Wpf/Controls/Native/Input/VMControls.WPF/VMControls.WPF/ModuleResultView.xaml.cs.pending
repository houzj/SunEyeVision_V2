	private void Menu_Clear_Click(object sender, RoutedEventArgs e)
	{
		try
		{
			if (m_CurrentInfo?.ModuleDisplayInfoList != null && ModuleSource != null)
			{
				m_CurrentInfo.ModuleDisplayInfoList.Clear();
				ServerSDKManager.serverSDKManager.mModuleManager.ClearModuleHistoryResult(ModuleSource.ID);
			}
		}
		catch (Exception ex)
		{
			string strMsg = ex.Message;
			if (ex is VmException ex2)
			{
				strMsg = ErrorCodeInfo.GetErrorInfo(ex2.errorCode) + "," + AppLocalizationService.GetLang("errCode:") + ex2.errorCode;
			}
			HikMessageBox.Show(strMsg, MessageIcons.Error);
		}
	}

	/// <summary>  
	/// 保存数据data到文件处理过程，返回值为保存的文件名  
	/// </summary>  
	public string SaveProcess(string data, string name)
	{
		StreamWriter streamWriter = null;
		try
		{
			streamWriter = new StreamWriter(name, append: false);
			streamWriter.Write(data);
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageIcons.Error);
		}
		finally
		{
			streamWriter?.Close();
			streamWriter?.Dispose();
		}
		return name;
	}

	private void Menu_Save_Click(object sender, RoutedEventArgs e)
	{
		if (!(m_DataGrid.ItemsSource is IList list))
		{
			return;
		}
		if (list.Count < 1)
		{
			HikMessageBox.Show(System.Windows.Application.Current?.MainWindow, AppLocalizationService.GetLang("Savefailed"), AppLocalizationService.GetLang("CountingErrors"), MessageIcons.Warning);
			return;
		}
		System.Windows.Forms.SaveFileDialog saveFileDialog = new System.Windows.Forms.SaveFileDialog();
		saveFileDialog.Filter = "(*.txt)|*.txt|(*.TXT)|*.TXT";
		saveFileDialog.FileName = ((ModuleSource as VmModule).Name + "_" + DateTime.Now.ToString("yyyy-MM-dd_hh-mm-ss")) ?? "";
		saveFileDialog.AddExtension = true;
		saveFileDialog.RestoreDirectory = true;
		System.Windows.Forms.SaveFileDialog saveFileDialog2 = saveFileDialog;
		try
		{
			if (saveFileDialog2.ShowDialog() != System.Windows.Forms.DialogResult.OK)
			{
				return;
			}
			string fileName = saveFileDialog2.FileName;
			StringBuilder stringBuilder = new StringBuilder();
			foreach (object item in list)
			{
				if (item is LogInfo logInfo)
				{
					stringBuilder.Append($"{logInfo.RowIndex}  {logInfo.AddTime}  {logInfo.Content}\r\n");
				}
			}
			SaveProcess(stringBuilder.ToString(), fileName);
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Savefailed"), ex.Message, MessageIcons.Error);
		}
		finally
		{
			saveFileDialog2.Dispose();
		}
	}

	private void imageListCombobox_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		ResultViewAddition?.SelectionChangedOut();
		System.Windows.Controls.ComboBox comboBox = sender as System.Windows.Controls.ComboBox;
		if (comboBox.SelectedValue == null)
		{
			imageView.ClearExternShapes();
			m_CurrentInfo.ShapeList.Clear();
			ResultViewAddition?.UpdateShapesWithCallBackData();
			imageView.Init();
			UpdateImageView(null);
			return;
		}
		if (m_CurrentInfo?.ModuleParams != null && comboBox.SelectedValue is Apps.XmlParser.Object obj)
		{
			if (!(obj.TypeA == "image") && !(obj.TypeA == "pixelinfoimage"))
			{
				IMoudleResultAddition resultViewAddition = ResultViewAddition;
				if (resultViewAddition == null || resultViewAddition.ActiveUpdateShapes(obj.TypeA))
				{
					goto IL_03bc;
				}
			}
			if (m_CurrentInfo.ImageViewList.Count((ImageViewItem p) => p.IsBackgroundImage) == 0)
			{
				ImageViewItem imageViewItem = m_CurrentInfo.ImageViewList.FirstOrDefault((ImageViewItem p) => p.IsCheck);
				if (imageViewItem != null)
				{
					imageViewItem.IsCheck = false;
					imageViewItem.IsEnable = true;
				}
				if (comboBox.SelectedItem is ImageViewItem imageViewItem2)
				{
					imageViewItem2.IsCheck = true;
					imageViewItem2.IsEnable = false;
				}
			}
			else if (comboBox.SelectedItem is ImageViewItem imageViewItem3)
			{
				if (imageViewItem3.IsBackgroundImage)
				{
					foreach (Image layer in checkImageList)
					{
						layer.Visibility = Visibility.Visible;
						ImageViewItem imageViewItem4 = m_CurrentInfo?.ImageViewList?.FirstOrDefault((ImageViewItem p) => p.DisplayName == layer.Uid);
						if (imageViewItem4 != null && !imageViewItem4.IsCallBackEnable && imageViewItem4.DisplayObject is Apps.XmlParser.Object obj2)
						{
							obj2.SetOutputFilter();
							WeakEventManager<Apps.XmlParser.Object, EventArgs>.RemoveHandler(obj2, "ValueChanged", P_ValueChanged);
							WeakEventManager<Apps.XmlParser.Object, EventArgs>.AddHandler(obj2, "ValueChanged", P_ValueChanged);
							imageViewItem4.IsCallBackEnable = true;
						}
					}
				}
				else
				{
					foreach (Image layer2 in checkImageList)
					{
						layer2.Visibility = Visibility.Collapsed;
						ImageViewItem imageViewItem5 = m_CurrentInfo?.ImageViewList?.FirstOrDefault((ImageViewItem p) => p.DisplayName == layer2.Uid);
						if (imageViewItem5 != null && imageViewItem5.IsCallBackEnable && imageViewItem5 != imageViewItem3 && imageViewItem5.DisplayObject is Apps.XmlParser.Object obj3)
						{
							obj3.RemoveOutputFilter();
							WeakEventManager<Apps.XmlParser.Object, EventArgs>.RemoveHandler(obj3, "ValueChanged", P_ValueChanged);
							imageViewItem5.IsCallBackEnable = false;
						}
					}
				}
			}
			m_CurrentInfo.RecordCheckedImages();
			UpdateModuleViewResultShow();
		}
		goto IL_03bc;
		IL_03bc:
		SetRoiVisible();
		ImageChangedEvent?.Invoke(m_CurrentInfo.SelectedImage.DisplayValue);
	}

	private void imageListComboboxIn_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		System.Windows.Controls.ComboBox comboBox = sender as System.Windows.Controls.ComboBox;
		if (!IsShowDoubleImage || comboBox.SelectedValue == null)
		{
			imageViewIn.ClearExternShapes();
			imageViewIn.Init();
			if (m_CurrentInfo != null)
			{
				m_CurrentInfo.ImageDataSourceIn = null;
			}
		}
		else
		{
			if (m_CurrentInfo?.ModuleParams != null && comboBox.SelectedValue is Apps.XmlParser.Object obj && (obj.TypeA == "image" || obj.TypeA == "pixelinfoimage"))
			{
				m_CurrentInfo.ImageDataSourceIn = obj.GetValue(uint.MaxValue);
			}
			SetRoiVisible();
			ImageChangedEvent?.Invoke(m_CurrentInfo.SelectedImage.DisplayValue);
		}
	}

	/// <summary>
	/// 设置roi的可见性
	/// </summary>
	public void SetRoiVisible()
	{
		if (IsOpenParams)
		{
			if (m_CurrentInfo != null)
			{
				bool isCanDrawROI = m_CurrentInfo.IsCanDrawROI;
				if (IsShowDoubleImage)
				{
					imageView.ROIVisible = false;
					imageViewIn.ROIVisible = isCanDrawROI;
				}
				else
				{
					imageView.ROIVisible = isCanDrawROI;
				}
			}
		}
		else
		{
			imageView.ROIVisible = false;
			imageViewIn.ROIVisible = false;
		}
	}

	/// <summary>
	/// 增加已选中待叠加的图像
	/// </summary>
	public void AddCheckImage(ImageData imageData, string strCheckImageName)
	{
		bool flag = true;
		int num = (int)imageView.GetImageViewWidth();
		int num2 = (int)imageView.GetImageViewHeight();
		if (num == 0)
		{
			num = 920;
		}
		if (num2 == 0)
		{
			num2 = 517;
		}
		ImageViewItem selectedImage;
		if ((selectedImage = m_CurrentInfo.SelectedImage) != null)
		{
			flag = (selectedImage.IsBackgroundImage ? true : false);
		}
		int value = 0;
		byte transparency = 0;
		int count = checkImageList.Count;
		if (count < 3)
		{
			foreach (TransparencyData imageTransparency in imageTransparencyList)
			{
				if (!imageTransparency.IsUsed)
				{
					value = imageTransparency.ZIndex;
					transparency = imageTransparency.ImageTransparency;
					imageTransparency.IsUsed = true;
					imageTransparency.key = strCheckImageName;
					break;
				}
			}
			Image image = new Image();
			image.Uid = strCheckImageName;
			image.MouseLeftButtonDown += checkImage_PreviewMouseLeftButtonDown;
			image.MouseLeftButtonUp += checkImage_PreviewMouseLeftButtonUp;
			image.MouseEnter += checkImage_MouseEnter;
			image.MouseMove += checkImage_MouseMove;
			image.MouseWheel += checkImage_MouseWheel;
			image.IsHitTestVisible = false;
			image.Focusable = true;
			image.SetValue(RenderOptions.BitmapScalingModeProperty, BitmapScalingMode.NearestNeighbor);
			imageView.AddImageLayer(image);
			System.Windows.Controls.Panel.SetZIndex(image, value);
			if (flag)
			{
				image.Visibility = Visibility.Visible;
			}
			else
			{
				image.Visibility = Visibility.Collapsed;
			}
			_byte2Image.Clear();
			image.Source = _byte2Image.BuiltBgraImageSource(imageData, num, num2, transparency);
			checkImageList.Add(image);
		}
		m_CurrentInfo.RenderDataCenter.CheckImagesName = checkImageList.Select((Image p) => p.Uid).ToList();
	}

	/// <summary>
	/// 移除已叠加的图层
	/// </summary>
	public void RemoveCheckImage(string strCheckImageName)
	{
		Image image = checkImageList.FirstOrDefault((Image p) => p.Uid == strCheckImageName);
		if (image != null)
		{
			checkImageList.Remove(image);
			imageView.RemoveImageLayer(image);
			TransparencyData transparencyData = imageTransparencyList.FirstOrDefault((TransparencyData p) => p.key == strCheckImageName);
			if (transparencyData != null)
			{
				transparencyData.key = null;
				transparencyData.IsUsed = false;
			}
		}
		m_CurrentInfo.RenderDataCenter.CheckImagesName = checkImageList.Select((Image p) => p.Uid).ToList();
	}

	/// <summary>
	/// 更新已叠加图层的图像
	/// </summary>
	public void UpdateCheckImages()
	{
		byte transparency = 0;
		int num = (int)imageView.GetImageViewWidth();
		int num2 = (int)imageView.GetImageViewHeight();
		if (num == 0)
		{
			num = 920;
		}
		if (num2 == 0)
		{
			num2 = 517;
		}
		foreach (Image checkImage in checkImageList)
		{
			if (curImageData == null)
			{
				checkImage.Source = null;
				continue;
			}
			ImageViewItem imageViewItem = m_CurrentInfo.ImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayName == checkImage.Uid);
			ImageData image = null;
			if (imageViewItem != null && imageViewItem.DisplayObject != null && !m_CurrentInfo.RenderDataCenter.TryGetImage(imageViewItem.DisplayName, out image))
			{
				image = (imageViewItem.DisplayObject as Apps.XmlParser.Object).GetValue(ExecuteCount) as ImageData;
			}
			if (image != null)
			{
				TransparencyData transparencyData = imageTransparencyList.FirstOrDefault((TransparencyData p) => p.key == checkImage.Uid);
				if (transparencyData != null)
				{
					transparency = transparencyData.ImageTransparency;
				}
				_byte2Image.Clear();
				checkImage.Source = _byte2Image.BuiltBgraImageSource(image, num, num2, transparency);
			}
			else
			{
				checkImage.Source = null;
			}
		}
	}

	/// <summary>
	/// 清空图层
	/// </summary>
	public void ClearImageLayer()
	{
		foreach (Image checkImage in checkImageList)
		{
			imageView.RemoveImageLayer(checkImage);
		}
		checkImageList.Clear();
		if (m_CurrentInfo?.RenderDataCenter != null)
		{
			m_CurrentInfo.RenderDataCenter.CheckImagesName = null;
		}
		foreach (TransparencyData imageTransparency in imageTransparencyList)
		{
			imageTransparency.key = null;
			imageTransparency.IsUsed = false;
		}
	}

	/// <summary>
	/// 底图显示大小改变时刷新叠加图层
	/// </summary>
	private void imageView_OnFreshExtendContent(object sender, object Tag)
	{
		UpdateCheckImages();
	}

