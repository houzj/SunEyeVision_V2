		moduleSetShapesConfig.SetBinding(ModuleSetShapesConfig.ConfigCommandProperty, "ShapesConfigCommand");
		moduleSetShapesConfig.SetBinding(ModuleSetShapesConfig.ItemsSourceProperty, "ShapeSourceList");
