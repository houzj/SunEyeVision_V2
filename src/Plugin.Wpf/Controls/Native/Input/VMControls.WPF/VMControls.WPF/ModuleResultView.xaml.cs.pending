	/// <summary>
	/// 根据选择的ROI名称改变imageListCombobox选中项
	/// </summary>
	/// <param name="strDisplayImageName"></param>
	public void ImageChanged(string strDisplayImageName)
	{
		if (m_CurrentInfo == null)
		{
			return;
		}
		VmIO io = (m_CurrentInfo.DecorateSource as VmModule)?.Root?.GetIoByPathFromAround(strDisplayImageName);
		if (io == null)
		{
			return;
		}
		if (IsShowDoubleImage)
		{
			ImageViewItem imageViewItem = m_CurrentInfo.InputImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayValue == io);
			if (imageViewItem != null)
			{
				m_CurrentInfo.SelectedInputImage = imageViewItem;
			}
		}
		else
		{
			ImageViewItem imageViewItem2 = m_CurrentInfo.ImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayValue == io);
			if (imageViewItem2 != null)
			{
				m_CurrentInfo.SelectedImage = imageViewItem2;
			}
		}
	}

	private void ResultTab_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		RefreshResultTree();
	}

	private void imageView_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (sender is ImageViewBox { ROIVisible: false, IsStateForDrawROI: not false } imageViewBox && imageViewBox.DrawROIType != null)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("RoiDrawTips"), MessageIcons.Warning);
			imageViewBox.Focus();
		}
	}

	private static void OnIsShowDoubleImageChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ModuleResultView moduleResultView = d as ModuleResultView;
		bool flag = (bool)e.NewValue;
		if (moduleResultView == null)
		{
			return;
		}
		moduleResultView.colInput.Width = (flag ? new GridLength(1.0, GridUnitType.Star) : new GridLength(0.0));
		if (moduleResultView.m_CurrentInfo != null)
		{
			moduleResultView.m_CurrentInfo.IsDoubleImageMode = flag;
			moduleResultView.m_CurrentInfo.SelectedInputImage = null;
			if (flag && moduleResultView.m_CurrentInfo.InputImageViewList.Count > 0)
			{
				moduleResultView.m_CurrentInfo.SelectedInputImage = moduleResultView.m_CurrentInfo.InputImageViewList[0];
			}
			moduleResultView.SetRoiVisible();
		}
	}

	private void BtnToolRegionScaleIn_Click(object sender, RoutedEventArgs e)
	{
		imageViewIn.Init();
	}

	private void m_btnFullScreenIn_Click(object sender, RoutedEventArgs e)
	{
		FullScreen instance = FullScreen.Instance;
		instance.DataContext = viewboxIn.DataContext;
		viewboxIn.Children.Remove(imageViewIn);
		imageUnion.Children.Remove(btnLeft);
		imageUnion.Children.Remove(btnRight);
		instance.SetChild(imageViewIn);
		instance.SetChild(btnLeft);
		instance.SetChild(btnRight);
		instance.ShowDialog();
		instance.RemoveChild();
		instance.DataContext = null;
		viewboxIn.Children.Add(imageViewIn);
		imageUnion.Children.Add(btnLeft);
		imageUnion.Children.Add(btnRight);
	}

