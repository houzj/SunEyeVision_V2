	private void m_ResultDataGrid_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		if (m_ResultDataGrid.SelectedItem == null)
		{
			return;
		}
		int num = m_ResultDataGrid.Items.IndexOf(m_ResultDataGrid.SelectedItem) + 1;
		selectIndex = num;
		IList<object> list = null;
		if ((list = m_CurrentInfo.ModuleParams.GetDisplayList()) == null)
		{
			return;
		}
		imageView.ClearExternShapes();
		m_CurrentInfo.ShapeList.Clear();
		AddCrossLine();
		foreach (Apps.XmlParser.Object item in list)
		{
			if (item.IsDisplay && !exceptTypes.Contains(item.Type))
			{
				item.ClearValueStore();
				List<object> shapes = item.GetValue(ExecuteCount) as List<object>;
				SetRectHighLight(item, shapes);
				DrawCurModuleUIResult(item, item.Type, shapes);
			}
		}
	}

