<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.ModuleSetShapesConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:AppsXmlUI="clr-namespace:Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:localXmlParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" xmlns:localXmlParser="clr-namespace:Apps.XmlParser;assembly=Apps.XmlParser" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="win" Title="{DynamicResource shapes_config}" Height="450" Width="400">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apps.XmlUI;component/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/TextBoxStyle/TextBoxStyle.xaml" />
        <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localXmlParserTab:Holder}}" DataType="{x:Type localXmlParserTab:Holder}" ItemsSource="{Binding EnumEntrysA}">
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Lang:ResourceBinding Name}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
      </HierarchicalDataTemplate>
      <Style x:Key="SearchButton" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border BorderBrush="{DynamicResource LogicTypeButtonBB}" CornerRadius="2">
                <Image Name="icon" Height="32" Width="32" Source="/Apps.Style;component/Resources/ic_search_normal.png" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_search_hover.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <StackPanel Name="StackPanel" Grid.Row="0" Orientation="Horizontal" Margin="18,4,0,0">
      <TextBox Name="SearchText" FontSize="14" Width="142" Style="{StaticResource input}" Tag="{DynamicResource Lang_Search}" />
      <Button Width="32" Height="32" Margin="-32,0,0,0" VerticalAlignment="Center" Style="{StaticResource SearchButton}" Click="Search_Click" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#E0DFDE" BorderThickness="1" Margin="18,4,18,8">
      <AppsXmlUI:CheckBoxConfigTreeView Name="outputConfigTreeView" Margin="0,5,0,0" ItemsSource="{Binding ItemsSource, ElementName=win}" />
    </Border>
    <Rectangle Grid.Row="1" Height="1" Fill="#C8C4C1" VerticalAlignment="Bottom" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft" Background="#E4E5E7">
      <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Lang_Msg_Cancel}" Margin="13,0,0,0" VerticalAlignment="Center" Click="Cancel_Click" />
      <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" Margin="8,0,0,0" VerticalAlignment="Center" Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</controls:BaseWindow>