<?xml version="1.0" encoding="utf-8"?>
<localBase:ServiceProvideControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.OneProcedureConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:localBase="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base">
  <Control.Template>
    <ControlTemplate>
      <Grid Name="PART_View">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:ToolBox ItemsSource="{Binding ToolBoxItemsSource, RelativeSource={RelativeSource TemplatedParent}}">
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="5" Direction="360" Opacity="0.30" ShadowDepth="2" Color="#FF0F1010" />
          </UIElement.Effect>
        </local:ToolBox>
        <localBase:DiagramArea Grid.Column="1" Procedure="{Binding Procedure, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
    </ControlTemplate>
  </Control.Template>
</localBase:ServiceProvideControl>