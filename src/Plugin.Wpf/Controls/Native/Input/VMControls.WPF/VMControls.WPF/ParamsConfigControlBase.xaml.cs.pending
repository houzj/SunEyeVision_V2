	public long GetBaseHandle()
	{
		TempVmSolution.Init();
		return (long)VmSolution.Instance.BaseHandle;
	}

	/// <summary>
	/// 加载独立Group方案
	/// </summary>
	/// <param name="shape"></param>
	public IntPtr ImportIndependentGroup(string path, string password)
	{
		IMVSGroup iMVSGroup = VmSolution.LoadIndependentGroup(path, password);
		ParamsConfig = iMVSGroup.Params;
		_independentGro = default;
		_independentGro.nId = iMVSGroup.ID;
		_independentGro.pHandle = VmSolution.Instance.BaseHandle;
		if (IntPtr.Zero == groupInfoPtr)
		{
			groupInfoPtr = Marshal.AllocCoTaskMem(Marshal.SizeOf(_independentGro));
		}
		Marshal.StructureToPtr(_independentGro, groupInfoPtr, fDeleteOld: true);
		return groupInfoPtr;
	}

	/// <summary>
	/// 加载Group模块库（独立使用时调用）
	/// </summary>
	private void LoadAssembliesForIndependentGroup()
	{
		string moduleName = "IMVSGroup";
		Assembly assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName + "Cs"));
		string text = string.Empty;
		if (VmSolution.ModulePathList.Keys.Contains(moduleName))
		{
			text = VmSolution.ModulePathList[moduleName];
		}
		else
		{
			DirectoryInfo directoryInfo = new DirectoryInfo(CurrentPathHelper.Instance.GetCurrentPath() + "\\Module(sp)\\x64");
			DirectoryInfo[] directories = directoryInfo.GetDirectories();
			foreach (DirectoryInfo directoryInfo2 in directories)
			{
				if ((from p in directoryInfo2.GetDirectories()
					select p.Name).Contains(moduleName))
				{
					text = directoryInfo2.FullName + "\\" + moduleName;
					VmSolution.ModulePathList.TryAdd(moduleName, text);
					break;
				}
			}
		}
		if (File.Exists(text + "\\" + moduleName + "Cs.dll"))
		{
			ActivatorWrap.LoadAssembly(text + "\\" + moduleName + "Cs.dll");
			if (assembly == null)
			{
				assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName + "Cs"));
			}
		}
		if (File.Exists(text + "\\" + moduleName + "Control.dll"))
		{
			ActivatorWrap.LoadAssembly(text + "\\" + moduleName + "Control.dll");
		}
		string text2 = Path.Combine(CurrentPathHelper.Instance.GetCurrentPath(), "Module(sp)\\x64\\.CommonControl\\DynamicObjectConfigControl.dll");
		if (File.Exists(text2))
		{
			ActivatorWrap.LoadAssembly(text2);
		}
	}

	/// <summary>
	/// 加载方案
	/// </summary>
	/// <param name="shape"></param>
	public IntPtr ImportSol(string path, string password)
	{
		VmSolution.Import(path, password);
		return VmSolution.Instance.BaseHandle;
	}

	public void BindParamById(uint Id)
	{
		VmModule moduleByID = VmSolution.Instance.GetModuleByID(Id);
		if (moduleByID != null)
		{
			ParamsConfig = moduleByID.Params;
		}
	}
