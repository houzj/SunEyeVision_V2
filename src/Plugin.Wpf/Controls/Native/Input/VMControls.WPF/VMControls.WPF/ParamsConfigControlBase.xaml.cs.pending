	private static void OnIsOpenSubWindowChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ParamsConfigControlBase paramsConfigControlBase = d as ParamsConfigControlBase;
		bool flag = (bool)e.NewValue;
		if (paramsConfigControlBase != null)
		{
			if (flag)
			{
				paramsConfigControlBase.OpenSubWindow();
			}
			else
			{
				paramsConfigControlBase.CloseSubWindow();
			}
		}
	}

	private void OpenSubWindow()
	{
		if (!IsLoaded)
		{
			needOpenSubWindowAfterLoaded = true;
		}
		else
		{
			if (!(DataContext is AlgorithmTabRoot { HasSubscribeInWindow: false } algorithmTabRoot))
			{
				return;
			}
			if (curSubWindow == null)
			{
				Window window = Window.GetWindow(this);
				if (window != null)
				{
					curSubWindow = new ParamSubscribeWindow(window, IntPtr.Zero);
				}
				else
				{
					HwndSource hwndSource = PresentationSource.FromDependencyObject(this) as HwndSource;
					curSubWindow = new ParamSubscribeWindow(null, hwndSource.Handle);
				}
				curSubWindow.Closed += CurSubWindow_Closed;
			}
			if (AppLocalizationService.GetLang("Language") == "English")
			{
				curSubWindow.Width = 320.0;
			}
			curSubWindow.DataContext = DataContext;
			curSubWindow.Show();
			algorithmTabRoot.HasSubscribeInWindow = true;
		}
	}

	private void CloseSubWindow()
	{
		if (curSubWindow != null)
		{
			curSubWindow.Closed -= CurSubWindow_Closed;
			curSubWindow.DataContext = null;
			curSubWindow.Close();
			curSubWindow = null;
		}
	}

	private void CurSubWindow_Closed(object sender, EventArgs e)
	{
		curSubWindow.Closed -= CurSubWindow_Closed;
		curSubWindow.DataContext = null;
		IsOpenSubWindow = false;
		curSubWindow = null;
	}

	private static void OnParamsConfigChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ParamsConfigControlBase paramsConfigControlBase = (ParamsConfigControlBase)d;
		IParamsConfig paramsConfig = e.OldValue as IParamsConfig;
		IParamsConfig paramsConfig2 = e.NewValue as IParamsConfig;
		if (paramsConfig != null && paramsConfigControlBase.DataContext is AlgorithmTabRoot algorithmTabRoot)
		{
			algorithmTabRoot.Dispose();
		}
		if (paramsConfig2 != null)
		{
			paramsConfigControlBase.LoadModuleControlDLL(paramsConfig2);
			if (paramsConfig2.XmlPath == null || !File.Exists(paramsConfig2.XmlPath))
			{
				return;
			}
			AlgorithmTabRoot algorithmTabRoot2 = null;
			algorithmTabRoot2 = ((!(paramsConfig2 is ModuleParam param)) ? new AlgorithmTabRoot(paramsConfig2) : param.GetParamRoot());
			if (AppLocalizationService.GetLang("Language") == "English")
			{
				if (algorithmTabRoot2.ENCustomTabWidth != 0f)
				{
					algorithmTabRoot2.CustomTabWidth = algorithmTabRoot2.ENCustomTabWidth;
					if (algorithmTabRoot2.ENCustomTabHeight != 0f)
					{
						algorithmTabRoot2.CustomTabHeight = algorithmTabRoot2.ENCustomTabHeight;
					}
				}
				else
				{
					algorithmTabRoot2.CustomTabWidth = algorithmTabRoot2.CustomTabENWidth;
				}
			}
			else if (algorithmTabRoot2.ZHCustomTabWidth != 0f)
			{
				algorithmTabRoot2.CustomTabWidth = algorithmTabRoot2.ZHCustomTabWidth;
				if (algorithmTabRoot2.ZHCustomTabHeight != 0f)
				{
					algorithmTabRoot2.CustomTabHeight = algorithmTabRoot2.ZHCustomTabHeight;
				}
			}
			else
			{
				algorithmTabRoot2.CustomTabWidth = algorithmTabRoot2.CustomTabCHWidth;
			}
			algorithmTabRoot2.DoIniter();
			if (Window.GetWindow(paramsConfigControlBase) is BaseWindow || !CVmObjectBase.GetIsSDKMode())
			{
				algorithmTabRoot2.IsSubscribeInWindow = ((IVmSolution)VmSolution.Instance)?.IsSubscribeInWindow ?? false;
			}
			algorithmTabRoot2.GetItemsValueUnit();
			paramsConfigControlBase.DataContext = algorithmTabRoot2;
			paramsConfigControlBase.SetBinding(IsOpenSubWindowProperty, new Binding("IsSubscribeInWindow")
			{
				Source = algorithmTabRoot2,
				Mode = BindingMode.TwoWay
			});
		}
		else
		{
			paramsConfigControlBase.IsOpenSubWindow = false;
			paramsConfigControlBase.DataContext = null;
		}
	}

