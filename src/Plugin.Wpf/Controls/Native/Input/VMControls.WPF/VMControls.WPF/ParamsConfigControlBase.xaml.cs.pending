	}

	public List<string> GetParamTabNames()
	{
		List<string> list = new List<string>();
		try
		{
			IOwner owner = DataContext as AlgorithmTabRoot;
			if (owner != null && owner.Owner != null)
			{
				VmModule vmModule = owner.Owner as VmModule;
				if (vmModule.StrModuleName == "ShellModule")
				{
					ISpecialModuleParamTabVisible specialModuleParamTabVisible = UIHelper.FindAndConvertDataContext<ISpecialModuleParamTabVisible>(this);
					if (specialModuleParamTabVisible != null)
					{
						return specialModuleParamTabVisible.GetParamTabNames();
					}
				}
			}
			List<Tab> list2 = (DataContext as AlgorithmTabRoot)?.Tabs.OfType<Tab>().ToList();
			if (list2 != null)
			{
				foreach (Tab item in list2)
				{
					list.Add(AppLocalizationService.GetLang(item.Name));
				}
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message + ex.StackTrace);
			VmException ex2 = new VmException(-536870911);
			throw ex2;
		}
		return list;
	}

	public void SetParamTabVisible(string tabName, bool isVisible)
	{
		Dispatcher.Invoke(() =>
		{
			if (string.IsNullOrEmpty(tabName))
			{
				throw new VmException(-536870911);
			}
			IOwner owner = DataContext as AlgorithmTabRoot;
			if (owner != null && owner.Owner != null)
			{
				VmModule vmModule = owner.Owner as VmModule;
				if (vmModule.StrModuleName == "ShellModule")
				{
					ISpecialModuleParamTabVisible specialModuleParamTabVisible = UIHelper.FindAndConvertDataContext<ISpecialModuleParamTabVisible>(this);
					if (specialModuleParamTabVisible != null)
					{
						List<string> paramTabNames = specialModuleParamTabVisible.GetParamTabNames();
						if (!paramTabNames.Contains(tabName))
						{
							throw new VmException(-536870911);
						}
						specialModuleParamTabVisible.SetParamTabVisible(tabName, isVisible);
					}
					return;
				}
			}
			Tab tab = (DataContext as AlgorithmTabRoot)?.Tabs.OfType<Tab>().ToList().FirstOrDefault((Tab p) => AppLocalizationService.GetLang(p.Name) == tabName);
			if (tab == null)
			{
				throw new VmException(-536870911);
			}
			tab.IsVisible = isVisible;
			int value = ((DataContext as AlgorithmTabRoot)?.Tabs.IndexOf(tab)).Value;
			(DataContext as AlgorithmTabRoot).HandleTabSelectionChange(value);
		});
	}

	public ParamsConfigControlBase()
	{
		InitializeComponent();
		CurrentUIHelper.Instance.Dispatcher.Invoke(() =>
		{
		});
		Loaded += ParamsConfigControlBase_Loaded;
	}

	~ParamsConfigControlBase()
	{
		try
		{
			if (IntPtr.Zero != groupInfoPtr)
			{
				Marshal.FreeCoTaskMem(groupInfoPtr);
			}
		}
		catch (Exception)
		{
		}
	}

	private void ParamsConfigControlBase_Loaded(object sender, RoutedEventArgs e)
	{
		Window window = Window.GetWindow(this);
		if (window != null)
		{
			WeakEventManager<Window, EventArgs>.RemoveHandler(window, "Closed", Window_Closed);
			WeakEventManager<Window, EventArgs>.AddHandler(window, "Closed", Window_Closed);
		}
		if (needOpenSubWindowAfterLoaded)
		{
			OpenSubWindow();
			needOpenSubWindowAfterLoaded = false;
		}
	}

	private void Window_Closed(object sender, EventArgs e)
	{
		if (DataContext is AlgorithmTabRoot algorithmTabRoot)
		{
			if (((IVmSolution)VmSolution.Instance).IsContinuousSelfExecute)
			{
				((IVmSolution)VmSolution.Instance).IsContinuousSelfExecute = false;
			}
			FunctionCameraManager.UnRegister("GetLight");
			FunctionCameraManager.UnRegister("DeleteLight");
			FunctionCameraManager.UnRegister("GetCameraParam");
			FunctionCameraManager.UnRegister("GetImageConfigLight");
			FunctionCameraManager.UnRegister("DeleteImageConfigLight");
			FunctionCameraManager.UnRegister("GetCamera");
			FunctionCameraManager.UnRegister("GetFrameMeanCount");
			FunctionCameraManager.UnRegister("GetComm");
			FunctionCameraManager.UnRegister("GetCommAddress");
			FunctionCameraManager.UnRegister("GetSendAddress");
			algorithmTabRoot.Dispose();
			algorithmTabRoot.DoFinish();
		}
	}

	public override void OnApplyTemplate()
	{
		base.OnApplyTemplate();
		paramstab = Template.FindName("paramstab", this) as ParamsTabUserControl;
	}

	/// <summary>
	/// 加载模块控件库，用于二次开发
	/// </summary>
	private void LoadModuleControlDLL(IParamsConfig paramsConfig)
	{
		if (!((paramsConfig as IParent)?.Parent is IVmModule vmModule))
		{
			return;
		}
		string moduleName = vmModule.ModuleTypeName;
		Assembly assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName + "Control"));
		if (!(assembly == null))
		{
			return;
		}
		string text = Path.GetDirectoryName(paramsConfig.XmlPath) + "\\" + moduleName + "Control.dll";
		if (File.Exists(text))
		{
			ActivatorWrap.LoadAssembly(text);
			assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName + "Control")) ?? AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName.Remove(moduleName.LastIndexOf('C')) + "Control"));
		}
	}

	/// <summary>
	/// 获取基础句柄
