	public List<string> GetParamTabNames()
	{
		List<string> list = new List<string>();
		try
		{
			IOwner owner = ParamsConfig.DataContext as AlgorithmTabRoot;
			if (owner != null && owner.Owner != null)
			{
				VmModule vmModule = owner.Owner as VmModule;
				if (vmModule.StrModuleName == "ShellModule")
				{
					ISpecialModuleParamTabVisible specialModuleParamTabVisible = UIHelper.FindAndConvertDataContext<ISpecialModuleParamTabVisible>(this);
					if (specialModuleParamTabVisible != null)
					{
						return specialModuleParamTabVisible.GetParamTabNames();
					}
				}
			}
			List<Tab> list2 = (ParamsConfig.DataContext as AlgorithmTabRoot)?.Tabs.OfType<Tab>().ToList();
			if (list2 != null)
			{
				foreach (Tab item in list2)
				{
					list.Add(AppLocalizationService.GetLang(item.Name));
				}
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message + ex.StackTrace);
			VmException ex2 = new VmException(-536870911);
			throw ex2;
		}
		return list;
	}

	public void SetParamTabVisible(string tabName, bool isVisible)
	{
		Dispatcher.Invoke(() =>
		{
			if (string.IsNullOrEmpty(tabName))
			{
				throw new VmException(-536870911);
			}
			IOwner owner = ParamsConfig.DataContext as AlgorithmTabRoot;
			if (owner != null && owner.Owner != null)
			{
				VmModule vmModule = owner.Owner as VmModule;
				if (vmModule.StrModuleName == "ShellModule")
				{
					ISpecialModuleParamTabVisible specialModuleParamTabVisible = UIHelper.FindAndConvertDataContext<ISpecialModuleParamTabVisible>(this);
					if (specialModuleParamTabVisible != null)
					{
						List<string> paramTabNames = specialModuleParamTabVisible.GetParamTabNames();
						if (!paramTabNames.Contains(tabName))
						{
							throw new VmException(-536870911);
						}
						specialModuleParamTabVisible.SetParamTabVisible(tabName, isVisible);
					}
					return;
				}
			}
			Tab tab = (ParamsConfig.DataContext as AlgorithmTabRoot)?.Tabs.OfType<Tab>().ToList().FirstOrDefault((Tab p) => AppLocalizationService.GetLang(p.Name) == tabName);
			if (tab == null)
			{
				throw new VmException(-536870911);
			}
			tab.IsVisible = isVisible;
			int value = ((ParamsConfig.DataContext as AlgorithmTabRoot)?.Tabs.IndexOf(tab)).Value;
			(ParamsConfig.DataContext as AlgorithmTabRoot).HandleTabSelectionChange(value);
		});
	}

