	private void Init()
	{
		ParamsConfig.ROIPartUI = RenderControl.ImageView;
		SetBinding(ParamsConfigWidthProperty, new Binding("DataContext.ConfigWindowWidth")
		{
			Source = ParamsConfig
		});
		RenderControl.OnSelectedImageChanged += RenderControl_OnSelectedImageChanged;
		RenderControlBase renderControl = RenderControl;
		renderControl.OnMouseLeftButtonDownPixelChanged = (PixelPositionChanged)Delegate.Combine(renderControl.OnMouseLeftButtonDownPixelChanged, new PixelPositionChanged(RenderControl_OnMouseLeftButtonDownPixelChanged));
	}

	private void RenderControl_OnMouseLeftButtonDownPixelChanged(int x, int y)
	{
		OnMouseLeftButtonDownPixelChanged?.Invoke(x, y);
	}

	private AlgorithmTabRoot GetAlgorithmTabRoot()
	{
		AlgorithmTabRoot result = null;
		if (ModuleSource != null)
		{
			if (ModuleSource.Params is IData data)
			{
				if (data is ModuleParam param)
				{
					result = param.GetParamRoot();
				}
			}
			else
			{
				result = new AlgorithmTabRoot(ModuleSource.Params);
			}
		}
		return result;
	}

	private static void OnModuleSourceChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		if (d is ParamsConfigWithRenderControlBase paramsConfigWithRenderControlBase)
		{
			if (e.OldValue != null)
			{
				paramsConfigWithRenderControlBase.DeInit();
			}
			paramsConfigWithRenderControlBase.ParamsConfigSource = paramsConfigWithRenderControlBase.ModuleSource?.Params;
			AlgorithmTabRoot algorithmTabRoot = paramsConfigWithRenderControlBase.GetAlgorithmTabRoot();
			paramsConfigWithRenderControlBase.RenderControl.AlgorithmItems = algorithmTabRoot;
			paramsConfigWithRenderControlBase.RenderControl.ROIList = paramsConfigWithRenderControlBase.RenderControl.AlgorithmItems?.ROISelecters.Select((IROISelecter p) => p.ROIList).ToList();
			if (paramsConfigWithRenderControlBase.ModuleSource is VmModuleSet)
			{
				BaseNode source = algorithmTabRoot.FindBaseNodeByName(VmModuleExtern.GroupParamsName);
				Binding binding = new Binding("SelectedModule")
				{
					Source = source
				};
				paramsConfigWithRenderControlBase.RenderControl.SetBinding(RenderControlBase.ModuleSourceProperty, binding);
			}
			else
			{
				Binding binding2 = new Binding("ModuleSource")
				{
					Source = paramsConfigWithRenderControlBase
				};
				paramsConfigWithRenderControlBase.RenderControl.SetBinding(RenderControlBase.ModuleSourceProperty, binding2);
			}
		}
	}

	private void DeInit()
	{
		if (ParamsConfig.DataContext is AlgorithmTabRoot)
		{
			if (((IVmSolution)VmSolution.Instance).IsContinuousSelfExecute)
			{
				((IVmSolution)VmSolution.Instance).IsContinuousSelfExecute = false;
			}
			RenderControl.AlgorithmItems = null;
			RenderControl.ROIList = null;
			RenderControl.ClearImageView();
		}
	}

