<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.ParamsConfigWithRenderControlBase" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" x:Name="us">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="{Binding ParamsConfigWidth, ElementName=us}" />
      <ColumnDefinition Width="1.5*" MinWidth="460" />
    </Grid.ColumnDefinitions>
    <local:ParamsConfigControlBase x:Name="ParamsConfig" ParamsConfig="{Binding ParamsConfigSource, ElementName=us}" Width="{Binding ParamsConfigWidth, ElementName=us}" IsEditState="{Binding IsParamsEditState, ElementName=us}" />
    <local:RenderControlBase x:Name="RenderControl" Grid.Column="1" ModuleSource="{Binding ModuleSource, ElementName=us}" IImageData="{Binding ImageDataSource, ElementName=us}" MultiImageButtonVisible="{Binding MultiImageButtonVisible, ElementName=us}" CoordinateInfoVisible="{Binding CoordinateInfoVisible, ElementName=us}" SelectedROI="{Binding AlgorithmItems.SelectedROI, RelativeSource={RelativeSource Mode=Self}}" RoiSelectedCommand="{Binding AlgorithmItems.RoiSelectedCommand, RelativeSource={RelativeSource Mode=Self}}" RoiDelCommand="{Binding AlgorithmItems.RoiDelCommand, RelativeSource={RelativeSource Mode=Self}}" RoiCopyCommand="{Binding AlgorithmItems.RoiCopyCommand, RelativeSource={RelativeSource Mode=Self}}" RoiPasteCommand="{Binding AlgorithmItems.RoiPasteCommand, RelativeSource={RelativeSource Mode=Self}}" ImageSizeChangedCommand="{Binding AlgorithmItems.ImageSizeChangedCommand, RelativeSource={RelativeSource Mode=Self}}" RoiVisibleChangedCommand="{Binding AlgorithmItems.RoiVisibleChangedCommand, RelativeSource={RelativeSource Mode=Self}}" ROIVisible="{Binding ROIVisible, ElementName=us, Mode=TwoWay}" />
  </Grid>
</UserControl>