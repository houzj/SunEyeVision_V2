<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.ParamsConfigWithResultViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="us" MaxButtonVisibility="Visible" SizeAble="True" Loaded="us_Loaded" Unloaded="us_Unloaded" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_1:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid SizeChanged="Workarea_OnSizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Name="columnDefinition" Width="*" />
    </Grid.ColumnDefinitions>
    <local:ParamsConfigControlBase x:Name="ParamsConfig" IsEditState="{Binding IsParamsEditState, ElementName=us}" ParamsConfig="{Binding ParamsConfigSource, ElementName=us}" Width="{Binding ParamsConfigWidth, ElementName=us}" />
    <Grid Name="ModuleViewHost" Column="2" Background="{DynamicResource MainviewBaground}">
      <local:ModuleResultView x:Name="ModuleResultControl" IsRoiVisible="True" IsInfoTabExpand="False" ModuleSource="{Binding ModuleSource, Mode=OneWay, ElementName=us}" />
    </Grid>
    <GridSplitter Grid.Column="1" Background="{DynamicResource MainviewBaground}" Width="1" BorderThickness="1,0" BorderBrush="#FF000000" Opacity="0.5" HorizontalAlignment="Stretch" />
  </Grid>
</vm_port_0:BaseWindow>