<?xml version="1.0" encoding="utf-8"?>
<local:TabWinBase x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.ParamsTabControlBase" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="win" Closing="BaseWindow_Closing" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_1:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <vm_port_0:BaseWindow.TitleBar>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Foreground="{DynamicResource Col_SubForm_HeaderBrush_Foreground}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" FontWeight="Bold">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} {1}">
            <Binding Path="DataContext.Owner.ID" ElementName="paramstab" />
            <Lang:ResourceBinding Path="DataContext.OwnerTypeName" ElementName="paramstab" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <Button Margin="8,0" ToolTip="{DynamicResource Lang_Help}" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ElementName=paramstab, Path=DataContext.OpenHelpCommand}">
        <ContentControl.Content>
          <Image Name="img" Width="14" Height="14" Stretch="Uniform" Source="/Apps.Style;component/Resources/btn_help.png" />
        </ContentControl.Content>
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="border" Width="30" Height="26" Background="#00FFFFFF" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Value="{DynamicResource Col_Menubar_Shortcut_Selected_Background}" Property="Border.Background" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
    </StackPanel>
  </vm_port_0:BaseWindow.TitleBar>
  <local:ParamsConfigControlBase x:Name="paramstab" Focusable="True" ROIPartUI="{Binding ROIPartUI, ElementName=win, Mode=OneWay}" IsEditState="{Binding IsEditState, ElementName=win, Mode=OneWay}" />
</local:TabWinBase>