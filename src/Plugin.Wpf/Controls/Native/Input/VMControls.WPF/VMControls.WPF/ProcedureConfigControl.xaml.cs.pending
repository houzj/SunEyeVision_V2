	private static void OnDecoratorSelectedTabItemChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		object oldValue = e.OldValue;
		object newValue = e.NewValue;
		procedureConfigControl.DecoratorSelectedItem = newValue;
	}

	private static void OnDecoratorSelectedSubTabItemChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		object oldValue = e.OldValue;
		object newValue = e.NewValue;
	}

	private static void OnDecoratorSelectedItemChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		object oldValue = e.OldValue;
		object newValue = e.NewValue;
		if (newValue != null)
		{
			object obj = newValue;
			IDecorate decorate = null;
			if (obj is IDecorate decorate2)
			{
				decorate = decorate2;
				obj = decorate2.DecorateSource;
				if (obj is IVmProcedure)
				{
					procedureConfigControl.DecoratorSelectedTabItem = decorate2;
				}
			}
			if (!procedureConfigControl.LoadingFlag)
			{
				procedureConfigControl.SetCurrentValue(SelectedItemProperty, obj);
			}
			if (obj is IVmProcedure)
			{
				procedureConfigControl.SetCurrentValue(SelectedModuleProperty, null);
				procedureConfigControl.SetCurrentValue(SelectedProProperty, obj);
			}
			else
			{
				procedureConfigControl.SetCurrentValue(SelectedModuleProperty, obj);
				procedureConfigControl.SetCurrentValue(SelectedProProperty, null);
			}
		}
		else if (oldValue != null)
		{
			object obj2 = oldValue;
			IDecorate decorate3 = null;
			if (obj2 is IDecorate decorate4)
			{
				decorate3 = decorate4;
				obj2 = decorate4.DecorateSource;
			}
			procedureConfigControl.SetCurrentValue(SelectedItemProperty, null);
			if (obj2 is IVmProcedure)
			{
				procedureConfigControl.SetCurrentValue(SelectedProProperty, null);
			}
			else
			{
				procedureConfigControl.SetCurrentValue(SelectedModuleProperty, null);
			}
		}
	}

	private static void OnSolutionChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		IVmSolution vmSolution = e.OldValue as IVmSolution;
		IVmSolution vmSolution2 = e.NewValue as IVmSolution;
		if (procedureConfigControl.curTabControlBase is BaseWindow { IsClosing: false })
		{
			procedureConfigControl.curTabControlBase?.Close();
		}
		if (vmSolution != null)
		{
		}
		if (vmSolution2 != null)
		{
			procedureConfigControl.DecoratorSolution = new VmSolutionDecorator
			{
				DecorateSource = vmSolution2
			};
		}
		else
		{
			procedureConfigControl.DecoratorSolution = null;
		}
	}

	private static void OnLoadingFlagChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		if (!(bool)e.NewValue && (bool)e.OldValue && procedureConfigControl.DecoratorSelectedItem is IDecorate { DecorateSource: var decorateSource })
		{
			procedureConfigControl.SetCurrentValue(SelectedItemProperty, decorateSource);
		}
	}

	private static void OnProceduresChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		IEnumerable enumerable = (IEnumerable)e.OldValue;
		IEnumerable enumerable2 = (IEnumerable)e.NewValue;
		if (enumerable != null)
		{
			CollectionChangedEventManager.RemoveHandler(enumerable as INotifyCollectionChanged, procedureConfigControl.Procedures_CollectionChanged);
			procedureConfigControl.ClearProcedures();
		}
		if (enumerable2 != null)
		{
			CollectionChangedEventManager.RemoveHandler(enumerable2 as INotifyCollectionChanged, procedureConfigControl.Procedures_CollectionChanged);
			CollectionChangedEventManager.AddHandler(enumerable2 as INotifyCollectionChanged, procedureConfigControl.Procedures_CollectionChanged);
			IUnRedoService unRedoService = Ioc.Get<IUnRedoService>();
			if (unRedoService != null && unRedoService.SetCopyStatus())
			{
				procedureConfigControl.AddProcedures(enumerable2);
				Ioc.Get<IUnRedoService>()?.SetCopyStatus("false");
			}
			else
			{
				procedureConfigControl.AddProcedures(enumerable2, isInit: true);
			}
		}
	}

	private void ClearProcedures()
	{
		ResetDisposeStatus();
		DecoratedProcedures.Clear();
		DecoratedModules.Clear();
	}

	private void ResetDisposeStatus()
	{
		IsDisposeNotify = true;
		IsDisposeNotify = false;
	}

	private void RemoveProcedures(IEnumerable oldValue)
	{
		foreach (object data in oldValue)
		{
			VmModuleBaseDecorator vmModuleBaseDecorator = DecoratedModules.FirstOrDefault((VmModuleBaseDecorator p) => p.DecorateSource == data);
			if (vmModuleBaseDecorator != null)
			{
				DecoratedProcedures.Remove(vmModuleBaseDecorator);
				DecoratedModules.Remove(vmModuleBaseDecorator);
			}
		}
	}

	/// <summary>
	///
	/// </summary>
	/// <param name="newValue"></param>
	/// <param name="isInit">首次添加</param>
	private void AddProcedures(IEnumerable newValue, bool isInit = false)
	{
		IList list;
		if ((list = newValue as IList) != null && list.Count == 1 && !(list[0] is IVmProcedure))
		{
			Dispatcher.BeginInvoke((Action)(() =>
			{
				VmModuleDecorator item = new VmModuleDecorator
				{
					DecorateSource = list[0]
				};
				DecoratedModules.Add(item);
			}));
			return;
		}
		Dispatcher.Invoke(() =>
		{
			if (IsSingleProcedure && !IsForSingleModulesetMode)
			{
				needShowSingleProcedureName = (DecoratorSelectedTabItem as VmProcedureDecorator)?.Name;
				IsSingleProcedure = false;
			}
			foreach (object item3 in newValue)
			{
				if (item3 is IVmProcedure)
				{
					VmProcedureDecorator item = new VmProcedureDecorator
					{
						DecorateSource = item3
					};
					DecoratedProcedures.Add(item);
					DecoratedModules.Add(item);
				}
				else
				{
					VmModuleDecorator item2 = new VmModuleDecorator
					{
						DecorateSource = item3
					};
					DecoratedModules.Add(item2);
				}
			}
			if (newValue.OfType<object>().Any((object p) => p is IVmProcedure))
			{
				if (isInit)
				{
					DecoratorSelectedTabItem = DecoratedProcedures.FirstOrDefault();
				}
				else
				{
					DecoratorSelectedTabItem = DecoratedProcedures.LastOrDefault();
				}
			}
			if (IsForSingleModulesetMode && DecoratedProcedures.Count > 0)
			{
				PropertyChangedEventManager.RemoveHandler(DecoratedProcedures.First() as VmProcedureDecorator, DisplayModuleSetChanged, "DisplayModuleSet");
				PropertyChangedEventManager.AddHandler(DecoratedProcedures.First() as VmProcedureDecorator, DisplayModuleSetChanged, "DisplayModuleSet");
				if (SingleModulesetSource != null && (DecoratedProcedures.First() as VmProcedureDecorator).DisplayModuleSet.DecorateSource != SingleModulesetSource)
				{
					(DecoratedProcedures.First() as VmProcedureDecorator).DisplayModuleSet = new VmGroupDecorator
					{
						DecorateSource = SingleModulesetSource
					};
				}
			}
			if (!string.IsNullOrEmpty(needShowSingleProcedureName))
			{
				ShowSingleProcedure(needShowSingleProcedureName, needPopTip: false);
			}
		});
	}

	private void AddModulesAsync(IEnumerable newValue, bool isInit = false)
	{
		Dispatcher.BeginInvoke((Action)(() =>
		{
			if (IsSingleProcedure && !IsForSingleModulesetMode)
			{
				needShowSingleProcedureName = (DecoratorSelectedTabItem as VmProcedureDecorator)?.Name;
				IsSingleProcedure = false;
			}
			foreach (object item3 in newValue)
			{
				if (item3 is IVmProcedure)
				{
					VmProcedureDecorator item = new VmProcedureDecorator
					{
						DecorateSource = item3
					};
					DecoratedProcedures.Add(item);
					DecoratedModules.Add(item);
				}
				else
				{
					VmModuleDecorator item2 = new VmModuleDecorator
					{
						DecorateSource = item3
					};
					DecoratedModules.Add(item2);
				}
			}
			if (newValue.OfType<object>().Any((object p) => p is IVmProcedure))
			{
				if (isInit)
				{
					DecoratorSelectedTabItem = DecoratedProcedures.FirstOrDefault();
				}
				else
				{
					DecoratorSelectedTabItem = DecoratedProcedures.LastOrDefault();
				}
			}
			if (IsForSingleModulesetMode && DecoratedProcedures.Count > 0)
			{
				PropertyChangedEventManager.RemoveHandler(DecoratedProcedures.First() as VmProcedureDecorator, DisplayModuleSetChanged, "DisplayModuleSet");
				PropertyChangedEventManager.AddHandler(DecoratedProcedures.First() as VmProcedureDecorator, DisplayModuleSetChanged, "DisplayModuleSet");
				if (SingleModulesetSource != null && (DecoratedProcedures.First() as VmProcedureDecorator).DisplayModuleSet.DecorateSource != SingleModulesetSource)
				{
					(DecoratedProcedures.First() as VmProcedureDecorator).DisplayModuleSet = new VmGroupDecorator
					{
						DecorateSource = SingleModulesetSource
					};
				}
			}
			if (!string.IsNullOrEmpty(needShowSingleProcedureName))
			{
				ShowSingleProcedure(needShowSingleProcedureName, needPopTip: false);
			}
		}));
	}

	private void TabControl_Loaded(object sender, RoutedEventArgs e)
	{
		if (!((DecoratorSelectedTabItem as IDecorate)?.DecorateSource is IVmProcedure))
		{
			DecoratorSelectedTabItem = DecoratedProcedures.FirstOrDefault();
			return;
		}
		if ((DecoratorSelectedItem as IDecorate)?.DecorateSource is IVmProcedure)
		{
			DecoratorSelectedTabItem = DecoratorSelectedItem;
		}
		if (DecoratorSelectedItem != DecoratorSelectedTabItem && (DecoratorSelectedItem as IVmModule)?.Root != (DecoratorSelectedTabItem as IDecorate)?.DecorateSource && ((DecoratorSelectedItem as IDecorate)?.DecorateSource as IVmModule)?.Root != (DecoratorSelectedTabItem as IDecorate)?.DecorateSource)
		{
			DecoratorSelectedItem = DecoratorSelectedTabItem;
		}
	}

