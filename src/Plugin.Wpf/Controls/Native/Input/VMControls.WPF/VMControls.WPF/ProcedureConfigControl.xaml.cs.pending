	private void ReplaceProcedures(IList oldItems, IList newItems)
	{
	}

	private void Procedures_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		switch (e.Action)
		{
		case NotifyCollectionChangedAction.Add:
			AddProcedures(e.NewItems);
			break;
		case NotifyCollectionChangedAction.Remove:
		{
			RemoveProcedures(e.OldItems);
			object obj = DecoratorSelectedItem;
			if (obj != null)
			{
				if (DecoratorSelectedItem is IDecorate decorate)
				{
					obj = decorate.DecorateSource;
				}
				if (e.OldItems.Contains(obj))
				{
					DecoratorSelectedItem = null;
				}
				if (DecoratorSelectedTabItem is IDecorate decorate2)
				{
					obj = decorate2.DecorateSource;
				}
				if (e.OldItems.Contains(obj))
				{
					DecoratorSelectedTabItem = null;
				}
			}
			break;
		}
		case NotifyCollectionChangedAction.Move:
			throw new NotImplementedException();
		case NotifyCollectionChangedAction.Replace:
			ReplaceProcedures(e.OldItems, e.NewItems);
			break;
		case NotifyCollectionChangedAction.Reset:
			ClearProcedures();
			break;
		}
	}

