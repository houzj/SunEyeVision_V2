		}
	}

	private static void OnSingleModulesetSourceChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = d as ProcedureConfigControl;
		IVmModuleSet vmModuleSet = e.OldValue as IVmModuleSet;
		if (e.NewValue is IVmModuleSet && procedureConfigControl.IsForSingleModulesetMode && procedureConfigControl.SingleModulesetSource is IVMGroup && procedureConfigControl.DecoratedProcedures.Count > 0 && (procedureConfigControl.DecoratedProcedures.First() as VmProcedureDecorator).DisplayModuleSet.DecorateSource != procedureConfigControl.SingleModulesetSource)
		{
			(procedureConfigControl.DecoratedProcedures.First() as VmProcedureDecorator).DisplayModuleSet = new VmGroupDecorator
			{
				DecorateSource = procedureConfigControl.SingleModulesetSource
			};
		}
	}

	private void DisplayModuleSetChanged(object sender, PropertyChangedEventArgs e)
	{
		NotifyPropertyChanged("IsDisplaySingleModulesetSource");
	}

	/// <summary>
	/// 显示单流程
	/// </summary>
	/// <param name="name"></param>
	public void ShowSingleProcedure(string name, bool needPopTip = true)
	{
		if (string.IsNullOrEmpty(name))
		{
			if (needPopTip)
			{
				HikMessageBox.Show("Lang_ProcessNameEmpty", MessageIcons.Error, isTranslate: true);
			}
			return;
		}
		List<VmProcedureDecorator> list = DecoratedProcedures?.OfType<VmProcedureDecorator>()?.ToList();
		VmProcedureDecorator vmProcedureDecorator = list?.FirstOrDefault((VmProcedureDecorator p) => p.Name == name);
		if (vmProcedureDecorator == null)
		{
			if (VmSolution.Instance.Modules.Any((VmModule p) => p.Name == name))
			{
				needShowSingleProcedureName = name;
			}
			else if (needPopTip)
			{
				HikMessageBox.Show("Lang_ProcessDontExist", MessageIcons.Error, isTranslate: true);
			}
			return;
		}
		needShowSingleProcedureName = null;
		IsSingleProcedure = true;
		foreach (VmProcedureDecorator item in list)
		{
			if (item.Name == name)
			{
				item.IsShowAtSingleProcedureMode = true;
				DecoratorSelectedTabItem = item;
			}
			else
			{
				item.IsShowAtSingleProcedureMode = false;
			}
		}
	}

	/// <summary>
	/// 显示全流程
	/// </summary>
	public void ShowMultiProcedure()
	{
		IsSingleProcedure = false;
		needShowSingleProcedureName = null;
	}

	/// <summary>
	/// 显示部分流程
	/// </summary>
	/// <param name="nameList"></param>
	public void ShowSomeProcedure(List<string> nameList)
	{
		if (nameList == null || nameList.Any((string p) => string.IsNullOrEmpty(p)))
		{
			HikMessageBox.Show("Lang_ProcessNameEmpty", MessageIcons.Error, isTranslate: true);
			return;
		}
		List<VmProcedureDecorator> list = DecoratedProcedures?.OfType<VmProcedureDecorator>()?.ToList();
		if (list?.Count((VmProcedureDecorator p) => nameList.Contains(p.Name)) != nameList.Count)
		{
			HikMessageBox.Show("Lang_ProcessDontExist", MessageIcons.Error, isTranslate: true);
			return;
		}
		IsSingleProcedure = true;
		foreach (VmProcedureDecorator item in list)
		{
			if (nameList.Contains(item.Name))
			{
				item.IsShowAtSingleProcedureMode = true;
			}
			else
			{
				item.IsShowAtSingleProcedureMode = false;
			}
		}
		DecoratorSelectedTabItem = list.FirstOrDefault((VmProcedureDecorator p) => p.IsShowAtSingleProcedureMode);
	}

	private void ConfigParamsCommandExecute(object obj)
	{
		VmModuleBaseDecorator obj2 = obj as VmModuleBaseDecorator;
		if (obj2 != null && obj2.IsForbidden)
		{
			return;
		}
		VmModuleBaseDecorator obj3 = obj as VmModuleBaseDecorator;
		if (obj3 == null || obj3.IsLoadFailed != true)
		{
			if (obj is VmGroupDecorator)
			{
				DiagramArea_ItemDoubleClick(this, new ObjectEventArgs
				{
					Param = obj
				});
			}
			else
			{
				DiagramArea_ItemDoubleClick(this, new ObjectEventArgs
				{
					Param = obj
				});
			}
		}
	}

	private void DiagramArea_ItemDoubleClick(object sender, EventArgs e)
	{
		OpenParams((e as ObjectEventArgs)?.Param);
	}

	public void OpenParams(object data)
	{
		if (CanOpenConfigurationInterface(data))
		{
			if (curTabControlBase != null)
			{
				curTabControlBase.Close();
			}
			OpenParamsTabControl(ROIPartUI, data);
		}
	}

	private void SearchModuleCommandExecute(DiagramEventArgs ts)
	{
		IList<SearchPathInfo> currentPath = (ts.Param as IList<SearchPathInfo>).Reverse().ToList();
		if (currentPath.Count() > 0)
		{
			VmModuleBaseDecorator vmModuleBaseDecorator = DecoratedProcedures.FirstOrDefault((VmModuleBaseDecorator x) => (x.DecorateSource as IVmModule).ID == currentPath[0].nodeID);
			if (vmModuleBaseDecorator is VmProcedureDecorator vmProcedureDecorator)
			{
				vmProcedureDecorator.SearchModuleCommandExecute(ts);
			}
		}
	}

	private void JumpTargetCommandExecute(SearchPopupModel ts)
	{
		BoolOfDisplayType = false;
		string[] pathList = ts.FullPath.Split('.');
		if (pathList.Length != 0)
		{
			VmModuleBaseDecorator vmModuleBaseDecorator = DecoratedProcedures.FirstOrDefault((VmModuleBaseDecorator x) => (x.DecorateSource as IVmModule).Name == pathList[0]);
			if (vmModuleBaseDecorator is VmProcedureDecorator vmProcedureDecorator)
			{
				vmProcedureDecorator.SearchModulePopupCommand(ts);
			}
		}
	}

	/// <summary>
	/// 能否打开参数配置界面
	/// [权限]
	/// </summary>
	/// <returns></returns>
	public bool CanOpenConfigurationInterface(object data)
	{
		bool flag = true;
		AccessUser loginUser = CodeManager.Instance.GetLoginUser();
		IVmModule vmModule = ((data is IDecorate decorate) ? decorate.DecorateSource : data) as IVmModule;
		if (!vmModule.ConfigAvailable && (loginUser == AccessUser.Tech || loginUser == AccessUser.Operator))
		{
			flag = false;
		}
		return flag && vmModule.ConfigCheck;
	}

	[DllImport("user32.dll")]
	public static extern int SetParent(IntPtr hWndChild, IntPtr hWndNewParent);

	private void OpenParamsTabControl(object partUI, object data)
	{
		try
		{
			if (curTabControlBase != null)
			{
				return;
			}
			LogHelper.Info("OpenParamsTabControl start.");
			IVmModule vmModule = ((data is IDecorate decorate) ? decorate.DecorateSource : data) as IVmModule;
			if (!CheckModelXmlIntact(vmModule))
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("模块XML缺失"));
				return;
			}
			if (!vmModule.IsGlobalModu)
			{
				Ioc.Get<IUnRedoService>()?.Register(new SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.DataForUI.RootOperation
				{
					RootOperType = "ModifyConfig"
				}, AppLocalizationService.GetLang("修改配置") + ": " + vmModule.Name);
			}
			if (ROIPartUI is ModuleResultView { Tag: TabWinBase tag } moduleResultView)
			{
				if (tag.Visibility == Visibility.Visible)
				{
					tag.Close();
				}
				TabWinBase tabWinBase = null;
				moduleResultView.Tag = null;
			}
			TabWinBase tabWinBase2 = GetExternTabWin(vmModule) ?? new ParamsTabControlBase();
			tabWinBase2.ROIPartUI = partUI;
			tabWinBase2.IsEditState = IsParamsEditState;
			LogHelper.Info("ParamsConfig value start.");
			tabWinBase2.ParamsConfig = vmModule.Params;
			LogHelper.Info("ParamsConfig value end.");
			if (Application.Current != null)
			{
				Window window = Window.GetWindow(this);
				tabWinBase2.Owner = window ?? Application.Current.MainWindow;
				tabWinBase2.AlongParent = this;
			}
			else if (PresentationSource.FromDependencyObject(this) is HwndSource hwndSource)
			{
				WindowInteropHelper windowInteropHelper = new WindowInteropHelper(tabWinBase2)
				{
					Owner = hwndSource.Handle
				};
			}
			ElementHost.EnableModelessKeyboardInterop(tabWinBase2);
			tabWinBase2.Show();
			SetCurrentValue(IsOpenParamsProperty, true);
			curTabControlBase = tabWinBase2;
			WeakEventManager<Window, EventArgs>.AddHandler(curTabControlBase, "Closed", CurTabControlBase_Closed);
			if (ROIPartUI is ModuleResultView moduleResultView2)
			{
				moduleResultView2.Tag = curTabControlBase;
				moduleResultView2.SetRoiVisible();
			}
			DecoratorSelectedItem = data;
			LogHelper.Info("OpenParamsTabControl end.");
		}
		catch (VmException ex)
		{
			string text = AppLocalizationService.GetLang("errCode:") + $"{ex.errorCode:X}" + "\r\n";
			text = text + AppLocalizationService.GetLang("errInfo:") + ErrorCodeInfo.GetErrorInfo(ex.errorCode);
			LogHelper.Error("OpenParamsTabControl error: " + text);
		}
		catch (Exception ex2)
		{
			LogHelper.Error("OpenParamsTabControl error: " + ex2.Message + "\r\n" + ex2.StackTrace);
		}
	}

	private bool CheckModelXmlIntact(IVmModule module)
	{
		try
		{
			if (module == null)
			{
				return false;
			}
			if (!Directory.Exists(module.ModuleDir) || !File.Exists(module.ModuleDir + "\\" + module.ModuleTypeName + ".xml") || !File.Exists(module.ModuleDir + "\\" + module.ModuleTypeName + "AlgorithmTab.xml") || !File.Exists(module.ModuleDir + "\\" + module.ModuleTypeName + "Display.xml"))
			{
				return false;
			}
			return true;
		}
		catch (Exception ex)
		{
			LogHelper.Error("CheckModelXmlIntact error: " + ex.Message + "\r\n" + ex.StackTrace);
			return false;
		}
	}

	private TabWinBase GetExternTabWin(IVmModule vmModule)
	{
		string moduleName = vmModule.ModuleTypeName;
		Assembly assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName + "Control"));
		if (assembly == null)
		{
			string text = Path.GetDirectoryName(vmModule.Params.XmlPath) + "\\" + moduleName + "Control.dll";
			if (File.Exists(text))
			{
				ActivatorWrap.LoadAssembly(text);
				assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName + "Control")) ?? AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly p) => string.Equals(p.GetName().Name, moduleName.Remove(moduleName.LastIndexOf('C')) + "Control"));
			}
		}
		if (assembly != null)
		{
			List<Type> list = (from p in assembly.GetTypes()
				where typeof(TabWinBase).IsAssignableFrom(p)
				select p).ToList();
			if (list.Count > 0)
			{
				return ActivatorWrap.CreateInstance(list[0]) as TabWinBase;
			}
		}
		return null;
	}

	private void CurTabControlBase_Closed(object sender, EventArgs e)
	{
		Dispatcher.Invoke(() =>
		{
			curTabControlBase = null;
			if (ROIPartUI is ModuleResultView moduleResultView)
			{
				moduleResultView.Tag = null;
			}
			SetCurrentValue(IsOpenParamsProperty, false);
			SetRoiVisible(v: false);
		});
		Ioc.Get<IUnRedoService>()?.RemoveEmptyOperation();
	}

	/// <summary>
	/// 设置主界面绘制roi的可见性
	/// </summary>
	/// <param name="v"></param>
	private void SetRoiVisible(bool v)
	{
		if (ROIPartUI is ModuleResultView moduleResultView)
		{
			moduleResultView.SetRoiVisible();
		}
		else if (ROIPartUI is ImageViewBox imageViewBox)
		{
			imageViewBox.ROIVisible = v;
			imageViewBox.IsMulRolModule = false;
		}
	}

