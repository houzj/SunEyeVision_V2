	public override void OnApplyTemplate()
	{
		base.OnApplyTemplate();
		View = Template.FindName("PART_View", this) as Grid;
		TabControl = Template.FindName("tabControl", this) as TabControl;
		toolBox = Template.FindName("toolBox", this) as ToolBox;
		paramControl = Template.FindName("paramControl", this) as Grid;
		columnDefinition1 = Template.FindName("columnDefinition1", this) as ColumnDefinition;
		columnDefinition2 = Template.FindName("columnDefinition2", this) as ColumnDefinition;
		if (AppDataFactory.Instance().IsRightLayout && columnDefinition1 != null && columnDefinition1 != null)
		{
			columnDefinition1.Width = new GridLength(1.0, GridUnitType.Star);
			columnDefinition2.Width = GridLength.Auto;
			Grid.SetColumn(paramControl, 0);
			Grid.SetColumn(toolBox, 1);
		}
	}

	protected override Visual GetVisualChild(int index)
	{
		if (index == 0)
		{
			return View;
		}
		return _adornerLayer;
	}

	private void m_ProcessTabControl_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		if (!(e.OriginalSource is TabControl))
		{
			return;
		}
		TabControl tabControl = sender as TabControl;
		if (e.AddedItems.Count <= 0)
		{
			return;
		}
		ScrollViewer sv = tabControl.Template.FindName("scroll", tabControl) as ScrollViewer;
		object item = e.AddedItems[0];
		TabItem itemControl = tabControl.ItemContainerGenerator.ContainerFromItem(item) as TabItem;
		if (itemControl != null)
		{
			if (Application.Current == null && WinformHandle == IntPtr.Zero)
			{
				itemControl.SetValue(TabItem.IsSelectedProperty, true);
			}
			else
			{
				itemControl.Focus();
				Keyboard.ClearFocus();
			}
			DelayAction = (object s) =>
			{
				if (s != sv)
				{
					DelayAction = null;
				}
				else
				{
					double horizontalOffset = sv.HorizontalOffset;
					Point point = new Point(0.0, horizontalOffset);
					if (itemControl.FindCommonVisualAncestor(sv) is Visual)
					{
						Point point2 = itemControl.TransformToVisual(sv).Transform(default);
						if (point2.X >= 0.0 && point2.X <= sv.ActualWidth)
						{
							CanScroll = false;
							if (Math.Abs(point2.X - 0.0) < MinExWidth)
							{
								sv.ScrollToHorizontalOffset(horizontalOffset - MinExWidth);
							}
							if (Math.Abs(point2.X + itemControl.ActualWidth - sv.ActualWidth) < MinExWidth)
							{
								sv.ScrollToHorizontalOffset(horizontalOffset + MinExWidth);
							}
						}
					}
				}
			};
		}
		else
		{
			LogHelper.Error("itemControl is null.");
		}
	}

	private void Sv_ScrollChanged(object sender, ScrollChangedEventArgs e)
	{
		Dispatcher.BeginInvoke((Action)(() =>
		{
			if (!CanScroll)
			{
				CanScroll = true;
			}
			else if (CanScroll)
			{
				DelayAction?.Invoke(sender);
			}
		}));
	}

