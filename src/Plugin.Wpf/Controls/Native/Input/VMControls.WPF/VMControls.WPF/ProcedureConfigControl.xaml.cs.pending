	private static void OnIsShowProgressMaskChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		ProcedureConfigControl procedureConfigControl = (ProcedureConfigControl)d;
		if ((bool)e.NewValue)
		{
			procedureConfigControl.AddMask();
		}
		else
		{
			procedureConfigControl.RemoveMask();
		}
	}

	private void RemoveMask()
	{
		if (View != null)
		{
			View.Children.Remove(progressMask);
			progressMask = null;
		}
	}

	private void AddMask()
	{
		if (View != null)
		{
			progressMask = new ProgressMask();
			progressMask.SetBinding(ProgressMask.MessageProperty, new Binding("MaskMessage")
			{
				Source = this
			});
			progressMask.SetBinding(ProgressMask.ValueProperty, new Binding("Progress")
			{
				Source = this
			});
			progressMask.SetValue(Grid.ColumnSpanProperty, 2);
			View.Children.Add(progressMask);
		}
	}

	/// <summary>
	/// 进入和返回时
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	private void ContentPresenter_DataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
	{
		object newValue = e.NewValue;
		if (!(newValue is IDecorate decorate))
		{
			return;
		}
		if (decorate is VmProcedureDecorator vmProcedureDecorator)
		{
			if (DecoratorSelectedTabItem == vmProcedureDecorator)
			{
				SelectedItemToSelectedTabItem();
			}
		}
		else
		{
			DecoratorSelectedSubTabItem = decorate;
			SelectedItemToSelectedSubTabItem();
		}
	}

