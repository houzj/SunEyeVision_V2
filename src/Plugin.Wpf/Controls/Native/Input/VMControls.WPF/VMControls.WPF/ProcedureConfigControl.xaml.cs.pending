	private void VarConfigParamsCommandExecute(object obj)
	{
		VmModuleBaseDecorator obj2 = obj as VmModuleBaseDecorator;
		if (obj2 != null && obj2.IsForbidden)
		{
			return;
		}
		VmModuleBaseDecorator obj3 = obj as VmModuleBaseDecorator;
		if ((obj3 == null || obj3.IsLoadFailed != true) && obj is VmModuleSetDecorator vmModuleSetDecorator)
		{
			GlobalVariableDialog globalVariableDialog = new GlobalVariableDialog();
			if (Application.Current != null)
			{
				globalVariableDialog.Owner = Application.Current.MainWindow;
			}
			else if (PresentationSource.FromDependencyObject(this) is HwndSource hwndSource)
			{
				WindowInteropHelper windowInteropHelper = new WindowInteropHelper(globalVariableDialog)
				{
					Owner = hwndSource.Handle
				};
			}
			ElementHost.EnableModelessKeyboardInterop(globalVariableDialog);
			globalVariableDialog.DecorateSource = vmModuleSetDecorator.LocalVariableModule;
			globalVariableDialog.ShowDialog();
		}
	}
}
