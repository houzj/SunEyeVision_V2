	private AlgorithmTabRoot GetAlgorithmTabRoot()
	{
		AlgorithmTabRoot result = null;
		if (ModuleSource != null)
		{
			if (ModuleSource.Params is IData data)
			{
				if (data is ModuleParam param)
				{
					result = param.GetParamRoot();
				}
			}
			else
			{
				result = new AlgorithmTabRoot(ModuleSource.Params);
			}
		}
		return result;
	}

	private void UpdateRoi()
	{
		if (AlgorithmItems != null)
		{
			AlgorithmItems.UpdateROI();
		}
		else if (SelectedROI is IROISelecter iROISelecter)
		{
			iROISelecter.UpdateROI();
		}
	}

	private static void OnIsShowDoubleImageChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		RenderControlBase ic = d as RenderControlBase;
		bool flag = (bool)e.NewValue;
		if (ic == null)
		{
			return;
		}
		ic.colInput.Width = (flag ? new GridLength(1.0, GridUnitType.Star) : new GridLength(0.0));
		if (ic.ImageListDecorator != null)
		{
			ic.ImageListDecorator.SelectedInputImage = null;
		}
		Binding binding = new Binding("ROIVisible")
		{
			Source = ic,
			Mode = BindingMode.OneWay
		};
		if (flag)
		{
			BindingOperations.ClearBinding(ic.imageView, ImageViewBox.ROIVisibleProperty);
			ic.imageView.ROIVisible = false;
			ic.imageViewIn.SetBinding(ImageViewBox.ROIVisibleProperty, binding);
			if (ic.ImageListDecorator != null && ic.ImageListDecorator.InputImageViewList.Count > 0)
			{
				ic.ImageListDecorator.SelectedInputImage = ic.ImageListDecorator.InputImageViewList[0];
				ic.ROIVisible = ic.ImageListDecorator.SelectedInputImage != null;
			}
		}
		else
		{
			BindingOperations.ClearBinding(ic.imageViewIn, ImageViewBox.ROIVisibleProperty);
			ic.imageViewIn.ROIVisible = false;
			ic.imageView.SetBinding(ImageViewBox.ROIVisibleProperty, binding);
			ic.ROIVisible = ic.ImageListDecorator.InputImageViewList.Any((ImageViewItem p) => p.DisplayValue == ic.ImageListDecorator.SelectedImage.DisplayValue);
		}
	}

	private void BtnToolRegionScaleIn_Click(object sender, RoutedEventArgs e)
	{
		imageViewIn.Init();
	}

	private void m_btnFullScreenIn_Click(object sender, RoutedEventArgs e)
	{
		FullScreen instance = FullScreen.Instance;
		instance.DataContext = viewboxIn.DataContext;
		viewboxIn.Children.Remove(imageViewIn);
		instance.SetChild(imageViewIn);
		instance.ShowDialog();
		instance.RemoveChild();
		instance.DataContext = null;
		viewboxIn.Children.Add(imageViewIn);
	}

	private void imageListComboboxIn_SelectionChanged(object sender, SelectionChangedEventArgs e)
	{
		ComboBox comboBox = sender as ComboBox;
		if (!IsShowDoubleImage || comboBox.SelectedValue == null)
		{
			imageViewIn.ClearExternShapes();
			imageViewIn.Init();
			ImageDataSourceIn = null;
		}
		else if (ModuleParams != null && comboBox.SelectedValue is Apps.XmlParser.Object obj && (obj.TypeA == "image" || obj.TypeA == "pixelinfoimage"))
		{
			ImageDataSourceIn = obj.GetValue(uint.MaxValue);
		}
	}

	private void imageView_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
	{
		if (sender is ImageViewBox { ROIVisible: false, IsStateForDrawROI: not false } imageViewBox && imageViewBox.DrawROIType != null)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("RoiDrawTips"), MessageIcons.Warning);
			imageViewBox.Focus();
		}
		RaiseMouseLeftButtonDownPixelChangedEvent();
	}

	/// <summary>
	/// 设置渲染间隔(ms)
	/// </summary>
	/// <param name="millseconds"></param>
	public void SetRenderInterval(int millseconds)
	{
		if (millseconds < 0 || millseconds > 10000)
		{
			throw new VmException(-536870911);
		}
		renderInterval = millseconds / 100 * 100;
	}

	private double GetElapsedMillSeconds(long timeStamp)
	{
		long num = timeStamp - oldTimeStamp;
		return (double)num * (1.0 / (double)Stopwatch.Frequency) * 1000.0;
	}

	private bool IsNeedRender(long timeStamp)
	{
		return GetElapsedMillSeconds(timeStamp) >= (double)renderInterval;
	}

	public void SetModuleAndStatusForRender(IVmModule module, RenderSatus status)
	{
		if (renderStatusModule != null)
		{
			WeakEventManager<IVmModule, EventArgs>.RemoveHandler(renderStatusModule, "ModuleResultCallBackArrived", RenderStatusModule_ModuleResultCallBackArrived);
			renderStatusModule.SubscribeCount--;
		}
		renderStatusModule = module ?? ModuleSource;
		if ((uint)status <= 1u)
		{
			if (renderStatusModule != null)
			{
				renderStatus = status;
				WeakEventManager<IVmModule, EventArgs>.RemoveHandler(renderStatusModule, "ModuleResultCallBackArrived", RenderStatusModule_ModuleResultCallBackArrived);
				WeakEventManager<IVmModule, EventArgs>.AddHandler(renderStatusModule, "ModuleResultCallBackArrived", RenderStatusModule_ModuleResultCallBackArrived);
				renderStatusModule.SubscribeCount++;
			}
			else
			{
				renderStatus = RenderSatus.ALL;
			}
		}
		else
		{
			renderStatusModule = null;
			renderStatus = RenderSatus.ALL;
		}
	}

	private void RenderStatusModule_ModuleResultCallBackArrived(object sender, EventArgs e)
	{
		try
		{
			if (e is ValueEventArgs e2 && sender is VmModule vmModule && e2.Value is ImvsSdkDefine.IMVS_MODULE_RESULT_INFO_LIST_EX_Data)
			{
				VmIO vmIO = vmModule["(ModuStatus)"] as VmIO;
				int num = 2;
				if (vmIO != null)
				{
					num = (int)(vmIO.GetValue(uint.MaxValue, 0) ?? ((object)1));
				}
				if (renderStatus != RenderSatus.ALL && num != 2 && num != (int)renderStatus)
				{
					needUpdateRender = false;
				}
			}
		}
		catch (Exception)
		{
		}
	}

	private void RaiseMouseLeftButtonDownPixelChangedEvent()
	{
		int x = imageView?.PixelX ?? 0;
		int y = imageView?.PixelY ?? 0;
		OnMouseLeftButtonDownPixelChanged?.Invoke(x, y);
	}

	private static void OnRenderToolbarVisibleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		RenderControlBase renderControlBase = d as RenderControlBase;
		bool flag = (bool)e.NewValue;
		if (renderControlBase != null)
		{
			renderControlBase.rowInput.Height = (flag ? new GridLength(40.0) : new GridLength(0.0));
		}
	}

	/// <summary>
	/// 当图像已堆叠显示时，切换背景图
	/// </summary>
	public void SwitchBackgroundImage(string backgroundImageName)
	{
		Dispatcher.Invoke(() =>
		{
			if (string.IsNullOrEmpty(backgroundImageName))
			{
				throw new VmException(-536870911);
			}
			ImageViewItem imageViewItem = ImageListDecorator?.ImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayName == backgroundImageName);
			if (imageViewItem == null || imageViewItem.IsBackgroundImage || !imageViewItem.IsCheck)
			{
				throw new VmException(-536870911);
			}
			if (imageViewItem.IsCheck)
			{
				DisplayImageListDecorator displayImageListDecorator = ImageListDecorator;
				if (displayImageListDecorator != null && displayImageListDecorator.ImageViewList.Count((ImageViewItem p) => p.IsCheck) == 1)
				{
					throw new VmException(-536870911);
				}
			}
			try
			{
				ImageListDecorator.isNeedTips = false;
				ImageListDecorator.SetBackgoundImage(imageViewItem);
				ImageListDecorator.isNeedTips = true;
			}
			catch (Exception ex)
			{
				LogHelper.Error(ex.Message);
			}
		});
	}

