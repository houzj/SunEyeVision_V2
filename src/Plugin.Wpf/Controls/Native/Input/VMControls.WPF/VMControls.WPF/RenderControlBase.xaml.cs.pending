	private void DrawPointSet(IList<object> shapeList, IPointSet pointSet)
	{
		int pointNum = pointSet.PointNum;
		string color = pointSet.Stroke;
		double opacity = pointSet.Opacity;
		double strokeThickness = pointSet.StrokeThickness;
		Pretreatment(ref color, ref opacity, ref strokeThickness);
		if (!shapeList.Any((object p) => p is IMultiPoint))
		{
			MultiPoint multiPoint = new MultiPoint();
			shapeList.Add(multiPoint);
			multiPoint.OutlinePoints = new ObservableCollection<IOutlinePoint>();
			multiPoint.MicroPoints = new ObservableCollection<IMicroPoint>();
			multiPoint.Rectangles = new ObservableCollection<IRectangle>();
		}
		if (shapeList.FirstOrDefault((object p) => p is IMultiPoint) is IMultiPoint multiPoint2)
		{
			for (int num = 0; num < pointNum; num++)
			{
				MicroPoint microPoint = new MicroPoint();
				microPoint.CenterX = (float)pointSet.PointList[num].X;
				microPoint.CenterY = (float)pointSet.PointList[num].Y;
				microPoint.Color = color;
				microPoint.Opacity = opacity;
				multiPoint2.MicroPoints.Add(microPoint);
			}
			if (shapeList != shapeBuffer)
			{
				imageView.NeedRefreshShapes = true;
			}
		}
	}

	private void DrawOutlinePoint(IList<object> shapeList, IOutlinePoint outlinePoint)
	{
		if (!shapeList.Any((object p) => p is IMultiPoint))
		{
			MultiPoint multiPoint = new MultiPoint();
			shapeList.Add(multiPoint);
			multiPoint.OutlinePoints = new ObservableCollection<IOutlinePoint>();
			multiPoint.MicroPoints = new ObservableCollection<IMicroPoint>();
			multiPoint.Rectangles = new ObservableCollection<IRectangle>();
		}
		if (shapeList.FirstOrDefault((object p) => p is IMultiPoint) is IMultiPoint multiPoint2)
		{
			multiPoint2.OutlinePoints.Add(outlinePoint);
			if (shapeList != shapeBuffer)
			{
				imageView.NeedRefreshShapes = true;
			}
		}
	}

	private void DrawPolyline(IList<object> shapes, IPolyline polyline)
	{
		int num = polyline.PolylinePointList?.Count ?? 0;
		string color = polyline.Stroke;
		double opacity = polyline.Opacity;
		double strokeThickness = polyline.StrokeThickness;
		Pretreatment(ref color, ref opacity, ref strokeThickness);
		for (int i = 0; i < num; i++)
		{
			System.Windows.Point point = polyline.PolylinePointList[i];
			if (i + 1 < num)
			{
				System.Windows.Point point2 = polyline.PolylinePointList[i + 1];
				Apps.Data.ShapeDefine.Line line = new Apps.Data.ShapeDefine.Line();
				line.StartLineX = (float)point.X;
				line.StartLineY = (float)point.Y;
				line.EndLineX = (float)point2.X;
				line.EndLineY = (float)point2.Y;
				line.Color = color;
				line.Opacity = opacity;
				line.StrokeThickness = strokeThickness;
				shapes.Add(line);
			}
		}
	}

	private void BtnToolRegionScale_Click(object sender, RoutedEventArgs e)
	{
		InitViewSize();
	}

	private void m_btnFullScreen_Click(object sender, RoutedEventArgs e)
	{
		FullScreen instance = FullScreen.Instance;
		instance.DataContext = viewbox.DataContext;
		viewbox.Children.Remove(imageView);
		instance.SetChild(imageView);
		instance.ShowDialog();
		instance.RemoveChild();
		instance.DataContext = null;
		viewbox.Children.Add(imageView);
	}

