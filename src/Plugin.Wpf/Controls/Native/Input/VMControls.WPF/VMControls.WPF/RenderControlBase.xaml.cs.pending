	private static void ImageDataChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		RenderControlBase renderControlBase = (RenderControlBase)d;
		IImageData imageData = (IImageData)e.NewValue;
		if (renderControlBase != null && imageData != null)
		{
			renderControlBase.UpdateImageView(new ImageData(imageData.Width, imageData.Height, imageData.Buffer, imageData.PixelFormat));
		}
	}

	private static void OnCoordinateInfoVisibleChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		RenderControlBase renderControlBase = d as RenderControlBase;
		if (e.NewValue as bool? == true)
		{
			Visibility visibility = Visibility.Visible;
			renderControlBase.imageView.IsDisplayPixelAuto = true;
			renderControlBase.imageViewIn.IsDisplayPixelAuto = true;
		}
		else
		{
			Visibility visibility = Visibility.Collapsed;
			renderControlBase.imageView.IsDisplayPixelAuto = false;
			renderControlBase.imageViewIn.IsDisplayPixelAuto = false;
		}
	}

	private static void OnModuleSourceChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		RenderControlBase renderControlBase = d as RenderControlBase;
		IVmModule vmModule = e.OldValue as IVmModule;
		IVmModule vmModule2 = e.NewValue as IVmModule;
		if (renderControlBase == null)
		{
			return;
		}
		if (vmModule != null)
		{
			renderControlBase.DeInitRenderControl(vmModule);
			WeakEventManager<IVmModule, EventArgs>.RemoveHandler(vmModule, "AsyncModuleResultCallBackArrived", renderControlBase.OnModuleResultCallBackArrived);
			IVmProcedure vmProcedure = (vmModule as IVmProcedure) ?? (vmModule.Root as IVmProcedure);
			if (vmProcedure != null)
			{
				WeakEventManager<IVmProcedure, EventArgs>.RemoveHandler(vmProcedure, "AsyncWorkStatusCallBack", renderControlBase.OnPreduceResultCallBackArrived);
			}
		}
		if (vmModule2 != null)
		{
			renderControlBase.InitRenderControl(vmModule2);
			WeakEventManager<IVmModule, EventArgs>.RemoveHandler(vmModule2, "AsyncModuleResultCallBackArrived", renderControlBase.OnModuleResultCallBackArrived);
			WeakEventManager<IVmModule, EventArgs>.AddHandler(vmModule2, "AsyncModuleResultCallBackArrived", renderControlBase.OnModuleResultCallBackArrived);
			IVmProcedure vmProcedure2 = (vmModule2 as IVmProcedure) ?? (vmModule2.Root as IVmProcedure);
			if (vmProcedure2 != null)
			{
				renderControlBase.OwnerProcessID = (vmProcedure2 as IVmModule).ID;
				LogHelper.Info($"VmRenderControl Binding Process [{renderControlBase.OwnerProcessID}]");
				WeakEventManager<IVmProcedure, EventArgs>.RemoveHandler(vmProcedure2, "AsyncWorkStatusCallBack", renderControlBase.OnPreduceResultCallBackArrived);
				WeakEventManager<IVmProcedure, EventArgs>.AddHandler(vmProcedure2, "AsyncWorkStatusCallBack", renderControlBase.OnPreduceResultCallBackArrived);
			}
		}
		if (!((renderControlBase.ModuleSource as VmModuleSet)?.StrModuleName == "SolutionModule"))
		{
		}
	}

	public bool SetBackgroundImage(IVmIO io)
	{
		IVmModule owner;
		if ((owner = io.Owner) != null && ImageListDecorator != null)
		{
			foreach (ImageViewItem imageView in ImageListDecorator.ImageViewList)
			{
				if (imageView.DisplayValue == io)
				{
					ImageListDecorator.SelectedImage = imageView;
					return true;
				}
			}
		}
		return false;
	}

	public RenderControlBase()
	{
		InitializeComponent();
		CurrentUIHelper.Instance.Dispatcher.Invoke(() =>
		{
		});
		Loaded += RenderControlBase_Loaded;
		Unloaded += RenderControlBase_Unloaded;
		imageTransparencyList.Add(new TransparencyData
		{
			ImageTransparency = 191,
			ZIndex = 100,
			IsUsed = false
		});
		imageTransparencyList.Add(new TransparencyData
		{
			ImageTransparency = 127,
			ZIndex = 101,
			IsUsed = false
		});
		imageTransparencyList.Add(new TransparencyData
		{
			ImageTransparency = 63,
			ZIndex = 102,
			IsUsed = false
		});
	}

	private void RenderControlBase_Loaded(object sender, RoutedEventArgs e)
	{
		imageView.IsDisplayPixelAuto = true;
		ImageViewBox imageViewBox = imageView;
		imageViewBox.OnSetImageEnd = (ImageViewBox.SetImageEnd)Delegate.Remove(imageViewBox.OnSetImageEnd, new ImageViewBox.SetImageEnd(imageView_OnSetImageEnd));
		ImageViewBox imageViewBox2 = imageView;
		imageViewBox2.OnSetImageEnd = (ImageViewBox.SetImageEnd)Delegate.Combine(imageViewBox2.OnSetImageEnd, new ImageViewBox.SetImageEnd(imageView_OnSetImageEnd));
		ImageViewBox imageViewBox3 = imageView;
		imageViewBox3.OnFreshExtendContent = (ImageViewBox.FreshExtendContent)Delegate.Remove(imageViewBox3.OnFreshExtendContent, new ImageViewBox.FreshExtendContent(imageView_OnFreshExtendContent));
		ImageViewBox imageViewBox4 = imageView;
		imageViewBox4.OnFreshExtendContent = (ImageViewBox.FreshExtendContent)Delegate.Combine(imageViewBox4.OnFreshExtendContent, new ImageViewBox.FreshExtendContent(imageView_OnFreshExtendContent));
		if (!Resources.MergedDictionaries.Contains((ResourceDictionary)(object)LocalizationResourceDictionary.Instance))
		{
			Resources.MergedDictionaries.Add((ResourceDictionary)(object)LocalizationResourceDictionary.Instance);
		}
	}

	private void RenderControlBase_Unloaded(object sender, RoutedEventArgs e)
	{
		ImageViewBox imageViewBox = imageView;
		imageViewBox.OnSetImageEnd = (ImageViewBox.SetImageEnd)Delegate.Remove(imageViewBox.OnSetImageEnd, new ImageViewBox.SetImageEnd(imageView_OnSetImageEnd));
		ImageViewBox imageViewBox2 = imageView;
		imageViewBox2.OnFreshExtendContent = (ImageViewBox.FreshExtendContent)Delegate.Remove(imageViewBox2.OnFreshExtendContent, new ImageViewBox.FreshExtendContent(imageView_OnFreshExtendContent));
	}

	private void InitRenderControl(IVmModule newModule)
	{
		ModuleParams = VmSolution.Instance[(ModuleSource as IVmFullPath).FullPath + ".[Display]"] as ParamRoot;
		ImageListDecorator = new DisplayImageListDecorator
		{
			DecorateSource = ModuleSource,
			ParentUI = this
		};
		if (ModuleParams == null || ImageListDecorator == null)
		{
			return;
		}
		IList<object> displayList = ModuleParams.GetDisplayList();
		if (displayList != null)
		{
			CollectionChangedEventManager.AddHandler(displayList as INotifyCollectionChanged, shapes_CollectionChanged);
			foreach (Apps.XmlParser.Object item in displayList)
			{
				if (item.Type != "image" && item.Type != "pixelinfoimage")
				{
					item.SetOutputFilter();
					WeakEventManager<Apps.XmlParser.Object, EventArgs>.AddHandler(item, "ValueChanged", P_ValueChanged);
				}
			}
		}
		ExecuteCount = newModule.ExecuteCount;
		ImageListDecorator.RefreshImageList();
	}

	private void shapes_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
	{
		if (e.Action == NotifyCollectionChangedAction.Add)
		{
			foreach (DynamicObject item in e.NewItems.OfType<DynamicObject>())
			{
				ImageListDecorator?.RefreshImageList();
				WeakEventManager<DynamicObject, EventArgs>.AddHandler(item, "ValueChanged", P_ValueChanged);
				WeakEventManager<DynamicObject, EventArgs>.AddHandler(item, "MappingChanged", Shape_MappingChanged);
			}
			return;
		}
		if (e.Action != NotifyCollectionChangedAction.Remove)
		{
			return;
		}
		foreach (DynamicObject item2 in e.OldItems.OfType<DynamicObject>())
		{
			ImageListDecorator?.RefreshImageList();
			WeakEventManager<DynamicObject, EventArgs>.RemoveHandler(item2, "ValueChanged", P_ValueChanged);
			WeakEventManager<DynamicObject, EventArgs>.RemoveHandler(item2, "MappingChanged", Shape_MappingChanged);
		}
	}

	private void Shape_MappingChanged(object sender, EventArgs e)
	{
		DynamicObject source = sender as DynamicObject;
		WeakEventManager<DynamicObject, EventArgs>.RemoveHandler(source, "ValueChanged", P_ValueChanged);
		WeakEventManager<DynamicObject, EventArgs>.AddHandler(source, "ValueChanged", P_ValueChanged);
	}

	private void DeInitRenderControl(IVmModule oldModule)
	{
		if (ModuleParams != null)
		{
			IList<object> displayList = ModuleParams.GetDisplayList();
			if (displayList != null)
			{
				CollectionChangedEventManager.RemoveHandler(displayList as INotifyCollectionChanged, shapes_CollectionChanged);
				IEnumerable<DynamicObject> source = displayList.OfType<DynamicObject>();
				source.ToList().ForEach((DynamicObject p) =>
				{
					WeakEventManager<DynamicObject, EventArgs>.RemoveHandler(p, "MappingChanged", Shape_MappingChanged);
					WeakEventManager<DynamicObject, EventArgs>.RemoveHandler(p, "ValueChanged", P_ValueChanged);
				});
				foreach (Apps.XmlParser.Object item in displayList)
				{
					if (item.Type != "image" && item.Type != "pixelinfoimage")
					{
						item.RemoveOutputFilter();
						WeakEventManager<Apps.XmlParser.Object, EventArgs>.RemoveHandler(item, "ValueChanged", P_ValueChanged);
					}
				}
			}
		}
		ModuleParams = null;
		ImageListDecorator?.Dispose();
		lock (_imageslock)
		{
			tempImageStore.Clear();
		}
		lock (_shapelock)
		{
			tempShapeStore.Clear();
		}
		if (renderStatusModule != null)
		{
			WeakEventManager<IVmModule, EventArgs>.RemoveHandler(renderStatusModule, "ModuleResultCallBackArrived", RenderStatusModule_ModuleResultCallBackArrived);
			renderStatusModule.SubscribeCount--;
			renderStatusModule = null;
			renderStatus = RenderSatus.ALL;
		}
	}

	internal void P_ValueChanged(object sender, EventArgs e)
	{
		try
		{
			if (e is ValueEventArgs e2)
			{
				if (e2.ExecuteCount != ExecuteCount)
				{
					ExecuteCount = e2.ExecuteCount;
				}
				if (e2.ValueType == "image" || e2.ValueType == "pixelinfoimage")
				{
					if (!(sender is Apps.XmlParser.Object obj))
					{
						return;
					}
					lock (_imageslock)
					{
						if (ImageListDecorator?.SelectedImage?.DisplayObject == obj)
						{
							if (tempImageStore.ContainsKey("SelectedImage"))
							{
								tempImageStore["SelectedImage"] = e2.Value;
							}
							else
							{
								tempImageStore.Add("SelectedImage", e2.Value);
							}
						}
						if (ImageListDecorator?.SelectedInputImage?.DisplayObject == obj)
						{
							if (tempImageStore.ContainsKey("SelectedInputImage"))
							{
								tempImageStore["SelectedInputImage"] = e2.Value;
							}
							else
							{
								tempImageStore.Add("SelectedInputImage", e2.Value);
							}
						}
						return;
					}
				}
				Apps.XmlParser.Object obj2 = sender as Apps.XmlParser.Object;
				if (obj2 == null || !obj2.IsDisplayA)
				{
					return;
				}
				lock (_shapelock)
				{
					if (tempShapeStore.ContainsKey(sender))
					{
						tempShapeStore[sender] = e2;
					}
					else
					{
						tempShapeStore.Add(sender, e2);
					}
					return;
				}
			}
			if (e != null && !((IVmSolution)VmSolution.Instance).IsRunning)
			{
				UpdateVMResultShow();
			}
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message + ex.StackTrace);
		}
	}

	private void OnModuleResultCallBackArrived(object sender, EventArgs e)
	{
		ValueEventArgs valueEventArgs;
		if ((valueEventArgs = e as ValueEventArgs) == null)
		{
			return;
		}
		if (valueEventArgs.Value is ImvsSdkDefine.IMVS_MODULE_RESULT_INFO_LIST_EX_Data { bIsSelfExecute: 1u })
		{
			if (!needUpdateRender)
			{
				needUpdateRender = true;
				if (tempImageStore.ContainsKey("SelectedImage"))
				{
					lock (_imageslock)
					{
						tempImageStore["SelectedImage"] = null;
					}
				}
				lock (_shapelock)
				{
					tempShapeStore.Clear();
					return;
				}
			}
			Task.Run(() =>
			{
				try
				{
					uint executeCount = valueEventArgs.ExecuteCount;
					while (Apps.XmlParser.Object.GetDataSendFinishState(OwnerProcessID, executeCount))
					{
						Thread.Sleep(3);
					}
					UpdateRenderAfterSelfExecute(sender);
				}
				catch (Exception ex)
				{
					LogHelper.Error("渲染异常：" + ex.Message + ex.StackTrace);
				}
			});
		}
		Dispatcher.BeginInvoke((BeginInvokeDelegate)(() =>
		{
			ImageViewBox imageViewBox = (IsShowDoubleImage ? imageViewIn : imageView);
			if (imageViewBox.ROIVisible && !imageViewBox.IsDragROI)
			{
				UpdateRoi();
			}
		}));
	}

	private void OnPreduceResultCallBackArrived(object sender, EventArgs e)
	{
		ValueEventArgs valueEventArgs;
		if ((valueEventArgs = e as ValueEventArgs) == null || !(valueEventArgs.Value is ImvsSdkDefine.IMVS_MODULE_WORK_STAUS { nWorkStatus: 0u } iMVS_MODULE_WORK_STAUS))
		{
			return;
		}
		if (!needUpdateRender)
		{
			needUpdateRender = true;
			if (tempImageStore.ContainsKey("SelectedImage"))
			{
				lock (_imageslock)
				{
					tempImageStore["SelectedImage"] = null;
				}
			}
			lock (_shapelock)
			{
				tempShapeStore.Clear();
				return;
			}
		}
		lock (_shapelock)
		{
			List<object> list = tempShapeStore.Keys.ToList();
			foreach (object item in list)
			{
				if (tempShapeStore.ContainsKey(item) && tempShapeStore[item] is ValueEventArgs e2 && e2.ExecuteCount != iMVS_MODULE_WORK_STAUS.nExecuteCount)
				{
					tempShapeStore.Remove(item);
				}
			}
		}
		long timestamp = Stopwatch.GetTimestamp();
		if (!IsNeedRender(timestamp))
		{
			return;
		}
		oldTimeStamp = timestamp;
		Task.Run(() =>
		{
			try
			{
				uint executeCount = valueEventArgs.ExecuteCount;
				if (executeCount == 0)
				{
					UpdateImageView(null);
				}
				else
				{
					while (Apps.XmlParser.Object.GetDataSendFinishState(OwnerProcessID, executeCount))
					{
						Thread.Sleep(3);
					}
					UpdateRender(executeCount);
				}
			}
			catch (Exception ex)
			{
				LogHelper.Error("渲染异常：" + ex.Message + ex.StackTrace);
			}
		});
	}

	private void UpdateRender(uint excuteCount)
	{
		ImageData imageData = (tempImageStore.ContainsKey("SelectedImage") ? (tempImageStore["SelectedImage"] as ImageData) : null);
		if (imageData != ImageDataSource)
		{
			if (imageData == null && ImageListDecorator?.SelectedImage?.DisplayObject is Apps.XmlParser.Object obj && (obj.Owner as IVmModule)?.ExecuteCount == ExecuteCount)
			{
				imageData = obj.GetValue(uint.MaxValue) as ImageData;
			}
			if (imageData == null)
			{
				LogHelper.Debug($"VmRenderControl:UpdateRender set imageData is null,ExecuteCount = {excuteCount}");
			}
			ImageDataSource = imageData;
			if (tempImageStore.ContainsKey("SelectedImage"))
			{
				lock (_imageslock)
				{
					tempImageStore["SelectedImage"] = null;
					return;
				}
			}
			return;
		}
		if (tempImageStore.ContainsKey("SelectedInputImage"))
		{
			ImageData imageData2 = tempImageStore["SelectedInputImage"] as ImageData;
			ImageDataSourceIn = imageData2;
			lock (_imageslock)
			{
				tempImageStore.Remove("SelectedInputImage");
			}
		}
		shapeBuffer.Clear();
	}

	private void UpdateRenderAfterSelfExecute(object moduleSource)
	{
		ImageData imageData = (tempImageStore.ContainsKey("SelectedImage") ? (tempImageStore["SelectedImage"] as ImageData) : null);
		if (imageData != ImageDataSource && imageData != null)
		{
			ImageDataSource = imageData;
			lock (_imageslock)
			{
				tempImageStore.Clear();
				return;
			}
		}
		if (imageData == null && ImageListDecorator?.SelectedImage?.DisplayValue is IVmIO vmIO && vmIO.Owner == moduleSource && imageData != ImageDataSource)
		{
			ImageDataSource = imageData;
		}
		else if (ImageDataSource == null && ImageListDecorator?.SelectedImage?.DisplayObject is Apps.XmlParser.Object obj)
		{
			if (obj.GetValue(uint.MaxValue) is ImageData imageData2)
			{
				ImageDataSource = imageData2;
			}
		}
		else
		{
			Dispatcher.BeginInvoke((BeginInvokeDelegate)(() =>
			{
				UpdateShapesWithCallBackData(tempShapeStore, tempImageStore);
			}));
		}
	}

	private void imageView_OnSetImageEnd(object sender, string msg)
	{
		try
		{
			bool result = true;
			if (bool.TryParse(msg, out result) && !result)
			{
				return;
			}
			UpdateShapesWithCallBackData();
			if (IsShowDoubleImage && tempImageStore.ContainsKey("SelectedInputImage"))
			{
				ImageData imageData = tempImageStore["SelectedInputImage"] as ImageData;
				ImageDataSourceIn = imageData;
				lock (_imageslock)
				{
					tempImageStore.Remove("SelectedInputImage");
					return;
				}
			}
		}
		catch (Exception)
		{
		}
		finally
		{
		}
	}

	private void UpdateShapesWithCallBackData(Dictionary<object, object> shapeStore = null, Dictionary<string, object> imageStore = null)
	{
		Dictionary<object, object> dictionary = shapeStore ?? tempShapeStore;
		imageView.ClearExternShapes();
		ShapeList.Clear();
		bool flag = false;
		lock (_shapelock)
		{
			foreach (KeyValuePair<object, object> item in dictionary)
			{
				Apps.XmlParser.Object obj = item.Key as Apps.XmlParser.Object;
				ValueEventArgs e = item.Value as ValueEventArgs;
				List<object> shapes = e.Value as List<object>;
				DrawCurModuleUIResult(e.ValueType, shapes, obj.IsLowQuality);
				if (e.ValueType == "text")
				{
					flag = true;
				}
			}
			tempShapeStore.Clear();
			dictionary = null;
		}
		if (!flag && (ModuleParams?.GetDisplayList())?.FirstOrDefault((object p) => p is Apps.XmlParser.Object obj3 && obj3.TypeA == "text") is Apps.XmlParser.Object { IsDisplay: not false } obj2)
		{
			List<object> shapes2 = obj2.GetValue(uint.MaxValue) as List<object>;
			DrawCurModuleUIResult(obj2.Type, shapes2);
		}
		DrawShapesInShapeBuffer();
		UpdateCheckImages(imageStore);
	}

	private void DrawShapesInShapeBuffer()
	{
		try
		{
			if (shapeBuffer.Count <= 0)
			{
				return;
			}
			List<object> list = shapeBuffer.ToList();
			foreach (object item in list)
			{
				if (item is IMultiPoint multiPoint)
				{
					int count = multiPoint.MicroPoints.Count;
					if (!shapeList.Any((object p) => p is IMultiPoint))
					{
						MultiPoint multiPoint2 = new MultiPoint();
						shapeList.Add(multiPoint2);
						multiPoint2.OutlinePoints = new ObservableCollection<IOutlinePoint>();
						multiPoint2.MicroPoints = new ObservableCollection<IMicroPoint>();
						multiPoint2.Rectangles = new ObservableCollection<IRectangle>();
					}
					if (shapeList.FirstOrDefault((object p) => p is IMultiPoint) is IMultiPoint multiPoint3)
					{
						for (int num = 0; num < count; num++)
						{
							multiPoint3.MicroPoints.Add(multiPoint.MicroPoints[num]);
						}
						imageView.NeedRefreshShapes = true;
					}
				}
				else
				{
					ShapeList.Add(item);
				}
			}
		}
		catch (Exception)
		{
		}
		finally
		{
			shapeBuffer.Clear();
		}
	}

	/// <summary>
	/// 清空模块结果显示内容
	/// </summary>
	public void ClearImageView(int index = 1)
	{
		if (index == 1)
		{
			imageView.Init();
			UpdateImageView(null);
		}
		else
		{
			imageViewIn.Init();
			ImageDataSourceIn = null;
		}
	}

	/// <summary>
	/// 更新模块结果显示
	/// </summary>
	public void UpdateVMResultShow()
	{
		try
		{
			Dispatcher.Invoke(() =>
			{
				if (ModuleSource != null && ModuleParams != null)
				{
					IList<object> list = null;
					if ((list = ModuleParams.GetDisplayList()) != null)
					{
						ImageData imageData = null;
						if (ImageListDecorator?.SelectedImage != null && ImageListDecorator.SelectedImage.DisplayObject is Apps.XmlParser.Object obj)
						{
							imageData = (ImageData)obj.GetValue(uint.MaxValue);
						}
						else
						{
							foreach (Apps.XmlParser.Object item in list)
							{
								if (item.Type == "image" || item.Type == "pixelinfoimage")
								{
									imageData = (ImageData)item.GetValue(uint.MaxValue);
									break;
								}
							}
						}
						UpdateImageView(imageData);
						foreach (Apps.XmlParser.Object item2 in list)
						{
							if (item2.IsDisplay && item2.Type != "image" && item2.Type != "pixelinfoimage")
							{
								List<object> shapes = item2.GetValue(uint.MaxValue) as List<object>;
								DrawCurModuleUIResult(item2.Type, shapes, item2.IsLowQuality);
							}
						}
						DrawShapesInShapeBuffer();
						imageView.NeedRefreshShapes = true;
						UpdateCheckImages();
						ImageViewBox imageViewBox = (IsShowDoubleImage ? imageViewIn : imageView);
						if (imageViewBox.ROIVisible && !imageViewBox.IsDragROI)
						{
							UpdateRoi();
						}
					}
				}
			});
		}
		catch (Exception ex)
		{
			LogHelper.Error(ex.Message + ex.StackTrace);
		}
	}

	/// <summary>
	/// 更新图像
	/// </summary>
	/// <param name="imageData"></param>
	private void UpdateImageView(ImageData imageData)
	{
		try
		{
			imageView.ClearExternShapes();
			ShapeList.Clear();
			ImageDataSource = imageData;
		}
		catch
		{
		}
	}

	private void DrawCurModuleUIResult(string shapeType, List<object> shapes, bool isLowQuality = false)
	{
		try
		{
			if (!ShapeList.Any((object p) => p is IMultiPoint))
			{
				MultiPoint multiPoint = new MultiPoint();
				ShapeList.Add(multiPoint);
				multiPoint.OutlinePoints = new ObservableCollection<IOutlinePoint>();
				multiPoint.MicroPoints = new ObservableCollection<IMicroPoint>();
				multiPoint.Rectangles = new ObservableCollection<IRectangle>();
			}
			switch (shapeType)
			{
			case "hsilist":
				break;
			case "sampleimage":
				break;
			case "imagetitle":
				break;
			case "path":
			{
				ArrowPath arrowPath = Path.GetArrowPath(shapes);
				SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.DrawShapeHelper.DrawShapes(new List<object> { arrowPath }, ShapeList, imageView);
				SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.DrawShapeHelper.DrawShapes(shapes, ShapeList, imageView);
				break;
			}
			case "polyline":
			{
				Polyline polyline = Polyline.GetPolyline(shapes);
				SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.DrawShapeHelper.DrawShapes(new List<object> { polyline }, ShapeList, imageView);
				SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.DrawShapeHelper.DrawShapes(shapes, ShapeList, imageView);
				break;
			}
			default:
				SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.DrawShapeHelper.DrawShapes(shapes, ShapeList, imageView);
				break;
			}
		}
		catch
		{
		}
	}

	public void DrawShapes(object shape)
	{
		Dispatcher.Invoke(() =>
		{
			try
			{
				if (shape != null && imageView != null)
				{
					AddShapeToList(shape, ShapeList);
				}
			}
			catch (Exception ex)
			{
				MessageBox.Show(ex.Message);
			}
		});
	}

	public void AddShapes(object shape)
	{
		try
		{
			if (shape != null && imageView != null)
			{
				AddShapeToList(shape, shapeBuffer);
			}
		}
		catch (Exception ex)
		{
			MessageBox.Show(ex.Message);
		}
	}

	private void AddShapeToList(object shape, IList<object> shapeList)
	{
		if (shape is ICircle { Stroke: var color, Opacity: var opacity, StrokeThickness: var strokeThickness } circle)
		{
			Pretreatment(ref color, ref opacity, ref strokeThickness);
			Apps.Data.ShapeDefine.Circle circle2 = new Apps.Data.ShapeDefine.Circle();
			circle2.CenterX = (float)circle.CenterPoint.X;
			circle2.CenterY = (float)circle.CenterPoint.Y;
			circle2.MajorRadius = (float)circle.Radius;
			circle2.MinorRadius = (float)circle.Radius;
			circle2.Color = color;
			circle2.FillColor = circle.Fill;
			circle2.Opacity = opacity;
			circle2.StrokeThickness = strokeThickness;
			shapeList.Add(circle2);
		}
		else if (shape is IAnnularSector { Stroke: var color2, Opacity: var opacity2, StrokeThickness: var strokeThickness2 } annularSector)
		{
			Pretreatment(ref color2, ref opacity2, ref strokeThickness2);
			AnnularSector annularSector2 = new AnnularSector();
			annularSector2.CenterX = (float)annularSector.CenterPoint.X;
			annularSector2.CenterY = (float)annularSector.CenterPoint.Y;
			annularSector2.InnerRadius = (float)annularSector.InnerRadius;
			annularSector2.OuterRadius = (float)annularSector.OuterRadius;
			annularSector2.StartAngle = (float)annularSector.StartAngle;
			annularSector2.AngleRange = (float)annularSector.AngleRange;
			annularSector2.Color = color2;
			annularSector2.FillColor = annularSector.Fill;
			annularSector2.Opacity = opacity2;
			annularSector2.StrokeThickness = strokeThickness2;
			shapeList.Add(annularSector2);
		}
		else if (shape is IEllipse { Stroke: var color3, Opacity: var opacity3, StrokeThickness: var strokeThickness3 } ellipse)
		{
			Pretreatment(ref color3, ref opacity3, ref strokeThickness3);
			Apps.Data.ShapeDefine.Ellipse ellipse2 = new Apps.Data.ShapeDefine.Ellipse();
			ellipse2.CenterX = (float)ellipse.CenterPoint.X;
			ellipse2.CenterY = (float)ellipse.CenterPoint.Y;
			ellipse2.MajorRadius = (float)ellipse.MajorRadius;
			ellipse2.MinorRadius = (float)ellipse.MinorRadius;
			ellipse2.Angle = (float)ellipse.Angle;
			ellipse2.Color = color3;
			ellipse2.FillColor = ellipse.Fill;
			ellipse2.Opacity = opacity3;
			ellipse2.StrokeThickness = strokeThickness3;
			shapeList.Add(ellipse2);
		}
		else if (shape is IText { Stroke: var color4, Opacity: var opacity4 } text)
		{
			double strokeThickness4 = 1.0;
			Pretreatment(ref color4, ref opacity4, ref strokeThickness4);
			Text text2 = new Text();
			text2.PositionX = (float)text.Position.X;
			text2.PositionY = (float)text.Position.Y;
			text2.Content = text.Content;
			text2.FontSize = ((text.FontSize == 0) ? 10 : text.FontSize);
			text2.Color = color4;
			text2.Opacity = opacity4;
			text2.StrokeThickness = strokeThickness4;
			List<object> list = new List<object>();
			list.Add(text2);
			object item = SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape.DrawShapeHelper.PretreatTexts(list);
			shapeList.Add(item);
		}
		else if (shape is ILine { Stroke: var color5, Opacity: var opacity5, StrokeThickness: var strokeThickness5 } line)
		{
			Pretreatment(ref color5, ref opacity5, ref strokeThickness5);
			Apps.Data.ShapeDefine.Line line2 = new Apps.Data.ShapeDefine.Line();
			line2.StartLineX = (float)line.StartPoint.X;
			line2.StartLineY = (float)line.StartPoint.Y;
			line2.EndLineX = (float)line.EndPoint.X;
			line2.EndLineY = (float)line.EndPoint.Y;
			line2.Color = color5;
			line2.FillColor = line.Fill;
			line2.Opacity = opacity5;
			line2.StrokeThickness = strokeThickness5;
			line2.IsThroughLine = line.IsThroughLine;
			shapeList.Add(line2);
		}
		else if (shape is IRectangle { Stroke: var color6, Opacity: var opacity6, StrokeThickness: var strokeThickness6 } rectangle)
		{
			Pretreatment(ref color6, ref opacity6, ref strokeThickness6);
			Apps.Data.ShapeDefine.Rect rect = new Apps.Data.ShapeDefine.Rect();
			rect.Width = (float)rectangle.Width;
			rect.Height = (float)rectangle.Height;
			rect.Angle = (float)rectangle.Angle;
			rect.SkewAngleX = (float)rectangle.SkewAngleX;
			rect.CenterX = (float)rectangle.CenterPoint.X;
			rect.CenterY = (float)rectangle.CenterPoint.Y;
			rect.Color = color6;
			rect.FillColor = rectangle.Fill;
			rect.Opacity = opacity6;
			rect.StrokeThickness = strokeThickness6;
			shapeList.Add(rect);
		}
		else if (shape is IPoint { Stroke: var color7, Opacity: var opacity7, StrokeThickness: var strokeThickness7 } point)
		{
			Pretreatment(ref color7, ref opacity7, ref strokeThickness7);
			Apps.Data.ShapeDefine.Point point2 = new Apps.Data.ShapeDefine.Point();
			point2.CenterX = (float)point.Point.X;
			point2.CenterY = (float)point.Point.Y;
			point2.Color = color7;
			point2.FillColor = point.Fill;
			point2.Opacity = opacity7;
			point2.StrokeThickness = strokeThickness7;
			shapeList.Add(point2);
		}
		else if (shape is IPointSet pointSet)
		{
			DrawPointSet(shapeList, pointSet);
		}
		else if (shape is IOutlinePoint outlinePoint)
		{
			DrawOutlinePoint(shapeList, outlinePoint);
		}
		else if (shape is IPolygon { Stroke: var color8, Opacity: var opacity8, StrokeThickness: var strokeThickness8 } polygon)
		{
			Pretreatment(ref color8, ref opacity8, ref strokeThickness8);
			Apps.Data.ShapeDefine.Polygon polygon2 = new Apps.Data.ShapeDefine.Polygon();
			if (polygon.Points != null)
			{
				foreach (System.Windows.Point point3 in polygon.Points)
				{
					polygon2.PolygonPoints.Add(point3);
				}
				polygon2.Color = color8;
				polygon2.FillColor = polygon.Fill;
				polygon2.Opacity = opacity8;
				polygon2.StrokeThickness = strokeThickness8;
			}
			shapeList.Add(polygon2);
		}
		else if (shape is IPolyline polyline)
		{
			DrawPolyline(shapeList, polyline);
		}
	}

	private void Pretreatment(ref string color, ref double opacity, ref double strokeThickness)
	{
		if (color == null)
		{
			color = "#" + VMColors.Green.ToString("X");
		}
		if (opacity == 0.0)
		{
			opacity = 1.0;
		}
		if (strokeThickness == 0.0)
		{
			strokeThickness = 1.0;
		}
	}

	public void DrawCppShapes(object shape, bool isAddShape)
	{
		try
		{
			object obj = new object();
			obj = ThirdDataConvert(shape);
			if (isAddShape)
			{
				AddShapes(obj);
			}
			else
			{
				DrawShapes(obj);
			}
		}
		catch (Exception)
		{
			throw;
		}
	}

	/// <summary>
	/// 获取基础句柄
	/// </summary>
	/// <returns></returns>
	public long GetBaseHandle()
	{
		TempVmSolution.Init();
		return (long)VmSolution.Instance.BaseHandle;
	}

	/// <summary>
	/// 根据渲染控件绑定ID
	/// </summary>
	/// <returns></returns>
	public void BindRenderById(uint Id)
	{
		Dispatcher.Invoke(() =>
		{
			VmModule moduleByID = VmSolution.Instance.GetModuleByID(Id);
			if (moduleByID != null)
			{
				ModuleSource = moduleByID;
			}
		});
	}

	private object ThirdDataConvert(object objInput)
	{
		try
		{
			if (objInput is PointSetIn)
			{
				PointSetEx pointSetEx = new PointSetEx
				{
					PointList = new List<System.Windows.Point>()
				};
				PointSetIn pointSetIn = (PointSetIn)objInput;
				pointSetEx.Stroke = pointSetIn.Color;
				pointSetEx.Fill = pointSetIn.FillColor;
				pointSetEx.Opacity = pointSetIn.Opacity;
				pointSetEx.StrokeThickness = pointSetIn.StrokeThickness;
				pointSetEx.PointNum = pointSetIn.PointNum;
				PointEx[] array = new PointEx[pointSetIn.PointNum];
				array = ExternalCallHelper.IntPtr2Structures<PointEx>(pointSetIn.PointListPtr, pointSetIn.PointNum);
				for (int i = 0; i < pointSetIn.PointNum; i++)
				{
					pointSetEx.PointList.Add(((IPoint)array[i]).Point);
				}
				return pointSetEx;
			}
			if (objInput is PointSetInOld)
			{
				PointSetEx pointSetEx2 = new PointSetEx
				{
					PointList = new List<System.Windows.Point>()
				};
				PointSetInOld pointSetInOld = (PointSetInOld)objInput;
				pointSetEx2.Stroke = "#" + pointSetInOld.Color.ToString("X6");
				pointSetEx2.Fill = "#" + pointSetInOld.FillColor.ToString("X8");
				pointSetEx2.Opacity = pointSetInOld.Opacity;
				pointSetEx2.StrokeThickness = pointSetInOld.StrokeThickness;
				pointSetEx2.PointNum = pointSetInOld.PointNum;
				PointExOld[] array2 = new PointExOld[pointSetInOld.PointNum];
				PointEx[] array3 = new PointEx[pointSetInOld.PointNum];
				array2 = ExternalCallHelper.IntPtr2Structures<PointExOld>(pointSetInOld.PointListPtr, pointSetInOld.PointNum);
				for (int j = 0; j < pointSetInOld.PointNum; j++)
				{
					array3[j].CenterX = array2[j].CenterX;
					array3[j].CenterY = array2[j].CenterY;
					array3[j].StrokeThickness = array2[j].StrokeThickness;
					array3[j].Opacity = array2[j].Opacity;
