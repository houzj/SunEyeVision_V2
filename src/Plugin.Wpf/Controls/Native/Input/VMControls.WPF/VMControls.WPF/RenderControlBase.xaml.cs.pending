	/// <summary>
	/// 获取可显示的图像名称列表
	/// </summary>
	public List<string> GetDisplayableImageNameList()
	{
		return ImageListDecorator?.ImageViewList?.Select((ImageViewItem p) => p.DisplayName).ToList() ?? new List<string>();
	}

	/// <summary>
	/// 设置图像显示
	/// </summary>
	/// <param name="displayImageName">显示的图像名称</param>
	public void SetSelectedImage(string displayImageName)
	{
		if (string.IsNullOrEmpty(displayImageName))
		{
			throw new VmException(-536870911);
		}
		ImageViewItem imageViewItem = ImageListDecorator?.ImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayName == displayImageName);
		if (imageViewItem == null)
		{
			throw new VmException(-536870911);
		}
		ImageListDecorator.SelectedImage = imageViewItem;
	}

	public void AddStackImage(string displayImageName)
	{
		Dispatcher.Invoke(() =>
		{
			if (!string.IsNullOrEmpty(displayImageName))
			{
				DisplayImageListDecorator displayImageListDecorator = ImageListDecorator;
				if (displayImageListDecorator == null || displayImageListDecorator.ImageViewList.Count((ImageViewItem p) => p.IsCheck) != 4)
				{
					ImageViewItem imageViewItem = ImageListDecorator?.ImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayName == displayImageName);
					if (imageViewItem == null || imageViewItem.IsCheck)
					{
						throw new VmException(-536870911);
					}
					imageViewItem.IsCheck = true;
					ImageListDecorator?.TriggerSelectImageChange(imageViewItem);
					return;
				}
			}
			throw new VmException(-536870911);
		});
	}

	/// <summary>
	/// 移除堆叠显示的图像
	/// </summary>
	/// <param name="displayImageName">图像名称</param>
	public void RemoveStackImage(string displayImageName)
	{
		Dispatcher.Invoke(() =>
		{
			if (!string.IsNullOrEmpty(displayImageName))
			{
				DisplayImageListDecorator displayImageListDecorator = ImageListDecorator;
				if (displayImageListDecorator == null || displayImageListDecorator.ImageViewList.Count((ImageViewItem p) => p.IsBackgroundImage) != 0)
				{
					ImageViewItem imageViewItem = ImageListDecorator?.ImageViewList.FirstOrDefault((ImageViewItem p) => p.IsBackgroundImage);
					if (imageViewItem != null && imageViewItem.DisplayName == displayImageName && ImageListDecorator.ImageViewList.Count((ImageViewItem p) => p.IsCheck) == 0)
					{
						throw new VmException(-536870911);
					}
					ImageViewItem imageViewItem2 = ImageListDecorator?.ImageViewList.FirstOrDefault((ImageViewItem p) => p.DisplayName == displayImageName);
					if (imageViewItem2 == null || !imageViewItem2.IsCheck)
					{
						throw new VmException(-536870911);
					}
					imageViewItem2.IsCheck = false;
					ImageListDecorator?.TriggerSelectImageChange(imageViewItem2);
					return;
				}
			}
			throw new VmException(-536870911);
		});
	}
}
