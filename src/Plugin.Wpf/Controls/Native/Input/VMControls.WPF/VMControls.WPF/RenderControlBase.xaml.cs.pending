	/// <summary>
	/// 保存原图，jpgQuality范围[1,100]
	/// </summary>
	public void SaveOriginalImage(string fileName, int index = 1, int jpgQuality = 95)
	{
		try
		{
			if (!(((index == 1) ? ImageDataSource : ImageDataSourceIn) is ImageData imageData))
			{
				MessageBox.Show(AppLocalizationService.GetLang("NoImageData"));
				return;
			}
			if (jpgQuality <= 0 || jpgQuality > 100)
			{
				throw new VmException(-536870911);
			}
			ImageSaveOpenCvHelper.SaveRawImageSyn(fileName, imageData, jpgQuality);
		}
		catch (VmException ex)
		{
			throw ex;
		}
		catch (Exception ex2)
		{
			MessageBox.Show(ex2.Message);
		}
	}

	/// <summary>
	/// 保存渲染图，jpgQuality范围[1,100]
	/// </summary>
	public void SaveRenderedImage(string fileName, int jpgQuality = 95)
	{
		try
		{
			ImageData imageData = ImageDataSource as ImageData;
			List<object> shapesSource = new List<object>(ShapeList);
			if (imageData == null)
			{
				MessageBox.Show(AppLocalizationService.GetLang("NoImageData"));
				return;
			}
			if (jpgQuality <= 0 || jpgQuality > 100)
			{
				throw new VmException(-536870911);
			}
			ImageSaveOpenCvHelper.SaveRoiImageSyn(fileName, imageData, shapesSource, null, jpgQuality);
		}
		catch (VmException ex)
		{
			throw ex;
		}
		catch (Exception ex2)
		{
			MessageBox.Show(ex2.Message);
		}
	}

	/// <summary>
	/// 设置控件背景
	/// 参数为尺寸小于100*100的图像绝对路径或#+16进制数表示的颜色字符串
	/// </summary>
	/// <param name="value">尺寸小于100*100的图像绝对路径或#+16进制数表示的颜色字符串</param>
	public void SetBackground(string value)
	{
		Dispatcher?.Invoke(() =>
		{
