<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.ToolBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF" xmlns:user="clr-namespace:VM.User;assembly=VM.User" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:UIHelper="clr-namespace:Apps.UIHelper.Extern;assembly=Apps.UIHelper" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" x:Name="us" AllowDrop="True" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_1:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
        <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/Apps.Style;component/ScrollBarStyle/RecScrollBarStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="btv" />
      <Style x:Key="ToolItemGridStyle" TargetType="{x:Type base:ToolItemGrid}">
        <Setter Property="base:ToolItemGrid.ModuleDir" Value="{Binding DirPath}" />
        <Setter Property="base:ToolItemGrid.ModuleTypeName" Value="{Binding Info}" />
        <Setter Property="base:ToolItemGrid.DisplayType" Value="{Binding DisplayType}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource btv}}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{vm_port_0_:ResourceBinding ToolTip}" />
        <Setter Property="FrameworkElement.Cursor" Value="SizeAll" />
      </Style>
      <Style x:Key="ExpanderDownHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource TitleColor}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid Background="#00FFFFFF">
                <Grid.RowDefinitions>
                  <RowDefinition Height="36" />
                  <RowDefinition Height="2" />
                </Grid.RowDefinitions>
                <Grid Row="0" Height="36">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0" Grid.Column="0" HorizontalAlignment="Left" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                  <Image Name="ImageBackground" Margin="0,0,16,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Grid.Column="1" Stretch="None" HorizontalAlignment="Right" Source="/Apps.Style;component/Resources/modal_右箭头_normal.png">
                    <UIElement.RenderTransform>
                      <ScaleTransform ScaleX="1" />
                    </UIElement.RenderTransform>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Image}">
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Value="True" Binding="{Binding IsNeuLayout, ElementName=us}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                              <Setter Property="RenderTransform">
                                <Setter.Value>
                                  <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                              </Setter>
                            </MultiDataTrigger.Setters>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Image>
                </Grid>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.Style;component/Resources/modal_fold_normal.png" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True" />
                <Trigger Property="IsPressed" Value="True" />
                <Trigger Property="IsEnabled" Value="False" />
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderHeaderFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border>
                <Rectangle Margin="0" SnapsToDevicePixels="True" Stroke="#FF000000" StrokeThickness="1" StrokeDashArray="1 2" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderStyle1" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource TitleColor}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Expander}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" CornerRadius="3" SnapsToDevicePixels="True">
                <StackPanel Orientation="Vertical">
                  <ToggleButton Name="HeaderSite" ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderedContentControl.HeaderTemplateSelector}" Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top" Foreground="{TemplateBinding Control.Foreground}" FontWeight="{TemplateBinding Control.FontWeight}" FontStyle="{TemplateBinding Control.FontStyle}" FontStretch="{TemplateBinding Control.FontStretch}" FontSize="{TemplateBinding Control.FontSize}" FontFamily="{TemplateBinding Control.FontFamily}" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="1" MinWidth="0" MinHeight="0" Padding="{TemplateBinding Control.Padding}" VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}" Style="{StaticResource ExpanderDownHeaderStyle}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter Name="ExpandSite" DockPanel.Dock="Bottom" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" Visibility="Collapsed" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                  <Rectangle Height="2" Width="208" Fill="{DynamicResource Col_Toolbar_Expand_Split}" StrokeThickness="0" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Expander.IsExpanded" Value="True">
                  <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="FoldGroupItemTemplate" TargetType="{x:Type GroupItem}">
        <Grid Name="btn" local:IsMouseEnterBehavior.IsMouseLeave="True">
          <Border Name="back" Width="51" Height="48" BorderThickness="0,1,1,1" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource Col_Toolbar_Modular_BorderBrush}" Background="{DynamicResource Col_Toolbar_Selected_Backgound}" Visibility="{Binding Visibility, ElementName=line}" />
          <Grid Width="52" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Height="{Binding Name.ImageEnableSourceHeight}" Width="{Binding Name.ImageEnableSourceWidth}">
              <Image Name="fore" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding Name.ImageEnablePath}" />
            </Grid>
          </Grid>
          <Rectangle Name="line" SnapsToDevicePixels="True" Width="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="{DynamicResource Col_Toolbar_Modular_RectStroke}" Stretch="Fill" Visibility="Collapsed" />
          <Popup Name="Popup" IsOpen="{TemplateBinding UIElement.IsMouseOver}" AllowsTransparency="True" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToolBox}}" Placement="{Binding placementMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToolBox}}">
            <Grid Width="235" Background="#02FFFFFF">
              <Border Margin="6,8,8,8" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Col_Toolbar_Popup_BorderBrush}" Background="{DynamicResource Col_Toolbar_Popup_Background}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="7" Direction="305" Opacity="0.39" ShadowDepth="3" Color="Black" />
                </UIElement.Effect>
                <Grid Margin="0,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Margin="12,0,0,0">
                    <Rectangle Width="2" Height="15" StrokeThickness="1" Stroke="{DynamicResource Col_Toolbar_PopupTile_Line}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                    <TextBlock FontSize="16" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap" Foreground="{DynamicResource Col_Toolbar_PopupTile_Foreground}" Margin="10,0,0,0" Text="{vm_port_0_:ResourceBinding Name.Name, Mode=OneWay}" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" Style="{StaticResource RecScrollViewer}">
                    <StackPanel>
                      <ItemsPresenter />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Margin="6,8,8,8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Popup.BorderBrush}">
                <Rectangle Height="1" Fill="#FFFFFFFF" Opacity="0.1" VerticalAlignment="Top" Margin="1,0" StrokeThickness="2" />
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="3" Direction="280" Opacity="0.09" ShadowDepth="2" Color="Orange" />
                </UIElement.Effect>
              </Border>
            </Grid>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="fore" Property="Image.Source" Value="{Binding Name.ImageHoverPath}" />
            <Setter TargetName="line" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
          <Trigger SourceName="btn" Property="local:IsMouseEnterBehavior.IsMouseLeave" Value="False">
            <Setter TargetName="Popup" Property="Popup.IsOpen" Value="True" />
          </Trigger>
          <DataTrigger Value="False" Binding="{Binding IsMouseOver, ElementName=us}">
            <Setter TargetName="Popup" Property="Popup.IsOpen" Value="False" />
          </DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <ControlTemplate x:Key="unFoldGroupItemTemplate" TargetType="{x:Type GroupItem}">
        <Expander Style="{StaticResource ExpanderStyle1}">
          <HeaderedContentControl.Header>
            <TextBlock FontSize="14" FontWeight="Normal" Foreground="{DynamicResource Col_Toolbar_Expand_Foreground}" Text="{vm_port_0_:ResourceBinding Name.Name}" />
          </HeaderedContentControl.Header>
          <StackPanel Orientation="Vertical">
            <ItemsPresenter Margin="9,-9,0,0" />
          </StackPanel>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="Expanded">
              <i:InvokeCommandAction Command="{Binding ViewData.ExpandCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToolBox}}" CommandParameter="{Binding}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Expander>
      </ControlTemplate>
      <Style x:Key="toolBoxFoldGroupItemStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template" Value="{StaticResource FoldGroupItemTemplate}" />
        <Style.Triggers>
          <DataTrigger Value="true" Binding="{Binding UnFoldSwitch, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToolBox}}">
            <Setter Property="Width" Value="230" />
            <Setter Property="Template" Value="{StaticResource unFoldGroupItemTemplate}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <GroupStyle x:Key="myFoldGroupStyle" ContainerStyle="{StaticResource ResourceKey=toolBoxFoldGroupItemStyle}" />
      <DataTemplate x:Key="FoldItemTemplate">
        <base:ToolItemGrid x:Name="ct" Width="68" Height="90" Style="{StaticResource ToolItemGridStyle}">
          <Grid Name="InfoGrid" Margin="0,7,0,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="4" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Name="bofore" CornerRadius="2" BorderThickness="1" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="3" Width="64" VerticalAlignment="Top" BorderBrush="{DynamicResource Col_Toolbar_PopupModular_Selected_BorderBrush}" Background="{DynamicResource Col_Toolbar_PopupModular_Selected_Background}" Height="{Binding ElementName=InfoGrid, Path=ActualHeight}">
              <Rectangle Height="1" Fill="#FFFFFFFF" Opacity="0.40" VerticalAlignment="Top" Margin="1,0" StrokeThickness="2" />
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="2" Direction="270" ShadowDepth="3" Color="Black" Opacity="0.35" />
              </UIElement.Effect>
            </Border>
            <Image Name="bg" Grid.Row="0" Margin="0,5,0,0" Width="36" Height="36" Source="{Binding ImageEnablePath}" />
            <TextBlock x:XmlAttributeProperties.XmlSpace="preserve" Name="tx" Height="35" Grid.Row="2" VerticalAlignment="Top" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Col_Toolbar_PopupModular_Selected_ForeBackground}" TextTrimming="CharacterEllipsis" Text="{vm_port_0_:ResourceBinding Name}" />
          </Grid>
        </base:ToolItemGrid>
        <DataTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="bofore" Property="UIElement.Visibility" Value="Visible" />
            <Setter Value="{DynamicResource Col_Toolbar_PopupModular_Selected_ForeBackground}" TargetName="tx" Property="TextBlock.Foreground" />
          </Trigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True" Binding="{Binding IsGroupTool}" />
              <Condition Value="True" Binding="{Binding UnFoldSwitch, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToolBox}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="FrameworkElement.ContextMenu">
              <Setter.Value>
                <vm_port_0:HikContextMenu>
                  <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteItemCommand}" />
                </vm_port_0:HikContextMenu>
              </Setter.Value>
            </Setter>
          </MultiDataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="GlobleItemTemplate">
        <base:ToolItemGrid Style="{StaticResource ToolItemGridStyle}">
          <Border Name="back" Width="51" Height="48" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource Col_Toolbar_Modular_BorderBrush}" Background="{DynamicResource Col_Toolbar_Selected_Backgound}" Visibility="{Binding Visibility, ElementName=line}" />
          <Grid Width="52" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Height="{Binding ImageEnableSourceHeight}" Width="{Binding ImageEnableSourceWidth}">
              <Image Name="fore" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding ImageEnablePath}" />
            </Grid>
          </Grid>
          <Rectangle Name="line" SnapsToDevicePixels="True" Width="1.5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Stroke="{DynamicResource Col_Toolbar_Modular_RectStroke}" Stretch="Fill" Visibility="Collapsed" />
        </base:ToolItemGrid>
        <DataTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="fore" Property="Image.Source" Value="{Binding ImageHoverPath}" />
            <Setter TargetName="line" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Background="{DynamicResource Col_Toolbar_Backgound}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <CollectionViewSource x:Key="src" IsLiveGroupingRequested="True" Source="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}">
              <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
              </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ItemsControl Name="ToolItems" IsEnabled="{Binding IsAdmin, Source={x:Static user:CodeManager.Instance}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ItemsControl}">
              <Setter Property="ItemsSource" Value="{Binding Source={StaticResource src}}" />
              <Setter Property="ItemTemplate" Value="{StaticResource FoldItemTemplate}" />
              <Setter Property="Margin" Value="0,12,0,0" />
              <Setter Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="250" Margin="0,6,0,0" />
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ItemsControl}">
                    <ScrollViewer Name="m_VerScroll" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                      <FrameworkElement.Resources>
                        <ResourceDictionary>
                          <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
                            <Grid Name="Bg" SnapsToDevicePixels="True" Width="2">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="5" />
                                <RowDefinition Height="0.00001*" />
                                <RowDefinition Height="5" />
                              </Grid.RowDefinitions>
                              <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Style="{StaticResource ScrollBarLineButton}" />
                              <Track Name="PART_Track" Grid.Row="1" IsEnabled="{TemplateBinding UIElement.IsMouseOver}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarPageButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                  <Thumb Tag="{TemplateBinding FrameworkElement.Tag}">
                                    <Control.Template>
                                      <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Rectangle Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" RadiusX="1" RadiusY="1" Fill="#595A5C" />
                                      </ControlTemplate>
                                    </Control.Template>
                                  </Thumb>
                                </Track.Thumb>
                              </Track>
                              <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource ScrollBarLineButton}" />
                            </Grid>
                          </ControlTemplate>
                          <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
                            <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
                            <Style.Triggers>
                              <Trigger Property="ScrollBar.Orientation" Value="Vertical">
                                <Setter Property="Width" Value="10" />
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="{x:Type ScrollViewer}" TargetType="{x:Type ScrollViewer}">
                            <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                  <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                                    <Grid Background="#00FFFFFF" Margin="0">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>
                                      <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <ScrollContentPresenter Grid.Column="0" Cursor="{TemplateBinding FrameworkElement.Cursor}" Margin="{TemplateBinding Control.Padding}" Grid.ColumnSpan="2" Grid.RowSpan="1" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
                                      <ScrollBar Name="PART_VerticalScrollBar" Tag="2" Background="#00FFFFFF" Orientation="Vertical" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,-2,0" Value="{TemplateBinding ScrollViewer.VerticalOffset}" Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}" ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}" Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}" />
                                      <ScrollBar Name="PART_HorizontalScrollBar" Background="#00FFFFFF" Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,0,0,3" Value="{TemplateBinding ScrollViewer.HorizontalOffset}" Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}" ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}" Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}" />
                                    </Grid>
                                  </Border>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ResourceDictionary>
                      </FrameworkElement.Resources>
                      <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                    </ScrollViewer>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding UnFoldSwitch, RelativeSource={RelativeSource TemplatedParent}}">
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" Width="250" Margin="0,6,0,6" />
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="Margin" Value="0,4,0,0" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsGlobleMode, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                  <Setter Property="ItemsSource" Value="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Setter Property="ItemTemplate" Value="{StaticResource GlobleItemTemplate}" />
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Top" />
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <ItemsControl.GroupStyle>
            <StaticResourceExtension ResourceKey="myFoldGroupStyle" />
          </ItemsControl.GroupStyle>
        </ItemsControl>
        <ToggleButton Name="switchButton" Grid.Row="1" HorizontalAlignment="Stretch" Height="22" IsChecked="{Binding UnFoldSwitch, RelativeSource={RelativeSource TemplatedParent}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ToggleButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="{DynamicResource Col_Toolbar_BottomExpand_Backgound}">
                      <Image Name="fore" HorizontalAlignment="Right" Stretch="None" Source="/Apps.Style;component/Resources/toolbarTriangleOpen_Normal.png" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="fore" Property="Image.Source" Value="/Apps.Style;component/Resources/toolbarTriangleOpen_Click.png" />
                      </Trigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Value="False" Binding="{Binding IsNeuLayout, RelativeSource={RelativeSource TemplatedParent}}" />
                          <Condition Value="True" Binding="{Binding UnFoldSwitch, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                          <Setter TargetName="fore" Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
                          <Setter TargetName="fore" Property="RenderTransform">
                            <Setter.Value>
                              <ScaleTransform ScaleX="-1" />
                            </Setter.Value>
                          </Setter>
                        </MultiDataTrigger.Setters>
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Value="True" Binding="{Binding IsNeuLayout, RelativeSource={RelativeSource TemplatedParent}}" />
                          <Condition Value="False" Binding="{Binding UnFoldSwitch, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                          <Setter TargetName="fore" Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
                          <Setter TargetName="fore" Property="RenderTransform">
                            <Setter.Value>
                              <ScaleTransform ScaleX="-1" />
                            </Setter.Value>
                          </Setter>
                        </MultiDataTrigger.Setters>
                      </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ToggleButton>
        <Border BorderThickness="0,0,1,0" BorderBrush="#FF000000" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Value="True" Binding="{Binding IsGlobleMode, RelativeSource={RelativeSource Mode=Self}}">
          <Setter TargetName="switchButton" Property="UIElement.Visibility" Value="Collapsed" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Control>