	private void Init()
	{
		toolData.FunctionExecuteEvent -= ToolData_FunctionExecuteEvent;
		toolData.FunctionExecuteEvent += ToolData_FunctionExecuteEvent;
		VmSolution.RestoreDefaultDisplay -= VmSolution_RestoreDefaultDisplay;
		VmSolution.RestoreDefaultDisplay += VmSolution_RestoreDefaultDisplay;
		VmSolution.OnGlobalScriptReportCallBack -= VmSolution_OnGlobalSciptReportData;
		VmSolution.OnGlobalScriptReportCallBack += VmSolution_OnGlobalSciptReportData;
		VmSolution.OnProcessImportEndCallBack -= VmSolution_OnProcessImportEndCallBack;
		VmSolution.OnProcessImportEndCallBack += VmSolution_OnProcessImportEndCallBack;
		if (toolData.DecorateSource is List<GlobalToolDataItem> list)
		{
			ItemsSource = new ObservableCollection<GlobalToolDataItem>(list);
			GlobalToolDataItem value = list.FirstOrDefault((GlobalToolDataItem t) => t.Name == "Lang_ControllerSet");
			ItemsSource.Remove(value);
		}
		VmSolution.OnSolutionLoadEndCallBack -= VmSolution_OnSolutionLoadEndCallBack;
		VmSolution.OnSolutionLoadEndCallBack += VmSolution_OnSolutionLoadEndCallBack;
		toolData.Init();
	}

	private void VmSolution_OnSolutionLoadEndCallBack(object sender, EndEventArgs args)
	{
		if (args == null || args.ErrorCode != 0)
		{
			return;
		}
		Dispatcher?.Invoke(() =>
		{
			VmModule vmModule = VmSolution.Instance.Modules.FirstOrDefault((VmModule m) => m.ID == 14000);
			if (toolData.DecorateSource is List<GlobalToolDataItem> source)
			{
				GlobalToolDataItem globalToolDataItem = source.FirstOrDefault((GlobalToolDataItem t) => t.Name == "Lang_ControllerSet");
				if (globalToolDataItem != null)
				{
					if (vmModule == null)
					{
						ItemsSource.Remove(globalToolDataItem);
					}
					else if (!ItemsSource.Contains(globalToolDataItem))
					{
						ItemsSource.Add(globalToolDataItem);
					}
				}
			}
		});
	}

	private void VmSolution_RestoreDefaultDisplay(object sender, EventArgs e)
	{
		Dispatcher?.Invoke(() =>
		{
			try
			{
				GlobalCommunicationMgr.Instance.CloseComm();
				GlobalCommunicationMgr.Instance.IsGet = false;
				globalCommunication?.Close();
				globalCommunication = null;
				GlobalCameraManager.Instance.CloseCamera();
				globalScriptWindow?.Close();
				globalScriptWindow = null;
			}
			catch (Exception ex)
			{
				Apps.Log.LogHelper.Error("VmSolution_InstanceChanged exception:" + ex.ToString());
			}
		});
	}

	private void VmSolution_OnProcessImportEndCallBack(object sender, EndEventArgs args)
	{
		Dispatcher?.BeginInvoke((Action)(() =>
		{
			try
			{
				if (GlobalCommunicationMgr.Instance.IsGet)
				{
					GlobalCommunicationMgr.Instance.ClearAll();
					GlobalCommunicationMgr.Instance.IsGet = false;
				}
				globalCommunication?.Close();
				globalCommunication = null;
				GlobalCameraManager.Instance.CloseCamera();
				globalScriptWindow?.Close();
				globalScriptWindow = null;
			}
			catch (Exception ex)
			{
				Apps.Log.LogHelper.Error("process load end is error:" + ex.ToString());
			}
		}));
	}

	private void VmSolution_InstanceChanged(object sender, EventArgs e)
	{
		Dispatcher?.Invoke(() =>
		{
			try
			{
				GlobalCommunicationMgr.Instance.CloseComm();
				GlobalCommunicationMgr.Instance.IsGet = false;
				globalCommunication?.Close();
				globalCommunication = null;
				GlobalCameraManager.Instance.CloseCamera();
				globalScriptWindow?.Close();
				globalScriptWindow = null;
			}
			catch (Exception ex)
			{
				Apps.Log.LogHelper.Error("VmSolution_InstanceChanged exception:" + ex.ToString());
			}
		});
	}

	private void DeInit()
	{
		VmSolution.RestoreDefaultDisplay -= VmSolution_RestoreDefaultDisplay;
		VmSolution.OnGlobalScriptReportCallBack -= VmSolution_OnGlobalSciptReportData;
		VmSolution.OnProcessImportEndCallBack -= VmSolution_OnProcessImportEndCallBack;
		VmSolution.OnSolutionLoadEndCallBack -= VmSolution_OnSolutionLoadEndCallBack;
		toolData.FunctionExecuteEvent -= ToolData_FunctionExecuteEvent;
		toolData.Dispose();
		DeintSource();
	}

	private void ToolData_FunctionExecuteEvent(string obj)
	{
		GetWinformHandle();
		GetWPFOwner();
		if (!string.IsNullOrEmpty(obj))
		{
			switch (obj)
			{
			case "GlobalCommSet":
				CommSet();
				break;
			case "GlobalLightSet":
				LightSet();
				break;
			case "GlobalCameraSet":
				CameraSet();
				break;
			case "GlobalVariableSet":
				GlobalVariable();
				break;
			case "GlobalScriptSet":
				GlobalScript();
				break;
			case "GlobalTriggerSet":
				GlobalTrigger();
				break;
			case "SaveSolution":
				SaveSolution();
				break;
			case "SaveAsSolution":
				SaveAsSolution();
				break;
			case "OpenSolution":
				OpenSolution();
				break;
			case "EditFrontendUI":
				EditFrontendUI();
				break;
			case "ComprehensiveConfig":
				ComprehensiveConfig();
				break;
			}
		}
	}

	private void DeintSource()
	{
		try
		{
			globalCommunication?.Close();
			globalCommunication = null;
			globalScriptWindow?.Close();
			hwndSource = null;
			Owner = null;
		}
		catch (Exception ex)
		{
			Apps.Log.LogHelper.Error("DeintSource exception:" + ex.ToString());
		}
	}

	private static void OpenGlobalModule(string path, int id, Action<object> action)
	{
		try
		{
			VmModule vmModule = VmSolution.Instance.Modules.FirstOrDefault((VmModule x) => x.ID == id);
			if (vmModule == null)
			{
				string path2 = CurrentPathHelper.Instance.GetCurrentPath() + "\\" + path;
				Assembly assembly = Assembly.LoadFile(path2);
				Type type = assembly.GetTypes().FirstOrDefault((Type p) => typeof(IVmModule).IsAssignableFrom(p));
				Activator.CreateInstance(type, VmSolution.Instance);
				vmModule = VmSolution.Instance.Modules.FirstOrDefault((VmModule x) => x.ID == id);
				if (id == 11000)
				{
					if (globalCommunication != null)
					{
						globalCommunication = null;
					}
					globalCommunication = new GlobalCommunication();
				}
			}
			if (vmModule != null)
			{
				action?.Invoke(vmModule);
			}
		}
		catch (Exception ex)
		{
			VmException vmException = VmSolution.GetVmException(ex);
			if (vmException != null)
			{
				ShowMessage.ShowVmExceptionMessage(vmException);
				Apps.Log.LogHelper.Error(vmException.errorMessage);
			}
			else
			{
				Apps.Log.LogHelper.Error(ex.ToString());
			}
		}
	}

