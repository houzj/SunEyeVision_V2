	/// <summary>
	/// 全局脚本
	/// </summary>
	public void GlobalScript()
	{
		try
		{
			if (globalScriptWindow == null)
			{
				globalScriptWindow = new MainWindow();
				globalScriptWindow.ExcuteEvent += () =>
				{
					VmSolution.Instance.Run();
				};
			}
			if (globalScriptWindow.IsClosing)
			{
				globalScriptWindow.ExcuteEvent -= () =>
				{
					VmSolution.Instance.Run();
				};
				globalScriptWindow = new MainWindow();
				globalScriptWindow.ExcuteEvent += () =>
				{
					VmSolution.Instance.Run();
				};
			}
			if (globalScriptWindow.GetShellParamer() != 0)
			{
				return;
			}
			if (globalScriptWindow.ObjShellRun != null && globalScriptWindow.ObjShellRun.IsPasswordEnabled)
			{
				string password = globalScriptWindow.ObjShellRun.Password;
				PasswordCheckWindow passwordCheckWindow = new PasswordCheckWindow
				{
					OriginalPassword = password
				};
				passwordCheckWindow.ShowDialog();
				if (passwordCheckWindow.IsPasswordOK)
				{
					SetWindowOwner(globalScriptWindow);
					globalScriptWindow.ShowDialog();
				}
			}
			else
			{
				SetWindowOwner(globalScriptWindow);
				globalScriptWindow.ShowDialog();
			}
		}
		catch (Exception ex)
		{
			VmException vmException = VmSolution.GetVmException(ex);
			if (vmException != null)
			{
				ShowMessage.ShowVmExceptionMessage(vmException);
				Apps.Log.LogHelper.Error(vmException.errorMessage);
			}
			else
			{
				Apps.Log.LogHelper.Error(ex.ToString());
			}
		}
	}

	public void VmSolution_OnGlobalSciptReportData(object sender, ObjectEventArgs args)
	{
		if (args == null || args.Param == null || string.IsNullOrEmpty(args.Param.ToString()))
		{
			return;
		}
		string info = args.Param.ToString();
		Dispatcher.BeginInvoke((Action)(() =>
		{
			try
			{
				dynamic val = JsonConvert.DeserializeObject(info);
				if (!((val == null) ? true : false))
				{
					dynamic val2 = val.head;
					if (!((val2 == null) ? true : false))
					{
						string s = val.head.errorCode;
						string text = val.head.type;
						string text2 = text;
						if (!(text2 == "report"))
						{
							if (text2 == "updateScript" && globalScriptWindow != null)
							{
								string text3 = val.head.msg;
								if (!string.IsNullOrEmpty(text3))
								{
									globalScriptWindow.UpdateShellContent(text3);
								}
							}
						}
						else
						{
							int result = 0;
							int.TryParse(s, out result);
							string strMsg = AppLocalizationService.GetLang("Lang_GlobalScript") + ":" + ErrorCodeInfo.GetErrorInfo(result);
							HikMessageBox.Show(strMsg, MessageIcons.Error);
						}
					}
				}
			}
			catch (Exception ex)
			{
				Apps.Log.LogHelper.Error("VmSolution_OnGlobalSciptReportData exception:" + ex.ToString());
			}
		}));
	}

	/// <summary>
	/// 全局触发
	/// </summary>
	public static void GlobalTrigger()
	{
		try
		{
			OpenGlobalModule("module(sp)\\x64\\Global\\GlobalTriggerModule\\GlobalTriggerModuleCs.dll", 14200, (object module) =>
			{
				if (module != null)
				{
					GlobalTriggerConfig dataContext = new GlobalTriggerConfig
					{
						DecorateSource = module
					};
					GloablTriggleConfigUI gloablTriggleConfigUI = new GloablTriggleConfigUI(module as VmModule)
					{
						DataContext = dataContext
					};
					SetWindowOwner(gloablTriggleConfigUI);
					gloablTriggleConfigUI.ShowDialog();
				}
			});
		}
		catch (Exception)
		{
		}
	}

	/// <summary>
	/// 保存方案
	/// </summary>
	public void SaveSolution()
	{
		if (!string.IsNullOrEmpty(VmSolution.Instance.SolutionPath))
		{
			Dispatcher.Invoke(() =>
			{
				SaveCalibUserData();
			});
			Task.Run(() =>
			{
				VmSolution.SaveAs(VmSolution.Instance.SolutionPath);
			}).ContinueWith((Task t) =>
			{
				GlobalCommunicationMgr.Instance.ResetParamStateFlag();
			});
		}
		else
		{
			SaveAsSolutionProcess();
		}
	}

	/// <summary>
	/// 所有流程保存一键标定引导信息
	/// </summary>
	private void SaveCalibUserData()
	{
		foreach (VmProcedure item in VmSolution.Instance.Modules.OfType<VmProcedure>())
		{
			((IVmProcedure)item).SaveCalibData();
		}
	}

	/// <summary>
	/// 方案另存为
	/// </summary>
	public void SaveAsSolution()
	{
		SaveAsSolutionProcess();
	}

	/// <summary>
	/// 获取VM安装路径
	/// </summary>
	private string GetVMInstallPath()
	{
		string registerValueByName = GetRegisterValueByName(registerkeyPathName, "CurrentVersion");
		string path = Path.Combine(vmInstallPath, "VisionMaster_" + registerValueByName);
		string registerValueByName2 = GetRegisterValueByName(path, "InstallPath");
		return string.IsNullOrEmpty(registerValueByName2) ? AppDomain.CurrentDomain.SetupInformation.ApplicationBase : (registerValueByName2 + "\\Applications\\");
	}

	/// <summary>
	/// 获取注册表中key对应的值
	/// </summary>
	private string GetRegisterValueByName(string path, string name)
	{
		string result = "";
		try
		{
			RegistryKey localMachine = Registry.LocalMachine;
			RegistryKey registryKey = localMachine.OpenSubKey(path);
			object obj = registryKey?.GetValue(name);
			if (obj != null && obj is string text)
			{
				result = text;
			}
			registryKey?.Close();
			localMachine.Close();
		}
		catch
		{
		}
		return result;
	}

	/// <summary>
	/// 打开方案
	/// </summary>
	public void OpenSolution()
	{
		((IVMRun)VmSolution.Instance).ContinuousRunEnable = false;
		bool flag = true;
		string strFileName = "";
		if (flag)
		{
			Microsoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog
			{
				Filter = "Solution Files (*." + AppFileExtension.Solution + ")|*." + AppFileExtension.Solution
			};
			if (openFileDialog.ShowDialog() != true)
			{
				return;
			}
			strFileName = openFileDialog.FileName;
		}
		else
		{
			DirectoryBrowser.OpenFileDialog openFileDialog2 = new DirectoryBrowser.OpenFileDialog
			{
				Filter = "Solution Files (*." + AppFileExtension.Solution + ")|*." + AppFileExtension.Solution
			};
			if (openFileDialog2.ShowDialog() != true)
			{
				return;
			}
			strFileName = openFileDialog2.FileNames.First();
		}
		if (string.IsNullOrEmpty(strFileName))
		{
			return;
		}
		uint nHasPwd = 0u;
		uint nValidFormat = 0u;
		try
		{
			ServerSDKManager.serverSDKManager.mSolutionManager.CheckSolution(strFileName, ref nHasPwd, ref nValidFormat);
		}
		catch (VmException vmException)
		{
			ShowMessage.ShowVmExceptionMessage(vmException);
			return;
		}
		string passWord = "";
		if (nValidFormat == 1)
		{
			if (nHasPwd == 1)
			{
				Decryption decryption = new Decryption();
				decryption.SolutionPath = strFileName;
				if (decryption.ShowDialog() != true)
				{
					return;
				}
				passWord = decryption.AccessAdministatorCode;
			}
			Task task = new Task(() =>
			{
				ImvsSdkDefine.IMVS_SOLUTION_VERSION_INFO stSolutionVersionInfo = default;
				int num = ServerSDKAPI.IMVS_GetSolutionVersion(CVmObjectBase.mhandle, strFileName, passWord, ref stSolutionVersionInfo);
				if (num != 0)
				{
					HikMessageBox.Show(AppLocalizationService.GetLang("errCode:") + " " + num.ToString("X") + Environment.NewLine + AppLocalizationService.GetLang(ErrorCodeInfo.GetErrorInfo(num)), MessageIcons.Error);
				}
				else
				{
					string version = stSolutionVersionInfo.strTargetSolutionInfo.Substring(1);
					Version version2 = new Version(version);
					Version version3 = new Version("4.0.0");
					if (version2 < version3)
					{
						Dispatcher.Invoke(() =>
						{
							string text = AppLocalizationService.GetLang("Lang_SolVersion_OutOfDate") + "\r\n" + AppLocalizationService.GetLang("版本信息") + stSolutionVersionInfo.strTargetSolutionInfo;
							HikMessageBox.Show(text, MessageIcons.Error);
							Apps.Log.LogHelper.Error(text);
						});
					}
					else
					{
						string lang = AppLocalizationService.GetLang("Lang_version");
						if (string.IsNullOrEmpty(lang))
						{
							Dispatcher.Invoke(() =>
							{
								string text = AppLocalizationService.GetLang("版本信息") + " Error";
								HikMessageBox.Show(text, MessageIcons.Error);
								Apps.Log.LogHelper.Error(text);
							});
						}
						else
						{
							Version version4 = new Version(lang.Substring(1));
							if (!(version2 < version4))
							{
								try
								{
									Apps.Log.LogHelper.Info("Load solution path: " + strFileName);
									if (GlobalCommunicationMgr.Instance.IsGet)
									{
										GlobalCommunicationMgr.Instance.CloseComm();
										GlobalCommunicationMgr.Instance.IsGet = false;
									}
									VmSolution.Load(strFileName, passWord);
									return;
								}
								catch (VmException ex2)
								{
									VmException ex3 = ex2;
									VmException vmException2 = ex3;
									Dispatcher.Invoke(() =>
									{
										ShowMessage.ShowVmExceptionMessage(vmException2);
									});
									return;
								}
								catch (Exception ex4)
								{
									Exception ex5 = ex4;
									Exception ex6 = ex5;
									Dispatcher.Invoke(() =>
									{
										HikMessageBox.Show(ex6.Message);
									});
									return;
								}
							}
							Dispatcher.Invoke(() =>
							{
								string text = AppLocalizationService.GetLang("版本信息") + " Error";
								HikMessageBox.Show(text, MessageIcons.Error);
								Apps.Log.LogHelper.Error(text);
							});
						}
					}
				}
			});
			SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.DataForUI.Clipboard.instance.ClearCopyInfo();
			if (VmSolution.Instance.Modules.Count > 0)
			{
				bool flag2 = false;
				try
				{
					flag2 = VmSolution.Instance.IsSolModifyInfo();
				}
				catch (Exception ex)
				{
					Apps.Log.LogHelper.Error("get IsSolModifyInfo is error:" + ex.ToString());
				}
				if (flag2)
				{
					switch (HikMessageBox.Show(AppLocalizationService.GetLang("Lang_SolSave"), AppLocalizationService.GetLang("Lang_SolCurSave"), MessageButtons.YesOrNoOrCancel, MessageIcons.Question))
					{
					default:
						return;
					case DialogResult.Yes:
						SaveSolution(task);
						return;
					case DialogResult.No:
						break;
					}
				}
			}
			task.Start();
		}
		else
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_SolLoad"), AppLocalizationService.GetLang("Lang_SolFmt"), MessageIcons.Error);
		}
	}

	/// <summary>
	/// 先保存方案，再加载方案
	/// </summary>
	private void SaveSolution(Task afterSaveTask)
	{
		if (!string.IsNullOrEmpty(VmSolution.Instance.SolutionPath))
		{
			Dispatcher.Invoke(() =>
			{
				SaveCalibUserData();
			});
			Task.Run(() =>
			{
				try
				{
					VmSolution.SaveAs(VmSolution.Instance.SolutionPath);
				}
				catch (Exception ex)
				{
					VmException vmException = VmSolution.GetVmException(ex);
					if (vmException != null)
					{
						ShowMessage.ShowVmExceptionMessage(vmException);
						Apps.Log.LogHelper.Error(vmException.errorMessage);
					}
					else
					{
						Apps.Log.LogHelper.Error(ex.ToString());
					}
				}
			}).ContinueWith((Task t) =>
			{
				GlobalCommunicationMgr.Instance.ResetParamStateFlag();
				afterSaveTask?.Start();
			});
		}
		else if (SaveAsSolutionProcess())
		{
			afterSaveTask?.Start();
		}
	}

	/// <summary>
	/// 方案另存为
	/// </summary>
	private bool SaveAsSolutionProcess()
	{
		if (VmSolution.Instance.IsHasPassword)
		{
			Decryption decryption = new Decryption();
			decryption.SolutionPath = VmSolution.Instance.SolutionPath;
			if (decryption.ShowDialog() != true)
			{
				return false;
			}
		}
		using (FileSaveDialog fileSaveDialog = new FileSaveDialog
		{
			FileTypeFilters = new FileTypeFilterCollection
			{
				new FileTypeFilter(AppLocalizationService.GetLang("解决方案"), "." + AppFileExtension.Solution)
			},
			DefaultFileExtension = "." + AppFileExtension.Solution,
			RestoreDirectory = true
		})
		{
			tempStrPassWord = "";
			FileDialogButton fileDialogButton = new FileDialogButton("encryptButton", AppLocalizationService.GetLang("加密选项"));
			fileDialogButton.Click += encryptCheckClick;
			fileSaveDialog.Controls.Add(fileDialogButton);
			if (fileSaveDialog.Show() == FileDialogResult.Ok)
			{
				string passWord = ((tempStrPassWord == null) ? "" : tempStrPassWord);
				Dispatcher.Invoke(() =>
				{
					SaveCalibUserData();
				});
				VmSolution.SaveAs(fileSaveDialog.ShellFile.Path, passWord);
				GlobalCommunicationMgr.Instance.ResetParamStateFlag();
			}
		}
		return true;
	}

	/// <summary>
	/// 打开综合配置窗口
	/// </summary>
	private void ComprehensiveConfig()
	{
		ComprehensiveConfigManager.ShowWindow();
	}

	private void encryptCheckClick(object sender, EventArgs e)
	{
		Encryption encryption = new Encryption();
		if (encryption.ShowDialog() == true && !string.IsNullOrEmpty(encryption.AccessAdministatorCode))
		{
			HikMessageBox.Show(AppLocalizationService.GetLang("Lang_Sure"), AppLocalizationService.GetLang("SubWindowPassword") + "：" + encryption.textCodeSet.Password + "\r\n" + AppLocalizationService.GetLang("Lang_Password"), MessageIcons.Warning);
			tempStrPassWord = encryption.AccessAdministatorCode;
		}
	}

	/// <summary>
