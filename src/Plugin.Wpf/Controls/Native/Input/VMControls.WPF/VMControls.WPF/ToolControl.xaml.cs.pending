	/// <summary>
	/// 设置子窗体的owner属性
	/// </summary>
	/// <param name="window">主窗体</param>
	/// <param name="owner">二次开发时父窗口对象</param>
	private static void SetWindowOwner(BaseWindow window)
	{
		try
		{
			if (Application.Current != null)
			{
				if (Owner != null)
				{
					window.Owner = Owner;
				}
				else
				{
					window.Owner = Application.Current.MainWindow;
				}
			}
			else if (hwndSource != null)
			{
				WindowInteropHelper windowInteropHelper = new WindowInteropHelper(window)
				{
					Owner = hwndSource.Handle
				};
			}
		}
		catch (Exception ex)
		{
			Apps.Log.LogHelper.Error("SetWindowOwner is exception:" + ex.ToString());
		}
	}

	/// <summary>
	/// 通信管理
	/// </summary>
	public static void CommSet()
	{
		OpenGlobalModule("module(sp)\\x64\\Global\\CommManagerModule\\CommManagerModuleCs.dll", 11000, (object module) =>
		{
			if (module != null)
			{
				Langauge = AppLocalizationService.GetLangParm();
				if (globalCommunication == null || globalCommunication.IsClosing)
				{
					globalCommunication = new GlobalCommunication();
				}
				globalCommunication.DecorateSource = module;
				if (!GlobalCommunicationMgr.Instance.IsGet)
				{
					GlobalCommunicationMgr.Instance.IsGet = true;
					GlobalCommunicationMgr.Instance.GetData();
					globalCommunication.UpdateLanguage(string.IsNullOrEmpty(Langauge) ? "zh-cn" : Langauge);
					GlobalCommunicationMgr.Instance.IsOpen = true;
					GlobalCommunicationMgr.Instance.ResetParamStateFlag();
					SetWindowOwner(globalCommunication);
					globalCommunication.ShowDialog();
				}
				else
				{
					globalCommunication.UpdateLanguage(string.IsNullOrEmpty(Langauge) ? "zh-cn" : Langauge);
					GlobalCommunicationMgr.Instance.IsOpen = true;
					SetWindowOwner(globalCommunication);
					globalCommunication.ShowDialog();
				}
			}
		});
	}

	/// <summary>
	/// 光源设置
	/// </summary>
	public static void LightSet()
	{
		VmModule vmModule = VmSolution.Instance.Modules.FirstOrDefault((VmModule m) => m.ID == 14000);
		if (vmModule != null)
		{
			OpenGlobalModule("module(sp)\\x64\\Global\\LightControl\\LightControlCs.dll", 14000, (object module) =>
			{
				if (module != null)
				{
					VmModule vmModule2 = (VmModule)module;
					LightSourceManager.Instance.ModuleID = (int)vmModule2.ID;
					LightSourceDlg lightSourceDlg = new LightSourceDlg();
					LightSourceManager.Instance.ModuleID = (int)vmModule2.ID;
					LightSourceManager.Instance.GetData();
					LightSourceManager.Instance.ReFreshComNum();
					SetWindowOwner(lightSourceDlg);
					lightSourceDlg.ShowDialog();
				}
			});
		}
		else
		{
			CommSetWithNoHide();
		}
	}

	/// <summary>
	/// 相机设置
	/// </summary>
	public static void CameraSet()
	{
		try
		{
			if (CodeManager.Instance.GetLoginUser() == AccessUser.Operator)
			{
				return;
			}
			List<VmModule> list = VmSolution.Instance.Modules.ToList();
			foreach (VmModule item in list)
			{
				if (GlobalCameraManager.Instance.FilterCameraModule(item.StrModuleName) && !GlobalCameraManager.Instance.ItemsA.Contains(item))
				{
					GlobalCameraManager.Instance.ItemsA.Add(item);
				}
			}
			List<VmModule> list2 = GlobalCameraManager.Instance.ItemsA.ToList();
			foreach (VmModule item2 in list2)
			{
				if (!VmSolution.Instance.Modules.Contains(item2))
				{
					GlobalCameraManager.Instance.ItemsA.Remove(item2);
					GlobalCameraManager.Instance.CurDeviceA = null;
				}
			}
			GlobalCameraDlg globalCameraDlg = new GlobalCameraDlg();
			GlobalCameraManager.Instance.GetAuthority();
			SetWindowOwner(globalCameraDlg);
			globalCameraDlg.ShowDialog();
		}
		catch (Exception ex)
		{
			Apps.Log.LogHelper.Error("CameraSet exception:" + ex.ToString());
		}
	}

