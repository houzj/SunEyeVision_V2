		Dispatcher.Invoke(() =>
		{
			ToolData_FunctionExecuteEvent(moduleName);
		});
	}

	private void LoadFrontendDesignDllAssembly()
	{
		string currentPath = CurrentPathHelper.Instance.GetCurrentPath();
		string text = Path.Combine(currentPath, "FrontendUI.Design.dll");
		if (!File.Exists(text))
		{
			text = Path.Combine(currentPath, "myLibs\\FrontendUI.Design.dll");
		}
		if (File.Exists(text))
		{
			Assembly assemblyByFileName = ActivatorWrap.GetAssemblyByFileName(text);
			if (null == assemblyByFileName)
			{
				ActivatorWrap.LoadAssembly(text);
			}
		}
	}

	/// <summary>
	/// 获取当前控件父窗体
	/// </summary>
	/// <returns></returns>
	private static object GetWindowOwner()
	{
		object result = null;
		try
		{
			if (Application.Current != null)
			{
				result = Application.Current.MainWindow;
			}
			else if (hwndSource != null)
			{
				result = hwndSource.Handle;
			}
		}
		catch (Exception message)
		{
			Apps.Log.LogHelper.Error(message);
		}
		return result;
	}

	/// <summary>
	/// 编辑运行界面
	/// </summary>
	public void EditFrontendUI()
	{
		try
		{
			LoadFrontendDesignDllAssembly();
			Type type = (Type)ActivatorWrap.TypeTable["FrontendUI.Design.FrontendWindowData"];
			if (type == null)
			{
				HikMessageBox.Show(AppLocalizationService.GetLang("未知类型") + "FrontendUI.Design.FrontendWindowData", MessageIcons.Warning);
				return;
			}
			MethodInfo method = type.GetMethod("EditFrontendUI", BindingFlags.DeclaredOnly | BindingFlags.Static | BindingFlags.Public);
			if (method != null)
			{
				method.Invoke(this, new object[1] { GetWindowOwner() });
			}
		}
		catch (Exception ex)
		{
			HikMessageBox.Show(ex.Message, MessageIcons.Error);
			Apps.Log.LogHelper.Error(ex);
		}
	}
}
