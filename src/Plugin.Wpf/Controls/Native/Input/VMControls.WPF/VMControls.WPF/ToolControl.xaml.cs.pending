	/// <summary>
	/// 每次打开通信管理窗体都是重新new,用于二次开发、运行界面子窗体上弹出通信管理窗体
	/// </summary>
	public static void CommSetWithNoHide()
	{
		if (globalCommunication != null)
		{
			globalCommunication.Close();
			GlobalCommunicationMgr.Instance.IsOpen = false;
			globalCommunication = null;
		}
		CommSet();
	}

