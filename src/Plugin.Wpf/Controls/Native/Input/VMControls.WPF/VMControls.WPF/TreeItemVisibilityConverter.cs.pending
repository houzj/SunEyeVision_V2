using System;
using System.Globalization;
using System.Linq;
using System.Windows;
using System.Windows.Data;
using Apps.XmlParser.Variable;
using VM.Core;
using SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.Interface;

namespace SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF;

public class TreeItemVisibilityConverter : IValueConverter
{
	public object Convert(object value, Type targetType, object parameter, CultureInfo culture)
	{
		Visibility visibility = Visibility.Visible;
		if (parameter == null)
		{
			if (value is VmIO vmIO && (!vmIO.VisibleInResultTree || !vmIO.Visible))
			{
				visibility = Visibility.Collapsed;
			}
		}
		else
		{
			visibility = Visibility.Hidden;
			string[] source = VariableManager.GetSupportIO().ToArray();
			if (value is IVmIO vmIO2 && source.Contains(vmIO2.TypeName) && !(vmIO2.Owner is IVmProcedure))
			{
				visibility = Visibility.Visible;
			}
		}
		return visibility;
	}

	public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture)
	{
		throw new NotImplementedException();
	}
}
