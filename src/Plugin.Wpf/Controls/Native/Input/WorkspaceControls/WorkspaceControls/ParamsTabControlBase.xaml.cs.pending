using System;
using System.CodeDom.Compiler;
using System.Diagnostics;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Markup;
using SunEyeVision.Plugin.Wpf.Native.Input.Interaction.Commom;
using SunEyeVision.Plugin.Wpf.Native.Display.PresentationControls;
using SunEyeVision.Plugin.Wpf.Native.Numeric.Presentation.Controls;
using PresentationControls.BaseInterface;

namespace SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls;

/// <summary>
/// ParamsTabControlBase.xaml 的交互逻辑
/// </summary>
/// <summary>
/// ParamsTabControlBase
/// </summary>
public partial class ParamsTabControlBase : TabWinBase, IComponentConnector
{
	public override IParamsConfig ParamsConfig
	{
		get
		{
			return paramstab.ParamsConfig;
		}
		set
		{
			paramstab.ParamsConfig = value;
		}
	}

	public ParamsTabControlBase()
	{
		InitializeComponent();
		SetBinding(FrameworkElement.WidthProperty, new Binding("DataContext.ConfigWindowWidth")
		{
			Source = paramstab
		});
		SetBinding(FrameworkElement.HeightProperty, new Binding("DataContext.ConfigWindowHeight")
		{
			Source = paramstab
		});
		Binding binding = new Binding("DataContext.ConfigMaxButtonVisibility")
		{
			Converter = new BooleanToVisibilityConverter(),
			Source = paramstab
		};
		SetBinding(BaseWindow.MaxButtonVisibilityProperty, binding);
		CurrentUIHelper.Instance.Dispatcher.Invoke(() =>
		{
		});
	}

}
