<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls.RunButtonControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls" xmlns:appUiCommon="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Apps.PcUI.Common;assembly=Apps.PcUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/WorkspaceControls/styles/commonstyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <StackPanel Orientation="Horizontal">
        <appUiCommon:PerSuperImageButton Style="{StaticResource SuperImageButtonRunOnceStyle}" ToolTip="{DynamicResource Lang_SigRun}" NormalSource="/SharedStyles;component/Resources/ic_play_多流程_normal.png" MoveOverSource="/SharedStyles;component/Resources/ic_play_多流程_hover.png" PressedSource="/SharedStyles;component/Resources/ic_play_多流程_click.png" DisableSource="/SharedStyles;component/Resources/ic_play_多流程_disable.png" Command="{Binding RunOnceCommand}" />
        <appUiCommon:PerSuperImageButton Name="cs" Style="{StaticResource ContentPresenterContinousRunStyle}" Margin="4,0,0,0" ToolTip="{DynamicResource Lang_MutiRun}" NormalSource="/SharedStyles;component/Resources/ic_多次运行_多流程_normal.png" MoveOverSource="/SharedStyles;component/Resources/ic_多次运行_多流程_hover.png" PressedSource="/SharedStyles;component/Resources/ic_多次运行_多流程_click.png" DisableSource="/SharedStyles;component/Resources/ic_多次运行_多流程_disable.png" Command="{Binding RunContinuousCommand}" />
      </StackPanel>
      <ControlTemplate.Triggers>
        <DataTrigger Value="True" Binding="{Binding DecorateSource.ContinuousRunEnable}">
          <Setter Value="{DynamicResource Lang_StopRun}" TargetName="cs" Property="FrameworkElement.ToolTip" />
          <Setter TargetName="cs" Property="appUiCommon:PerSuperImageButton.NormalSource" Value="/SharedStyles;component/Resources/ic_停止运行_多流程_normal.png" />
          <Setter TargetName="cs" Property="appUiCommon:PerSuperImageButton.DisableSource" Value="/SharedStyles;component/Resources/ic_停止运行_多流程_disable.png" />
          <Setter TargetName="cs" Property="appUiCommon:PerSuperImageButton.PressedSource" Value="/SharedStyles;component/Resources/ic_停止运行_多流程_click.png" />
          <Setter TargetName="cs" Property="appUiCommon:PerSuperImageButton.MoveOverSource" Value="/SharedStyles;component/Resources/ic_停止运行_多流程_hover.png" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</Control>