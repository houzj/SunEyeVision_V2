using System;
using System.Globalization;
using System.Windows.Data;
using SunEyeVision.Plugin.Wpf.Native.Dependencies.PresentationControls.Interface;

namespace SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls;

public class TreeDeepthConverter : IValueConverter
{
	public object Convert(object value, Type targetType, object parameter, CultureInfo culture)
	{
		int num = 0;
		if (value is IVmIO vmIO)
		{
			for (IParent parent = vmIO.Parent as IParent; parent != null; parent = parent.Parent as IParent)
			{
				num++;
				if (!(parent is IVmIO))
				{
					break;
				}
			}
		}
		return num;
	}

	public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture)
	{
		throw new NotImplementedException();
	}
}
