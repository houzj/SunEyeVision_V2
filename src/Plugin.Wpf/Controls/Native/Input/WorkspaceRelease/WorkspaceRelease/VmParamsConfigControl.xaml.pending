<?xml version="1.0" encoding="utf-8"?>
<local:WorkspaceUserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceRelease.VmParamsConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceRelease" xmlns:VMWpf="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls" x:Name="us">
  <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
    <VMWpf:ParamsConfigControlBase Name="ParamView" ParamsConfig="{Binding ParamsConfig, ElementName=us}" />
  </ScrollViewer>
</local:WorkspaceUserControl>