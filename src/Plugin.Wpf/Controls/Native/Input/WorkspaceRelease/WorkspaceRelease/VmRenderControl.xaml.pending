<?xml version="1.0" encoding="utf-8"?>
<local:WorkspaceUserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceRelease.VmRenderControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceRelease" xmlns:VMWpf="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls" x:Name="us">
  <VMWpf:RenderControlBase Name="renderControl" ModuleSource="{Binding ModuleSource, ElementName=us}" IImageData="{Binding IImageSource, ElementName=us}" CoordinateInfoVisible="{Binding CoordinateInfoVisible, ElementName=us}" />
</local:WorkspaceUserControl>