<?xml version="1.0" encoding="utf-8"?>
<local:WorkspaceControl x:Class="SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceRelease.VmSingleModuleSetConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:VMWpf="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceRelease">
  <Control.Template>
    <ControlTemplate>
      <VMWpf:SingleModuleSetControl Name="SingleControl" ModuleSource="{Binding ModuleSource, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    </ControlTemplate>
  </Control.Template>
</local:WorkspaceControl>