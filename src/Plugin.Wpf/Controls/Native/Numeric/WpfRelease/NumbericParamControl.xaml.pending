<?xml version="1.0" encoding="utf-8"?>
<ContentControl x:Class="SunEyeVision.Plugin.Wpf.Native.Numeric.VMControls.WPF.Release.Front.NumbericParamControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.VMControls.WPF.Release.Front" xmlns:Front="clr-namespace:FrontendUI.Design.Controls;assembly=FrontendUI.Design" xmlns:Convert="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.Convert">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Convert:BindingPropertyConvert x:Key="BindingPropertyConvert" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Front:NumbericParamControl Name="PART_Control">
    <Front:BaseControl.UserCostomer>
      <MultiBinding Converter="{StaticResource BindingPropertyConvert}">
        <Binding RelativeSource="{RelativeSource Mode=Self}" />
        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentControl}}" />
      </MultiBinding>
    </Front:BaseControl.UserCostomer>
  </Front:NumbericParamControl>
</ContentControl>