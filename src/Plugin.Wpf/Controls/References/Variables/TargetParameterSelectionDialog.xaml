<?xml version="1.0" encoding="utf-8"?>
<vm_port_1:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Controls.References.Variables.TargetParameterSelectionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.References.Variables" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:paramtab="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.References.Variables" Height="470" Width="603" Title="目标参数" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Interaction.Commom" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Foundation" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Foundation/BaseWindow.xaml"/><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceScrollBars.xaml"/><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceComboBoxes.xaml"/><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Commands/BottomCommands.xaml"/><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/References/VariableSelectionStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="deleteButton" TargetType="{x:Type Button}"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Image Name="Image" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/delete_normal.png"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Image" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/delete_click.png"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Image" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/delete_click.png"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="delete" TargetType="{x:Type Button}" BasedOn="{StaticResource deleteButton}">
          <EventSetter Event="Click" Handler="Delete_OnHandler" />
        </Style>
        <Style x:Key="{x:Type ItemsControl}" TargetType="{x:Type ItemsControl}">
          <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
          <Setter Property="ItemsPanel">
            <Setter.Value>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ItemTemplate">
            <Setter.Value>
              <DataTemplate DataType="RunParam">
                <Border BorderThickness="1">
                  <Grid Height="32">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="8*" />
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock MaxWidth="250" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#666666" Grid.Column="0" FontSize="14" FontFamily="Microsoft YaHei" ToolTip="{Binding DisplayPath}" Text="{Binding DisplayPath}" />
                    <Button HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource delete}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Name="LeftPanel" Grid.Row="0">
      <Border Margin="15,10,15,10" BorderBrush="#E0DFDE" BorderThickness="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.8*" />
            <ColumnDefinition Width="6*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#E0DFDE">
            <Grid Background="#ffffff">
              <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="37" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid Grid.Row="1">
                <Grid Margin="0,0,5,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#4c4c4c" Margin="12,0,0,0" Text="{DynamicResource Lang_SelectList}" FontFamily="微软雅黑" FontWeight="Bold" TextAlignment="Left" FontSize="14px" />
                  <ComboBox Name="SearchComboBox" HorizontalAlignment="Right" Width="145" SelectedIndex="0" Grid.Column="1" Style="{StaticResource ListViewComboBoxStyle}" Height="32" IsEnabled="False" ToolTip="类型筛选的原件元数据尚未接入"><ComboBoxItem Content="当前类型"/></ComboBox>
                </Grid>
              </Grid>
              <Border Grid.Row="2" Margin="5,5,5,3" BorderBrush="#E0DFDE" BorderThickness="1">
                <Grid Background="#ffffff">
                  <paramtab:TargetParameterTree x:Name="RunParamsSelectTreeView" Margin="2,5,2,3" ItemsSource="{Binding TreeNodes}">
                  </paramtab:TargetParameterTree>
                </Grid>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="50" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Lang_GlobalVariableTargetParams}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14px" FontFamily="Microsoft YaHei" />
            <Grid Grid.Row="1" VerticalAlignment="Top" Height="340">
              <ScrollViewer Name="ScrollViewer" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding Path=Height, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}">
                <ItemsControl ItemsSource="{Binding SelectedConsumers}" />
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#E4E5E7">
      <Button Content="{DynamicResource Confirm}" HorizontalAlignment="Right" Style="{StaticResource BottomButtonStyle}" Width="66" Height="24" Margin="0,0,15,0" Click="Close_OnClick" />
    </Border>
  </Grid>
</vm_port_1:BaseWindow>
