<foundation:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Controls.References.Variables.VariableArrayDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:foundation="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Foundation"
    xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.References.Variables"
    x:Name="ArrayDialog" Height="460" Width="670" Title="{Binding WindowTitle, ElementName=ArrayDialog}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Foundation/BaseWindow.xaml"/>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceScrollBars.xaml"/>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceComboBoxes.xaml"/>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Commands/BottomCommands.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <Grid.Resources>
      <Style TargetType="{x:Type ItemsControl}">
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
          <Grid Height="28" Width="122" Margin="20,5,5,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock MaxWidth="40" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" ToolTip="{Binding Index}" Text="{Binding Index}"/>
            <TextBlock Grid.Column="1" MaxWidth="90" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#666666" FontSize="14" FontFamily="Microsoft YaHei" ToolTip="{Binding Value}" Text="{Binding Value}"/>
          </Grid>
        </DataTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Border Margin="20,20,20,5" BorderBrush="#E0DFDE" BorderThickness="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
        <Border BorderBrush="#E4E5E7" Background="#E4E5E7" BorderThickness="1">
          <ScrollViewer VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item" CanContentScroll="True" Style="{StaticResource RecScrollViewer}" VerticalScrollBarVisibility="Auto">
            <ItemsControl Width="652" ItemsSource="{Binding ElementName=ArrayDialog, Path=BindItems}"/>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Margin="0,5,0,0">
          <local:VariablePageNavigator HorizontalAlignment="Right" Margin="0,1,9,2" TotalDataCount="{Binding ElementName=ArrayDialog, Path=ItemsTotalCount}" CurrentPageNumber="{Binding ElementName=ArrayDialog, Path=CurrentPageNum, Mode=TwoWay}" PageDataCount="{Binding ElementName=ArrayDialog, Path=PageCount, Mode=TwoWay}"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</foundation:BaseWindow>
