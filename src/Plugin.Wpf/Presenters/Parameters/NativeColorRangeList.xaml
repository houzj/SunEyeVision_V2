<UserControl x:Class="SunEyeVision.Plugin.Wpf.Presenters.Parameters.NativeColorRangeList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foundation="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Foundation"
             xmlns:localization="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <localization:LocalizationResources />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceScrollBars.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceComboBoxes.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceBottomButtons.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- 对齐原厂 UserScrollView：ListView 项为四色边框 + 54x54 颜色圆 + 启用勾选 + 悬停删除。 -->
      <Style x:Key="ColorRangeDeleteButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Image x:Name="Icon" Stretch="None"
                     Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_selected_delete_normal.png" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Icon" Property="Image.Source"
                          Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_selected_delete_click.png" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Icon" Property="Image.Source"
                          Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_selected_delete_click.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ColorRangeItemStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListViewItem}">
              <Grid Margin="3" Background="#FCFCFC">
                <foundation:FouerColorBorder x:Name="CardBorder" BorderThickness="1" BorderBrush="#00FFFFFF" CornerRadius="2">
                  <Grid x:Name="CardGrid">
                    <Canvas Width="54" Height="54">
                      <Ellipse Canvas.Left="0" Canvas.Top="0" Width="54" Height="54" Fill="{Binding BrushColor}" />
                    </Canvas>
                    <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                  </Grid>
                </foundation:FouerColorBorder>
                <Button x:Name="DeleteButton" Width="18" Height="18" Margin="0,-5,-5,0" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                        Style="{StaticResource ColorRangeDeleteButtonStyle}" Click="OnDeleteClick" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="CardBorder" Property="Border.BorderBrush" Value="#CCCCCC" />
                  <Setter TargetName="CardGrid" Property="Panel.Background" Value="#F2F2F2" />
                  <Setter TargetName="DeleteButton" Property="UIElement.Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="CardBorder" Property="Border.BorderBrush" Value="#E0E0E0" />
                  <Setter TargetName="CardBorder" Property="foundation:FouerColorBorder.BottomBorderBrush" Value="{DynamicResource Col_Theme}" />
                  <Setter TargetName="CardGrid" Property="Panel.Background" Value="#F2F2F2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ColorRangeAddButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Image x:Name="Fore" Height="54" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/btn_add-color_normal.png" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Fore" Property="Image.Source"
                          Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/btn_add-color_hover.png" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Fore" Property="Image.Source"
                          Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/btn_add-color_click.png" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Fore" Property="Image.Source"
                          Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/btn_add-color_disable.png" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- 对齐原厂 ColorExtractList：18 标题 / 92 卡片区 / * 参数区。 -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="18" />
      <RowDefinition Height="92" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{DynamicResource ExtractList}" Foreground="#666666" FontSize="14" FontWeight="Bold" Margin="18,0,0,0" />
    <Border Grid.Row="1" Margin="18,10,10,0" Height="82" BorderThickness="1" BorderBrush="#FFD3D3D3" Background="#FCFCFC">
      <ScrollViewer x:Name="CardScroll" Style="{StaticResource titleBarShrinkScrollViewer}" Height="80"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Padding="3,0,3,0">
        <StackPanel Orientation="Horizontal">
          <ListView x:Name="CardList" Height="64" VerticalAlignment="Center" BorderBrush="#00FFFFFF"
                    Background="#FCFCFC" ItemContainerStyle="{StaticResource ColorRangeItemStyle}"
                    ItemsSource="{Binding Cards, ElementName=Root}" SelectionChanged="OnSelectionChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.CanContentScroll="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ListView>
          <Button x:Name="AddButton" Margin="3" Style="{StaticResource ColorRangeAddButtonStyle}" Click="OnAddClick" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <ScrollViewer Grid.Row="2" Padding="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Params Settings}" Foreground="#666666" FontSize="14" FontWeight="Bold" Margin="18,16,0,0" />
        <StackPanel x:Name="DetailStack" Orientation="Vertical" Margin="18,5,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
