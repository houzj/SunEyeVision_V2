<UserControl x:Class="SunEyeVision.Plugin.Wpf.Presenters.Parameters.NativeCommandSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <localization:LocalizationResources />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceComboBoxes.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- 对齐原厂 CommandSelecter_Frame：两枚命令按钮 + 清空按钮，命令按钮使用 CmdTypeRadioButtonStyle。 -->
  <Grid Margin="37,0,35,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="73" />
      <RowDefinition Height="16" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,2,0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="46" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <RadioButton x:Name="FirstCommand" Grid.Column="0" Focusable="True" IsThreeState="False"
                   HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadioButtonStyle}" />
      <RadioButton x:Name="SecondCommand" Grid.Column="2" Focusable="True" IsThreeState="False"
                   HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadioButtonStyle}" />
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="246" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Height="32" Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock x:Name="CountLabel" HorizontalAlignment="Left" FontFamily="Microsoft YaHei" FontSize="14"
                   Foreground="#FF4C4C4C" VerticalAlignment="Center" />
        <TextBlock x:Name="CountValue" HorizontalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="24"
                   Foreground="#FF4C4C4C" VerticalAlignment="Center" Margin="10,0,0,0" />
      </StackPanel>
      <RadioButton x:Name="ClearCommand" Grid.Column="1" Height="32" Focusable="True" IsThreeState="False"
                   HorizontalAlignment="Stretch" Style="{StaticResource CmdTypeRadbtnDeleteStyle}" />
    </Grid>
  </Grid>
</UserControl>
