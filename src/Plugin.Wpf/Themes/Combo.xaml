            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="10" />
