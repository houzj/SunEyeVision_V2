                  <Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <Setter TargetName="Back" Value="{DynamicResource Col_ModuleConfig_ComboBox_Selected_Background}" Property="Border.Background" />
                    <Setter Value="{DynamicResource Col_ModuleConfig_ComboBox_Foreground}" Property="Foreground" />
                    <Setter TargetName="rect" Property="Visibility" Value="Visible" />
