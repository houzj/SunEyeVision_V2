            </Trigger>
            <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
              <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
