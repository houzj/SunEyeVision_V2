<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns:b08n0="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Foundation" xmlns:b08n1="clr-namespace:SunEyeVision.Plugin.Wpf.Themes.Palettes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  >
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="b08n1:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="WinMinBtnStyle" TargetType="{x:Type Button}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding MinimizeTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type b08n0:BaseWindow}}}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="bg" Width="30" Height="28" Background="#00FFFFFF" CornerRadius="2" BorderThickness="0" BorderBrush="{DynamicResource Col_SubForm_CloseButton_Selected_BorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image Name="fore" Width="32" Height="32" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowshift_ic_minimize.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bg" Value="{DynamicResource Col_SubForm_CloseButton_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="bg" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Value="{DynamicResource Col_SubForm_CloseButton_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="bg" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="fore" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowshift_ic_minimize.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WinMaxBtnStyle" TargetType="{x:Type Button}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding RestoreTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type b08n0:BaseWindow}}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="bg" Width="30" Height="28" Background="#00FFFFFF" CornerRadius="2" BorderThickness="0" BorderBrush="{DynamicResource Col_SubForm_CloseButton_Selected_BorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image Name="fore" Width="32" Height="32" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowshift_ic_normal.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bg" Value="{DynamicResource Col_SubForm_CloseButton_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="bg" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Value="{DynamicResource Col_SubForm_CloseButton_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="bg" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="fore" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowshift_ic_normal.png" />
            </Trigger>
            <DataTrigger Value="Normal" Binding="{Binding WindowState, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
              <Setter TargetName="fore" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowshift_ic_maximize.png" />
              <Setter Property="FrameworkElement.ToolTip" Value="{Binding MaximizeTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type b08n0:BaseWindow}}}" />
            </DataTrigger>
            <DataTrigger Value="Maximized" Binding="{Binding WindowState, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
              <Setter TargetName="fore" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowshift_ic_normal.png" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WinCloseBtnStyle" TargetType="{x:Type Button}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding CloseTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type b08n0:BaseWindow}}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="bg" Width="30" Height="28" Background="#00FFFFFF" CornerRadius="2" BorderThickness="0" BorderBrush="{DynamicResource Col_SubForm_CloseButton_Selected_BorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image Name="fore" Width="32" Height="32" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowclose.png" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bg" Value="{DynamicResource Col_SubForm_CloseButton_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="bg" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Value="{DynamicResource Col_SubForm_CloseButton_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="bg" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="fore" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Windows/windowclose.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <b08n0:TopThicknessConvert x:Key="TopThicknessConvert" />
  <b08n0:TopThicknessConvert2 x:Key="TopThicknessConvert2" />
  <b08n0:TopCornerRadiusConvert x:Key="TopCornerRadiusConvert" />
  <b08n0:BottomCornerRadiusConvert x:Key="BottomCornerRadiusConvert" />
  <ControlTemplate x:Key="MetroWindowTemplate" TargetType="{x:Type b08n0:BaseWindow}">
    <b08n0:FouerColorBorder x:Name="Border" Background="#00FFFFFF" TopBorderBrush="{TemplateBinding b08n0:BaseWindow.TopBorderBrush}" LeftBorderBrush="{TemplateBinding b08n0:BaseWindow.LeftBorderBrush}" RightBorderBrush="{TemplateBinding b08n0:BaseWindow.RightBorderBrush}" BottomBorderBrush="{TemplateBinding b08n0:BaseWindow.BottomBorderBrush}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="{TemplateBinding b08n0:BaseWindow.CornerRadius}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <b08n0:FouerColorBorder Grid.Row="1" Margin="-1" Background="{TemplateBinding Control.Background}" LeftBorderBrush="{TemplateBinding b08n0:BaseWindow.LeftBorderBrush}" RightBorderBrush="{TemplateBinding b08n0:BaseWindow.RightBorderBrush}" BottomBorderBrush="{TemplateBinding b08n0:BaseWindow.BottomBorderBrush}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource BottomCornerRadiusConvert}}" BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource TopThicknessConvert2}}">
          <AdornerDecorator>
            <ContentPresenter />
          </AdornerDecorator>
        </b08n0:FouerColorBorder>
        <HeaderedContentControl Name="Header" Grid.Row="0" Grid.Column="0">
          <b08n0:FouerColorBorder TopBorderBrush="{TemplateBinding b08n0:BaseWindow.TopBorderBrush}" Background="{TemplateBinding b08n0:BaseWindow.HeaderBrush}" CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource TopCornerRadiusConvert}}" BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource TopThicknessConvert}}">
            <Grid UseLayoutRounding="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Content="{TemplateBinding b08n0:BaseWindow.IconContent}" />
              <TextBlock Name="Title" Grid.Column="1" Text="{TemplateBinding Window.Title}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="10,0" Foreground="{TemplateBinding b08n0:BaseWindow.HeaderFore}" Visibility="Collapsed" />
              <ContentControl Name="titlebar" Grid.Column="2" Content="{TemplateBinding b08n0:BaseWindow.TitleBar}" Visibility="Visible" Grid.ColumnSpan="1" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Grid.Column="3">
                <Button Name="MinWinButton" Visibility="{TemplateBinding b08n0:BaseWindow.MinButtonVisibility}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" IsTabStop="True" Style="{StaticResource WinMinBtnStyle}" />
                <Button Name="MaxWinButton" Visibility="{TemplateBinding b08n0:BaseWindow.MaxButtonVisibility}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" IsTabStop="True" Style="{StaticResource WinMaxBtnStyle}" />
                <Button Name="CloseWinButton" Margin="2,0,8,0" Visibility="{TemplateBinding b08n0:BaseWindow.CloseButtonVisibility}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" IsTabStop="True" Style="{StaticResource WinCloseBtnStyle}" />
              </StackPanel>
            </Grid>
          </b08n0:FouerColorBorder>
        </HeaderedContentControl>
      </Grid>
    </b08n0:FouerColorBorder>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding ElementName=titlebar, Path=Content}" Value="{x:Null}">
        <Setter TargetName="titlebar" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="Title" Property="UIElement.Visibility" Value="Visible" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="{x:Type b08n0:BaseWindow}" TargetType="{x:Type b08n0:BaseWindow}" BasedOn="{StaticResource {x:Type Window}}">
    <Setter Property="Window.AllowsTransparency" Value="False" />
    <Setter Property="b08n0:BaseWindow.HeaderBrush" Value="{DynamicResource Col_SubForm_HeaderBrush_Background}" />
    <Setter Property="b08n0:BaseWindow.HeaderFore" Value="{DynamicResource Col_SubForm_HeaderBrush_Foreground}" />
    <Setter Property="b08n0:BaseWindow.TopBorderBrush" Value="{DynamicResource Col_Window_TopFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Col_SubForm_BorderBrush}" />
    <Setter Property="Window.WindowStyle" Value="None" />
    <Setter Property="Window.ResizeMode" Value="NoResize" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="b08n0:BaseWindow.CornerRadius" Value="1,1,2,2" />
    <Setter Property="Template" Value="{StaticResource MetroWindowTemplate}" />
    <Setter Property="b08n0:BaseWindow.ShowInTaskbar" Value="False" />
    <Setter Property="Window.ResizeMode" Value="CanMinimize" />
    <Setter Property="b08n0:BaseWindow.MinButtonVisibility" Value="Collapsed" />
    <Setter Property="b08n0:BaseWindow.MaxButtonVisibility" Value="Collapsed" />
    <Setter Property="WindowChrome.WindowChrome">
      <Setter.Value>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>