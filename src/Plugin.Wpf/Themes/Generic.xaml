<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SunEyeVision.Plugin.Wpf.Controls" xmlns:fields="clr-namespace:SunEyeVision.Plugin.Wpf.Fields" xmlns:sys="clr-namespace:System;assembly=mscorlib"><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/configuration/ConfigurationShell.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/configuration/ConfigurationControls.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Combo.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/FieldStyles.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Regions/RoiResources.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/TemplateWindowButtonStyles.xaml" /><!-- 图像 ROI 容器样式（{x:Type ROIItemsPage}/{x:Type SubROIItemsPage}）：
     绘制时 ROIControlBase 依赖 ROIItemsPage.SubstituteHost（模板中名为 Bd 的 Canvas），
     该样式不合并则回落到 ItemsControl 默认模板，SubstituteHost 为 null，绘制 ROI 立即 NRE。 -->
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/roiitemspagestyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/subroiitemspagestyle.xaml" /><!-- 形状与各 ROI 控件的显示样式：与原厂 BaseControls/themes/generic.xaml 的合并清单一致。
     缺少这些字典时 ROI 控件能创建（ROITempConverter 返回实例），但 Template 为 null，画布上看不到绘制出来的区域。 -->
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/shape/shapeitemspagestyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/rectroi/rectroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/circleroi/circleroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/ellipseroi/ellipseroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/polygonroi/polygonroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/sectorroi/sectorroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/oversectorroi/oversectorroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/pointroi/pointroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/linecaliperroi/linecaliperroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/circlecaliperroi/circlecaliperroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/sectorcaliperroi/sectorcaliperroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/lineroi/lineroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/circlemesroi/circlemesroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/coordinateroi/coordinateroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/roi/multilineroi/multilineroistyle.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/specialroi/crossroi/crossroistyle.xaml" /></ResourceDictionary.MergedDictionaries>
<Style TargetType="ComboBox" BasedOn="{StaticResource ListViewComboBoxStyle}"/>
<!-- 参数页外观由 VM 原件字典提供：ConfigurationShell/ConfigurationControls（窗口级）+ Combo/FieldStyles/RoiResources（参数面板级）。
     本文件只保留原件没有对应物时必需的自有控件模板；颜色一律引用原件键，不再另造主题色。 -->
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ConfigurationControlForeground}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="TextBox">
 <Setter Property="Foreground" Value="{DynamicResource ConfigurationControlForeground}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
 <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/></Border></ControlTemplate></Setter.Value></Setter>
 <Style.Triggers><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource Col_SubForm_Background}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Col_Theme}"/></Trigger></Style.Triggers>
</Style>
<Style TargetType="Button">
 <Setter Property="Foreground" Value="{DynamicResource ConfigurationControlForeground}"/><Setter Property="Background" Value="#E1DFDF"/><Setter Property="BorderBrush" Value="#BFBFBF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6,2"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Col_Theme}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="ScrollBar"><Setter Property="Background" Value="{DynamicResource Col_SubForm_Background}"/><Setter Property="Foreground" Value="#BBBBBB"/><Setter Property="Width" Value="12"/></Style>
<Style TargetType="TabItem" BasedOn="{StaticResource ConfigurationTab}"/>

<SolidColorBrush x:Key="ConfigurationToggleOffBrush" Color="#B8B8B8"/>
<SolidColorBrush x:Key="ConfigurationSelectedTextBrush" Color="White"/>
<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    
    </ResourceDictionary>
