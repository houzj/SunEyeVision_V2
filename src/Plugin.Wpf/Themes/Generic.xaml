<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SunEyeVision.Plugin.Wpf.Controls" xmlns:fields="clr-namespace:SunEyeVision.Plugin.Wpf.Fields" xmlns:sys="clr-namespace:System;assembly=mscorlib"><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/configuration/ConfigurationShell.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/configuration/ConfigurationControls.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Combo.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/FieldStyles.xaml" /><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Regions/RoiResources.xaml" /></ResourceDictionary.MergedDictionaries>
<Style TargetType="ComboBox" BasedOn="{StaticResource ListViewComboBoxStyle}"/>
<!-- 参数页外观由 VM 原件字典提供：ConfigurationShell/ConfigurationControls（窗口级）+ Combo/FieldStyles/RoiResources（参数面板级）。
     本文件只保留原件没有对应物时必需的自有控件模板；颜色一律引用原件键，不再另造主题色。 -->
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ConfigurationControlForeground}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="TextBox">
 <Setter Property="Foreground" Value="{DynamicResource ConfigurationControlForeground}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
 <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/></Border></ControlTemplate></Setter.Value></Setter>
 <Style.Triggers><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource Col_SubForm_Background}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Col_Theme}"/></Trigger></Style.Triggers>
</Style>
<Style TargetType="Button">
 <Setter Property="Foreground" Value="{DynamicResource ConfigurationControlForeground}"/><Setter Property="Background" Value="#E1DFDF"/><Setter Property="BorderBrush" Value="#BFBFBF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6,2"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Col_Theme}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="ScrollBar"><Setter Property="Background" Value="{DynamicResource Col_SubForm_Background}"/><Setter Property="Foreground" Value="#BBBBBB"/><Setter Property="Width" Value="12"/></Style>
<Style TargetType="TabItem" BasedOn="{StaticResource ConfigurationTab}"/>

<SolidColorBrush x:Key="ConfigurationToggleOffBrush" Color="#B8B8B8"/>
<SolidColorBrush x:Key="ConfigurationSelectedTextBrush" Color="White"/>
<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
<Style TargetType="{x:Type controls:NumericUpDown}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Col_ModuleConfig_ComboBox_Background}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NumericUpDown}">
                    <Grid>
                        
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                
                                <TextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Left" IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent" />

                                
                                <Border Grid.Column="1" Background="{DynamicResource Col_SubForm_Background}" BorderBrush="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,4,4,0" Visibility="{TemplateBinding ShowUpDownButtons, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Vertical">
                                        
                                        <RepeatButton x:Name="PART_IncreaseButton" Content="▲" Width="18" Height="13" FontSize="8" Foreground="{DynamicResource ConfigurationControlForeground}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                                                        
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Col_Theme_Light}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Col_ModuleConfig_ComboBox_Selected_Background}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                        <RepeatButton x:Name="PART_DecreaseButton" Content="▼" Width="18" Height="13" FontSize="8" Foreground="{DynamicResource ConfigurationControlForeground}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Col_Theme_Light}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Col_ModuleConfig_ComboBox_Selected_Background}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        
                        
                        <Popup x:Name="PART_SliderPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="{DynamicResource Col_ModuleConfig_ComboBox_Background}" BorderBrush="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,2,0,0">
                                <Slider x:Name="PART_Slider" Style="{StaticResource SliderStyle1}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" SmallChange="{TemplateBinding SmallChange}" LargeChange="{TemplateBinding LargeChange}" Width="220" />
                            </Border>
                        </Popup>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Col_SubForm_Background}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Col_Theme}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Col_Theme_Light}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
<Style TargetType="{x:Type controls:ToggleSwitch}">
        <Setter Property="SwitchWidth" Value="42" />
        <Setter Property="SwitchHeight" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="OnBackground" Value="{DynamicResource Col_Theme}" />
        <Setter Property="OffBackground" Value="{DynamicResource ConfigurationToggleOffBrush}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ConfigurationSelectedTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitch}">
                    <Border x:Name="SwitchBorder" Background="{TemplateBinding OffBackground}" BorderBrush="{TemplateBinding OffBackground}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Width="{TemplateBinding SwitchWidth}" Height="{TemplateBinding SwitchHeight}">
                        <Grid>
                            
                            <Border x:Name="ThumbBorder" Background="{TemplateBinding ThumbColor}" CornerRadius="{TemplateBinding CornerRadius}" Width="{Binding SwitchHeight, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding SwitchHeight, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchBorder" Property="Background" Value="{Binding OnBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="{Binding OnBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ThumbBorder" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
<Style TargetType="{x:Type controls:RangeSlider}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RangeSlider}">
                    
                    <Canvas x:Name="PART_Canvas" Height="22" VerticalAlignment="Center">
                        
                        
                        <Border x:Name="PART_Track" Canvas.Top="9" Height="4" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource HorizontalSliderTrackNormalBackground}" CornerRadius="2" />

                        
                        <Border x:Name="PART_RangeFill" Canvas.Top="9" Height="4" Background="{DynamicResource Col_Theme}" CornerRadius="2" />

                        
                        <Thumb x:Name="PART_MinThumb" Canvas.Top="1" Width="14" Height="20" Background="{DynamicResource GlobalBorderBg}" BorderBrush="{DynamicResource Col_Theme}" BorderThickness="2" Cursor="Hand">
                            <Thumb.Style>
                                <Style TargetType="Thumb">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Thumb.Style>
                        </Thumb>

                        
                        <Thumb x:Name="PART_MaxThumb" Canvas.Top="1" Width="14" Height="20" Background="{DynamicResource GlobalBorderBg}" BorderBrush="{DynamicResource Col_Theme}" BorderThickness="2" Cursor="Hand">
                            <Thumb.Style>
                                <Style TargetType="Thumb">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Thumb.Style>
                        </Thumb>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
<Style TargetType="{x:Type controls:RangeInputControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RangeInputControl}">
                    <Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            
                            <controls:NumericUpDown x:Name="PART_MinNumeric" Grid.Column="0" Width="{TemplateBinding NumericWidth}" Value="{Binding MinValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" SmallChange="{TemplateBinding SmallChange}" LargeChange="{TemplateBinding LargeChange}" DecimalPlaces="{TemplateBinding DecimalPlaces}" ShowSlider="False" ShowUpDownButtons="True" />

                            
                            <TextBlock Grid.Column="1" Text="-" Margin="2,0" VerticalAlignment="Center" Foreground="{DynamicResource ConfigurationControlForeground}" />

                            
                            <controls:NumericUpDown x:Name="PART_MaxNumeric" Grid.Column="2" Width="{TemplateBinding NumericWidth}" Value="{Binding MaxValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" SmallChange="{TemplateBinding SmallChange}" LargeChange="{TemplateBinding LargeChange}" DecimalPlaces="{TemplateBinding DecimalPlaces}" ShowSlider="False" ShowUpDownButtons="True" />

                            
                            <TextBlock Grid.Column="3" Text="{TemplateBinding Unit}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ConfigurationControlForeground}" Visibility="Visible" />
                        </Grid>
                        
                        
                        <Popup x:Name="PART_SliderPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="{DynamicResource Col_ModuleConfig_ComboBox_Background}" BorderBrush="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,2,0,0">
                                <controls:RangeSlider x:Name="PART_RangeSlider" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" MinValue="{Binding MinValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" MaxValue="{Binding MaxValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" SmallChange="{TemplateBinding SmallChange}" LargeChange="{TemplateBinding LargeChange}" MinGap="{TemplateBinding MinGap}" Width="220" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
<Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TargetType="{x:Type controls:ColorPicker}">
        <Setter Property="Width" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ColorPicker}">
                    <Border Background="{DynamicResource Col_ModuleConfig_ComboBox_Background}" BorderBrush="{DynamicResource Col_ModuleConfig_ComboBox_BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="0">
                        <Grid>
                            
                            <TabControl x:Name="PART_TabControl">
                                
                                <TabItem Header="默认">
                                    <StackPanel Margin="10,12,10,0" HorizontalAlignment="Center">
                                        
                                        <TextBlock Text="主题颜色" FontSize="12" Foreground="{DynamicResource ConfigurationControlForeground}" Margin="0,0,0,8" TextAlignment="Center" Width="198" />
                                        <UniformGrid x:Name="PART_ThemeColorsPanel" Columns="10" Rows="6" Width="198" Height="112" />
                                        
                                        
                                        <TextBlock Text="标准颜色" FontSize="12" Foreground="{DynamicResource ConfigurationControlForeground}" Margin="0,12,0,8" TextAlignment="Center" Width="198" />
                                        <UniformGrid x:Name="PART_StandardColorsPanel" Columns="10" Rows="1" Width="198" Height="18" />
                                    </StackPanel>
                                </TabItem>

                                
                                <TabItem Header="更多">
                                    <Grid Margin="10,12,10,0" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        
                                        <Canvas x:Name="PART_HsvCanvas" Grid.Column="0" Width="140" Height="140" Cursor="Cross" Margin="0,0,8,0" VerticalAlignment="Top">
                                            
                                            <Canvas.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Red" Offset="0.0" />
                                                    <GradientStop Color="Yellow" Offset="0.166" />
                                                    <GradientStop Color="Lime" Offset="0.333" />
                                                    <GradientStop Color="Cyan" Offset="0.5" />
                                                    <GradientStop Color="Blue" Offset="0.666" />
                                                    <GradientStop Color="Magenta" Offset="0.833" />
                                                    <GradientStop Color="Red" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Canvas.Background>
                                            
                                            
                                            <Rectangle Width="140" Height="140">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="White" Offset="0.0" />
                                                        <GradientStop Color="Transparent" Offset="0.5" />
                                                        <GradientStop Color="Black" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            
                                            
                                            <Ellipse x:Name="PART_HsvSelector" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" />
                                        </Canvas>
                                        
                                        
                                        <Grid Grid.Column="1" Width="36" Height="140" VerticalAlignment="Top">
                                            <Slider x:Name="PART_ValueSlider" Orientation="Vertical" Minimum="0" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1" HorizontalAlignment="Center" />
                                            
                                            
                                            <TextBlock x:Name="PART_ValueText" Text="1.00" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    


    
    <Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="ColorPickerButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Col_Theme}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Direction="315" Opacity="0.3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    
    </ResourceDictionary>