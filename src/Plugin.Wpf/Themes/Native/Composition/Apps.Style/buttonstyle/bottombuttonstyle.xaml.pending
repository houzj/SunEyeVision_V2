<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
    <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Orange_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource btnEditTemplateBorderBG}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BottomLineBtnEnableBB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource BottomLineBtnEnableBG}" Property="Background" />
              <Setter Value="{DynamicResource BottomLineBtnEnableBB}" Property="BorderBrush" />
              <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OrangeEdit_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource Col_Theme}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Col_EditProcess_Modular_BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="1">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource Col_Theme_Mouse}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme_Mouse}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Value="{DynamicResource Col_Theme_Click}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme_Click}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource BottomLineBtnEnableBG}" Property="Background" />
              <Setter Value="{DynamicResource BottomLineBtnEnableBB}" Property="BorderBrush" />
              <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BottomButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="66" />
  </Style>
  <Style x:Key="ExpandButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="ToggleButton.IsThreeState" Value="False" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBox.Normal.Forground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="bd" CornerRadius="1" BorderBrush="#00FFFFFF" BorderThickness="1" Background="#00FFFFFF" Height="22">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Name="cp" Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              <Image Name="icon" Grid.Column="1" Margin="6,5,4,5" Stretch="None" Height="12" Width="12" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/btn_高级参数_downarrow.png" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/btn_高级参数_uparrow.png" />
              <Setter TargetName="cp" Value="{DynamicResource 收起}" Property="ContentPresenter.Content" />
              <Setter TargetName="cp" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="bd" Property="Width" Value="54" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource LogForeground}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource btnEditTemplateEnableBB}" Property="Border.BorderBrush" />
              <Setter Value="{DynamicResource ParamsTabForeground}" Property="Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource LogForeground}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource btnEditTemplateEnableBB}" Property="Border.BorderBrush" />
              <Setter Value="{DynamicResource ParamsTabForeground}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WhiteNormal_ToolBoxButton" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Image Name="ImageBackground" Width="34" Height="34" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_点击.png" />
