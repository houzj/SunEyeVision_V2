  <Style x:Key="Add_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource GlobalBorderBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
              <Image Name="addIcon" Margin="2,0,0,0" Width="20" Height="20" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/btn_新建模板_normal.png" />
              <ContentPresenter Margin="3,0,0,0" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
              <Setter TargetName="addIcon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/btn_新建模板_click.png" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
              <Setter TargetName="addIcon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/btn_新建模板_click.png" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource BottomLineBtnEnableBG}" Property="Background" />
              <Setter Value="{DynamicResource BottomLineBtnEnableBB}" Property="BorderBrush" />
              <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
              <Setter TargetName="addIcon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/Resources/btn_新建模板 _disable.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
