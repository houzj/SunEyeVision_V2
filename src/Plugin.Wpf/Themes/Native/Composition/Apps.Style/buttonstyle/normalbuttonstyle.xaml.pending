  <Style x:Key="ExpendBtn" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Image Name="img" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/Resources/result_pack up_normal.png" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <RotateTransform x:Name="rotate" Angle="180" />
            </UIElement.RenderTransform>
          </Image>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="FrameworkElement.Cursor" Value="Hand" />
            </Trigger>
            <EventTrigger RoutedEvent="Button.Click">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="rotate" Storyboard.TargetProperty="Angle" Duration="0:0:0" By="180">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
