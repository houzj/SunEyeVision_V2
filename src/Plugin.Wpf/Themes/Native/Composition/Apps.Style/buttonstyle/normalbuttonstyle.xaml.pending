  <Style x:Key="btnEditTemplateStyle" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Background="{DynamicResource btnEditTemplateBorderBG}" BorderBrush="{DynamicResource TextButtonBB}" BorderThickness="1" CornerRadius="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Name="im" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit_normal.png" Stretch="None" />
              <TextBlock Name="tx" Text="{DynamicResource 编辑模型}" FontSize="12" Foreground="{DynamicResource ParamsTabForeground}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="im" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit_disable.png" />
              <Setter TargetName="iBorder" Value="{DynamicResource btnEditTemplateEnableBG}" Property="Border.Background" />
              <Setter TargetName="iBorder" Value="{DynamicResource btnEditTemplateEnableBB}" Property="Border.BorderBrush" />
              <Setter TargetName="tx" Value="{DynamicResource btnEditTemplateEnableFG}" Property="TextBlock.Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
              <Setter TargetName="im" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit_click.png" />
              <Setter TargetName="iBorder" Value="{DynamicResource Col_Theme}" Property="Border.Background" />
              <Setter TargetName="iBorder" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
              <Setter TargetName="tx" Value="{DynamicResource TabPanalLight}" Property="TextBlock.Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ImageButtonStyle3" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
            <ContentPresenter Name="con" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
              <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
