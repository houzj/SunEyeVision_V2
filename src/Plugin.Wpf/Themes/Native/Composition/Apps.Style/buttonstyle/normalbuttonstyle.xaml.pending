            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
              <Setter TargetName="tb" Value="{DynamicResource ListViewComboBoxBackground}" Property="TextBlock.Foreground" />
