            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="sync" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_dialog_sync_click.png" />
