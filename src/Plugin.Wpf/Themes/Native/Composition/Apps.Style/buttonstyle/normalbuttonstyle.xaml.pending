  <Style x:Key="TextButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="iBorder" CornerRadius="2" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{DynamicResource BottomLineBtnEnableBG}" BorderBrush="{DynamicResource TextButtonBB}" BorderThickness="1">
            <TextBlock Name="Tb1" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ParamsTabForeground}" FontSize="12" Text="{TemplateBinding ContentControl.Content}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="iBorder" Value="{DynamicResource Col_Theme}" Property="Border.Background" />
              <Setter TargetName="Tb1" Value="{DynamicResource ListViewComboBoxBackground}" Property="TextBlock.Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
