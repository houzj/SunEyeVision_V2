<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="BarRadioButtonStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource TabItemNormalBack}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RadioButton.Static.Border}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Name="templateRoot" SnapsToDevicePixels="True" Background="{DynamicResource TitleBackGround}">
            <Border Name="bd" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="2,0,0,2" RenderTransformOrigin="0.5,0.5" />
            <ContentPresenter Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FrameworkElement.Tag" Value="True">
              <Setter TargetName="bd" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="-1" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="true">
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Value="{DynamicResource ButtonForground}" Property="Foreground" />
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
              <Setter TargetName="bd" Value="{DynamicResource ButtonBackground}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="templateRoot" Value="{DynamicResource TabItemHoverBack}" Property="Panel.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UserSelectBtnStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="#808080" />
    <Setter Property="BorderBrush" Value="#CCCCCC" />
    <Setter Property="Background" Value="#FCFCFC" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Name="icon" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/check-box_off.png" />
            <ContentPresenter Name="presenter" Margin="3,0,0,0" Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/check-box_on.png" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/radiobtn_off_disable.png" />
              <Setter TargetName="presenter" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>