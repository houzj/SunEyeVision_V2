  <Style x:Key="ShellEditButtonStyle1" TargetType="{x:Type ToggleButton}">
    <Setter Property="ToggleButton.IsThreeState" Value="False" />
    <Setter Property="Height" Value="28" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <StackPanel Orientation="Vertical" Margin="0">
            <Border Name="bd" CornerRadius="2" BorderBrush="{DynamicResource ListViewComboBoxBordBrush}" BorderThickness="1" Background="{DynamicResource GlobalMouseOverBg}" Width="64">
              <Grid>
                <ContentPresenter Name="cp" Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                <Image Name="icon" Margin="0" Stretch="None" Height="28" Width="28" Visibility="Collapsed" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/edit_normal.png" />
              </Grid>
            </Border>
            <Border Name="line" Background="{DynamicResource Col_Theme}" Height="1" Margin="2,0,2,0" BorderBrush="{DynamicResource Col_Theme}" CornerRadius="0.5" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleButton.IsChecked" Value="True" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleButton.IsChecked" Value="True" />
                <Condition Property="UIElement.IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
            </MultiTrigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="cp" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="bd" Property="Border.BorderThickness" Value="0" />
              <Setter TargetName="icon" Property="Visibility" Value="Visible" />
              <Setter TargetName="bd" Property="Width" Value="28" />
              <Setter Property="Margin" Value="0,12,14,6" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="line" Property="Visibility" Value="Visible" />
              <Setter TargetName="cp" Property="Visibility" Value="Visible" />
              <Setter TargetName="bd" Property="Border.BorderThickness" Value="1" />
              <Setter TargetName="bd" Property="Width" Value="64" />
              <Setter Property="Margin" Value="0,12,18,6" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleButton.IsChecked" Value="False" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/edit_click.png" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleButton.IsChecked" Value="False" />
                <Condition Property="UIElement.IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/edit_click.png" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
