  <Style x:Key="ToggleButtonEditStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Background="#D6D5D4" BorderBrush="#A9A9A9" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2,0,0,2">
            <TextBlock Name="tx" FontSize="12" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock.Text>
                <vm_port_0__:ResourceBinding RelativeSource="{RelativeSource TemplatedParent}">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Content</Ctor>
                </vm_port_0__:ResourceBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="iBorder" Property="Border.Background" Value="#E7E7E8" />
              <Setter TargetName="iBorder" Property="Border.BorderBrush" Value="#CFCFD0" />
              <Setter TargetName="tx" Property="TextBlock.Foreground" Value="#80666666" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="iBorder" Value="{DynamicResource Col_Theme}" Property="Border.Background" />
              <Setter TargetName="iBorder" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
              <Setter TargetName="tx" Property="TextBlock.Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="Name" Value="t2">
              <Setter TargetName="iBorder" Property="Border.CornerRadius" Value="0,2,2,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EditLinkButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_SwitchSubscribe}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <Image Name="icon" Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_link切换_normal.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsPressed, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_link切换_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_link切换_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="False" Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_link切换_disable.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsPressed, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit切换_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="False" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit切换_normal.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit切换_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="False" Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_btn_edit切换_disable.png" />
            </MultiDataTrigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Value="{DynamicResource Lang_SwitchEdit}" Property="FrameworkElement.ToolTip" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DisplayHideBtnStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Width" Value="36" />
