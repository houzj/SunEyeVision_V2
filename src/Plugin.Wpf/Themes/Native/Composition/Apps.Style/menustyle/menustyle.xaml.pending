<?xml version="1.0" encoding="utf-8"?>
<win:ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:win="clr-namespace:System.Windows;assembly=PresentationFramework" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <win:ResourceDictionary.MergedDictionaries>
    <win:ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ScrollBarStyle/RecScrollBarStyle.xaml" />
    <win:ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/SeparatorStyle/SeparatorStyle.xaml" />
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
  </win:ResourceDictionary.MergedDictionaries>
  <system:Double x:Key="menuHeadFontSize">13</system:Double>
  <system:Double x:Key="menuItemFontSize">14</system:Double>
  <system:Double x:Key="submenuItemWidth">200</system:Double>
  <system:Double x:Key="submenuItemHeight">34</system:Double>
  <win:Thickness x:Key="submenuItemThickness">4,0,4,0</win:Thickness>
  <win:Style x:Key="MenuPopupStyle" TargetType="{x:Type Border}">
    <win:Setter Property="Background" Value="{win:DynamicResource Col_Menubar_Sub_Background}" />
    <win:Setter Property="Border.Padding" Value="4,5,4,5" />
    <win:Setter Property="Border.CornerRadius" Value="4" />
    <win:Setter Property="BorderThickness" Value="1" />
    <win:Setter Property="BorderBrush" Value="{win:DynamicResource Col_Menubar_Sub_BorderBrush}" />
  </win:Style>
  <ControlTemplate x:Key="{win:ComponentResourceKey ResourceId=TopLevelHeaderTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
    <Grid SnapsToDevicePixels="True" Background="#00FFFFFF" Margin="0,0,15,0" Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Menu}}">
      <Border Name="bg" CornerRadius="2" Background="#00FFFFFF" TextElement.Foreground="{win:TemplateBinding Control.Foreground}" TextElement.FontSize="{win:StaticResource menuHeadFontSize}">
        <ContentPresenter ContentSource="Header" Margin="{win:TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{win:TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Popup AllowsTransparency="True" Focusable="False" PopupAnimation="{win:DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
        <Border Background="#00FFFFFF" Padding="0,5,0,0">
          <Border Name="DropDown" MinWidth="{win:TemplateBinding win:FrameworkElement.ActualWidth}" Style="{win:StaticResource MenuPopupStyle}">
            <ScrollViewer Name="SubMenuScrollViewer" Style="{win:StaticResource RecScrollViewer}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
            </ScrollViewer>
          </Border>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <win:Trigger Property="UIElement.IsMouseOver" Value="True">
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Background}" Property="Border.Background" />
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Foreground}" Property="TextElement.Foreground" />
      </win:Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{win:ComponentResourceKey ResourceId=TopLevelItemTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
    <Grid SnapsToDevicePixels="True" Margin="0,0,15,0" Background="#00FFFFFF">
      <Border Name="bg" CornerRadius="2" Background="#00FFFFFF" TextElement.Foreground="{win:TemplateBinding Control.Foreground}" TextElement.FontSize="{win:StaticResource menuHeadFontSize}">
        <ContentPresenter ContentSource="Header" Margin="{win:TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{win:TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Left" VerticalAlignment="Center" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <win:Trigger Property="UIElement.IsMouseOver" Value="True">
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Background}" Property="Border.Background" />
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Foreground}" Property="TextElement.Foreground" />
      </win:Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{win:ComponentResourceKey ResourceId=SubmenuItemTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
    <StackPanel>
      <Separator Name="sp" Visibility="Collapsed" Style="{win:StaticResource sp}" />
      <Grid Background="#00FFFFFF" MinWidth="{win:StaticResource submenuItemWidth}" Height="{win:StaticResource submenuItemHeight}">
        <Border Name="bg" Background="#00FFFFFF" TextElement.Foreground="{win:TemplateBinding Control.Foreground}" TextElement.FontSize="{win:StaticResource menuItemFontSize}">
          <ContentPresenter Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{win:TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{win:StaticResource submenuItemThickness}" />
        </Border>
        <Rectangle Name="line" Fill="{win:DynamicResource Col_Theme}" Height="1" VerticalAlignment="Bottom" Visibility="Hidden" />
      </Grid>
    </StackPanel>
    <ControlTemplate.Triggers>
      <win:Trigger Property="UIElement.IsMouseOver" Value="True">
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Background}" Property="Border.Background" />
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Foreground}" Property="TextElement.Foreground" />
        <win:Setter TargetName="line" Property="UIElement.Visibility" Value="Visible" />
      </win:Trigger>
      <win:DataTrigger Value="true" Binding="{Binding IsShowSeparator}">
        <win:Setter TargetName="sp" Property="UIElement.Visibility" Value="Visible" />
      </win:DataTrigger>
      <win:Trigger Property="UIElement.IsEnabled" Value="False">
        <win:Setter Value="{win:DynamicResource TextDisenabledForground}" Property="Control.Foreground" />
      </win:Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{win:ComponentResourceKey ResourceId=SubmenuHeaderTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
    <Grid SnapsToDevicePixels="True" Background="#00FFFFFF" Height="{win:StaticResource submenuItemHeight}">
      <Border Name="bg" TextElement.Foreground="{win:TemplateBinding Control.Foreground}" TextElement.FontSize="{win:StaticResource menuItemFontSize}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter Name="HeaderHost" RecognizesAccessKey="True" VerticalAlignment="Center" ContentSource="Header" HorizontalAlignment="Left" Margin="{win:StaticResource submenuItemThickness}" />
          <Path Grid.Column="1" Data="M0,7 L4,4 L0,0" HorizontalAlignment="Right" Margin="0,0,5,0" StrokeThickness="1" Stroke="{win:TemplateBinding Control.Foreground}" VerticalAlignment="Center" />
          <Rectangle Name="line" Fill="{win:DynamicResource Col_Theme}" Height="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Visibility="Hidden" />
        </Grid>
      </Border>
      <Popup AllowsTransparency="True" PopupAnimation="{win:DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
        <Border Padding="7,0,0,0">
          <Border Name="DropDown" MinWidth="{win:TemplateBinding win:FrameworkElement.ActualWidth}" Style="{win:StaticResource MenuPopupStyle}">
            <ScrollViewer Name="SubMenuScrollViewer" Style="{win:StaticResource RecScrollViewer}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
            </ScrollViewer>
          </Border>
          <Border.Background>
            <SolidColorBrush Color="Black" Opacity="0.05" />
          </Border.Background>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <win:Trigger Property="UIElement.IsMouseOver" Value="True">
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Background}" Property="Border.Background" />
        <win:Setter TargetName="bg" Value="{win:DynamicResource Col_Menubar_Selected_Foreground}" Property="TextElement.Foreground" />
        <win:Setter TargetName="line" Property="UIElement.Visibility" Value="Visible" />
      </win:Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <win:Style x:Key="NormalMenuItemStyle" TargetType="{x:Type MenuItem}">
    <win:Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    <win:Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    <win:Setter Property="Background" Value="#00FFFFFF" />
    <win:Setter Property="BorderBrush" Value="#00FFFFFF" />
    <win:Setter Property="BorderThickness" Value="1" />
    <win:Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <win:Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <win:Setter Property="Foreground" Value="{win:DynamicResource Col_Menubar_Foreground}" />
    <win:Setter Property="MenuItem.Command" Value="{Binding ItemClickCommand}" />
    <win:Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
    <win:Style.Triggers>
      <win:Trigger Property="MenuItem.Role" Value="TopLevelHeader">
        <win:Setter Property="Background" Value="#00FFFFFF" />
        <win:Setter Property="BorderBrush" Value="#00FFFFFF" />
        <win:Setter Property="Template" Value="{win:DynamicResource {win:ComponentResourceKey ResourceId=TopLevelHeaderTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}}" />
      </win:Trigger>
      <win:Trigger Property="MenuItem.Role" Value="TopLevelItem">
        <win:Setter Property="Template" Value="{win:DynamicResource {win:ComponentResourceKey ResourceId=TopLevelItemTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}}" />
      </win:Trigger>
      <win:Trigger Property="MenuItem.Role" Value="SubmenuHeader">
        <win:Setter Property="Template" Value="{win:DynamicResource {win:ComponentResourceKey ResourceId=SubmenuHeaderTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}}" />
      </win:Trigger>
      <win:Trigger Property="MenuItem.Role" Value="SubmenuItem">
        <win:Setter Property="Template" Value="{win:DynamicResource {win:ComponentResourceKey ResourceId=SubmenuItemTemplateKey, TypeInTargetAssembly={x:Type MenuItem}}}" />
      </win:Trigger>
      <win:Trigger Property="IsEnabled" Value="False">
        <win:Setter Property="Foreground" Value="{win:DynamicResource TextDisenabledForground}" />
      </win:Trigger>
      <win:DataTrigger Value="false" Binding="{Binding IsDisplayInMenu}">
        <win:Setter Property="Visibility" Value="Collapsed" />
      </win:DataTrigger>
    </win:Style.Triggers>
  </win:Style>
  <win:Style x:Key="NormalMenuStyle" TargetType="{x:Type Menu}">
    <win:Setter Property="FontFamily" Value="{win:DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}" />
    <win:Setter Property="FontSize" Value="{win:DynamicResource {x:Static SystemFonts.MenuFontSizeKey}}" />
    <win:Setter Property="FontStyle" Value="{win:DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}" />
    <win:Setter Property="FontWeight" Value="{win:DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}" />
    <win:Setter Property="Foreground" Value="{win:DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
    <win:Setter Property="VerticalContentAlignment" Value="Center" />
    <win:Setter Property="Template">
      <win:Setter.Value>
        <ControlTemplate TargetType="{x:Type Menu}">
          <Border BorderBrush="{win:TemplateBinding Control.BorderBrush}" BorderThickness="{win:TemplateBinding Control.BorderThickness}" Background="{win:TemplateBinding Control.Background}" Padding="{win:TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ItemsPresenter SnapsToDevicePixels="{win:TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </win:Setter.Value>
    </win:Setter>
  </win:Style>
  <ControlTemplate x:Key="MenuControlTemplate1" TargetType="{x:Type Menu}">
    <Border Background="#00FFFFFF" SnapsToDevicePixels="True">
      <ItemsPresenter SnapsToDevicePixels="{win:TemplateBinding UIElement.SnapsToDevicePixels}" />
    </Border>
    <ControlTemplate.Triggers>
      <win:DataTrigger Value="True" Binding="{Binding IsBusy, ElementName=frontend}">
        <win:Setter Property="UIElement.IsEnabled" Value="False" />
      </win:DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</win:ResourceDictionary>