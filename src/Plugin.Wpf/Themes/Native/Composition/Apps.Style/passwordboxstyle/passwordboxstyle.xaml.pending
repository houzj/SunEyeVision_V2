<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0_:ColorThemesResourceDictionary.Instance" />
    <ResourceDictionary Source="../ButtonStyle/ToggleButtonStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="textBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="TextBox.MaxLength" Value="15" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Col_SubForm_Foreground}" />
    <Setter Property="FrameworkElement.ContextMenu">
      <Setter.Value>
        <vm_port_0:HikContextMenu>
          <MenuItem Command="Cut" />
          <MenuItem Command="Copy" />
          <MenuItem Command="Paste" />
        </vm_port_0:HikContextMenu>
      </Setter.Value>
    </Setter>
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="" Binding="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="textCodeBoxStyle" TargetType="{x:Type PasswordBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="PasswordBox.MaxLength" Value="15" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="PasswordBox.PasswordChar" Value="*" />
    <Setter Property="Foreground" Value="{DynamicResource Col_SubForm_Foreground}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="vm_port_0:PasswordBoxWaterMark.IsMonitoring" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="vm_port_0:PasswordBoxWaterMark.PasswordLength" Value="0">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="textServerCodeBoxStyle" TargetType="{x:Type PasswordBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="PasswordBox.MaxLength" Value="15" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="PasswordBox.PasswordChar" Value="*" />
    <Setter Property="Foreground" Value="{DynamicResource Col_SubForm_Foreground}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="vm_port_0:PasswordBoxWaterMark.IsMonitoring" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FF686868" Padding="12,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="vm_port_0:PasswordBoxWaterMark.PasswordLength" Value="0">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False" />
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="passwordBoxStyle" TargetType="{x:Type PasswordBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="PasswordBox.MaxLength" Value="15" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="PasswordBox.PasswordChar" Value="*" />
    <Setter Property="Foreground" Value="{DynamicResource Col_SubForm_Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Col_SubForm_Background}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="vm_port_0:PasswordBoxWaterMark.IsMonitoring" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" CornerRadius="2">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="12,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="vm_port_0:PasswordBoxWaterMark.PasswordLength" Value="0">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CommonPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" />
              <TextBlock Name="MessageTextBlock" Text="{TemplateBinding FrameworkElement.Tag}" FontSize="{TemplateBinding Control.FontSize}" Padding="{TemplateBinding Control.Padding}" Foreground="{TemplateBinding Control.Foreground}" VerticalAlignment="Center" Visibility="Hidden" />
              <TextBox Name="DisplayTextBox" BorderThickness="0" Height="{TemplateBinding FrameworkElement.Height}" VerticalContentAlignment="Center" FontSize="{TemplateBinding Control.FontSize}" Foreground="{TemplateBinding Control.Foreground}" Background="{TemplateBinding Control.Background}" Visibility="Hidden" Text="{Binding Path=(vm_port_0:PasswordBoxWaterMark.Password), UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=PasswordBox}}" />
              <ToggleButton Name="ImageToggleButton" Grid.Column="1" Focusable="False" Background="{TemplateBinding Control.Background}" Style="{StaticResource eyeToggleButton}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsKeyboardFocused" Value="False" />
                <Condition Property="vm_port_0:PasswordBoxWaterMark.Password" Value="" />
              </MultiTrigger.Conditions>
              <Setter TargetName="MessageTextBlock" Property="Visibility" Value="Visible" />
              <Setter TargetName="MessageTextBlock" Property="UIElement.Opacity" Value="0.6" />
              <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Hidden" />
            </MultiTrigger>
            <DataTrigger Value="True" Binding="{Binding ElementName=ImageToggleButton, Path=IsChecked}">
              <Setter TargetName="DisplayTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="MessageTextBlock" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Hidden" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>