<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="NormalRadioButton" TargetType="{x:Type RadioButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Col_ModuleConfig_List_Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
    <Setter Property="Background" Value="{DynamicResource ListViewComboBoxBackground}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Name="icon" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/check-box_off.png" />
            <ContentPresenter Margin="3,0,0,0" Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/check-box_on.png" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>