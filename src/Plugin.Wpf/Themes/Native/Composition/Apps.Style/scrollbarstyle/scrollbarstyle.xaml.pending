        <RowDefinition Height="5" />
      </Grid.RowDefinitions>
      <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Style="{StaticResource ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Row="1" IsEnabled="{TemplateBinding UIElement.IsMouseOver}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
