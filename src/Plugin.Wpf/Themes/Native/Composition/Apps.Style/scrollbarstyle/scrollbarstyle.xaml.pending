<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="VerticalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="7" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Name="rect" Grid.Row="0" Grid.RowSpan="3" Canvas.Left="0" Canvas.Top="0" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" RadiusX="4" RadiusY="4" Stroke="{DynamicResource ScrollBarFill}" Fill="{DynamicResource ScrollBarFill}" />
            <Path Grid.Row="1" Data="M0.5,0.5 L5.5,0.5 M0.5,3.5 L5.5,3.5 M0.5,6.5 L5.5,6.5" Width="6" Stretch="Fill" Stroke="{DynamicResource ScrollBarStroke}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Thumb.IsDragging" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="rect" Value="{DynamicResource ScrollBarFillTg}" Property="Shape.Fill" />
              <Setter TargetName="rect" Value="{DynamicResource ScrollBarStrokeTg}" Property="Shape.Stroke" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HorizontalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="7" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Name="rect" Grid.Column="0" Grid.ColumnSpan="3" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" RadiusX="4" RadiusY="4" Stroke="{DynamicResource ScrollBarFill}" Fill="{DynamicResource ScrollBarFill}" />
            <Path Grid.Column="1" Data="M0.5,0.5 L0.5,5.5 M3.5,0.5 L3.5,5.5 M6.5,0.5 L6.5,5.5" Height="6" Stretch="Fill" Stroke="{DynamicResource ScrollBarStroke}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Thumb.IsDragging" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="rect" Value="{DynamicResource ScrollBarFillTg}" Property="Shape.Fill" />
              <Setter TargetName="rect" Value="{DynamicResource ScrollBarStrokeTg}" Property="Shape.Stroke" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Rectangle Fill="#00FFFFFF" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Rectangle Fill="#00FFFFFF" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid Name="Bg" SnapsToDevicePixels="True" Width="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="5" />
        <RowDefinition Height="0.00001*" />
        <RowDefinition Height="5" />
      </Grid.RowDefinitions>
      <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Style="{StaticResource ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Row="1" IsEnabled="{TemplateBinding UIElement.IsMouseOver}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource VerticalScrollBarThumb}" />
        </Track.Thumb>
      </Track>
      <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource ScrollBarLineButton}" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="HorizontalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid Name="Bg" SnapsToDevicePixels="True" Height="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="0.00001*" />
        <ColumnDefinition Width="5" />
      </Grid.ColumnDefinitions>
      <RepeatButton Grid.Column="0" Command="ScrollBar.LineLeftCommand" Style="{StaticResource ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Column="1" IsEnabled="{TemplateBinding UIElement.IsMouseOver}" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource HorizontalScrollBarThumb}" />
        </Track.Thumb>
      </Track>
      <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource ScrollBarLineButton}" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
      </Trigger>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="RecVerticalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="7" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Name="rect" Grid.Row="0" Grid.RowSpan="3" Canvas.Left="0" Canvas.Top="0" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Col_ScrollBar_BorderBrush}" Fill="{DynamicResource Col_ScrollBar_Fill}" StrokeThickness="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FrameworkElement.Tag" Value="1">
              <Setter Value="{DynamicResource TextBox.Foreground}" TargetName="rect" Property="Shape.Stroke" />
              <Setter Value="{DynamicResource btnEditTemplateBorderBG}" TargetName="rect" Property="Shape.Fill" />
            </Trigger>
            <Trigger Property="FrameworkElement.Tag" Value="2">
              <Setter Value="{DynamicResource Col_ScrollBar_BorderBrush}" TargetName="rect" Property="Shape.Stroke" />
              <Setter Value="{DynamicResource Col_ScrollBar_Fill}" TargetName="rect" Property="Shape.Fill" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="RecVerticalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid Name="Bg" SnapsToDevicePixels="True" Width="10">
      <Grid.RowDefinitions>
