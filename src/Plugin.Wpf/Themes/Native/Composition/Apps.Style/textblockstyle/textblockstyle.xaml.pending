<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="CategoryHeader" TargetType="{x:Type TextBlock}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Foreground" Value="{DynamicResource ModuleForeground}" />
    <Setter Property="FontSize" Value="14px" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="label" TargetType="{x:Type TextBlock}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="FontSize" Value="14px" />
  </Style>
  <Style x:Key="TitleTextBlock" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#4d4d4d" />
    <Setter Property="FontFamily" Value="Microsoft Yahei" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ContentTextBlock" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#4d4d4d" />
    <Setter Property="FontFamily" Value="Microsoft Yahei" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="noteStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Foreground" Value="#FF808080" />
    <Setter Property="FontSize" Value="14px" />
  </Style>
</ResourceDictionary>