  <Style x:Key="TemplateConfigTreeViewStyle" TargetType="{x:Type TreeView}">
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    <Setter Property="Foreground" Value="#808080" />
    <Setter Property="BorderBrush" Value="#CCCCCC" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FontSize" Value="14px" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeView}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <HierarchicalDataTemplate ItemsSource="{Binding Childs}">
          <Border Name="HeadBack" Background="#00FFFFFF" Height="40">
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="txtHead" Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding TemplateType}" ToolTip="{Binding}" />
              <Button Grid.Column="2" Style="{StaticResource DeleteBtnStyle}" Command="{Binding DataContext.DelTemplateCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}}" CommandParameter="{Binding}" />
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="HeadBack" Property="Border.Background" Value="#C0C0C0" />
              <Setter TargetName="txtHead" Property="TextBlock.Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </DataTemplate.Triggers>
        </HierarchicalDataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TemplateConfigTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="#808080" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource TreeViewItemFocusVisual}" />
    <Setter Property="TreeViewItem.IsExpanded" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Name="Back" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True" Height="40">
              <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="1.5" />
                </Grid.RowDefinitions>
                <Grid Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton Name="Expander" ClickMode="Press" Grid.Column="0" Margin="6" Style="{StaticResource ExpandCollapseToggleStyle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter Focusable="False" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding Name}" ToolTip="{Binding}" />
                  <Button Grid.Column="2" Style="{StaticResource DeleteBtnStyle}" Command="{Binding DataContext.DelTemplateCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}}" CommandParameter="{Binding}" />
                </Grid>
                <StackPanel Name="sp" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Col_Theme}" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ItemsPresenter Name="ItemsHost" Grid.Row="1" Margin="24,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TreeViewItem.IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="sp" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="ItemsControl.HasItems" Value="False">
              <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="sp" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Border.Background" Value="#C0C0C0" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="TreeViewItem.IsSelected" Value="True">
              <Setter TargetName="Back" Property="Border.Background" Value="#8E8F8F" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NormalTreeViewStyle" TargetType="{x:Type TreeView}">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
