<?xml version="1.0" encoding="utf-8"?>
<PCcontrol:HikTextBox x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab.DeleteTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:PCcontrol="clr-namespace:Apps.PcUI.Controls;assembly=Apps.PcUI" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" x:Name="myControl" Margin="10,0,0,0" VerticalContentAlignment="Center" BorderThickness="0" xmlns:paramtab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource Self}}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" SelectionChanged="tb_SelectionChanged" PreviewTextInput="tb_PreviewTextInput" MouseDown="Grid_MouseDown">
  <UIElement.CommandBindings>
    <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
  </UIElement.CommandBindings>
</PCcontrol:HikTextBox>