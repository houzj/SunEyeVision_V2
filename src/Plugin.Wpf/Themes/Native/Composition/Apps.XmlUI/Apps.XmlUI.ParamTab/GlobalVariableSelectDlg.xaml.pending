<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab.GlobalVariableSelectDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localXmlParserTab="clr-namespace:Apps.XmlParser.ParamTab;assembly=Apps.XmlParser" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" x:Name="globalVariableSelectDlg" Title="{DynamicResource lang_SelectGlobalVariable}" Height="520" Width="680" Loaded="globalVariableSelectDlg_Loaded" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.XmlUI/Styles/ParamUserControlDataTemplate.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/CheckBoxStyle/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/TabControlStyle/TabControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <local:ListItemBackgroundConverter x:Key="listItemBackgroundConverter" />
        <Style x:Key="{x:Type ListView}" TargetType="{x:Type ListView}">
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
          <Setter Property="ScrollViewer.PanningMode" Value="Both" />
          <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListView}">
                <ScrollViewer Tag="1" Style="{StaticResource RecScrollViewer}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="ItemsControl.IsGrouping" Value="True" />
                      <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
          <Style.Setters MouseDoubleClick="globalVarList_MouseDoubleClick">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                  <Border Name="bd" SnapsToDevicePixels="True" Height="34px" Padding="0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="79" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Name="txt1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="#FF666666" Text="{Binding Index}" />
                      <Rectangle Grid.Column="1" Width="1" StrokeThickness="0" Fill="#BFBFBF" />
                      <TextBlock Name="txt2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="#FF666666" MaxWidth="165" Text="{Lang:ResourceBinding Name}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                      <Rectangle Grid.Column="3" Width="1" StrokeThickness="0" Fill="#BFBFBF" />
                      <TextBlock Name="txt3" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="#FF666666" MaxWidth="170" Text="{Binding RemarkInfo}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                      <Rectangle Grid.Column="5" Width="1" StrokeThickness="0" Fill="#BFBFBF" />
                      <TextBlock Name="txt4" Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Foreground="#FF666666" MaxWidth="170" Text="{Binding Value}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Converter={StaticResource listItemBackgroundConverter}}" />
                      </Style>
                    </FrameworkElement.Style>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter TargetName="bd" Property="Border.Background" Value="#F1DFD2" />
                      <Setter Value="{DynamicResource Col_Theme}" TargetName="txt1" Property="TextBlock.Foreground" />
                      <Setter Value="{DynamicResource Col_Theme}" TargetName="txt2" Property="TextBlock.Foreground" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Border.Background" Value="#F1DFD2" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style.Setters>
        </Style>
        <DataTemplate x:Key="ComboboxTree">
          <Border Name="Border" BorderThickness="1" BorderBrush="{DynamicResource ListViewComboBoxBordBrush}" CornerRadius="2" Background="{DynamicResource ListViewComboBoxBackground}">
            <local:TreeViewCombobox Height="30" TextBlock.Foreground="{DynamicResource TextBox.Normal.Forground}" ToggleButtonStyle="{StaticResource ComboxStyleBtn}" ItemsSource="{Binding EnumEntrysA, ElementName=globalVariableSelectDlg}" ExternSelectedItem="{Binding TriggerSelectedObject, ElementName=globalVariableSelectDlg, Mode=TwoWay}">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type localXmlParserTab:EnumEntry}}" DataType="{x:Type localXmlParserTab:EnumEntry}" ItemsSource="{Binding EnumEntrysA}">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Binding DisplayNameA}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                  </HierarchicalDataTemplate>
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <local:TreeViewCombobox.ExternSelectedItemTemplate>
                <DataTemplate>
                  <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" FontSize="14" Text="{Binding FullName}" />
                </DataTemplate>
              </local:TreeViewCombobox.ExternSelectedItemTemplate>
            </local:TreeViewCombobox>
          </Border>
        </DataTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32" Margin="20,5,20,5">
          <ContentControl Grid.Column="3" Width="200" HorizontalAlignment="Left" ContentTemplate="{StaticResource ComboboxTree}" Content="{Binding}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="32" Margin="20,5,20,5">
          <TextBox Name="SearchText" Tag="{DynamicResource Lang_Search}" Style="{StaticResource input}" Padding="6,0,16,0" Width="200" Height="32" TextChanged="SearchText_TextChanged" />
          <Button Style="{StaticResource searchBtn}" Margin="-32,0,0,0" Click="SearchItem_OnClick" />
        </StackPanel>
      </StackPanel>
      <Grid Row="1" Background="#A6A6A6" Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="79" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Number}" Foreground="#4C4C4C" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" />
        <Rectangle Grid.Column="1" Width="1" StrokeThickness="0" Fill="#BFBFBF" />
        <TextBlock Grid.Column="2" Text="{DynamicResource Lang_Variable}" Foreground="#4C4C4C" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" />
        <Rectangle Grid.Column="3" Width="1" StrokeThickness="0" Fill="#BFBFBF" />
        <TextBlock Grid.Column="4" Text="{DynamicResource Lang_ReMark}" Foreground="#4C4C4C" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" />
        <Rectangle Grid.Column="5" Width="1" StrokeThickness="0" Fill="#BFBFBF" />
        <TextBlock Grid.Column="6" Text="{DynamicResource Lang_GlobalVariableDefaultValue}" Foreground="#4C4C4C" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" />
      </Grid>
      <Border Grid.Row="2" Visibility="{Binding ElementName=globalVariableSelectDlg, Path=EmptyStatus}">
        <StackPanel VerticalAlignment="Center">
          <Image Height="50" Width="100" VerticalAlignment="Center" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_empty.png" />
          <TextBlock Text="{DynamicResource Lang_ContentEmpty}" Margin="0,10,0,0" FontSize="14" Foreground="#666666" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <ListView Name="globalVarList" Grid.Row="2" BorderThickness="0" Margin="20,0" ItemsSource="{Binding BindItems, ElementName=globalVariableSelectDlg}" />
      <Border Grid.Row="3" Visibility="{Binding ElementName=globalVariableSelectDlg, Path=PageNumShowStatus}">
        <local:PageNumControl HorizontalAlignment="Right" Margin="0,1,9,2" TotalDataCount="{Binding ElementName=globalVariableSelectDlg, Path=ItemsTotalCount}" CurrentPageNumber="{Binding ElementName=globalVariableSelectDlg, Path=CurrentPageNum, Mode=TwoWay}" PageDataCount="{Binding ElementName=globalVariableSelectDlg, Path=PageCount, Mode=TwoWay}" />
      </Border>
    </Grid>
    <Border Grid.Row="1" BorderThickness="0" Background="#E4E5E7">
      <Button Style="{StaticResource BottomButtonStyle}" Content="{DynamicResource Confirm}" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Confirm_Click" />
    </Border>
  </Grid>
</vm_port_0:BaseWindow>