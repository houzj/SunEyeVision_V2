<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab.PageNumControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" x:Name="pagenumControl" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ButtonStyle/NormalButtonStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ButtonStyle/BottomButtonStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ComboBoxStyle/ListViewComboBoxStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/TextBoxStyle/TextBoxStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ListBoxItemStyle1" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Bd" Margin="8,1,0,0" BorderBrush="#FF000000" BorderThickness="0" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Grid>
                  <Label Name="lb" FontSize="14px" Padding="0" Height="18" HorizontalAlignment="Center" FontFamily="Microsoft YaHei" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{Binding StrNum}" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="true" Binding="{Binding Path=IsNum}" />
                    <Condition Value="true" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="lb" Value="{DynamicResource Col_Theme}" Property="Foreground" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="true" Binding="{Binding Path=IsNum}" />
                    <Condition Value="true" Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="lb" Value="{DynamicResource Col_Theme}" Property="Foreground" />
                  <Setter TargetName="lb" Property="FontWeight" Value="Bold" />
                </MultiDataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BtnInfoStyle" TargetType="{x:Type Button}">
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="Preve">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Image Name="icon" Height="18" Width="18" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_arrow_back_normal.png" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_arrow_back_click.png" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_arrow_back_disable.png" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Next">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Image Name="icon" Height="18" Width="18" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_arrow_preve_normal.png" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_arrow_preve_click.png" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_arrow_preve_disable.png" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="jmpButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource GlobalBorderBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
                  <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource BottomLineBtnEnableBG}" Property="Background" />
                  <Setter Value="{DynamicResource BottomLineBtnEnableBB}" Property="BorderBrush" />
                  <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="66" />
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Height="24" Grid.Column="0" VerticalAlignment="Center">
      <ComboBox Name="SearchComboBox" Margin="10,0,0,0" HorizontalAlignment="Right" SelectedIndex="0" Style="{StaticResource ListViewComboBoxStyle}" Height="24" FontSize="12px" DisplayMemberPath="DisplayInfo" SelectedValuePath="PageNum" Visibility="{Binding PageCountVisible, ElementName=pagenumControl}" Width="{Binding NumWidth, ElementName=pagenumControl}" ItemsSource="{Binding pageCountInfos, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PageNumControl}}}" SelectedValue="{Binding PageDataCount, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PageNumControl}}}" SelectionChanged="SearchComboBox_SelectionChanged" />
      <TextBlock Margin="7,0,5,0" TextAlignment="Center" FontSize="12px" VerticalAlignment="Center" FontFamily="Microsoft YaHei" Text="{Binding Path=DisplayTotalCount, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PageNumControl}}}" />
      <Button Name="PART_ButtonPrePage" Padding="0" Margin="2,0,0,0" Background="#00FFFFFF" Style="{DynamicResource BtnInfoStyle}" Tag="Preve" Visibility="{Binding Path=BtnCollapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:PageNumControl}}" Click="PART_ButtonPrePage_Click" />
      <ListBox Name="PART_ListBoxPages" SelectedIndex="0" ItemContainerStyle="{StaticResource ListBoxItemStyle1}" BorderThickness="0" Margin="-4,0,3,0" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemsSource="{Binding Path=ShowingPageNumberCollection, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PageNumControl}}}" Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PageNumControl}}}" SelectionChanged="PART_ListBoxPages_SelectionChanged">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Horizontal" IsItemsHost="True" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ListBox>
      <Button Name="PART_ButtonNextPage" Content="&gt;" Padding="0" Margin="0,0,5,0" Style="{DynamicResource BtnInfoStyle}" Tag="Next" Visibility="{Binding Path=BtnCollapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:PageNumControl}}" Click="PART_ButtonNextPage_Click" />
      <TextBlock Margin="2,0,5,0" Text="{DynamicResource Lang_Jump}" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="12px" />
      <Border BorderThickness="0.5" BorderBrush="#FF808080">
        <TextBox Name="txtJumpNum" InputMethod.IsInputMethodEnabled="False" Background="#FCFCFC" Width="50" Height="24" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Microsoft YaHei" FontSize="12px" PreviewKeyDown="TxtJumpNum_PreviewKeyDown" />
      </Border>
      <TextBlock Margin="5,0,5,0" Text="{DynamicResource Lang_Page}" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="12px" />
    </StackPanel>
    <Button Name="btnOk" Grid.Column="1" Content="{DynamicResource 跳转}" FontFamily="Microsoft YaHei" FontSize="12px" Width="66" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource jmpButtonStyle}" Click="BtnOk_Click" />
  </Grid>
</UserControl>