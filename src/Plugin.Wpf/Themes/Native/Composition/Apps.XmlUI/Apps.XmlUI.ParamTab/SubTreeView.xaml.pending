<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab.SubTreeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="UserControl" Background="#00FFFFFF" xmlns:paramtab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMUtility.Convert" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.XmlUI/ResourceDictionaries/GlobalResources.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ButtonStyle/ToggleButtonStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/CheckBoxStyle/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <vm_port_0:LeftMarginMultiplierConverter x:Key="lengthConverter" Length="14" />
      <Style x:Key="TreeViewItemFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TreeViewItemStyle1" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Padding" Value="1,0,0,0" />
        <Setter Property="Foreground" Value="{Binding TForeground, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource TreeViewItemFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TreeViewItem}">
              <StackPanel>
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                  <Grid Height="30" Margin="{Binding Converter={StaticResource lengthConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition MinWidth="14" Width="14" />
                      <ColumnDefinition MinWidth="12" Width="12" />
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Name="Expander" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" ClickMode="Press" Style="{StaticResource ExpandCollapseToggleStyle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter Name="PART_Header" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" ContentSource="Header" />
                  </Grid>
                </Border>
                <ItemsPresenter Name="ItemsHost" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="TreeViewItem.IsExpanded" Value="False">
                  <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="ItemsControl.HasItems" Value="False">
                  <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                </Trigger>
                <Trigger Property="TreeViewItem.IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{Binding Path=TBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
                  <Setter Value="{DynamicResource TitleColor}" Property="Foreground" />
                </Trigger>
                <Trigger SourceName="Bd" Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{Binding Path=TBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="TreeViewItem.IsSelected" Value="True" />
                    <Condition Property="TreeViewItem.IsSelectionActive" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="#E7E5E4" />
                  <Setter Value="{DynamicResource TitleColor}" Property="Foreground" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
        <EventSetter Event="MouseDoubleClick" Handler="TextBlock_MouseDown" />
      </Style>
      <SolidColorBrush x:Key="ListBorder" Color="#828790" />
      <Style x:Key="TreeViewStyle1" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TreeView}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer Name="_tv_scrollviewer_" Background="{TemplateBinding Control.Background}" CanContentScroll="False" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" Style="{StaticResource RecScrollViewer}">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
                  <Setter TargetName="_tv_scrollviewer_" Property="ScrollViewer.CanContentScroll" Value="True" />
                </Trigger>
                <DataTrigger Value="Visible" Binding="{Binding ElementName=_tv_scrollviewer_, Path=ComputedHorizontalScrollBarVisibility}">
                  <Setter TargetName="_tv_scrollviewer_" Property="Padding" Value="0,0,20,20" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <TreeView Name="treeView" Padding="0,0,20,0" Grid.Row="0" BorderThickness="0" Background="#00FFFFFF" FontSize="14" Style="{StaticResource TreeViewStyle1}" ItemContainerStyle="{StaticResource TreeViewItemStyle1}" DataContext="{Binding ElementName=UserControl, Path=DataContext}" ItemsSource="{Binding EnumEntrysA}" Foreground="{Binding ElementName=UserControl, Path=TForeground}" Loaded="TreeView_Loaded" TreeViewItem.Selected="TreeView_Selected">
    <ItemsControl.ItemTemplate>
      <HierarchicalDataTemplate ItemsSource="{Binding EnumEntrysA}">
        <StackPanel Orientation="Horizontal">
          <CheckBox Style="{StaticResource NormalCheckBoxStyle}" Visibility="{Binding IsMultiCheck, Converter={StaticResource bool2VisibilityConverter}, ElementName=UserControl}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}" Text="{vm_port_0_:ResourceBinding Name}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
        </StackPanel>
      </HierarchicalDataTemplate>
    </ItemsControl.ItemTemplate>
  </TreeView>
</UserControl>