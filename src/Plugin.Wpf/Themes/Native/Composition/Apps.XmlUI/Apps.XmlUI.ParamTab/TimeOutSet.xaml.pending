<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab.TimeOutSet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" x:Name="SysParamSetX" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Title="{DynamicResource Lang_ProcessTimeOut}" Height="200" Width="370" BorderBrush="#FF161617" BorderThickness="1" MinButtonVisibility="Collapsed" ShowInTaskbar="False" xmlns:paramtab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab;assembly=Apps.XmlUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.HikPcUI.ListView" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0__="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_0_:ColorThemesResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0__:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFF2F3F5">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32" Margin="0,0,0,20">
      <Label Content="{DynamicResource Lang_ProcessTimeOutms}" Width="122" FontSize="14" Margin="26,0,0,0" Foreground="#FF666666" />
      <vm_port_1:SliderArrange Name="timeSpan" Margin="12,0,0,0" FontSize="14" Width="182" Maximum="100000" Minimum="0" SliderTickFrequency="10" StartValue="80">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="OnStartValueChange">
            <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </vm_port_1:SliderArrange>
    </StackPanel>
    <Grid Background="#FFE4E4E7" Height="32" VerticalAlignment="Bottom">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ButtonStyle/BottomButtonStyle.xaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Confirm}" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="ButtonApply_Click" />
        <Button Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Lang_Msg_Cancel}" Margin="0,0,14,0" Style="{StaticResource BottomButtonStyle}" Click="ButtonClose_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</vm_port_0:BaseWindow>