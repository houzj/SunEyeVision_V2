<?xml version="1.0" encoding="utf-8"?>
<pcUI:ConfirmBaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.DisplayForGroupControl.DynamicRunParamDisplayWin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:pcUI="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:appxmlUI="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" WindowStartupLocation="CenterScreen" CancelVisible="Collapsed" Title="{DynamicResource Lang_SetCnfg}" xmlns:displayforgroupcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.DisplayForGroupControl" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
