<?xml version="1.0" encoding="utf-8"?>
<ToggleButton x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.BooleanControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type ToggleButton}">
      <ContentPresenter Name="shape" Content="{Binding OffContent, RelativeSource={RelativeSource TemplatedParent}}" />
      <ControlTemplate.Triggers>
        <Trigger Property="ToggleButton.IsChecked" Value="True">
          <Setter TargetName="shape" Property="ContentPresenter.Content" Value="{Binding OnContent, RelativeSource={RelativeSource TemplatedParent}}" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</ToggleButton>