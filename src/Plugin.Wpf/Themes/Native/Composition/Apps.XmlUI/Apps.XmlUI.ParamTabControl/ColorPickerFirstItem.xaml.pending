<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.ColorPickerFirstItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:CustomWPFColorPicker="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ButtonFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle SnapsToDevicePixels="True" Margin="3" Stroke="#FF000000" StrokeDashArray="1 2" StrokeThickness="1" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <LinearGradientBrush x:Key="ButtonNormalBackgroundFill" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#EDEDED" Offset="0" />
        <GradientStop Color="#EDEDED" Offset="0.9" />
      </LinearGradientBrush>
      <Style x:Key="ColorButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackgroundFill}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Command" Value="{x:Static CustomWPFColorPicker:ColorPickerControlView.SelectColorCommand}" />
        <Setter Property="CommandParameter" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="buttonBorder" Width="{TemplateBinding FrameworkElement.Height}" Height="{TemplateBinding FrameworkElement.Height}" BorderThickness="1,0,1,0" Margin="0" BorderBrush="#D0D0D0" Background="{TemplateBinding Control.Background}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="buttonBorder" Property="Border.BorderThickness" Value="2" />
                  <Setter TargetName="buttonBorder" Property="Border.BorderBrush" Value="#FEAB38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ColorButtonStyleFirstRow" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackgroundFill}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Command" Value="{x:Static CustomWPFColorPicker:ColorPickerControlView.SelectColorCommand}" />
        <Setter Property="CommandParameter" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="buttonBorder" Width="{TemplateBinding FrameworkElement.Height}" Height="{TemplateBinding FrameworkElement.Height}" BorderThickness="1" Margin="0" BorderBrush="#D0D0D0" Background="{TemplateBinding Control.Background}">
                <Border Name="innerBorder" Margin="0.5" BorderThickness="0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{x:Null}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="buttonBorder" Property="Border.BorderThickness" Value="2" />
                  <Setter TargetName="buttonBorder" Property="Border.BorderBrush" Value="#FEAB38" />
                  <Setter TargetName="innerBorder" Property="Border.BorderBrush" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ColorButtonStyleSecondRow" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackgroundFill}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Command" Value="{x:Static CustomWPFColorPicker:ColorPickerControlView.SelectColorCommand}" />
        <Setter Property="CommandParameter" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="buttonBorder" Width="13" Height="13" BorderThickness="1,1,1,0" Margin="0" BorderBrush="#D0D0D0" Background="{TemplateBinding Control.Background}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="buttonBorder" Property="Border.BorderThickness" Value="2" />
                  <Setter TargetName="buttonBorder" Property="Border.BorderBrush" Value="#FEAB38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel Orientation="Vertical">
      <Border Width="196" Height="23" Background="#DDE7EE" BorderThickness="0,0,0,2" BorderBrush="#BFBFBF">
        <DockPanel Width="196">
          <Label SnapsToDevicePixels="True" FontFamily="Arial" Foreground="#FF00008B" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center" VerticalAlignment="Center" Content="{DynamicResource Lang_ThemeColors}" />
        </DockPanel>
      </Border>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,4,4,3" Columns="10">
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#FFFFFF" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#000000" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#EEECE1" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#1f497d" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#4f81bd" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#c0504d" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#9bbb59" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#8064a2" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#4bacc6" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#f79646" />
      </UniformGrid>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,2,4,0" Columns="10">
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#f2f2f2" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#7f7f7f" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#ddd9c3" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#c6d9f0" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#dbe5f1" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#f2dcdb" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#ebf1dd" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#e5e0ec" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#dbeef3" />
        <Button Style="{StaticResource ColorButtonStyleSecondRow}" Background="#fdeada" />
      </UniformGrid>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,0,4,0" Columns="10">
        <Button Style="{StaticResource ColorButtonStyle}" Background="#d8d8d8" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#595959" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#c4bd97" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#8db3e2" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#b8cce4" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#e5b9b7" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#d7e3bc" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#ccc1d9" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#b7dde8" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#fbd5b5" />
      </UniformGrid>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,0,4,0" Columns="10">
        <Button Style="{StaticResource ColorButtonStyle}" Background="#bfbfbf" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#3f3f3f" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#938953" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#548dd4" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#95b3d7" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#d99694" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#c3d69b" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#b2a2c7" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#92cddc" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#fac08f" />
      </UniformGrid>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,0,4,0" Columns="10">
        <Button Style="{StaticResource ColorButtonStyle}" Background="#a5a5a5" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#262626" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#494429" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#17365d" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#366092" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#953734" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#76923c" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#5f497a" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#31859b" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#e36c09" />
      </UniformGrid>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,0,4,3" Columns="10">
        <Button Style="{StaticResource ColorButtonStyle}" Background="#7f7f7f" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#0c0c0c" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#1d1b10" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#0f243e" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#244061" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#632423" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#4f6128" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#3f3151" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#205867" />
        <Button Style="{StaticResource ColorButtonStyle}" Background="#974806" />
      </UniformGrid>
      <Border Width="196" Height="23" Background="#DDE7EE" BorderThickness="0,0,0,2" BorderBrush="#BFBFBF">
        <DockPanel Width="196">
          <Label SnapsToDevicePixels="True" FontFamily="Arial" Foreground="#FF00008B" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center" VerticalAlignment="Center" Content="{DynamicResource Lang_StandardColors}" />
        </DockPanel>
      </Border>
      <UniformGrid SnapsToDevicePixels="True" Margin="2,1,4,2" Columns="10">
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#c00000" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#ff0000" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#ffc000" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#ffff00" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#92d050" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#00b050" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#00b0f0" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#0070c0" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#002060" />
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#7030a0" />
      </UniformGrid>
      <Grid Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="35" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource ColorButtonStyleFirstRow}" Background="#00000000" Height="26" HorizontalAlignment="Center" Margin="2" />
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Lang:LangResource Lang_NoFillColor}" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>