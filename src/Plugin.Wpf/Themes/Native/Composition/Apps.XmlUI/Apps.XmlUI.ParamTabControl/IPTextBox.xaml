<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.IPTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" x:Name="ipText" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.Apps.XmlUI.ParamTabControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="textBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="BorderBrush" Value="#CCCCCD" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Grid>
                <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" CornerRadius="2">
                  <Grid>
                    <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  </Grid>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#F2F3F5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="1" Margin="-5,-2">
    <UniformGrid Columns="4" Margin="5,2" GotFocus="TextBox_OnGotFocus">
      <DockPanel Margin="0">
        <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Text="." Foreground="#666666" Margin="1,0" />
        <vm_port_0:NumbericTextBox x:Name="IPPart1" MaxValue="255" MinValue="0" Precision="0" Style="{StaticResource textBoxStyle}" />
      </DockPanel>
      <DockPanel Margin="0">
        <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Text="." Foreground="#666666" Margin="1,0" />
        <vm_port_0:NumbericTextBox x:Name="IPPart2" MaxValue="255" MinValue="0" Precision="0" Style="{StaticResource textBoxStyle}" />
      </DockPanel>
      <DockPanel Margin="0">
        <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Text="." Foreground="#666666" Margin="1,0" />
        <vm_port_0:NumbericTextBox x:Name="IPPart3" MaxValue="255" MinValue="0" Precision="0" Style="{StaticResource textBoxStyle}" />
      </DockPanel>
      <vm_port_0:NumbericTextBox x:Name="IPPart4" Margin="0" MaxValue="255" MinValue="0" Precision="0" Style="{StaticResource textBoxStyle}" />
    </UniformGrid>
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Style.Triggers>
          <DataTrigger Value="False" Binding="{Binding ElementName=ipText, Path=IsValid}">
            <Setter Property="BorderBrush" Value="#FFFF0000" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </Border>
</UserControl>