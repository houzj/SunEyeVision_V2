<?xml version="1.0" encoding="utf-8"?>
<localcontrol:ROIStackControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.LineROIStack" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:baseData="clr-namespace:Apps.BaseData;assembly=Apps.BaseData" xmlns:localcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.Apps.XmlUI.ParamTabControl" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0__="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.BaseData" xmlns:vm_port_0___="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_0___:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0_:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
      <vm_port_0__:NormalMultiplicationConverter x:Key="normalMultiplicationConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <StackPanel>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Startpoint X Coordinate}" ToolTip="{DynamicResource Startpoint X Coordinate}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <vm_port_0:SliderArrangeFloat SliderTickFrequency="1" Minimum="{Binding ImageWidth, ConverterParameter=-0.5, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localcontrol:RoiSelectControl}}" Maximum="{Binding Minimum, ConverterParameter=-3, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=Self}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <vm_port_0:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <vm_port_0__:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.StartPointX" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </vm_port_0:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </vm_port_0:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Startpoint Y Coordinate}" ToolTip="{DynamicResource Startpoint Y Coordinate}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <vm_port_0:SliderArrangeFloat SliderTickFrequency="1" Minimum="{Binding ImageHeight, ConverterParameter=-0.5, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localcontrol:RoiSelectControl}}" Maximum="{Binding Minimum, ConverterParameter=-3, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=Self}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <vm_port_0:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <vm_port_0__:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.StartPointY" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </vm_port_0:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </vm_port_0:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Endpoint X Coordinate}" ToolTip="{DynamicResource Endpoint X Coordinate}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <vm_port_0:SliderArrangeFloat SliderTickFrequency="1" Minimum="{Binding ImageWidth, ConverterParameter=-0.5, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localcontrol:RoiSelectControl}}" Maximum="{Binding Minimum, ConverterParameter=-3, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=Self}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <vm_port_0:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <vm_port_0__:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.EndPointX" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </vm_port_0:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </vm_port_0:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
        <localParamTab:LeftRightControl Height="32">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Endpoint Y Coordinate}" ToolTip="{DynamicResource Endpoint Y Coordinate}" />
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <vm_port_0:SliderArrangeFloat SliderTickFrequency="1" Minimum="{Binding ImageHeight, ConverterParameter=-0.5, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localcontrol:RoiSelectControl}}" Maximum="{Binding Minimum, ConverterParameter=-3, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=Self}}" DragingChangedCommand="{Binding DragingChangedCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <vm_port_0:SliderArrangeBase.StartValue>
                <MultiBinding Mode="TwoWay">
                  <MultiBinding.Converter>
                    <vm_port_0__:RightFixdMultiplicationConverter />
                  </MultiBinding.Converter>
                  <Binding Path="ROIData.EndPointY" Mode="TwoWay" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                  <Binding Path="ImageHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localcontrol:IImageSizeControl}" />
                </MultiBinding>
              </vm_port_0:SliderArrangeBase.StartValue>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnStartValueChange">
                  <i:InvokeCommandAction Command="{Binding ROIValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </vm_port_0:SliderArrangeFloat>
          </localParamTab:LeftRightControl.RightContent>
        </localParamTab:LeftRightControl>
      </StackPanel>
    </ControlTemplate>
  </Control.Template>
</localcontrol:ROIStackControl>