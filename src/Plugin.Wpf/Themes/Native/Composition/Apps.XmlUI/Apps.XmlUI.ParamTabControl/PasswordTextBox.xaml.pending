<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.PasswordTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" x:Name="passwordTextBox" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ButtonStyle/ToggleButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="textCodeBoxStyle" TargetType="{x:Type PasswordBox}">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="PasswordBox.MaxLength" Value="15" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="32" />
        <Setter Property="PasswordBox.PasswordChar" Value="*" />
        <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="vm_port_0:PasswordBoxWaterMark.IsMonitoring" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type PasswordBox}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Grid>
                  <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="vm_port_0:PasswordBoxWaterMark.PasswordLength" Value="0">
                  <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="textBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="TextBox.MaxLength" Value="15" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
        <Setter Property="FrameworkElement.ContextMenu">
          <Setter.Value>
            <vm_port_0:HikContextMenu>
              <MenuItem Command="Cut" />
              <MenuItem Command="Copy" />
              <MenuItem Command="Paste" />
            </vm_port_0:HikContextMenu>
          </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Grid>
                  <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                  <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="" Binding="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="40" />
    </Grid.ColumnDefinitions>
    <Border BorderThickness="1" BorderBrush="#CCCCCD" CornerRadius="4" Grid.Column="0" Grid.ColumnSpan="2">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
          <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Background" Value="#F2F3F5" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
    <Grid Column="0">
      <PasswordBox Name="passwordBox" Margin="5,0,0,0" BorderThickness="0" Background="#00FFFFFF" MinWidth="180" Foreground="#808080" MaxLength="32" Height="32" Style="{StaticResource textCodeBoxStyle}" Tag="{DynamicResource 请输入密码}" PreviewKeyDown="text_PreviewKeyDown" LostFocus="text_LostFocus">
        <UIElement.CommandBindings>
          <CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
        </UIElement.CommandBindings>
      </PasswordBox>
      <TextBox Name="textBox" Margin="5,0,0,0" BorderThickness="0" Background="#00FFFFFF" MinWidth="180" Foreground="#808080" MaxLength="32" Height="32" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" Tag="{DynamicResource 请输入密码}" Text="{Binding ElementName=passwordBox, Path=Password, Mode=TwoWay}" PreviewKeyDown="text_PreviewKeyDown" LostFocus="text_LostFocus" />
    </Grid>
    <ToggleButton Grid.Column="1" Style="{StaticResource eyeToggleButton}" Margin="2,0,4,0" IsChecked="{Binding ElementName=passwordTextBox, Path=IfShowPassword, Mode=TwoWay}" />
  </Grid>
</UserControl>