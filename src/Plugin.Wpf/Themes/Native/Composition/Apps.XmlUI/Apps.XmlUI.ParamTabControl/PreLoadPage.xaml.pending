<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl.PreLoadPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:page="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:paramtabcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0__="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ScrollBarStyle/RecScrollBarStyle.xaml" />
        <x:StaticExtension Member="vm_port_0__:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0_:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <local:LogManageTypeImageConvert x:Key="logTypeImageConvert" />
      <Style x:Key="showCrossToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFD3D3D3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="iBorder" Margin="0,-4,0,-4" BorderBrush="#FFD3D3D3" Background="#00FFFFFF" BorderThickness="1">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="iBorder" Property="Border.Background" Value="#FFD3D3D3" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="iBorder" Property="Border.Background" Value="#FFD3D3D3" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#FFD3D3D3" />
        <Setter Property="Height" Value="30" />
      </Style>
      <Style x:Key="contentCenterStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="contentLeftStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <DataTemplate x:Key="contentImageStyle">
        <Image Stretch="None" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFFCFCFC">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <ScrollViewer Name="scrollViewer" Grid.Row="1" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Visible" Focusable="False" SnapsToDevicePixels="True" CanContentScroll="True">
      <DataGrid Name="logshow" Margin="20,0,20,20" HorizontalGridLinesBrush="#00FFFFFF" VerticalGridLinesBrush="#FFFFFFFF" IsReadOnly="True" SelectionUnit="FullRow" CanUserAddRows="False" CanUserSortColumns="True" CanUserResizeRows="False" CanUserResizeColumns="False" AlternationCount="2" AlternatingRowBackground="#FFF2F2F2" VirtualizingPanel.IsVirtualizing="True" GridLinesVisibility="Vertical" RowHeaderWidth="0" BorderBrush="#FFD3D3D3" AutoGenerateColumns="False" FontSize="13" FontFamily="Microsoft YaHei" RowHeaderStyle="{x:Null}">
        <DataGrid.Columns>
          <DataGridTextColumn x:Name="DataGridTime" Width="210" ElementStyle="{StaticResource contentCenterStyle}" />
          <DataGridTemplateColumn x:Name="DataGridType" Width="90" CellTemplate="{StaticResource contentImageStyle}" />
          <DataGridTemplateColumn x:Name="DataGridEvent" Width="450">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </ScrollViewer>
    <UniformGrid Grid.Row="0" Columns="4" HorizontalAlignment="Left" Margin="20,0,0,0">
      <RadioButton Name="radio_allinfo" IsChecked="True" VerticalAlignment="Center" Style="{StaticResource showCrossToggleButtonStyle}">
        <TextBlock Grid.Column="0" Text="{DynamicResource All}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" />
      </RadioButton>
      <RadioButton Name="radio_err" IsChecked="False" VerticalAlignment="Center" Style="{StaticResource showCrossToggleButtonStyle}">
        <TextBlock Grid.Column="0" Text="{DynamicResource Lang_Err}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" />
      </RadioButton>
      <RadioButton Name="radio_warning" IsChecked="False" VerticalAlignment="Center" Style="{StaticResource showCrossToggleButtonStyle}">
        <TextBlock Grid.Column="0" Text="{DynamicResource 告警}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" />
      </RadioButton>
      <RadioButton Name="radio_info" IsChecked="False" VerticalAlignment="Center" Style="{StaticResource showCrossToggleButtonStyle}">
        <TextBlock Grid.Column="0" Text="{DynamicResource 信息}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" />
      </RadioButton>
    </UniformGrid>
  </Grid>
</vm_port_0:BaseWindow>