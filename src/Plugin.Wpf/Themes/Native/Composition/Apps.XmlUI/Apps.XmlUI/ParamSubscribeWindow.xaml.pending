<?xml version="1.0" encoding="utf-8"?>
<vm_port_0:BaseWindow x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamSubscribeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:PCommon="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:VMInterface="clr-namespace:VMControls.Interface;assembly=VMControls.Interface" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" x:Name="win" Height="480" Width="240" MaxButtonVisibility="Collapsed" MinButtonVisibility="Collapsed" ShowInTaskbar="False" xmlns:xmlui="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/CheckBoxStyle/CheckBoxStyle.xaml" />
        <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="b2v" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <vm_port_0:BaseWindow.TitleBar>
    <Grid WindowChrome.IsHitTestVisibleInChrome="True">
      <TextBlock Text="{DynamicResource Lang_ParamSubscription}" HorizontalAlignment="Left" FontFamily="Microsoft YaHei" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="10,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <CheckBox Style="{StaticResource NormalCheckBoxStyle}" VerticalAlignment="Center" IsChecked="{Binding Path=Solution.(VMInterface:IVmSolution.IsSubscribeInWindow)}" />
        <TextBlock Text="{DynamicResource Lang_DefaultMethod}" FontFamily="Microsoft YaHei" VerticalAlignment="Center" FontSize="10" Foreground="#FFFFFFFF" TextAlignment="Center" />
      </StackPanel>
    </Grid>
  </vm_port_0:BaseWindow.TitleBar>
  <Grid Background="{DynamicResource GlobalMouseOverBg}" DataContext="{Binding SelectedSubscribeParam}" DataContextChanged="Grid_DataContextChanged">
    <localParamTab:SubTreeView x:Name="treeView" Margin="12" Background="#FFFFFFFF">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnTreeNodeDoubleClick">
          <PCommon:ParamsEventCommand Command="{Binding ClickCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type localParamTab:SubTreeView}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsSubscribeIndex, ElementName=win}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </localParamTab:SubTreeView>
    <localParamTab:SubTreeView x:Name="indextreeView" Margin="12" Background="#FFFFFFFF" Visibility="{Binding IsSubscribeIndex, ElementName=win, Converter={StaticResource b2v}}">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnTreeNodeDoubleClick">
          <PCommon:ParamsEventCommand Command="{Binding IndexClickCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </localParamTab:SubTreeView>
  </Grid>
</vm_port_0:BaseWindow>