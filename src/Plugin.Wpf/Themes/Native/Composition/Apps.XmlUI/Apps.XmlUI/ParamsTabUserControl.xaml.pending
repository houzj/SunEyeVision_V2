<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamsTabUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:appData="clr-namespace:Apps.Data;assembly=Apps.Data" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:PCommon="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ItemsControlStyle/ItemsControlStyle.xaml" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.XmlUI/ResourceDictionaries/GlobalResources.xaml" />
        <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
      <CollectionViewSource x:Key="src" Source="{Binding Collection}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="GroupName" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
      <DataTemplate x:Key="listTab">
        <local:ParamListView CustomParamENWidth="{Binding CustomParamENWidthA}" ChildMargin="{Binding ChildMargin, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ParamsTabUserControl}}}" ChildHeaderMargin="{Binding ChildHeaderMargin, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ParamsTabUserControl}}}" />
      </DataTemplate>
      <DataTemplate x:Key="gridPanal">
        <Grid Loaded="Grid_Loaded">
          <local:ParamUserControl Margin="0" DataContext="{Binding Collection[0]}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid Name="myGrid" Background="#00FFFFFF">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="0*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <local:TabControlFx x:Name="tab" VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlobalBorderBrush}" Style="{StaticResource TabControlStyle}" ItemsSource="{Binding TabsA}" SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="SelectionChanged">
              <PCommon:ParamsEventCommand Command="{Binding ChangeSelectedSubParamCommand}" CommandParameter="{x:Null}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource TopTabItemStyle}" TargetType="{x:Type TabItem}">
              <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource booleanToVisibilityConverter}}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Label Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#00FFFFFF" Content="{vm_port_0_:ResourceBinding NameA}" ToolTip="{vm_port_0_:ResourceBinding NameA}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <ContentPresenter Name="con" ContentTemplate="{StaticResource listTab}" Content="{Binding}" />
              <DataTemplate.Triggers>
                <DataTrigger Value="{x:Static appData:TabTypeEnum.Panal}" Binding="{Binding TabTypeA}">
                  <Setter TargetName="con" Value="{StaticResource gridPanal}" Property="ContentPresenter.ContentTemplate" />
                </DataTrigger>
                <DataTrigger Value="false" Binding="{Binding IsVisible}">
                  <Setter TargetName="con" Property="UIElement.Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </local:TabControlFx>
        <Border Grid.Row="1" Background="#00FFFFFF" CornerRadius="0">
          <Grid>
            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding ExternParamsListA}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <local:ParamUserControl />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ItemsControl}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ExternParamsListA}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ItemsControl>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource GlobalBorderBg}" CornerRadius="0,0,2,2">
          <Grid>
            <ItemsControl Height="32" HorizontalAlignment="Left" ItemsSource="{Binding BottomExcuteButtonsLeftA}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,4,0,4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <local:ParamUserControl />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ItemsControl}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="Tab_Run Params" Binding="{Binding SelectedItem.NameA, ElementName=tab}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BottomExcuteButtonsLeftA}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ItemsControl>
            <ItemsControl Height="32" HorizontalAlignment="Right" ItemsSource="{Binding BottomExcuteButtonsA}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,14,4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <local:ParamUserControl />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ItemsControl}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BottomExcuteButtonsA}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ItemsControl>
          </Grid>
        </Border>
        <Grid Name="imageRec" RowSpan="2" Column="1" Background="{DynamicResource Col_DisplayImage_Control_BorderBrush}" />
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>