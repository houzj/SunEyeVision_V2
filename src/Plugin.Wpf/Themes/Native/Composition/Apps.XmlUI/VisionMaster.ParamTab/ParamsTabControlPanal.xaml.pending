<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.VisionMaster.ParamTab.ParamsTabControlPanal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:appsLocal="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:appData="clr-namespace:Apps.Data;assembly=Apps.Data" xmlns:paramtab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.VisionMaster.ParamTab" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.XmlUI/ResourceDictionaries/GlobalResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="TabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabControlNormalBorderBrush}" />
        <Setter Property="Background" Value="#F9F9F9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Name="ColumnDefinition0" />
                  <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Name="RowDefinition0" Height="Auto" />
                  <RowDefinition Name="RowDefinition1" Height="*" />
                </Grid.RowDefinitions>
                <Border Name="head" BorderThickness="0,0,0,1" BorderBrush="#FFCCC7C6" Margin="4,2,0,2">
                  <TabPanel Name="HeaderPanel" Grid.Column="0" Grid.Row="0" Margin="0" ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                  <UIElement.Effect>
                    <DropShadowEffect Color="White" Direction="270" ShadowDepth="1" Opacity="0.66" BlurRadius="2" />
                  </UIElement.Effect>
                </Border>
                <Grid Name="PART_ItemsHolder" Column="0" Row="1" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
                <DataTrigger Value="1" Binding="{Binding VisibleTabsA.Count}">
                  <Setter TargetName="head" Property="Visibility" Value="Hidden" />
                  <Setter TargetName="head" Property="Margin" Value="0" />
                  <Setter TargetName="head" Property="Height" Value="0" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#FF666666" />
        <Setter Property="Visibility" Value="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Grid>
                <Border Name="bd" HorizontalAlignment="Center" VerticalAlignment="Center" Height="35" Background="#00FFFFFF" Width="{Binding ParamWidth}">
                  <ContentPresenter Name="Content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                </Border>
                <Rectangle Name="line" Height="2" Fill="{DynamicResource Col_Theme}" Visibility="Hidden" VerticalAlignment="Bottom" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="bd" Value="{DynamicResource Col_Theme_Light}" Property="Border.Background" />
                  <Setter Property="FontWeight" Value="Bold" />
                  <Setter Property="Foreground" Value="#FF4D4D4D" />
                  <Setter TargetName="line" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="line" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="Black" Color="#1f0f01" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#d9d9d9" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="30" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Rectangle Name="Rect" Grid.ColumnSpan="2" Height="0" StrokeThickness="1" Stroke="{DynamicResource Col_Theme}" VerticalAlignment="Bottom" Opacity="0.7" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#474747" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#474747" />
                        <Setter TargetName="Rect" Property="Height" Value="1" />
                        <Setter Property="Foreground" Value="#efefef" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Border Name="Border" Background="#FF474747" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="#1f0e01" CornerRadius="1" Visibility="Collapsed" />
                <TextBox Grid.Column="0" Focusable="False" Foreground="{TemplateBinding Control.Foreground}" FontSize="{TemplateBinding Control.FontSize}" Margin="11,0,0,0" Background="#00FFFFFF" Text="{TemplateBinding ComboBox.Text}" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{DynamicResource TextBoxStyle1}" />
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{DynamicResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#1f0e01" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#252525" />
                          <GradientStop Offset="0.15" Color="#252525" />
                          <GradientStop Offset="1" Color="#252525" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#1f0e01" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                      </UIElement.Effect>
                      <UIElement.RenderTransform>
                        <TranslateTransform X="-4" />
                      </UIElement.RenderTransform>
                      <ScrollViewer Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
                <Path Name="InnerShadow" Data="M166,181 L183,325" Margin="0,1,0,0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Stretch="Fill" Height="1" Stroke="#FFFFFFFF" Opacity="0.1" Visibility="Collapsed" Width="{Binding ActualWidth, ElementName=Border}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="{StaticResource Black}" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#474747" />
                  <Setter TargetName="Border" Property="Visibility" Value="Visible" />
                  <Setter TargetName="InnerShadow" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="{StaticResource Black}" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#474747" />
                  <Setter TargetName="InnerShadow" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="DisplayTypeTemplate">
        <Grid Width="{Binding Path=ActualWidth, ElementName=ValueColumn}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="25" />
          </Grid.ColumnDefinitions>
          <local:ParamUserControl Grid.Column="1" />
        </Grid>
      </DataTemplate>
      <CollectionViewSource x:Key="src" Source="{Binding Collection}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="GroupName" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
      <ControlTemplate x:Key="listTab" TargetType="{x:Type Control}">
        <local:ParamListView />
      </ControlTemplate>
      <ControlTemplate x:Key="gridPanal" TargetType="{x:Type Control}">
        <Grid Background="#FFF2F3F5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <DockPanel Margin="18,0,0,8" Grid.Row="0">
            <TextBlock Name="ht" Grid.Row="0" Margin="0,12,0,0" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="#FF4D4D4D" Width="auto" Text="{Binding Path=ContentTitleA}" />
          </DockPanel>
          <local:ParamUserControl Margin="0" Grid.Row="1" DataContext="{Binding Collection[0]}" />
        </Grid>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding ContentTitleA}" Value="{x:Null}">
            <Setter TargetName="ht" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="myGrid" Background="#00FFFFFF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="0*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <local:TabControlFx x:Name="tab" Loaded="Tab_Loaded" VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0,0,0,1" BorderBrush="#FFC8C4C1" SelectedIndex="0" ItemContainerStyle="{StaticResource TopTabItemStyle}" Style="{StaticResource TabControlStyle}" Grid.Row="0" ItemsSource="{Binding VisibleTabsA}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Label Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#00FFFFFF" Content="{vm_port_0:ResourceBinding NameA}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate>
          <Control Name="con" Template="{StaticResource listTab}" />
          <DataTemplate.Triggers>
            <DataTrigger Value="{x:Static appData:TabTypeEnum.Panal}" Binding="{Binding TabTypeA}">
              <Setter TargetName="con" Value="{StaticResource gridPanal}" Property="Control.Template" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </local:TabControlFx>
  </Grid>
</UserControl>