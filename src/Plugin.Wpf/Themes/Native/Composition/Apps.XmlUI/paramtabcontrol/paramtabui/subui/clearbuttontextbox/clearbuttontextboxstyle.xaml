<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab">
  <SolidColorBrush x:Key="FocusedBorderBrush" Color="Black" />
  <SolidColorBrush x:Key="NullTextBorderBrush" Color="Red" />
  <SolidColorBrush x:Key="DisableBorderBrush" Color="#9E9696" />
  <SolidColorBrush x:Key="MouseOverBackground" Color="LightGray" />
  <SolidColorBrush x:Key="DisableBackground" Color="#E6E6E6" />
  <ControlTemplate x:Key="ClearButtonTemplate" TargetType="{x:Type Button}">
    <Grid>
      <Rectangle Name="rctButton" Fill="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="rctButton" Property="Shape.Fill" Value="{StaticResource MouseOverBackground}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="ClearButtonTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="bdRoot" CornerRadius="4" BorderBrush="#CCCCCD" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Background="{TemplateBinding Control.Background}">
            <DockPanel LastChildFill="True">
              <Button Name="Part_ClearButton" local:ClearButtonTextBoxStyle.IsClearButton="True" Content="X" DockPanel.Dock="Right" Focusable="False" Height="30" FontSize="{TemplateBinding Control.FontSize}" Template="{StaticResource ClearButtonTemplate}" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
              <ScrollViewer Name="PART_ContentHost" DockPanel.Dock="Left" Background="#00FFFFFF" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="" Binding="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <Setter TargetName="Part_ClearButton" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="bdRoot" Property="Border.BorderBrush" Value="{StaticResource NullTextBorderBrush}" />
            </DataTrigger>
            <Trigger Property="UIElement.IsFocused" Value="False">
              <Setter TargetName="Part_ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="bdRoot" Property="Border.BorderBrush" Value="{StaticResource FocusedBorderBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bdRoot" Property="Border.BorderBrush" Value="{StaticResource FocusedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bdRoot" Property="Border.BorderBrush" Value="{StaticResource DisableBorderBrush}" />
              <Setter TargetName="bdRoot" Property="Border.Background" Value="{StaticResource DisableBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>