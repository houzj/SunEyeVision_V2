<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:uControl="clr-namespace:VM.Utility.Convert;assembly=VM.Controls" xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:PCommon="clr-namespace:Apps.PcUI.Common;assembly=Apps.PcUI" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:xp="clr-namespace:Apps.Data;assembly=Apps.Data" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMUtility.Convert" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ScrollBarStyle/RecScrollBarStyle.xaml" />
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/Apps.Style/ItemsControlStyle/ItemsControlStyle.xaml" />
    <x:StaticExtension Member="vm_port_0_:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <vm_port_0:LongTextConvert x:Key="longTextConvert" FontSize="12" MaxLen="230" FontFamily="Microsoft YaHei" />
  <local:UserTempConverter x:Key="userTempConverter" />
  <SolidColorBrush x:Key="TabControlNormalBorderBrush" Color="#8C8E94" />
  <SolidColorBrush x:Key="ListBorder" Color="#828790" />
  <local:GroupInfoConverter x:Key="myGroupInfoConverter" />
  <local:ItemCheckConverter x:Key="CheckConverter" />
  <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
  <local:LeftWidthConverter x:Key="LeftWidthConverter" />
  <CollectionViewSource x:Key="src" IsLiveGroupingRequested="True" Source="{Binding Collection}">
    <CollectionViewSource.GroupDescriptions>
      <PropertyGroupDescription PropertyName="GroupName" />
    </CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>
  <DataTemplate x:Key="ParamItemTemplate">
    <Border Name="bd" BorderThickness="1" BorderBrush="{Binding MyItemState, Converter={StaticResource CheckConverter}}" IsEnabled="{Binding EnableA}">
      <local:ParamUserControl>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="PreviewMouseDown">
            <PCommon:ParamsEventCommand Command="{Binding ParamItemSelectedCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </local:ParamUserControl>
    </Border>
  </DataTemplate>
  <Style x:Key="{x:Type localParamTab:LeftRightControl}" TargetType="{x:Type localParamTab:LeftRightControl}">
    <Setter Property="localParamTab:LeftRightControl.ChildLeftWidth" Value="{Binding ChildLeftWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ParamListView}}}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Instance, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ParamListView}}}" Value="{x:Null}">
        <Setter Property="localParamTab:LeftRightControl.ChildLeftWidth" Value="{Binding Converter={StaticResource LeftWidthConverter}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ParamGroupItemStyle" TargetType="{x:Type GroupItem}">
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupItem}">
          <HeaderedContentControl Name="groupContainer" BorderThickness="0">
            <HeaderedContentControl.Header>
              <DockPanel Margin="{Binding ChildHeaderMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ParamListView}}}">
                <Rectangle Name="rec" Fill="#FFE0DFDE" Height="1" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="0,0,18,0" />
                <TextBlock Name="ht" Margin="0,20,0,0" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource Col_ModuleConfig_Title_Foreground}" Width="auto" Text="{Lang:ResourceBinding Name.NameA}" />
              </DockPanel>
            </HeaderedContentControl.Header>
            <ItemsPresenter />
          </HeaderedContentControl>
          <ControlTemplate.Triggers>
            <DataTrigger Value="0">
              <DataTrigger.Binding>
                <MultiBinding Converter="{StaticResource groupIndexConverter}">
                  <Binding />
                  <Binding Path="ItemsSource" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" />
                </MultiBinding>
              </DataTrigger.Binding>
              <Setter TargetName="rec" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="CategoryNoHead" Binding="{Binding Name.DisplayType}">
              <Setter TargetName="ht" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding Name.CustomVisibleA}">
              <Setter TargetName="groupContainer" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ParamItemStyle" TargetType="{x:Type ContentPresenter}">
    <Style.Triggers>
      <DataTrigger Value="false" Binding="{Binding CustomVisibleA}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ParamListViewStyle" TargetType="{x:Type ItemsControl}">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FF042271" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ItemsControl}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ScrollViewer Tag="1" Style="{StaticResource RecScrollViewer}">
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ParamListViewStyleNoScro" TargetType="{x:Type ItemsControl}">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FF042271" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ItemsControl}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>