  <DataTemplate x:Key="ParamLimit">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <localParamTab:LeftRightControl Row="0" Height="32" Margin="{Binding MarginA}">
        <localParamTab:LeftRightControl.LeftContent>
          <TextBlock VerticalAlignment="Center">
            <TextBlock.Text>
              <MultiBinding StringFormat=" {0}判断">
                <Binding Path="DisplayNameA" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </localParamTab:LeftRightControl.LeftContent>
        <localParamTab:LeftRightControl.RightContent>
          <localcontrol:BooleanControl IsChecked="{Binding DataContextA.EnableA, Mode=TwoWay}">
            <localcontrol:BooleanControl.OffContent>
              <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/swith_off.png" />
            </localcontrol:BooleanControl.OffContent>
            <localcontrol:BooleanControl.OnContent>
              <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/swith_on.png" />
            </localcontrol:BooleanControl.OnContent>
          </localcontrol:BooleanControl>
        </localParamTab:LeftRightControl.RightContent>
      </localParamTab:LeftRightControl>
      <localParamTab:LeftRightControl Row="1" Height="32" Visibility="{Binding DataContextA.EnableA, Converter={StaticResource bool2VisibilityConverter}}" Margin="{Binding MarginA}">
        <localParamTab:LeftRightControl.LeftContent>
          <TextBlock VerticalAlignment="Center">
            <TextBlock.Text>
              <MultiBinding StringFormat=" {0}范围">
                <Binding Path="DisplayNameA" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </localParamTab:LeftRightControl.LeftContent>
        <localParamTab:LeftRightControl.RightContent>
          <vm_port_0:SliderArrangeFloat Minimum="-9999" Maximum="9999" MinimumLeft="-9999" MaximumRight="9999" SliderType="between" SliderTickFrequency="{Binding IncValueA}" StartValue="{Binding DataContextA.MinValueA, Mode=TwoWay}" EndValue="{Binding DataContextA.MaxValueA, Mode=TwoWay}" MaximumLeft="{Binding DataContextA.MaxValueA}" MinimumRight="{Binding DataContextA.MinValueA}" DecimalDigits="{Binding DecimalDigitsA}" />
        </localParamTab:LeftRightControl.RightContent>
      </localParamTab:LeftRightControl>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CalibResultDescription">
    <TextBlock Name="TextBlock" HorizontalAlignment="Left" Margin="30,0,0,0" TextWrapping="Wrap" Foreground="#FF000000" VerticalAlignment="Stretch" FontFamily="楷体" FontSize="16" Text="{Binding CurValueA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
  </DataTemplate>
  <Style x:Key="InputParamListStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <ContentControl Content="{Binding}">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <StackPanel Margin="30,0,10,0">
                  <TextBlock Text="分支订阅" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource ParamHeadTextBlock}" />
                  <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.5*" />
                      <ColumnDefinition Width="1.5*" />
                      <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Param Name}" Grid.Column="0" Style="{StaticResource ParamHeadTextBlock}" />
                    <TextBlock Text="{DynamicResource Lang_GlobalVariableDefaultValue}" Grid.Column="1" Style="{StaticResource ParamHeadTextBlock}" />
                    <TextBlock Text="{DynamicResource Params Subscribe}" Grid.Column="2" Style="{StaticResource ParamHeadTextBlock}" />
                  </Grid>
                  <ListBox Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource InputParamStyle}" ItemsSource="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="InputParamList">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <ListBox Width="540" Grid.Row="0" Background="#00FFFFFF" BorderThickness="0" AlternationCount="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource InputParamListStyle}" ItemsSource="{Binding Operation.InputDicListA}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="IPString">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <localcontrol:IPTextBox VerticalContentAlignment="Center" IP="{Binding CurValueA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsValid="{Binding IsValidA, Mode=TwoWay}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="OnIPValueChange">
              <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </localcontrol:IPTextBox>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="PasswordString">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <localcontrol:PasswordTextBox VerticalContentAlignment="Center" Password="{Binding CurValueA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="OnPasswordChange">
              <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </localcontrol:PasswordTextBox>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationSendEvent_Sub">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <localParamTab:ComboBoxNoWheel x:Name="cb" Grid.Column="0" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding CurValueA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
          </i:EventTrigger>
          <i:EventTrigger EventName="DropDownOpened">
            <i:InvokeCommandAction Command="{Binding RefreshListCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </localParamTab:ComboBoxNoWheel>
      <Button Grid.Column="1" Margin="0,0,0,0" ToolTip="{DynamicResource Lang_ControllerSet}" HorizontalAlignment="Right" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_modal_视觉控制器_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_modal_视觉控制器_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationSendEvent">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource EnumerationSendEvent_Sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="IntegerDynamic">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" Text="{Binding DisplayNameA}" ToolTip="{Binding DescriptionA}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource Integer_Sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="FloatBxDynamic">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" Text="{Binding DisplayNameA}" ToolTip="{Binding DescriptionA}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource Float_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationBxDynamic">
    <localParamTab:LeftRightControl>
      <localParamTab:LeftRightControl.LeftContent>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
          </Grid.RowDefinitions>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" Text="{Binding DisplayNameA}" ToolTip="{Binding DescriptionA}" />
        </Grid>
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
          </Grid.RowDefinitions>
          <ContentControl ContentTemplate="{StaticResource EnumerationBx_sub}" Content="{Binding}" />
        </Grid>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="StringBxDynamic">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" Text="{Binding DisplayNameA}" ToolTip="{Binding DescriptionA}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <Border Margin="0,4,0,1" Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource ListViewComboBoxBordBrush}" CornerRadius="2">
          <PControl:HikTextBox Foreground="{DynamicResource HikTextBoxFg}" FontSize="14" Background="{DynamicResource ListViewComboBoxBackground}" VerticalContentAlignment="Center" TextWrapping="Wrap" Style="{DynamicResource TextBox1}" BorderBrush="{x:Null}" Text="{Binding CurValueA}" IsReadOnly="{Binding IsReadOnlyA}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </PControl:HikTextBox>
        </Border>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="BooleanBxDynamic">
    <localParamTab:LeftRightControl Height="32" Margin="{Binding MarginA}">
      <localParamTab:LeftRightControl.LeftContent>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" Text="{Binding DisplayNameA}" ToolTip="{Binding DescriptionA}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource Boolean_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
</ResourceDictionary>