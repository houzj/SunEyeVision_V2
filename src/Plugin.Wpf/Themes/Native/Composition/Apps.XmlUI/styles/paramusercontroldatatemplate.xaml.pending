  <DataTemplate x:Key="PointFLimit">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <localParamTab:LeftRightControl Row="0" Height="32" Margin="{Binding MarginA}">
          <localParamTab:LeftRightControl.LeftContent>
            <TextBlock VerticalAlignment="Center">
              <TextBlock.Text>
                <MultiBinding StringFormat=" {0}X判断">
                  <Binding Path="DisplayNameA" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </localParamTab:LeftRightControl.LeftContent>
          <localParamTab:LeftRightControl.RightContent>
            <localcontrol:BooleanControl IsChecked="{Binding DataContextA.XLimitA.EnableA, Mode=TwoWay}">
              <localcontrol:BooleanControl.OffContent>
