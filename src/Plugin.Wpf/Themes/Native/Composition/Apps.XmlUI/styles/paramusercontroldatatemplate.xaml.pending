  <DataTemplate x:Key="Expand">
    <ToggleButton Height="30" Margin="0,0,40,0" HorizontalAlignment="Right" Padding="6,0,0,0" VerticalContentAlignment="Center" Content="{DynamicResource 高级参数}" Style="{StaticResource ExpandButtonStyle}" IsChecked="{Binding CurValueA, Mode=TwoWay}" />
  </DataTemplate>
  <DataTemplate x:Key="Enumeration_Sub">
    <ComboBox Name="cb" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding CurValueA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="SelectionChanged">
          <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
        </i:EventTrigger>
