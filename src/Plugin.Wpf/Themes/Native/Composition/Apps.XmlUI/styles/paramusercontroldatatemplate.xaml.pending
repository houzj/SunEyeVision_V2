        <TextBlock Text="{DynamicResource Lang_GlobalVariableDefaultValue}" Grid.Column="1" Style="{StaticResource ParamHeadTextBlock}" />
        <TextBlock Text="{DynamicResource Params Subscribe}" Grid.Column="2" Style="{StaticResource ParamHeadTextBlock}" />
      </Grid>
      <ListBox Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CustomizeInputParamStyle}" localcontrol:ItemsControlExtension.ItemsSource="{Binding NameA}" />
      <localcontrol:ButtonControl Margin="34,0,0,0" HorizontalAlignment="Left" Style="{StaticResource IcAddBtnStyle}" DataName="{Binding CommandNameA}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="CustomizeInputParamForGrasp">
    <StackPanel Margin="30,0,10,0">
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Param Name}" Grid.Column="0" Style="{StaticResource ParamHeadTextBlock}" />
        <TextBlock Text="{DynamicResource Lang_GlobalVariableDefaultValue}" Grid.Column="1" Style="{StaticResource ParamHeadTextBlock}" />
        <TextBlock Text="{DynamicResource Params Subscribe}" Grid.Column="2" Style="{StaticResource ParamHeadTextBlock}" />
      </Grid>
      <ListBox Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource InputParamStyle}" localcontrol:ItemsControlExtension.ItemsSource="{Binding NameA}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="35" />
          <ColumnDefinition Width="35" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <localcontrol:ButtonControl Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" Style="{StaticResource IcAddBtnStyle}" DataName="{Binding CommandNameA}" />
        <localcontrol:ButtonControl Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" Style="{StaticResource DeleteBtnStyle}" DataName="{Binding DelCommandNameA}" />
      </Grid>
    </StackPanel>
  </DataTemplate>
  <Style x:Key="CustomizeInputParamStyle1" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <TextBox Height="30" Margin="0,0,10,0" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource NormalTextBoxStyle}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Description}" IsReadOnly="{Binding IsReadOnly}" />
            <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" ToolTip="{Binding Value}" Text="{Binding Value}" />
            <ContentControl Grid.Column="2" Height="30" ContentTemplate="{StaticResource ButtonSelecter_Simple_sub}" Content="{Binding ParamValue}" />
            <Button Grid.Column="3" Content="…" VerticalAlignment="Center" Style="{StaticResource EditBtnStyle}" Command="{Binding EditParamCommand}" Visibility="{Binding IsCanDelete, Converter={StaticResource bool2VisibilityConverter}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Description}" />
  </Style>
  <DataTemplate x:Key="CustomizeInputParamForMeasure">
    <StackPanel Margin="30,0,10,0">
      <ListBox Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CustomizeInputParamStyle1}" localcontrol:ItemsControlExtension.ItemsSource="{Binding NameA}" />
    </StackPanel>
  </DataTemplate>
  <Style x:Key="CustomizeOutputParamStyle1" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <TextBox Height="30" Margin="0,0,10,0" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource NormalTextBoxStyle}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Description}" IsReadOnly="{Binding IsReadOnly}" />
            <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" ToolTip="{Binding Value}" Text="{Binding Value}" />
            <Button Grid.Column="2" Content="…" VerticalAlignment="Center" Style="{StaticResource EditBtnStyle}" Command="{Binding EditParamCommand}" Visibility="{Binding IsCanDelete, Converter={StaticResource bool2VisibilityConverter}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Description}" />
  </Style>
  <DataTemplate x:Key="CustomizeOutputParamForMeasure">
    <StackPanel Margin="30,0,10,0">
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.5*" />
          <ColumnDefinition Width="1.5*" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Param Name}" Grid.Column="0" Style="{StaticResource ParamHeadTextBlock}" />
