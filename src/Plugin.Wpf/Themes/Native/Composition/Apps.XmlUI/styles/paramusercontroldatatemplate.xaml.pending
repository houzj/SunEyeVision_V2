  <DataTemplate x:Key="Boolean_SaveImage">
    <localParamTab:LeftRightControl Height="32" Margin="{Binding MarginA}">
      <localParamTab:LeftRightControl.RightContent>
        <StackPanel Orientation="Horizontal">
          <ContentControl ContentTemplate="{StaticResource Boolean_sub}" Content="{Binding}" />
          <Button ToolTip="{DynamicResource Lang_CheckConnectionStatus}" Margin="5,-2,0,0" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
            <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_dialog_FTPcheck_normal.png" />
