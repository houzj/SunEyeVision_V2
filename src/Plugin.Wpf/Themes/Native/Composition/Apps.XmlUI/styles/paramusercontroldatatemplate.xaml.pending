  <ControlTemplate x:Key="OpenFileForCNNDialogControlTemplate" TargetType="{x:Type ComboBox}">
    <Grid Name="MainGrid" SnapsToDevicePixels="True">
      <Popup Name="PART_Popup" AllowsTransparency="True" Margin="1" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" HorizontalOffset="{Binding HorizontalOffsetVal, RelativeSource={RelativeSource TemplatedParent}}" VerticalOffset="{Binding VerticalOffsetVal, RelativeSource={RelativeSource TemplatedParent}}">
        <Border Background="#FFFFFFFF" BorderBrush="#FFD3D3D3" BorderThickness="1" CornerRadius="2">
          <ItemsControl Margin="5" ItemsSource="{Binding MsgsA}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid MaxWidth="360" Height="30">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>
                  <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Lang:ResourceBinding DisplayNameA}" />
                  <PCommon:PerSuperImageButton Name="btn" Grid.Column="1" NormalSource="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_copy_normal.png" MoveOverSource="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_copy_click.png" PressedSource="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_copy_click.png" DisableSource="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_copy_normal.png" ToolTip="{Lang:LangResource Chooce}" Command="{Binding DataContext.MsgCopyCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding StrValueA}" Value="{x:Null}">
                    <Setter TargetName="btn" Property="UIElement.Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Popup>
      <Grid Name="GT">
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_flow_group_notice.png" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="ComboBox.IsDropDownOpen" Value="True" />
      </Trigger>
      <DataTrigger Binding="{Binding MsgsA}" Value="{x:Null}">
        <Setter Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
