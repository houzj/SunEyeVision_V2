  <Style x:Key="OutputParamStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" Background="#00FFFFFF" Grid.Column="0" Style="{StaticResource NormalTextBoxStyle}" ToolTip="{Binding Description}" IsReadOnly="{Binding IsReadOnly}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <TextBox Name="Default" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="False" Background="#00FFFFFF" Grid.Column="1" Style="{StaticResource NormalTextBoxStyle}" ToolTip="{Binding Description}" Text="{Binding DefaultValueA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <TextBox Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Grid.Column="2" Style="{StaticResource DescriptionTextBoxStyle}" Text="{Binding Value}" />
            <TextBox Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Grid.Column="3" Style="{StaticResource DescriptionTextBoxStyle}" ToolTip="{Binding Description}" Text="{Binding Description}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Description}" />
  </Style>
  <DataTemplate x:Key="OutputParam">
