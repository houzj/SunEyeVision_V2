  <DataTemplate x:Key="BottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Lang:ResourceBinding DisplayNameA}" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="ClockSource">
    <localcontrol:ClockSourceControl Milliseconds="{Binding MillisecondsA}" ClockIsEnabled="{Binding EnableA}" TickCommand="{Binding TickCommand}" />
  </DataTemplate>
  <DataTemplate x:Key="ContinuousExecuteBottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Lang:ResourceBinding DisplayNameA}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Path=Solution.(VMInterface:IVmSolution.IsContinuousSelfExecute)}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Path=Procedure.(VMInterface:IVMRun.IsRunning)}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding Path=Procedure.(VMInterface:IVMRun.RunEnable)}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="ExecuteOnceBottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Lang:ResourceBinding DisplayNameA}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Path=Solution.(VMInterface:IVmSolution.IsContinuousSelfExecute)}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Path=Procedure.(VMInterface:IVMRun.IsRunning)}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding Path=Procedure.(VMInterface:IVMRun.RunEnable)}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="StopExecuteBottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Lang:ResourceBinding DisplayNameA}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding Path=Solution.(VMInterface:IVmSolution.IsContinuousSelfExecute)}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_Simple_sub">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <localParamTab:DeleteTextBox Grid.Column="0" Background="#00FFFFFF" FontSize="14" Foreground="{Binding ReadOnlyA, Converter={StaticResource FgConverter}}" IsReadOnly="{Binding ReadOnlyA}" Text="{Binding CurValueA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <PControl:PopupButton Name="rt" Grid.Column="1" HorizontalOffsetVal="-150" Style="{StaticResource LinkPopButton}" IsPopupOpen="{Binding IsDropDownOpen, Mode=TwoWay}">
        <PControl:PopupButton.SubContent>
          <DataTemplate>
            <Border Margin="0,4,0,0" BorderBrush="{DynamicResource TextBox.Static.Border}" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6" Background="{DynamicResource ComboBoxBorderS}">
              <localParamTab:SubTreeView Width="Auto" MinWidth="180" Height="180">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                    <PCommon:ParamsEventCommand Command="{Binding ClickCommand}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </localParamTab:SubTreeView>
            </Border>
          </DataTemplate>
        </PControl:PopupButton.SubContent>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="DropDownOpened">
            <i:InvokeCommandAction Command="{Binding DropDownCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </PControl:PopupButton>
      <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource TextBox.Static.Border}" Grid.Column="0" Grid.ColumnSpan="2" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_sub">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="2" CornerRadius="2">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsSelectedSubscribeParam}">
                <Setter Property="BorderThickness" Value="3" />
                <Setter Property="BorderBrush" Value="{DynamicResource Col_Theme_Mouse}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Border>
      <PControl:PopupButton Name="et" Grid.Column="0" HorizontalOffsetVal="0" Style="{x:Null}" IsPopupOpen="{Binding IsTextDropDownOpen, Mode=TwoWay}">
        <PControl:PopupButton.ButtonStyle>
          <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <localParamTab:DeleteTextBox Background="#00FFFFFF" FontSize="14" Foreground="{Binding ReadOnlyA, Converter={StaticResource FgConverter}}" IsReadOnly="{Binding ReadOnlyA}" Text="{Binding CurValueA, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="OnTBFoucsChanged">
                        <PCommon:ParamsEventCommand Command="{Binding FocusedCommand}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </localParamTab:DeleteTextBox>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </PControl:PopupButton.ButtonStyle>
        <PControl:PopupButton.SubContent>
          <DataTemplate>
            <Border Margin="0,4,0,0" BorderBrush="{DynamicResource TextBox.Static.Border}" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6" Background="{DynamicResource ComboBoxBorderS}" Visibility="{Binding IsTextPopupVisible, Converter={StaticResource bool2VisibilityConverter}}">
              <localParamTab:SubTreeView Width="180" Height="180">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                    <PCommon:ParamsEventCommand Command="{Binding IndexClickCommand}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </localParamTab:SubTreeView>
            </Border>
          </DataTemplate>
        </PControl:PopupButton.SubContent>
      </PControl:PopupButton>
      <PControl:PopupButton Name="rt" Grid.Column="1" HorizontalOffsetVal="-150" Style="{StaticResource LinkPopButton}" IsPopupOpen="{Binding IsDropDownOpen, Mode=TwoWay}">
        <PControl:PopupButton.SubContent>
          <DataTemplate>
            <Grid Background="#00FFFFFF" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="27" />
              </Grid.ColumnDefinitions>
              <Border BorderBrush="{DynamicResource TextBox.Static.Border}" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6" Background="{DynamicResource ComboBoxBorderS}">
                <localParamTab:SubTreeView Width="180" Height="180">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                      <PCommon:ParamsEventCommand Command="{Binding ClickCommand}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </localParamTab:SubTreeView>
              </Border>
              <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{DynamicResource Lang_OpenSubscriptionWindow}" Style="{StaticResource PopWindowButtonStyle}" Command="{Binding PopSubscribeWindowCommand}" Visibility="{Binding SubscribeInPopWindowEnableA, Converter={StaticResource bool2VisibilityConverter}}" />
            </Grid>
          </DataTemplate>
        </PControl:PopupButton.SubContent>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="DropDownOpened">
            <i:InvokeCommandAction Command="{Binding DropDownCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </PControl:PopupButton>
      <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource TextBox.Static.Border}" Grid.Column="0" Grid.ColumnSpan="2" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecter_Simple_tag_sub">
