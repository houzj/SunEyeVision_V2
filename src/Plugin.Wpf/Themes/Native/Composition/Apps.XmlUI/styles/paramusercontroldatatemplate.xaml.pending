    <DisplayForGroupControl:DynamicRunParamButton HorizontalAlignment="Left" Margin="2,0,0,0" Content="{DynamicResource Lang_SetCnfg}" Padding="4,0" Style="{StaticResource BottomButtonStyle}" Command="{Binding DataContext.OpenDialogCommand, RelativeSource={RelativeSource AncestorType=local:ParamUserControl, AncestorLevel=2}}" CommandParameter="{Binding EditMethod, RelativeSource={RelativeSource Mode=Self}}" />
  </DataTemplate>
  <DataTemplate x:Key="ConfigDialog">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
