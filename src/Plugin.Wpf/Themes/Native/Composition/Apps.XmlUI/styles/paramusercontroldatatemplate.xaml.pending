            <ComboBox Grid.Column="2" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysNameTypeA, Mode=OneWay}" SelectedValue="{Binding NameTypeA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
