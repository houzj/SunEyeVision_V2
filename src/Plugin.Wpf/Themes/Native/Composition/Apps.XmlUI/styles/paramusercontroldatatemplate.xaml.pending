  </ControlTemplate>
  <DataTemplate x:Key="AddButton">
    <StackPanel Orientation="Horizontal" Margin="{Binding EnumEntrysA, Converter={StaticResource addButtonMarginConvert}}">
      <ComboBox SelectedIndex="0" DisplayMemberPath="DisplayNameALang" Width="68" Height="32" Margin="10,0" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA}" SelectedValue="{Binding CurValueA, Mode=TwoWay}" Visibility="{Binding EnumEntrysA, Converter={StaticResource comboxVisbileConvert}}" />
      <Button Margin="5" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/add_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/add_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Boolean_subEx">
    <localcontrol:BooleanControl HorizontalAlignment="Left" ToolTip="{Lang:ResourceBinding ToolTipStringA, Mode=TwoWay}" IsChecked="{Binding CurValueA, Mode=TwoWay}">
      <localcontrol:BooleanControl.OffContent>
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/swith_off.png" />
      </localcontrol:BooleanControl.OffContent>
      <localcontrol:BooleanControl.OnContent>
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/swith_on.png" />
      </localcontrol:BooleanControl.OnContent>
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="OnCheckedChange">
          <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </localcontrol:BooleanControl>
  </DataTemplate>
  <DataTemplate x:Key="Boolean_sub">
    <localcontrol:BooleanControl HorizontalAlignment="Left" IsChecked="{Binding CurValueA, Mode=TwoWay}">
