                <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </RadioButton>
          <RadioButton Grid.Column="1" Style="{StaticResource UserSelectBtnStyle}" Content="{Lang:ResourceBinding Options2A}" IsChecked="{Binding CurValueA2, Mode=OneWay}">
