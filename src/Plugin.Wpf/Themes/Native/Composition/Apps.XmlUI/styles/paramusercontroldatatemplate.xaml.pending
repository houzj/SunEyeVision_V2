        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
          </Grid.ColumnDefinitions>
          <ContentControl ContentTemplate="{StaticResource String_sub}" Content="{Binding}" Visibility="{Binding IsSubA, Converter={StaticResource Boolean2VisibilityReverse}}" />
          <ContentControl ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding SubData}" Visibility="{Binding IsSubA, Converter={StaticResource bool2VisibilityConverter}}" />
          <ToggleButton Grid.Column="1" Style="{StaticResource EditLinkButton}" IsChecked="{Binding IsSubA, Mode=TwoWay}" Visibility="{Binding SubscribeVisibleA, Converter={StaticResource bool2VisibilityConverter}}" />
        </Grid>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="StringBx">
