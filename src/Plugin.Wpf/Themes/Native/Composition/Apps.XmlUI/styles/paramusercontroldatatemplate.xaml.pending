                  <vm_port_0:SliderArrangeFloat Grid.Row="2" Grid.Column="3" SliderTickFrequency="{Binding Path=DataContext.ItemsA[2].IncValueA, ElementName=paramControl}" StartValue="{Binding TeachWorldA.R, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[2].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[2].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[2].DecimalDigitsA, ElementName=paramControl}" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="3" Grid.Column="1" SliderTickFrequency="{Binding Path=DataContext.ItemsA[3].IncValueA, ElementName=paramControl}" StartValue="{Binding PhotoWorldA.X, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[3].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[3].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[3].DecimalDigitsA, ElementName=paramControl}" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="3" Grid.Column="2" SliderTickFrequency="{Binding Path=DataContext.ItemsA[3].IncValueA, ElementName=paramControl}" StartValue="{Binding PhotoWorldA.Y, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[3].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[3].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[3].DecimalDigitsA, ElementName=paramControl}" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="3" Grid.Column="3" SliderTickFrequency="{Binding Path=DataContext.ItemsA[3].IncValueA, ElementName=paramControl}" StartValue="{Binding PhotoWorldA.R, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[3].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[3].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[3].DecimalDigitsA, ElementName=paramControl}" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="4" Grid.Column="1" SliderTickFrequency="{Binding Path=DataContext.ItemsA[4].IncValueA, ElementName=paramControl}" StartValue="{Binding CalibWorldA.X, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[4].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[4].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[4].DecimalDigitsA, ElementName=paramControl}" />
