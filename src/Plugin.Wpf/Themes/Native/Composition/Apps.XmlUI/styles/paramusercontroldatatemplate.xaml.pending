          <i:InvokeCommandAction Command="{Binding FloatsA[0].TypeChangeCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="OnRightTypeChange">
          <i:InvokeCommandAction Command="{Binding FloatsA[1].TypeChangeCommand}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </vm_port_1:SliderArrangeFloat>
  </DataTemplate>
  <DataTemplate x:Key="FloatBettween">
