  <DataTemplate x:Key="RadioSelecter_Branch">
    <Grid Height="32" Margin="34,1,70,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <RadioButton Focusable="True" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource NormalRadioButton}" Content="{Binding EnumEntrysA[0].DisplayNameALang}">
        <ToggleButton.IsChecked>
          <MultiBinding Mode="OneWay" Converter="{StaticResource equalConverter}">
            <Binding Path="CurValueA" />
            <Binding Path="EnumEntrysA[0].ValueA" />
          </MultiBinding>
        </ToggleButton.IsChecked>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Checked">
            <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" CommandParameter="{Binding EnumEntrysA[0].ValueA}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </RadioButton>
      <RadioButton Focusable="True" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource NormalRadioButton}" Content="{Binding EnumEntrysA[1].DisplayNameALang}">
        <ToggleButton.IsChecked>
          <MultiBinding Mode="OneWay" Converter="{StaticResource equalConverter}">
            <Binding Path="CurValueA" />
            <Binding Path="EnumEntrysA[1].ValueA" />
          </MultiBinding>
        </ToggleButton.IsChecked>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Checked">
            <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" CommandParameter="{Binding EnumEntrysA[1].ValueA}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </RadioButton>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="PointPair">
    <Grid>
      <ContentControl>
        <Control.Template>
          <ControlTemplate TargetType="{x:Type ContentControl}">
            <Grid Margin="0,0,10,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                <TextBlock Text="{DynamicResource 对位示教点}" Style="{StaticResource CategoryHeader}" />
                <TextBlock Style="{StaticResource CategoryHeader}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                      <Binding Path="DisplayIndexA" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="—" Style="{StaticResource CategoryHeader}" />
                <TextBlock Text="{DynamicResource Unfixtured Point}" Style="{StaticResource CategoryHeader}" />
                <TextBlock Style="{StaticResource CategoryHeader}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                      <Binding Path="DisplayIndexA" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
              <Button Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
                <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/delete_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/delete_click.png" />
                </FrameworkElement.Tag>
              </Button>
              <localParamTab:LeftRightControl Row="1" ChildLeftWidth="50">
                <localParamTab:LeftRightControl.LeftContent>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                          <Setter Property="FontWeight" Value="Normal" />
                          <Setter Property="Foreground" Value="#666666" />
                        </Style>
                        <Style x:Key="GridStyle" TargetType="{x:Type Grid}">
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                    <Grid Row="0" Margin="0,0,0,0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Grid}" BasedOn="{StaticResource GridStyle}">
                          <Style.Triggers>
                            <DataTrigger Value="False" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock Text="{DynamicResource Point}" />
                    </Grid>
                    <Grid Row="0" Margin="0,0,0,0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Grid}" BasedOn="{StaticResource GridStyle}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock Text="{DynamicResource PointX}" />
                    </Grid>
                    <Grid Row="1" Margin="0,23,0,0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Grid}" BasedOn="{StaticResource GridStyle}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock Text="{DynamicResource pointy}" />
                    </Grid>
                    <Grid Row="2" Margin="0,23,0,0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Grid}" BasedOn="{StaticResource GridStyle}">
                          <Style.Triggers>
                            <DataTrigger Value="False" Binding="{Binding HasAngleA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock Text="{DynamicResource Angle}" />
                    </Grid>
                  </Grid>
                </localParamTab:LeftRightControl.LeftContent>
                <localParamTab:LeftRightControl.RightContent>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <Style x:Key="Rect" TargetType="{x:Type Rectangle}">
                          <Setter Property="Margin" Value="3,0" />
                          <Setter Property="Grid.Column" Value="1" />
                          <Setter Property="Height" Value="1" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                          <Setter Property="HorizontalAlignment" Value="Stretch" />
                          <Setter Property="Fill" Value="#CECCCB" />
                        </Style>
                        <Style x:Key="RectA" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                          <Style.Triggers>
                            <DataTrigger Value="False" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="RectB" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="RectC" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                          <Setter Property="Visibility" Value="{Binding HasAngleA, Converter={StaticResource bool2VisibilityConverter}}" />
                        </Style>
                        <Style x:Key="cstyle" TargetType="{x:Type ContentControl}">
                          <Setter Property="ContentTemplate" Value="{StaticResource ButtonSelecter_sub}" />
                          <Setter Property="Width" Value="140" />
                          <Setter Property="Margin" Value="0,5" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                          <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                        <Style x:Key="cstyleA" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="False" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="cstyleB" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsPointModeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="cstyleC" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                          <Setter Property="Visibility" Value="{Binding HasAngleA, Converter={StaticResource bool2VisibilityConverter}}" />
                        </Style>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                    <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource cstyleA}" Content="{Binding ObjectPointA}" />
                    <Rectangle Grid.Row="0" Style="{StaticResource Rect}" />
                    <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource cstyleA}" Content="{Binding TargetPointA}" />
                    <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource cstyleB}" Content="{Binding ObjectPointXA}" />
                    <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource cstyleB}" Content="{Binding TargetPointXA}" />
                    <ContentControl Grid.Row="1" Grid.Column="2" Style="{StaticResource cstyleB}" Content="{Binding ObjectPointYA}" />
                    <Rectangle Grid.Row="1" Style="{StaticResource RectB}" />
                    <ContentControl Grid.Row="1" Grid.Column="0" Style="{StaticResource cstyleB}" Content="{Binding TargetPointYA}" />
                    <ContentControl Grid.Row="2" Grid.Column="0" Style="{StaticResource cstyleC}" Content="{Binding TargetPointAngleA}" />
                    <Rectangle Grid.Row="2" Style="{StaticResource RectC}" />
                    <ContentControl Grid.Row="2" Grid.Column="2" Style="{StaticResource cstyleC}" Content="{Binding ObjectPointAngleA}" />
                  </Grid>
                </localParamTab:LeftRightControl.RightContent>
              </localParamTab:LeftRightControl>
            </Grid>
          </ControlTemplate>
        </Control.Template>
      </ContentControl>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="AddButton_PointPair">
    <Grid Height="20" Margin="34,8,40,9">
      <vm_port_3:SuperImageButton Name="ByPoint" Grid.Column="0" Height="20">
