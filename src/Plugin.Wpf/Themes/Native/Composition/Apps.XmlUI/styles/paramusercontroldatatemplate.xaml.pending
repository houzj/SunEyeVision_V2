          <ComboBox Grid.Row="1" Height="32" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" Visibility="{Binding TimeVisibility, Mode=TwoWay}" ItemsSource="{Binding EnumEntrysTimeFormatA, Mode=OneWay}" SelectedValue="{Binding TimeFormatA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="SelectionChanged">
