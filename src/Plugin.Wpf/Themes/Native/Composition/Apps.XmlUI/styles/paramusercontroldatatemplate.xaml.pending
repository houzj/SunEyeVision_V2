  <Style x:Key="InputParamStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <ContentControl ContentTemplateSelector="{StaticResource mydt}" Content="{Binding}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <DataTemplate x:Key="ParamObject">
                  <Grid Margin="0,0,0,3" Visibility="{Binding VisibilityA, Converter={StaticResource bool2VisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Height="30" Margin="0,0,10,0" IsReadOnly="True" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource NormalTextBoxStyle}" ToolTip="{Binding Description}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" Text="{Binding Value}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <ContentControl Grid.Column="2" Margin="0,0,10,0" Height="30" ContentTemplate="{StaticResource ButtonSelecter_Simple_sub}" Content="{Binding ParamValue}" />
                  </Grid>
                </DataTemplate>
                <DataTemplate x:Key="PointFParam">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,3" Visibility="{Binding IsInputByPoint, Converter={StaticResource bool2VisibilityConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Height="30" Margin="0,0,10,0" IsReadOnly="True" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource NormalTextBoxStyle}" ToolTip="{Binding Description}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                      <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" Text="{Binding Value}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                      <ContentControl Grid.Column="2" Margin="0,0,10,0" Height="30" ContentTemplate="{StaticResource ButtonSelecter_Simple_sub}" Content="{Binding ParamValue}" />
                    </Grid>
                    <Grid Row="1" Visibility="{Binding IsInputNotByPoint, Converter={StaticResource bool2VisibilityConverter}}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="0" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                      </Grid.RowDefinitions>
                      <Grid Margin="0,0,0,3" Row="1" DataContext="{Binding ParamObjects[0]}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="1*" />
                          <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="30" Margin="0,0,10,0" IsReadOnly="True" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource PointFValueTextBoxStyle}" Text="{Binding Parent.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Tag="{Binding ValueNameA}" ToolTip="{Binding Name}" />
                        <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" Text="{Binding Value}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <ContentControl Grid.Column="2" Margin="0,0,10,0" Height="30" ContentTemplate="{StaticResource ButtonSelecter_Simple_sub}" Content="{Binding ParamValue}" />
                      </Grid>
                      <Grid Margin="0,0,0,3" Row="2" DataContext="{Binding ParamObjects[1]}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="1*" />
                          <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="30" Margin="0,0,10,0" IsReadOnly="True" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource PointFValueTextBoxStyle}" Text="{Binding Parent.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Tag="{Binding ValueNameA}" ToolTip="{Binding Name}" />
                        <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" Text="{Binding Value}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <ContentControl Grid.Column="2" Margin="0,0,10,0" Height="30" ContentTemplate="{StaticResource ButtonSelecter_Simple_sub}" Content="{Binding ParamValue}" />
                      </Grid>
                      <Grid Margin="0,0,0,3" Row="3" DataContext="{Binding ParamObjects[2]}" Visibility="{Binding IsInputNotByPoint, Converter={StaticResource bool2VisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="1*" />
                          <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="30" Margin="0,0,10,0" IsReadOnly="True" Foreground="#a6a6a6" Background="#00FFFFFF" Style="{StaticResource PointFValueTextBoxStyle}" Text="{Binding Parent.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Tag="{Binding ValueNameA}" ToolTip="{Binding Name}" />
                        <TextBox Grid.Column="1" Margin="0,0,10,0" Foreground="#a6a6a6" Height="30" IsReadOnly="True" Background="#00FFFFFF" Style="{StaticResource DescriptionTextBoxStyle}" Text="{Binding Value}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <ContentControl Grid.Column="2" Margin="0,0,10,0" Height="30" ContentTemplate="{StaticResource ButtonSelecter_Simple_sub}" Content="{Binding ParamValue}" />
                      </Grid>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
