          <PControl:HikTextBox Foreground="{DynamicResource HikTextBoxFg}" FontSize="14" Background="{DynamicResource ListViewComboBoxBackground}" VerticalContentAlignment="Center" TextWrapping="Wrap" Style="{DynamicResource TextBox1}" BorderBrush="{x:Null}" Text="{Binding CurValueA}" IsReadOnly="{Binding IsReadOnlyA}" />
        </Border>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <Style x:Key="ParamHeadTextBlock" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="0,0,10,0" />
