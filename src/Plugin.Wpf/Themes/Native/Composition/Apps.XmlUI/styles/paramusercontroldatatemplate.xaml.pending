  <DataTemplate x:Key="RowNumTemplate">
    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#666666" Text="{Binding Path=Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}}" />
  </DataTemplate>
  <DataTemplate x:Key="Lable_EdgeInspGroup">
    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="#666666" Text="{Lang:ResourceBinding DisplayNameA}" />
  </DataTemplate>
  <DataTemplate x:Key="ButtonCommand_EdgeInspGroup">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
      <ToggleButton Name="t1" Height="24" BorderThickness="1" Content="{Lang:ResourceBinding DisplayNameA_Btn1}" IsChecked="{Binding Checked_Btn1}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource ToggleButtonEditStyle}" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="80" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding TabNum, Converter={StaticResource TabNumConverter}}">
                <Setter Property="Width" Value="66" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <PCommon:ParamsEventCommand Command="{Binding ClickCommand_1}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <core1:ChangePropertyAction PropertyName="IsChecked" Value="false" i:TargetedTriggerAction.TargetObject="{Binding ElementName=t2}" />
            <ChangePropertyAction PropertyName="IsChecked" Value="false" i:TargetedTriggerAction.TargetObject="{Binding ElementName=t3}" xmlns="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ToggleButton>
      <ToggleButton Name="t2" Height="24" BorderThickness="0,1,1,1" Content="{Lang:ResourceBinding DisplayNameA_Btn2}" IsChecked="{Binding Checked_Btn2}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource ToggleButtonEditStyle}" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="80" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding TabNum, Converter={StaticResource TabNumConverter}}">
                <Setter Property="Width" Value="66" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <PCommon:ParamsEventCommand Command="{Binding ClickCommand_2}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <ChangePropertyAction PropertyName="IsChecked" Value="false" i:TargetedTriggerAction.TargetObject="{Binding ElementName=t1}" xmlns="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" />
            <ChangePropertyAction PropertyName="IsChecked" Value="false" i:TargetedTriggerAction.TargetObject="{Binding ElementName=t3}" xmlns="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ToggleButton>
      <ToggleButton Name="t3" Width="66" Height="24" BorderThickness="0,1,1,1" Content="{Lang:ResourceBinding DisplayNameA_Btn3}" IsChecked="{Binding Checked_Btn3}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource ToggleButtonEditStyle}" TargetType="{x:Type ToggleButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding TabNum, Converter={StaticResource TabNumConverter}}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <PCommon:ParamsEventCommand Command="{Binding ClickCommand_3}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <ChangePropertyAction PropertyName="IsChecked" Value="false" i:TargetedTriggerAction.TargetObject="{Binding ElementName=t1}" xmlns="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" />
            <ChangePropertyAction PropertyName="IsChecked" Value="false" i:TargetedTriggerAction.TargetObject="{Binding ElementName=t2}" xmlns="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ToggleButton>
    </StackPanel>
  </DataTemplate>
