  </DataTemplate>
  <DataTemplate x:Key="ButtonSelecterSub_Del">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <ContentControl Grid.Column="0" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding}" />
      <Button Grid.Column="1" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/delete_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/delete_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationCommunication">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource Enumeration_Sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationLight_Sub">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox Name="cb" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding CurValueA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
          </i:EventTrigger>
          <i:EventTrigger EventName="DropDownOpened">
            <i:InvokeCommandAction Command="{Binding RefreshListCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
      <Button Grid.Column="1" Margin="0,0,0,0" ToolTip="{DynamicResource Lang_ControllerSet}" HorizontalAlignment="Right" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding ClickCommand}">
        <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_modal_视觉控制器_normal.png" />
        <FrameworkElement.Tag>
          <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ic_modal_视觉控制器_click.png" />
        </FrameworkElement.Tag>
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationLight">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource EnumerationLight_Sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationTrigger_Sub">
    <Grid>
      <ComboBox Name="cb" DisplayMemberPath="DisplayNameA" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding TriggerProcessID, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding SelectedChangedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=cb}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EnumerationTrigger">
