  <DataTemplate x:Key="Command_sub">
    <Button Padding="4,0,4,0" Width="auto" HorizontalAlignment="Left" Style="{StaticResource BottomButtonStyle}" Content="{Lang:ResourceBinding DisplayNameA}" Command="{Binding ClickCommand}" />
