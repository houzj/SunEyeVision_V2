      <localParamTab:LeftRightControl.LeftContent>
        <ContentControl ContentTemplate="{StaticResource BooleanCheck_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Col_ModuleConfig_List_Foreground}" VerticalAlignment="Center" Text="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" />
      </localParamTab:LeftRightControl.RightContent>
