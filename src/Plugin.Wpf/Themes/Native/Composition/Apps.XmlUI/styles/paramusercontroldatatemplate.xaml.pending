  <DataTemplate x:Key="CommandWithTip_sub">
    <Button Padding="4,0,4,0" Width="140" HorizontalAlignment="Left" Style="{StaticResource BottomButtonStyle}" Content="{Lang:ResourceBinding DisplayNameA}" ToolTip="{Lang:ResourceBinding DescriptionA}" Command="{Binding ClickCommand}" />
  </DataTemplate>
  <DataTemplate x:Key="CommandWithTip">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl ContentTemplate="{StaticResource CommandWithTip_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <Style x:Key="listboxItemStyle1" TargetType="{x:Type ListBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBox.Normal.Forground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
    <Setter Property="Background" Value="{DynamicResource ListViewComboBoxBackground}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="{x:Type ListBoxItem}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListBoxItem}">
                <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Back" Value="{DynamicResource ListViewComboBoxIsSelected}" Property="Border.Background" />
                  </Trigger>
                  <Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <Setter TargetName="Back" Value="{DynamicResource ListViewComboBoxIsSelected}" Property="Border.Background" />
                    <Setter Value="{DynamicResource TitleColor}" Property="Foreground" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DropPopButton" TargetType="{x:Type PControl:PopupButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="PControl:PopupButton.ButtonStyle">
      <Setter.Value>
        <Style TargetType="{x:Type ToggleButton}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid Background="#00FFFFFF">
                  <Image Name="icon" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="16" Width="16" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/combo_ic_triangle_normal.png" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/combo_ic_triangle_click.png" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/combo_ic_triangle_click.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="ComboxEdit_sub">
    <Grid Height="34">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <TextBox Margin="10,0,0,0" Grid.Column="0" AllowDrop="False" Background="#00FFFFFF" BorderThickness="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource TextBox.Normal.Forground}" Text="{Binding CurValueA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding CurValueA}" MaxLength="{Binding LengthA}" />
      <PControl:PopupButton Name="rt" Grid.Column="1" HorizontalOffsetVal="-70" Style="{StaticResource DropPopButton}" IsPopupOpen="{Binding IsDropDownOpen, Mode=TwoWay}">
        <PControl:PopupButton.SubContent>
          <DataTemplate>
            <Border Margin="0,4,0,0" BorderBrush="{DynamicResource TextBox.Static.Border}" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6" Background="{DynamicResource ComboBoxBorderS}">
              <ListBox DisplayMemberPath="ValueA" BorderThickness="0" BorderBrush="#00FFFFFF" Width="100" Style="{StaticResource listboxItemStyle1}" ItemsSource="{Binding EnumEntrysA}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="SelectionChanged">
                    <PCommon:ParamsEventCommand Command="{Binding SelectedChangedCommand}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </ListBox>
            </Border>
          </DataTemplate>
        </PControl:PopupButton.SubContent>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="DropDownOpened">
            <i:InvokeCommandAction Command="{Binding DropDownCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </PControl:PopupButton>
      <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource TextBox.Static.Border}" Grid.Column="0" Grid.ColumnSpan="2" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ComboxEdit">
    <localParamTab:LeftRightControl Height="34">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl Width="100" HorizontalAlignment="Left" ContentTemplate="{StaticResource ComboxEdit_sub}" Content="{Binding}" />
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="StringName">
    <localParamTab:LeftRightControl Height="64">
      <localParamTab:LeftRightControl.LeftContent>
        <Grid Height="64">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Control Template="{StaticResource TextLeft}" />
        </Grid>
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <Grid Height="64">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="15" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <ContentControl Margin="0,1,0,1" ContentTemplate="{StaticResource ButtonSelecter_sub}" Content="{Binding FileNameA}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="-" />
            <ComboBox Grid.Column="2" DisplayMemberPath="DisplayNameALang" SelectedValuePath="ValueA" Style="{StaticResource ListViewComboBoxStyle}" ItemsSource="{Binding EnumEntrysA, Mode=OneWay}" SelectedValue="{Binding NameTypeA, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                  <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </ComboBox>
          </Grid>
          <Grid Row="1">
            <TextBlock VerticalAlignment="Center" Text="{Lang:ResourceBinding ImgName}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </Grid>
        </Grid>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="StringImgName_Selecter">
