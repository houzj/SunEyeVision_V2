  <DataTemplate x:Key="ImageViewConfig_subContent">
    <Border Margin="0,4,0,0" Width="260" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,6,6">
      <Border.Background>
        <LinearGradientBrush>
          <GradientStop Offset="0.0" Color="#FCFCFC" />
          <GradientStop Offset="0.15" Color="#FCFCFC" />
          <GradientStop Offset="1" Color="#F7F7F7" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="102" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="32" />
          <RowDefinition Height="32" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource OK颜色}" Grid.Row="0" Grid.Column="0" FontSize="14" Foreground="#808080" Margin="10,0,0,0" />
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource NG颜色}" Grid.Row="1" Grid.Column="0" Foreground="#808080" Margin="10,0,0,0" />
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource 透明度}" Grid.Row="2" Grid.Column="0" Foreground="#808080" Margin="10,0,0,0" />
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource 粗细}" Grid.Row="3" Grid.Column="0" Foreground="#808080" Margin="10,0,0,0" Visibility="{Binding BridgeObjA.StrokeThicknessConfigEnable, Converter={StaticResource bool2VisibilityConverter}}" />
        <vm_port_2:ColorPickerControlView Grid.Row="0" Grid.Column="1" CurrentColor="{Binding BridgeObjA.okcolorA, Mode=TwoWay}" />
        <vm_port_2:ColorPickerControlView Grid.Row="1" Grid.Column="1" CurrentColor="{Binding BridgeObjA.ngcolorA, Mode=TwoWay}" />
        <vm_port_1:SliderArrangeFloat Name="slider1" Grid.Row="2" Grid.Column="1" SliderTickFrequency="0.01" Minimum="0" Foreground="#808080" Maximum="1" StartValue="{Binding BridgeObjA.opacityA, Mode=TwoWay}" />
        <vm_port_1:SliderArrangeFloat Name="slider2" Grid.Row="3" Grid.Column="1" SliderTickFrequency="1" Minimum="1" Foreground="#808080" Maximum="10" StartValue="{Binding BridgeObjA.StrokeThicknessA, Mode=TwoWay}" Visibility="{Binding BridgeObjA.StrokeThicknessConfigEnable, Converter={StaticResource bool2VisibilityConverter}}" />
      </Grid>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Height" Value="120" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding BridgeObjA.StrokeThicknessConfigEnable}">
              <Setter Property="Height" Value="150" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="ImageViewConfig">
    <localParamTab:LeftRightControl Height="32" HorizontalAlignment="Left">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <UniformGrid Width="100" Columns="2">
          <ToggleButton Style="{StaticResource eyeToggleButton}" IsChecked="{Binding BridgeObjA.IsDisplayA, Mode=TwoWay}" />
          <PControl:PopupButton HorizontalOffsetVal="-90" SubContent="{StaticResource ImageViewConfig_subContent}" Visibility="{Binding PanVisibleA, Converter={StaticResource bool2VisibilityConverter}}" />
        </UniformGrid>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
  <DataTemplate x:Key="StringConfig_sub">
    <PControl:PopupButton Name="et" Grid.Column="0" HorizontalOffsetVal="0" Style="{x:Null}" IsPopupOpen="{Binding IsTextDropDownOpen, Mode=TwoWay}">
      <PControl:PopupButton.ButtonStyle>
        <Style TargetType="{x:Type ToggleButton}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid>
                  <Border BorderThickness="1" CornerRadius="4" BorderBrush="#CCCCCD" Background="#FFFFFFFF" IsHitTestVisible="False" />
                  <localParamTab:DeleteTextBox Background="#00FFFFFF" FontSize="14" Foreground="#808080" IsReadOnly="{Binding ReadOnly}" vm_port_3:AttachBinding.BindingString="{Binding Path=BindingPathA, StringFormat=Text:{0}}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="OnTBFoucsChanged">
                        <vm_port_3:ParamsEventCommand Command="{Binding FocusedCommand}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </localParamTab:DeleteTextBox>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </PControl:PopupButton.ButtonStyle>
      <PControl:PopupButton.SubContent>
        <DataTemplate>
          <Border Margin="0,4,0,0" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
            <Border.Background>
              <LinearGradientBrush>
                <GradientStop Offset="0.0" Color="#FCFCFC" />
                <GradientStop Offset="0.15" Color="#FCFCFC" />
                <GradientStop Offset="1" Color="#F7F7F7" />
              </LinearGradientBrush>
            </Border.Background>
            <localParamTab:SubTreeView Width="180" Height="180">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                  <vm_port_3:ParamsEventCommand Command="{Binding IndexClickCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localParamTab:SubTreeView>
          </Border>
        </DataTemplate>
      </PControl:PopupButton.SubContent>
    </PControl:PopupButton>
  </DataTemplate>
  <DataTemplate x:Key="StringConfig">
    <localParamTab:LeftRightControl Height="32">
