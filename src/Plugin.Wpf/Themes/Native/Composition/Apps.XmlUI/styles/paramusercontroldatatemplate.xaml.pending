  <DataTemplate x:Key="RadioSelecter">
    <localParamTab:LeftRightControl ChildLeftWidth="{Binding LangRadioSelecterWidth}">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <WrapPanel VerticalAlignment="Center">
          <RadioButton Focusable="True" Margin="2,0,0,0" Style="{StaticResource NormalRadioButton}" Content="{Binding EnumEntrysA[0].DisplayNameALang}">
            <ToggleButton.IsChecked>
              <MultiBinding Mode="OneWay" Converter="{StaticResource equalConverter}">
                <Binding Path="CurValueA" />
                <Binding Path="EnumEntrysA[0].ValueA" />
              </MultiBinding>
            </ToggleButton.IsChecked>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="Checked">
                <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" CommandParameter="{Binding EnumEntrysA[0].ValueA}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </RadioButton>
          <RadioButton Focusable="True" Margin="2,0,0,0" Style="{StaticResource NormalRadioButton}" Content="{Binding EnumEntrysA[1].DisplayNameALang}">
            <ToggleButton.IsChecked>
              <MultiBinding Mode="OneWay" Converter="{StaticResource equalConverter}">
                <Binding Path="CurValueA" />
                <Binding Path="EnumEntrysA[1].ValueA" />
              </MultiBinding>
            </ToggleButton.IsChecked>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="Checked">
                <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" CommandParameter="{Binding EnumEntrysA[1].ValueA}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </RadioButton>
        </WrapPanel>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
