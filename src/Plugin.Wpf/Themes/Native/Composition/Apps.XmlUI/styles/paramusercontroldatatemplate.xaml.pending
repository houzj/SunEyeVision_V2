  <DataTemplate x:Key="Table">
    <StackPanel>
      <localcontrol:DataGridControl Margin="34,0,40,3" Style="{StaticResource dataGridStyle}" ColumnHeaderStyle="{StaticResource dataGridColumnHeaderStyle}" RowStyle="{StaticResource dataGridRowStyle}" CellStyle="{StaticResource dataGridCellStyle}" IsDelEnable="{Binding IsAddDelEnableA}" Views="{Binding ColumnsA}" DataName="{Binding DataNameA}" />
      <localcontrol:ButtonControl Margin="34,0,0,0" HorizontalAlignment="Left" Style="{StaticResource IcAddBtnStyle}" DataName="{Binding CommandNameA}" Visibility="{Binding IsAddDelEnableA, Converter={StaticResource bool2VisibilityConverter}}" />
    </StackPanel>
  </DataTemplate>
  <Style x:Key="NineBoxStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="3">
            <PControl:HikTextBox Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType={x:Type ListBox}}, Converter={StaticResource WidthConverter}}" Text="{Binding ValueA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ValueA}" IsReadOnly="{Binding Path=(localcontrol:ItemsControlExtension.DataSource).IsEditableA, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType={x:Type ListBox}}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ItemsPanelTemplate x:Key="NineBoxItemsPanelStyle">
    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
  </ItemsPanelTemplate>
  <DataTemplate x:Key="NineBox">
    <ListBox Margin="34,0,40,0" Background="#00FFFFFF" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NineBoxStyle}" ItemsPanel="{StaticResource NineBoxItemsPanelStyle}" localcontrol:ItemsControlExtension.ItemsSource="{Binding NameA}" localcontrol:ItemsControlExtension.DataSource="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=Self}}" />
  </DataTemplate>
  <Style x:Key="CoordinateTransformParamStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderThickness="1" Padding="10" BorderBrush="#FFA9A9A9" CornerRadius="2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="89" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="auto" />
                  <RowDefinition Height="auto" />
                  <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed" Text="{Lang:ResourceBinding Path=DataContext.ItemsA[0].DisplayNameA, ElementName=paramControl}" ToolTip="{Lang:ResourceBinding Path=DataContext.ItemsA[0].DescriptionA, ElementName=paramControl}" />
                <vm_port_0:SliderArrangeFloat Grid.Row="0" Grid.Column="1" Visibility="Collapsed" SliderTickFrequency="{Binding Path=DataContext.ItemsA[0].IncValueA, ElementName=paramControl}" StartValue="{Binding PixelAccuracyA, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[0].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[0].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[0].DecimalDigitsA, ElementName=paramControl}" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Lang:ResourceBinding Path=DataContext.ItemsA[1].DisplayNameA, ElementName=paramControl}" ToolTip="{Lang:ResourceBinding Path=DataContext.ItemsA[1].DescriptionA, ElementName=paramControl}" />
                <ContentControl Grid.Row="1" Grid.Column="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsEnabled="False" Background="#00FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="14" Foreground="#808080" Text="{Binding SavePathA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding SavePathA}" />
                    <PCommon:SuperImageButton Grid.Column="1" Margin="0,-1,0,1">
                      <PCommon:SuperImageButton.NormalConnent>
                        <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_文件路径_normal.png" Stretch="None" />
                      </PCommon:SuperImageButton.NormalConnent>
                      <PCommon:SuperImageButton.PressedConnent>
                        <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_文件路径_click.png" Stretch="None" />
                      </PCommon:SuperImageButton.PressedConnent>
                      <PCommon:SuperImageButton.MOverConnent>
                        <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.XmlUI/Resources/ic_文件路径_hover.png" Stretch="None" />
                      </PCommon:SuperImageButton.MOverConnent>
                      <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                          <i:InvokeCommandAction Command="{Binding ClickCommand}" />
                        </i:EventTrigger>
                      </i:Interaction.Triggers>
                    </PCommon:SuperImageButton>
                    <Border BorderThickness="1" CornerRadius="4" BorderBrush="#CCCCCD" Grid.Column="0" Grid.ColumnSpan="2" />
                  </Grid>
                </ContentControl>
                <ListBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="34,0,40,0" Background="#00FFFFFF" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NineBoxStyle}" ItemsSource="{Binding CalibMatA}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ListBox>
              </Grid>
            </Border>
            <Button Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource DeleteBtnStyle}" Command="{Binding DelParamCommand}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="CoordinateTransformParam">
    <StackPanel>
      <ListBox Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CoordinateTransformParamStyle}" ItemsSource="{Binding ElementName=paramWindow, Path=DataContext.Owner.CoordinateTransformsA}" />
      <Button Margin="34,0,0,0" CommandParameter="true" Style="{StaticResource addBtnCross}" Command="{Binding ElementName=paramWindow, Path=DataContext.Owner.AddCoordinateTransformParamCommand}" />
    </StackPanel>
  </DataTemplate>
  <Style x:Key="MoveGraspParamStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
