  <DataTemplate x:Key="LinePair">
    <Grid>
      <ContentControl>
        <Control.Template>
          <ControlTemplate TargetType="{x:Type ContentControl}">
            <Grid Margin="0,0,10,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                <TextBlock Text="{DynamicResource 示教线}" Style="{StaticResource CategoryHeader}" />
                <TextBlock Style="{StaticResource CategoryHeader}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                      <Binding Path="DisplayIndexA" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="—" Style="{StaticResource CategoryHeader}" />
                <TextBlock Text="{DynamicResource 运行线}" Style="{StaticResource CategoryHeader}" />
                <TextBlock Style="{StaticResource CategoryHeader}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                      <Binding Path="DisplayIndexA" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
              <Button Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource BaseImage_ButtonStyle}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDeleteA, Converter={StaticResource bool2VisibilityConverter}}">
                <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/delete_normal.png" />
                <FrameworkElement.Tag>
                  <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/delete_click.png" />
                </FrameworkElement.Tag>
              </Button>
              <localParamTab:LeftRightControl Row="1" ChildLeftWidth="{Binding ChildLeftWidth}">
                <localParamTab:LeftRightControl.LeftContent>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <Style x:Key="tstyle" TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Setter Property="FontWeight" Value="Normal" />
                          <Setter Property="Foreground" Value="#666666" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                          <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                        <Style x:Key="styleA" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="0" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="Margin" Value="0,0,0,0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="styleB" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="Margin" Value="0,0,0,0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="styleB1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="Margin" Value="0,23,0,0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="styleC" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="Margin" Value="0,0,0,0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="styleC1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="Margin" Value="0,23,0,0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                        <Style x:Key="styleD" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tstyle}">
                          <Style.Triggers>
                            <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Setter Property="Margin" Value="0,23,0,0" />
                            </DataTrigger>
                            <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Setter Property="Margin" Value="0,23,0,0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                    <TextBlock Text="{DynamicResource Angle}" Grid.Row="4" Style="{StaticResource styleD}" />
                    <TextBlock Text="{DynamicResource select Line}" Grid.Row="0" Style="{StaticResource styleA}" />
                    <TextBlock Text="{DynamicResource Startpoint}" Grid.Row="0" Style="{StaticResource styleB}" />
                    <TextBlock Text="{DynamicResource Endpoint}" Grid.Row="1" Style="{StaticResource styleB1}" />
                    <TextBlock Text="{DynamicResource StartX}" Grid.Row="0" Style="{StaticResource styleC}" />
                    <TextBlock Text="{DynamicResource StartY}" Grid.Row="1" Style="{StaticResource styleC1}" />
                    <TextBlock Text="{DynamicResource EndX}" Grid.Row="2" Style="{StaticResource styleC1}" />
                    <TextBlock Text="{DynamicResource EndY}" Grid.Row="3" Style="{StaticResource styleC1}" />
                  </Grid>
                </localParamTab:LeftRightControl.LeftContent>
                <localParamTab:LeftRightControl.RightContent>
                  <Grid>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ChildUIWidth}" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="{Binding ChildUIWidth}" />
                      </Grid.ColumnDefinitions>
                      <FrameworkElement.Resources>
                        <ResourceDictionary>
                          <Style x:Key="Rect" TargetType="{x:Type Rectangle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Margin" Value="3,0" />
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Height" Value="1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Fill" Value="#CECCCB" />
                          </Style>
                          <Style x:Key="RectA" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                            <Style.Triggers>
                              <DataTrigger Value="0" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="RectB" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                            <Style.Triggers>
                              <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="RectC" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                            <Style.Triggers>
                              <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="RectD" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Rect}">
                            <Style.Triggers>
                              <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="cstyle" TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="ContentTemplate" Value="{StaticResource ButtonSelecter_sub}" />
                            <Setter Property="Width" Value="{Binding ChildUIWidth}" />
                            <Setter Property="Margin" Value="0,5" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                          </Style>
                          <Style x:Key="cstyleA" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                            <Style.Triggers>
                              <DataTrigger Value="0" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="cstyleB" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                            <Style.Triggers>
                              <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="cstyleC" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                            <Style.Triggers>
                              <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                          <Style x:Key="cstyleD" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource cstyle}">
                            <Style.Triggers>
                              <DataTrigger Value="1" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Value="2" Binding="{Binding ShowTypeA}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ResourceDictionary>
                      </FrameworkElement.Resources>
                      <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource cstyleA}" Content="{Binding ObjectLineA}" />
                      <Rectangle Grid.Row="0" Style="{StaticResource RectA}" />
                      <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource cstyleA}" Content="{Binding TargetLineA}" />
                      <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource cstyleB}" Content="{Binding ObjectStartPointA}" />
                      <Rectangle Grid.Row="0" Style="{StaticResource RectB}" />
                      <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource cstyleB}" Content="{Binding TargetStartPointA}" />
                      <ContentControl Grid.Row="1" Grid.Column="2" Style="{StaticResource cstyleB}" Content="{Binding ObjectEndPointA}" />
                      <Rectangle Grid.Row="1" Style="{StaticResource RectB}" />
                      <ContentControl Grid.Row="1" Grid.Column="0" Style="{StaticResource cstyleB}" Content="{Binding TargetEndPointA}" />
                      <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource cstyleC}" Content="{Binding ObjectStartPointXA}" />
                      <Rectangle Grid.Row="0" Style="{StaticResource RectC}" />
                      <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource cstyleC}" Content="{Binding TargetStartPointXA}" />
                      <ContentControl Grid.Row="1" Grid.Column="2" Style="{StaticResource cstyleC}" Content="{Binding ObjectStartPointYA}" />
                      <Rectangle Grid.Row="1" Style="{StaticResource RectC}" />
                      <ContentControl Grid.Row="1" Grid.Column="0" Style="{StaticResource cstyleC}" Content="{Binding TargetStartPointYA}" />
                      <ContentControl Grid.Row="2" Grid.Column="2" Style="{StaticResource cstyleC}" Content="{Binding ObjectEndPointXA}" />
                      <Rectangle Grid.Row="2" Style="{StaticResource RectC}" />
                      <ContentControl Grid.Row="2" Grid.Column="0" Style="{StaticResource cstyleC}" Content="{Binding TargetEndPointXA}" />
                      <ContentControl Grid.Row="3" Grid.Column="2" Style="{StaticResource cstyleC}" Content="{Binding ObjectEndPointYA}" />
                      <Rectangle Grid.Row="3" Style="{StaticResource RectC}" />
                      <ContentControl Grid.Row="3" Grid.Column="0" Style="{StaticResource cstyleC}" Content="{Binding TargetEndPointYA}" />
                      <ContentControl Grid.Row="4" Grid.Column="0" Style="{StaticResource cstyleD}" Content="{Binding TargetAngleA}" />
                      <Rectangle Grid.Row="4" Style="{StaticResource RectD}" />
                      <ContentControl Grid.Row="4" Grid.Column="2" Style="{StaticResource cstyleD}" Content="{Binding ObjectAngleA}" />
                    </Grid>
                  </Grid>
                </localParamTab:LeftRightControl.RightContent>
              </localParamTab:LeftRightControl>
            </Grid>
          </ControlTemplate>
        </Control.Template>
      </ContentControl>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="AddButton_LinePair">
    <Grid Height="20" Margin="34,8,40,9">
      <vm_port_3:SuperImageButton Name="ByPoint" Grid.Column="0" Height="20">
        <vm_port_3:SuperImageButton.NormalConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/add_normal.png" />
          </StackPanel>
        </vm_port_3:SuperImageButton.NormalConnent>
        <vm_port_3:SuperImageButton.PressedConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/add_click.png" />
          </StackPanel>
        </vm_port_3:SuperImageButton.PressedConnent>
        <vm_port_3:SuperImageButton.MOverConnent>
          <StackPanel Orientation="Horizontal">
            <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/add_click.png" />
          </StackPanel>
        </vm_port_3:SuperImageButton.MOverConnent>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <vm_port_3:ParamsEventCommand CommandParameter="0" Command="{Binding ClickCommand}" />
