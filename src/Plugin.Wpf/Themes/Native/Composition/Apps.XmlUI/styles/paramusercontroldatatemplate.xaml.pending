  <DataTemplate x:Key="Command_sub_Width">
    <Button Padding="4,0,4,0" HorizontalAlignment="Left" Style="{StaticResource BottomButtonStyle}" Content="{Binding DisplayNameA}" MaxWidth="{Binding MaxWidthA}" MinWidth="{Binding MinWidthA}" Command="{Binding ClickCommand}" Width="{Binding WidthA}" />
  </DataTemplate>
