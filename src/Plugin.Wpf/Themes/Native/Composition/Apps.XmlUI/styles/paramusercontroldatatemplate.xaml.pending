                  <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Text="R" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="1" Grid.Column="1" SliderTickFrequency="{Binding Path=DataContext.ItemsA[1].IncValueA, ElementName=paramControl}" StartValue="{Binding MarkPixA.X, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[1].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[1].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[1].DecimalDigitsA, ElementName=paramControl}" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="1" Grid.Column="2" SliderTickFrequency="{Binding Path=DataContext.ItemsA[1].IncValueA, ElementName=paramControl}" StartValue="{Binding MarkPixA.Y, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[1].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[1].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[1].DecimalDigitsA, ElementName=paramControl}" />
                  <vm_port_0:SliderArrangeFloat Grid.Row="1" Grid.Column="3" SliderTickFrequency="{Binding Path=DataContext.ItemsA[1].IncValueA, ElementName=paramControl}" StartValue="{Binding MarkPixA.R, Mode=TwoWay}" Minimum="{Binding Path=DataContext.ItemsA[1].MinValueA, ElementName=paramControl}" Maximum="{Binding Path=DataContext.ItemsA[1].MaxValueA, ElementName=paramControl}" DecimalDigits="{Binding Path=DataContext.ItemsA[1].DecimalDigitsA, ElementName=paramControl}" />
