      <ToggleButton Name="t1" Width="80" Height="24" MinWidth="66" BorderThickness="1" Style="{StaticResource ToggleButtonEditStyle}" Content="{Lang:ResourceBinding DisplayNameA_Btn1}" IsChecked="{Binding Checked_Btn1}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="Click">
            <PCommon:ParamsEventCommand Command="{Binding ClickCommand_1}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ToggleButton>
    </StackPanel>
