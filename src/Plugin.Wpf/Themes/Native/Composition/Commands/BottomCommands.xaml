<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- Original SharedStyles button styles and ParameterPresentation four templates. Only host state/command/label paths adapted. -->
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<BooleanToVisibilityConverter x:Key="bool2VisibilityConverter"/>
  <!-- SharedStyles ResetBtnStyle: original image resources, with local pack URIs. -->
  <Style x:Key="ResetBtnStyle" TargetType="{x:Type Button}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
      <Grid><Image x:Name="icon" Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/References/ic_btn_initialize_normal.png"/></Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/References/ic_btn_initialize_click.png"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/References/ic_btn_initialize_click.png"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Orange_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource btnEditTemplateBorderBG}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BottomLineBtnEnableBB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ParamsTabForeground}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource BottomLineBtnEnableBG}" Property="Background" />
              <Setter Value="{DynamicResource BottomLineBtnEnableBB}" Property="BorderBrush" />
              <Setter Value="{DynamicResource btnEditTemplateEnableFG}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BottomButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="66" />
  </Style>
  <DataTemplate x:Key="BottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Binding DisplayNameA}" Visibility="{Binding CustomVisibleA, Converter={StaticResource bool2VisibilityConverter}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="ContinuousExecuteBottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Binding DisplayNameA}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding CustomVisibleA}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsContinuous}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsRunning}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding RunEnabled}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="ExecuteOnceBottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Binding DisplayNameA}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding CustomVisibleA}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsContinuous}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsRunning}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding RunEnabled}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="StopExecuteBottomCommand">
    <Button Width="auto" MinWidth="66" Margin="2.5,0" Padding="10,0,10,0" Content="{Binding DisplayNameA}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource BottomButtonStyle}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding ClickCommand}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding CustomVisibleA}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Value="False" Binding="{Binding IsContinuous}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </DataTemplate>
</ResourceDictionary>
