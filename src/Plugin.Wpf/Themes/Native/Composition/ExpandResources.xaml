<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:language="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
<ResourceDictionary.MergedDictionaries>
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
<x:StaticExtension Member="language:LocalizationResourceDictionary.Instance"/>
</ResourceDictionary.MergedDictionaries>
<Style x:Key="ExpandButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="ToggleButton.IsThreeState" Value="False" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBox.Normal.Forground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="bd" CornerRadius="1" BorderBrush="#00FFFFFF" BorderThickness="1" Background="#00FFFFFF" Height="22">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Name="cp" Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              <Image Name="icon" Grid.Column="1" Margin="6,5,4,5" Stretch="None" Height="12" Width="12" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/References/btn_高级参数_downarrow.png" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/References/btn_高级参数_uparrow.png" />
              <Setter TargetName="cp" Value="{DynamicResource 收起}" Property="ContentPresenter.Content" />
              <Setter TargetName="cp" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="bd" Property="Width" Value="54" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource LogForeground}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource btnEditTemplateEnableBB}" Property="Border.BorderBrush" />
              <Setter Value="{DynamicResource ParamsTabForeground}" Property="Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource LogForeground}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource btnEditTemplateEnableBB}" Property="Border.BorderBrush" />
              <Setter Value="{DynamicResource ParamsTabForeground}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
<!-- Original Apps.XmlUI Expand template; only the external business property name is adapted. -->
<DataTemplate x:Key="NativeAdvancedToggle">
<ToggleButton Height="30" Margin="0,0,40,0" HorizontalAlignment="Right" Padding="6,0,0,0" VerticalContentAlignment="Center" Content="{DynamicResource 高级参数}" Style="{StaticResource ExpandButtonStyle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
</DataTemplate>
</ResourceDictionary>
