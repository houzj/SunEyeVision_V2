<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- Standalone defaults; host replaces these keys atomically at its theme boundary. Original templates remain unchanged. -->
<SolidColorBrush x:Key="ImageSources.Background" Color="#303030"/>
<SolidColorBrush x:Key="ImageSources.Foreground" Color="#AAAAAA"/>
<SolidColorBrush x:Key="ImageSources.Border" Color="#505050"/>
<SolidColorBrush x:Key="ImageSources.Accent" Color="#FF7800"/>
<SolidColorBrush x:Key="ImageSources.Hover" Color="#454545"/>
<SolidColorBrush x:Key="ImageSources.Scroll" Color="#666666"/>
<SolidColorBrush x:Key="ImageSources.MenuBackground" Color="#252525"/>
</ResourceDictionary>