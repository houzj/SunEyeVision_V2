<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Parameters.Rows" xmlns:original="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Parameters.Core" xmlns:language="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization" xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
<ResourceDictionary.MergedDictionaries>
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
<x:StaticExtension Member="language:LocalizationResourceDictionary.Instance"/>
</ResourceDictionary.MergedDictionaries>
<original:EqualConverter x:Key="equalConverter"/>
  <Style x:Key="NormalRadioButton" TargetType="{x:Type RadioButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Col_ModuleConfig_List_Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
    <Setter Property="Background" Value="{DynamicResource ListViewComboBoxBackground}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Name="icon" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/check-box_off.png" />
            <ContentPresenter Margin="3,0,0,0" Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
              <!-- Generated text lookup stops at this template boundary. Preserve the original Radio's text properties. -->
              <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}" /></ContentPresenter.Resources>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/check-box_on.png" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="TextLeft" TargetType="{x:Type Control}">
    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Col_ModuleConfig_List_Foreground}" TextTrimming="CharacterEllipsis" Text="{language:ResourceBinding DisplayNameA}" ToolTip="{language:ResourceBinding DescriptionA}" />
  </ControlTemplate>
  <DataTemplate x:Key="RadioSelecter">
    <localParamTab:LeftRightControl ChildLeftWidth="{Binding LangRadioSelecterWidth}">
      <localParamTab:LeftRightControl.LeftContent>
        <Control Template="{StaticResource TextLeft}" />
      </localParamTab:LeftRightControl.LeftContent>
      <localParamTab:LeftRightControl.RightContent>
        <WrapPanel VerticalAlignment="Center">
          <RadioButton Focusable="True" Margin="2,0,0,0" Style="{StaticResource NormalRadioButton}" Content="{Binding EnumEntrysA[0].DisplayNameALang}">
            <ToggleButton.IsChecked>
              <MultiBinding Mode="OneWay" Converter="{StaticResource equalConverter}">
                <Binding Path="CurValueA" />
                <Binding Path="EnumEntrysA[0].ValueA" />
              </MultiBinding>
            </ToggleButton.IsChecked>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="Checked">
                <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" CommandParameter="{Binding EnumEntrysA[0].ValueA}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </RadioButton>
          <RadioButton Focusable="True" Margin="2,0,0,0" Style="{StaticResource NormalRadioButton}" Content="{Binding EnumEntrysA[1].DisplayNameALang}">
            <ToggleButton.IsChecked>
              <MultiBinding Mode="OneWay" Converter="{StaticResource equalConverter}">
                <Binding Path="CurValueA" />
                <Binding Path="EnumEntrysA[1].ValueA" />
              </MultiBinding>
            </ToggleButton.IsChecked>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="Checked">
                <i:InvokeCommandAction Command="{Binding ValueChangedCommand}" CommandParameter="{Binding EnumEntrysA[1].ValueA}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </RadioButton>
        </WrapPanel>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
