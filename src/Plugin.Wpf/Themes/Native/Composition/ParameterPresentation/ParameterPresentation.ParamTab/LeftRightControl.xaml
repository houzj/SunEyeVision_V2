<?xml version="1.0" encoding="utf-8"?>
<Grid x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTab.LeftRightControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:paramTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTab" xmlns:Local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation" TextBlock.FontSize="14" Margin="{Binding ChildMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:ParamListView}}}" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" /><BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="{Binding ChildLeftWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type paramTab:LeftRightControl}}}" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Name="PartText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Col_ModuleConfig_List_Foreground}" VerticalAlignment="Center" Visibility="{Binding IsDisplayLeft, Converter={StaticResource bool2VisibilityConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type paramTab:LeftRightControl}}}" Text="{vm_port_0:ResourceBinding DisplayNameA}" ToolTip="{vm_port_0:ResourceBinding DescriptionA}" />
</Grid>