<?xml version="1.0" encoding="utf-8"?>
<Control x:Class="SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTabControl.DisplayForGroupControl.ROIConfigControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTabControl.DisplayForGroupControl" xmlns:BaseLocal="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation" xmlns:VMInterface="clr-namespace:PresentationControls.Interface;assembly=PresentationControls.Interface" xmlns:ImageViewport="clr-namespace:ImageViewport;assembly=ImageViewport" xmlns:localcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTabControl" Width="1000" Height="600" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageViewport" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Interaction.Controls" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ThemeColors" xmlns:vm_port_0__="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <x:StaticExtension Member="vm_port_0__:LocalizationResourceDictionary.Instance" />
        <x:StaticExtension Member="vm_port_0_:ColorThemesResourceDictionary.Instance" />
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/ButtonStyle/BottomButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <localcontrol:RoiSelectControl VerticalAlignment="Top" Margin="10" DataContext="{Binding Path=(VMInterface:IDecorate.DecorateSource)}" ImageWidth="{Binding DataContext.ImageWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" ImageHeight="{Binding DataContext.ImageHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
        <Grid Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <UniformGrid Columns="4" Width="150" HorizontalAlignment="Right">
            <vm_port_1:ZoomOutButton Width="34" Height="34" Content="{DynamicResource 放大}" HookImageViewBox="{Binding ElementName=imageView}" />
            <vm_port_1:ZoomInButton Width="34" Height="34" Content="{DynamicResource 缩小}" HookImageViewBox="{Binding ElementName=imageView}" />
            <Button Name="BtnToolRegionScale" Width="34" Height="34" Style="{StaticResource ClientOriginScaleBtn}" Content="1:1" Click="BtnToolRegionScale_Click" />
            <Button Name="BtnToolFullScreen" Width="34" Height="34" Style="{StaticResource ClientFullScreenBtn}" Content="全屏" Click="m_btnFullScreen_Click" />
          </UniformGrid>
          <Grid Name="viewbox" Row="1">
            <vm_port_0:ImageViewBox Name="imageView" ImageDataSource="{Binding ImageSource}" ROIList="{Binding ROIList}" DrawROIType="{Binding Path=(VMInterface:IDecorate.DecorateSource).DrawROIType}" IsStateForDrawROI="{Binding Path=(VMInterface:IDecorate.DecorateSource).IsStateForDrawROI}" RoiAddCommand="{Binding Path=(VMInterface:IDecorate.DecorateSource).AddROICommand}" RoiSelectedCommand="{Binding Path=RoiSelectedCommand}" />
          </Grid>
        </Grid>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</Control>