<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:localization="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization"
                    xmlns:localcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTabControl"
                    xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTab">
  <!-- ExtensionParamUserControl/BooleanUserControl/BooleanTipsDataTemplate.xaml.
       Dependencies are supplied by the owning parameter dictionary; no second theme or state model. -->
  <DataTemplate x:Key="BooleanTips">
    <localParamTab:LeftRightControl Height="32">
      <localParamTab:LeftRightControl.RightContent>
        <ContentControl Content="{Binding}">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <localcontrol:BooleanControl HorizontalAlignment="Left" IsChecked="{Binding CurValueA, Mode=TwoWay}">
                  <localcontrol:BooleanControl.OffContent>
                    <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/swith_off.png"/>
                  </localcontrol:BooleanControl.OffContent>
                  <localcontrol:BooleanControl.OnContent>
                    <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/swith_on.png"/>
                  </localcontrol:BooleanControl.OnContent>
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="OnCheckedChange">
                      <i:InvokeCommandAction Command="{Binding ValueChangedCommand}"/>
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </localcontrol:BooleanControl>
                <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource Col_Theme}" TextTrimming="CharacterEllipsis"
                           FontSize="12" MaxWidth="150" VerticalAlignment="Center" Text="{localization:ResourceBinding MessageTips,Mode=OneWay}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </localParamTab:LeftRightControl.RightContent>
    </localParamTab:LeftRightControl>
  </DataTemplate>
</ResourceDictionary>
