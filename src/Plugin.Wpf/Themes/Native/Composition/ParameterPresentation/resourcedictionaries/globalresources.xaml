<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation" xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.ParameterPresentation.ParamTab" xmlns:rows="clr-namespace:SunEyeVision.Plugin.Wpf.Adapters.Fields" xmlns:vm_port_0__="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
<ResourceDictionary.MergedDictionaries>
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/VisionUi/SourceScrollBars.xaml"/>
<ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/ParameterPresentation/resourcedictionaries/ParamRowDataTemplates.xaml"/>
</ResourceDictionary.MergedDictionaries>
<SolidColorBrush x:Key="ListBorder" Color="#828790"/>
<BooleanToVisibilityConverter x:Key="bool2VisibilityConverter"/>
<local:ItemCheckConverter x:Key="CheckConverter"/>
<local:LeftWidthConverter x:Key="LeftWidthConverter"/>
<CollectionViewSource x:Key="src" IsLiveGroupingRequested="True"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="GroupName"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
<DataTemplate x:Key="DeclaredParameterRow"><ContentPresenter Content="{Binding View}"/></DataTemplate>
<DataTemplate x:Key="ParamItemTemplate">
    <Border Name="bd" BorderThickness="1" BorderBrush="{Binding MyItemState, Converter={StaticResource CheckConverter}}" IsEnabled="{Binding EnableA}">
      <local:ParamUserControl>
      </local:ParamUserControl>
    </Border>
  </DataTemplate>
<Style x:Key="{x:Type localParamTab:LeftRightControl}" TargetType="{x:Type localParamTab:LeftRightControl}">
    <Setter Property="localParamTab:LeftRightControl.ChildLeftWidth" Value="{Binding ChildLeftWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ParamListView}}}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Instance, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ParamListView}}}" Value="{x:Null}">
        <Setter Property="localParamTab:LeftRightControl.ChildLeftWidth" Value="{Binding Converter={StaticResource LeftWidthConverter}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
<Style x:Key="ParamGroupItemStyle" TargetType="{x:Type GroupItem}">
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupItem}">
          <HeaderedContentControl Name="groupContainer" BorderThickness="0">
            <HeaderedContentControl.Header>
              <DockPanel Margin="{Binding ChildHeaderMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ParamListView}}}">
                <Rectangle Name="rec" Fill="#FFE0DFDE" Height="1" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="0,0,18,0" />
                <TextBlock Name="ht" Margin="0,20,0,0" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei" Foreground="{DynamicResource Col_ModuleConfig_Title_Foreground}" Width="auto" Text="{vm_port_0__:ResourceBinding Name.NameA}" />
              </DockPanel>
            </HeaderedContentControl.Header>
            <ItemsPresenter />
          </HeaderedContentControl>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Name.IsFirst}">
              <Setter TargetName="rec" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="CategoryNoHead" Binding="{Binding Name.DisplayType}">
              <Setter TargetName="ht" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding Name.CustomVisibleA}">
              <Setter TargetName="groupContainer" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
<Style x:Key="ParamItemStyle" TargetType="{x:Type ContentPresenter}">
    <Style.Triggers>
      <DataTrigger Value="false" Binding="{Binding CustomVisibleA}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
<Style x:Key="ParamListViewStyle" TargetType="{x:Type ItemsControl}">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FF042271" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ItemsControl}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ScrollViewer Tag="1" Style="{StaticResource RecScrollViewer}">
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ParamListViewStyleNoScro" TargetType="{x:Type ItemsControl}">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FF042271" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ItemsControl}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>