<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:localcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTabControl" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0___="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization" xmlns:vm_port_0__="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.BaseData">
<!-- Original Box, SectorRing and Sector branches with expand styles; remaining shape branches are not substitutes. -->
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/ExpandResources.xaml"/><ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/><x:StaticExtension Member="vm_port_0___:LocalizationResourceDictionary.Instance"/></ResourceDictionary.MergedDictionaries><vm_port_0:NegateConverter x:Key="negateConverter"/>

<Style x:Key="BoxRoiBtnStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Margin" Value="0,0,27,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Background="#00FFFFFF">
            <Image Name="bg" Width="36" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ROI_选中但未绘制_bg.png" />
            <Image Name="icon" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ROI_retangle_normal.png" />
          </Grid>
          <ControlTemplate.Triggers>

      <DataTrigger Value="True" Binding="{Binding BoxEnable_ModuleEnableA}">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/Resources/ROI_retangle_click.png" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding BoxA}">
              <Setter TargetName="bg" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
<ControlTemplate x:Key="TextLeft" TargetType="{x:Type Control}">
    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Col_ModuleConfig_List_Foreground}" TextTrimming="CharacterEllipsis" Text="{vm_port_0___:ResourceBinding DisplayNameA}" ToolTip="{vm_port_0___:ResourceBinding DescriptionA}" />
  </ControlTemplate>
<Style x:Key="ROIStackStyle" TargetType="{x:Type localcontrol:ROIStackControl}">
    <Setter Property="localcontrol:ROIStackControl.ROIData" Value="{Binding CurROIData}" />
    <Setter Property="localcontrol:ROIStackControl.IsDraging" Value="{Binding CanUpDateROI, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=localcontrol:RoiSelectControl}, Converter={StaticResource negateConverter}}" />
  </Style>
<DataTemplate x:Key="BoxROI">
    <localcontrol:BoxROIStack Style="{StaticResource ROIStackStyle}" />
  </DataTemplate>
