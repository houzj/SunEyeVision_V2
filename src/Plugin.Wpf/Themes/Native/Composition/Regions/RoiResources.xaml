<Style x:Key="ROIListStyle" TargetType="{x:Type ContentControl}">
    <Setter Property="ContentTemplate" Value="{x:Null}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="True" Binding="{Binding IsChecked, ElementName=expand}" />
          <Condition Value="Visible" Binding="{Binding Visibility, ElementName=expand}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
      <DataTrigger Value="True" Binding="{Binding SectorRingEnable_ModuleEnableA}"><Setter Property="ContentTemplate" Value="{StaticResource SectorRingROI}"/></DataTrigger>
      <DataTrigger Value="True" Binding="{Binding SectorEnable_ModuleEnableA}"><Setter Property="ContentTemplate" Value="{StaticResource SectorROI}"/></DataTrigger>
<DataTrigger Value="True" Binding="{Binding BoxEnable_ModuleEnableA}">
        <Setter Property="ContentTemplate" Value="{StaticResource BoxROI}" />
      </DataTrigger>














    </Style.Triggers>
  </Style>
</ResourceDictionary>
