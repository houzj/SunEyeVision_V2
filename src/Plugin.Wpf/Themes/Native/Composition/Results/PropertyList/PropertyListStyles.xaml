<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:results="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Native.Composition.Results.PropertyList">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/ImageButton.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Results.PropertyList.ResultTreeViewStyle" TargetType="{x:Type TreeView}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_Foreground}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeView}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
            <ItemsPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Results.PropertyList.TreeViewItemFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.PropertyList.ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Image Name="icon" Height="12" Width="12" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/tree-collapse.png" VerticalAlignment="Center" HorizontalAlignment="Center" />
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/tree-expand.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.PropertyList.IcDeleteBtnStyle" TargetType="{x:Type Button}">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Name="icon" Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/variable-unlink-normal.png" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
            <ContentPresenter Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="Left" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/variable-unlink-hover.png" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/variable-unlink-disabled.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.PropertyList.ResultTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_Foreground}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Results.PropertyList.TreeViewItemFocusVisual}" />
    <Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=True}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True" Height="40">
              <Grid Name="RowContent" results:PropertyListView.SelectOnRowClick="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                <Rectangle Grid.Column="2" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                <Rectangle Grid.Column="4" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                <Rectangle Grid.Column="6" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                <Grid Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="140" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                  </Grid.RowDefinitions>
                  <Grid ColumnSpan="5" Margin="15,0,0,0" Column="{Binding Level}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Name="Expander" ClickMode="Press" Style="{StaticResource Results.PropertyList.ExpandCollapseToggleStyle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" ToolTip="{Binding Text, RelativeSource={RelativeSource self}}" />
                  </Grid>
                  <Rectangle Grid.Row="1" Grid.ColumnSpan="5" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                </Grid>
                <Grid Column="3">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="10,0" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Text="{Binding DisplayValue}">
                      <FrameworkElement.ToolTip>
                        <ToolTip DataContext="{Binding Path=PlacementTarget, RelativeSource={x:Static RelativeSource.Self}}">
                          <TextBlock TextWrapping="Wrap" MaxWidth="600" Text="{Binding Text}" />
                        </ToolTip>
                      </FrameworkElement.ToolTip>
                    </TextBlock>
                  </StackPanel>
                  <Rectangle Grid.Row="1" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                </Grid>
                <Grid Column="5">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                  </Grid.RowDefinitions>
                  <Grid Name="globalVarGrid" ToolTip="{Binding BindingUnavailableReason}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>
                    <Button Name="btnLink" Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" Command="{Binding DataContext.BindVariableCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}}" CommandParameter="{Binding}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Button}">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type Button}">
                                <Image Name="icon" Height="32" Width="32" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/variable-link-normal.png" />
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/PropertyList/variable-link-hover.png" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </FrameworkElement.Style>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock HorizontalAlignment="Left" FontSize="14" Text="{Binding BindingDisplayName}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <Button Name="btnDel" Grid.Column="2" Style="{StaticResource Results.PropertyList.IcDeleteBtnStyle}" Command="{Binding DataContext.UnbindVariableCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}}" CommandParameter="{Binding}" />
                  </Grid>
                  <Rectangle Grid.Row="1" StrokeThickness="0" Fill="{DynamicResource Results.PropertyList.Col_ShowResults_ModuleResult_BorderBrush}" Opacity="0.5" />
                </Grid>
              </Grid>
            </Border>
            <ItemsPresenter Name="ItemsHost" Grid.Row="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TreeViewItem.IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Value="False" Binding="{Binding IsGroup, FallbackValue=False}">
              <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.BindVariableCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="{x:Null}">
              <Setter TargetName="btnLink" Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.UnbindVariableCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="{x:Null}">
              <Setter TargetName="btnDel" Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanBindVariable, FallbackValue=False, TargetNullValue=False}" Value="False">
              <Setter TargetName="btnLink" Property="IsEnabled" Value="False" />
              <Setter TargetName="btnDel" Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="True">
              <Setter TargetName="btnLink" Property="IsEnabled" Value="False" />
              <Setter TargetName="btnDel" Property="IsEnabled" Value="False" />
            </DataTrigger>
            <Trigger Property="TreeViewItem.IsSelected" Value="True">
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <DataTrigger Binding="{Binding BindingDisplayName}" Value="{x:Null}">
              <Setter TargetName="btnLink" Property="Visibility" Value="Visible" />
              <Setter TargetName="btnDel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Results.PropertyList.ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Rectangle Fill="#00FFFFFF" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.PropertyList.ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Rectangle Fill="#00FFFFFF" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.PropertyList.RecHorizontalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="7" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Name="rect" Grid.Column="0" Grid.ColumnSpan="3" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Results.PropertyList.Col_ScrollBar_BorderBrush}" Fill="{DynamicResource Results.PropertyList.Col_ScrollBar_Fill}" StrokeThickness="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FrameworkElement.Tag" Value="1">
              <Setter Value="{DynamicResource Results.PropertyList.TextBox.Foreground}" TargetName="rect" Property="Shape.Stroke" />
              <Setter Value="{DynamicResource Results.PropertyList.btnEditTemplateBorderBG}" TargetName="rect" Property="Shape.Fill" />
            </Trigger>
            <Trigger Property="FrameworkElement.Tag" Value="2">
              <Setter Value="{DynamicResource Results.PropertyList.Col_ScrollBar_BorderBrush}" TargetName="rect" Property="Shape.Stroke" />
              <Setter Value="{DynamicResource Results.PropertyList.Col_ScrollBar_Fill}" TargetName="rect" Property="Shape.Fill" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="Results.PropertyList.RecHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid Name="Bg" SnapsToDevicePixels="True" Height="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="0.00001*" />
        <ColumnDefinition Width="5" />
      </Grid.ColumnDefinitions>
      <RepeatButton Grid.Column="0" Command="ScrollBar.LineLeftCommand" Style="{StaticResource Results.PropertyList.ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Column="1" IsEnabled="{TemplateBinding UIElement.IsMouseOver}" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource Results.PropertyList.ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource Results.PropertyList.ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Tag="{TemplateBinding FrameworkElement.Tag}" Style="{StaticResource Results.PropertyList.RecHorizontalScrollBarThumb}" />
        </Track.Thumb>
      </Track>
      <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource Results.PropertyList.ScrollBarLineButton}" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="Results.PropertyList.RecVerticalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="7" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Name="rect" Grid.Row="0" Grid.RowSpan="3" Canvas.Left="0" Canvas.Top="0" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Results.PropertyList.Col_ScrollBar_BorderBrush}" Fill="{DynamicResource Results.PropertyList.Col_ScrollBar_Fill}" StrokeThickness="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FrameworkElement.Tag" Value="1">
              <Setter Value="{DynamicResource Results.PropertyList.TextBox.Foreground}" TargetName="rect" Property="Shape.Stroke" />
              <Setter Value="{DynamicResource Results.PropertyList.btnEditTemplateBorderBG}" TargetName="rect" Property="Shape.Fill" />
            </Trigger>
            <Trigger Property="FrameworkElement.Tag" Value="2">
              <Setter Value="{DynamicResource Results.PropertyList.Col_ScrollBar_BorderBrush}" TargetName="rect" Property="Shape.Stroke" />
              <Setter Value="{DynamicResource Results.PropertyList.Col_ScrollBar_Fill}" TargetName="rect" Property="Shape.Fill" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="Results.PropertyList.RecVerticalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid Name="Bg" SnapsToDevicePixels="True" Width="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="5" />
        <RowDefinition Height="0.00001*" />
        <RowDefinition Height="5" />
      </Grid.RowDefinitions>
      <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Style="{StaticResource Results.PropertyList.ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Row="1" IsEnabled="{TemplateBinding UIElement.IsMouseOver}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource Results.PropertyList.ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource Results.PropertyList.ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Tag="{TemplateBinding FrameworkElement.Tag}" Style="{StaticResource Results.PropertyList.RecVerticalScrollBarThumb}" />
        </Track.Thumb>
      </Track>
      <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource Results.PropertyList.ScrollBarLineButton}" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="Results.PropertyList.RecScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template" Value="{StaticResource Results.PropertyList.RecHorizontalScrollBar}" />
      </Trigger>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource Results.PropertyList.RecVerticalScrollBar}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Results.PropertyList.RecScrollViewer" TargetType="{x:Type ScrollViewer}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
            <Grid Background="#00FFFFFF" Margin="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ScrollContentPresenter Grid.Column="0" Cursor="{TemplateBinding FrameworkElement.Cursor}" Margin="{TemplateBinding Control.Padding}" Grid.ColumnSpan="1" Grid.RowSpan="1" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
              <ScrollBar Name="PART_VerticalScrollBar" Tag="{TemplateBinding FrameworkElement.Tag}" Background="#00FFFFFF" Orientation="Vertical" Grid.Row="0" Grid.Column="1" Margin="-12,0,2,0" Value="{TemplateBinding ScrollViewer.VerticalOffset}" Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}" ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}" Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}" Style="{StaticResource Results.PropertyList.RecScrollBarStyle}" />
              <ScrollBar Name="PART_HorizontalScrollBar" Background="#00FFFFFF" Tag="{TemplateBinding FrameworkElement.Tag}" Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,-12,0,2" Value="{TemplateBinding ScrollViewer.HorizontalOffset}" Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}" ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}" Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}" Style="{StaticResource Results.PropertyList.RecScrollBarStyle}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
