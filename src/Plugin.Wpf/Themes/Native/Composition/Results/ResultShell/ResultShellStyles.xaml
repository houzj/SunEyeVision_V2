            <Image Name="icon" Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/cross-lines-normal.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/cross-lines-disabled.png" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/cross-lines-hover.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.Shell.ClientOriginScaleBtn" TargetType="{x:Type Button}">
