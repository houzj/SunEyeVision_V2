  <Style x:Key="Results.Shell.StyleLeft" TargetType="{x:Type Button}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Image Name="ImageBackground" Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/previous-normal.png" />
