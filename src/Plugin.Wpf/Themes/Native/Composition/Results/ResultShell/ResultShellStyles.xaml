            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ImageBackground" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/previous-hover.png" />
            </Trigger>
