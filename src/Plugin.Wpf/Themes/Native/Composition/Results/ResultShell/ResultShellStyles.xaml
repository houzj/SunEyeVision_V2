          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ImageBackground" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/fullscreen-hover.png" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ImageBackground" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/fullscreen-pressed.png" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ImageBackground" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/fullscreen-normal.png" />
