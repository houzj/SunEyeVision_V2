  <Style x:Key="Results.Shell.FrequentTab" TargetType="{x:Type TabItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid>
            <Border Name="Border" BorderThickness="0,0,1,1" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}">
              <ContentControl Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Results.Shell.Col_DisplayImage_Foreground}" Content="{TemplateBinding HeaderedContentControl.Header}" Margin="12,2,12,2" />
            </Border>
            <Rectangle Name="line" Height="1" Fill="#00FFFFFF" VerticalAlignment="Bottom" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="Border" Value="{DynamicResource Results.Shell.Col_DisplayImage_Selected_Background}" Property="Border.Background" />
              <Setter TargetName="line" Value="{DynamicResource Results.Shell.Col_Theme}" Property="Shape.Fill" />
              <Setter TargetName="ContentSite" Value="{DynamicResource Results.Shell.Col_DisplayImage_Selected_Foreground}" Property="Foreground" />
            </Trigger>
            <Trigger Property="TabItem.IsSelected" Value="False">
              <Setter TargetName="Border" Value="{DynamicResource Results.Shell.Col_DisplayImage_Background}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Results.Shell.ModuleViewTabControl" TargetType="{x:Type TabControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Name="ColumnDefinition0" />
              <ColumnDefinition Name="ColumnDefinition1" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Name="RowDefinition0" Height="Auto" />
              <RowDefinition Name="RowDefinition1" Height="*" />
            </Grid.RowDefinitions>
            <TabPanel Name="HeaderPanel" Grid.Column="0" IsItemsHost="True" Margin="0" Grid.Row="0" KeyboardNavigation.TabIndex="1" ZIndex="1" />
            <Border Name="ContentPanel" BorderBrush="{TemplateBinding Control.BorderBrush}" Margin="0,-1,0,0" BorderThickness="0,1,0,0" Background="{TemplateBinding Control.Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
              <ContentPresenter Name="PART_SelectedContentHost" ContentTemplate="{TemplateBinding TabControl.SelectedContentTemplate}" Content="{TemplateBinding TabControl.SelectedContent}" ContentStringFormat="{TemplateBinding TabControl.SelectedContentStringFormat}" ContentSource="SelectedContent" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabControl.TabStripPlacement" Value="Bottom">
              <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="1" />
