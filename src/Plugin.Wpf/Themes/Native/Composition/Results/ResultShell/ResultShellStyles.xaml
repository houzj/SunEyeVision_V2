        <ControlTemplate TargetType="{x:Type Button}">
          <Image Name="ImageBackground" Width="34" Height="34" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Results/ResultShell/original-scale-normal.png" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
