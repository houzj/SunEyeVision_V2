  <!-- 匹配中心底栏样式移到文件末尾：其模板引用 TemplateTextBoxStyle/NormalTextBoxStyle，WPF 同字典 StaticResource 须前向可见。 -->
  <!-- 匹配中心底栏，逐字等价迁移自 hpfeaturepatmatchdialoguibasestyle.xaml:16-45（BottomBorder）。
       数值输入框用 TemplateTextBox + 转换器；确认按钮复用 BottomButtonStyle。 -->
  <Style TargetType="{x:Type parameters:NativeMatchCenterBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type parameters:NativeMatchCenterBar}">
          <Border BorderBrush="#C2C2C2" BorderThickness="0,1,0,0">
            <Grid Background="#E6E6E6" Height="30">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="匹配中心 :(" Foreground="#808080" FontSize="13" VerticalAlignment="Center" Margin="8,0,2,0" />
                <Border BorderThickness="1" CornerRadius="4" BorderBrush="#C2C2C2">
                  <parameters:TemplateTextBox Width="76" TextAlignment="Center" Style="{StaticResource TemplateTextBoxStyle}"
                    Text="{Binding FixPointX, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource cvtDoubleToFloat}}" />
                </Border>
                <TextBlock Text="," Foreground="#808080" FontSize="13" VerticalAlignment="Center" Margin="2,0" />
                <Border BorderThickness="1" CornerRadius="4" BorderBrush="#C2C2C2">
                  <parameters:TemplateTextBox Width="76" TextAlignment="Center" Style="{StaticResource TemplateTextBoxStyle}"
                    Text="{Binding FixPointY, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource cvtDoubleToFloat}}" />
                </Border>
                <TextBlock Text=")" Foreground="#808080" FontSize="13" VerticalAlignment="Center" Margin="2,0,4,0" />
                <CheckBox Style="{StaticResource CheckBoxStyle1}" VerticalAlignment="Center"
                  IsChecked="{Binding IsLocked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                <TextBlock Text="锁定" Foreground="#808080" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0" />
              </StackPanel>
              <Grid HorizontalAlignment="Right">
                <Button Content="确定" Style="{StaticResource BottomButtonStyle}" Margin="0,0,10,0"
                  Command="{Binding ConfirmCommand, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
