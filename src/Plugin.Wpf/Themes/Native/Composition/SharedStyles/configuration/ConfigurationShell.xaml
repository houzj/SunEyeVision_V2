<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- 原件来源：VisionPluginContracts/Resources/ConfigurationShell.xaml；未改动键与颜色。 -->
<SolidColorBrush x:Key="Col_SubForm_Background" Color="#F2F3F5"/><SolidColorBrush x:Key="Col_ModuleConfig_Title_Foreground" Color="#666666"/><SolidColorBrush x:Key="Col_ModuleConfig_Title_Selected_Foreground" Color="#4D4D4D"/><SolidColorBrush x:Key="Col_Theme" Color="#E76900"/><SolidColorBrush x:Key="Col_Theme_Light" Color="#20E76900"/><SolidColorBrush x:Key="Col_ModuleConfig_Title_BorderBrush" Color="#CCC7C6"/><SolidColorBrush x:Key="GlobalBorderBg" Color="#E4E5E7"/>
 <Style x:Key="ConfigurationTabs" TargetType="{x:Type TabControl}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Name="ColumnDefinition0" />
              <ColumnDefinition Name="ColumnDefinition1" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Name="RowDefinition0" Height="Auto" />
              <RowDefinition Name="RowDefinition1" Height="*" />
            </Grid.RowDefinitions>
            <Border Name="head" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Col_ModuleConfig_Title_BorderBrush}" Margin="4,2,0,2">
              <TabPanel Name="HeaderPanel" Grid.Column="0" Grid.Row="0" Margin="0" ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
              <UIElement.Effect>
                <DropShadowEffect Color="White" Direction="270" ShadowDepth="1" Opacity="0.66" BlurRadius="2" />
              </UIElement.Effect>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
            <Trigger Property="Tag" Value="False">
              <Setter TargetName="head" Property="Visibility" Value="Hidden" />
              <Setter TargetName="head" Property="Margin" Value="0" />
              <Setter TargetName="head" Property="Height" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
 <Style x:Key="ConfigurationTab" TargetType="{x:Type TabItem}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource Col_ModuleConfig_Title_Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid>
            <Border Name="bd" HorizontalAlignment="Center" VerticalAlignment="Center" Height="35" Background="#00FFFFFF" Width="{TemplateBinding Width}">
              <ContentControl Name="Content" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Control.Foreground}" Tag="{TemplateBinding HeaderedContentControl.Header}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                
              </ContentControl>
            </Border>
            <Rectangle Name="line" Height="2" Fill="{DynamicResource Col_Theme}" Visibility="Hidden" VerticalAlignment="Bottom" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource Col_Theme_Light}" Property="Border.Background" />
              <Setter TargetName="Content" Property="FontWeight" Value="Bold" />
              <Setter TargetName="Content" Value="{DynamicResource Col_ModuleConfig_Title_Selected_Foreground}" Property="Foreground" />
              <Setter TargetName="line" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="FrameworkElement.Cursor" Value="Hand" />
              <Setter TargetName="line" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
 <Style x:Key="ConfigurationCategoryHeader" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Microsoft YaHei"/><Setter Property="Margin" Value="0,20,0,0"/></Style>
 <Style x:Key="ConfigurationSeparator" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="#FFE0DFDE"/><Setter Property="Margin" Value="0,0,18,0"/></Style>
</ResourceDictionary>
