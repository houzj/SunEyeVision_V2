<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ClassicalRadioButtonStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="#D1D1D1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid>
              <Grid>
                <Ellipse Name="Ellipse1" Width="15" Height="15" Fill="#00FFFFFF" Stroke="#C2C3C3" StrokeThickness="1.5" />
                <Ellipse Name="Ellipse2" Width="4" Height="4" Fill="#f8630f" Visibility="Collapsed" />
              </Grid>
            </Grid>
            <Border CornerRadius="4" Margin="3 0 0 0" Padding="2 0 5 0" Background="{TemplateBinding Control.Background}">
              <Label Margin="2 0 0 0" Content="{TemplateBinding ContentControl.Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Control.Foreground}" Background="{TemplateBinding Control.Background}" />
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Ellipse2" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ellipse1" Property="Shape.Stroke" Value="#f8630f" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>