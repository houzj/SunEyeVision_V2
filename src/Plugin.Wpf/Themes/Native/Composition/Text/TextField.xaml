<ResourceDictionary xmlns:b08n0="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Popups" xmlns:b08n1="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.References.Primitives" xmlns:b08n2="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Interaction" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
 
 
 >
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
  <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Popups/PopupStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="StringConfig_sub">
    <b08n0:PopupButton Name="et" Grid.Column="0" HorizontalOffsetVal="0" Style="{x:Null}" IsPopupOpen="{Binding IsTextDropDownOpen, Mode=TwoWay}">
      <b08n0:PopupButton.ButtonStyle>
        <Style TargetType="{x:Type ToggleButton}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid>
                  <Border BorderThickness="1" CornerRadius="4" BorderBrush="#CCCCCD" Background="#FFFFFFFF" IsHitTestVisible="False" />
                  <b08n1:DeleteTextBox Background="#00FFFFFF" FontSize="14" Foreground="#808080" IsReadOnly="{Binding ReadOnly}" Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="OnTBFoucsChanged">
                        <b08n2:ParamsEventCommand Command="{Binding FocusedCommand}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </b08n1:DeleteTextBox>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </b08n0:PopupButton.ButtonStyle>
      <b08n0:PopupButton.SubContent>
        <DataTemplate>
          <Border Margin="0,4,0,0" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
            <Border.Background>
              <LinearGradientBrush>
                <GradientStop Offset="0.0" Color="#FCFCFC" />
                <GradientStop Offset="0.15" Color="#FCFCFC" />
                <GradientStop Offset="1" Color="#F7F7F7" />
              </LinearGradientBrush>
            </Border.Background>
            <b08n1:SubTreeView Width="180" Height="180" ItemSource="{Binding SourceNodes}" SelectedItem="{Binding SelectedSourceNode, Mode=TwoWay}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                  <b08n2:ParamsEventCommand Command="{Binding IndexClickCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </b08n1:SubTreeView>
          </Border>
        </DataTemplate>
      </b08n0:PopupButton.SubContent>
    </b08n0:PopupButton>
  </DataTemplate>
</ResourceDictionary>
