<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
 xmlns:PControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Apps.PcUI.Controls"
 xmlns:localParamTab="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Composition.Apps.XmlUI.ParamTab"
 xmlns:vm_port_3="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.HikPcUI.Commom">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
  <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Input/Apps.PcUI/Styles/PcUIStyle.xaml"/>
 </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="StringConfig_sub">
    <PControl:PopupButton Name="et" Grid.Column="0" HorizontalOffsetVal="0" Style="{x:Null}" IsPopupOpen="{Binding IsTextDropDownOpen, Mode=TwoWay}">
      <PControl:PopupButton.ButtonStyle>
        <Style TargetType="{x:Type ToggleButton}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid>
                  <Border BorderThickness="1" CornerRadius="4" BorderBrush="#CCCCCD" Background="#FFFFFFFF" IsHitTestVisible="False" />
                  <localParamTab:DeleteTextBox Background="#00FFFFFF" FontSize="14" Foreground="#808080" IsReadOnly="{Binding ReadOnly}" Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="OnTBFoucsChanged">
                        <vm_port_3:ParamsEventCommand Command="{Binding FocusedCommand}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </localParamTab:DeleteTextBox>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </PControl:PopupButton.ButtonStyle>
      <PControl:PopupButton.SubContent>
        <DataTemplate>
          <Border Margin="0,4,0,0" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
            <Border.Background>
              <LinearGradientBrush>
                <GradientStop Offset="0.0" Color="#FCFCFC" />
                <GradientStop Offset="0.15" Color="#FCFCFC" />
                <GradientStop Offset="1" Color="#F7F7F7" />
              </LinearGradientBrush>
            </Border.Background>
            <localParamTab:SubTreeView Width="180" Height="180" ItemSource="{Binding SourceNodes}" SelectedItem="{Binding SelectedSourceNode, Mode=TwoWay}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="OnTreeNodeDoubleClick">
                  <vm_port_3:ParamsEventCommand Command="{Binding IndexClickCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </localParamTab:SubTreeView>
          </Border>
        </DataTemplate>
      </PControl:PopupButton.SubContent>
    </PControl:PopupButton>
  </DataTemplate>
</ResourceDictionary>
