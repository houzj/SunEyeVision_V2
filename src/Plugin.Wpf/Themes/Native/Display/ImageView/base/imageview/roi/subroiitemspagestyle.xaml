<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageView.Base.ImageView" xmlns:displayNative0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Contracts" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.BaseData">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageView/base/imageview/imageviewitemspagestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <vm_port_1:TypeFilterConverter x:Key="typeFilterConverter" />
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="{x:Type local:SubROIItemsPage}" TargetType="{x:Type local:SubROIItemsPage}" BasedOn="{StaticResource ImageViewItemsPageStyle}">
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:ROIItem ControlToImageRadio="{Binding ControlToImageRadio, RelativeSource={RelativeSource AncestorType=local:ImageViewItemsPage, Mode=FindAncestor}}" ThicknessScale="{Binding ThicknessScale, RelativeSource={RelativeSource AncestorType=local:ImageViewItemsPage, Mode=FindAncestor}}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type displayNative0:IROIVisible}}">
        <Setter Property="Visibility" Value="{Binding Path=(displayNative0:IROIVisible.IsVisible), Converter={StaticResource bv}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>