<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView">
  <Style x:Key="ImageViewItemsPageStyle" TargetType="{x:Type local:ImageViewItemsPage}">
    <Setter Property="ListBox.SelectionMode" Value="Single" />
    <Setter Property="local:ImageViewItemsPage.CopyRoiCommand" Value="{Binding CopyRoiCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ROIItemsPage}}" />
    <Setter Property="local:ImageViewItemsPage.DeleteRoiCommand" Value="{Binding DeleteRoiCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ROIItemsPage}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Canvas Name="Bd">
            <ItemsPresenter />
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True" IsHitTestVisible="{Binding IsHitTestVisibleOfHost, RelativeSource={RelativeSource AncestorType=local:ImageViewItemsPage, Mode=FindAncestor}}" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>