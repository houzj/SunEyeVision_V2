<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:baseData="clr-namespace:Apps.BaseData;assembly=Apps.BaseData" xmlns:localBase="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls">
  <MultiBinding x:Key="WidthBinding" Mode="TwoWay">
    <MultiBinding.Converter>
      <baseData:RightFixdMultiplicationConverter />
    </MultiBinding.Converter>
    <Binding Path="(Interface:IRectROI.Width)" Mode="TwoWay" />
    <Binding Path="ImageSourceWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localBase:ImageViewBox}" />
  </MultiBinding>
  <MultiBinding x:Key="HeightBinding" Mode="TwoWay">
    <MultiBinding.Converter>
      <baseData:RightFixdMultiplicationConverter />
    </MultiBinding.Converter>
    <Binding Path="(Interface:IRectROI.Height)" Mode="TwoWay" />
    <Binding Path="ImageSourceHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localBase:ImageViewBox}" />
  </MultiBinding>
  <MultiBinding x:Key="CenterPointBinding" Mode="TwoWay">
    <MultiBinding.Converter>
      <baseData:PointRightFixdMultiplicationConverter />
    </MultiBinding.Converter>
    <Binding Path="(Interface:IRectROI.CenterPoint)" Mode="TwoWay" />
    <Binding Path="ImageSourceWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localBase:ImageViewBox}" />
    <Binding Path="ImageSourceHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=localBase:ImageViewBox}" />
  </MultiBinding>
</ResourceDictionary>