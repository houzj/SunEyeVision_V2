<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="{x:Type local:CircleMesROI}" TargetType="{x:Type local:CircleMesROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:CircleMesROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CircleMesROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CircleMesROI.CircleRadius" Value="{Binding Path=Radius, Mode=TwoWay}" />
    <Setter Property="local:CircleMesROI.CircleCenterPoint" Value="{Binding Path=CenterPoint, Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <TextBlock IsHitTestVisible="False" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3,3,0,0" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" />
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid Name="move" Cursor="SizeAll">
            <Ellipse Fill="#00FFFFFF" Stroke="{StaticResource ROIBaseColor}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <Grid Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Rectangle Name="SizeRect" Cursor="SizeWE" Style="{StaticResource RectStyle}" />
            </Grid>
            <ContentPresenter Name="cp" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>