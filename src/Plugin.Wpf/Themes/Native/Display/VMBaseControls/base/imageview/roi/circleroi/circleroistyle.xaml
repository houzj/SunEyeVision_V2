<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="FeatureCircleBaseStyle" TargetType="{x:Type Path}">
    <Setter Property="Stroke" Value="{StaticResource ROIBaseColor}" />
    <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Shape.Stretch" Value="Fill" />
    <Setter Property="Fill" Value="#00FFFFFF" />
  </Style>
  <Style x:Key="FeatureCircleStyle" TargetType="{x:Type Path}" BasedOn="{StaticResource FeatureCircleBaseStyle}">
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="true" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaBackgroundColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="false" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Sign}" Value="{x:Null}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignSpecialColor}" />
      </MultiDataTrigger>
      <DataTrigger Value="false" Binding="{Binding UIType}">
        <Setter Property="Fill" Value="#00FFFFFF" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type local:CircleROI}" TargetType="{x:Type local:CircleROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:CircleROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CircleROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CircleROI.MinRadius" Value="{Binding Path=(vm_port_0:ICircleROI.MinRadius), Mode=TwoWay}" />
    <Setter Property="local:CircleROI.CircleRadius" Value="{Binding Path=(vm_port_0:ICircleROI.Radius), Mode=TwoWay}" />
    <Setter Property="local:CircleROI.CircleCenterPoint" Value="{Binding Path=(vm_port_0:ICircleROI.CenterPoint), Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <TextBlock IsHitTestVisible="False" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3,3,0,0" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" />
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid Name="move" Cursor="SizeAll">
            <Path Name="pt" Style="{StaticResource FeatureCircleBaseStyle}">
              <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                  <EllipseGeometry Center="{Binding Center, RelativeSource={RelativeSource Mode=TemplatedParent}}" RadiusX="{Binding RadiusSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" RadiusY="{Binding RadiusSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                  <EllipseGeometry Center="{Binding Center, RelativeSource={RelativeSource Mode=TemplatedParent}}" RadiusX="{Binding MinRadiusSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" RadiusY="{Binding MinRadiusSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                </GeometryGroup>
              </Path.Data>
            </Path>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="{Binding InnerCircleSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" Width="{Binding InnerCircleSize, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <Grid Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Rectangle Name="InnerRect" Cursor="SizeWE" Style="{StaticResource RectStyle}" />
              </Grid>
            </Grid>
            <Grid Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Rectangle Name="SizeRect" Cursor="SizeWE" Style="{StaticResource RectStyle}" />
            </Grid>
            <ContentPresenter Name="cp" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROIUIType}}" />
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROISign}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="pt" Property="Style" Value="{StaticResource FeatureCircleStyle}" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>