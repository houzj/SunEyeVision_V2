<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="RotateStyle" TargetType="{x:Type local:RotateArea}">
    <Setter Property="Margin" Value="{Binding MoveRotateMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="local:RotateArea.RectAngle" Value="{Binding RectAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type Interface:IAngleEnable}}">
        <Setter Property="Visibility" Value="{Binding Path=(Interface:IAngleEnable.IsAngleEnable), Converter={StaticResource bv}}" />
      </DataTrigger>
      <DataTrigger Value="False" Binding="{Binding IsRotatable, RelativeSource={RelativeSource AncestorType=local:CoordinateROI}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type local:CoordinateROI}" TargetType="{x:Type local:CoordinateROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:CoordinateROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CoordinateROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CoordinateROI.ContainerAngle" Value="{Binding Angle, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CoordinateROI.CenterPoint" Value="{Binding Path=(Interface:ICoordinateROI.OrgPoint), Mode=TwoWay}" />
    <Setter Property="local:CoordinateROI.RectAngle" Value="{Binding Path=(Interface:ICoordinateROI.Angle), Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <TextBlock IsHitTestVisible="False" FontWeight="Bold" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" />
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid Name="move" Cursor="SizeAll" Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Row="1" Column="1" Background="#00FFFFFF">
              <Path Stretch="Uniform" Stroke="{StaticResource ROIBaseColor}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                <Path.Data>
                  <GeometryGroup>
                    <LineGeometry StartPoint="0,0" EndPoint="80,0" />
                    <LineGeometry StartPoint="0,0" EndPoint="0,80" />
                  </GeometryGroup>
                </Path.Data>
              </Path>
              <ContentPresenter Name="cp" />
              <Grid Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Rectangle Name="InnerRect" Cursor="SizeAll" Style="{StaticResource RectStyle}" />
              </Grid>
              <Grid ZIndex="-1" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                  <RowDefinition Height="3*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Width="0" Height="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Row="1">
                  <Path Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding ArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,6" />
                            <LineSegment Point="-12,0" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
              </Grid>
              <Grid ZIndex="-1" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Top" Column="1">
                  <Path Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding TopArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,-6" />
                            <LineSegment Point="-6,6" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
              </Grid>
              <Grid ZIndex="-1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <local:TopRightRotateArea x:Name="topRightRotate" Style="{StaticResource RotateStyle}" />
                <Ellipse Visibility="Visible" IsHitTestVisible="False" ClipToBounds="True" Stroke="{StaticResource AnchorBaseColor}" Margin="{Binding StrokeThickness, ConverterParameter=-20, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource normalMultiplicationConverter}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding StrokeThickness, ConverterParameter=10, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource normalMultiplicationConverter}}" Width="{Binding Height, RelativeSource={RelativeSource Mode=Self}}">
                  <UIElement.Clip>
                    <RectangleGeometry x:Name="eRect" />
                  </UIElement.Clip>
                </Ellipse>
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type Interface:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>