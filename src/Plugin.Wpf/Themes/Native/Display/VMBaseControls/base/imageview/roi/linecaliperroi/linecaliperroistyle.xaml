<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type local:LineCaliperROI}" TargetType="{x:Type local:LineCaliperROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:LineCaliperROI.CaliperNum" Value="{Binding Path=CaliperNum, Mode=TwoWay}" />
    <Setter Property="local:LineCaliperROI.CaliperWidth" Value="{Binding Path=CaliperWidth, Mode=TwoWay}" />
    <Setter Property="local:LineCaliperROI.CaliperHeight" Value="{Binding Path=CaliperHeight, Mode=TwoWay}" />
    <Setter Property="local:LineCaliperROI.StartPoint" Value="{Binding Path=StartPoint, Mode=TwoWay}" />
    <Setter Property="local:LineCaliperROI.EndPoint" Value="{Binding Path=EndPoint, Mode=TwoWay}" />
    <Setter Property="local:LineCaliperROI.CaliperRotateAngle" Value="{Binding Path=CaliperRotateAngle, Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <Canvas>
                  <TextBlock IsHitTestVisible="False" FontWeight="Bold" Margin="3,3,0,0" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" Canvas.Left="{Binding Path=Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X}" Canvas.Top="{Binding Path=Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y}" />
                </Canvas>
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Canvas Name="move" Cursor="SizeAll">
            <local:Arrow x:Name="line" Cursor="SizeAll" HeadHeight="2" HeadWidth="6" Fill="{StaticResource ROIBaseColor}" Stroke="{StaticResource ROIBaseColor}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" X1="{Binding (Canvas.Left), ElementName=startPoint}" Y1="{Binding (Canvas.Top), ElementName=startPoint}" X2="{Binding (Canvas.Left), ElementName=endPoint}" Y2="{Binding (Canvas.Top), ElementName=endPoint}" />
            <Grid RenderTransformOrigin="0.5,0.5" Canvas.Left="{Binding RectTopLeft, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding RectTopLeft, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" Width="{Binding RectWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding RectHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <Rectangle Fill="#00FFFFFF" Stroke="{StaticResource ROIBaseColor}" Margin="{Binding NegativeStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Grid Width="0" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <local:AreaLeft x:Name="left" Style="{StaticResource leftRightAreaStyle}" AreaAngle="{Binding CaliperRotateAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </Grid>
              <Grid Height="0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <local:AreaTop x:Name="top" Style="{StaticResource leftRightAreaStyle}" AreaAngle="{Binding CaliperRotateAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </Grid>
              <Grid Width="0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <local:AreaLeft x:Name="right" Style="{StaticResource leftRightAreaStyle}" AreaAngle="{Binding CaliperRotateAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </Grid>
              <Grid Height="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <local:AreaTop x:Name="bottom" Style="{StaticResource leftRightAreaStyle}" AreaAngle="{Binding CaliperRotateAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </Grid>
              <Grid IsHitTestVisible="False" ZIndex="-1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="3*" />
                  <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid Width="0" Height="0" VerticalAlignment="Top" HorizontalAlignment="Left" Row="1">
                  <Path Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding ArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,6" />
                            <LineSegment Point="-12,0" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
                <Grid Width="0" Height="0" VerticalAlignment="Top" HorizontalAlignment="Right" Row="1">
                  <Path Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding ArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,6" />
                            <LineSegment Point="-12,0" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
              </Grid>
              <UIElement.RenderTransform>
                <RotateTransform Angle="{Binding CaliperRotateAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </UIElement.RenderTransform>
            </Grid>
            <local:AreaRightTopRect x:Name="caliperRect" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding CaliperRotateAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <Ellipse Name="startPoint" Style="{StaticResource EllipseStyle}" Canvas.Left="{Binding Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <Ellipse Name="endPoint" Style="{StaticResource EllipseStyle}" Canvas.Left="{Binding End, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding End, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <local:DrawingCanvas x:Name="drawCanvas" ZIndex="-1" IsHitTestVisible="True" />
            <ContentPresenter Name="cp" />
          </Canvas>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>