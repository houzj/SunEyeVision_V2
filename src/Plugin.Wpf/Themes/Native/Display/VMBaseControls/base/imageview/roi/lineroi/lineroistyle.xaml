<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="{x:Type local:LineROI}" TargetType="{x:Type local:LineROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:LineROI.StartPoint" Value="{Binding Path=StartPoint, Mode=TwoWay}" />
    <Setter Property="local:LineROI.EndPoint" Value="{Binding Path=EndPoint, Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <Canvas>
                  <TextBlock IsHitTestVisible="False" FontWeight="Bold" Margin="3,3,0,0" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" Canvas.Left="{Binding Path=Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X}" Canvas.Top="{Binding Path=Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y}" />
                </Canvas>
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Canvas Name="move" Cursor="SizeAll">
            <local:Arrow x:Name="line" Cursor="SizeAll" Stroke="{StaticResource ROIBaseColor}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" X1="{Binding (Canvas.Left), ElementName=startPoint}" Y1="{Binding (Canvas.Top), ElementName=startPoint}" X2="{Binding (Canvas.Left), ElementName=endPoint}" Y2="{Binding (Canvas.Top), ElementName=endPoint}" />
            <Ellipse Name="startPoint" Style="{StaticResource EllipseStyle}" Canvas.Left="{Binding Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Start, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <Ellipse Name="endPoint" Style="{StaticResource EllipseStyle}" Canvas.Left="{Binding End, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding End, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            <ContentPresenter Name="cp" />
          </Canvas>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="false" Binding="{Binding Sign}" />
                <Condition Value="true" Binding="{Binding UIType}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="line" Property="Shape.Stroke" Value="#EC0000" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Sign}" Value="{x:Null}" />
                <Condition Value="true" Binding="{Binding UIType}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="line" Property="Shape.Stroke" Value="#60FF00" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>