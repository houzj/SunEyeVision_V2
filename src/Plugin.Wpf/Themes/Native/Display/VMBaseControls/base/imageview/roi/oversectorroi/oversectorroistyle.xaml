<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="FeatureSectorBaseStyle" TargetType="{x:Type Path}">
    <Setter Property="Stroke" Value="{StaticResource ROIBaseColor}" />
    <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Fill" Value="#00FFFFFF" />
  </Style>
  <Style x:Key="{x:Type local:OverSectorROI}" TargetType="{x:Type local:OverSectorROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:OverSectorROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:OverSectorROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:OverSectorROI.MinRadius" Value="{Binding Path=(vm_port_0:IOverSectorROI.MinRadius), Mode=TwoWay}" />
    <Setter Property="local:OverSectorROI.CircleRadius" Value="{Binding Path=(vm_port_0:IOverSectorROI.Radius), Mode=TwoWay}" />
    <Setter Property="local:OverSectorROI.CircleCenterPoint" Value="{Binding Path=(vm_port_0:IOverSectorROI.CenterPoint), Mode=TwoWay}" />
    <Setter Property="local:OverSectorROI.StartAngle" Value="{Binding Path=(vm_port_0:IOverSectorROI.StartAngle), Mode=TwoWay}" />
    <Setter Property="local:OverSectorROI.AngleRange" Value="{Binding Path=(vm_port_0:IOverSectorROI.AngleRange), Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Name="move" Cursor="SizeAll">
            <Canvas>
              <Path Name="path" Style="{StaticResource FeatureSectorBaseStyle}">
                <Path.Data>
                  <GeometryGroup>
                    <PathGeometry>
                      <PathFigure x:Name="pFigure" IsClosed="True">
                        <LineSegment x:Name="lSegment1" />
                        <ArcSegment x:Name="aSegment12" IsLargeArc="False" SweepDirection="Counterclockwise" />
                        <ArcSegment x:Name="aSegment11" IsLargeArc="False" SweepDirection="Counterclockwise" />
                        <ArcSegment x:Name="aSegment10" IsLargeArc="False" SweepDirection="Counterclockwise" />
                        <ArcSegment x:Name="aSegment1" IsLargeArc="False" SweepDirection="Counterclockwise" />
                        <LineSegment x:Name="lSegment2" />
                        <ArcSegment x:Name="aSegment2" IsLargeArc="False" SweepDirection="Clockwise" />
                        <ArcSegment x:Name="aSegment20" IsLargeArc="False" SweepDirection="Clockwise" />
                        <ArcSegment x:Name="aSegment21" IsLargeArc="False" SweepDirection="Clockwise" />
                        <ArcSegment x:Name="aSegment22" IsLargeArc="False" SweepDirection="Clockwise" />
                      </PathFigure>
                    </PathGeometry>
                  </GeometryGroup>
                </Path.Data>
              </Path>
              <Path Name="arcPoint" Cursor="Hand" Stretch="Uniform" Fill="{StaticResource AnchorBaseColor}" Stroke="{StaticResource AnchorBaseColor}" Visibility="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource bv}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                <Path.Data>
                  <GeometryGroup>
                    <LineGeometry StartPoint="0,5" EndPoint="10,5" />
                    <PathGeometry>
                      <PathFigure StartPoint="6.9,1" IsClosed="True">
                        <LineSegment Point="8.7,0" />
                        <ArcSegment Point="8.7,10" IsLargeArc="False" SweepDirection="Clockwise" Size="10,10" />
                        <LineSegment Point="6.9,9" />
                        <ArcSegment Point="6.9,1" IsLargeArc="False" SweepDirection="Counterclockwise" Size="8,8" />
                      </PathFigure>
                    </PathGeometry>
                  </GeometryGroup>
                </Path.Data>
              </Path>
              <local:AreaTopRect x:Name="middleStartPoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MiddleStartAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <local:AreaTopRect x:Name="middleEndPoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MiddleEndAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Ellipse Name="startPoint" Style="{StaticResource EllipseStyle}" />
              <Ellipse Name="endPoint" Style="{StaticResource EllipseStyle}" />
              <local:AreaLeftRect x:Name="minMiddlePoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MinMiddleAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <local:AreaLeftRect x:Name="middlePoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MinMiddleAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Path Name="startArrow" Panel.ZIndex="-1" Style="{StaticResource HorizontalArrowStyle}" />
              <Path Name="endArrow" Panel.ZIndex="-1" Style="{StaticResource HorizontalArrowStyle}" />
              <Path Name="arcArrow" Panel.ZIndex="-1" Style="{StaticResource VerticalArrowStyle}" />
            </Canvas>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>