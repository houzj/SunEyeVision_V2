<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="{x:Type local:PointROI}" TargetType="{x:Type local:PointROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:PointROI.CenterPoint" Value="{Binding Path=CenterPoint, Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <Canvas>
                  <TextBlock IsHitTestVisible="False" FontWeight="Bold" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" Canvas.Left="{Binding Path=ContainerPosition, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X}" Canvas.Top="{Binding Path=ContainerPosition, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y}" />
                </Canvas>
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Canvas Name="move" Cursor="SizeAll">
            <Path Stretch="Uniform" Stroke="{StaticResource ROIBaseColor}" Width="{Binding Path=ContainerWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding Path=ContainerHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Left="{Binding Path=ContainerPosition, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=ContainerPosition, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <Path.Data>
                <GeometryGroup>
                  <LineGeometry StartPoint="0,0" EndPoint="1,1" />
                  <LineGeometry StartPoint="1,0" EndPoint="0,1" />
                </GeometryGroup>
              </Path.Data>
            </Path>
            <ContentPresenter Name="cp" />
          </Canvas>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type Interface:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>