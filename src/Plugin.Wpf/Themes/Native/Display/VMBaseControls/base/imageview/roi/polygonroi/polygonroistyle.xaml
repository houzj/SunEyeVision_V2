<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:vmBaseControls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="PolygonBaseStyle" TargetType="{x:Type Polygon}">
    <Setter Property="Margin" Value="{Binding NegativeStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Stroke" Value="#0F6AF3" />
    <Setter Property="Polygon.Points" Value="{Binding Points, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Shape.Stretch" Value="Fill" />
    <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Fill" Value="#00FFFFFF" />
  </Style>
  <Style x:Key="FeaturePolygonStyle" TargetType="{x:Type Polygon}" BasedOn="{StaticResource PolygonBaseStyle}">
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="true" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaBackgroundColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="false" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Sign}" Value="{x:Null}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignSpecialColor}" />
      </MultiDataTrigger>
      <DataTrigger Value="false" Binding="{Binding UIType}">
        <Setter Property="Fill" Value="#00FFFFFF" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type local:PolygonROI}" TargetType="{x:Type local:PolygonROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:PolygonROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:PolygonROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:PolygonROI.PolygonPoints" Value="{Binding Path=(vm_port_0:IPolygonROI.PolygonPoints), Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <TextBlock IsHitTestVisible="False" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3,3,0,0" Foreground="{StaticResource ROITextColor}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" />
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter Grid.Row="0" ContentTemplate="{Binding RoiExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}}" Content="{Binding}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentPresenter}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=RoiExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}, Converter={StaticResource nullJudgeConverter}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentPresenter>
            <Grid Name="move" Row="1" Cursor="SizeAll">
              <Polygon Name="mPolygon" Style="{StaticResource PolygonBaseStyle}" />
              <local:MoveAreaPage x:Name="Rects" Cursor="Arrow" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" RectMargin="{Binding MoveEllipseMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" ItemsSource="{Binding PolygonPoints, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding IsSelected, Converter={StaticResource bv}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <ContentPresenter Name="cp" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROIUIType}}" />
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROISign}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="mPolygon" Property="Style" Value="{StaticResource FeaturePolygonStyle}" />
            </MultiDataTrigger>
            <DataTrigger Value="False" Binding="{Binding Path=RoiExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}, Converter={StaticResource nullJudgeConverter}}">
              <Setter TargetName="mPolygon" Property="Shape.Stroke" Value="{Binding RoiColor}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>