<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base" xmlns:vmBaseControls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <local:GetRectConverter x:Key="GetRectConverter" />
  <Style x:Key="TopAreaStyle" TargetType="{x:Type local:Area}">
    <Setter Property="Margin" Value="{Binding MoveRectMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="local:Area.AreaAngle" Value="{Binding RectAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Visibility" Value="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource bv}}" />
  </Style>
  <Style x:Key="leftRightAreaStyle" TargetType="{x:Type local:Area}">
    <Setter Property="Margin" Value="{Binding MoveRectMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="local:Area.AreaAngle" Value="{Binding RectAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
  </Style>
  <Style x:Key="RotateStyle" TargetType="{x:Type local:RotateArea}">
    <Setter Property="Margin" Value="{Binding MoveRotateMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="local:RotateArea.RectAngle" Value="{Binding RectAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IAngleEnable}}">
        <Setter Property="Visibility" Value="{Binding Path=(vm_port_0:IAngleEnable.IsAngleEnable), Converter={StaticResource bv}}" />
      </DataTrigger>
      <DataTrigger Value="False" Binding="{Binding IsRotatable, RelativeSource={RelativeSource AncestorType=local:RectROI}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FeatureRectBaseStyle" TargetType="{x:Type Rectangle}">
    <Setter Property="Margin" Value="{Binding NegativeStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Stroke" Value="{StaticResource ROIBaseColor}" />
    <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
  </Style>
  <Style x:Key="FeatureRectStyle" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource FeatureRectBaseStyle}">
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="true" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaBackgroundColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="false" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Sign}" Value="{x:Null}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignSpecialColor}" />
      </MultiDataTrigger>
      <DataTrigger Value="false" Binding="{Binding UIType}">
        <Setter Property="Fill" Value="#00FFFFFF" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FeatureSectorBaseStyle" TargetType="{x:Type Path}">
    <Setter Property="Stroke" Value="{StaticResource ROIBaseColor}" />
    <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
  </Style>
  <Style x:Key="{x:Type local:RectROI}" TargetType="{x:Type local:RectROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:RectROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:RectROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:RectROI.ContainerAngle" Value="{Binding Angle, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:RectROI.RectWidth" Value="{Binding Path=(vm_port_0:IRectROI.Width), Mode=TwoWay}" />
    <Setter Property="local:RectROI.RectHeight" Value="{Binding Path=(vm_port_0:IRectROI.Height), Mode=TwoWay}" />
    <Setter Property="local:RectROI.RectAngle" Value="{Binding Path=(vm_port_0:IRectROI.Angle), Mode=TwoWay}" />
    <Setter Property="local:RectROI.RectCenterPoint" Value="{Binding Path=(vm_port_0:IRectROI.CenterPoint), Mode=TwoWay}" />
    <Setter Property="local:RectROI.IsFullScreen" Value="{Binding Path=(vm_port_0:IFullROI.IsFullScreen), Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="tbTemplate">
                <TextBlock IsHitTestVisible="False" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" Foreground="{StaticResource ROITextColor}" Visibility="{Binding IsSeqRect, Converter={StaticResource nbv}}" Text="{Binding DataContext.Label}" FontSize="{Binding LabelFontSize}" />
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter Grid.Row="0" ContentTemplate="{Binding RoiExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}}" Content="{Binding}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentPresenter}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=RoiExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}, Converter={StaticResource nullJudgeConverter}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentPresenter>
            <ContentPresenter Grid.Column="1" ContentTemplate="{Binding RoiRightTopExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}}" Content="{Binding}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentPresenter}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=RoiRightTopExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}, Converter={StaticResource nullJudgeConverter}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentPresenter>
            <Grid Name="move" Row="1" Cursor="SizeAll" Background="#00FFFFFF">
              <Rectangle Name="rc" Style="{StaticResource FeatureRectBaseStyle}" />
              <Grid Width="0" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <local:AreaLeft x:Name="left" Style="{StaticResource leftRightAreaStyle}" />
              </Grid>
              <Grid Height="0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <local:AreaTop x:Name="top" Style="{StaticResource leftRightAreaStyle}" />
              </Grid>
              <Grid Width="0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <local:AreaLeft x:Name="right" Style="{StaticResource leftRightAreaStyle}" />
              </Grid>
              <Grid Height="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <local:AreaTop x:Name="bottom" Style="{StaticResource leftRightAreaStyle}" />
              </Grid>
              <Grid Name="leftTop" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <local:AreaLeftTopRect x:Name="rect1" Style="{StaticResource TopAreaStyle}" />
                <local:TopLeftRotateArea x:Name="topLeftRotate" Style="{StaticResource RotateStyle}" />
              </Grid>
              <Grid Name="rightTop" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <local:AreaRightTopRect x:Name="rect2" Style="{StaticResource TopAreaStyle}" />
                <local:TopRightRotateArea x:Name="topRightRotate" Style="{StaticResource RotateStyle}" />
                <Ellipse IsHitTestVisible="False" ClipToBounds="True" Stroke="{StaticResource AnchorBaseColor}" Visibility="{Binding Visibility, ElementName=topRightRotate}" Margin="{Binding StrokeThickness, ConverterParameter=-20, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource normalMultiplicationConverter}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding StrokeThickness, ConverterParameter=10, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource normalMultiplicationConverter}}" Width="{Binding Height, RelativeSource={RelativeSource Mode=Self}}">
                  <UIElement.Clip>
                    <RectangleGeometry x:Name="eRect" />
                  </UIElement.Clip>
                </Ellipse>
              </Grid>
              <Grid Name="rightBottom" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <local:AreaLeftTopRect x:Name="rect3" Style="{StaticResource TopAreaStyle}" />
                <local:BottomRightRotateArea x:Name="bottomRightRotate" Style="{StaticResource RotateStyle}" />
              </Grid>
              <Grid Name="leftBottom" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <local:AreaRightTopRect x:Name="rect4" Style="{StaticResource TopAreaStyle}" />
                <local:BottomLeftRotateArea x:Name="bottomLeftRotate" Style="{StaticResource RotateStyle}" />
              </Grid>
              <Grid ZIndex="-1" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                  <RowDefinition Height="3*" />
                  <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Grid Width="0" Height="0" VerticalAlignment="Top" HorizontalAlignment="Left" Row="1">
                  <Path Name="leftArrow" Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding ArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,6" />
                            <LineSegment Point="-12,0" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
                <Grid Width="0" Height="0" VerticalAlignment="Top" HorizontalAlignment="Right" Row="1">
                  <Path Name="rightArrow" Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding ArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,6" />
                            <LineSegment Point="-12,0" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
                <TextBlock Grid.Row="1" Text="1" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{StaticResource ROITextColor}" FontSize="{Binding LabelFontSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" Visibility="{Binding IsSeqRect, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource bv}}" />
              </Grid>
              <Grid Name="bottomArrow" ZIndex="-1" IsHitTestVisible="False" Visibility="{Binding IsSeqRect, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource bv}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Column="1">
                  <Path Stroke="#0F6AF3" Fill="#0F6AF3" Stretch="Fill" Margin="{Binding BottomArrowMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                    <Path.Data>
                      <GeometryGroup>
                        <PathGeometry>
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="-6,-6" />
                            <LineSegment Point="-6,6" />
                          </PathFigure>
                        </PathGeometry>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                </Grid>
                <TextBlock Grid.Column="1" Text="2" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="{StaticResource ROITextColor}" FontSize="{Binding LabelFontSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </Grid>
              <Canvas>
                <Line Name="line" Visibility="Collapsed" IsHitTestVisible="False" Stroke="{StaticResource AnchorBaseColor}" X1="{Binding StartPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Y1="{Binding StartPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" X2="{Binding EndPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Y2="{Binding EndPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </Canvas>
              <ContentPresenter Name="cp" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROILabel}}">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource tbTemplate}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROIUIType}}" />
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROISign}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="rc" Property="Style" Value="{StaticResource FeatureRectStyle}" />
            </MultiDataTrigger>
            <DataTrigger Value="False" Binding="{Binding Path=RoiExternTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=vmBaseControls:ImageViewBox}, Converter={StaticResource nullJudgeConverter}}">
              <Setter TargetName="rc" Property="Shape.Stroke" Value="{Binding RoiColor}" />
              <Setter TargetName="leftArrow" Property="Shape.Stroke" Value="{Binding RoiColor}" />
              <Setter TargetName="leftArrow" Property="Shape.Fill" Value="{Binding RoiColor}" />
              <Setter TargetName="rightArrow" Property="Shape.Stroke" Value="{Binding RoiColor}" />
              <Setter TargetName="rightArrow" Property="Shape.Fill" Value="{Binding RoiColor}" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsFullScreen}">
              <Setter TargetName="left" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="right" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="top" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="bottom" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="leftTop" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="rightTop" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="leftBottom" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="rightBottom" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="move" Property="FrameworkElement.Cursor" Value="Arrow" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>