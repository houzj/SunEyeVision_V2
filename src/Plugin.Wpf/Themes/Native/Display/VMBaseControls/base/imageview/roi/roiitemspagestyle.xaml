<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/imageviewitemspagestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type local:ROIItemsPage}" TargetType="{x:Type local:ROIItemsPage}">
    <Setter Property="ItemsSource" Value="{Binding InnerROIList, RelativeSource={RelativeSource Mode=Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Canvas Name="Bd">
            <ItemsPresenter />
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:SubROIItemsPage ItemsSource="{Binding}" ControlToImageRadio="{Binding ControlToImageRadio, RelativeSource={RelativeSource AncestorType=local:ROIItemsPage, Mode=FindAncestor}}" ThicknessScale="{Binding ThicknessScale, RelativeSource={RelativeSource AncestorType=local:ROIItemsPage, Mode=FindAncestor}}" ImageWidth="{Binding ImageWidth, RelativeSource={RelativeSource AncestorType=local:ROIItemsPage, Mode=FindAncestor}}" ImageHeight="{Binding ImageHeight, RelativeSource={RelativeSource AncestorType=local:ROIItemsPage, Mode=FindAncestor}}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>