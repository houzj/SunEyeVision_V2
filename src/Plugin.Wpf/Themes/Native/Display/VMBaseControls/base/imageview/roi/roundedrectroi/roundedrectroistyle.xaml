<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:image="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="RotateStyle" TargetType="{x:Type local:RotateArea}">
    <Setter Property="Margin" Value="{Binding MoveRotateMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="local:RotateArea.RectAngle" Value="{Binding RectAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Visibility" Value="{Binding IsAngleEnable, Converter={StaticResource bv}}" />
  </Style>
</ResourceDictionary>