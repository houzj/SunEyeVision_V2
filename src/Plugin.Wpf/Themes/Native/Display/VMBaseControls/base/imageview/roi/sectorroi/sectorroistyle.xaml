<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:base="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="FeatureSectorBaseStyle" TargetType="{x:Type Path}">
    <Setter Property="Stroke" Value="{StaticResource ROIBaseColor}" />
    <Setter Property="StrokeThickness" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Fill" Value="#00FFFFFF" />
  </Style>
  <Style x:Key="FeatureSectorStyle" TargetType="{x:Type Path}" BasedOn="{StaticResource FeatureSectorBaseStyle}">
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="true" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaBackgroundColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="false" Binding="{Binding Sign}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignColor}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Sign}" Value="{x:Null}" />
          <Condition Value="true" Binding="{Binding UIType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Fill" Value="{StaticResource ROIBaseFeaSignSpecialColor}" />
      </MultiDataTrigger>
      <DataTrigger Value="false" Binding="{Binding UIType}">
        <Setter Property="Fill" Value="#00FFFFFF" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type local:SectorROI}" TargetType="{x:Type local:SectorROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:SectorROI.ContainerWidth" Value="{Binding Width, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:SectorROI.ContainerHeight" Value="{Binding Height, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:SectorROI.MinRadius" Value="{Binding Path=(Interface:ISectorROI.MinRadius), Mode=TwoWay}" />
    <Setter Property="local:SectorROI.CircleRadius" Value="{Binding Path=(Interface:ISectorROI.Radius), Mode=TwoWay}" />
    <Setter Property="local:SectorROI.CircleCenterPoint" Value="{Binding Path=(Interface:ISectorROI.CenterPoint), Mode=TwoWay}" />
    <Setter Property="local:SectorROI.StartAngle" Value="{Binding Path=(Interface:ISectorROI.StartAngle), Mode=TwoWay}" />
    <Setter Property="local:SectorROI.EndAngle" Value="{Binding Path=(Interface:ISectorROI.EndAngle), Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Name="move" Cursor="SizeAll">
            <Canvas>
              <Path Name="path" Style="{StaticResource FeatureSectorBaseStyle}">
                <Path.Data>
                  <GeometryGroup>
                    <PathGeometry>
                      <PathFigure IsClosed="True" StartPoint="{Binding Path=EndPoint, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                        <LineSegment Point="{Binding Path=MinEndPoint, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        <ArcSegment SweepDirection="Counterclockwise" Size="{Binding Path=MinSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" Point="{Binding Path=MinStartPoint, RelativeSource={RelativeSource Mode=TemplatedParent}}" IsLargeArc="{Binding Path=IsLargeArc, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        <LineSegment Point="{Binding Path=StartPoint, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        <ArcSegment SweepDirection="Clockwise" Size="{Binding Path=MaxSize, RelativeSource={RelativeSource Mode=TemplatedParent}}" Point="{Binding Path=EndPoint, RelativeSource={RelativeSource Mode=TemplatedParent}}" IsLargeArc="{Binding Path=IsLargeArc, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                      </PathFigure>
                    </PathGeometry>
                  </GeometryGroup>
                </Path.Data>
              </Path>
              <Path Name="arcPoint" Cursor="Hand" Stretch="Uniform" Fill="{StaticResource AnchorBaseColor}" Stroke="{StaticResource AnchorBaseColor}" Visibility="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource bv}}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                <Path.Data>
                  <GeometryGroup>
                    <LineGeometry StartPoint="0,5" EndPoint="10,5" />
                    <PathGeometry>
                      <PathFigure StartPoint="6.9,1" IsClosed="True">
                        <LineSegment Point="8.7,0" />
                        <ArcSegment Point="8.7,10" IsLargeArc="False" SweepDirection="Clockwise" Size="10,10" />
                        <LineSegment Point="6.9,9" />
                        <ArcSegment Point="6.9,1" IsLargeArc="False" SweepDirection="Counterclockwise" Size="8,8" />
                      </PathFigure>
                    </PathGeometry>
                  </GeometryGroup>
                </Path.Data>
              </Path>
              <local:AreaTopRect x:Name="middleStartPoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MiddleStartAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Left="{Binding Path=MiddleStartPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=MiddleStartPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <local:AreaTopRect x:Name="middleEndPoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MiddleEndAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Left="{Binding Path=MiddleEndPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=MiddleEndPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Ellipse Name="startPoint" Style="{StaticResource EllipseStyle}" Canvas.Left="{Binding Path=StartPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=StartPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Ellipse Name="endPoint" Style="{StaticResource EllipseStyle}" Canvas.Left="{Binding Path=EndPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=EndPoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <local:AreaLeftRect x:Name="minMiddlePoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MinMiddleAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Left="{Binding Path=MinMiddlePoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=MinMiddlePoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <local:AreaLeftRect x:Name="middlePoint" Style="{StaticResource TopAreaStyle}" AreaAngle="{Binding MinMiddleAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Left="{Binding Path=MiddlePoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=X, RelativeSource={RelativeSource Mode=TemplatedParent}}" Canvas.Top="{Binding Path=MiddlePoint, Converter={x:Static base:PointCvt.Cvt}, ConverterParameter=Y, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Path Name="startArrow" Panel.ZIndex="-1" Style="{StaticResource HorizontalArrowStyle}" />
              <Path Name="endArrow" Panel.ZIndex="-1" Style="{StaticResource HorizontalArrowStyle}" />
              <Path Name="arcArrow" Panel.ZIndex="-1" Style="{StaticResource VerticalArrowStyle}" />
            </Canvas>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type Interface:IROIUIType}}" />
                <Condition Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type Interface:IROISign}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="path" Property="Style" Value="{StaticResource FeatureSectorStyle}" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>