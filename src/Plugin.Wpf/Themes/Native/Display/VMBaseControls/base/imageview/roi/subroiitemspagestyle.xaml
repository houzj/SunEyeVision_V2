<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:BaseDate="clr-namespace:Apps.BaseData;assembly=Apps.BaseData" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.BaseData">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/imageviewitemspagestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <vm_port_1:TypeFilterConverter x:Key="typeFilterConverter" />
  <BooleanToVisibilityConverter x:Key="bv" />
  <Style x:Key="{x:Type local:SubROIItemsPage}" TargetType="{x:Type local:SubROIItemsPage}" BasedOn="{StaticResource ImageViewItemsPageStyle}">
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:ROIItem ControlToImageRadio="{Binding ControlToImageRadio, RelativeSource={RelativeSource AncestorType=local:ImageViewItemsPage, Mode=FindAncestor}}" ThicknessScale="{Binding ThicknessScale, RelativeSource={RelativeSource AncestorType=local:ImageViewItemsPage, Mode=FindAncestor}}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Converter={StaticResource typeFilterConverter}, ConverterParameter={x:Type vm_port_0:IROIVisible}}">
        <Setter Property="Visibility" Value="{Binding Path=(vm_port_0:IROIVisible.IsVisible), Converter={StaticResource bv}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>