<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.Shape" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView">
  <Style x:Key="ShapeContainerStyle" TargetType="{x:Type local:ShapeContainer}">
    <Setter Property="local:ShapeContainer.ImageSourceWidth" Value="{Binding ImageSourceWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ShapeItemsPage}}" />
    <Setter Property="local:ShapeContainer.ImageSourceHeight" Value="{Binding ImageSourceHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ShapeItemsPage}}" />
    <Setter Property="local:ShapeContainer.ControlToImageRadio" Value="{Binding ControlToImageRadio, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ShapeItemsPage}}" />
    <Setter Property="local:ShapeContainer.ThicknessScale" Value="{Binding ThicknessScale, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ShapeItemsPage}}" />
    <Setter Property="local:ShapeContainer.BaseStrokeThickness" Value="{Binding Path=(Interface:IShape.StrokeThickness)}" />
    <Setter Property="UIElement.Opacity" Value="{Binding Path=(Interface:IShapeBase.Opacity)}" />
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Path=(Interface:IShape.ToolTip)}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Canvas Name="container" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>