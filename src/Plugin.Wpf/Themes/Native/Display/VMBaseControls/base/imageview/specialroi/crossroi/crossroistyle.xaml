<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView.ROI" xmlns:Interface="clr-namespace:VMControls.RenderInterface;assembly=VMControls.RenderInterface" xmlns:baseControl="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMBaseControls.Base.ImageView" xmlns:baseData="clr-namespace:Apps.BaseData;assembly=Apps.BaseData" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.VMControls.RenderInterface" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.Apps.BaseData">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/VMBaseControls/base/imageview/roi/roicontrolbasestyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <vm_port_1:NormalMultiplicationConverter x:Key="normalMultiplicationConverter" />
  <SolidColorBrush x:Key="ROIBaseColor" Color="#7CFC00" />
  <Style x:Key="RectStyle" TargetType="{x:Type Rectangle}">
    <Setter Property="Stroke" Value="#FF008000" />
    <Setter Property="Fill" Value="#FFFF0000" />
    <Setter Property="Margin" Value="{Binding MoveRectMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="StrokeThickness" Value="{Binding HotStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="Visibility" Value="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource bv}}" />
  </Style>
  <Style x:Key="RotateStyle" TargetType="{x:Type local:RotateArea}">
    <Setter Property="Margin" Value="{Binding MoveRotateMargin, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
    <Setter Property="local:RotateArea.RectAngle" Value="{Binding RectAngle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
  </Style>
  <Style x:Key="{x:Type local:CrossROI}" TargetType="{x:Type local:CrossROI}" BasedOn="{StaticResource ROIControlBaseStyle}">
    <Setter Property="local:ROIControlBase.ContainerPosition" Value="{Binding Position, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=baseControl:ContainerItem}}" />
    <Setter Property="local:CrossROI.CrossCenterPoint" Value="{Binding Path=(vm_port_0:ICrossROI.CenterPoint), Mode=TwoWay}" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Width="0" Height="0">
            <Grid Margin="{Binding NegativeStrokeThickness, ConverterParameter=10, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource ROIBaseColor}" Width="{Binding OriStrokeThickness, ConverterParameter=4, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding OriStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Rectangle HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{StaticResource ROIBaseColor}" Width="{Binding OriStrokeThickness, ConverterParameter=4, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding OriStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Rectangle HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{StaticResource ROIBaseColor}" Width="{Binding OriStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding OriStrokeThickness, ConverterParameter=4, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Rectangle HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{StaticResource ROIBaseColor}" Width="{Binding OriStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="{Binding OriStrokeThickness, ConverterParameter=4, Converter={StaticResource normalMultiplicationConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <Ellipse Fill="#00FFFFFF" Stroke="{StaticResource ROIBaseColor}" Margin="{Binding OriStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" StrokeThickness="{Binding OriStrokeThickness, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>