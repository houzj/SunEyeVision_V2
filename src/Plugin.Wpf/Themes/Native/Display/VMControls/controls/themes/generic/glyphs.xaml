<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls.Themes">
  <Geometry x:Key="UpArrowGeometry">M0,5 L4.5,.5 9,5 6,5 4.5,3.5 3,5 z</Geometry>
  <Geometry x:Key="DownArrowGeometry">M0,0 L3,0 4.5,1.5 6,0 9,0 4.5,4.5 z</Geometry>
  <DataTemplate x:Key="IncreaseGlyphNormalKey">
    <Path Width="9" Height="5" Fill="{DynamicResource {x:Static themes:ResourceKeys.GlyphNormalForegroundKey}}" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Data="{StaticResource UpArrowGeometry}" />
  </DataTemplate>
  <DataTemplate x:Key="IncreaseGlyphDisabledKey">
    <Path Width="9" Height="5" Fill="{DynamicResource {x:Static themes:ResourceKeys.GlyphDisabledForegroundKey}}" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Data="{StaticResource UpArrowGeometry}" />
  </DataTemplate>
  <DataTemplate x:Key="DecreaseGlyphNormalKey">
    <Path Width="9" Height="5" Fill="{DynamicResource {x:Static themes:ResourceKeys.GlyphNormalForegroundKey}}" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Data="{StaticResource DownArrowGeometry}" />
  </DataTemplate>
  <DataTemplate x:Key="DecreaseGlyphDisabledKey">
    <Path Width="9" Height="5" Fill="{DynamicResource {x:Static themes:ResourceKeys.GlyphDisabledForegroundKey}}" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Data="{StaticResource DownArrowGeometry}" />
  </DataTemplate>
</ResourceDictionary>