<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:convert="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMUtility.Convert">
  <convert:OrMultiValueConvertor x:Key="OrConverter" />
  <Style x:Key="{x:Type local:EditableTextBlock}" TargetType="{x:Type local:EditableTextBlock}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EditableTextBlock}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="2" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="textBlockHeader" VerticalAlignment="Center" Text="{Binding Text, Mode=TwoWay}" />
            <TextBox Name="editableTextBoxHeader" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0" Grid.Row="0" Grid.Column="0" Visibility="Hidden" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}}">
              <Setter Property="local:EditableTextBlock.IsListView" Value="True" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True">
                  <Condition.Binding>
                    <MultiBinding Converter="{StaticResource OrConverter}">
                      <Binding Path="IsListView" />
                      <Binding Path="IsSelected" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}" />
                    </MultiBinding>
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter Property="local:EditableTextBlock.IsSelected" Value="True" />
            </MultiDataTrigger>
            <DataTrigger Value="False" Binding="{Binding Path=IsSelected}">
              <Setter Property="local:EditableTextBlock.IsInEditMode" Value="False" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Path=IsInEditMode}">
              <Setter TargetName="editableTextBoxHeader" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>