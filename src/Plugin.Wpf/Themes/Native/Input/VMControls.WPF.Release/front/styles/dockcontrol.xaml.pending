<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Release.Front">
  <Style x:Key="DockControl" TargetType="{x:Type local:DockControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DockControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter xmlns:controls="clr-namespace:FrontendUI.Design.Controls;assembly=FrontendUI.Design" Content="{TemplateBinding controls:DockControl.LeftBar}" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding DockControl.Content}" />
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding DockControl.RightBar}" />
            </Grid>
            <ContentPresenter Grid.Row="1" Content="{TemplateBinding DockControl.BottomBar}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>