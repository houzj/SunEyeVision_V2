<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:VmControls="clr-namespace:VM.Controls.Core.Converters;assembly=VM.Controls" xmlns:conv="clr-namespace:VM.Controls.Core.Converters" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls" xmlns:vm_port_1="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.VMControls.Core.Converters" xmlns:vm_port_2="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_2:ColorThemesResourceDictionary.Instance" />
    <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <vm_port_1:InverseBoolConverter x:Key="InverseBoolConverter" />
  <Style x:Key="GeometryThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <Border.BorderBrush>
              <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFA500">
                      <GeometryDrawing.Geometry>
                        <GeometryGroup>
                          <RectangleGeometry Rect="0,0,50,50" />
                          <RectangleGeometry Rect="50,50,50,50" />
                        </GeometryGroup>
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Border.BorderBrush>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="button1" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="#F2DD99" Opacity="0.6">
            <TextBlock Name="displayText" MaxHeight="40" LineStackingStrategy="BlockLineHeight" Visibility="Visible" IsHitTestVisible="True" Cursor="SizeAll" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top" Width="{Binding Width, ElementName=grid}" Text="{Binding CommentText, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:CommentBox}}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ResizeDecoratorTemplate" TargetType="{x:Type Control}">
    <Grid Name="grid" Opacity="0.7" SnapsToDevicePixels="True" Visibility="Visible">
      <local:ResizeThumb Height="2" BorderThickness="2" Cursor="SizeNS" Margin="-1 -1 -1 -1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Width="2" BorderThickness="2" Cursor="SizeWE" Margin="0 0 0 0" VerticalAlignment="Stretch" HorizontalAlignment="Left" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Width="2" BorderThickness="2" Cursor="SizeWE" Margin="0 0 0 0" VerticalAlignment="Stretch" HorizontalAlignment="Right" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Height="2" BorderThickness="2" Cursor="SizeNS" Margin="0 0 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Width="3" Height="3" BorderThickness="3" Cursor="SizeNWSE" Margin="0 0 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Width="3" Height="3" BorderThickness="3" Cursor="SizeNESW" Margin="0 0 0 0" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Width="3" Height="3" BorderThickness="3" Cursor="SizeNESW" Margin="0 0 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Style="{StaticResource GeometryThumb}" />
      <local:ResizeThumb Width="3" Height="3" BorderThickness="3" Cursor="SizeNWSE" Margin="0 0 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource GeometryThumb}" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="{x:Type local:CommentBox}" TargetType="{x:Type local:CommentBox}">
    <Setter Property="UIElement.Opacity" Value="0.4" />
    <Setter Property="FrameworkElement.ContextMenu">
      <Setter.Value>
        <vm_port_0:HikContextMenu>
          <MenuItem Header="{DynamicResource Lang_Top}" Command="{Binding UpCanvasCommand}" />
          <MenuItem Header="{DynamicResource Lang_ToDown}" Command="{Binding BottomCanvasCommand}" />
          <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteCommentBoxCommand}" />
        </vm_port_0:HikContextMenu>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Focusable="True" Background="#00FFFFFF">
            <Border Name="currentBorder" Focusable="True" CornerRadius="0">
              <Border.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0" Opacity="0.03">
                  <GradientStop Color="#FFC6570C" Offset="0" />
                  <GradientStop Color="#FFFD8112" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid Name="grid" Margin="0,0,0,0">
                <Button Name="dragButton" Padding="0" VerticalAlignment="Top" Cursor="SizeAll" Style="{StaticResource button1}" IsEnabled="{Binding IsLockWorkArea, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramPage}, Converter={StaticResource InverseBoolConverter}}" />
                <TextBox Name="dragElement" Visibility="Collapsed" BorderThickness="0" Background="#F2DD99" Opacity="1" MaxLength="200" VerticalAlignment="Top" local:TextBoxAttach.AutoHeight="True" AcceptsReturn="True" TextBlock.LineHeight="20" TextWrapping="Wrap" IsEnabled="{Binding IsLockWorkArea, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramPage}, Converter={StaticResource InverseBoolConverter}}" Width="{Binding Width, ElementName=grid}" ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" Text="{Binding CommentText, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:CommentBox}}" />
                <Canvas Name="WorkView" Focusable="True" Width="{Binding ActualWidth, ElementName=grid}" Height="{Binding ActualHeight, ElementName=grid}" />
                <Button Name="itemDelBtn" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" Cursor="Hand" Width="25" Height="20" Style="{StaticResource IcDeleteBtnStyle}" IsEnabled="{Binding IsLockWorkArea, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramPage}, Converter={StaticResource InverseBoolConverter}}" Command="{Binding DeleteCommentBoxCommand}" />
                <Control Template="{StaticResource ResizeDecoratorTemplate}" />
              </Grid>
            </Border>
            <UIElement.InputBindings>
              <KeyBinding Key="Delete" Command="{Binding DeleteCommentBoxCommand}" />
            </UIElement.InputBindings>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>