<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:user="clr-namespace:VM.User;assembly=VM.User" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
    <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type local:Connection}" TargetType="{x:Type local:Connection}">
    <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Ligature}" />
    <Setter Property="Fill" Value="{Binding Path=Stroke, RelativeSource={RelativeSource Mode=Self}}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="FrameworkElement.ContextMenu">
      <Setter.Value>
        <controls:HikContextMenu>
          <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteConnectionCommand}" />
        </controls:HikContextMenu>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsFocused" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Selected_Ligature}" />
      </Trigger>
      <DataTrigger Value="true" Binding="{Binding SourceItem.IsFocused, RelativeSource={RelativeSource Self}}">
        <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Selected_Ligature}" />
      </DataTrigger>
      <DataTrigger Value="true" Binding="{Binding TargetItem.IsFocused, RelativeSource={RelativeSource Self}}">
        <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Selected_Ligature}" />
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding IsLockWorkArea, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
      <DataTrigger Value="False" Binding="{Binding IsAdmin, Source={x:Static user:CodeManager.Instance}}">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="StrokeThickness" Value="3" />
      </Trigger>
      <Trigger Property="local:Connection.IsDragOver" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Connecting_Ligature}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>