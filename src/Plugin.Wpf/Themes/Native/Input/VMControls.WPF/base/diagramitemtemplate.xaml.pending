  <DataTemplate x:Key="GroupCirculationBackground">
    <Grid Name="grid" Margin="-5" IsHitTestVisible="False">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="ArrowImage" TargetType="{x:Type Image}">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Source" Value="/Apps.Style;component/Resources/ic_cycle_right.png" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsModuleForbidden, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramItem}}">
                <Setter Property="Source" Value="/Apps.Style;component/Resources/ic_cycle_right_disable.png" />
              </DataTrigger>
              <DataTrigger Value="True" Binding="{Binding IsModuleFailed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramItem}}">
                <Setter Property="Source" Value="/Apps.Style;component/Resources/ic_cycle_right_disable.png" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Border Name="bd" BorderBrush="#66F9F5F2" BorderThickness="2" CornerRadius="3">
        <Border.Background>
          <LinearGradientBrush EndPoint="0,1" StartPoint="0,0" Opacity="0.08">
            <GradientStop Color="#19F6F6F6" Offset="0" />
            <GradientStop Color="#33F3F3F3" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <UIElement.Effect>
          <DropShadowEffect Color="Black" ShadowDepth="3" Opacity="0.5" />
        </UIElement.Effect>
      </Border>
      <Image Margin="0,-4,0,0" VerticalAlignment="Top" Style="{StaticResource ArrowImage}" />
      <Image Margin="0,0,0,-4" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{StaticResource ArrowImage}">
        <UIElement.RenderTransform>
          <RotateTransform Angle="180" />
        </UIElement.RenderTransform>
      </Image>
      <Image Margin="-3,0,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Style="{StaticResource ArrowImage}">
        <UIElement.RenderTransform>
          <RotateTransform Angle="-90" />
        </UIElement.RenderTransform>
      </Image>
      <Image Margin="0,0,-3,0" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5" Style="{StaticResource ArrowImage}">
        <UIElement.RenderTransform>
          <RotateTransform Angle="90" />
        </UIElement.RenderTransform>
      </Image>
    </Grid>
  </DataTemplate>
  <Style x:Key="NormalModulePathStyle" TargetType="{x:Type Path}">
    <Setter Property="Shape.Stretch" Value="Fill" />
    <Setter Property="Data">
      <Setter.Value>
        <PathGeometry>
