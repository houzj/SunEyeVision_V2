                <RectangleGeometry RadiusX="2" RadiusY="2" Rect="7,6,12,16" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingGroup>
      </DrawingGroup>
    </DrawingGroup>
  </DrawingGroup>
  <DrawingImage x:Key="switch_off____DrawingImage" Drawing="{StaticResource switch_off____DrawingGroup}" />
  <DataTemplate x:Key="RunStopButton">
    <commomcontrol:SuperImageButton Command="{Binding RunContinuousCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type commomcontrol:SuperImageButton}">
          <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_MutiRun}" />
          <Setter Property="commomcontrol:SuperImageButton.NormalConnent">
            <Setter.Value>
              <Image Stretch="None" Source="{StaticResource ic______normalDrawingImage}" />
            </Setter.Value>
          </Setter>
          <Setter Property="commomcontrol:SuperImageButton.DisableConnent">
            <Setter.Value>
              <Image Stretch="None" Source="{StaticResource ic______disableDrawingImage}" />
            </Setter.Value>
          </Setter>
          <Setter Property="commomcontrol:SuperImageButton.PressedConnent">
            <Setter.Value>
              <Image Width="36" Height="36" Source="{StaticResource ic______clickDrawingImage}" />
            </Setter.Value>
          </Setter>
          <Setter Property="commomcontrol:SuperImageButton.MOverConnent">
            <Setter.Value>
              <Image Stretch="None" Source="{StaticResource ic______hoverDrawingImage}" />
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding DecorateSource.ContinuousRunEnable}">
              <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Lang_StopRun}" />
              <Setter Property="commomcontrol:SuperImageButton.NormalConnent">
                <Setter.Value>
                  <Image Stretch="None" Source="{StaticResource ic_stop_normalDrawingImage}" />
                </Setter.Value>
              </Setter>
              <Setter Property="commomcontrol:SuperImageButton.DisableConnent">
                <Setter.Value>
                  <Image Stretch="None" Source="{StaticResource ic_stop_disableDrawingImage}" />
                </Setter.Value>
              </Setter>
              <Setter Property="commomcontrol:SuperImageButton.PressedConnent">
                <Setter.Value>
                  <Image Stretch="None" Source="{StaticResource ic_stop_clickDrawingImage}" />
                </Setter.Value>
              </Setter>
              <Setter Property="commomcontrol:SuperImageButton.MOverConnent">
                <Setter.Value>
                  <Image Stretch="None" Source="{StaticResource ic_stop_hoverDrawingImage}" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </commomcontrol:SuperImageButton>
  </DataTemplate>
  <Style x:Key="MenuItemDisLinkTo" TargetType="{x:Type MenuItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <MenuItem Header="{Binding Name}" Command="{Binding DataContext.DeleteConnectionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <vm_port_1:HikContextMenu x:Key="NormalOperateMenu">
    <MenuItem Header="{DynamicResource Lang_Disconnect}" ItemContainerStyle="{Binding Source={StaticResource MenuItemDisLinkTo}}" ItemsSource="{Binding DisLinkTo}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Style.Triggers>
            <DataTrigger Value="0" Binding="{Binding ItemsSource.Count, RelativeSource={RelativeSource Mode=Self}}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteItemCommand}" />
    <MenuItem Header="{DynamicResource Lang_Copy}" Command="{Binding CopyItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLoadFailed}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Copy parameters}" Command="{Binding CopyAlgoParamItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="False" Binding="{Binding IsSupportCopyParam}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Paste parameters}" Command="{Binding PasteAlgoParamItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLoadFailed}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Rename}" Command="{Binding RenameCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Forbidden}" Command="{Binding ForbiddenItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="True" Binding="{Binding IsSingleProcedure}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Enabled}" Command="{Binding ActivateItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="True" Binding="{Binding IsForbidden}" />
                <Condition Value="True" Binding="{Binding IsSingleProcedure}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
  </vm_port_1:HikContextMenu>
  <ControlTemplate x:Key="Square" TargetType="{x:Type local:DiagramItem}">
    <Grid Name="PART_View" Width="40" Height="40">
      <Rectangle Name="Rec" Fill="#00FFFFFF" Margin="-10" />
      <Path Name="itemBorder" Margin="0.2" Style="{StaticResource NormalModulePathStyle}">
        <UIElement.Effect>
          <DropShadowEffect Color="#FF121111" ShadowDepth="3" Opacity="0.45" />
        </UIElement.Effect>
      </Path>
      <Canvas Name="StateFlag" Height="22" VerticalAlignment="Top" Clip="{Binding Data, ElementName=itemBorder}" />
      <Image Name="LogoIm" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Source="{Binding StateImagePath}" />
      <Path Name="errorBorder" Visibility="Collapsed" Stroke="#FF636468" StrokeThickness="2" Stretch="Fill" Data="{Binding Data, ElementName=itemBorder}" />
      <Grid Margin="0,18,0,0">
        <Grid HorizontalAlignment="Center" TextBlock.FontWeight="Bold" TextBlock.FontSize="12" TextBlock.Foreground="{vm_port_0:ColorResourceBinding Col_EditProcess_Foreground}">
          <TextBlock Name="Id" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding DecorateSource.ID}" />
        </Grid>
      </Grid>
      <ContentPresenter Name="leftConnector" Content="{x:Null}" />
      <ContentPresenter Name="rightConnector" Content="{x:Null}" />
      <ContentPresenter Name="topConnector" Content="{x:Null}" />
      <ContentPresenter Name="bottomConnector" Content="{x:Null}" />
    </Grid>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="local:DiagramItem.IsHited" Value="True" />
          <Condition Property="local:DiagramItem.IsLockWorkArea" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="leftConnector" Property="ContentPresenter.Content" Value="{StaticResource left}" />
        <Setter TargetName="rightConnector" Property="ContentPresenter.Content" Value="{StaticResource right}" />
        <Setter TargetName="topConnector" Property="ContentPresenter.Content" Value="{StaticResource top}" />
        <Setter TargetName="bottomConnector" Property="ContentPresenter.Content" Value="{StaticResource bottom}" />
      </MultiTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemDisplayEnum.ADORNER}" Binding="{Binding DisplayType, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource diagramItemDisplayConverter}}">
        <Setter TargetName="Id" Property="TextBlock.Text" Value="{x:Null}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.FUNCTION}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource FunctionModulePath}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.TIMER}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource TimerModulePath}" />
      </DataTrigger>
      <Trigger Property="local:DiagramItem.RunState" Value="{x:Null}">
        <Setter TargetName="LogoIm" Property="Image.Source" Value="{Binding NormalImagePath}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.RunState" Value="True">
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_OK_Status}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.RunState" Value="False">
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_NG_Status}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleConfigCorrect" Value="False">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="errorBorder" Property="Shape.StrokeDashArray" Value="3,2" />
        <Setter TargetName="itemBorder" Property="Shape.Fill">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
              <GradientStop Color="#FFFAF7F5" Offset="0" />
              <GradientStop Color="#FFE1E5E1" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleForbidden" Value="True">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="itemBorder" Property="Shape.Fill">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
              <GradientStop Color="#D3D3D3F5" Offset="0" />
              <GradientStop Color="#D3D3D3E1" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter TargetName="LogoIm" Property="Image.Source" Value="{Binding StateImagePath}" />
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{x:Null}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleFailed" Value="True">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="itemBorder" Property="Shape.Fill">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
              <GradientStop Color="#FFFAF7F5" Offset="0" />
              <GradientStop Color="#FFEBE6E2" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter TargetName="LogoIm" Property="Image.Source" Value="{Binding StateImagePath}" />
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_NG_Status}" />
        <Setter TargetName="Id" Property="UIElement.Opacity" Value="0.4" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="errorBorder" Property="Shape.Stroke" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_BorderBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <vm_port_1:HikContextMenu x:Key="SquareOperateMenu">
    <MenuItem Header="{DynamicResource Lang_Disconnect}" ItemContainerStyle="{Binding Source={StaticResource MenuItemDisLinkTo}}" ItemsSource="{Binding DisLinkTo}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Style.Triggers>
            <DataTrigger Value="0" Binding="{Binding ItemsSource.Count, RelativeSource={RelativeSource Mode=Self}}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteItemCommand}" />
    <MenuItem Header="{DynamicResource Lang_Copy}" Command="{Binding CopyItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLoadFailed}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Copy parameters}" Command="{Binding CopyAlgoParamItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Paste parameters}" Command="{Binding PasteAlgoParamItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLoadFailed}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Rename}" Command="{Binding RenameWindowCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Forbidden}" Command="{Binding ForbiddenItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="True" Binding="{Binding IsSingleProcedure}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Enabled}" Command="{Binding ActivateItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="True" Binding="{Binding IsForbidden}" />
                <Condition Value="True" Binding="{Binding IsSingleProcedure}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
  </vm_port_1:HikContextMenu>
  <ControlTemplate x:Key="NORMAL" TargetType="{x:Type local:DiagramItem}">
    <Grid Name="PART_View" Width="110" Height="30">
      <Rectangle Name="Rec" Fill="#00FFFFFF" Margin="-10" />
      <Path Name="itemBorder" Margin="0.2" Style="{StaticResource NormalModulePathStyle}">
        <UIElement.Effect>
          <DropShadowEffect Color="#FF121111" ShadowDepth="3" Opacity="0.45" />
        </UIElement.Effect>
      </Path>
      <Canvas Name="StateFlag" Width="26" HorizontalAlignment="Left" Clip="{Binding Data, ElementName=itemBorder}" />
      <Image Name="LogoIm" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Source="{Binding StateImagePath}" />
      <Path Name="errorBorder" Visibility="Collapsed" Stroke="#FF636468" StrokeThickness="2" Stretch="Fill" Data="{Binding Data, ElementName=itemBorder}" />
      <Grid Margin="26,0,0,0">
        <Grid HorizontalAlignment="Center" TextBlock.FontWeight="Bold" TextBlock.FontSize="12" TextBlock.Foreground="{vm_port_0:ColorResourceBinding Col_EditProcess_Foreground}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="Id" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding DecorateSource.ID}" />
          <appUi:HeadReNameTextBox Name="itemName" Grid.Column="1" Background="#00FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" BorderThickness="0" MaxLength="{x:Static local:DiagramItem.MaxNameLenth}" Foreground="{vm_port_0:ColorResourceBinding Col_EditProcess_Foreground}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}" IsReName="{Binding IsReName, Mode=TwoWay}" />
        </Grid>
      </Grid>
      <ContentPresenter Name="leftConnector" Content="{x:Null}" />
      <ContentPresenter Name="rightConnector" Content="{x:Null}" />
      <ContentPresenter Name="topConnector" Content="{x:Null}" />
      <ContentPresenter Name="bottomConnector" Content="{x:Null}" />
    </Grid>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="local:DiagramItem.IsHited" Value="True" />
          <Condition Property="local:DiagramItem.IsLockWorkArea" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="leftConnector" Property="ContentPresenter.Content" Value="{StaticResource left}" />
        <Setter TargetName="rightConnector" Property="ContentPresenter.Content" Value="{StaticResource right}" />
        <Setter TargetName="topConnector" Property="ContentPresenter.Content" Value="{StaticResource top}" />
        <Setter TargetName="bottomConnector" Property="ContentPresenter.Content" Value="{StaticResource bottom}" />
      </MultiTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemDisplayEnum.ADORNER}" Binding="{Binding DisplayType, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource diagramItemDisplayConverter}}">
        <Setter TargetName="Id" Property="TextBlock.Text" Value="{x:Null}" />
        <Setter TargetName="itemName" Property="TextBox.Text" Value="{Lang:ResourceBinding DecorateSource.Name}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.IMAGE}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource ImageModulePath}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.IFBRANCH}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource IfBranchPath}" />
        <Setter TargetName="PART_View" Property="FrameworkElement.Height" Value="40" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.FUNCTION}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource FunctionModulePath}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.SHELL}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource ShellModulePath}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:DiagramItemSubDisplayEnum.COMMUNCATION}" Binding="{Binding TargetDisplayType}">
        <Setter TargetName="itemBorder" Property="Path.Data" Value="{StaticResource CommuncationDataPath}" />
      </DataTrigger>
      <Trigger Property="local:DiagramItem.RunState" Value="{x:Null}">
        <Setter TargetName="LogoIm" Property="Image.Source" Value="{Binding NormalImagePath}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.RunState" Value="True">
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_OK_Status}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.RunState" Value="False">
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_NG_Status}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleConfigCorrect" Value="False">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="errorBorder" Property="Shape.StrokeDashArray" Value="3,2" />
        <Setter TargetName="itemBorder" Property="Shape.Fill">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
              <GradientStop Color="#FFFAF7F5" Offset="0" />
              <GradientStop Color="#FFE1E5E1" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleForbidden" Value="True">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="itemBorder" Property="Shape.Fill">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
              <GradientStop Color="#D3D3D3F5" Offset="0" />
              <GradientStop Color="#D3D3D3E1" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter TargetName="LogoIm" Property="Image.Source" Value="{Binding StateImagePath}" />
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{x:Null}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleFailed" Value="True">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="itemBorder" Property="Shape.Fill">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
              <GradientStop Color="#FFFAF7F5" Offset="0" />
              <GradientStop Color="#FFEBE6E2" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter TargetName="LogoIm" Property="Image.Source" Value="{Binding StateImagePath}" />
        <Setter TargetName="StateFlag" Property="Panel.Background" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_NG_Status}" />
        <Setter TargetName="itemName" Property="UIElement.Opacity" Value="0.4" />
        <Setter TargetName="Id" Property="UIElement.Opacity" Value="0.4" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter TargetName="errorBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="errorBorder" Property="Shape.Stroke" Value="{vm_port_0:ColorResourceBinding Col_EditProcess_Modular_BorderBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="CheckMenuItemStyle" TargetType="{x:Type MenuItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border Background="{TemplateBinding Control.Background}" MinWidth="156" BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding Control.BorderBrush}" HorizontalAlignment="Stretch" Height="30">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Name="Icon" ContentSource="Icon" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="Center" />
              <StackPanel Name="HeaderHost" Orientation="Horizontal" Margin="12,0,0,0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding HeaderedItemsControl.Header}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <ToggleButton Margin="5,0,0,0" IsChecked="{Binding DecorateSource.IsProcessRunStop, Mode=TwoWay}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Image Name="icon" Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/swith_off.png" Stretch="Fill" />
                            <ControlTemplate.Triggers>
                              <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/swith_on.png" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </FrameworkElement.Style>
                </ToggleButton>
              </StackPanel>
              <ContentPresenter Name="Shortcuts" Margin="0,0,12,0" Grid.Column="2" ContentSource="InputGestureText" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsSuspendingPopupAnimation" Value="True" />
            <Trigger Property="MenuItem.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="HeaderHost" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource ListViewComboBoxIsSelected}" Property="Background" />
              <Setter Property="BorderBrush" Value="{vm_port_0:ColorResourceBinding Col_Theme}" />
            </Trigger>
            <Trigger Property="MenuItem.IsChecked" Value="True">
              <Setter Property="Background" Value="{vm_port_0:ColorResourceBinding Col_Theme}" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="MenuItem.IsPressed" Value="True">
              <Setter Property="Background" Value="{vm_port_0:ColorResourceBinding Col_Theme}" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <vm_port_1:HikContextMenu x:Key="ProcessOperateMenu">
    <MenuItem Header="{DynamicResource Lang_Disconnect}" ItemContainerStyle="{Binding Source={StaticResource MenuItemDisLinkTo}}" ItemsSource="{Binding DisLinkTo}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Style.Triggers>
            <DataTrigger Value="0" Binding="{Binding ItemsSource.Count, RelativeSource={RelativeSource Mode=Self}}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Name="exportItem" Header="{DynamicResource Lang_PrcExport}" Command="{Binding ProcessExportCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding IsRemoteMode}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <!--Unknown connection ID: 1-->
    </MenuItem>
    <MenuItem Name="exportItemRemote" Header="{DynamicResource Lang_PrcExport}">
      <MenuItem Header="{DynamicResource Remote}" Command="{Binding ProcessExportRemoteCommand}" />
      <MenuItem Header="{DynamicResource Local}" Command="{Binding ProcessExportCommand}" />
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsRemoteMode}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <!--Unknown connection ID: 2-->
    </MenuItem>
    <MenuItem Name="copyItem" Header="{DynamicResource Lang_ProcessCopy}" Command="{Binding CopyCommand}">
      <!--Unknown connection ID: 3-->
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_ExportAlgorithmCode}" Command="{Binding ExportAlgorithmCommand}" />
    <MenuItem Header="{DynamicResource Lang_RunInterval}" Command="{Binding SetIntervalCommand}" />
    <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteItemCommand}" />
    <MenuItem Header="{DynamicResource Lang_StopProcessNG}" Style="{StaticResource CheckMenuItemStyle}" />
    <MenuItem Header="{DynamicResource Lang_Rename}" Command="{Binding RenameCommand}" />
    <MenuItem Header="{DynamicResource Lang_ProcessTimeOut}" Command="{Binding SetTimeOutCommand}" />
  </vm_port_1:HikContextMenu>
  <ControlTemplate x:Key="PROCESS" TargetType="{x:Type local:DiagramItem}">
    <Grid Name="PART_View" Width="140" Height="120">
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.RowSpan="2" IsHitTestVisible="False" Background="#00FFFFFF" CornerRadius="3">
        <UIElement.Effect>
          <DropShadowEffect Color="#FF121111" ShadowDepth="3" Opacity="0.45" />
        </UIElement.Effect>
      </Border>
      <Rectangle Name="Rec" Grid.RowSpan="2" Fill="#00FFFFFF" Margin="-20" />
      <Border Name="itemBorder" Grid.Row="1" CornerRadius="0,0,4,4" Background="#FFF2F3F5" />
      <Grid Name="subGrid" Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Name="controlArea" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=workEnable}">
          <commomcontrol:SuperImageButton ToolTip="{DynamicResource Lang_SigRun}" Style="{StaticResource SuperImageButtonRunOnceStyle}" Command="{Binding RunOnceCommand}">
            <commomcontrol:SuperImageButton.NormalConnent>
              <Image Stretch="None" Source="{StaticResource ic_play_____normalDrawingImage}" />
            </commomcontrol:SuperImageButton.NormalConnent>
            <commomcontrol:SuperImageButton.DisableConnent>
              <Image Stretch="None" Source="{StaticResource ic_play_____disableDrawingImage}" />
            </commomcontrol:SuperImageButton.DisableConnent>
            <commomcontrol:SuperImageButton.PressedConnent>
              <Image Stretch="None" Source="{StaticResource ic_play_____clickDrawingImage}" />
            </commomcontrol:SuperImageButton.PressedConnent>
            <commomcontrol:SuperImageButton.MOverConnent>
              <Image Stretch="None" Source="{StaticResource ic_play_____hoverDrawingImage}" />
            </commomcontrol:SuperImageButton.MOverConnent>
          </commomcontrol:SuperImageButton>
          <ContentPresenter Margin="2,0,0,0" Style="{StaticResource ContentPresenterContinousRunStyle}" ContentTemplate="{StaticResource RunStopButton}" Content="{Binding}" />
          <Line X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" Width="3" Height="18" Margin="5.5,0,3.5,0" StrokeThickness="1" Stroke="#575858" StrokeDashArray="3,1.2" VerticalAlignment="Center" />
          <commomcontrol:SuperImageButton Command="{Binding ConfigParamsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}" CommandParameter="{Binding}">
            <commomcontrol:SuperImageButton.NormalConnent>
              <Image Source="/Apps.Style;component/Resources/ic_图形配置_normal.png" Stretch="None" />
            </commomcontrol:SuperImageButton.NormalConnent>
            <commomcontrol:SuperImageButton.DisableConnent>
              <Image Source="/Apps.Style;component/Resources/ic_图形配置_normal.png" Stretch="None" />
            </commomcontrol:SuperImageButton.DisableConnent>
            <commomcontrol:SuperImageButton.PressedConnent>
              <Image Source="/Apps.Style;component/Resources/ic_图形配置_click.png" Stretch="None" />
            </commomcontrol:SuperImageButton.PressedConnent>
            <commomcontrol:SuperImageButton.MOverConnent>
              <Image Source="/Apps.Style;component/Resources/ic_图形配置_hover.png" Stretch="None" />
            </commomcontrol:SuperImageButton.MOverConnent>
          </commomcontrol:SuperImageButton>
        </StackPanel>
        <Rectangle Fill="#FFE0DFDE" Height="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="126" />
        <Grid Row="1">
          <StackPanel Orientation="Vertical" Margin="12,0,0,0" HorizontalAlignment="Left" TextBlock.FontSize="11" TextBlock.Foreground="{DynamicResource ParamsTabForeground}">
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{Binding DecorateSource.ExecuteCount}" />
              <TextBlock Text="{DynamicResource 次}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Text="{Binding DecorateSource.ProcessTime, StringFormat='{}{0:N2}ms', Mode=OneWay}" />
          </StackPanel>
          <ToggleButton Name="workEnable" Margin="0,1,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding IsForbidden, Converter={StaticResource inverseBooleanConverter}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ToggleButton}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Grid Background="#00FFFFFF">
                        <Image Name="bg" Width="40" Height="28" Source="{StaticResource switch_off____DrawingImage}" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                          <Setter TargetName="bg" Property="Image.Source" Value="{StaticResource switch_on____DrawingImage}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
          </ToggleButton>
        </Grid>
      </Grid>
      <Border Name="Drag_View" Cursor="SizeAll" CornerRadius="4,4,0,0" Attached:EventOfMouseDownToDoubleClick.Event="MouseDown" Background="{vm_port_0:ColorResourceBinding Col_EditProcess_AllProcess_Title_Background}" Attached:AttachedRoutedEventBase.Command="{Binding OpenProcedureCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localwpf:ProcedureConfigControl}}">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Ellipse Name="light" Width="8" Height="8" Fill="#FFEC0000" Margin="10,0,0,0" />
            <appUi:HeadReNameTextBox Name="itemName" Margin="5,0,0,0" Width="90" HorizontalAlignment="Left" Background="#00FFFFFF" Foreground="#FFE4E4E4" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" BorderThickness="0" MaxLength="{x:Static local:DiagramItem.MaxNameLenth}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}" IsReName="{Binding IsReName, Mode=TwoWay}" />
          </StackPanel>
          <Button VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" Cursor="Arrow" Command="{Binding OpenProcedureCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=localwpf:ProcedureConfigControl}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Grid Background="#00FFFFFF">
                        <Image Name="bg" Source="/Apps.Style;component/Resources/ic_展开_click.png" Stretch="None" Visibility="Hidden" />
                        <Image Source="/Apps.Style;component/Resources/ic_展开_normal.png" Stretch="None" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="bg" Property="Visibility" Value="Visible" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="Click">
                <core:ChangePropertyAction PropertyName="IsSelected" Value="True" i:TargetedTriggerAction.TargetObject="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </Button>
        </Grid>
      </Border>
      <Canvas Name="ContansFail" Visibility="Collapsed" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="20" Height="20" Margin="10,0,0,0">
        <Panel.Background>
          <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/ic_flow_group_notice.png" />
        </Panel.Background>
      </Canvas>
      <ContentPresenter Name="leftConnector" Grid.RowSpan="2" Content="{x:Null}" />
      <ContentPresenter Name="rightConnector" Grid.RowSpan="2" Content="{x:Null}" />
      <ContentPresenter Name="topConnector" Grid.RowSpan="2" Content="{x:Null}" />
      <ContentPresenter Name="bottomConnector" Grid.RowSpan="2" Content="{x:Null}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Value="{x:Static DataForUI:ModuleDisplayType.PROCESSADORNER}" Property="local:DiagramItem.DisplayType">
        <Setter TargetName="itemName" Property="TextBox.Text" Value="{Lang:ResourceBinding DecorateSource.Name}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="local:DiagramItem.IsHited" Value="True" />
          <Condition Property="local:DiagramItem.IsLockWorkArea" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="leftConnector" Property="ContentPresenter.Content" Value="{StaticResource left}" />
        <Setter TargetName="rightConnector" Property="ContentPresenter.Content" Value="{StaticResource right}" />
        <Setter TargetName="topConnector" Property="ContentPresenter.Content" Value="{StaticResource top}" />
        <Setter TargetName="bottomConnector" Property="ContentPresenter.Content" Value="{StaticResource bottom}" />
      </MultiTrigger>
      <Trigger Property="local:DiagramItem.IsModuleFailed" Value="{x:Null}">
        <Setter TargetName="ContansFail" Property="UIElement.Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter TargetName="itemBorder" Property="Border.BorderBrush" Value="{vm_port_0:ColorResourceBinding Col_Theme}" />
        <Setter TargetName="itemBorder" Property="Border.BorderThickness" Value="2,0,2,2" />
      </Trigger>
      <DataTrigger Value="{x:Static DataForUI:StatusBarSymbol.Ready}" Binding="{Binding WorkState}">
        <Setter TargetName="light" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <vm_port_1:HikContextMenu x:Key="GroupOperateMenu">
    <MenuItem Header="{DynamicResource Lang_Delet}" Command="{Binding DeleteItemCommand}" />
    <MenuItem Header="{DynamicResource Lang_Copy}" Command="{Binding CopyItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLoadFailed}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_ExportGroup}" Command="{Binding ExportGroupCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding IsRemoteMode}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_ExportGroup}">
      <MenuItem Header="{DynamicResource Remote}" Command="{Binding ExportGroupRemoteCommand}" />
      <MenuItem Header="{DynamicResource Local}" Command="{Binding ExportGroupCommand}" />
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsRemoteMode}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_ExportAlgorithmCode}" Visibility="Collapsed" Command="{Binding ExportAlgorithmCommand}" />
    <MenuItem Header="{DynamicResource Lang_Rename}" Command="{Binding RenameCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_EnablePermissions}" Command="{Binding EnablePasswordCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="{Binding IsPasswordEnabledA, Converter={StaticResource bool2CollapesdConverter}}" />
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_SetScriptPassword}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="{Binding IsPasswordEnabledA, Converter={StaticResource bool2VisibilityConverter}}" />
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsForbidden}" />
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <MenuItem Header="{DynamicResource Lang_EditPassword}" Command="{Binding EditPasswordCommand}" />
      <MenuItem Header="{DynamicResource Lang_DeletePassword}" Command="{Binding CancelPasswordCommand}" />
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_AddToToolbox}" Command="{Binding AddToToolboxCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLoadFailed}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Forbidden}" Command="{Binding ForbiddenItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="False" Binding="{Binding IsForbidden}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem Header="{DynamicResource Lang_Enabled}" Command="{Binding ActivateItemCommand}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding IsLoadFailed}" />
                <Condition Value="True" Binding="{Binding IsForbidden}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
  </vm_port_1:HikContextMenu>
  <ControlTemplate x:Key="GROUP" TargetType="{x:Type local:DiagramItem}">
    <Grid Name="PART_View" Width="110" Height="40">
      <ContentPresenter Name="cp" ContentTemplate="{x:Null}" Content="{x:Null}" />
      <Border IsHitTestVisible="False" Background="#00FFFFFF" CornerRadius="3">
        <UIElement.Effect>
          <DropShadowEffect Color="#FF121111" ShadowDepth="3" Opacity="0.45" />
        </UIElement.Effect>
      </Border>
      <Rectangle Name="Rec" Fill="#00FFFFFF" Margin="-10" />
      <Canvas Name="itemBorder">
        <Panel.Background>
          <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_bg.png" />
        </Panel.Background>
      </Canvas>
      <Canvas Name="ContansFail" Visibility="Collapsed" HorizontalAlignment="Right" Width="20" Margin="10,20,0,0">
        <Panel.Background>
          <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/ic_flow_group_notice.png" />
        </Panel.Background>
      </Canvas>
      <Grid TextBlock.Foreground="{DynamicResource ModuleForeground}" TextBlock.FontWeight="Bold" TextBlock.FontSize="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Margin="7,0,0,0" Command="{Binding ConfigParamsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}" CommandParameter="{Binding}">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Image Name="ImageBackground" Stretch="None" Source="/Apps.Style;component/Resources/ic_group_configuration_normal.png" Tag="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_group_configuration_click.png" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_group_configuration_disable.png" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsModuleForbidden, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramItem}}">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_group_configuration_disable.png" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsModuleFailed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramItem}}">
                  <Setter TargetName="ImageBackground" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_group_configuration_disable.png" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="Click">
              <ChangePropertyAction PropertyName="IsSelected" Value="True" i:TargetedTriggerAction.TargetObject="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" xmlns="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Button>
        <Grid HorizontalAlignment="Center" Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <appUi:HeadReNameTextBox Name="itemName" Grid.Column="1" Background="#00FFFFFF" Foreground="{DynamicResource ModuleForeground}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" BorderThickness="0" MaxLength="{x:Static local:DiagramItem.MaxNameLenth}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}" IsReName="{Binding IsReName, Mode=TwoWay}" />
        </Grid>
        <Image Name="grouplock" Grid.Column="1" Margin="0,0,-20,-5" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Collapsed" Stretch="None" Source="pack://application:,,,/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_group_encryption.png" />
      </Grid>
      <ContentPresenter Name="leftConnector" Content="{x:Null}" />
      <ContentPresenter Name="rightConnector" Content="{x:Null}" />
      <ContentPresenter Name="topConnector" Content="{x:Null}" />
      <ContentPresenter Name="bottomConnector" Content="{x:Null}" />
    </Grid>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="local:DiagramItem.IsHited" Value="True" />
          <Condition Property="local:DiagramItem.IsLockWorkArea" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="leftConnector" Property="ContentPresenter.Content" Value="{StaticResource left}" />
        <Setter TargetName="rightConnector" Property="ContentPresenter.Content" Value="{StaticResource right}" />
        <Setter TargetName="topConnector" Property="ContentPresenter.Content" Value="{StaticResource top}" />
        <Setter TargetName="bottomConnector" Property="ContentPresenter.Content" Value="{StaticResource bottom}" />
      </MultiTrigger>
      <Trigger Value="{x:Static DataForUI:ModuleDisplayType.GROUPADORNER}" Property="local:DiagramItem.DisplayType">
        <Setter TargetName="itemName" Property="TextBox.Text" Value="{Lang:ResourceBinding DecorateSource.Name}" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_bg_focus.png" />
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:DiagramItem.RunState" Value="True">
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_正常.png" />
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:DiagramItem.RunState" Value="false">
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_异常.png" />
          </Setter.Value>
        </Setter>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ListBoxItem.IsSelected" Value="True" />
          <Condition Property="local:DiagramItem.RunState" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_正常选中.png" />
          </Setter.Value>
        </Setter>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ListBoxItem.IsSelected" Value="True" />
          <Condition Property="local:DiagramItem.RunState" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_异常选中.png" />
          </Setter.Value>
        </Setter>
      </MultiTrigger>
      <Trigger Property="local:DiagramItem.IsModuleForbidden" Value="True">
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_bg_forbidden.png" />
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleFailed" Value="True">
        <Setter TargetName="itemBorder" Property="Panel.Background">
          <Setter.Value>
            <ImageBrush Stretch="None" ImageSource="/Apps.Style;component/Resources/group_bg_load_fail.png" />
          </Setter.Value>
        </Setter>
        <Setter TargetName="itemName" Property="UIElement.Opacity" Value="0.4" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsModuleFailed" Value="{x:Null}">
        <Setter TargetName="ContansFail" Property="UIElement.Visibility" Value="Visible" />
      </Trigger>
      <DataTrigger Value="True" Binding="{Binding DecorateSource.IsEnableLoop}">
        <Setter TargetName="cp" Property="ContentPresenter.ContentTemplate" Value="{StaticResource GroupCirculationBackground}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static DataForUI:ModuleDisplayType.GROUP}" Binding="{Binding DisplayType}">
        <Setter TargetName="grouplock" Property="UIElement.Visibility" Value="{Binding IsPasswordEnabledA, Converter={StaticResource bool2VisibilityConverter}}" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="NONE" TargetType="{x:Type local:DiagramItem}" />
  <Style x:Key="{x:Type local:DiagramItem}" TargetType="{x:Type local:DiagramItem}">
    <Setter Property="local:DiagramItem.DisplayType" Value="{Binding DisplayType}" />
    <Setter Property="local:DiagramItem.IsModuleConfigCorrect" Value="{Binding DecorateSource.IsReady}" />
    <Setter Property="local:DiagramItem.IsLockWorkArea" Value="{Binding IsLockWorkArea, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}" />
    <Setter Property="local:DiagramItem.IsOpenParams" Value="{Binding IsOpenParams, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}" />
    <Setter Property="local:DiagramItem.DeleteCommand" Value="{Binding DeleteItemCommand}" />
    <Setter Property="Template" Value="{StaticResource NORMAL}" />
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding DecorateSource.Name}" />
    <Style.Triggers>
      <DataTrigger Value="{x:Static local:DiagramItemDisplayEnum.MODULE}" Binding="{Binding DisplayType, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource diagramItemDisplayConverter}}">
        <Setter Property="local:DiagramItem.IsModuleForbidden" Value="{Binding IsForbidden}" />
        <Setter Property="local:DiagramItem.IsModuleFailed" Value="{Binding IsLoadFailed}" />
        <Setter Property="local:DiagramItem.RunState" Value="{Binding DecorateSource.IsRunOK}" />
        <Setter Property="local:DiagramItem.NextItemsSource" Value="{Binding Path=DecorateSource.(VMInterface:IVmModule.NextModules)}" />
        <Setter Property="local:DiagramItem.Position" Value="{Binding Position}" />
        <Setter Property="Attached:AttachedRoutedEvent.Event" Value="MouseDoubleClick" />
        <Setter Property="Attached:AttachedRoutedEventBase.Command" Value="{Binding ConfigParamsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}" />
        <Setter Property="Attached:AttachedRoutedEventBase.CommandParameter" Value="{Binding}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource NormalOperateMenu}" />
      </DataTrigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.FUNCTION}">
        <Setter Property="Template" Value="{StaticResource Square}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource SquareOperateMenu}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.FUNCTIONADORNER}">
        <Setter Property="Template" Value="{StaticResource Square}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource SquareOperateMenu}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.TIMER}">
        <Setter Property="Template" Value="{StaticResource Square}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource SquareOperateMenu}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.TIMERADORNER}">
        <Setter Property="Template" Value="{StaticResource Square}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource SquareOperateMenu}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.PROCESS}">
        <Setter Property="Template" Value="{StaticResource PROCESS}" />
        <Setter Property="local:DiagramItem.IsModuleFailed" Value="{Binding IsLoadFailed}" />
        <Setter Property="local:DiagramItem.Position" Value="{Binding Position}" />
        <Setter Property="local:DiagramItem.NextItemsSource" Value="{Binding Path=DecorateSource.(VMInterface:IVmModule.NextModules)}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource ProcessOperateMenu}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.PROCESSADORNER}">
        <Setter Property="Template" Value="{StaticResource PROCESS}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.GROUP}">
        <Setter Property="local:DiagramItem.IsModuleForbidden" Value="{Binding IsForbidden}" />
        <Setter Property="local:DiagramItem.IsModuleFailed" Value="{Binding IsLoadFailed}" />
        <Setter Property="local:DiagramItem.RunState" Value="{Binding DecorateSource.IsRunOK}" />
        <Setter Property="Template" Value="{StaticResource GROUP}" />
        <Setter Property="local:DiagramItem.Position" Value="{Binding Position}" />
        <Setter Property="local:DiagramItem.NextItemsSource" Value="{Binding Path=DecorateSource.(VMInterface:IVmModule.NextModules)}" />
        <Setter Property="Attached:AttachedRoutedEvent.Event" Value="MouseDoubleClick" />
        <Setter Property="Attached:AttachedRoutedEventBase.Command" Value="{Binding SubSource.OpenGroupCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}" />
        <Setter Property="Attached:AttachedRoutedEventBase.CommandParameter" Value="{Binding}" />
        <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource GroupOperateMenu}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.GROUPADORNER}">
        <Setter Property="Template" Value="{StaticResource GROUP}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.GROUPADORNER}">
        <Setter Property="Template" Value="{StaticResource GROUP}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.DisplayType" Value="{x:Static DataForUI:ModuleDisplayType.NONE}">
        <Setter Property="Template" Value="{StaticResource NONE}" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter Property="Panel.ZIndex" Value="10" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsLockWorkArea" Value="True">
        <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
      </Trigger>
      <Trigger Property="local:DiagramItem.IsOpenParams" Value="True">
        <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
      </Trigger>
      <DataTrigger Value="False" Binding="{Binding IsAdmin, Source={x:Static user:CodeManager.Instance}}">
        <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>