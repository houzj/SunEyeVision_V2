          <GradientStop Color="#F3F6F5" Offset="0.47" />
          <GradientStop Color="#ECEDF0" Offset="0.82" />
          <GradientStop Color="#EBE6E2" Offset="0.97" />
          <GradientStop Color="#EB6600" Offset="1.0" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
