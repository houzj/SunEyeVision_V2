<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base">
  <Style x:Key="{x:Type local:ItemsPage}" TargetType="{x:Type local:ItemsPage}">
    <Setter Property="UIElement.AllowDrop" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</ResourceDictionary>