<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base">
  <Style x:Key="{x:Type local:RectDragPanalBase}" TargetType="{x:Type local:RectDragPanalBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Background="#00FFFFFF">
            <Rectangle Name="Rec" Fill="#00FFFFFF" Margin="-10" />
            <Border CornerRadius="3">
              <Rectangle Stroke="#7FDA780F" StrokeThickness="2" StrokeDashArray="5,2" RadiusX="3" RadiusY="3" />
              <Border.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0" Opacity="0.03">
                  <GradientStop Color="#FFC6570C" Offset="0" />
                  <GradientStop Color="#FFFD8112" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <UIElement.Effect>
                <DropShadowEffect Color="Black" Opacity="0.65" ShadowDepth="4" />
              </UIElement.Effect>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>