<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.VMControls.WPF.Base" xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" xmlns:vm_port_0="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.Apps.ColorFun" xmlns:vm_port_0_="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="vm_port_0:ColorThemesResourceDictionary.Instance" />
    <x:StaticExtension Member="vm_port_0_:LocalizationResourceDictionary.Instance" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/NormalButtonStyle.xaml" />
    <ResourceDictionary Source="/Apps.Style;component/ButtonStyle/BottomButtonStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  <Style x:Key="cbx" TargetType="{x:Type ToggleButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ButtonBase.ClickMode" Value="Press" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
            <Image Name="icon" Height="16" Width="16" Source="/Apps.Style;component/Resources/combo_ic_triangle_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/combo_ic_triangle_click.png" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
              <Setter TargetName="icon" Property="Image.Source" Value="/Apps.Style;component/Resources/combo_ic_triangle_click.png" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="comboboxPro" TargetType="{x:Type ComboBox}">
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Col_ComboBox_Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="30" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="{x:Type ComboBoxItem}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Rectangle Name="Rect" Grid.ColumnSpan="3" Height="0" StrokeThickness="1" Stroke="{DynamicResource Col_Theme}" VerticalAlignment="Bottom" Opacity="0.7" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Back" Property="Border.Background" Value="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup_Selected_Background}" />
                  </Trigger>
                  <Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <Setter TargetName="Back" Property="Border.Background" Value="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup_Selected_Background}" />
                    <Setter TargetName="Rect" Property="Height" Value="1" />
                  </Trigger>
                  <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                    <Setter TargetName="Back" Property="Border.Background" Value="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup_Selected_Background}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid Background="{TemplateBinding Control.Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
              <Grid>
                <Border Name="DropDown" Margin="0" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderThickness="0" CornerRadius="1" Padding="0,6,0,6" BorderBrush="{vm_port_0:ColorResourceBinding Col_ComboBox_BorderBrush}" Background="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup}">
                  <UIElement.Effect>
                    <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                  </UIElement.Effect>
                  <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
            <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{StaticResource cbx}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Grid Column="0" Margin="11,0,0,0">
              <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <ContentPresenter />
            </Grid>
            <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
              <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
            </DataTrigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
              <Setter Property="IsTabStop" Value="False" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type local:SearchDryPopup}" TargetType="{x:Type local:SearchDryPopup}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SearchDryPopup}">
          <Border Name="Border" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding local:SearchDryPopup.CornerRadius}" Opacity="0.3" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
            <Grid Name="PART_Root">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <Grid Width="280" Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Name="SearchComboBox" Grid.Column="0" Margin="10,0,0,0" Width="100" Height="30" Style="{StaticResource comboboxPro}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                      <i:InvokeCommandAction Command="{Binding SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SearchDryPopup}}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                  <ComboBoxItem Content="{DynamicResource Lang_AllProcess}" />
                  <ComboBoxItem Content="{DynamicResource Lang_CurrentProcess}" />
                </ComboBox>
                <TextBlock Name="PART_TextBlockTips" Grid.Column="1" Text="{DynamicResource 请输入搜索条件}" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{vm_port_0:ColorResourceBinding Col_ComboBox_Foreground}" />
                <TextBox Name="PART_TextBoxInput" Grid.Column="1" Width="155" Height="30" Margin="15,0,0,0" Padding="0,0,20,0" Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" CaretBrush="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=Self}}" Foreground="{vm_port_0:ColorResourceBinding Col_ComboBox_Foreground}" Text="{Binding SearchText, Delay=100, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SearchDryPopup}}">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                        <Setter Property="Border.CornerRadius" Value="2" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
                      </Style>
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                </TextBox>
                <Button Name="PART_ButtonClear" Width="30" Height="30" Grid.Column="2" Visibility="Collapsed" Margin="-30,0,0,0" Style="{StaticResource IcSearchDeleteBtnStyle}" />
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                      <DataTrigger Value="true" Binding="{Binding IsSearchShow, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SearchDryPopup}}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Value="false" Binding="{Binding IsSearchShow, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SearchDryPopup}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Grid>
              <CheckBox Name="cbExpand" Grid.Column="1" Margin="0,0,0,0" Background="#00FFFFFF">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type CheckBox}">
                    <Setter Property="BorderBrush" Value="{DynamicResource ListViewComboBoxBordBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="ToggleButton.IsChecked" Value="{Binding IsSearchShow, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SearchDryPopup}}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                            <Image Name="im" Source="/Apps.Style;component/Resources/ic_note_search_normal.png" Stretch="None" />
                            <UIElement.Effect>
                              <DropShadowEffect Opacity="1" ShadowDepth="2" BlurRadius="8" Color="Black" />
                            </UIElement.Effect>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="ToggleButton.IsChecked" Value="true">
                              <Setter TargetName="im" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_rightarrow32_normal.png" />
                            </Trigger>
                            <MultiTrigger>
                              <MultiTrigger.Conditions>
                                <Condition Property="ToggleButton.IsChecked" Value="true" />
                                <Condition Property="UIElement.IsMouseOver" Value="True" />
                              </MultiTrigger.Conditions>
                              <Setter TargetName="im" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_rightarrow32_click.png" />
                            </MultiTrigger>
                            <MultiTrigger>
                              <MultiTrigger.Conditions>
                                <Condition Property="ToggleButton.IsChecked" Value="false" />
                                <Condition Property="UIElement.IsMouseOver" Value="True" />
                              </MultiTrigger.Conditions>
                              <Setter TargetName="im" Property="Image.Source" Value="/Apps.Style;component/Resources/ic_note_search_click.png" />
                            </MultiTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </FrameworkElement.Style>
              </CheckBox>
              <local:PopupEx x:Name="PART_Popup" AllowsTransparency="True" Topmost="False" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" Placement="Bottom" StaysOpen="True">
                <Border Padding="0,0,4,0">
                  <Border Name="Shdw" Background="#00FFFFFF" MaxWidth="252" MinWidth="{Binding ActualWidth, ElementName=PART_Root}">
                    <Border Name="DropDownBorder" Margin="0,1,0,0" BorderBrush="{DynamicResource ListViewComboBoxBordBrush}" BorderThickness="0" Background="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup}">
                      <Grid RenderOptions.ClearTypeHint="Enabled">
                        <Border Name="NoResultBorder" Padding="14" Background="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup}">
                          <TextBlock Text="{DynamicResource 无匹配结果}" Foreground="{vm_port_0:ColorResourceBinding Col_ComboBox_Foreground}" />
                        </Border>
                        <ListBox Name="PART_ListBoxSearchResult" ItemsSource="{TemplateBinding local:SearchDryPopup.SearchResultCollection}" Foreground="{DynamicResource Col_ComboBox_Foreground}" Margin="0,10" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" MaxHeight="215" VirtualizingPanel.IsVirtualizing="True" BorderThickness="0" Background="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="40*" />
                                  <ColumnDefinition Width="20*" />
                                  <ColumnDefinition Width="40*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Foreground="{DynamicResource Col_ComboBox_Foreground}" Content="{Binding GroupName}" />
                                <Label Grid.Column="2" Foreground="{DynamicResource Col_ComboBox_Foreground}" Content="{Binding FullPath}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                              <Setter Property="Background" Value="#00FFFFFF" />
                              <Setter Property="Foreground" Value="#FFFFFFFF" />
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="BorderThickness" Value="0" />
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border Name="Bd" Height="38" Margin="0,0,0,4" BorderThickness="0" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                                      <Grid>
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter HorizontalAlignment="Stretch" Margin="14,0,0,0" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                                        <Rectangle Name="Rect" Grid.ColumnSpan="3" Height="0" StrokeThickness="1" Stroke="{DynamicResource Col_Theme}" VerticalAlignment="Bottom" Opacity="0.7" />
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Border.Background" Value="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup_Selected_Background}" />
                                        <Setter TargetName="Rect" Property="Height" Value="1" />
                                      </Trigger>
                                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Border.Background" Value="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup_Selected_Background}" />
                                        <Setter TargetName="Rect" Property="Height" Value="1" />
                                      </Trigger>
                                      <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                          <Condition Property="ListBoxItem.IsSelected" Value="True" />
                                          <Condition Property="Selector.IsSelectionActive" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Border.Background" Value="{vm_port_0:ColorResourceBinding Col_ComboBox_Popup_Selected_Background}" />
                                      </MultiTrigger>
                                      <Trigger Property="IsEnabled" Value="False">
                                        <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                        </ListBox>
                      </Grid>
                    </Border>
                  </Border>
                </Border>
              </local:PopupEx>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="UIElement.Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>