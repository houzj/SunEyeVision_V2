<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="PopbuttonTemplate" TargetType="{x:Type ComboBox}">
    <Grid Name="MainGrid" SnapsToDevicePixels="True">
      <Popup Name="PART_Popup" AllowsTransparency="True" Margin="1" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" HorizontalOffset="{Binding HorizontalOffsetVal, RelativeSource={RelativeSource TemplatedParent}}" VerticalOffset="{Binding VerticalOffsetVal, RelativeSource={RelativeSource TemplatedParent}}">
        <ContentPresenter ContentTemplate="{Binding SubContent, RelativeSource={RelativeSource TemplatedParent}}" Content="{Binding}" />
      </Popup>
      <Grid Name="GT">
        <ToggleButton Name="TO" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Style="{Binding ButtonStyle, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="ArrowButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{x:Null}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Margin="0,-1,0,1">
            <Image Name="image" Source="{Binding ElementName=UserControl, Path=TBtnBgNormal}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="image" Property="Image.Source" Value="{Binding ElementName=UserControl, Path=TBtnBgHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>