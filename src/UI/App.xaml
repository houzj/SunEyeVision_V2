<Application x:Class="SunEyeVision.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SunEyeVision.UI"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 应用资源 -->
                <ResourceDictionary Source="Shell/Resources/AppResources.xaml"/>
                <!-- 节点样式资源 -->
                <ResourceDictionary Source="Resources/Styles/NodeStyleResources.xaml"/>
                <!-- 连接线样式资源 -->
                <ResourceDictionary Source="Resources/Styles/ConnectionStyleResources.xaml"/>
                <!-- Canvas样式资源 -->
                <ResourceDictionary Source="Resources/Styles/CanvasStyleResources.xaml"/>
                <!-- 通用样式资源 -->
                <ResourceDictionary Source="Resources/Styles/CommonStyleResources.xaml"/>
                <!-- 菜单样式资源（主题化菜单弹出框，跟随亮/暗主题） -->
                <ResourceDictionary Source="Resources/Styles/MenuStyleResources.xaml"/>
                <!-- 全局 ToolTip 样式资源（主题化悬浮提示，跟随亮/暗主题） -->
                <ResourceDictionary Source="Resources/Styles/ToolTipStyleResources.xaml"/>
                <!-- 首次启动及启动页默认暗色；ThemeManager 初始化后恢复用户已保存的主题。 -->
                <ResourceDictionary Source="Themes/Dark/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
