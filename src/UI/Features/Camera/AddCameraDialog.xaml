<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.Camera.AddCameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        mc:Ignorable="d"
        Title="添加相机"
        Width="700"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">
    
    <local:ThemeDialogWindow.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        </Style>
    </local:ThemeDialogWindow.Resources>

    <Grid Margin="20" TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索与接口选择：只搜索勾选的接口，默认仅 GigE -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="{Binding SearchButtonText}"
                    Command="{Binding SearchCommand}"
                    MinWidth="146" Height="36" Padding="12,0" Margin="0,0,8,0"
                    Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="停止搜索"
                    Command="{Binding StopCommand}"
                    MinWidth="92" Height="36" Padding="12,0"
                    Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="搜索接口：" VerticalAlignment="Center" FontSize="13"/>
                <CheckBox Content="GigE" IsChecked="{Binding IsGigEVisionSelected}" Margin="4,0,12,0"/>
                <CheckBox Content="USB3" IsChecked="{Binding IsUsb3VisionSelected}" Margin="0,0,12,0"/>
                <CheckBox Content="模拟" IsChecked="{Binding IsSimulationSelected}"/>
            </StackPanel>
            <TextBlock Text="{Binding SearchStatus}" Grid.ColumnSpan="3"
                       Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        </Grid>
        
        <!-- 相机列表 -->
        <GroupBox Grid.Row="1" Header="发现的相机" Margin="0,0,0,12" Padding="12">
            <ListBox ItemsSource="{Binding DiscoveredCameras}"
                     SelectedItem="{Binding SelectedCamera}"
                     SelectionMode="Single"
                     ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}"
                     Height="200"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                     Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                                <TextBlock Text="已添加" Margin="8,0,0,0"
                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"
                                           FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                <Run Text="IP: "/>
                                <Run Text="{Binding IpAddress}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                <Run Text="制造商: "/>
                                <Run Text="{Binding Manufacturer}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                <Run Text="型号: "/>
                                <Run Text="{Binding Model}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        
        <!-- 相机名称 -->
        <GroupBox Grid.Row="2" Header="相机名称" Margin="0,0,0,12" Padding="12">
            <StackPanel>
                <TextBox Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="32" Padding="8" 
                         FontSize="14"
                         BorderThickness="1"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}" Margin="0,4,0,0">
                    <Run Text="（自动生成: "/>
                    <Run Text="{Binding SelectedCamera.Manufacturer, FallbackValue='未知'}"/>
                    <Run Text="-"/>
                    <Run Text="{Binding SelectedCamera.Model, FallbackValue='未知'}"/>
                    <Run Text="-001）"/>
                </TextBlock>
            </StackPanel>
        </GroupBox>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定"
                    Command="{Binding ConfirmCommand}"
                    Width="80" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Width="80" Height="32"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</local:ThemeDialogWindow>
