<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.Camera.AddCameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        mc:Ignorable="d"
        Title="添加相机"
        Width="700"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">
    
    <local:ThemeDialogWindow.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
        </Style>
    </local:ThemeDialogWindow.Resources>

    <Grid Margin="20" TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 搜索按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="🔍 搜索相机"
                    Command="{Binding SearchCommand}"
                    Width="120" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="⏸ 停止"
                    Command="{Binding StopCommand}"
                    Width="80" Height="32"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <TextBlock Text="{Binding SearchStatus}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        </StackPanel>
        
        <!-- 相机列表 -->
        <GroupBox Grid.Row="2" Header="发现的相机" Margin="0,0,0,12" Padding="12">
            <ListBox ItemsSource="{Binding DiscoveredCameras}"
                     SelectedItem="{Binding SelectedCamera}"
                     SelectionMode="Single"
                     ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}"
                     Height="200"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                     Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                <Run Text="IP: "/>
                                <Run Text="{Binding IpAddress}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                <Run Text="制造商: "/>
                                <Run Text="{Binding Manufacturer}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                <Run Text="型号: "/>
                                <Run Text="{Binding Model}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        
        <!-- 相机名称 -->
        <GroupBox Grid.Row="3" Header="相机名称" Margin="0,0,0,12" Padding="12">
            <StackPanel>
                <TextBox Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="32" Padding="8" 
                         FontSize="14"
                         BorderThickness="1"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}" Margin="0,4,0,0">
                    <Run Text="（自动生成: "/>
                    <Run Text="{Binding SelectedCamera.Manufacturer, FallbackValue='未知'}"/>
                    <Run Text="-"/>
                    <Run Text="{Binding SelectedCamera.Model, FallbackValue='未知'}"/>
                    <Run Text="-001）"/>
                </TextBlock>
            </StackPanel>
        </GroupBox>
        
        <!-- 连接信息（可选） -->
        <GroupBox Grid.Row="4" Header="连接信息（可选）" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名:" VerticalAlignment="Center" Margin="0,0,8,4" FontSize="13" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username}" Height="32" Margin="0,0,16,4" 
                         Padding="8" FontSize="14" BorderThickness="1"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="密码:" VerticalAlignment="Center" Margin="0,0,8,4" FontSize="13" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                <PasswordBox Grid.Row="0" Grid.Column="3" Height="32" Margin="0,0,0,4" 
                           Padding="8" FontSize="14" BorderThickness="1"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Height="32" Margin="0,0,0,0" 
                         Padding="8" FontSize="14" BorderThickness="1"/>
            </Grid>
        </GroupBox>
        
        <!-- 厂商 SDK 选项 -->
        <CheckBox Grid.Row="5" Content="使用厂商 SDK 增强功能（需要额外配置）" 
                  IsChecked="{Binding UseVendorSdk}" 
                  Margin="0,0,0,12"
                  FontSize="13" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定"
                    Command="{Binding ConfirmCommand}"
                    Width="80" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Width="80" Height="32"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</local:ThemeDialogWindow>
