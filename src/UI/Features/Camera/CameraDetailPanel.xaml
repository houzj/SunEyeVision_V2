<UserControl x:Class="SunEyeVision.UI.Features.Camera.CameraDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:visibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             xmlns:camera="clr-namespace:SunEyeVision.UI.Features.Camera"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="600" d:DesignWidth="400">
    <UserControl.Resources>
        <visibility:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="请选择相机查看详情" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" FontSize="14"
                   Visibility="{Binding IsCameraSelected, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}"/>
        <Grid Margin="10" Visibility="{Binding IsCameraSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,2,4,8">
                <TextBlock Text="常用属性" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                <Button Content="预览" Width="96" Height="32" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PreviewCommand}"/>
            </Grid>
            <camera:CameraParameterPanel Grid.Row="1" DataContext="{Binding}" ShowCategoryNavigation="False"/>
        </Grid>
    </Grid>
</UserControl>
