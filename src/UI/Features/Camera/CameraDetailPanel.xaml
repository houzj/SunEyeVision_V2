<UserControl x:Class="SunEyeVision.UI.Features.Camera.CameraDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SunEyeVision.UI.Features.Camera"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:visibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <visibility:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        
        <!-- TabControl 样式 -->
        <Style x:Key="DetailTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="DetailTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Margin="0,0,8,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                            ContentSource="Header"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ComboBox 统一继承应用级主题模板，避免回退到 WPF 白色默认 Popup -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBoxStyle}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}"/>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ExpanderButton" Grid.Column="0" Width="14" Height="14"
                                                  Padding="0" Background="Transparent" BorderThickness="0"
                                                  Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path x:Name="Chevron" Width="6" Height="8"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 6 4 L 0 8 Z"
                                                          Fill="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" CenterX="3" CenterY="4"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="90" CenterX="3" CenterY="4"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="ExpanderButton" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 跨 Tab 固定操作区 -->
        <Grid Grid.Row="0" Margin="12,8,12,4"
              Visibility="{Binding IsCameraSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectedCamera.Name}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding ConnectionActionText}" Width="96" Height="32" Margin="0,0,8,0"
                        IsEnabled="{Binding IsCameraSelected}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ToggleConnectionCommand}"/>
                <Button Content="预览" Width="80" Height="32"
                        IsEnabled="{Binding IsCameraSelected}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PreviewCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 未选中相机时的提示 -->
        <TextBlock Grid.RowSpan="3" Text="请选择相机查看详情"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#999999"
                   FontSize="14"
                   Visibility="{Binding IsCameraSelected, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}"/>
        
        <!-- 相机详情 TabControl -->
        <TabControl x:Name="DetailTabControl" Grid.Row="1"
                    Style="{StaticResource DetailTabControlStyle}"
                    Visibility="{Binding IsCameraSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            
            <!-- Tab1：基本信息 -->
            <TabItem Header="基本信息" Style="{StaticResource DetailTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        
                        <!-- 基本信息 -->
                        <GroupBox Header="基本信息" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                                         Text="{Binding SelectedCamera.Name}"
                                         IsReadOnly="True"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="制造商:" 
                                           VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                                         Text="{Binding SelectedCamera.Manufacturer}"
                                         Margin="0,8,0,0"
                                         IsReadOnly="True"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="型号:" 
                                           VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" 
                                         Text="{Binding SelectedCamera.Model}"
                                         Margin="0,8,0,0"
                                         IsReadOnly="True"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="描述:" 
                                           VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" 
                                         Text="{Binding SelectedCamera.Description}"
                                         Margin="0,8,0,0" Height="60" TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"/>
                            </Grid>
                        </GroupBox>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Tab2：参数设置 -->
            <TabItem Header="参数设置" Style="{StaticResource DetailTabItemStyle}">
                <Grid Margin="12,8,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235" MinWidth="205"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="440"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧只做类别导航，不再把参数编辑控件塞进树节点 -->
                    <Border Grid.Column="0" Padding="8"
                            Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                            BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="属性分类" FontWeight="SemiBold" Margin="4,2,4,8"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                            <TextBox Grid.Row="1" MinHeight="30" Margin="2,0,2,8"
                                     Text="{Binding ParameterSearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     ToolTip="搜索参数中文名称、SDK 名称或类别；搜索结果显示在右侧"/>
                            <TreeView Grid.Row="2" ItemsSource="{Binding ParameterCategories}"
                                      SelectedItemChanged="OnParameterCategorySelected"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ItemContainerStyle="{StaticResource {x:Type TreeViewItem}}">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type local:CameraParameterGroupViewModel}"
                                                              ItemsSource="{Binding Children}"
                                                              ItemContainerStyle="{StaticResource {x:Type TreeViewItem}}">
                                        <TextBlock Text="{Binding Name}" Padding="4,6"
                                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="展开" Width="76" Height="28" Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExpandParameterTreeCommand}"/>
                                <Button Content="折叠" Width="76" Height="28"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CollapseParameterTreeCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="12"
                            Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                            BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectedCategoryTitle}" FontSize="15" FontWeight="SemiBold"
                                       Margin="2,0,0,8"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                            <TextBlock Grid.Row="1" Text="{Binding ParameterStatus}" FontSize="12" Margin="2,0,0,8"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CameraParameterItemViewModel}">
                                            <Grid Margin="2,3,8,4" ToolTip="{Binding ToolTipText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Unit}"
                                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                                <Grid Grid.Column="1">
                                                    <controls:NumericUpDown Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Minimum="{Binding MinimumValue}" Maximum="{Binding MaximumValue}"
                                                             SmallChange="{Binding IncrementValue}" LargeChange="{Binding LargeIncrementValue}"
                                                             DecimalPlaces="{Binding DecimalPlaces}"
                                                             ShowSlider="False" MinHeight="32"
                                                             Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Padding="6"
                                                             IsReadOnly="{Binding IsReadOnly}"
                                                             Visibility="{Binding IsTextValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <controls:ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            OnText="启用" OffText="关闭" ShowText="True"
                                                                            VerticalAlignment="Center" IsEnabled="{Binding IsEditable}"
                                                                            Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <ComboBox ItemsSource="{Binding EnumValues}" Style="{StaticResource ThemeComboBoxStyle}"
                                                              ItemContainerStyle="{StaticResource ThemeComboBoxItemStyle}"
                                                              SelectedValuePath="Value" SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding IsEditable}"
                                                              Visibility="{Binding IsEnumeration, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Content="执行" MinHeight="32" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.ExecuteParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsCommand, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="保存参数" Width="100" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveParamsCommand}"/>
                                <Button Content="恢复默认" Width="100" Height="32"
                                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetParamsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
        </TabControl>

        <Border Grid.Row="2" Margin="8,2,8,8" Padding="8,5"
                Visibility="{Binding IsCameraSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource {x:Static base:ThemeKeys.StatusBarBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                BorderThickness="1" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="连接状态：" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                <TextBlock Text="{Binding SelectedCamera.StatusText}" Margin="0,0,18,0"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                <TextBlock Text="IP：" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                <TextBlock Text="{Binding SelectedCamera.IpAddress}" Margin="0,0,18,0"/>
                <TextBlock Text="延迟：" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                <TextBlock Text="{Binding SelectedCamera.Latency, FallbackValue=0}"/>
                <TextBlock Text=" ms" Margin="0,0,18,0"/>
                <TextBlock Text="帧率：" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                <TextBlock Text="{Binding SelectedCamera.FrameRate, FallbackValue=0}"/>
                <TextBlock Text=" fps"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
