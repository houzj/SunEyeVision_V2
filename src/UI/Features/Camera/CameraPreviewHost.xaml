<UserControl x:Class="SunEyeVision.UI.Features.Camera.CameraPreviewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageViewport;assembly=SunEyeVision.Plugin.Wpf"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base">
    <Grid Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}">
        <display:ImageViewBox x:Name="ImageDisplay">
            <display:ImageViewBox.Resources>
                <ResourceDictionary><ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/OriginalTheme.xaml"/>
                    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/shape/shapeitemspagestyle.xaml"/>
                    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Display/ImageViewport/base/imageview/shape/crossshape/crossshapestyle.xaml"/>
                </ResourceDictionary.MergedDictionaries></ResourceDictionary>
            </display:ImageViewBox.Resources>
        </display:ImageViewBox>
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                Padding="8,4"
                IsHitTestVisible="False"
                Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                Opacity="0.9">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Text="准备预览"/>
        </Border>
    </Grid>
</UserControl>
