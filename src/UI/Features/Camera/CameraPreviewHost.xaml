<UserControl x:Class="SunEyeVision.UI.Features.Camera.CameraPreviewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base">
    <Grid Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}">
        <sdk:ImageControl x:Name="ImageDisplay"
                          ShowImageSourceSelector="False"
                          ShowToolBar="True"
                          ShowStatusBar="True"
                          EnablePanning="True"
                          EnableZoom="True"
                          AutoFitMode="FirstOnly"
                          ShowChessboardBackground="False"/>
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                Padding="8,4"
                Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                Opacity="0.9">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Text="准备预览"/>
        </Border>
    </Grid>
</UserControl>
