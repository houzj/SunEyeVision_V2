<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.Camera.CameraPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:camera="clr-namespace:SunEyeVision.UI.Features.Camera"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        Title="相机设置"
        Width="1480"
        Height="900"
        MinWidth="1080"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="{Binding SelectedCamera.Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCamera.StatusText}"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6"
                Background="{DynamicResource {x:Static base:ThemeKeys.ToolBarBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                BorderThickness="1" CornerRadius="3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="ToggleAcquisitionButton" Content="连续采集" Width="104" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OnToggleAcquisitionClick"/>
                    <Button x:Name="SingleCaptureButton" Content="单次采集" Width="96" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OnSingleCaptureClick"/>
                    <Button x:Name="TriggerButton" Content="触发一次" Width="96" Height="32"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OnTriggerOnceClick"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="ConfigurationSummaryText" HorizontalAlignment="Right"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                    <TextBlock x:Name="CaptureStatusText" HorizontalAlignment="Right" Margin="0,3,0,0"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="600"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="4*" MinWidth="420"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                    Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}" CornerRadius="4">
                <ContentControl x:Name="PreviewHostContainer"/>
            </Border>
            <Border Grid.Column="2" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                    Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}" CornerRadius="4">
                <camera:CameraParameterPanel DataContext="{Binding}"/>
            </Border>
        </Grid>
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,5"
                Background="{DynamicResource {x:Static base:ThemeKeys.StatusBarBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                BorderThickness="1" CornerRadius="3">
            <TextBlock Text="{Binding ParameterStatus}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.StatusBarTextBrush}}"/>
        </Border>
    </Grid>
</themeWindows:ThemeDialogWindow>
