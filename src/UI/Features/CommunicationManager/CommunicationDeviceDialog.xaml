<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        Title="设备管理" Width="640" Height="720" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}">
    <themeWindows:ThemeDialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </themeWindows:ThemeDialogWindow.Resources>
    <Grid Margin="18" TextElement.FontSize="14" TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="通信协议" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="协议类型"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" TextSearch.TextPath="DisplayName">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="设备名称"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Separator Grid.Row="2" Margin="0,12"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="通信参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Visibility="{Binding IsTcpClient, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="目标IP"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="目标端口"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Visibility="{Binding IsS7, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CPU型号"/><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding S7CpuTypeOptions}" SelectedItem="{Binding S7CpuType}"/>
                    <TextBlock Grid.Row="1" Text="通信方式"/><TextBlock Grid.Row="1" Grid.Column="1" Text="TcpClient" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="目标IP"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="目标端口"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="4" Text="机架号"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="5" Text="槽号"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Visibility="{Binding IsCip, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="通信方式"/><TextBlock Grid.Row="0" Grid.Column="1" Text="TcpClient" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="目标IP"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="目标端口"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="轮询间隔(ms)"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="4" Text="自动重连"/><controls:ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding AutoReconnect, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22" VerticalAlignment="Center"/>
                </Grid>
                <Grid Visibility="{Binding IsTcpServer, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="本机IP"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LocalHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="本机端口"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Visibility="{Binding IsUdp, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="本机IP"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LocalHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="本机端口"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="目标IP"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="目标端口"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Visibility="{Binding IsModbus, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="通信方式"/><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ModbusModeOptions}" SelectedItem="{Binding ModbusMode}"/>
                    <TextBlock Grid.Row="1" Text="目标IP" Visibility="{Binding IsModbusTcp, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsModbusTcp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="2" Text="目标端口" Visibility="{Binding IsModbusTcp, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsModbusTcp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="1" Text="串口号" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding SerialPort, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" ToolTip="选择当前主机检测到的串口" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="2" Text="波特率" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="3" Text="数据位" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="4" Text="校验位" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="5" Text="停止位" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" Visibility="{Binding IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="6" Text="站号"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="7" Text="轮询间隔(ms)"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="8" Text="自动重连"/><controls:ToggleSwitch Grid.Row="8" Grid.Column="1" IsChecked="{Binding AutoReconnect, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22" VerticalAlignment="Center"/>
                </Grid>
                <Grid Visibility="{Binding IsPlainSerial, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="串口号"/><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding SerialPort, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" ToolTip="选择当前主机检测到的串口"/>
                    <TextBlock Grid.Row="1" Text="波特率"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="数据位"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}"/>
                    <TextBlock Grid.Row="3" Text="校验位"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}"/>
                    <TextBlock Grid.Row="4" Text="停止位"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}"/>
                    <TextBlock Grid.Row="5" Text="字符超时(ms)"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CharacterTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Visibility="{Binding IsOpcUa, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="服务器地址"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="服务器端口"/><controls:NumericUpDown Grid.Row="1" Grid.Column="1" IntValue="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="65535" DecimalPlaces="0" Height="32"/>
                    <TextBlock Grid.Row="2" Text="请求超时(ms)"/><controls:NumericUpDown Grid.Row="2" Grid.Column="1" IntValue="{Binding RequestTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="250" Maximum="120000" DecimalPlaces="0" Height="32"/>
                    <TextBlock Grid.Row="3" Text="端点预览"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OpcUaEndpointPreview, Mode=OneWay}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="4" Text="自动重连"/><controls:ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding AutoReconnect, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22"/>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="匿名连接（None；仅适用于隔离测试网络）" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,4,0,0"/>
                </Grid>
                <Grid Visibility="{Binding IsHttp, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="请求地址"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="请求方式"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HttpMethodOptions}" SelectedItem="{Binding HttpMethod}"/>
                    <TextBlock Grid.Row="2" Text="请求超时(ms)"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RequestTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <StackPanel Visibility="{Binding IsRawProtocol, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="数据上传"/><controls:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableDataUpload, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="自动重连"/><controls:ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding AutoReconnect, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="接收结束符" Margin="0,10,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                            <controls:ToggleSwitch IsChecked="{Binding EnableReceiveTerminator, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22" VerticalAlignment="Center"/>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding EnableReceiveTerminator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox MinHeight="68" MaxHeight="130" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6" Text="{Binding ReceiveTerminator, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="\r" Tag="\r" Width="52" Height="28" Margin="0,0,8,0" Click="ReceiveTerminatorShortcut_Click"/>
                                    <Button Content="\n" Tag="\n" Width="52" Height="28" Margin="0,0,8,0" Click="ReceiveTerminatorShortcut_Click"/>
                                    <Button Content="\r\n" Tag="\r\n" Width="60" Height="28" Click="ReceiveTerminatorShortcut_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}" TextWrapping="Wrap" Margin="120,12,0,0"/>
                <TextBlock Text="当前阶段保存设备配置，真实协议连接将在通讯运行时接入。" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" TextWrapping="Wrap" Margin="120,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="84" Margin="0,0,10,0"/>
            <Button Content="创建" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="84"/>
        </StackPanel>
    </Grid>
</themeWindows:ThemeDialogWindow>
