<UserControl x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationHeartbeatsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:comm="clr-namespace:SunEyeVision.UI.Features.CommunicationManager" xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommunicationUiResources.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible"/><comm:OneBasedIndexConverter x:Key="Ordinal"/>
  <Style x:Key="HeartbeatTargetButtonStyle" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,3">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{TemplateBinding Foreground}" Width="8" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
<Style x:Key="HeartbeatTreeItemStyle" TargetType="TreeViewItem">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <Setter Property="IsExpanded" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ToggleButton x:Name="Expander" Width="28" Height="32" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 5 4 L 0 8 Z" Fill="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="HeaderBorder" Grid.Column="1" MinHeight="32" Padding="8,4" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Background="Transparent" Cursor="Hand"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border>
     <ItemsPresenter x:Name="ChildrenPresenter" Grid.Row="1" Grid.Column="1"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenPresenter" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/><Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type comm:HeartbeatTargetNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource HeartbeatTreeItemStyle}"><TextBlock Text="{Binding Name}" ToolTip="{Binding FullName}"/></HierarchicalDataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Margin="14,12">
  <DataGrid x:Name="HeartbeatGrid" ItemsSource="{Binding Heartbeats}" AlternationCount="1000000" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
   ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}" Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Ordinal}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="设备" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid ToolTip="{Binding Status}">
     <ToggleButton x:Name="TargetButton" Style="{StaticResource HeartbeatTargetButtonStyle}" Content="{Binding TargetLabel}" IsChecked="{Binding IsTargetOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
     <Popup PlacementTarget="{Binding ElementName=TargetButton}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" IsOpen="{Binding IsTargetOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StaysOpen="False" Opened="Targets_Opened">
      <Border Padding="6" MinWidth="240" Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="1">
       <TreeView ItemContainerStyle="{StaticResource HeartbeatTreeItemStyle}" ItemsSource="{Binding Targets}" PreviewMouseLeftButtonDown="Target_MouseDown" PreviewMouseRightButtonDown="Target_RightMouseDown" PreviewKeyDown="Target_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="280" Background="Transparent" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" BorderThickness="0"/>
      </Border>
     </Popup>
    </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="心跳类型" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{Binding Modes}" SelectedItem="{Binding ModeDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="发送内容" Width="330"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel VerticalAlignment="Center">
     <ComboBox DockPanel.Dock="Left" Width="90" Margin="0,0,6,0" Visibility="{Binding ShowTypeSelector, Converter={StaticResource Visible}}" Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Modbus 发送编码类型"/>
     <TextBlock DockPanel.Dock="Left" Width="90" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding TypeLocked, Converter={StaticResource Visible}}" Text="{Binding TypeLabel}" ToolTip="类型由OPC UA节点决定，不允许手动切换"/>
     <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="SecondContentColumn" Width="0"/></Grid.ColumnDefinitions>
      <TextBox Height="30" MinWidth="60" VerticalContentAlignment="Center" Style="{StaticResource CommunicationTableTextBoxStyle}" Text="{Binding ContentA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="发送内容1，按目标类型校验" AutomationProperties.Name="发送内容1"/>
      <TextBlock Grid.Column="1" Text="-" Margin="6,0" VerticalAlignment="Center" Visibility="{Binding IsAlternate, Converter={StaticResource Visible}}"/>
      <TextBox Grid.Column="2" Height="30" MinWidth="60" VerticalContentAlignment="Center" Visibility="{Binding IsAlternate, Converter={StaticResource Visible}}" Style="{StaticResource CommunicationTableTextBoxStyle}" Text="{Binding ContentB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="发送内容2，与内容1交替发送，不是范围" AutomationProperties.Name="发送内容2"/>
     </Grid>
    </DockPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding IsAlternate}" Value="True"><Setter TargetName="SecondContentColumn" Property="Width" Value="*"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="时间间隔(ms)" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:NumericUpDown Minimum="1" Maximum="2147483647" IntValue="{Binding IntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="启用/关闭" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:ToggleSwitch IsChecked="{Binding Enabled, Mode=OneWay}" CheckedChanged="Enabled_Changed" SwitchWidth="40" SwitchHeight="20" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="操作" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Click="Remove_Click" Width="24" Height="24" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="删除心跳配置" Style="{DynamicResource DangerButtonStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <ItemsControl ItemsSource="{Binding Heartbeats}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate>
   <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusIssue, Converter={StaticResource Visible}}" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}" ToolTip="{Binding StatusMessage}"/>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Button Content="＋" Command="{Binding AddHeartbeatCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,6"/>
 </StackPanel></ScrollViewer>
</UserControl>
