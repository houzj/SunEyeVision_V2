<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:workflow="clr-namespace:SunEyeVision.Workflow;assembly=SunEyeVision.Workflow"
        xmlns:comm="clr-namespace:SunEyeVision.UI.Features.CommunicationManager"
        mc:Ignorable="d"
        Title="通讯管理器"
        Width="1100"
        Height="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommunicationUiResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <comm:OneBasedIndexConverter x:Key="OneBasedIndexConverter"/>
        <comm:CommunicationListViewportConverter x:Key="CommunicationListViewportConverter"/>
        <Style x:Key="OpcUaDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableHeaderBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TableHeaderTextBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CenteredDataGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OpcUaDataGridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OpcUaDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpcUaDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource OpcUaDataGridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredDataGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReceiveEventOutputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CommunicationTableTextBoxStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CompareNumericRangeStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompareRule}" Value="范围内"><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="范围外"><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding DataType}" Value="string"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding DataType}" Value="Boolean"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompareStringValueStyle" TargetType="TextBox" BasedOn="{StaticResource ReceiveEventOutputTextBoxStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataType}" Value="string"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding DataType}" Value="Boolean"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="等于"><Setter Property="Visibility" Value="Visible"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="不等于"><Setter Property="Visibility" Value="Visible"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="上升沿"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="下降沿"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ByteCompareRangeStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompareRule}" Value="范围内"><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="范围外"><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="等于"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="不等于"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="上升沿"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="下降沿"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding DataType}" Value="string"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ByteCompareValueStyle" TargetType="TextBox" BasedOn="{StaticResource ReceiveEventOutputTextBoxStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Width" Value="145"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataType}" Value="string"><Setter Property="Visibility" Value="Visible"/><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="等于"><Setter Property="Visibility" Value="Visible"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding CompareRule}" Value="不等于"><Setter Property="Visibility" Value="Visible"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveMessageExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="DevicePageVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActivePage}" Value="Devices"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveEventPageVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActivePage}" Value="ReceiveEvents"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveEventDetailVisibilityStyle" TargetType="Grid" BasedOn="{StaticResource ReceiveEventPageVisibilityStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedReceiveEvent}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveEventEmptyVisibilityStyle" TargetType="Grid" BasedOn="{StaticResource ReceiveEventPageVisibilityStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNoSelectedReceiveEvent}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveEventParseDetailsStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReceiveEvent.IsProtocolCompare}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveEventCompareDetailsStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReceiveEvent.IsProtocolCompare}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavigationButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonDisabledBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActivePage}" Value="Devices">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiveEventNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActivePage}" Value="ReceiveEvents">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SendEventPageVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="SendEvents"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SendEventNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="SendEvents">
                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HeartbeatNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Heartbeats">
                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TriggerNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Triggers">
                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ResponseNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonBaseStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Responses">
                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CommunicationDeviceTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DeviceItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CommunicationDeviceTabTemplate" DataType="{x:Type workflow:Communication}">
            <Grid MinHeight="48">
                <Grid.ContextMenu>
                    <ContextMenu MinWidth="132">
                        <MenuItem Header="重命名" Click="RenameDevice_Click"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="DeleteDevice_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Top" Margin="0,1,2,0"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                    <TextBlock Text="{Binding ProtocolStatusText}" FontSize="11" Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                    <TextBlock Text="{Binding RuntimeConnectionError, StringFormat='失败原因：{0}'}"
                               ToolTip="{Binding RuntimeConnectionError}" TextWrapping="Wrap" MaxHeight="48"
                               FontSize="10" Margin="0,2,4,0"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRuntimeConnectionError}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RuntimeStatus}" Value="{x:Static workflow:CommunicationRuntimeStatus.Connecting}">
                                    <Setter Property="Fill" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RuntimeStatus}" Value="{x:Static workflow:CommunicationRuntimeStatus.Connected}">
                                    <Setter Property="Fill" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RuntimeStatus}" Value="{x:Static workflow:CommunicationRuntimeStatus.Faulted}">
                                    <Setter Property="Fill" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWaitingForReconnect}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <controls:ToggleSwitch Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       SwitchWidth="40" SwitchHeight="20"
                                       IsChecked="{Binding IsActuallyConnected, Mode=OneWay}"
                                       ToolTip="连接/断开。开启自动重连时，手动断开后也会按倒计时重新连接。"
                                       IsEnabled="{Binding CanToggleRuntime}"
                                       CheckedChanged="DeviceToggle_CheckedChanged"/>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource {x:Static base:ThemeKeys.TableHeaderBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}" BorderThickness="0,0,1,0">
            <StackPanel>
                <Button Content="设备管理" Style="{StaticResource DeviceNavigationButtonStyle}" Click="DevicePage_Click"/>
                <Button Content="接收事件" Style="{StaticResource ReceiveEventNavigationButtonStyle}" Click="ReceiveEventsPage_Click"/>
                <Button Content="发送事件" Style="{StaticResource SendEventNavigationButtonStyle}" Click="SendEventsPage_Click"/>
                <Button Content="触发配置" Style="{StaticResource TriggerNavigationButtonStyle}"
                        Click="TriggersPage_Click" BorderThickness="0"/>
                <Separator Margin="18,8"/>
                <Button Content="响应配置" Style="{StaticResource ResponseNavigationButtonStyle}"
                        Click="ResponsesPage_Click" BorderThickness="0"/>
                <Button Content="心跳管理" Style="{StaticResource HeartbeatNavigationButtonStyle}" Click="HeartbeatsPage_Click" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,1,0" Style="{StaticResource DevicePageVisibilityStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="14,10,14,0">
                <TextBlock Text="通讯设备列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="＋" DockPanel.Dock="Right" Width="30" Height="30" Command="{Binding AddCommunicationCommand}"/>
            </DockPanel>
            <ListBox Grid.Row="1" Margin="14,8,14,10" ItemsSource="{Binding Communications}"
                     SelectedItem="{Binding SelectedCommunication, Mode=TwoWay}"
                     AlternationCount="1000000" BorderThickness="0"
                     Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"
                     ItemContainerStyle="{StaticResource CommunicationDeviceTabItemStyle}"
                     ItemTemplate="{StaticResource CommunicationDeviceTabTemplate}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,14,0" Style="{StaticResource DevicePageVisibilityStyle}">
            <TextBlock Text="请选择一个通信设备查看参数" FontSize="16"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoSelectedCommunication, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Grid Visibility="{Binding HasSelectedCommunication, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="通讯参数" FontSize="17" FontWeight="SemiBold" Margin="14,10,0,0"/>
            <ScrollViewer Grid.Row="1" Margin="14,10,0,4" MaxHeight="310" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCommunication.ProtocolDisplayName}" FontSize="13" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,0,0,6"/>
                    <Grid Visibility="{Binding SelectedCommunication.IsTcpClient, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="目标IP"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.Host, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="目标端口" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.Port, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsS7, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="目标IP"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.Host, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="目标端口" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.Port, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="1" Text="机架号"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCommunication.Rack, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="槽号" Margin="18,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCommunication.Slot, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="2" Text="CPU型号"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding S7CpuTypeOptions}" SelectedItem="{Binding SelectedCommunication.S7CpuType}" Height="32"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsCip, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="目标IP"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.Host, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="目标端口" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.Port, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="1" Text="轮询间隔(ms)"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCommunication.PollInterval, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="自动重连" Margin="18,0,0,0"/><controls:ToggleSwitch Grid.Row="1" Grid.Column="3" IsChecked="{Binding SelectedCommunication.AutoReconnect, Mode=TwoWay}" SwitchWidth="40" SwitchHeight="20" Margin="18,0,0,0"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsTcpServer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="本机IP"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.LocalHost, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="本机端口" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.LocalPort, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsUdp, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="本机IP"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.LocalHost, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="1" Text="本机端口"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCommunication.LocalPort, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="目标IP" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.RemoteHost, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="目标端口" Margin="18,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCommunication.RemotePort, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                    </Grid>
                    <StackPanel Visibility="{Binding SelectedCommunication.IsModbus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="通信方式"/><ComboBox Grid.Column="1" ItemsSource="{Binding ModbusModeOptions}" SelectedItem="{Binding SelectedCommunication.ModbusMode, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            <TextBlock Grid.Column="2" Text="站号" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.UnitId, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        </Grid>
                        <Grid Visibility="{Binding SelectedCommunication.IsModbusTcp, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="目标IP"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.Host, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            <TextBlock Grid.Column="2" Text="目标端口" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.Port, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        </Grid>
                        <Grid Visibility="{Binding SelectedCommunication.IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="串口号"/><ComboBox Grid.Column="1" ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding SelectedCommunication.SerialPort, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" ToolTip="选择当前主机检测到的串口" Height="32"/>
                            <TextBlock Grid.Column="2" Text="波特率" Margin="18,0,0,0"/><ComboBox Grid.Column="3" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding SelectedCommunication.BaudRate, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        </Grid>
                        <Grid Visibility="{Binding SelectedCommunication.IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="数据位"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.DataBits, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            <TextBlock Grid.Column="2" Text="校验位" Margin="18,0,0,0"/><ComboBox Grid.Column="3" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedCommunication.Parity, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        </Grid>
                        <Grid Visibility="{Binding SelectedCommunication.IsModbusRtu, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="停止位"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.StopBits, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            <TextBlock Grid.Column="2" Text="超时(ms)" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.RequestTimeout, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="轮询间隔(ms)"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.PollInterval, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            <TextBlock Grid.Column="2" Text="自动重连" Margin="18,0,0,0"/><controls:ToggleSwitch Grid.Column="3" IsChecked="{Binding SelectedCommunication.AutoReconnect, Mode=TwoWay}" SwitchWidth="40" SwitchHeight="20" Margin="18,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <Grid Visibility="{Binding SelectedCommunication.IsPlainSerial, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="串口号"/><ComboBox Grid.Column="1" ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding SelectedCommunication.SerialPort, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" ToolTip="选择当前主机检测到的串口" Height="32"/>
                        <TextBlock Grid.Row="1" Text="波特率"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding SelectedCommunication.BaudRate, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="2" Text="数据位"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCommunication.DataBits, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="3" Text="校验位"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedCommunication.Parity, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="停止位" Margin="18,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedCommunication.StopBits, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="字符超时(ms)" Margin="18,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCommunication.CharacterTimeout, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsOpcUa, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="服务器地址"/><TextBox Grid.Column="1" Text="{Binding SelectedCommunication.OpcUaHost, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="服务器端口" Margin="18,0,0,0"/><controls:NumericUpDown Grid.Column="3" IntValue="{Binding SelectedCommunication.OpcUaPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" DecimalPlaces="0" Height="32" Margin="18,0,0,0" ToolTip="端口 1–65535；0 表示旧配置无效，需修正后保存"/>
                        <TextBlock Grid.Row="1" Text="请求超时(ms)"/><controls:NumericUpDown Grid.Row="1" Grid.Column="1" IntValue="{Binding SelectedCommunication.RequestTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="120000" DecimalPlaces="0" Height="32" ToolTip="有效范围 250–120000 ms"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="自动重连" Margin="18,0,0,0"/><controls:ToggleSwitch Grid.Row="1" Grid.Column="3" IsChecked="{Binding SelectedCommunication.AutoReconnect, Mode=TwoWay}" SwitchWidth="40" SwitchHeight="20" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="2" Text="端点预览"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedCommunication.EndpointUrl, Mode=OneWay}" IsReadOnly="True" Height="32"/>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="匿名连接（None；仅适用于隔离测试网络）" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,4,0,0"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsHttp, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="请求地址"/><TextBox Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedCommunication.Host, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="1" Text="请求方式"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCommunication.HttpMethod, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="请求超时(ms)" Margin="18,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCommunication.RequestTimeout, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="18,0,0,0"/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedCommunication.IsRawProtocol, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="数据上传"/><controls:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedCommunication.EnableDataUpload, Mode=TwoWay}" SwitchWidth="40" SwitchHeight="20"/>
                        <TextBlock Grid.Column="2" Text="自动重连" Margin="18,0,0,0"/><controls:ToggleSwitch Grid.Column="3" IsChecked="{Binding SelectedCommunication.AutoReconnect, Mode=TwoWay}" SwitchWidth="40" SwitchHeight="20" Margin="18,0,0,0"/>
                        <TextBlock Grid.Row="1" Text="接收结束符" VerticalAlignment="Center"/>
                        <controls:ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding SelectedCommunication.EnableReceiveTerminator, Mode=TwoWay}" SwitchWidth="40" SwitchHeight="20"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0" Visibility="{Binding SelectedCommunication.EnableReceiveTerminator, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox MinHeight="76" MaxHeight="140" HorizontalAlignment="Stretch" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,7" Text="{Binding SelectedCommunication.ReceiveTerminator, UpdateSourceTrigger=PropertyChanged}"/>
                            <UniformGrid Columns="3" HorizontalAlignment="Left" Width="224" Margin="0,8,0,0">
                                <Button Content="\r" Tag="\r" Height="30" Margin="0,0,6,0" Click="ReceiveTerminatorShortcut_Click"/>
                                <Button Content="\n" Tag="\n" Height="30" Margin="0,0,6,0" Click="ReceiveTerminatorShortcut_Click"/>
                                <Button Content="\r\n" Tag="\r\n" Height="30" Click="ReceiveTerminatorShortcut_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <TabControl Grid.Row="2" Margin="14,4,0,10"
                        Visibility="{Binding SelectedCommunication.IsRawProtocol, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TabPanel Grid.Row="0" Grid.Column="0" IsItemsHost="True" Background="Transparent"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel x:Name="ReceiveActions" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                            Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                            BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="文本"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedWorkspace.IsReceiveHexDisplay}" Value="True">
                                                            <Setter Property="Text" Value="HEX"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <controls:ToggleSwitch IsChecked="{Binding SelectedWorkspace.IsReceiveHexDisplay, Mode=TwoWay}"
                                                           SwitchWidth="42" SwitchHeight="20" Margin="0,0,8,0"/>
                                    <Button Content="清空" Command="{Binding ClearReceivedDataCommand}"
                                            Width="52" Height="24" Padding="4,0"/>
                                </StackPanel>
                                <StackPanel x:Name="SendActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Border BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                            Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                            BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="文本"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedWorkspace.IsSendHexInput}" Value="True">
                                                            <Setter Property="Text" Value="HEX"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <controls:ToggleSwitch IsChecked="{Binding SelectedWorkspace.IsSendHexInput, Mode=TwoWay}"
                                                           SwitchWidth="42" SwitchHeight="20" Margin="0,0,8,0"/>
                                    <Button Content="清空" Command="{Binding ClearSentDataCommand}"
                                            Width="52" Height="24" Padding="4,0"/>
                                </StackPanel>
                            </Grid>
                            <ContentPresenter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                              ContentSource="SelectedContent" Margin="0,6,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="1">
                                <Setter TargetName="ReceiveActions" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SendActions" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="接收数据">
                    <Grid Margin="8">
                        <Border BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                BorderThickness="1" CornerRadius="3">
                            <TextBox Text="{Binding SelectedWorkspace.ReceivedText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                     VerticalScrollBarVisibility="Auto" TextChanged="TrafficLog_TextChanged"/>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="发送数据">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                            <TextBox Text="{Binding SelectedWorkspace.SentText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                     VerticalScrollBarVisibility="Auto" TextChanged="TrafficLog_TextChanged"/>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,6"
                                MaxHeight="112">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" MinHeight="40">
                                    <TextBox Text="{Binding SelectedWorkspace.SendText, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="40" MaxHeight="96" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Center" Padding="7,4"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                             ToolTip="Enter 发送，Shift+Enter 换行"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="SendTextBox_PreviewKeyDown"/>
                                    <TextBlock Text="输入消息…  Enter 发送，Shift+Enter 换行"
                                               Margin="8,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedWorkspace.SendText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1" Content="发送" Command="{Binding SendDataCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="32" Padding="10,4" FontSize="13"
                                        VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border Grid.Row="2" Margin="14,8,0,10" Padding="12"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                    Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                    BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding SelectedCommunication.IsModbus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="寄存器地址" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="首地址" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <controls:NumericUpDown Grid.Column="1" Height="30" Minimum="0" Maximum="65535"
                                                DecimalPlaces="0" ShowSlider="False"
                                                IntValue="{Binding SelectedWorkspace.ModbusRegisterStartAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="寄存器个数" VerticalAlignment="Center" Margin="20,0,8,0"/>
                        <controls:NumericUpDown Grid.Column="3" Height="30" Minimum="1"
                                                Maximum="{Binding SelectedWorkspace.MaxModbusRegisterCount}"
                                                DecimalPlaces="0" ShowSlider="False"
                                                IntValue="{Binding SelectedWorkspace.ModbusRegisterCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedWorkspace.AddressRangeWarning}" TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"/>
