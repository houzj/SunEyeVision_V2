                                    <DataGridTemplateColumn Header="名称" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource ReceiveEventOutputTextBoxStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="类型" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Height="30" ItemsSource="{Binding DataContext.SelectedReceiveDataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding DataType, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="内容" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:ParamBinding Height="30" ParameterName="Content" NodeId="AssemblyOutput" NodeName="组装列表" IsBound="{Binding IsContentBound, Mode=TwoWay}" BindingSource="{Binding BindingSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BindingDisplayText="{Binding BindingDisplayText, Mode=TwoWay}" AvailableDataSources="{Binding AvailableDataSources}" SyncEditingToSource="True" BindingSourceSelected="AssemblyBindingSourceSelected" LostKeyboardFocus="AssemblyBinding_LostKeyboardFocus"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn ElementStyle="{StaticResource CommunicationTableTextStyle}" Header="数据结果" Binding="{Binding Result}" Width="140" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Click="RemoveAssemblyOutput_Click" Style="{StaticResource DangerButtonStyle}" Padding="0" Width="24" Height="24"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="＋" Width="28" Height="28" Padding="0" HorizontalAlignment="Left" Margin="8,4,0,0" Command="{Binding AddAssemblyOutputCommand}"/>
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Expander Grid.Row="1" Style="{StaticResource ReceiveMessageExpanderStyle}"
                      Header="{Binding SelectedReceiveEvent.MessagePanelHeader}"
                      IsExpanded="{Binding SelectedReceiveEvent.IsMessageExpanded, Mode=TwoWay}" Margin="0,4,0,0">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Right" FontSize="14"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <Border Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"
                        BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}" BorderThickness="0,1,0,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="解析结果" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox Content="16进制显示" IsChecked="{Binding SelectedReceiveEvent.ShowMessageAsHex}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="清空" Click="ClearReceiveEventMessage_Click" Padding="10,2"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox Grid.Row="1" Text="{Binding SelectedReceiveEvent.ParseHistoryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8"
                                 TextChanged="ParseHistory_TextChanged" Loaded="ParseHistory_Loaded" IsVisibleChanged="ParseHistory_IsVisibleChanged"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                 Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                 BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
                    </Grid>
                </Border>
            </Expander>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SendEventPageVisibilityStyle}">
            <comm:CommunicationSendEventsView/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Heartbeats"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <comm:CommunicationHeartbeatsView/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Triggers"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <comm:CommunicationTriggersView/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Responses"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <comm:CommunicationResponsesView/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,14,0" Style="{StaticResource ReceiveEventEmptyVisibilityStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="暂无接收事件" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                <TextBlock Text="点击左侧上方“＋”创建接收事件" Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
            </StackPanel>
        </Grid>

    </Grid>
</themeWindows:ThemeDialogWindow>
