                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"
                              BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                              BorderThickness="1" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                              ColumnHeaderStyle="{StaticResource OpcUaDataGridHeaderStyle}"
                              RowStyle="{StaticResource OpcUaDataGridRowStyle}"
                              CellStyle="{StaticResource OpcUaDataGridCellStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              MouseDoubleClick="OpcUaDataGrid_MouseDoubleClick"
                              ToolTip="双击数据点行可编辑命名空间索引和标签名称">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" MinWidth="120"/>
                            <DataGridTemplateColumn Header="值" Width="200" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsValueReadOnly}"
                                                 VerticalContentAlignment="Center" Padding="6,2" Height="28"
                                                 Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                                 BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                                 KeyDown="OpcUaValueEditor_KeyDown"
                                                 LostKeyboardFocus="OpcUaValueEditor_LostKeyboardFocus"
                                                 ToolTip="可写数据点：输入后按 Enter 或离开输入框写入；Esc 取消"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="90"/>
                            <DataGridTextColumn Header="权限" Binding="{Binding AccessText}" Width="70"/>
                            <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="42" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Click="RemoveOpcUaPoint_Click" Height="26" Width="26" Padding="0"
                                                Style="{StaticResource DangerButtonStyle}"
                                                ToolTip="从本软件移除数据点（不删除服务器标签）" IsEnabled="{Binding IsNotWriting}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="尚未添加数据点，点击“+ 添加数据点”。" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="{Binding SelectedWorkspace.HasNoOpcUaPoints, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="4" Text="{Binding SelectedWorkspace.SelectedOpcUaPoint.ErrorText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Margin="14,8,0,10" Padding="12"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                    Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                    BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding SelectedCommunication.IsCip, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="EtherNet/IP CIP 显式消息" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="72"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <TextBlock Text="服务码" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedWorkspace.CipService, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                        <TextBlock Grid.Column="2" Text="Class" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Grid.Column="3" Text="{Binding SelectedWorkspace.CipClassId, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                        <TextBlock Grid.Column="4" Text="Instance" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Grid.Column="5" Text="{Binding SelectedWorkspace.CipInstanceId, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                        <TextBlock Grid.Column="6" Text="Attribute" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Grid.Column="7" Text="{Binding SelectedWorkspace.CipAttributeId, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="请求数据 HEX（可空）" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedWorkspace.CipRequestDataHex, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                        <Button Grid.Column="2" Content="执行" Command="{Binding ExecuteCipCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="12,3" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBox Grid.Row="3" Text="{Binding SelectedWorkspace.CipResultText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,1,0" Style="{StaticResource ReceiveEventPageVisibilityStyle}">
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="14,10,14,0">
                <TextBlock Text="接收事件列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="＋" DockPanel.Dock="Right" Width="30" Height="30" Click="AddReceiveEvent_Click"/>
            </DockPanel>
            <ListBox Grid.Row="1" Margin="14,8,14,10" ItemsSource="{Binding ReceiveEvents}"
                     SelectedItem="{Binding SelectedReceiveEvent, Mode=TwoWay}" BorderThickness="0"
                     Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Padding="10,9" FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,14,0" Style="{StaticResource ReceiveEventPageVisibilityStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,18,18,24">
                    <TextBlock Text="绑定设备" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="绑定设备" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <ComboBox Grid.Column="1" Height="36" ItemsSource="{Binding Communications}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedReceiveEvent.SelectedDeviceId, Mode=TwoWay}"/>
                    </Grid>
                    <Separator Margin="0,0,0,16"/>
                    <TextBlock Text="基本配置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="分隔符" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedReceiveEvent.Separator, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        <TextBlock Grid.Column="2" Text="字符长度比较" FontSize="15" VerticalAlignment="Center" Margin="24,0,0,0"/>
                        <controls:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,16,0" IsChecked="{Binding SelectedReceiveEvent.CharacterLengthCompare}" SwitchWidth="40" SwitchHeight="20"/>
                    </Grid>
                    <Separator Margin="0,0,0,16"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="输出列表" FontSize="17" FontWeight="SemiBold"/>
                        <Button Content="＋" DockPanel.Dock="Right" Width="28" Height="28" Padding="0"/>
                    </DockPanel>
                    <Grid MinHeight="160" Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}">
                        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Background="{DynamicResource {x:Static base:ThemeKeys.TableHeaderBackgroundBrush}}" TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TableHeaderTextBrush}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="序号" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="名称" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="设备" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="数据结果" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="状态 ⓘ" VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedReceiveEvent.Outputs}" BorderThickness="0"
                                 Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
            <TextBlock Text="*未保存" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="80" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click" Style="{StaticResource SecondaryButtonStyle}" Width="80"/>
        </StackPanel>
    </Grid>
</themeWindows:ThemeDialogWindow>
