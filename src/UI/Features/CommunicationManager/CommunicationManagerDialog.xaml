                                                                            Background="Transparent" MouseLeftButtonUp="RemoveModbusAddressBar_Click">
                                                                        <TextBlock Text="×" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding IsLast}" Value="True"/>
                                                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="10" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Tag="{Binding}" MouseLeftButtonUp="ModbusAddressCell_Click"
                                                                ToolTip="点击查看接收记录或配置地址">
                                                            <Grid>
                                                                <TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsConfigured}" Value="False"/>
                                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="＋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsConfigured}" Value="False"/>
                                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
                                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInRange}" Value="False">
                                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Row="5" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="数据同步" Click="SyncModbusData_Click" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,3" Margin="4,0,0,0"/>
                            <Button Content="发送测试" Click="SendModbusTest_Click" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,3" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="创建总数：" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedWorkspace.ModbusAddressPoints.Count}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Margin="14,8,0,10" Padding="12"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                    Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                    BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding SelectedCommunication.IsS7, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="S7 PLC 字节读写" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="150"/><ColumnDefinition Width="60"/><ColumnDefinition Width="70"/><ColumnDefinition Width="65"/><ColumnDefinition Width="70"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding SelectedWorkspace.S7Areas}" SelectedItem="{Binding SelectedWorkspace.S7Area}" Height="32"/>
                        <TextBlock Grid.Column="2" Text="DB" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBox Grid.Column="3" Text="{Binding SelectedWorkspace.S7DataBlock, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="4" Text="起始字节" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBox Grid.Column="5" Text="{Binding SelectedWorkspace.S7StartByte, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Grid.Column="6" Text="读取数" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBox Grid.Column="7" Text="{Binding SelectedWorkspace.S7ByteCount, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,8,0"/>
                        <Button Grid.Column="8" Content="执行" Command="{Binding ExecuteS7OperationCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="12,4"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="写入 HEX（留空为读取）" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="230" Height="30" Text="{Binding SelectedWorkspace.S7WriteHex, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
