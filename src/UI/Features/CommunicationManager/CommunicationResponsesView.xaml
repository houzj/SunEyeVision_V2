<UserControl x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationResponsesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:comm="clr-namespace:SunEyeVision.UI.Features.CommunicationManager" xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK">
<UserControl.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommunicationUiResources.xaml"/></ResourceDictionary.MergedDictionaries>
<BooleanToVisibilityConverter x:Key="Visible"/>
<HierarchicalDataTemplate DataType="{x:Type comm:HeartbeatTargetNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></HierarchicalDataTemplate>
<Style x:Key="ResponseTargetButton" TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Padding="8,6" CornerRadius="3" BorderThickness="1" Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="▾" Margin="12,0,0,0"/><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="FormLabel" TargetType="TextBlock"><Setter Property="Width" Value="160"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/></Style>
</ResourceDictionary></UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Responses}" Margin="24,16"><ItemsControl.ItemTemplate><DataTemplate>
<StackPanel Margin="0,0,0,24">
<DockPanel Margin="0,0,0,16"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/><controls:ToggleSwitch IsChecked="{Binding Definition.Enabled, Mode=OneWay}" CheckedChanged="Enabled_Changed" SwitchWidth="40" SwitchHeight="20" HorizontalAlignment="Left" Margin="20,0,0,0"/></DockPanel>
<StackPanel x:Name="ResponseConfigurationPanel" Visibility="{Binding Definition.Enabled, Converter={StaticResource Visible}}">
<DockPanel Margin="0,0,0,10"><TextBlock Text="通信设备" Style="{StaticResource FormLabel}"/><Grid>
<ToggleButton x:Name="TargetButton" Content="{Binding TargetLabel}" IsChecked="{Binding IsTargetOpen, Mode=TwoWay}" Style="{StaticResource ResponseTargetButton}" Height="34"/>
<Popup PlacementTarget="{Binding ElementName=TargetButton}" IsOpen="{Binding IsTargetOpen, Mode=TwoWay}" StaysOpen="False" Opened="Targets_Opened"><Border MinWidth="320" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"><TreeView ItemsSource="{Binding Targets}" SelectedItemChanged="Target_Selected" MaxHeight="280" Background="Transparent" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" BorderThickness="0"/></Border></Popup>
</Grid></DockPanel>
<DockPanel Margin="0,0,0,10" Visibility="{Binding ShowType, Converter={StaticResource Visible}}"><TextBlock Text="数据类型" Style="{StaticResource FormLabel}"/><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding Definition.DataType, Mode=TwoWay}" HorizontalAlignment="Left" Width="180"/></DockPanel>
<DockPanel Margin="0,0,0,10" Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}"><TextBlock Text="通信超时时间(s)" Style="{StaticResource FormLabel}"/><controls:NumericUpDown Minimum="0" Maximum="86400" Value="{Binding Definition.DelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30"/></DockPanel>
<DockPanel Margin="0,0,0,10" Visibility="{Binding ShowSeparator, Converter={StaticResource Visible}}"><TextBlock Text="分隔符" Style="{StaticResource FormLabel}"/><ComboBox Style="{StaticResource CommunicationSeparatorStyle}" ItemsSource="{Binding Separators}" SelectedValue="{Binding Definition.Separator, Mode=TwoWay}" HorizontalAlignment="Left" Width="180"/></DockPanel>
<DockPanel Margin="0,0,0,10" Visibility="{Binding ShowTerminator, Converter={StaticResource Visible}}"><TextBlock Text="结束符" Style="{StaticResource FormLabel}"/><ComboBox Style="{StaticResource CommunicationSeparatorStyle}" ItemsSource="{Binding Separators}" SelectedValue="{Binding Definition.Terminator, Mode=TwoWay}" HorizontalAlignment="Left" Width="180"/></DockPanel>
<DockPanel Margin="0,0,0,10"><TextBlock Text="{Binding FirstLabel}" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource CommunicationTableTextBoxStyle}" Text="{Binding Definition.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
<DockPanel Margin="0,0,0,10" Visibility="{Binding IsState, Converter={StaticResource Visible}}"><TextBlock Text="{Binding SecondLabel}" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource CommunicationTableTextBoxStyle}" Text="{Binding Definition.AlternateContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
<TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,4,0,12"/>
</StackPanel>
<Separator/>
</StackPanel>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</UserControl>
