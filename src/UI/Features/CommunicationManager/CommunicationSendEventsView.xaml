<UserControl x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationSendEventsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
 xmlns:comm="clr-namespace:SunEyeVision.UI.Features.CommunicationManager"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommunicationUiResources.xaml"/></ResourceDictionary.MergedDictionaries>
  <comm:OneBasedIndexConverter x:Key="SendIndex"/>
  <BooleanToVisibilityConverter x:Key="SendBoolVisibility"/>
  <Style x:Key="SendTabStyle" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0,0,0,3"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonHoverBackgroundBrush}}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ContextMenu x:Key="SendEventContextMenu" x:Shared="False">
   <MenuItem Header="重命名" Click="RenameSendEvent_Click"/>
   <MenuItem Header="删除" Click="DeleteSendEvent_Click"/>
  </ContextMenu>
  <Style x:Key="SendLiteralStyle" TargetType="TextBox" BasedOn="{StaticResource CommunicationTableTextBoxStyle}">
   <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,3"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsContentBound}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="SendBindingStyle" TargetType="controls:ParamBinding">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsContentBound}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Margin="14,10,14,10">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Right" Content="＋" Width="30" Height="30" Click="AddSendEvent_Click"/><TextBlock Text="发送事件列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ListBox Grid.Row="1" Margin="0,8,0,0" AlternationCount="1000000" ItemsSource="{Binding SendEvents}" SelectedItem="{Binding SelectedSendEvent, Mode=TwoWay}" BorderThickness="0">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8,10"><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" FontSize="15" Margin="0,0,10,0"/><TextBlock Text="{Binding DisplayName}" FontSize="15"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <EventSetter Event="PreviewMouseRightButtonDown" Handler="SendItem_RightClick"/>
     <Setter Property="ContextMenu" Value="{StaticResource SendEventContextMenu}"/>
    </Style></ListBox.ItemContainerStyle>
   </ListBox>
  </Grid>
  <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasSelectedSendEvent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <TextBlock Text="内容为空" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="点击左侧“＋”创建发送事件" Margin="0,10,0,0" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
  </StackPanel>
  <Grid Grid.Column="1" Margin="14,10,14,12" Visibility="{Binding HasSelectedSendEvent, Converter={StaticResource SendBoolVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding SelectedSendEvent.IsAssembly, Converter={StaticResource SendBoolVisibility}}">
    <Button x:Name="SendInputTab" Content="输入配置" Click="InputConfig_Click" Margin="0,0,8,0">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SendTabStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSendEvent.IsAssemblyConfigTab}" Value="False"><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <Button x:Name="SendAssemblyTab" Content="组装配置" Click="AssemblyConfig_Click">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SendTabStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSendEvent.IsAssemblyConfigTab}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel IsEnabled="{Binding SelectedSendEvent.IsNotBusy}">
      <StackPanel x:Name="InputConfigurationPanel" Visibility="{Binding SelectedSendEvent.IsInputConfigTab, Converter={StaticResource SendBoolVisibility}}">
       <TextBlock Text="绑定设备" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,14"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="绑定设备" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <ComboBox Grid.Column="1" Height="34" ItemsSource="{Binding Communications}" SelectedValuePath="Id" SelectedValue="{Binding SelectedSendEvent.DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="1" Text="{Binding SendTargetLabel}" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="{Binding HasSendTarget, Converter={StaticResource SendBoolVisibility}}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Height="34" Margin="0,4" ItemsSource="{Binding SendEventTargets}" SelectedValuePath="Id" SelectedValue="{Binding SelectedSendEvent.TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DropDownOpened="Targets_DropDownOpened" Visibility="{Binding HasSendTarget, Converter={StaticResource SendBoolVisibility}}">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
       </Grid>
       <TextBlock Text="{Binding SendCapabilityText}" TextWrapping="Wrap" Margin="14,8,0,12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
       <StackPanel Visibility="{Binding SelectedSendEvent.IsDirect, Converter={StaticResource SendBoolVisibility}}">
        <Separator/><TextBlock Text="基本配置" FontSize="17" FontWeight="SemiBold" Margin="0,14"/>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="分隔符" VerticalAlignment="Center" Margin="14,0,0,0"/><ComboBox x:Name="DirectSendSeparator" Grid.Column="1" ItemsSource="{Binding SelectedSendEvent.SeparatorOptions}" Style="{StaticResource CommunicationSeparatorStyle}" SelectedValue="{Binding SelectedSendEvent.Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34"/></Grid>
       </StackPanel>
       <Grid Margin="0,0,0,14" Visibility="{Binding IsSendRaw, Converter={StaticResource SendBoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="结束符" VerticalAlignment="Center" Margin="14,0,0,0"/><ComboBox Grid.Column="1" Height="32" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSendEvent.Terminator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="无" Tag=""/><ComboBoxItem Content="\r" Tag="&#xD;"/><ComboBoxItem Content="\n" Tag="&#xA;"/><ComboBoxItem Content="\r\n" Tag="&#xD;&#xA;"/></ComboBox></Grid>
       <Separator/>
       <DockPanel x:Name="SendParametersHeader" Margin="0,14,0,10">
        <Button x:Name="SendTestButton" DockPanel.Dock="Right" Content="发送测试" Command="{Binding TestSendEventCommand}" MinWidth="90" ToolTip="实际写入绑定设备"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSendEvent.Status}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,12,0" ToolTip="{Binding SelectedSendEvent.Status}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        <TextBlock Text="参数列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="在参数列表填写测试值；“发送测试”会实际写入绑定设备。" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
      <DataGrid x:Name="SendParametersGrid" ItemsSource="{Binding SelectedSendEvent.Parameters}" AlternationCount="1000000" CanUserSortColumns="False" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="240"
        ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}"
        Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}">
       <DataGrid.Columns>
<DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource SendIndex}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="名称" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommunicationTableTextBoxStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="类型" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{x:Static comm:CommunicationSendEventViewModel.DataTypes}" SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="测试值" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommunicationTableTextBoxStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="数据结果" ElementStyle="{StaticResource CommunicationTableTextStyle}" Binding="{Binding Result}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="状态" ElementStyle="{StaticResource CommunicationTableTextStyle}" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
        <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Click="RemoveParameter_Click" Style="{DynamicResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
       <Button Content="＋" Command="{Binding AddSendParameterCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,4,0,10"/>
      </StackPanel>
      <StackPanel x:Name="AssemblyConfigurationPanel" Visibility="{Binding SelectedSendEvent.ShowAssemblyConfig, Converter={StaticResource SendBoolVisibility}}">
       <TextBlock Text="分隔符设置" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,14"/>
       <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="分隔符" VerticalAlignment="Center" Margin="14,0,0,0"/><ComboBox x:Name="AssemblySendSeparator" Grid.Column="1" ItemsSource="{Binding SelectedSendEvent.SeparatorOptions}" Style="{StaticResource CommunicationSeparatorStyle}" SelectedValue="{Binding SelectedSendEvent.Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34"/></Grid>
       <Separator/>
       <DockPanel x:Name="SendAssemblyHeader" Margin="0,14,0,10">
        <Button x:Name="AssemblySendTestButton" DockPanel.Dock="Right" Content="发送测试" Command="{Binding TestSendEventCommand}" MinWidth="90" ToolTip="按组装规则实际写入绑定设备"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSendEvent.Status}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,12,0" ToolTip="{Binding SelectedSendEvent.Status}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        <TextBlock Text="组装列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <DataGrid ItemsSource="{Binding SelectedSendEvent.AssemblyOutputs}" AlternationCount="1000000" CanUserSortColumns="False" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="240"
        ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}"
        Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}">
        <DataGrid.Columns>
<DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource SendIndex}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="类型" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{x:Static comm:CommunicationSendEventViewModel.DataTypes}" SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="内容" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel>
          <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsContentBound, Mode=TwoWay}" Content="引用" VerticalAlignment="Center" Margin="6,0" ToolTip="选中后从参数列表引用输入；取消后填写固定内容"/>
          <Grid><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SendLiteralStyle}"/>
          <controls:ParamBinding Style="{StaticResource SendBindingStyle}" Height="30" ParameterName="Content" NodeId="SendAssembly" NodeName="组装列表"
            IsBound="{Binding IsContentBound, Mode=TwoWay}" BindingSource="{Binding BindingSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            BindingDisplayText="{Binding BindingDisplayText, Mode=TwoWay}" AvailableDataSources="{Binding AvailableDataSources}" SyncEditingToSource="True"
            BindingSourceSelected="AssemblyBinding_Selected" LostKeyboardFocus="AssemblyBinding_LostFocus"/>
         </Grid></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="数据结果" ElementStyle="{StaticResource CommunicationTableTextStyle}" Binding="{Binding Result}" Width="110" IsReadOnly="True"/>
         <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Click="RemoveAssembly_Click" Style="{DynamicResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <Button Content="＋" Command="{Binding AddSendAssemblyCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,4,0,10"/>
      </StackPanel>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Expander Grid.Row="2" Header="{Binding SelectedSendEvent.MessagePanelHeader}" IsExpanded="{Binding SelectedSendEvent.IsMessageExpanded, Mode=TwoWay}" Margin="0,8">
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,6"><TextBlock Text="发送结果" FontWeight="SemiBold" Margin="0,0,12,0"/><CheckBox Content="内容16进制" IsChecked="{Binding SelectedSendEvent.ShowHistoryAsHex}" ToolTip="数据内容，不包含协议帧头" Margin="0,0,12,0"/><Button Content="清空" Command="{Binding ClearSendEventHistoryCommand}"/></StackPanel>
     <TextBox Text="{Binding SelectedSendEvent.HistoryText, Mode=OneWay}" Height="130" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" VerticalScrollBarVisibility="Auto" TextChanged="History_TextChanged" IsVisibleChanged="History_IsVisibleChanged"/>
    </StackPanel>
   </Expander>
  </Grid>
 </Grid>
</UserControl>
