<UserControl x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationTriggersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:comm="clr-namespace:SunEyeVision.UI.Features.CommunicationManager" xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK">
<UserControl.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommunicationUiResources.xaml"/></ResourceDictionary.MergedDictionaries>
<comm:OneBasedIndexConverter x:Key="Ordinal"/>
<DataTemplate x:Key="NameTemplate"><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
<Style x:Key="CommandItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}"><Setter Property="IsEnabled" Value="{Binding IsSupported}"/><Style.Triggers><DataTrigger Binding="{Binding IsSupported}" Value="False"><Setter Property="ToolTip" Value="模块动作需要工具提供明确的动作接口，当前尚未提供。"/></DataTrigger></Style.Triggers></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><Border Grid.Row="1" Background="{TemplateBinding Background}" Padding="0,14,0,0"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="HeaderBorder" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Background="{DynamicResource {x:Static base:ThemeKeys.ControlBackgroundBrush}}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><TabControl Margin="14"><TabItem Header="事件触发"><StackPanel><DataGrid x:Name="EventTriggerGrid" ItemsSource="{Binding EventTriggers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" AlternationCount="1000000" HeadersVisibility="Column" ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}" Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"><DataGrid.Columns>
<DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Ordinal}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发事件" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Events}" SelectedValuePath="Id" SelectedValue="{Binding Definition.EventId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

<DataGridTemplateColumn Header="触发命令类型" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Commands}" SelectedValuePath="Id" SelectedValue="{Binding Definition.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemContainerStyle="{StaticResource CommandItemStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发配置" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Fields}" SelectedValuePath="Id" SelectedValue="{Binding Definition.FieldId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Width="140" Margin="8,0,0,0" ToolTip="触发字符：选择事件组装输出字段。工作流输入和运行参数映射暂不实现。"/><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Targets}" SelectedValuePath="Id" SelectedValue="{Binding Definition.TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="操作" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Width="24" Height="24" Click="Remove_Click" Style="{DynamicResource DangerButtonStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid><Button Content="＋" Command="{Binding AddEventTriggerCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,8"/></StackPanel></TabItem><TabItem Header="字符串触发"><StackPanel><DataGrid x:Name="StringTriggerGrid" ItemsSource="{Binding StringTriggers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" AlternationCount="1000000" HeadersVisibility="Column" ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}" Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"><DataGrid.Columns>
<DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Ordinal}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发字符" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CommunicationTableTextBoxStyle}" Text="{Binding Definition.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="匹配模式" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{Binding MatchModes}" SelectedItem="{Binding Definition.MatchMode, Mode=TwoWay}" ToolTip="完全匹配：整条相同；部分匹配：包含；不匹配：不检查内容，任何有效文本均可触发。"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发命令类型" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Commands}" SelectedValuePath="Id" SelectedValue="{Binding Definition.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemContainerStyle="{StaticResource CommandItemStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发配置" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Targets}" SelectedValuePath="Id" SelectedValue="{Binding Definition.TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="操作" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Width="24" Height="24" Click="Remove_Click" Style="{DynamicResource DangerButtonStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid><Button Content="＋" Command="{Binding AddStringTriggerCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,8"/></StackPanel></TabItem></TabControl></ScrollViewer>
</UserControl>
