<UserControl x:Class="SunEyeVision.UI.Features.CommunicationManager.CommunicationTriggersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:comm="clr-namespace:SunEyeVision.UI.Features.CommunicationManager" xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK">
<UserControl.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CommunicationUiResources.xaml"/></ResourceDictionary.MergedDictionaries>
<comm:OneBasedIndexConverter x:Key="Ordinal"/>
<DataTemplate x:Key="NameTemplate"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
<Style x:Key="CommandItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}"><Setter Property="IsEnabled" Value="{Binding IsSupported}"/><Style.Triggers><DataTrigger Binding="{Binding IsSupported}" Value="False"><Setter Property="ToolTip" Value="模块动作需要工具提供明确的动作接口，当前尚未提供。"/></DataTrigger></Style.Triggers></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><Border Grid.Row="1" Background="{TemplateBinding Background}" Padding="0,14,0,0"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="HeaderBorder" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Background="{DynamicResource {x:Static base:ThemeKeys.ControlBackgroundBrush}}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><TabControl Margin="14"><TabItem Header="事件触发"><StackPanel><DataGrid x:Name="EventTriggerGrid" ItemsSource="{Binding EventTriggers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" AlternationCount="1000000" HeadersVisibility="Column" ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}" Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"><DataGrid.Columns>
<DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Ordinal}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发事件" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Events}" SelectedValuePath="Id" SelectedValue="{Binding Definition.EventId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

<DataGridTemplateColumn Header="触发命令类型" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Commands}" SelectedValuePath="Id" SelectedValue="{Binding Definition.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemContainerStyle="{StaticResource CommandItemStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="执行目标" Width="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Targets}" SelectedValuePath="Id" SelectedValue="{Binding Definition.TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发参数" Width="340" MinWidth="300"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<DockPanel>
<ComboBox x:Name="ComparisonOutputSelector" DockPanel.Dock="Left" Width="130" Margin="0,0,6,0" ItemsSource="{Binding ComparisonOutputs}" ItemTemplate="{StaticResource NameTemplate}" SelectedValuePath="Id" SelectedValue="{Binding ComparisonOutputId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="多输出或绑定失效时，选择用于比较的输出">
<ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource CommunicationTableComboBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding ShowComparisonOutputSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
</ComboBox>
<controls:ParamBinding Height="30" ParameterName="触发参数" NodeName="触发规则" SyncEditingToSource="True" AvailableDataSources="{Binding ConditionSources}" BindingSource="{Binding TriggerParameterSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="有输入或绑定时按类型比较相等才执行；清空且无绑定时不比较。失效绑定不放行。"/>
</DockPanel>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="操作" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Width="24" Height="24" Padding="0" HorizontalAlignment="Center" ToolTip="删除触发规则" Click="Remove_Click" Style="{DynamicResource DangerButtonStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid><Button Content="＋" Command="{Binding AddEventTriggerCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,8"/></StackPanel></TabItem><TabItem Header="全局数据触发"><StackPanel><TextBlock Margin="0,0,0,8" Text="匹配所有开启数据上传的来源，保留原生类型；指定来源请使用接收事件。" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/><TextBlock Text="{Binding GlobalRuleLoadNotice}" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/><DataGrid x:Name="StringTriggerGrid" ItemsSource="{Binding StringTriggers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" AlternationCount="1000000" HeadersVisibility="Column" ColumnHeaderStyle="{DynamicResource OpcUaDataGridHeaderStyle}" RowStyle="{DynamicResource OpcUaDataGridRowStyle}" CellStyle="{StaticResource CommunicationTableCellStyle}" Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"><DataGrid.Columns>
<DataGridTemplateColumn Header="序号" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CommunicationTableTextStyle}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Ordinal}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发参数" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CommunicationTableTextBoxStyle}" Text="{Binding Definition.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="按本次上传原生类型解析；等于、不等于、包含要求填写参数。"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="匹配方式" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemsSource="{Binding MatchModes}" SelectedItem="{Binding MatchMode, Mode=TwoWay}" ToolTip="等于：按原生类型比较；包含：仅String；不检查内容：任意有效标量，数组和原始字节不直接触发。"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="触发命令类型" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Commands}" SelectedValuePath="Id" SelectedValue="{Binding Definition.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemContainerStyle="{StaticResource CommandItemStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="执行目标" Width="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><ComboBox Style="{StaticResource CommunicationTableComboBoxStyle}" ItemTemplate="{StaticResource NameTemplate}" ItemsSource="{Binding Targets}" SelectedValuePath="Id" SelectedValue="{Binding Definition.TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="操作" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Width="24" Height="24" Padding="0" HorizontalAlignment="Center" ToolTip="删除触发规则" Click="Remove_Click" Style="{DynamicResource DangerButtonStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid><Button Content="＋" Command="{Binding AddStringTriggerCommand}" Width="28" Height="28" HorizontalAlignment="Left" Margin="8,8"/></StackPanel></TabItem></TabControl></ScrollViewer>
</UserControl>
