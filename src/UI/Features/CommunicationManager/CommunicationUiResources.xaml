<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../Resources/Styles/CommonStyleResources.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <DataTemplate x:Key="CommunicationSeparatorTemplate"><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
 <Style x:Key="CommunicationSeparatorStyle" TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBoxStyle}">
  <Setter Property="Height" Value="34"/><Setter Property="IsEditable" Value="False"/>
  <Setter Property="SelectedValuePath" Value="Value"/>
  <Setter Property="ItemTemplate" Value="{StaticResource CommunicationSeparatorTemplate}"/>
 </Style>
 <Style x:Key="CommunicationTableTextStyle" TargetType="TextBlock">
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextAlignment" Value="Center"/>
 </Style>
 <Style x:Key="CommunicationTableTextBoxStyle" TargetType="TextBox">
  <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,3"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
  <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
  <Setter Property="BorderThickness" Value="1"/>
 </Style>
 <DataTemplate x:Key="CommunicationTableStringTemplate"><TextBlock Text="{Binding}" Style="{StaticResource CommunicationTableTextStyle}"/></DataTemplate>
 <Style x:Key="CommunicationTableComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBoxStyle}">
  <Setter Property="Height" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="ItemTemplate" Value="{StaticResource CommunicationTableStringTemplate}"/>
 </Style>
 <Style x:Key="CommunicationTableCellStyle" TargetType="DataGridCell">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="10,5"/>
  <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
</ResourceDictionary>
