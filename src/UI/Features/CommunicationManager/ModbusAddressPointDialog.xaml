<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.CommunicationManager.ModbusAddressPointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        Title="设备管理" Width="430" Height="620" MinWidth="390" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}">
    <Grid Margin="18" TextElement.FontSize="14" TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="地址配置" FontSize="18" FontWeight="SemiBold"/>
        <Separator Grid.Row="1" Margin="0,12"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/>
                    <RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <TextBlock Text="地址名称" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                <TextBlock Grid.Row="1" Text="寄存器地址" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                <TextBlock Grid.Row="2" Text="寄存器个数" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                <TextBlock Grid.Row="3" Text="Int位数" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding IntBitsOptions}" SelectedItem="{Binding IntBits}" Height="32"/>
                <TextBlock Grid.Row="4" Text="字节顺序" VerticalAlignment="Center"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ByteOrderOptions}" SelectedItem="{Binding ByteOrder}" Height="32"/>
                <TextBlock Grid.Row="5" Text="读写属性" VerticalAlignment="Center"/><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding AccessModeOptions}" SelectedItem="{Binding AccessMode}" Height="32"/>
                <TextBlock Grid.Row="6" Text="超时时间(ms)" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Height="32" ToolTip="该地址块每次读取请求的超时时间"/>
                <TextBlock Grid.Row="7" Text="轮询使能" VerticalAlignment="Center"/><controls:ToggleSwitch Grid.Row="7" Grid.Column="1" IsChecked="{Binding PollEnabled, Mode=TwoWay}" SwitchWidth="42" SwitchHeight="22" VerticalAlignment="Center"/>
            </Grid>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding ValidationMessage}" Foreground="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="84" Margin="0,0,10,0"/>
            <Button Content="确定" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="84"/>
        </StackPanel>
    </Grid>
</themeWindows:ThemeDialogWindow>
