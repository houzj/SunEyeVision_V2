<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.CommunicationManager.ModbusSendTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        Title="发送测试" Width="460" Height="540" MinWidth="400" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}">
    <Grid Margin="18" TextElement.FontSize="14"
          TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="处理方式" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="地址选择" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="AddressCombo" Grid.Column="1" Height="32"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="发送数据类型" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="DataTypeCombo" Grid.Column="1" Height="32"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="多个 int/float 值用英文分号 (;) 分隔；按实际输入量写入，超过地址块容量只取前面的值。string 按 UTF-8 编码。"
                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                   TextWrapping="Wrap" Margin="0,2,0,12"/>
        <TextBlock Grid.Row="4" Text="发送数据内容" Margin="0,0,0,7"/>
        <TextBox x:Name="PayloadTextBox" Grid.Row="5" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="8" VerticalContentAlignment="Top"/>
        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="清空" Click="Clear_Click" Style="{StaticResource SecondaryButtonStyle}"
                    Width="76" Margin="0,0,10,0"/>
            <Button x:Name="SendButton" Content="发送" Click="Send_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Width="76"/>
        </StackPanel>
    </Grid>
</themeWindows:ThemeDialogWindow>
