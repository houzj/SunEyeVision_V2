<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.Dialogs.SaveAsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        Title="另存为"
        Width="500"
        Height="430"
        MinHeight="360"
        MinWidth="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">

    <Window.Resources>
        <!-- 按钮由全局 CommonStyleResources 提供主题化样式；这里仅作尺寸覆盖 -->
        <Style x:Key="SaveAsDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="SaveAsDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- 按钮区：Dock 到底部，永不被内容挤出（高度自适应，始终可见） -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Style="{StaticResource SaveAsDialogButtonStyle}"
                    IsCancel="True"/>
            <Button Content="保存"
                    Style="{StaticResource SaveAsDialogPrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>

        <!-- 内容区：标题 + 名称 + 描述，填满 DockPanel 剩余空间 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Margin="2,2,2,16">
                <Run Text="{Binding DialogTitle}"/>
            </TextBlock>

            <!-- 名称 -->
            <StackPanel Grid.Row="1" Margin="2,0,2,12">
                <TextBlock Text="名称："
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4"
                         Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                         BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                         Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- 描述（占满剩余空间，溢出可滚动） -->
            <StackPanel Grid.Row="2" Margin="2,0,2,0">
                <TextBlock Text="描述（可选）："
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="80"
                         Padding="6,4"
                         Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                         BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                         Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                         BorderThickness="1"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</themeWindows:ThemeDialogWindow>
