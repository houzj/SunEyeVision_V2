<Window x:Class="SunEyeVision.UI.Features.Dialogs.SolutionConfigurationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base" xmlns:dialogs="clr-namespace:SunEyeVision.UI.Features.Dialogs"
 xmlns:visibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
 Title="SunEyeVision 解决方案管理器" Width="1040" Height="680" MinWidth="760" MinHeight="520"
 WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
 WindowChrome.WindowChrome="{x:Static dialogs:SolutionConfigurationDialog.DialogChrome}"
 Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}"
 Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <visibility:StringToVisibilityConverter x:Key="TextVisibility"/>
  <dialogs:SolutionIdentityVisibilityConverter x:Key="CurrentVisibility"/>
  <dialogs:SolutionMissingLocationVisibilityConverter x:Key="MissingLocationVisibility"/>
  <dialogs:SolutionDescriptionPreviewConverter x:Key="DescriptionPreview"/>
  <!-- Keep disabled/modal lists on the active theme instead of system ListBox chrome. -->
  <Style x:Key="SolutionList" TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Padding="{TemplateBinding Padding}"
      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
      <ItemsPresenter/>
     </ScrollViewer>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ContextMenu x:Key="SolutionMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
   Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}">
   <MenuItem Header="打开" Command="{Binding LaunchCommand}"/>
   <MenuItem Header="重命名及描述…" Command="{Binding EditSolutionCommand}"/>
   <MenuItem Header="创建副本…" Command="{Binding CopySolutionCommand}"/>
   <MenuItem Header="另存为…" Command="{Binding SaveSolutionAsCommand}" Visibility="{Binding IsSelectedCurrent, Converter={StaticResource BoolVisibility}}"/>
   <MenuItem Header="{Binding ToggleDefaultButtonText}" Command="{Binding ToggleDefaultCommand}"/>
   <Separator/>
   <MenuItem Header="打开所在目录" Command="{Binding OpenFolderCommand}"/>
   <MenuItem Header="重新定位…" Command="{Binding LocateCommand}"/>
   <MenuItem Header="属性…" Command="{Binding PropertiesCommand}"/>
   <Separator/>
   <MenuItem Header="移除记录（保留文件）" Command="{Binding RemoveSolutionCommand}"/>
   <MenuItem Header="删除方案文件…" Command="{Binding DeleteSolutionCommand}"/>
  </ContextMenu>
  <Style x:Key="SolutionItem" TargetType="ListBoxItem">
   <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
   <Setter Property="ContextMenu" Value="{StaticResource SolutionMenu}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/>
   <Setter Property="Padding" Value="12"/><Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Padding="{TemplateBinding Padding}" BorderThickness="1" CornerRadius="6"
     Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RecentItem" TargetType="ListBoxItem" BasedOn="{StaticResource SolutionItem}">
   <Setter Property="ContextMenu" Value="{x:Null}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarBackgroundBrush}}">
   <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{DynamicResource SunEyeVision.BrandLogo}" Width="60" Height="36" Stretch="Uniform" Margin="0,0,12,0"/>
     <StackPanel><TextBlock Text="太阳眼视觉" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}"/><TextBlock Text="SunEyeVision" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextSecondaryBrush}}"/></StackPanel>
    </StackPanel>
    <TextBlock x:Name="VersionTextBlock" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextSecondaryBrush}}"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
     <TextBlock Text="启动：" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <ComboBox x:Name="StartupModeBox" Width="156" SelectedValuePath="Tag" SelectedValue="{Binding StartupMode}" IsEnabled="{Binding CanInteract}">
      <ComboBoxItem Content="每次选择方案" Tag="Choose"/><ComboBoxItem Content="打开上次方案" Tag="Last"/><ComboBoxItem Content="打开启动默认方案" Tag="Default"/>
     </ComboBox>
    </StackPanel>
    <Button Grid.Column="3" Content="×" Width="36" Height="32" Margin="12,0,0,0" ToolTip="关闭管理器" Style="{DynamicResource ToolButtonStyle}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}" Padding="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding RecentSolutions.Count, StringFormat='最近打开 ({0})'}" FontSize="15" FontWeight="SemiBold" Margin="4,4,4,12"/>
     <Grid Grid.Row="1">
      <ListBox x:Name="RecentList" Style="{StaticResource SolutionList}" ItemsSource="{Binding RecentSolutions}" ItemContainerStyle="{StaticResource RecentItem}" IsEnabled="{Binding CanInteract}"
       BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
       SelectionChanged="Recent_SelectionChanged" PreviewKeyDown="Recent_KeyDown" MouseDoubleClick="Recent_DoubleClick">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="尚无打开记录" FontSize="12" Margin="6,12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRecentSolutions}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
     <Button Grid.Row="2" Content="{Binding AllSolutionsCount}" ContentStringFormat="全部方案 ({0})" Margin="0,12,0,0" Command="{Binding ShowAllCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
    </Grid>
   </Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Content="新建方案" Command="{Binding NewSolutionCommand}" Padding="12,8" Style="{DynamicResource PrimaryButtonStyle}"/>
     <Button Grid.Column="1" Content="添加已有…" Command="{Binding OpenSolutionCommand}" Padding="12,8" Margin="8,0" Style="{DynamicResource SecondaryButtonStyle}"/>
     <Grid Grid.Column="2">
      <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" Padding="8,8,28,8" VerticalContentAlignment="Center" Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
      <TextBlock Text="搜索名称、描述或路径…" Margin="9,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <Button Content="×" Width="24" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="清除搜索" Command="{Binding ClearSearchCommand}" Style="{DynamicResource ToolButtonStyle}" Visibility="{Binding HasSearchText, Converter={StaticResource BoolVisibility}}"/>
     </Grid>
     <Button Grid.Column="3" Content="设置 ▾" Padding="10,8" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="Settings_Click">
      <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
       Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}">
       <MenuItem Header="数据目录">
        <MenuItem Header="查看数据目录…" Command="{Binding ShowDataDirectoryCommand}"/>
        <MenuItem Header="复制数据目录路径" Command="{Binding CopyDataDirectoryCommand}"/>
        <MenuItem Header="打开数据目录" Command="{Binding OpenDataDirectoryCommand}"/>
        <Separator/><MenuItem Header="更改数据目录…" Command="{Binding ChangeDataDirectoryCommand}"/>
       </MenuItem>
       <MenuItem Header="修复文件关联" Command="{Binding RepairAssociationCommand}"/>
       <Separator/><MenuItem Header="高级维护">
        <MenuItem Header="故障恢复…" Command="{Binding RestorePreviousCommand}" ToolTip="先选中一个有内部恢复内容的方案"/>
       </MenuItem>
      </ContextMenu></Button.ContextMenu>
     </Button>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding OperationStatus}" Margin="0,0,0,8" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
    <Grid Grid.Row="2">
     <ListBox x:Name="CardList" Style="{StaticResource SolutionList}" ItemsSource="{Binding FilteredMetadatas}" SelectedItem="{Binding SelectedMetadata, Mode=TwoWay}" ItemContainerStyle="{StaticResource SolutionItem}" IsEnabled="{Binding CanInteract}"
      Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="Cards_KeyDown" SelectionChanged="Cards_SelectionChanged"
      PreviewMouseRightButtonDown="Cards_RightClick" ContextMenuOpening="Cards_ContextMenuOpening" MouseDoubleClick="Solution_DoubleClick">
      <ListBox.ItemsPanel><ItemsPanelTemplate><dialogs:SolutionCardPanel CardWidth="240"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
          <TextBlock Text="启动默认" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}" Visibility="{Binding IsDefault, Converter={StaticResource BoolVisibility}}"/>
          <TextBlock Text="文件失效" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}" Visibility="{Binding IsMissing, Converter={StaticResource BoolVisibility}}"/>
         </StackPanel>
        </Grid>
        <TextBlock Text="{Binding FilePath}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        <TextBlock Text="{Binding Description, Converter={StaticResource DescriptionPreview}}" Height="16" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding ModifiedTime, StringFormat='修改：{0:yyyy-MM-dd HH:mm}'}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
         <TextBlock Grid.Column="1" Text="已打开" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}">
          <TextBlock.Visibility><MultiBinding Converter="{StaticResource CurrentVisibility}"><Binding Path="Id"/><Binding Path="DataContext.CurrentSolutionId" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></TextBlock.Visibility>
         </TextBlock>
         <Button Grid.Column="1" Content="重新定位…" FontSize="11" Padding="0" Height="16" Style="{DynamicResource ToolButtonStyle}" Click="Missing_Locate">
          <Button.Visibility><MultiBinding Converter="{StaticResource MissingLocationVisibility}"><Binding Path="IsMissing"/><Binding Path="Id"/><Binding Path="DataContext.CurrentSolutionId" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></Button.Visibility>
         </Button>
        </Grid>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFilteredSolutions}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
      <TextBlock Text="双击打开方案，右键进行管理。" FontSize="12" Margin="0,8,0,0" TextAlignment="Center" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
