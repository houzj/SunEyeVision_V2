<Window x:Class="SunEyeVision.UI.Features.Dialogs.SolutionConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SunEyeVision.UI.Converters"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        xmlns:dialogs="clr-namespace:SunEyeVision.UI.Features.Dialogs"
        mc:Ignorable="d"
        Title="太阳眼视觉 - 打开解决方案"
        Width="960"
        Height="640"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowChrome.WindowChrome="{x:Static dialogs:SolutionConfigurationDialog.DialogChrome}"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">

    <Window.Resources>
        <!-- 转换器 -->
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:PathToFileNameConverter x:Key="PathToFileNameConverter"/>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏文字按钮样式（工程化） -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮样式 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
        </Style>

        <!-- 卡片图标按钮样式：透明 + 主题悬停，避免系统默认样式透出卡片选中深色 -->
        <Style x:Key="CardIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最近打开列表项样式 -->
        <Style x:Key="RecentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 自绘标题栏 -->
            <RowDefinition Height="*"/>     <!-- 主内容 -->
        </Grid.RowDefinitions>

        <!-- ========== 自绘标题栏（VM 风格深色） ========== -->
        <Border Grid.Row="0" Height="64"
                Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarBackgroundBrush}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + 双行标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/SunEyeVision.UI;component/Icons/app_logo.ico" Width="40" Height="40" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="太阳眼视觉" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}"/>
                        <TextBlock Text="SunEyeVision" FontSize="11" Opacity="0.8"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 版本号 -->
                <TextBlock x:Name="VersionTextBlock" Grid.Column="1" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontSize="12" Opacity="0.6"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}"/>

                <!-- 右上控件：启动时跳过 + 关闭 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <CheckBox x:Name="SkipCheckBox" Content="启动时跳过" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}"
                              IsChecked="{Binding SkipStartupConfig}" VerticalAlignment="Center"
                              Margin="0,0,16,0" FontSize="12"
                              WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Width="34" Height="34" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容：左右分栏 ========== -->
        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>  <!-- 最近打开 -->
                <ColumnDefinition Width="*"/>    <!-- 全部方案 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：最近打开 -->
            <Border Grid.Column="0" Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,12,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="最近打开" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                        <TextBlock Text="{Binding RecentSolutions.Count, StringFormat=' ({0})'}" FontSize="12"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- 最近打开列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding RecentSolutions}"
                             SelectedItem="{Binding SelectedMetadata}"
                             BorderThickness="0"
                             Background="Transparent" ItemContainerStyle="{StaticResource RecentItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                               VerticalAlignment="Center" Margin="8,1,0,0"
                                               Text="{Binding LastAccessTime, StringFormat='{}{0:MM-dd HH:mm}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部：全部解决方案入口 -->
                    <Button Grid.Row="2" Style="{StaticResource ToolbarButtonStyle}" Margin="0,10,0,0"
                            Command="{Binding ShowAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="全部解决方案" FontSize="12"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                            <TextBlock Text="{Binding AllSolutionsCount, StringFormat=' ({0})'}" FontSize="12"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 右侧：全部方案卡片区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏：工程化文字按钮 + 搜索框（带水印） -->
                <Border Grid.Row="0" Background="{DynamicResource {x:Static base:ThemeKeys.ToolBarBackgroundBrush}}"
                        BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="1"
                        CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button Content="新建" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NewSolutionCommand}"/>
                            <Button Content="载入" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenSolutionCommand}" Margin="6,0,0,0"/>
                            <Button Content="另存" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveSolutionAsCommand}" Margin="6,0,0,0"/>
                            <Button Content="复制" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CopySolutionCommand}" Margin="6,0,0,0"/>
                            <Button Content="删除" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteSolutionCommand}" Margin="6,0,0,0"/>
                            <Button Content="{Binding ToggleDefaultButtonText}" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ToggleDefaultCommand}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- 搜索框（带水印，占右侧剩余空间） -->
                        <Grid DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Padding="8,5" FontSize="12"
                                     Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                                     BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                     CaretBrush="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>

                            <!-- 水印：空 + 未聚焦 显示；聚焦或有内容 隐藏 -->
                            <TextBlock IsHitTestVisible="False"
                                       VerticalAlignment="Center" Padding="8,5"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Text="输入名称/描述/路径过滤...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchTextBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 解决方案卡片列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Background="{DynamicResource {x:Static base:ThemeKeys.WorkspaceBackgroundBrush}}">
                    <ItemsControl ItemsSource="{Binding FilteredMetadatas}">
                        <!-- 自动换行布局 -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- 卡片样式模板 -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- ★ 卡片宽 210：右侧卡片区可用约 686px，3×(210+10)=660 ≤ 686，
                                     一行排 3 个卡片，消除之前"一行 2 个 + 大片空置"的问题。
                                     (原 240 时 3×250=750 > 686 放不下第3个) -->
                                <Border Width="210" Height="150" Margin="0,0,10,10" CornerRadius="6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <!-- 悬停效果（未选中时） -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Value="False">
                                                            <Condition.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding Path="Id"/>
                                                                    <Binding Path="DataContext.SelectedMetadataId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </Condition.Binding>
                                                        </Condition>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </MultiDataTrigger>
                                                <!-- 选中效果 -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.SelectedMetadataId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- 卡片内容 -->
                                    <Grid Margin="12,10,12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：品牌图标占位 + 名称 + 编辑按钮 -->
                                        <Grid Grid.Row="0" Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 品牌色图标占位（默认态显示对号 / 非默认态显示圆点） -->
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="4"
                                                    Background="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}" VerticalAlignment="Center">
                                                <Grid>
                                                    <!-- 默认解决方案：对号 -->
                                                    <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- 非默认方案：圆点 -->
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>

                                            <!-- 名称 -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                                       VerticalAlignment="Center" Margin="6,0,4,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                        <Binding Path="Id"/>
                                                                        <Binding Path="DataContext.SelectedMetadataId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 编辑按钮 -->
                                            <Button Grid.Column="2" Width="24" Height="24" Padding="0"
                                                    Style="{StaticResource CardIconButtonStyle}"
                                                    Command="{Binding DataContext.EditSolutionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Cursor="Hand">
                                                <TextBlock Text="✏️" FontSize="11"
                                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                            </Button>
                                        </Grid>

                                        <!-- 第二行：文件路径 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="📄" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                                            <TextBlock Text="{Binding FilePath, Converter={StaticResource PathToFileNameConverter}}"
                                                       FontSize="10" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                        </StackPanel>

                                        <!-- 第三行：描述 -->
                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Description}"/>

                                        <!-- 第四行：时间信息 -->
                                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,4,0,0">
                                                <Run Text="最近打开: "/>
                                                <Run Text="{Binding LastAccessTime, StringFormat='{}{0:MM-dd HH:mm}'}" FontWeight="Medium"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,2,0,0">
                                                <Run Text="修改: "/>
                                                <Run Text="{Binding ModifiedTime, StringFormat='{}{0:MM-dd HH:mm}'}" FontWeight="Medium"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- "已打开"徽章：卡片右下角，仅当 Id == CurrentSolutionId 时显示（受主题管理） -->
                                        <Border Grid.RowSpan="4" CornerRadius="3" Padding="6,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                Background="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding Path="Id"/>
                                                                    <Binding Path="DataContext.CurrentSolutionId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="已打开" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                                        </Border>
                                    </Grid>

                                    <!-- 选中命令绑定 -->
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
