<Window x:Class="SunEyeVision.UI.Features.Dialogs.ThemeMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">

    <Border BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左侧图标 -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                  Width="44" Height="44"
                  VerticalAlignment="Top" Margin="0,2,16,0">
                <Ellipse x:Name="IconBackground" Width="40" Height="40"/>
                <TextBlock x:Name="IconGlyph"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0" Grid.Column="1"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Margin="0,0,0,10"/>

            <!-- 消息正文 -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1" Grid.Column="1"
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Margin="0,0,0,18"/>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="84" Height="34"
                        Margin="0,0,8,0" Padding="0"
                        FontSize="13" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnCancelClick"
                        Background="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                        Foreground="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"
                        BorderThickness="0"/>
                <Button x:Name="NoButton"
                        Content="否"
                        Width="84" Height="34"
                        Margin="0,0,8,0" Padding="0"
                        FontSize="13" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnNoClick"
                        Background="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                        Foreground="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"
                        BorderThickness="0"/>
                <Button x:Name="YesButton"
                        Content="是"
                        Width="84" Height="34"
                        Padding="0"
                        FontSize="13" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnYesClick"
                        Background="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"
                        Foreground="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"
                        BorderThickness="0"/>
                <Button x:Name="OkButton"
                        Content="确定"
                        Width="84" Height="34"
                        Padding="0"
                        FontSize="13" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnOkClick"
                        Background="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"
                        Foreground="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"
                        BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
