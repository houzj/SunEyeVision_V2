<Window x:Class="SunEyeVision.UI.Features.Dialogs.ThemeMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">

    <Window.Resources>
        <!-- 弹窗按钮样式：统一不分主次；悬停/按下背景高亮并适配主题；
             前景色用主题按钮文字色，保证文字/图标在悬停高亮下不被盖住 -->
        <Style x:Key="MessageDialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonTextBrush}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonPressedBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左侧图标 -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                  Width="44" Height="44"
                  VerticalAlignment="Top" Margin="0,2,16,0">
                <Ellipse x:Name="IconBackground" Width="40" Height="40"/>
                <TextBlock x:Name="IconGlyph"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0" Grid.Column="1"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Margin="0,0,0,10"/>

            <!-- 消息正文 -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1" Grid.Column="1"
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                       Margin="0,0,0,18"/>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Margin="0,0,8,0"
                        Style="{StaticResource MessageDialogButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnCancelClick"/>
                <Button x:Name="NoButton"
                        Content="否"
                        Margin="0,0,8,0"
                        Style="{StaticResource MessageDialogButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnNoClick"/>
                <Button x:Name="YesButton"
                        Content="是"
                        Style="{StaticResource MessageDialogButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnYesClick"/>
                <Button x:Name="OkButton"
                        Content="确定"
                        Style="{StaticResource MessageDialogButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnOkClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
