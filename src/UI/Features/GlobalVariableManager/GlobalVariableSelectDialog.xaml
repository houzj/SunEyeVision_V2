<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.GlobalVariableManager.GlobalVariableSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        mc:Ignorable="d"
        Title="选择变量"
        Width="700"
        Height="480"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#616161"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 过滤工具栏 -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- 底部 -->
        </Grid.RowDefinitions>

        <!-- 过滤工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 分组筛选 -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup}"
                          Width="140"
                          Margin="0,0,8,0"
                          Padding="8,4"
                          FontSize="13"
                          VerticalAlignment="Center"/>

                <!-- 搜索框 -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         Padding="8,4"
                         FontSize="13"
                         VerticalAlignment="Center"
                         Background="White"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="ToolTip" Value="按名称、注释、类型搜索"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  Margin="16,8"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding FilteredVariables}"
                  SelectedItem="{Binding SelectedVariable}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  HorizontalGridLinesBrush="#F0F0F0"
                  RowHeight="26"
                  FontSize="12"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="IsEnabled" Value="True"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- 序号 -->
                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 变量名称 -->
                <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="120" IsReadOnly="True"/>

                <!-- 类型 -->
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" IsReadOnly="True"/>

                <!-- 当前值 -->
                <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="120" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 注释 -->
                <DataGridTextColumn Header="注释" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 分组 -->
                <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#9E9E9E"
                           FontSize="12">
                    <Run Text="共 "/>
                    <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                    <Run Text=" 个变量"/>
                    <Run Text="（总计 "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" 个）"/>
                </TextBlock>

                <!-- 确定 -->
                <Button Grid.Column="1"
                        Content="确定"
                        IsDefault="True"
                        Click="OK_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80"
                        Margin="0,0,10,0"/>

                <!-- 取消 -->
                <Button Grid.Column="2"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80"/>
            </Grid>
        </Border>
    </Grid>
</themeWindows:ThemeDialogWindow>
