<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.ParameterSetting.TargetParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SunEyeVision.UI.Features.ParameterSetting"
        xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
        mc:Ignorable="d"
        Title="目标参数管理"
        Width="800"
        Height="550"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 按钮样式由全局 CommonStyleResources 提供（PrimaryButtonStyle/SecondaryButtonStyle） -->
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：树形选择 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="选择参数" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                    </Border>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding TreeNodes}"
                              Background="White"
                              BorderThickness="0"
                              FontSize="12">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TargetParamTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              IsThreeState="{Binding SupportsTriState}"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Padding="2,3"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#333333"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" Margin="8,0"
                          HorizontalAlignment="Center"
                          Background="Transparent"/>

            <!-- 右侧：已选消费者列表 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="目标参数" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedConsumers}"
                             Background="White"
                             BorderThickness="0"
                             FontSize="12"
                             Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayPath}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#333333"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#F44336"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="4,2"
                                            Margin="4,0,0,0"
                                            ToolTip="移除"
                                            Command="{Binding DataContext.RemoveConsumerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0,0,10,0"/>
                <Button Content="取消"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</local:ThemeDialogWindow>
