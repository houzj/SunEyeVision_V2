<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Features.ParameterSetting.TargetParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SunEyeVision.UI.Features.ParameterSetting"
        xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        mc:Ignorable="d"
        Title="目标参数管理"
        Width="800"
        Height="550"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="TargetTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="TargetListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：树形浏览；复选框控制目标参数是否绑定。 -->
            <Border Grid.Column="0" Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource {x:Static base:ThemeKeys.PanelHeaderBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="选择列表" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                            <ComboBox Margin="0,6,0,0" Height="28" IsEnabled="False" SelectedIndex="0"
                                      ToolTip="仅显示与当前全局变量类型匹配的参数">
                                <ComboBoxItem Content="全部类型"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding TreeNodes}"
                              Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                              Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                              BorderThickness="0"
                              FontSize="12">
                        <TreeView.ItemContainerStyle>
                            <StaticResource ResourceKey="TargetTreeItemStyle"/>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TargetParamTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Padding="2,3"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="False"
                                              VerticalAlignment="Center"
                                              Margin="6,0,4,0"
                                              ToolTip="勾选绑定，取消勾选解绑"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" Margin="8,0"
                          HorizontalAlignment="Center"
                          Background="Transparent"/>

            <!-- 右侧：已选消费者列表 -->
            <Border Grid.Column="2" Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource {x:Static base:ThemeKeys.PanelHeaderBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="目标参数" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedConsumers}"
                             Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                             Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                             BorderThickness="0"
                             FontSize="12"
                             Margin="4">
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="TargetListItemStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayPath}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="4,2"
                                            Margin="4,0,0,0"
                                            ToolTip="移除"
                                            Command="{Binding DataContext.RemoveConsumerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0,0,10,0"/>
                <Button Content="取消"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</local:ThemeDialogWindow>
