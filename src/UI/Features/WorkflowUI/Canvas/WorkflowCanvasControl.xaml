<UserControl x:Class="SunEyeVision.UI.Features.WorkflowUI.Canvas.WorkflowCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters"
             xmlns:convertersPath="clr-namespace:SunEyeVision.UI.Converters.Path"
             xmlns:convertersNode="clr-namespace:SunEyeVision.UI.Converters.Node"
             xmlns:convertersVisibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:convertersWorkflow="clr-namespace:SunEyeVision.UI.Converters.Workflow"
             xmlns:common="clr-namespace:SunEyeVision.UI.Shell.Controls.Common"
             xmlns:rendering="clr-namespace:SunEyeVision.UI.Services.Rendering"
             xmlns:native="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls.Base;assembly=SunEyeVision.Plugin.Wpf"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             xmlns:local="clr-namespace:SunEyeVision.UI.Features.WorkflowUI.Canvas"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Styles/NodeStyleResources.xaml"/>
          <ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Styles/ConnectionStyleResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <convertersPath:SmartPathConverter x:Key="SmartPathConverter"/>
        <convertersPath:SmartPathMultiConverter x:Key="SmartPathMultiConverter"/>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convertersPath:CoordinateOffsetConverter x:Key="CoordinateOffsetConverter"/>
        <converters:PointCenterToOffsetConverter x:Key="PointCenterToOffsetConverter"/>
        <convertersNode:ToolNodeIconConverter x:Key="ToolNodeIcon"/>
        <convertersNode:NodeShapeConverter x:Key="NodeShape"/>
        <convertersNode:GroupNodeBackgroundConverter x:Key="GroupNodeBackground"/>

        <!-- 使用缓存的节点转换器（性能优化） -->
        <rendering:CachedNodeBackgroundConverter x:Key="NodeBackgroundColorConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <PathGeometry x:Key="StandardModuleOutline" Figures="M106,0 A4,4 0 0 1 110,4 L110,26 A4,4 0 0 1 106,30 L4,30 A4,4 0 0 1 0,26 L0,4 A4,4 0 0 1 4,0 Z"/>
        <PathGeometry x:Key="ImageModuleOutline" Figures="M15,0 L95,0 A15,15 0 0 1 110,15 A15,15 0 0 1 95,30 L15,30 A15,15 0 0 1 0,15 A15,15 0 0 1 15,0 Z"/>
    <PathGeometry x:Key="IfBranchOutline" Figures="M0,12 A2,2 0 0 1 2,10 L54,1 A2,2 0 0 1 56,1 L108,10 A2,2 0 0 1 110,12 L110,28 A2,2 0 0 1 108,30 L56,39 A2,2 0 0 1 54,39 L2,30 A2,2 0 0 1 0,28 Z"/>
    <PathGeometry x:Key="FunctionModuleOutline" Figures="M0,2 A2,2 0 0 1 2,0 L38,0 A2,2 0 0 1 40,2 L40,38 A2,2 0 0 1 38,40 L2,40 A2,2 0 0 1 0,38 Z"/>
    <PathGeometry x:Key="TimerModuleOutline" Figures="M20,0 A20,20 0 0 1 40,20 A20,20 0 0 1 20,40 A20,20 0 0 1 0,20 A20,20 0 0 1 20,0 Z"/>
    <PathGeometry x:Key="ShellModuleOutline" Figures="M9.5,0 L108,0 A2,2 0 0 1 110,2 L110,20.5 A1,3 0 0 1 109,23.5 L103.5,29 A3,1 0 0 1 100.5,30 L2,30 A2,2 0 0 1 0,28 L0,9.5 A1,3 0 0 1 1,6.5 L6.5,1 A3,1 0 0 1 9.5,0 Z"/>
    <PathGeometry x:Key="CommDataOutline" Figures="M2,0 L100.5,0 A3,1.5 0 0 1 103.5,1.5 L109,13.5 A2,3 0 0 1 109,16.5 L103.5,28.5 A3,1.5 0 0 1 100.5,30 L2,30 A3,1.5 0 0 1 1,28.5 L6.5,16.5 A2,3 0 0 1 6.5,13.5 L1,1.5 A3,1.5 0 0 1 2,0 Z"/>

        <!-- 箭头标记 - 尖端指向右侧（度的方向），方便旋转 -->
        <!-- 箭头长度与 BezierPathCalculator.ArrowLength 保持一致（15px） -->
        <PathGeometry x:Key="ArrowGeometry" Figures="M -6,-5 L 2,0 L -6,5 Z"/>

        <!-- 箭头填充颜色 -->
        <SolidColorBrush x:Key="ArrowBrush" Color="#FFA70F"/>

        <!-- 节点背景样式（保留用于转换器） -->
        <SolidColorBrush x:Key="NodeBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NodeHeaderBackground" Color="#0066CC"/>
        <SolidColorBrush x:Key="NodeFooterBackground" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="NodeTextForeground" Color="#0066CC"/>
        <convertersWorkflow:NodeIconStatusBackgroundConverter x:Key="NodeIconStatusBackgroundConverter"/>
        <convertersWorkflow:NodeIconStatusForegroundConverter x:Key="NodeIconStatusForegroundConverter"/>
        <SolidColorBrush x:Key="NodeTimeForeground" Color="#666666"/>
        <SolidColorBrush x:Key="NodeBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="NodeBorderBrushSelected" Color="#0066CC"/>
        <!-- 端口可见性：默认透明但保留命中，节点悬停或端口自身悬停时显示。
             用 Opacity 而不是 Collapsed，否则端口在节点外侧拿不到鼠标事件，永远放不大。 -->
        <Style x:Key="CanvasPortStyle" TargetType="{x:Type native:ConnectionPort}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=local:WorkflowNodeView}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHited, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 主容器 -->
    <Grid x:Name="MainGrid">
        <!-- 原有的 WorkflowCanvas -->
        <Canvas x:Name="WorkflowCanvas"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="WorkflowCanvas_DragEnter"
                DragOver="WorkflowCanvas_DragOver"
                DragLeave="WorkflowCanvas_DragLeave"
                Drop="WorkflowCanvas_Drop"
                PreviewMouseLeftButtonDown="WorkflowCanvas_PreviewMouseLeftButtonDown"
                PreviewMouseMove="WorkflowCanvas_PreviewMouseMove"
                PreviewMouseLeftButtonUp="WorkflowCanvas_PreviewMouseLeftButtonUp"
                GotFocus="WorkflowCanvas_GotFocus"
                LostFocus="WorkflowCanvas_LostFocus">

        <!-- 原VM DiagramPage的6像素线网背景，随主题整体替换。 -->
        <Canvas.Background>
            <DynamicResource ResourceKey="{x:Static base:ThemeKeys.WorkflowCanvasGridBrush}"/>
        </Canvas.Background>

        <!-- 连接线 - 使用智能直角折线 -->
        <ItemsControl ItemsSource="{Binding DocumentCanvas.Connections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Canvas.ZIndex" Value="1000"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Canvas>
                        <!-- 连接线 - 仅视觉显示层，不参与命中测试 -->
                        <Path Loaded="Path_Loaded"
                              IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                            <Path.Style>
                                <Style BasedOn="{StaticResource ConnectionLineStyle}" TargetType="Path"/>
                            </Path.Style>
                        </Path>

                        <!-- 透明宽命中线 - 始终透明，仅负责点击选中交互 -->
                        <Path Stroke="Transparent" StrokeThickness="2"
                              Cursor="Hand"
                              MouseEnter="ConnectionHitArea_MouseEnter"
                              MouseLeave="ConnectionHitArea_MouseLeave"
                              Focusable="True" MouseLeftButtonDown="ConnectionHitArea_MouseLeftButtonDown" MouseRightButtonDown="ConnectionHitArea_MouseRightButtonDown">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 连接线拐点（中间点）标记 -->
                        <ItemsControl ItemsSource="{Binding PathPoints, Mode=OneWay}"
                                      Visibility="{Binding ShowPathPoints, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#FF6600"
                                                 Stroke="#FFFFFF"
                                                 StrokeThickness="1"
                                                 Opacity="0.7"
                                                 Canvas.Left="{Binding X, Converter={StaticResource CoordinateOffsetConverter}, ConverterParameter=-4}"
                                                 Canvas.Top="{Binding Y, Converter={StaticResource CoordinateOffsetConverter}, ConverterParameter=-4}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 箭头（颜色跟随连线状态：悬停蓝、选中橙，其余跟随 StatusColor） -->
                        <Path Data="{StaticResource ArrowGeometry}"
                              Canvas.Left="{Binding ArrowX}"
                              Canvas.Top="{Binding ArrowY}"
                              RenderTransformOrigin="0,0"
                              x:Name="ArrowPath">
                            <Path.RenderTransform><RotateTransform Angle="{Binding ArrowAngle}"/></Path.RenderTransform>
                            <Path.Style>
                                <Style BasedOn="{StaticResource ConnectionArrowStyle}" TargetType="Path"/>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 节点 -->
        <ItemsControl x:Name="CanvasNodeItems" ItemsSource="{Binding DocumentCanvas.Nodes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
        <!-- Position表示HitArea中心点，Canvas.Left/Top需要左上角坐标 -->
        <!-- 左上角 = 中心点 - (HitAreaWidth/2, HitAreaHeight/2) -->
        <Setter Property="Canvas.Left" Value="{Binding HitAreaLeft, Mode=OneWay}"/>
        <Setter Property="Canvas.Top" Value="{Binding HitAreaTop, Mode=OneWay}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 节点视图宿主：对应原件 DiagramItem，命中状态由控件自身维护，端口可见性跟随它 -->
                    <local:WorkflowNodeView>
                    <local:WorkflowNodeView.Style>
                        <Style TargetType="local:WorkflowNodeView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=local:WorkflowCanvasControl}}" Value="True">
                                    <Setter Property="IsWorkAreaLocked" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.CanEditWorkflowCanvas, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="IsWorkAreaLocked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:WorkflowNodeView.Style>
                    <!-- HitArea Border: 用于命中测试，Position表示其中心点 -->
                    <Border Width="{Binding HitAreaWidth}" Height="{Binding HitAreaHeight}"
                            Background="Transparent"
                            Tag="{Binding}"
                            x:Name="HitAreaBorder"
                            MouseLeftButtonDown="Node_MouseLeftButtonDown"
                            MouseLeftButtonUp="Node_MouseLeftButtonUp"
                            MouseMove="Node_MouseMove">
                        <Border.ContextMenu>
                            <ContextMenu Background="#FFFFFFFF"
                                         BorderBrush="#FFCCCCCC"
                                         BorderThickness="1" Padding="4">
                                <!-- 菜单项与顺序对齐原件：断开连接 / 删除 / 复制 / 重命名 / 禁用 / 启用 -->
                                <MenuItem Header="断开连接" Click="NodeContextMenu_Disconnect_Click"/>
                                <MenuItem Header="删除" Click="NodeContextMenu_Delete_Click"/>
                                <MenuItem Header="复制" Click="NodeContextMenu_Copy_Click"/>
                                <MenuItem Header="重命名" Click="NodeContextMenu_Rename_Click"/>
                                <MenuItem Header="禁用" Click="NodeContextMenu_ToggleEnabled_Click">
                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="启用" Click="NodeContextMenu_ToggleEnabled_Click">
                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <!-- GROUP循环装饰：原件GroupCirculationBackground，围绕110×40卡片外扩5。 -->
                            <Grid x:Name="GroupLoopOverlay" Width="120" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGroupLoopEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.Resources><Style x:Key="GroupLoopArrow" TargetType="Image"><Setter Property="Stretch" Value="None"/><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_cycle_right.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_cycle_right_disable.png"/></DataTrigger></Style.Triggers></Style></Grid.Resources>
                                <Border BorderBrush="#66F9F5F2" BorderThickness="2" CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.08"><GradientStop Color="#19F6F6F6" Offset="0"/><GradientStop Color="#33F3F3F3" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect Color="Black" ShadowDepth="3" Opacity="0.5"/></Border.Effect></Border>
                                <Image Margin="0,-4,0,0" VerticalAlignment="Top" Style="{StaticResource GroupLoopArrow}"/>
                                <Image Margin="0,0,0,-4" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{StaticResource GroupLoopArrow}"><Image.RenderTransform><RotateTransform Angle="180"/></Image.RenderTransform></Image>
                                <Image Margin="-3,0,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Style="{StaticResource GroupLoopArrow}"><Image.RenderTransform><RotateTransform Angle="-90"/></Image.RenderTransform></Image>
                                <Image Margin="0,0,-3,0" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5" Style="{StaticResource GroupLoopArrow}"><Image.RenderTransform><RotateTransform Angle="90"/></Image.RenderTransform></Image>
                            </Grid>
                            <!-- NodeBorder: 视觉显示元素，居中于HitArea -->
                            <Border Width="{Binding VisualWidth}" Height="{Binding VisualHeight}"

                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"



                                    Tag="{Binding}"
                                    x:Name="NodeBorder">

                                <Grid>
                            <!-- 节点底板：原件 NormalModulePathStyle 的填充为 5 段渐变，末尾 #EB6600 让底边呈现一条橙色细线；形状随 NodeDisplayType 切换。 -->
                            <Path x:Name="NodeSurface" Stretch="Fill" IsHitTestVisible="False" Stroke="#FFB8B8B8" StrokeThickness="1" Data="{Binding NodeDisplayType, Converter={StaticResource NodeShape}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource StandardModuleOutline}"/>
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FAF7F5" Offset="0"/>
                                                    <GradientStop Color="#F3F6F5" Offset="0.47"/>
                                                    <GradientStop Color="#ECEDF0" Offset="0.82"/>
                                                    <GradientStop Color="#EBE6E2" Offset="0.97"/>
                                                    <GradientStop Color="#EB6600" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <!-- 原件 IsModuleForbidden：底板换成半透明灰渐变 + 改白图标（见模板 L988-1000）。 -->
                                                <Setter Property="Fill">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#D3D3D3F5" Offset="0"/>
                                                            <GradientStop Color="#D3D3D3E1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NodeDisplayType}" Value="IMAGE">
                                                <Setter Property="Data" Value="{StaticResource ImageModuleOutline}"/>
                                            </DataTrigger>
                                                <DataTrigger Binding="{Binding NodeDisplayType}" Value="IFBRANCH">
                                                    <Setter Property="Data" Value="{StaticResource IfBranchOutline}"/>
                                                </DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="FUNCTION"><Setter Property="Data" Value="{StaticResource FunctionModuleOutline}"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="TIMER"><Setter Property="Data" Value="{StaticResource TimerModuleOutline}"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="SHELL"><Setter Property="Data" Value="{StaticResource ShellModuleOutline}"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="COMMUNCATION"><Setter Property="Data" Value="{StaticResource CommDataOutline}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            
                            <Path x:Name="NodeStatusBorder" Margin="-2" Stretch="Fill" StrokeThickness="2" IsHitTestVisible="False">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource StandardModuleOutline}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Stroke" Value="#FF636468"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnconfiguredRequiredInputs}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="StrokeDashArray" Value="3,2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunState}" Value="Failed">
                                                <!-- 原件 IsModuleFailed：橙实线（虚线只用于"参数未配置完整"）。 -->
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Modular_BorderBrush}"/>
                                                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Stroke" Value="{DynamicResource Col_EditProcess_Modular_BorderBrush}"/>
                                                <!-- 选中是橙实线；虚线只属于"参数未配置完整"。 -->
                                                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NodeDisplayType}" Value="IMAGE">
                                                <Setter Property="Data" Value="{StaticResource ImageModuleOutline}"/>
                                            </DataTrigger>
                                                <DataTrigger Binding="{Binding NodeDisplayType}" Value="IFBRANCH">
                                                    <Setter Property="Data" Value="{StaticResource IfBranchOutline}"/>
                                                </DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="FUNCTION"><Setter Property="Data" Value="{StaticResource FunctionModuleOutline}"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="TIMER"><Setter Property="Data" Value="{StaticResource TimerModuleOutline}"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="SHELL"><Setter Property="Data" Value="{StaticResource ShellModuleOutline}"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="COMMUNCATION"><Setter Property="Data" Value="{StaticResource CommDataOutline}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSubroutineNode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!-- 状态条：原件 StateFlag，左侧 26px 竖条，OK 绿 / NG 红 -->
                                <Border x:Name="RunStateBar" Width="26" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        IsHitTestVisible="False" Background="Transparent"
                                        Clip="{Binding Data, ElementName=NodeSurface}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunState}" Value="Running">
                                                <!-- 原件激活色 #FFA70F：执行中的节点状态条与连线同为激活橙。 -->
                                                <Setter Property="Background" Value="{DynamicResource Col_EditProcess_Modular_Running_Status}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunState}" Value="Passed">
                                                <Setter Property="Background" Value="{DynamicResource Col_EditProcess_Modular_OK_Status}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunState}" Value="Rejected">
                                                <Setter Property="Background" Value="{DynamicResource Col_EditProcess_Modular_NG_Status}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunState}" Value="Failed">
                                                <Setter Property="Background" Value="{DynamicResource Col_EditProcess_Modular_NG_Status}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- 节点内容 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <!-- 原件：NG/失败时编号与名称整体压暗到 0.4 -->
                                            <DataTrigger Binding="{Binding RunState}" Value="Rejected"><Setter Property="Opacity" Value="0.4"/></DataTrigger>
                                            <DataTrigger Binding="{Binding RunState}" Value="Failed"><Setter Property="Opacity" Value="0.4"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 节点类型图标（非子程序）/ 子程序设置按钮；方案 §6 五态：状态色块 + 图标重叠 -->
                                <Grid Grid.Column="0">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Width" Value="26"/><Style.Triggers><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Width" Value="31"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <!-- 图标叠上居中；状态时反白；对子程序节点隐藏 -->
                                    <!-- 正常态彩色图标 / 状态态白色图标：与原件 LogoIm 双图机制一致 -->
                                    <Image Width="20" Height="20" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Image.Source><Binding Converter="{StaticResource ToolNodeIcon}"/></Image.Source>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding NodeDisplayType}" Value="FUNCTION"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="TIMER"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Width="20" Height="20" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Image.Source><Binding Converter="{StaticResource ToolNodeIcon}" ConverterParameter="state"/></Image.Source>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding NodeDisplayType}" Value="FUNCTION"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="TIMER"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    

                                    
                                    <!-- 原GROUP参数按钮：24px原图、左边距7，标题不显示全局ID。 -->
                                    <Button x:Name="GroupSettingsButton" Width="24" Height="24" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" ToolTip="子程序参数设置" Click="SubroutineNodeSettings_Click">
                                        <Button.Template><ControlTemplate TargetType="Button">
                                            <Image x:Name="GroupSettingsImage" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_normal.png"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GroupSettingsImage" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_click.png"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="GroupSettingsImage" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_disable.png"/></Trigger>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter TargetName="GroupSettingsImage" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_disable.png"/></DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Button.Template>
                                        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 全局序号 -->
                                <TextBlock Grid.Column="1" x:Name="NodeIndexText"
                                           Text="{Binding GlobalIndex, StringFormat='{}{0}'}"
                                           Margin="0" Foreground="#4C4C4C"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource NodeGlobalIndexStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsToolboxPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding RunState}" Value="Rejected"><Setter Property="Opacity" Value="0.4"/></DataTrigger><DataTrigger Binding="{Binding RunState}" Value="Failed"><Setter Property="Opacity" Value="0.4"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="FUNCTION"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,18,0,0"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="TIMER"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,18,0,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>

                                <!-- 节点显示名称（重命名时切换到编辑框） -->
                                <Grid Grid.Column="2">
                                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding NodeDisplayType}" Value="FUNCTION"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="TIMER"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <TextBlock Text="{Binding DispName}" FontWeight="Bold" Foreground="#4C4C4C" HorizontalAlignment="Left" Margin="2,0,0,0"
                                               x:Name="NodeNameText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NodeTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox MaxLength="64" Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                             Background="White"
                                             BorderBrush="#FF6600"
                                             BorderThickness="1"
                                             Padding="2,0"
                                             MinWidth="40"
                                             FontSize="{DynamicResource NodeFontSize}"
                                             FontWeight="Bold"
                                             VerticalAlignment="Center"
                                             x:Name="NodeNameEditor"
                                             KeyDown="NodeRenameTextBox_KeyDown"
                                             LostFocus="NodeRenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Grid>




                        </Grid>

                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- 原件 NORMAL 节点填充：浅色四段渐变 + 底部橙色收边 -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/>
                                <Setter Property="Effect" Value="{x:Null}"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnconfiguredRequiredInputs}" Value="True"><Setter Property="Opacity" Value="0.86"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsSubroutineNode}" Value="True">
                                    <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource GroupNodeBackground}"><Binding Path="IsEnabled"/><Binding Path="IsSelected"/><Binding Path="Status"/></MultiBinding></Setter.Value></Setter>
                                </DataTrigger>
                            </Style.Triggers></Style>
                        </Border.Style>
                    </Border>
                            <!-- 连接端口：原件 Connector 规格（20×30 命中区、5×8 橙条、命中放大 8.5×12），节点悬停时四个方位常驻显示 -->
                            <!-- 端口层：显隐由 WorkflowNodeView 代码直接控制，对应原件 DiagramItem 的端口触发器 -->
                            <Grid x:Name="PortLayer"
                                  Width="{Binding VisualWidth}" Height="{Binding VisualHeight}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="100" IsHitTestVisible="True">

                                <native:ConnectionPort Style="{StaticResource CanvasPortStyle}" x:Name="LeftPort" Index="0" Orientation="Left"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Margin="-20,0,0,0" Tag="LeftPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove">
                                    <native:ConnectionPort.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="-1" ScaleY="1"/>
                                            <TranslateTransform X="20"/>
                                        </TransformGroup>
                                    </native:ConnectionPort.RenderTransform>
                                </native:ConnectionPort>

                                <native:ConnectionPort Style="{StaticResource CanvasPortStyle}" x:Name="RightPort" Index="2" Orientation="Right"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,-20,0" Tag="RightPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove"/>

                                <native:ConnectionPort Style="{StaticResource CanvasPortStyle}" x:Name="TopPort" Index="1" Orientation="Top"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                                       Margin="0,-25,0,0" Tag="TopPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove">
                                    <native:ConnectionPort.RenderTransform>
                                        <RotateTransform Angle="-90" CenterX="10" CenterY="15"/>
                                    </native:ConnectionPort.RenderTransform>
                                </native:ConnectionPort>

                                <native:ConnectionPort Style="{StaticResource CanvasPortStyle}" x:Name="BottomPort" Index="3" Orientation="Bottom"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                       Margin="0,0,0,-25" Tag="BottomPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove">
                                    <native:ConnectionPort.RenderTransform>
                                        <RotateTransform Angle="90" CenterX="10" CenterY="15"/>
                                    </native:ConnectionPort.RenderTransform>
                                </native:ConnectionPort>
                            </Grid>
                        </Grid>
                    </Border>
                    </local:WorkflowNodeView>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsDebugWindowOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="HitAreaBorder" Property="ContextMenu" Value="{x:Null}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 拖拽连接时的临时连接线 -->
        <Path x:Name="TempConnectionLine"
              Style="{DynamicResource TempConnectionLineStyle}"
              Visibility="Collapsed">
            <Path.Data>
                <PathGeometry x:Name="TempConnectionGeometry" />
            </Path.Data>
        </Path>

        <!-- 框选控件 -->
        <common:SelectionBox x:Name="SelectionBox" Canvas.ZIndex="9999"/>

        <!-- 最大外接矩形（用于调试） -->
        <Border x:Name="BoundingRectangle"
                 BorderBrush="#FF0000"
                 BorderThickness="3"
                 Background="Red"
                 CornerRadius="2"
                 Opacity="0.5"
                 Canvas.ZIndex="500"
                 Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
            </Border.Effect>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
