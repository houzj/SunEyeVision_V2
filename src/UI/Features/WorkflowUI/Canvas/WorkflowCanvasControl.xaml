<UserControl x:Class="SunEyeVision.UI.Features.WorkflowUI.Canvas.WorkflowCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters"
             xmlns:convertersPath="clr-namespace:SunEyeVision.UI.Converters.Path"
             xmlns:convertersNode="clr-namespace:SunEyeVision.UI.Converters.Node"
             xmlns:convertersVisibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:convertersWorkflow="clr-namespace:SunEyeVision.UI.Converters.Workflow"
             xmlns:common="clr-namespace:SunEyeVision.UI.Shell.Controls.Common"
             xmlns:rendering="clr-namespace:SunEyeVision.UI.Services.Rendering"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <convertersPath:SmartPathConverter x:Key="SmartPathConverter"/>
        <convertersPath:SmartPathMultiConverter x:Key="SmartPathMultiConverter"/>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convertersPath:PointOffsetConverter x:Key="PointOffsetConverter"/>
        <converters:PointCenterToOffsetConverter x:Key="PointCenterToOffsetConverter"/>

        <!-- 使用缓存的节点转换器（性能优化） -->
        <rendering:CachedNodeBackgroundConverter x:Key="NodeBackgroundColorConverter"/>
        <rendering:CachedNodeBorderConverter x:Key="NodeBorderColorConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <!-- 箭头标记 - 尖端指向右侧（度的方向），方便旋转 -->
        <!-- 箭头长度与 BezierPathCalculator.ArrowLength 保持一致（15px） -->
        <PathGeometry x:Key="ArrowGeometry">
            <PathFigure StartPoint="0,0">
                <LineSegment Point="-15,-8" />
                <LineSegment Point="-15,8" />
                <LineSegment Point="0,0" />
            </PathFigure>
        </PathGeometry>

        <!-- 箭头填充颜色 -->
        <SolidColorBrush x:Key="ArrowBrush" Color="#666666"/>

        <!-- 节点背景样式（保留用于转换器） -->
        <SolidColorBrush x:Key="NodeBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NodeHeaderBackground" Color="#0066CC"/>
        <SolidColorBrush x:Key="NodeFooterBackground" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="NodeTextForeground" Color="#0066CC"/>
        <convertersWorkflow:NodeIconStatusBackgroundConverter x:Key="NodeIconStatusBackgroundConverter"/>
        <convertersWorkflow:NodeIconStatusForegroundConverter x:Key="NodeIconStatusForegroundConverter"/>
        <SolidColorBrush x:Key="NodeTimeForeground" Color="#666666"/>
        <SolidColorBrush x:Key="NodeBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="NodeBorderBrushSelected" Color="#0066CC"/>
    </UserControl.Resources>

    <!-- 主容器 -->
    <Grid x:Name="MainGrid">
        <!-- 原有的 WorkflowCanvas -->
        <Canvas x:Name="WorkflowCanvas"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="WorkflowCanvas_DragEnter"
                DragOver="WorkflowCanvas_DragOver"
                DragLeave="WorkflowCanvas_DragLeave"
                Drop="WorkflowCanvas_Drop"
                PreviewMouseLeftButtonDown="WorkflowCanvas_PreviewMouseLeftButtonDown"
                PreviewMouseMove="WorkflowCanvas_PreviewMouseMove"
                PreviewMouseLeftButtonUp="WorkflowCanvas_PreviewMouseLeftButtonUp"
                GotFocus="WorkflowCanvas_GotFocus"
                LostFocus="WorkflowCanvas_LostFocus">

        <!-- 棋盘格背景：整体 DrawingBrush（随主题整体替换），DynamicResource 只留在元素属性层，避免 Drawing 冻结导致内部引用失效 -->
        <Canvas.Background>
            <DynamicResource ResourceKey="{x:Static base:ThemeKeys.CheckerboardBackgroundBrush}"/>
        </Canvas.Background>

        <!-- 连接线 - 使用智能直角折线 -->
        <ItemsControl ItemsSource="{Binding WorkflowConnections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Canvas.ZIndex" Value="1000"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Canvas>
                        <!-- 连接线 - 仅视觉显示层，不参与命中测试 -->
                        <Path Loaded="Path_Loaded"
                              IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{Binding StatusColor}"/>
                                    <Setter Property="StrokeThickness" Value="2"/>
                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Stroke" Value="#0066CC"/>
                                            <Setter Property="StrokeThickness" Value="2.5"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#0066CC" BlurRadius="4" ShadowDepth="0" Opacity="0.6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="#FF6600"/>
                                            <Setter Property="StrokeThickness" Value="3"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF6600" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <!-- 透明宽命中线 - 始终透明，仅负责点击选中交互 -->
                        <Path Stroke="Transparent" StrokeThickness="14" Fill="Transparent"
                              Cursor="Hand"
                              MouseEnter="ConnectionHitArea_MouseEnter"
                              MouseLeave="ConnectionHitArea_MouseLeave"
                              MouseLeftButtonDown="ConnectionHitArea_MouseLeftButtonDown">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 连接线拐点（中间点）标记 -->
                        <ItemsControl ItemsSource="{Binding PathPoints, Mode=OneWay}"
                                      Visibility="{Binding ShowPathPoints, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#FF6600"
                                                 Stroke="#FFFFFF"
                                                 StrokeThickness="1"
                                                 Opacity="0.7"
                                                 Canvas.Left="{Binding X, Converter={StaticResource PointOffsetConverter}, ConverterParameter=-4}"
                                                 Canvas.Top="{Binding Y, Converter={StaticResource PointOffsetConverter}, ConverterParameter=-4}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 箭头（颜色跟随连线状态：悬停蓝、选中橙，其余跟随 StatusColor） -->
                        <Path Data="{StaticResource ArrowGeometry}"
                              Canvas.Left="{Binding ArrowX}"
                              Canvas.Top="{Binding ArrowY}"
                              RenderTransformOrigin="0,0"
                              Loaded="ArrowPath_Loaded"
                              x:Name="ArrowPath">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{Binding StatusColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Fill" Value="#0066CC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Fill" Value="#FF6600"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 节点 -->
        <ItemsControl ItemsSource="{Binding WorkflowNodes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
        <!-- Position表示HitArea中心点，Canvas.Left/Top需要左上角坐标 -->
        <!-- 左上角 = 中心点 - (HitAreaWidth/2, HitAreaHeight/2) -->
        <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointCenterToOffsetConverter}, ConverterParameter=-80, Mode=OneWay}"/>
        <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointCenterToOffsetConverter}, ConverterParameter=-28, Mode=OneWay}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- HitArea Border: 用于命中测试，Position表示其中心点 -->
                    <Border Width="{DynamicResource HitAreaWidth}" Height="{DynamicResource HitAreaHeight}"
                            Background="Transparent"
                            Tag="{Binding}"
                            x:Name="HitAreaBorder">
                        <Border.ContextMenu>
                            <ContextMenu Background="#FFFFFFFF"
                                         BorderBrush="#FFCCCCCC"
                                         BorderThickness="1" Padding="4">
                                <MenuItem Header="重命名" Click="NodeContextMenu_Rename_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <!-- NodeGlowBorder: 状态辉光装饰层。Effect 只挂在无内容层上，
                                 避免 NodeBorder 挂 DropShadowEffect 时把图标/文字子树位图化重绘导致模糊 -->
                            <Border x:Name="NodeGlowBorder"
                                    Width="{DynamicResource NodeWidth}" Height="{DynamicResource NodeHeight}"
                                    CornerRadius="{DynamicResource NodeCornerRadius}"
                                    Background="Transparent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <!-- 选中：橙色发光（原挂在 NodeBorder 上，效果层含文字/图标 → 模糊；移至独立装饰层） -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF6600" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- 悬停：轻柔阴影提升（NodeGlow 不拦截命中，跟随 NodeBorder 的真实 IsMouseOver） -->
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=NodeBorder}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- NodeBorder: 视觉显示元素，居中于HitArea -->
                            <Border Width="{DynamicResource NodeWidth}" Height="{DynamicResource NodeHeight}"
                                    CornerRadius="{DynamicResource NodeCornerRadius}"
                                    BorderThickness="1.5"
                                    BorderBrush="{Binding IsSelected, Converter={StaticResource NodeBorderColorConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                    MouseMove="Node_MouseMove"
                                    Tag="{Binding}"
                                    x:Name="NodeBorder">
                                <Border.Background>
                                    <Binding Converter="{StaticResource NodeBackgroundColorConverter}"/>
                                </Border.Background>
                                <Grid>
                                    <!-- 虚线选中装饰层：与 Border 同尺寸，仅选中时可见 -->
                                    <Rectangle RadiusX="{DynamicResource NodeCornerRadiusDouble}" RadiusY="{DynamicResource NodeCornerRadiusDouble}"
                                               Stroke="{DynamicResource NodeSelectedDashBrush}" StrokeThickness="1.5"
                                               StrokeDashArray="6,3"
                                               Fill="Transparent"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- 节点内容 -->
                            <Grid Margin="{DynamicResource NodeContentMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 节点类型图标（非子程序）/ 子程序设置按钮；方案 §6 五态：状态色块 + 图标重叠 -->
                                <Grid Grid.Column="0" Width="30">
                                    <!-- 状态色块：撑满第一列全高，左圆角对齐节点外框（Margin 负值盖过 1.5px 边框实现无缝贴合） -->
                                    <Border CornerRadius="6,0,0,6"
                                            Margin="-1.5,0,0,0"
                                            Background="{Binding Status, Converter={StaticResource NodeIconStatusBackgroundConverter}}"/>

                                    <!-- 图标叠上居中；状态时反白；对子程序节点隐藏 -->
                                    <TextBlock Text="{Binding Icon}"
                                               Foreground="{Binding Status, Converter={StaticResource NodeIconStatusForegroundConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NodeIconStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToolType}" Value="Subroutine">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 子程序设置按钮（仅 Subroutine 类型节点可见，替换图标显示）
                                         治本：原 Content="{Binding Icon}" (emoji 🔁 U+1F501) 走 Segoe UI Emoji 字体路径，
                                         Foreground 主题色对 emoji 无效 + emoji 自带紫色在浅色卡片背景上对比度低 →
                                         暗色主题下肉眼不可见（用户实测截图）。改用 ⚙ (U+2699 BLACK GEAR)：
                                         1. 标准几何符号，显式指定 IconFontFamily(Segoe UI Symbol) 必含该字形，
                                            主字体路径渲染（不走 emoji 字体），不依赖 WPF 字体回退链
                                         2. 纯黑白字形，Foreground 完全可控，亮/暗主题都清晰可见
                                         3. 与本控件"返回"按钮(↩ U+21A9)设计语言一致 -->
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Width="24" Height="24"
                                            Cursor="Hand"
                                            ToolTip="子程序参数设置"
                                            Click="SubroutineNodeSettings_Click"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Panel.ZIndex="10">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- 背景恒透明：悬停/按下不出现背景色块（避免与状态色块混色出杂色）。
                                                     点击热区=按钮自身 24x24。 -->
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <!-- 齿轮前景全部在 TextBlock.Style 内控制（Setter+Triggers），不依赖 Binding Setter：
                                             ★ 基础色跟随节点运行状态(与普通类型图标同一转换器的色值)：
                                               待运行→#333333(浅卡片可见)；运行中/成功/失败/跳过→白色(on实色状态色块)。
                                             ★ 悬停变主题蓝提示可点(按钮语义)。Style Trigger 优先级>Style Setter，
                                               且悬停 Trigger 放最后 → 悬停时覆盖状态色。 -->
                                        <TextBlock Text="&#x2699;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="{DynamicResource NodeIconFontSize}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF333333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="运行中">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="成功">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="失败">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NG">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="跳过">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <!-- 悬停变节点端口同款悬停色(橙 #FF6600)：与端口交互反馈一致，
                                                             且橙在绿/蓝/红/灰/浅底上都足够明显。放最后，覆盖状态色 -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PortHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToolType}" Value="Subroutine">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 全局序号 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GlobalIndex, StringFormat='{}{0}'}"
                                           Style="{DynamicResource NodeGlobalIndexStyle}"
                                           Margin="4,0,8,0"
                                           Visibility="Visible"/>

                                <!-- 节点显示名称（重命名时切换到编辑框） -->
                                <Grid Grid.Column="2">
                                    <TextBlock Text="{Binding DispName}"
                                               x:Name="NodeNameText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NodeTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                             Background="White"
                                             BorderBrush="#FF6600"
                                             BorderThickness="1"
                                             Padding="2,0"
                                             MinWidth="40"
                                             FontSize="{DynamicResource NodeFontSize}"
                                             FontWeight="Medium"
                                             VerticalAlignment="Center"
                                             x:Name="NodeNameEditor"
                                             KeyDown="NodeRenameTextBox_KeyDown"
                                             LostFocus="NodeRenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Grid>

                            <!-- 连接点 - 上 -->
                            <Ellipse Name="TopPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,-10,0,0"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="TopPort"
                                     Visibility="Collapsed"/>

                            <!-- 连接点 - 下 -->
                            <Ellipse Name="BottomPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,-10"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="BottomPort"
                                     Visibility="Collapsed"/>

                            <!-- 连接点 - 左 -->
                            <Ellipse Name="LeftPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="-10,0,0,0"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="LeftPort"
                                     Visibility="Collapsed"/>

                            <!-- 连接点 - 右 -->
                            <Ellipse Name="RightPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0,0,-10,0"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="RightPort"
                                     Visibility="Collapsed"/>


                        </Grid>

                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Effect 已移至 NodeGlowBorder 装饰层（选中/悬停辉光），避免内容子树位图化导致文字/图标模糊 -->
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Style>
                        </Border.Style>
                    </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 拖拽连接时的临时连接线 -->
        <Path x:Name="TempConnectionLine"
              Style="{DynamicResource TempConnectionLineStyle}"
              Visibility="Collapsed">
            <Path.Data>
                <PathGeometry x:Name="TempConnectionGeometry" />
            </Path.Data>
        </Path>

        <!-- 框选控件 -->
        <common:SelectionBox x:Name="SelectionBox" Canvas.ZIndex="9999"/>

        <!-- 最大外接矩形（用于调试） -->
        <Border x:Name="BoundingRectangle"
                 BorderBrush="#FF0000"
                 BorderThickness="3"
                 Background="Red"
                 CornerRadius="2"
                 Opacity="0.5"
                 Canvas.ZIndex="500"
                 Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
            </Border.Effect>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
