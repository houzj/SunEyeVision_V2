<UserControl x:Class="SunEyeVision.UI.Features.WorkflowUI.Canvas.WorkflowCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters"
             xmlns:convertersPath="clr-namespace:SunEyeVision.UI.Converters.Path"
             xmlns:convertersNode="clr-namespace:SunEyeVision.UI.Converters.Node"
             xmlns:convertersVisibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:convertersWorkflow="clr-namespace:SunEyeVision.UI.Converters.Workflow"
             xmlns:common="clr-namespace:SunEyeVision.UI.Shell.Controls.Common"
             xmlns:rendering="clr-namespace:SunEyeVision.UI.Services.Rendering"
             xmlns:native="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.WorkspaceControls.Base;assembly=SunEyeVision.Plugin.Wpf"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             xmlns:local="clr-namespace:SunEyeVision.UI.Features.WorkflowUI.Canvas"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Styles/NodeStyleResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <convertersPath:SmartPathConverter x:Key="SmartPathConverter"/>
        <convertersPath:SmartPathMultiConverter x:Key="SmartPathMultiConverter"/>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convertersPath:CoordinateOffsetConverter x:Key="CoordinateOffsetConverter"/>
        <converters:PointCenterToOffsetConverter x:Key="PointCenterToOffsetConverter"/>
        <convertersNode:ToolNodeIconConverter x:Key="ToolNodeIcon"/>
        <convertersNode:GroupNodeBackgroundConverter x:Key="GroupNodeBackground"/>

        <!-- 使用缓存的节点转换器（性能优化） -->
        <rendering:CachedNodeBackgroundConverter x:Key="NodeBackgroundColorConverter"/>
        <rendering:CachedNodeBorderConverter x:Key="NodeBorderColorConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <!-- 箭头标记 - 尖端指向右侧（度的方向），方便旋转 -->
        <!-- 箭头长度与 BezierPathCalculator.ArrowLength 保持一致（15px） -->
        <PathGeometry x:Key="ArrowGeometry" Figures="M -6,-5 L 2,0 L -6,5 Z"/>

        <!-- 箭头填充颜色 -->
        <SolidColorBrush x:Key="ArrowBrush" Color="#FFA70F"/>

        <!-- 节点背景样式（保留用于转换器） -->
        <SolidColorBrush x:Key="NodeBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NodeHeaderBackground" Color="#0066CC"/>
        <SolidColorBrush x:Key="NodeFooterBackground" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="NodeTextForeground" Color="#0066CC"/>
        <convertersWorkflow:NodeIconStatusBackgroundConverter x:Key="NodeIconStatusBackgroundConverter"/>
        <convertersWorkflow:NodeIconStatusForegroundConverter x:Key="NodeIconStatusForegroundConverter"/>
        <SolidColorBrush x:Key="NodeTimeForeground" Color="#666666"/>
        <SolidColorBrush x:Key="NodeBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="NodeBorderBrushSelected" Color="#0066CC"/>
      </ResourceDictionary>
    </UserControl.Resources>

    <!-- 主容器 -->
    <Grid x:Name="MainGrid">
        <!-- 原有的 WorkflowCanvas -->
        <Canvas x:Name="WorkflowCanvas"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="WorkflowCanvas_DragEnter"
                DragOver="WorkflowCanvas_DragOver"
                DragLeave="WorkflowCanvas_DragLeave"
                Drop="WorkflowCanvas_Drop"
                PreviewMouseLeftButtonDown="WorkflowCanvas_PreviewMouseLeftButtonDown"
                PreviewMouseMove="WorkflowCanvas_PreviewMouseMove"
                PreviewMouseLeftButtonUp="WorkflowCanvas_PreviewMouseLeftButtonUp"
                GotFocus="WorkflowCanvas_GotFocus"
                LostFocus="WorkflowCanvas_LostFocus">

        <!-- 原VM DiagramPage的6像素线网背景，随主题整体替换。 -->
        <Canvas.Background>
            <DynamicResource ResourceKey="{x:Static base:ThemeKeys.WorkflowCanvasGridBrush}"/>
        </Canvas.Background>

        <!-- 连接线 - 使用智能直角折线 -->
        <ItemsControl ItemsSource="{Binding DocumentCanvas.Connections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Canvas.ZIndex" Value="1000"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Canvas>
                        <!-- 连接线 - 仅视觉显示层，不参与命中测试 -->
                        <Path Loaded="Path_Loaded"
                              IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="#FFA70F"/>
                                    <Setter Property="StrokeThickness" Value="2"/>
                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Stroke" Value="#E76900"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="#E76900"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <!-- 透明宽命中线 - 始终透明，仅负责点击选中交互 -->
                        <Path Stroke="Transparent" StrokeThickness="2"
                              Cursor="Hand"
                              MouseEnter="ConnectionHitArea_MouseEnter"
                              MouseLeave="ConnectionHitArea_MouseLeave"
                              Focusable="True" MouseLeftButtonDown="ConnectionHitArea_MouseLeftButtonDown" MouseRightButtonDown="ConnectionHitArea_MouseRightButtonDown">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 连接线拐点（中间点）标记 -->
                        <ItemsControl ItemsSource="{Binding PathPoints, Mode=OneWay}"
                                      Visibility="{Binding ShowPathPoints, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#FF6600"
                                                 Stroke="#FFFFFF"
                                                 StrokeThickness="1"
                                                 Opacity="0.7"
                                                 Canvas.Left="{Binding X, Converter={StaticResource CoordinateOffsetConverter}, ConverterParameter=-4}"
                                                 Canvas.Top="{Binding Y, Converter={StaticResource CoordinateOffsetConverter}, ConverterParameter=-4}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 箭头（颜色跟随连线状态：悬停蓝、选中橙，其余跟随 StatusColor） -->
                        <Path Data="{StaticResource ArrowGeometry}"
                              Canvas.Left="{Binding ArrowX}"
                              Canvas.Top="{Binding ArrowY}"
                              RenderTransformOrigin="0,0"
                              x:Name="ArrowPath">
                            <Path.RenderTransform><RotateTransform Angle="{Binding ArrowAngle}"/></Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#FFA70F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Fill" Value="#E76900"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Fill" Value="#E76900"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 节点 -->
        <ItemsControl x:Name="CanvasNodeItems" ItemsSource="{Binding DocumentCanvas.Nodes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
        <!-- Position表示HitArea中心点，Canvas.Left/Top需要左上角坐标 -->
        <!-- 左上角 = 中心点 - (HitAreaWidth/2, HitAreaHeight/2) -->
        <Setter Property="Canvas.Left" Value="{Binding HitAreaLeft, Mode=OneWay}"/>
        <Setter Property="Canvas.Top" Value="{Binding HitAreaTop, Mode=OneWay}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 节点视图宿主：对应原件 DiagramItem，命中状态由控件自身维护，端口可见性跟随它 -->
                    <local:WorkflowNodeView>
                    <!-- HitArea Border: 用于命中测试，Position表示其中心点 -->
                    <Border Width="{Binding HitAreaWidth}" Height="{Binding HitAreaHeight}"
                            Background="Transparent"
                            Tag="{Binding}"
                            x:Name="HitAreaBorder"
                            MouseLeftButtonDown="Node_MouseLeftButtonDown"
                            MouseLeftButtonUp="Node_MouseLeftButtonUp"
                            MouseMove="Node_MouseMove">
                        <Border.ContextMenu>
                            <ContextMenu Background="#FFFFFFFF"
                                         BorderBrush="#FFCCCCCC"
                                         BorderThickness="1" Padding="4">
                                <!-- 菜单项与顺序对齐原件：断开连接 / 删除 / 复制 / 重命名 / 禁用 / 启用 -->
                                <MenuItem Header="断开连接" Click="NodeContextMenu_Disconnect_Click"/>
                                <MenuItem Header="删除" Click="NodeContextMenu_Delete_Click"/>
                                <MenuItem Header="复制" Click="NodeContextMenu_Copy_Click"/>
                                <MenuItem Header="重命名" Click="NodeContextMenu_Rename_Click"/>
                                <MenuItem Header="禁用" Click="NodeContextMenu_ToggleEnabled_Click">
                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="启用" Click="NodeContextMenu_ToggleEnabled_Click">
                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <!-- GROUP循环装饰：原件GroupCirculationBackground，围绕110×40卡片外扩5。 -->
                            <Grid x:Name="GroupLoopOverlay" Width="120" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGroupLoopEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.Resources><Style x:Key="GroupLoopArrow" TargetType="Image"><Setter Property="Stretch" Value="None"/><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_cycle_right.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_cycle_right_disable.png"/></DataTrigger></Style.Triggers></Style></Grid.Resources>
                                <Border BorderBrush="#66F9F5F2" BorderThickness="2" CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.08"><GradientStop Color="#19F6F6F6" Offset="0"/><GradientStop Color="#33F3F3F3" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect Color="Black" ShadowDepth="3" Opacity="0.5"/></Border.Effect></Border>
                                <Image Margin="0,-4,0,0" VerticalAlignment="Top" Style="{StaticResource GroupLoopArrow}"/>
                                <Image Margin="0,0,0,-4" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{StaticResource GroupLoopArrow}"><Image.RenderTransform><RotateTransform Angle="180"/></Image.RenderTransform></Image>
                                <Image Margin="-3,0,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Style="{StaticResource GroupLoopArrow}"><Image.RenderTransform><RotateTransform Angle="-90"/></Image.RenderTransform></Image>
                                <Image Margin="0,0,-3,0" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5" Style="{StaticResource GroupLoopArrow}"><Image.RenderTransform><RotateTransform Angle="90"/></Image.RenderTransform></Image>
                            </Grid>
                            <!-- NodeBorder: 视觉显示元素，居中于HitArea -->
                            <Border Width="{Binding VisualWidth}" Height="{Binding VisualHeight}"

                                    BorderBrush="{Binding IsSelected, Converter={StaticResource NodeBorderColorConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"



                                    Tag="{Binding}"
                                    x:Name="NodeBorder">

                                <Grid>
                            <!-- 节点内容 -->
                            <Grid Margin="{DynamicResource NodeContentMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 节点类型图标（非子程序）/ 子程序设置按钮；方案 §6 五态：状态色块 + 图标重叠 -->
                                <Grid Grid.Column="0">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Width" Value="24"/><Style.Triggers><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Width" Value="31"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <!-- 图标叠上居中；状态时反白；对子程序节点隐藏 -->
                                    <Image Source="{Binding Converter={StaticResource ToolNodeIcon}}" Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubroutineNode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- 原GROUP参数按钮：24px原图、左边距7，标题不显示全局ID。 -->
                                    <Button x:Name="GroupSettingsButton" Width="24" Height="24" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" ToolTip="子程序参数设置" Click="SubroutineNodeSettings_Click">
                                        <Button.Template><ControlTemplate TargetType="Button">
                                            <Image x:Name="GroupSettingsImage" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_normal.png"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GroupSettingsImage" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_click.png"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="GroupSettingsImage" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_disable.png"/></Trigger>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter TargetName="GroupSettingsImage" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_group_configuration_disable.png"/></DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Button.Template>
                                        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 全局序号 -->
                                <TextBlock Grid.Column="1" x:Name="NodeIndexText"
                                           Text="{Binding GlobalIndex, StringFormat='{}{0}'}"
                                           Margin="0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource NodeGlobalIndexStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsToolboxPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>

                                <!-- 节点显示名称（重命名时切换到编辑框） -->
                                <Grid Grid.Column="2">
                                    <TextBlock Text="{Binding DispName}" FontWeight="Bold" Foreground="#373A3C" HorizontalAlignment="Center"
                                               x:Name="NodeNameText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NodeTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox MaxLength="64" Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                             Background="White"
                                             BorderBrush="#FF6600"
                                             BorderThickness="1"
                                             Padding="2,0"
                                             MinWidth="40"
                                             FontSize="{DynamicResource NodeFontSize}"
                                             FontWeight="Bold"
                                             VerticalAlignment="Center"
                                             x:Name="NodeNameEditor"
                                             KeyDown="NodeRenameTextBox_KeyDown"
                                             LostFocus="NodeRenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Grid>




                        </Grid>

                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- 原件 NORMAL 节点填充：浅色四段渐变 + 底部橙色收边 -->
                                <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FAF7F5" Offset="0"/><GradientStop Color="#F3F6F5" Offset="0.47"/><GradientStop Color="#ECEDF0" Offset="0.82"/><GradientStop Color="#EBE6E2" Offset="0.97"/><GradientStop Color="#EB6600" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                                <Setter Property="BorderBrush" Value="#66F9F5F2"/>
                                <Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="4"/>
                                <!-- Effect 已移至 NodeGlowBorder 装饰层（选中/悬停辉光），避免内容子树位图化导致文字/图标模糊 -->
                                <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="3" Opacity="0.45" Color="#FF121111"/></Setter.Value></Setter>

                            <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D3D3D3F5" Offset="0"/><GradientStop Color="#D3D3D3E1" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderThickness" Value="2"/></DataTrigger><DataTrigger Binding="{Binding NodeDisplayType}" Value="IMAGE"><Setter Property="CornerRadius" Value="15"/></DataTrigger><DataTrigger Binding="{Binding IsSubroutineNode}" Value="True">
                                    <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource GroupNodeBackground}"><Binding Path="IsEnabled"/><Binding Path="IsSelected"/><Binding Path="Status"/></MultiBinding></Setter.Value></Setter>
                                </DataTrigger>
                            </Style.Triggers></Style>
                        </Border.Style>
                    </Border>
                            <!-- 连接端口：原件 Connector 规格（20×30 命中区、5×8 橙条、命中放大 8.5×12），节点悬停时四个方位常驻显示 -->
                            <Grid x:Name="PortLayer"
                                  Width="{Binding VisualWidth}" Height="{Binding VisualHeight}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <!-- 端口显隐跟随节点级悬停状态（对应原件 DiagramItem.IsHited），不再依赖 ElementName 绑定在模板内的解析时机 -->
                                            <DataTrigger Binding="{Binding IsHited, RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowNodeView}}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <native:ConnectionPort x:Name="LeftPort" Index="0" Orientation="Left"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Margin="-20,0,0,0" Tag="LeftPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove">
                                    <native:ConnectionPort.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="-1" ScaleY="1"/>
                                            <TranslateTransform X="20"/>
                                        </TransformGroup>
                                    </native:ConnectionPort.RenderTransform>
                                </native:ConnectionPort>

                                <native:ConnectionPort x:Name="RightPort" Index="2" Orientation="Right"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,-20,0" Tag="RightPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove"/>

                                <native:ConnectionPort x:Name="TopPort" Index="1" Orientation="Top"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                                       Margin="0,-25,0,0" Tag="TopPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove">
                                    <native:ConnectionPort.RenderTransform>
                                        <RotateTransform Angle="-90" CenterX="10" CenterY="15"/>
                                    </native:ConnectionPort.RenderTransform>
                                </native:ConnectionPort>

                                <native:ConnectionPort x:Name="BottomPort" Index="3" Orientation="Bottom"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                       Margin="0,0,0,-25" Tag="BottomPort"
                                                       MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                                       MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                                       MouseMove="Port_MouseMove">
                                    <native:ConnectionPort.RenderTransform>
                                        <RotateTransform Angle="90" CenterX="10" CenterY="15"/>
                                    </native:ConnectionPort.RenderTransform>
                                </native:ConnectionPort>
                            </Grid>
                        </Grid>
                    </Border>
                    </local:WorkflowNodeView>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 拖拽连接时的临时连接线 -->
        <Path x:Name="TempConnectionLine"
              Style="{DynamicResource TempConnectionLineStyle}"
              Visibility="Collapsed">
            <Path.Data>
                <PathGeometry x:Name="TempConnectionGeometry" />
            </Path.Data>
        </Path>

        <!-- 框选控件 -->
        <common:SelectionBox x:Name="SelectionBox" Canvas.ZIndex="9999"/>

        <!-- 最大外接矩形（用于调试） -->
        <Border x:Name="BoundingRectangle"
                 BorderBrush="#FF0000"
                 BorderThickness="3"
                 Background="Red"
                 CornerRadius="2"
                 Opacity="0.5"
                 Canvas.ZIndex="500"
                 Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
            </Border.Effect>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
