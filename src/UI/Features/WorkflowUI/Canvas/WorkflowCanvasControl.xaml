<UserControl x:Class="SunEyeVision.UI.Features.WorkflowUI.Canvas.WorkflowCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters"
             xmlns:convertersPath="clr-namespace:SunEyeVision.UI.Converters.Path"
             xmlns:convertersNode="clr-namespace:SunEyeVision.UI.Converters.Node"
             xmlns:convertersVisibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:convertersWorkflow="clr-namespace:SunEyeVision.UI.Converters.Workflow"
             xmlns:common="clr-namespace:SunEyeVision.UI.Shell.Controls.Common"
             xmlns:rendering="clr-namespace:SunEyeVision.UI.Services.Rendering"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             xmlns:icons="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Icons;assembly=SunEyeVision.Plugin.SDK"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Styles/NodeStyleResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <convertersPath:SmartPathConverter x:Key="SmartPathConverter"/>
        <convertersPath:SmartPathMultiConverter x:Key="SmartPathMultiConverter"/>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convertersPath:PointOffsetConverter x:Key="PointOffsetConverter"/>
        <converters:PointCenterToOffsetConverter x:Key="PointCenterToOffsetConverter"/>
        <convertersNode:VmNodeIconConverter x:Key="VmNodeIcon"/>

        <!-- 使用缓存的节点转换器（性能优化） -->
        <rendering:CachedNodeBackgroundConverter x:Key="NodeBackgroundColorConverter"/>
        <rendering:CachedNodeBorderConverter x:Key="NodeBorderColorConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <!-- 箭头标记 - 尖端指向右侧（度的方向），方便旋转 -->
        <!-- 箭头长度与 BezierPathCalculator.ArrowLength 保持一致（15px） -->
        <PathGeometry x:Key="ArrowGeometry" Figures="M -6,-5 L 2,0 L -6,5 Z"/>

        <!-- 箭头填充颜色 -->
        <SolidColorBrush x:Key="ArrowBrush" Color="#666666"/>

        <!-- 节点背景样式（保留用于转换器） -->
        <SolidColorBrush x:Key="NodeBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NodeHeaderBackground" Color="#0066CC"/>
        <SolidColorBrush x:Key="NodeFooterBackground" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="NodeTextForeground" Color="#0066CC"/>
        <convertersWorkflow:NodeIconStatusBackgroundConverter x:Key="NodeIconStatusBackgroundConverter"/>
        <convertersWorkflow:NodeIconStatusForegroundConverter x:Key="NodeIconStatusForegroundConverter"/>
        <SolidColorBrush x:Key="NodeTimeForeground" Color="#666666"/>
        <SolidColorBrush x:Key="NodeBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="NodeBorderBrushSelected" Color="#0066CC"/>
      </ResourceDictionary>
    </UserControl.Resources>

    <!-- 主容器 -->
    <Grid x:Name="MainGrid">
        <!-- 原有的 WorkflowCanvas -->
        <Canvas x:Name="WorkflowCanvas"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="WorkflowCanvas_DragEnter"
                DragOver="WorkflowCanvas_DragOver"
                DragLeave="WorkflowCanvas_DragLeave"
                Drop="WorkflowCanvas_Drop"
                PreviewMouseLeftButtonDown="WorkflowCanvas_PreviewMouseLeftButtonDown"
                PreviewMouseMove="WorkflowCanvas_PreviewMouseMove"
                PreviewMouseLeftButtonUp="WorkflowCanvas_PreviewMouseLeftButtonUp"
                GotFocus="WorkflowCanvas_GotFocus"
                LostFocus="WorkflowCanvas_LostFocus">

        <!-- 棋盘格背景：整体 DrawingBrush（随主题整体替换），DynamicResource 只留在元素属性层，避免 Drawing 冻结导致内部引用失效 -->
        <Canvas.Background>
            <DynamicResource ResourceKey="{x:Static base:ThemeKeys.CheckerboardBackgroundBrush}"/>
        </Canvas.Background>

        <!-- 连接线 - 使用智能直角折线 -->
        <ItemsControl ItemsSource="{Binding WorkflowConnections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Canvas.ZIndex" Value="1000"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Canvas>
                        <!-- 连接线 - 仅视觉显示层，不参与命中测试 -->
                        <Path Loaded="Path_Loaded"
                              IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="#FFA70F"/>
                                    <Setter Property="StrokeThickness" Value="2"/>
                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Stroke" Value="#E76900"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="#E76900"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <!-- 透明宽命中线 - 始终透明，仅负责点击选中交互 -->
                        <Path Stroke="Transparent" StrokeThickness="2"
                              Cursor="Hand"
                              MouseEnter="ConnectionHitArea_MouseEnter"
                              MouseLeave="ConnectionHitArea_MouseLeave"
                              Focusable="True" MouseLeftButtonDown="ConnectionHitArea_MouseLeftButtonDown">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SmartPathMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PathUpdateCounter"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 连接线拐点（中间点）标记 -->
                        <ItemsControl ItemsSource="{Binding PathPoints, Mode=OneWay}"
                                      Visibility="{Binding ShowPathPoints, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#FF6600"
                                                 Stroke="#FFFFFF"
                                                 StrokeThickness="1"
                                                 Opacity="0.7"
                                                 Canvas.Left="{Binding X, Converter={StaticResource PointOffsetConverter}, ConverterParameter=-4}"
                                                 Canvas.Top="{Binding Y, Converter={StaticResource PointOffsetConverter}, ConverterParameter=-4}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 箭头（颜色跟随连线状态：悬停蓝、选中橙，其余跟随 StatusColor） -->
                        <Path Data="{StaticResource ArrowGeometry}"
                              Canvas.Left="{Binding ArrowX}"
                              Canvas.Top="{Binding ArrowY}"
                              RenderTransformOrigin="0,0"
                              x:Name="ArrowPath">
                            <Path.RenderTransform><RotateTransform Angle="{Binding ArrowAngle}"/></Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#FFA70F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Fill" Value="#E76900"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Fill" Value="#E76900"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 节点 -->
        <ItemsControl ItemsSource="{Binding WorkflowNodes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
        <!-- Position表示HitArea中心点，Canvas.Left/Top需要左上角坐标 -->
        <!-- 左上角 = 中心点 - (HitAreaWidth/2, HitAreaHeight/2) -->
        <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointCenterToOffsetConverter}, ConverterParameter=-65, Mode=OneWay}"/>
        <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointCenterToOffsetConverter}, ConverterParameter=-25, Mode=OneWay}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- HitArea Border: 用于命中测试，Position表示其中心点 -->
                    <Border Width="{DynamicResource HitAreaWidth}" Height="{DynamicResource HitAreaHeight}"
                            Background="Transparent"
                            Tag="{Binding}"
                            x:Name="HitAreaBorder">
                        <Border.ContextMenu>
                            <ContextMenu Background="#FFFFFFFF"
                                         BorderBrush="#FFCCCCCC"
                                         BorderThickness="1" Padding="4">
                                <MenuItem Header="重命名" Click="NodeContextMenu_Rename_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <!-- NodeBorder: 视觉显示元素，居中于HitArea -->
                            <Border Width="{DynamicResource NodeWidth}" Height="{DynamicResource NodeHeight}"

                                    BorderBrush="{Binding IsSelected, Converter={StaticResource NodeBorderColorConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                    MouseMove="Node_MouseMove"
                                    Tag="{Binding}"
                                    x:Name="NodeBorder">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FAF7F5" Offset="0"/><GradientStop Color="#EBE6E2" Offset="1"/></LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                            <!-- 节点内容 -->
                            <Grid Margin="{DynamicResource NodeContentMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 节点类型图标（非子程序）/ 子程序设置按钮；方案 §6 五态：状态色块 + 图标重叠 -->
                                <Grid Grid.Column="0" Width="24">
                                    <!-- 图标叠上居中；状态时反白；对子程序节点隐藏 -->
                                    <Image Source="{Binding ToolType, Converter={StaticResource VmNodeIcon}}" Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"/>

                                    <!-- 子程序沿用同一语义矢量图标，保留参数设置点击入口。 -->
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Width="24" Height="24"
                                            Cursor="Hand"
                                            ToolTip="子程序参数设置"
                                            Click="SubroutineNodeSettings_Click"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Panel.ZIndex="10">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- 背景恒透明：悬停/按下不出现背景色块（避免与状态色块混色出杂色）。
                                                     点击热区=按钮自身 24x24。 -->
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <!-- 矢量图标前景在 Style 中控制，状态与点击悬停语义保持不变：
                                             ★ 基础色跟随节点运行状态(与普通类型图标同一转换器的色值)：
                                               待运行→#333333(浅卡片可见)；运行中/成功/失败/跳过→白色(on实色状态色块)。
                                             ★ 悬停变主题蓝提示可点(按钮语义)。Style Trigger 优先级>Style Setter，
                                               且悬停 Trigger 放最后 → 悬停时覆盖状态色。 -->
                                        <icons:ToolIcon Key="{Binding Icon}" Width="16" Height="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <icons:ToolIcon.Style>
                                                <Style TargetType="icons:ToolIcon">
                                                    <Setter Property="Foreground" Value="#FF333333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="运行中">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="成功">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="失败">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NG">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="跳过">
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                        <!-- 悬停变节点端口同款悬停色(橙 #FF6600)：与端口交互反馈一致，
                                                             且橙在绿/蓝/红/灰/浅底上都足够明显。放最后，覆盖状态色 -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PortHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </icons:ToolIcon.Style>
                                        </icons:ToolIcon>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToolType}" Value="Subroutine">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 全局序号 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GlobalIndex, StringFormat='{}{0}'}"
                                           Style="{DynamicResource NodeGlobalIndexStyle}"
                                           Margin="0"
                                           Visibility="Visible"/>

                                <!-- 节点显示名称（重命名时切换到编辑框） -->
                                <Grid Grid.Column="2">
                                    <TextBlock Text="{Binding DispName}" FontWeight="Bold" Foreground="#373A3C" HorizontalAlignment="Center"
                                               x:Name="NodeNameText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NodeTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                             Background="White"
                                             BorderBrush="#FF6600"
                                             BorderThickness="1"
                                             Padding="2,0"
                                             MinWidth="40"
                                             FontSize="{DynamicResource NodeFontSize}"
                                             FontWeight="Bold"
                                             VerticalAlignment="Center"
                                             x:Name="NodeNameEditor"
                                             KeyDown="NodeRenameTextBox_KeyDown"
                                             LostFocus="NodeRenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Grid>




                        </Grid>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0.7"/><Setter Property="CornerRadius" Value="4"/>
                                <!-- Effect 已移至 NodeGlowBorder 装饰层（选中/悬停辉光），避免内容子树位图化导致文字/图标模糊 -->
                                <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="3" Opacity="0.45"/></Setter.Value></Setter>

                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderThickness" Value="2"/></DataTrigger><DataTrigger Binding="{Binding ToolType}" Value="ImageLoad"><Setter Property="CornerRadius" Value="15"/></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                    </Border>
                            <!-- 连接点 - 上 -->
                            <rendering:VmExecutionPort Name="TopPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}" Width="30" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,-10,0,0"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="TopPort"
                                     Visibility="Collapsed"/>

                            <!-- 连接点 - 下 -->
                            <rendering:VmExecutionPort Name="BottomPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}" Width="30" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,-10"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="BottomPort"
                                     Visibility="Collapsed"/>

                            <!-- 连接点 - 左 -->
                            <rendering:VmExecutionPort Name="LeftPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}" Width="20" Height="30"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="-10,0,0,0"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="LeftPort"
                                     Visibility="Collapsed"/>

                            <!-- 连接点 - 右 -->
                            <rendering:VmExecutionPort Name="RightPortEllipse"
                                     Style="{DynamicResource PortEllipseStyle}" Width="20" Height="30"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0,0,-10,0"
                                     MouseLeftButtonDown="Port_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Port_MouseLeftButtonUp"
                                     MouseMove="Port_MouseMove"
                                     MouseEnter="Port_MouseEnter"
                                     MouseLeave="Port_MouseLeave"
                                     Tag="RightPort"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 拖拽连接时的临时连接线 -->
        <Path x:Name="TempConnectionLine"
              Style="{DynamicResource TempConnectionLineStyle}"
              Visibility="Collapsed">
            <Path.Data>
                <PathGeometry x:Name="TempConnectionGeometry" />
            </Path.Data>
        </Path>

        <!-- 框选控件 -->
        <common:SelectionBox x:Name="SelectionBox" Canvas.ZIndex="9999"/>

        <!-- 最大外接矩形（用于调试） -->
        <Border x:Name="BoundingRectangle"
                 BorderBrush="#FF0000"
                 BorderThickness="3"
                 Background="Red"
                 CornerRadius="2"
                 Opacity="0.5"
                 Canvas.ZIndex="500"
                 Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
            </Border.Effect>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
