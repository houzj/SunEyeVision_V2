<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Shared C geometry: the in-app logo remains transparent; only the desktop icon has a backing tile. -->
    <DrawingGroup x:Key="SunEyeVision.BrandDrawing" po:Freeze="True">
        <GeometryDrawing Brush="#0964AC" Geometry="M 28,266 C 120,257 149,153 254,153 C 353,153 388,259 484,247 C 398,270 361,238 335,215 C 313,195 286,177 254,177 C 166,177 107,259 28,266 Z"/>
        <GeometryDrawing Brush="#0964AC" Geometry="M 87,257 C 161,219 191,322 262,322 C 328,322 389,253 459,251 C 381,268 342,350 266,350 C 177,350 165,256 87,257 Z"/>
        <GeometryDrawing Brush="#F2AE16"><GeometryDrawing.Geometry>
            <EllipseGeometry Center="257,245" RadiusX="59" RadiusY="59"/>
        </GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="White" Geometry="M 211,280 L 256,200 L 292,292 L 276,300 L 256,237 C 239,247 225,263 211,280 Z"/>
        <GeometryDrawing Brush="White"><GeometryDrawing.Geometry>
            <EllipseGeometry Center="286,215" RadiusX="9" RadiusY="9"/>
        </GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="White" Geometry="M 280,229 L 292,229 L 292,287 L 280,252 Z"/>
    </DrawingGroup>
    <DrawingImage x:Key="SunEyeVision.BrandLogo" po:Freeze="True" Drawing="{StaticResource SunEyeVision.BrandDrawing}"/>
    <DrawingImage x:Key="SunEyeVision.AppIcon" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#E8F6FF"/>
                            <GradientStop Offset="0.5" Color="#B7DAF2"/>
                            <GradientStop Offset="1" Color="#77B0D9"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#7BA8C9" Thickness="2"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,496,496" RadiusX="104" RadiusY="104"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <StaticResource ResourceKey="SunEyeVision.BrandDrawing"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Solution files use a folded document silhouette, not the application's square tile. -->
    <DrawingImage x:Key="SunEyeVision.SolutionIcon" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#F6FBFF"/>
                            <GradientStop Offset="1" Color="#BCD9EE"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#658DAD" Thickness="4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M96,20 H340 L436,116 V472 Q436,492 416,492 H96 Q76,492 76,472 V40 Q76,20 96,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#C4DFF2">
                    <GeometryDrawing.Pen><Pen Brush="#658DAD" Thickness="4" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M340,20 L436,116 H340 Z"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform><MatrixTransform Matrix="0.7,0,0,0.7,76,96"/></DrawingGroup.Transform>
                    <DrawingGroup.Children>
                        <DrawingCollection><StaticResource ResourceKey="SunEyeVision.BrandDrawing"/></DrawingCollection>
                    </DrawingGroup.Children>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
