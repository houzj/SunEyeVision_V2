<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Local to the two startup windows; independent of the main application theme. -->
    <SolidColorBrush x:Key="Startup.Background" Color="#121518"/>
    <SolidColorBrush x:Key="Startup.Panel" Color="#1C2227"/>
    <SolidColorBrush x:Key="Startup.Border" Color="#3C444B"/>
    <SolidColorBrush x:Key="Startup.Text" Color="#EEF1F3"/>
    <SolidColorBrush x:Key="Startup.Muted" Color="#A7B0B8"/>
    <SolidColorBrush x:Key="Startup.Accent" Color="#FFAD52"/>
    <FontFamily x:Key="Startup.Font">Segoe UI, Microsoft YaHei UI</FontFamily>
    <DrawingImage x:Key="Startup.BrandMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="{StaticResource Startup.Accent}" Thickness="2"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,42,42" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Startup.Accent}">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="22,22" RadiusX="6.5" RadiusY="6.5"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
