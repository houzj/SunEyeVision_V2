<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- 复用应用正式品牌图形，避免欢迎页出现与产品标识不一致的占位标记。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Branding/Logo.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Local to the two startup windows; independent of the main application theme. -->
    <SolidColorBrush x:Key="Startup.Background" Color="#121518"/>
    <SolidColorBrush x:Key="Startup.Panel" Color="#1C2227"/>
    <SolidColorBrush x:Key="Startup.Border" Color="#3C444B"/>
    <SolidColorBrush x:Key="Startup.Text" Color="#EEF1F3"/>
    <SolidColorBrush x:Key="Startup.Muted" Color="#A7B0B8"/>
    <SolidColorBrush x:Key="Startup.Accent" Color="#FFAD52"/>
    <FontFamily x:Key="Startup.Font">Segoe UI, Microsoft YaHei UI</FontFamily>
    <DrawingImage x:Key="Startup.BrandMark" po:Freeze="True" Drawing="{StaticResource SunEyeVision.BrandDrawing}"/>
</ResourceDictionary>
