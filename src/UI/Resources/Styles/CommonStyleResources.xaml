<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base">

    <!-- ======================================== -->
    <!-- 图标字体 -->
    <!-- ======================================== -->

    <!-- 图标字体：必含 ⚙(U+2699)/↩(U+21A9) 等几何符号。
         显式指定 Segoe UI Symbol（Windows 内置、必含这些字形），
         避免依赖 WPF 字体回退链（回退结果无保证，是 ⚙ 不可见 bug 的根源）。
         新增几何符号图标时统一引用本资源，不散落硬编码字体。 -->
    <FontFamily x:Key="IconFontFamily">Segoe UI Symbol</FontFamily>

    <!-- ======================================== -->
    <!-- 按钮样式 -->
    <!-- ======================================== -->

    <!-- 主按钮样式 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#2196F3"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1976D2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#BDBDBD"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮样式 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#757575"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#616161"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具按钮样式 -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="BorderBrush" Value="#BDBDBD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================== -->
    <!-- DataGrid 样式 -->
    <!-- ======================================== -->

    <!-- 相机列表 DataGrid 样式 -->
    <Style x:Key="CameraDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RowBackground" Value="#F0F8FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================== -->
    <!-- 全局滚动条样式（隐式，随主题切换）        -->
    <!-- ======================================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarBackgroundBrush}}"/>
        <!-- 不设全局 Width/Height：
             垂直滚动条：ScrollViewer 内部会强制 Width=8；高度由视口 Stretch。
             水平滚动条：ScrollViewer 内部会强制 Height=8（在 Orientation=Horizontal 模板中显式声明）；宽度由视口 Stretch。
             全局设 Width=8 会让水平滚动条宽度也变成 8，塌缩成 8x8 方块。
             全局设 Height=8 会让垂直滚动条高度也变成 8，塌缩成 8x8 方块。
             这是用户看到滚动条"在中间不可控"的真因。 -->
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <!-- 垂直滚动条模板（WPF 标准：Track 垂直 + 方向反转，Thumb 声明在最上层保证可点击拖动） -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- 垂直滚动条固定宽度 8（在模板内声明，避免全局 Width=8 误伤水平条宽度） -->
                    <Grid Background="{TemplateBinding Background}" Width="8">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{x:Null}"
                                              Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{x:Null}"
                                              Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbBrush}}"
                                                    CornerRadius="4"
                                                    Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbHoverBrush}}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbPressedBrush}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 垂直滚动条固定宽度 8（在垂直方向 Trigger 内声明，避免全局 Width=8 误伤水平条宽度） -->
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
            </Trigger>
            <!-- 水平滚动条模板（WPF 标准：Track 水平 + 不反转，命令用 PageLeft/PageRight） -->
            <Trigger Property="Orientation" Value="Horizontal">
                <!-- 水平滚动条固定高度 8（垂直方向不受全局 Height 影响，由视口拉伸） -->
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{x:Null}"
                                                      Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{x:Null}"
                                                      Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbBrush}}"
                                                            CornerRadius="4"
                                                            Margin="0,1"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbHoverBrush}}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbPressedBrush}}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
