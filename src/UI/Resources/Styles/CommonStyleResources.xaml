<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base">

    <!-- ======================================== -->
    <!-- 图标字体 -->
    <!-- ======================================== -->

    <!-- 图标字体：必含 ⚙(U+2699)/↩(U+21A9) 等几何符号。
         显式指定 Segoe UI Symbol（Windows 内置、必含这些字形），
         避免依赖 WPF 字体回退链（回退结果无保证，是 ⚙ 不可见 bug 的根源）。
         新增几何符号图标时统一引用本资源，不散落硬编码字体。 -->
    <FontFamily x:Key="IconFontFamily">Segoe UI Symbol</FontFamily>

    <!-- MDL2 图标字体：Windows 内置 Segoe MDL2 Assets，与参考项目 VisionMaster 图标体系一致。
         用于 E7xx/EF3B 等私有区字形（运行/停止/删除/保存/缩放等原生图标）。
         参考项目按钮图标来源：FontIconButton FontFamily=Segoe MDL2 Assets，如运行=&#xEF3B;(U+EF3B)。
         注意：U+EF3B 不在 Segoe UI Symbol(IconFontFamily) 中，必须用本字体资源。 -->
    <FontFamily x:Key="Mdl2IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- ======================================== -->
    <!-- 按钮样式 -->
    <!-- ======================================== -->

    <!-- 主按钮样式 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.PrimaryButtonBackgroundBrush}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.PrimaryButtonTextBrush}}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.PrimaryButtonHoverBackgroundBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonDisabledBackgroundBrush}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮样式 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonBackgroundBrush}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonBorderBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonHoverBackgroundBrush}}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonHoverBorderBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonPressedBackgroundBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonDisabledBackgroundBrush}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具按钮样式 -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonBackgroundBrush}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonTextBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonBorderBrush}}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonHoverBackgroundBrush}}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonHoverBorderBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ButtonPressedBackgroundBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作按钮样式：继承工具按钮模板，前景/边框改为错误色 -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================== -->
    <!-- ComboBox 统一主题模板                     -->
    <!-- ======================================== -->

    <!--
         WPF 默认 ComboBox 模板依赖系统主题，Popup 在深色界面下仍会显示白底。
         这里统一接管输入框、箭头、Popup 和列表项，所有界面只需继承此样式。
    -->
    <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MaxDropDownHeight" Value="300"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="SelectionContent"
                                                              Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}"
                                                              TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                            <Path Grid.Column="1"
                                                  Width="8"
                                                  Height="5"
                                                  Margin="0,0,6,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
                                            <Setter TargetName="SelectionContent" Property="TextElement.Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               VerticalOffset="2">
                            <Border Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"
                                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer CanContentScroll="True"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 普通 UI ComboBox 默认使用同一主题模板；局部样式必须 BasedOn 此样式。 -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBoxStyle}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}"/>

    <!-- ======================================== -->
    <!-- DataGrid 样式 -->
    <!-- ======================================== -->

    <!-- 相机列表 DataGrid 样式 -->
    <Style x:Key="CameraDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource {x:Static base:ThemeKeys.ControlBackgroundBrush}}"/>
        <Setter Property="RowBackground" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RowBackground" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================== -->
    <!-- 全局滚动条样式（隐式，随主题切换）        -->
    <!-- ======================================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarBackgroundBrush}}"/>
        <!-- 不设全局 Width/Height：
             垂直滚动条：ScrollViewer 内部会强制 Width=8；高度由视口 Stretch。
             水平滚动条：ScrollViewer 内部会强制 Height=8（在 Orientation=Horizontal 模板中显式声明）；宽度由视口 Stretch。
             全局设 Width=8 会让水平滚动条宽度也变成 8，塌缩成 8x8 方块。
             全局设 Height=8 会让垂直滚动条高度也变成 8，塌缩成 8x8 方块。
             这是用户看到滚动条"在中间不可控"的真因。 -->
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <!-- 垂直滚动条模板（WPF 标准：Track 垂直 + 方向反转，Thumb 声明在最上层保证可点击拖动） -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- 垂直滚动条固定宽度 8（在模板内声明，避免全局 Width=8 误伤水平条宽度） -->
                    <Grid Background="{TemplateBinding Background}" Width="8">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{x:Null}"
                                              Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{x:Null}"
                                              Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbBrush}}"
                                                    CornerRadius="4"
                                                    Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbHoverBrush}}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbPressedBrush}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 垂直滚动条固定宽度 8（在垂直方向 Trigger 内声明，避免全局 Width=8 误伤水平条宽度） -->
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
            </Trigger>
            <!-- 水平滚动条模板（WPF 标准：Track 水平 + 不反转，命令用 PageLeft/PageRight） -->
            <Trigger Property="Orientation" Value="Horizontal">
                <!-- 水平滚动条固定高度 8（垂直方向不受全局 Height 影响，由视口拉伸） -->
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{x:Null}"
                                                      Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{x:Null}"
                                                      Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbBrush}}"
                                                            CornerRadius="4"
                                                            Margin="0,1"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbHoverBrush}}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource {x:Static base:ThemeKeys.ScrollBarThumbPressedBrush}}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
