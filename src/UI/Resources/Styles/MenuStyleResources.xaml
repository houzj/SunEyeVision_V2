<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base">

    <!-- 命名样式：完整主题化 MenuItem 模板（基于 Aero2 默认模板改造） -->
    <Style x:Key="ThemeMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid x:Name="templateRoot" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="Col0" MinWidth="24" Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTextColumnGroup"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                            <ColumnDefinition x:Name="Col3" Width="14"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        <Border x:Name="GlyphPanel" Background="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}" Margin="1" MinWidth="20" Height="16" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
                            <Path x:Name="Glyph" Data="F1 M5.00001,0 L3.15001,4.5 L-2.7e-005,5 L3.30002,7.8 L2.5,11.8 L5.00001,9.7 L7.5,11.8 L6.69998,7.8 L10,5 L6.85002,4.5 L5.00001,0 Z" Fill="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}" FlowDirection="LeftToRight" HorizontalAlignment="Center" Height="10" VerticalAlignment="Center" Width="10"/>
                        </Border>
                        <ContentPresenter x:Name="menuHeaderContainer" ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="menuGestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                        <!-- 子菜单右箭头（仅子菜单项显示） -->
                        <Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=templateRoot}">
                            <Border x:Name="SubMenuBorder" Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"
                                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"
                                    BorderThickness="1" Padding="2">
                                <ScrollViewer x:Name="SubMenuScrollViewer">
                                    <Grid RenderOptions.ClearTypeHint="Enabled">
                                        <Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                            <Rectangle Height="1" Width="{Binding ActualWidth, ElementName=templateRoot}" Fill="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
                                        </Canvas>
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True" Margin="2" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuItemHoverBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuItemHoverBrush}}"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Col0" Property="MinWidth" Value="0"/>
                            <Setter TargetName="Col3" Property="Width" Value="Auto"/>
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="Col0" Property="MinWidth" Value="0"/>
                            <Setter TargetName="Col3" Property="Width" Value="Auto"/>
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="menuHeaderContainer" Property="TextElement.Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 隐式样式：所有 MenuItem（含子菜单项、右键菜单项）默认套用主题化模板 -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource ThemeMenuItemStyle}"/>

    <!-- 菜单分隔线（仅菜单内生效，不影响普通布局 Separator） -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="28,3,8,3" Background="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 隐式 ContextMenu：未显式设置样式的右键菜单背景主题化 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

</ResourceDictionary>
