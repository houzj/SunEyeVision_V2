<Window x:Class="SunEyeVision.UI.Shell.Controls.Common.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="#171A1B" Width="640" Height="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ShowActivated="True" Topmost="True">
    <Grid ClipToBounds="True">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#202426" Offset="0"/><GradientStop Color="#121516" Offset="0.65"/><GradientStop Color="#101213" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Canvas Opacity="0.28" IsHitTestVisible="False">
            <Rectangle Canvas.Left="440" Canvas.Top="-40" Width="7" Height="7" Fill="#9A5A2D"/><Rectangle Canvas.Left="505" Canvas.Top="30" Width="9" Height="9" Fill="#9A5A2D"/><Rectangle Canvas.Left="530" Canvas.Top="70" Width="6" Height="6" Fill="#9A5A2D"/><Rectangle Canvas.Left="395" Canvas.Top="90" Width="8" Height="8" Fill="#6D777A"/><Rectangle Canvas.Left="430" Canvas.Top="125" Width="8" Height="8" Fill="#6D777A"/><Rectangle Canvas.Left="470" Canvas.Top="165" Width="10" Height="10" Fill="#6D777A"/><Rectangle Canvas.Left="520" Canvas.Top="205" Width="7" Height="7" Fill="#9A5A2D"/><Rectangle Canvas.Left="560" Canvas.Top="240" Width="9" Height="9" Fill="#6D777A"/><Rectangle Canvas.Left="430" Canvas.Top="275" Width="7" Height="7" Fill="#6D777A"/><Rectangle Canvas.Left="490" Canvas.Top="310" Width="8" Height="8" Fill="#9A5A2D"/><Rectangle Canvas.Left="575" Canvas.Top="130" Width="7" Height="7" Fill="#6D777A"/>
        </Canvas>
        <StackPanel Orientation="Horizontal" Margin="18,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image Source="{DynamicResource SunEyeVision.BrandLogo}" Width="34" Height="22" Stretch="Uniform" Margin="0,0,8,0"/>
            <TextBlock Text="SunEyeVision" FontSize="15" FontWeight="SemiBold" Foreground="#D7DBDD" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{DynamicResource SunEyeVision.BrandLogo}" Width="104" Height="72" Stretch="Uniform" Margin="0,0,18,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SunEyeVision" FontSize="44" FontWeight="SemiBold" Foreground="#F1F1F1"/><TextBlock Text="机器视觉平台" FontSize="20" Foreground="#D1D4D5" Margin="3,2,0,0"/></StackPanel></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0"><Ellipse Width="8" Height="8" Fill="#9B9B9B" Margin="0,0,13,0"/><Ellipse Width="8" Height="8" Fill="#9B9B9B" Margin="0,0,13,0"/><Ellipse Width="8" Height="8" Fill="#9B9B9B" Margin="0,0,13,0"/><Ellipse Width="8" Height="8" Fill="#D8782A" Margin="0,0,13,0"/><Ellipse Width="8" Height="8" Fill="#9B9B9B"/></StackPanel>
        </StackPanel>
        <TextBlock x:Name="MessageText" Text="正在启动" Foreground="#969C9E" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
    </Grid>
</Window>


