<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Common.SelectionBox"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="100"
             Visibility="Collapsed">
    <!-- 框选过程中的橡皮筋框：原件 ItemsPage.cs:728-744 —— LightSlateGray 1px 虚线 2,1，无填充无投影。
         框选完成后的「多节点外包框」是另一个元素 RectDragPanal（rectdragpanalbasestyle.xaml 橙虚线 5,2），不在这里。 -->
    <Canvas>
        <Rectangle x:Name="SelectionBorder"
                   Stroke="LightSlateGray"
                   StrokeThickness="1"
                   StrokeDashArray="2,1"
                   StrokeLineJoin="Round"
                   Fill="Transparent"
                   IsHitTestVisible="False"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="ItemCountText"
                   Foreground="#FFA70F"
                   FontSize="12"
                   FontWeight="Bold"
                   Visibility="Collapsed"/>
    </Canvas>
</UserControl>
