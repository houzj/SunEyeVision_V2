<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Panels.ImagePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Controls.Panels"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="140" d:DesignWidth="500">

    <UserControl.Resources>
        <!-- 样式转换器 -->
        <local:ImageRunModeDisplayConverter x:Key="ImageRunModeDisplayConverter"/>
        <local:RunModeToVisibilityConverter x:Key="RunModeToVisibilityConverter"/>

        <!-- 图标按钮样式 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Height="30">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        </Style>

        <!-- 运行按钮样式（醒目） -->
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"
                                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Height="30">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 切换按钮样式 -->
        <Style x:Key="IconToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Width="36"
                                Height="36">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        </Style>

        <!-- 开关按钮样式 -->
        <Style x:Key="SwitchToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BackgroundBorder"
                                Background="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                                BorderThickness="1"
                                CornerRadius="1"
                                Width="42"
                                Height="22">
                            <Rectangle x:Name="SwitchEllipse"
                                             Width="20"
                                             Height="22"
                                             Fill="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"/>
                         </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"/>
                                <Setter TargetName="SwitchEllipse" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        </Style>

        <!-- 运行模式选择按钮样式 -->
        <Style x:Key="RunModeSelectButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,0"
                                    Width="100"
                                    Height="36">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,4,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 下拉列表项样式 -->
        <Style x:Key="RunModeListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                Padding="8,4"
                                BorderThickness="0"
                                CornerRadius="2">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
        </Style>

        <!-- 运行模式枚举值数组 -->
        <x:Array x:Key="ImageRunModeValues" Type="{x:Type local:ImageRunMode}">
            <local:ImageRunMode>运行全部</local:ImageRunMode>
            <local:ImageRunMode>运行选择</local:ImageRunMode>
        </x:Array>

    </UserControl.Resources>

    <!-- 主容器 -->
    <Border Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}" BorderThickness="1" CornerRadius="6" Padding="2"
            HorizontalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Column="0"
                           Text="{Binding ImageCountDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="12"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <!-- 按钮组容器 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <!-- 运行模式选择 -->
                    <Button x:Name="RunModeButton"
                            Content="{Binding ImageRunMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ImageRunModeDisplayConverter}}"
                            Style="{StaticResource RunModeSelectButton}"
                            ToolTip="选择运行模式"
                            Click="OnRunModeButtonClick"/>
                    <Popup x:Name="RunModePopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=RunModeButton}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide"
                           StaysOpen="False">
                        <Border Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"
                                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                MaxHeight="150"
                                MinWidth="100">
                            <ListBox x:Name="RunModeListBox"
                                     ItemsSource="{Binding Source={StaticResource ImageRunModeValues}}"
                                     SelectedItem="{Binding ImageRunMode, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource RunModeListBoxItem}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     PreviewMouseDown="OnRunModeListBoxPreviewMouseDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource ImageRunModeDisplayConverter}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!-- 自动切换标签 -->
                    <TextBlock Text="自动切换"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                               VerticalAlignment="Center"
                               Margin="6,0,6,0"/>

                    <!-- 自动切换开关 -->
                    <ToggleButton x:Name="AutoSwitchToggle"
                                   IsChecked="{Binding AutoSwitchEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource SwitchToggleButton}"
                                   Margin="0,0,0,0"
                                   ToolTip="自动切换"/>
                    <!-- 分隔线 -->
                    <Border Width="1"
                            Background="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"
                            Margin="12,6,12,6"
                            VerticalAlignment="Stretch"/>
                    <!-- 添加图片 -->
                    <Button Content="➕"
                            Command="{Binding AddImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource IconButton}"
                            ToolTip="添加图片"/>

                    <!-- 添加文件夹 -->
                    <Button Content="📁"
                            Command="{Binding AddFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            ToolTip="添加文件夹"/>

                    <!-- 清除全部 -->
                    <Button Content="🧹"
                            Command="{Binding ClearAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            ToolTip="清除全部"/>
                </StackPanel>
            </Grid>

            <!-- 图像缩略图列表 -->
            <ListBox x:Name="ThumbnailListBox"
                     Grid.Row="2"
                     ItemsSource="{Binding ImageCollection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     ScrollViewer.ScrollChanged="OnScrollChanged"
                    SelectionChanged="OnThumbnailListBoxSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MouseLeftButtonDown="OnThumbnailClick"
                                Tag="{Binding}"
                                Width="70"
                                Height="70"
                                Margin="1"
                                ToolTip="{Binding Name}">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"
                                             Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
                                    <MenuItem Header="移除图片引用" Click="OnThumbnailRemoveReference"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBackgroundBrush}}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBorderBrush}}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsForRun}" Value="True"/>
                                                <Condition Binding="{Binding ImageRunMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="运行选择"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding IsForRun}" Value="True"/>
                                                <Condition Binding="{Binding ImageRunMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="运行选择"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                            <Setter Property="BorderThickness" Value="3"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsForRun}" Value="False"/>
                                                <Condition Binding="{Binding ImageRunMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="运行选择"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0.4"/>
                                            <Setter Property="Cursor" Value="No"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Border Background="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBackgroundBrush}}"
                                        CornerRadius="2"
                                        Padding="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid Width="60" Height="60">
                                        <!-- 缩略图由 ImageInfo.EnsureThumbnail 后台线程解码 + 静态缓存（DecodePixelWidth=100 + Freeze），
                                             滚动时缓存命中秒出。三态反馈：加载中灰底 / 成功图 / 失败占位（rule-015 失败可见） -->

                                        <!-- 加载中 / 未请求：灰底占位 -->
                                        <Border Background="#333333" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailState}" Value="Loading">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailState}" Value="Pending">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 成功：已冻结缩略图 -->
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="LowQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailState}" Value="Loaded">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- 失败：破图占位 -->
                                        <Border Background="#552222" CornerRadius="2">
                                            <TextBlock Text="✕" Foreground="#FF8888"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="18"/>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailState}" Value="Failed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 右上角删除按钮 -->
                                <Button Command="{Binding DeleteSingleImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="20" Height="20" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,2,2,0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="删除此图像">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}" CornerRadius="10" Width="20" Height="20">
                                                <TextBlock Text="X" FontSize="12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 左上角选择框 -->
                                <CheckBox IsChecked="{Binding IsForRun, Mode=TwoWay}"
                                          Width="18" Height="18"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Margin="2,2,0,0" Cursor="Hand">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Border x:Name="CheckBorder" Background="{DynamicResource {x:Static base:ThemeKeys.ThumbnailBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                                                                BorderThickness="2" CornerRadius="3" Width="16" Height="16">
                                                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <!-- 选中：浅底 + 绿色边框 + 绿色 ✓（不再整框刷绿底，保证勾清晰可见） -->
                                                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageRunMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="运行选择">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- 容器被虚拟化物化（进入可视区域）时触发缩略图解码。
                             这是业界成熟做法：由虚拟化系统决定"哪些项可见"，无需手算视口/索引，
                             对项宽变化、DPI、滚动位置完全免疫。 -->
                        <EventSetter Event="Loaded" Handler="OnItemLoaded"/>
                        <!-- 容器滚出可视区域（虚拟化回收）时取消进行中的解码，省 CPU 给当前视口（对齐 ImageGlass 不可见即取消） -->
                        <EventSetter Event="Unloaded" Handler="OnItemUnloaded"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
