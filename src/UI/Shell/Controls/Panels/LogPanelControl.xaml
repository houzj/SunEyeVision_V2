<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Panels.LogPanelControl"
             x:Name="LogPanelRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:logging="clr-namespace:SunEyeVision.Plugin.SDK.Logging;assembly=SunEyeVision.Plugin.SDK"
             xmlns:converters="clr-namespace:SunEyeVision.UI.Converters"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <!-- 右键菜单项样式 - 与选中行样式一致 -->
        <Style TargetType="MenuItem" x:Key="ContextMenuMenuItemStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <!-- 鼠标悬停 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuItemHoverBrush}}"/>
                </Trigger>
                <!-- 选中状态 - 主题反转背景 + 主题反转文字 -->
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 右键菜单容器样式 -->
        <Style TargetType="ContextMenu" x:Key="LogContextMenuStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- DataGrid 行样式 -->
        <Style TargetType="DataGridRow" x:Key="LogDataRowStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <!-- 鼠标悬停效果 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                </Trigger>
                <!-- 选中效果 - 主题反转背景 + 主题反转文字 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 单元格样式 -->
        <Style TargetType="DataGridCell" x:Key="LogDataCellStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <!-- 选中时继承行的背景色 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 文本块样式（用于 DataGridTextColumn.ElementStyle） -->
        <Style TargetType="TextBlock" x:Key="LogDataTextBlockStyle">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- DataGrid 列头样式 -->
        <Style TargetType="DataGridColumnHeader" x:Key="LogDataColumnHeaderStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableHeaderBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TableHeaderTextBrush}}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid 样式 -->
        <Style TargetType="DataGrid" x:Key="LogDataGridStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowStyle" Value="{StaticResource LogDataRowStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource LogDataCellStyle}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource LogDataColumnHeaderStyle}"/>
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>

        <!-- 过滤按钮样式 -->
        <Style TargetType="ToggleButton" x:Key="LogFilterToggleButtonStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 鼠标悬停 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                </Trigger>
                <!-- 选中状态 -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 工具栏操作按钮样式（清空/复制全部），带暗色主题适配的悬停效果 -->
        <Style TargetType="Button" x:Key="LogToolbarButtonStyle">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="0"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <Border Grid.Row="0" Background="{DynamicResource {x:Static base:ThemeKeys.ToolBarBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.DividerBrushBrush}}" BorderThickness="0,0,0,1" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：过滤按钮（单选互斥，默认全部） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="全部"
                                     GroupName="LogLevelFilter"
                                     IsChecked="{Binding ShowAll, Mode=TwoWay}"
                                     Style="{StaticResource LogFilterToggleButtonStyle}"/>
                        <RadioButton Content="信息"
                                     GroupName="LogLevelFilter"
                                     IsChecked="{Binding ShowInfo, Mode=TwoWay}"
                                     Style="{StaticResource LogFilterToggleButtonStyle}"/>
                        <RadioButton Content="成功"
                                     GroupName="LogLevelFilter"
                                     IsChecked="{Binding ShowSuccess, Mode=TwoWay}"
                                     Style="{StaticResource LogFilterToggleButtonStyle}"/>
                        <RadioButton Content="警告"
                                     GroupName="LogLevelFilter"
                                     IsChecked="{Binding ShowWarning, Mode=TwoWay}"
                                     Style="{StaticResource LogFilterToggleButtonStyle}"/>
                        <RadioButton Content="错误"
                                     GroupName="LogLevelFilter"
                                     IsChecked="{Binding ShowError, Mode=TwoWay}"
                                     Style="{StaticResource LogFilterToggleButtonStyle}"/>
                    </StackPanel>

                    <!-- 中间：搜索框 -->
                    <!-- 中间：搜索框 -->
                    <Border Grid.Column="1"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                            BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Height="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>

                            <!-- 搜索图标 -->
                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="10"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>

                            <!-- 输入框 -->
                            <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                     CaretBrush="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                     Padding="0"
                                     Margin="2,0,0,0"
                                     GotFocus="SearchTextBox_GotFocus"
                                     LostFocus="SearchTextBox_LostFocus"/>

                            <!-- 水印 -->
                            <TextBlock Grid.Column="1"
                                       x:Name="WatermarkText"
                                       Text="搜索日志..."
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>

                            <!-- 清除按钮 -->
                            <TextBlock Grid.Column="2"
                                       x:Name="ClearSearchButton"
                                       Text="✕"
                                       FontSize="10"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       Visibility="Collapsed"
                                       MouseLeftButtonDown="ClearSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- 右侧：操作按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="诊断模式"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <controls:ToggleSwitch IsChecked="{Binding IsDiagnosticMode, Mode=TwoWay}"
                                               SwitchWidth="36"
                                               SwitchHeight="18"
                                               OnBackground="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"
                                               ToolTip="开启后显示内部实现细节日志（用于排查问题）"
                                               Margin="0,0,12,0"/>
                        <TextBlock Text="自动滚动"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <controls:ToggleSwitch IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                               SwitchWidth="36"
                                               SwitchHeight="18"/>
                        <Button Content="清空"
                                Command="{Binding ClearCommand}"
                                Margin="0,0,4,0"
                                Style="{StaticResource LogToolbarButtonStyle}"/>
                        <Button Content="复制全部"
                                Command="{Binding CopyAllCommand}"
                                Style="{StaticResource LogToolbarButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 日志列表 - 使用 DataGrid 替代 ListBox，性能更好 -->
            <DataGrid Grid.Row="1"
                      x:Name="LogDataGrid"
                      ItemsSource="{Binding LogEntriesView, Mode=OneWay}"
                      Style="{StaticResource LogDataGridStyle}"
                      SelectedItem="{Binding SelectedLogEntry, Mode=TwoWay}">
                <DataGrid.Columns>
                    <!-- 时间列 -->
                    <DataGridTextColumn Header="时间"
                                          Binding="{Binding FormattedTime}"
                                          Width="Auto"
                                          MinWidth="90"
                                          IsReadOnly="True"
                                          ElementStyle="{StaticResource LogDataTextBlockStyle}"/>
                    <!-- 级别列 -->
                    <DataGridTextColumn Header="级别"
                                          Binding="{Binding Level}"
                                          Width="Auto"
                                          MinWidth="50"
                                          IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LogDataTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Debug}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Info}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Success}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.SuccessBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Warning}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Error}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- 来源列 -->
                    <DataGridTextColumn Header="来源"
                                          Binding="{Binding Source}"
                                          Width="Auto"
                                          MinWidth="80"
                                          IsReadOnly="True"
                                          ElementStyle="{StaticResource LogDataTextBlockStyle}"/>
                    <!-- 消息列（自动换行，长日志完整显示；悬停可看整条原文） -->
                    <DataGridTextColumn Header="消息"
                                          Binding="{Binding DisplayMessage}"
                                          Width="*"
                                          MinWidth="200"
                                          IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LogDataTextBlockStyle}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="ToolTip" Value="{Binding DisplayMessage}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <!-- 右键菜单 -->
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource LogContextMenuStyle}">
                        <MenuItem Header="复制选中"
                                      Click="CopySelected_Click"
                                      Style="{StaticResource ContextMenuMenuItemStyle}"/>
                        <MenuItem Header="复制全部"
                                      Command="{Binding CopyAllCommand}"
                                      Style="{StaticResource ContextMenuMenuItemStyle}"/>
                        <Separator/>
                        <MenuItem Header="清空日志"
                                      Click="ClearLogs_Click"
                                      Style="{StaticResource ContextMenuMenuItemStyle}"/>
                        <MenuItem Header="全选"
                                      Click="SelectAll_Click"
                                      Style="{StaticResource ContextMenuMenuItemStyle}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource {x:Static base:ThemeKeys.ToolBarBackgroundBrush}}"
                    BorderBrush="{DynamicResource {x:Static base:ThemeKeys.DividerBrushBrush}}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}">
                        <Run Text="已记录: "/>
                        <Run Text="{Binding TotalEnqueued, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='显示: {0}', Mode=OneWay}"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                               Margin="8,0,0,0"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding ErrorCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='错误: {0}', Mode=OneWay}"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ErrorCount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding WarningCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='警告: {0}', Mode=OneWay}"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.WarningBrush}}"
                               HorizontalAlignment="Center"
                               Margin="8,0"
                               Visibility="{Binding WarningCount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="4"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}">
                        <Run Text="✅ 零阻塞"/>
                        <Run Text=" | "/>
                        <Run Text="⚡ 批量更新"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
