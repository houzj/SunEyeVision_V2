<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.ImageResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SunEyeVision.UI.Shell.Controls.Shell"
             xmlns:results="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Native.Composition.Results.PropertyList;assembly=SunEyeVision.Plugin.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:SunEyeVision.UI.Shell.Controls.Panels"
             xmlns:sources="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Native.Composition.ImageSources;assembly=SunEyeVision.Plugin.Wpf"
             xmlns:sdk="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:convertersVisibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700">

    <UserControl.Resources>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convertersVisibility:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>  <!-- 图像显示模块 -->
            <RowDefinition Height="Auto"/>  <!-- 图像加载及预览模块 -->
        </Grid.RowDefinitions>

        <!-- 图像显示模块 - 使用TabControl -->
        <Border Grid.Row="0" BorderThickness="0">
            <TabControl x:Name="ImageDisplayTabControl"
                        Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}"
                        BorderThickness="0">
                <TabControl.Resources>
                    <!-- TabItem 头样式 -->
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="12,6">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- 第一个TabItem: 图像结果 -->
                <TabItem Header="图像结果" Padding="12,6">
                    <Border Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}">
                        <sdk:ImageControl x:Name="ImageDisplayContent"
                                          SourceImage="{Binding DisplayImage}"
                                          ShowToolBar="True"
                                          ShowStatusBar="True"
                                          ShowChessboardBackground="True"
                                          EnablePanning="True"
                                          EnableZoom="True"
                                          AutoFitMode="FirstOnly"
                                          ImageSources="{Binding DisplayImageSources}"
                                          SelectedImageSourceIndex="{Binding SelectedDisplayImageSourceIndex, Mode=TwoWay}"
                                          ImageLoaded="OnImageLoaded"
                                          ZoomChanged="OnZoomChanged"/>
                    </Border>
                </TabItem>

                <!-- 第二个TabItem: 模块结果 -->
                <TabItem Header="模块结果" Padding="12,6">
                    <Grid Background="{DynamicResource {x:Static base:ThemeKeys.ImageAreaBackgroundBrush}}">
                        <results:PropertyListView x:Name="ModuleResultTreeView"
                            SelectedItemChanged="OnResultTreeSelectionChanged"
                            Visibility="{Binding HasModuleResults, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 空状态 -->
                        <Grid Visibility="{Binding HasModuleResults, Converter={StaticResource InverseBoolToVisibilityConverter}}">
              <TextBlock Text="📊" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"/>
              <TextBlock Text="请选中已执行的节点查看结果" FontSize="10" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,52,0,0"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 图像加载及预览模块 -->
        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static base:ThemeKeys.TableHeaderBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                BorderThickness="0,1,0,0"
                Padding="2"
                Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ImagePreviewSourceMessage}"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextDisabledBrush}}"
                           TextTrimming="CharacterEllipsis"/>
                <sources:ImageSourceStrip x:Name="ImagePreviewContent"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
