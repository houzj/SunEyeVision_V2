<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.RootWorkflowOverviewControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="True" MinWidth="140" MinHeight="120" ClipToBounds="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RootWorkflowOverviewDrawings.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource ThemeWorkspaceBackgroundBrush}">
  <ScrollViewer x:Name="ViewportScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Background="Transparent">
   <Canvas x:Name="Surface" Width="5000" Height="5000" Background="Transparent" AllowDrop="True"/>
  </ScrollViewer>
  <TextBlock x:Name="EmptyHint" Text="暂无根流程，请通过流程栏添加" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
 </Grid>
</UserControl>
