<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.ShellTopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="81" d:DesignWidth="1600">

    <UserControl.Resources>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- VS 同款即时提示样式（ScreenTip）：仅窗口控制按钮（最小化/最大化/关闭）使用。
             即时显示（无延迟）+ 无箭头纯文本框（VS 标题栏按钮提示风格） -->
        <Style x:Key="WindowControlScreenTip" TargetType="ToolTip">
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter ContentSource="Content"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏按钮样式（含 IsHitTestVisibleInChrome，使按钮在窗口 Caption 区域可点击） -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarButtonHoverBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconHoverBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconHoverBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单按钮样式 -->
        <Style x:Key="TitleBarMenuButton" TargetType="MenuItem" BasedOn="{StaticResource ThemeMenuItemStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!-- ========== 一体化标题栏（VisionMaster 风格：菜单行 + 工具栏行，两行紧凑布局） ========== -->
    <Border Background="{DynamicResource ThemeTitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource {x:Static base:ThemeKeys.DividerBrush}}"
            BorderThickness="0,0,0,1">
        <Grid Height="81">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>  <!-- 行1：菜单栏 -->
                <RowDefinition Height="47"/>  <!-- 行2：工具栏 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>  <!-- Logo -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- 窗口控制 -->
            </Grid.ColumnDefinitions>

            <!-- Logo：跨两行，垂直居中，放大 -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                <Image Source="{DynamicResource SunEyeVision.BrandLogo}" Width="60" Height="55" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="SunEyeVision" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- 菜单栏（行1） -->
            <Menu x:Name="MainMenu" Grid.Row="0" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>

            <!-- 行1/行2 分割线（Logo 右侧起，跨菜单/窗口控制区域） -->
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="1"
                    Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" VerticalAlignment="Bottom"/>

            <!-- 原件工具栏按功能分组；缺基础入口明确禁用。 -->
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel x:Name="ToolbarItems" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
                <Button x:Name="RunModeButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" IsEnabled="False"
                        ToolTip="运行模式：功能尚未接入" ToolTipService.ShowOnDisabled="True" Margin="6,0,8,0" Padding="0">
                    <StackPanel Orientation="Horizontal" Opacity="0.45">
                        <Image Width="24" Height="24" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/Apps.Style/resources/frontend/ic_topbar_运行fronted_normal.png"/>
                        <TextBlock Text="运行模式" FontSize="13" Margin="6,0,8,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 右侧：项目信息 + 窗口控制（第一行） -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Border Background="Transparent" Padding="6,0" Margin="0,0,8,0"
                        Visibility="{Binding HasCurrentSolution, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="{Binding CurrentSolutionName}" FontSize="13" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button ToolTip="最小化" ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="10000" ToolTipService.Placement="Bottom"
                        Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click" Padding="10,4">
                    <Button.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource WindowControlScreenTip}"/>
                    </Button.Resources>
                    <Rectangle Width="10" Height="2" Fill="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="MaximizeButton" ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="10000" ToolTipService.Placement="Bottom"
                        Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click" Padding="10,4"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- VS 同款图标：Segoe MDL2 Assets 字体，字形由代码按 Window.State 切换
                         (\uE739=最大化方框, \uE923=还原/两个窗口)；ToolTip 由代码随状态设置 -->
                    <Button.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource WindowControlScreenTip}"/>
                    </Button.Resources>
                    <TextBlock x:Name="MaximizeGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Text="&#xE739;"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"
                               VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="关闭" ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="10000" ToolTipService.Placement="Bottom"
                        Style="{StaticResource TitleBarButton}" Click="ExitMenu_Click" Padding="10,4">
                    <Button.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource WindowControlScreenTip}"/>
                    </Button.Resources>
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
