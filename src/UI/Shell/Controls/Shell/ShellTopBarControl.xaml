<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.ShellTopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="1600">

    <UserControl.Resources>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 工具栏按钮样式（含 IsHitTestVisibleInChrome，使按钮在窗口 Caption 区域可点击） -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarButtonHoverBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconHoverBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconHoverBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单按钮样式 -->
        <Style x:Key="TitleBarMenuButton" TargetType="MenuItem" BasedOn="{StaticResource ThemeMenuItemStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <!-- 工作流选择下拉框样式（完整主题化模板：ToggleButton + 箭头 + Popup + 列表项，亮/暗主题都跟随）
             结构对齐 ImageControl.xaml 的 ToolBarComboBoxStyle，全用主题 Key，避免 WPF 默认模板硬编码亮色 -->
        <Style x:Key="WorkflowComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 背景/边框链式传递：ComboBox → ToggleButton → 内层 Border（每层都是正确的 TemplateBinding，
                                 避免直接在内层写 {TemplateBinding ComboBox.Background} 读到 ToggleButton 空背景导致透明） -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  IsHitTestVisible="False"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                                                <Path Grid.Column="1" x:Name="Arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                                      Margin="6,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Width="8" Height="5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlSelectedBackgroundBrush}}"/>
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleY="-1"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"
                                        BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="2">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏下拉列表项样式（跟随主题，作用域仅顶栏，不影响其他界面的 ComboBox） -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ContextMenuBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.ControlHoverBackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextOnDarkBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ========== 一体化标题栏（VisionMaster 风格：菜单行 + 工具栏行，两行紧凑布局） ========== -->
    <Border Background="{DynamicResource ThemeTitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeDividerBrushBrush}"
            BorderThickness="0,0,0,1">
        <Grid Height="64">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- 行1：菜单栏 -->
                <RowDefinition Height="32"/>  <!-- 行2：工具栏 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- 窗口控制 -->
            </Grid.ColumnDefinitions>

            <!-- Logo：跨两行，垂直居中，放大 -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                <Image Source="/SunEyeVision.UI;component/Icons/app_logo.ico" Width="55" Height="55" VerticalAlignment="Center"/>
                <TextBlock Text="SunEyeVision" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center" Margin="8,0,18,0"/>
            </StackPanel>

            <!-- 菜单栏（行1） -->
            <Menu Grid.Row="0" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <MenuItem Header="文件(_F)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="解决方案配置(_C)" Command="{Binding ShowSolutionConfigurationCommand}" InputGestureText="Ctrl+Alt+S"/>
                    <Separator/>
                    <MenuItem Header="保存当前(_S)" Command="{Binding SaveCurrentSolutionCommand}" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="退出(_X)" Click="ExitMenu_Click" InputGestureText="Alt+F4"/>
                </MenuItem>
                <MenuItem Header="视图(_V)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="显示路径拐点(_P)" InputGestureText="Ctrl+P" Command="{Binding TogglePathPointsCommand}"/>
                    <Separator/>
                    <MenuItem Header="全屏(_F)" InputGestureText="F11" Click="ToggleFullscreen_Click"/>
                </MenuItem>
                <MenuItem Header="运行(_R)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="运行(_R)" Command="{Binding RunWorkflowCommand}" InputGestureText="F5"/>
                    <MenuItem Header="停止(_S)" Command="{Binding StopWorkflowCommand}" InputGestureText="Shift+F5"/>
                </MenuItem>
                <MenuItem Header="工具(_T)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="全局变量管理(_G)" Command="{Binding ShowGlobalVariableManagerCommand}"/>
                    <MenuItem Header="相机管理(_C)" Command="{Binding ShowCameraManagerCommand}"/>
                    <MenuItem Header="通讯管理(_M)" Command="{Binding ShowCommunicationManagerCommand}"/>
                </MenuItem>
                <MenuItem Header="帮助(_H)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="用户手册(_M)" InputGestureText="F1" Command="{Binding ShowHelpCommand}"/>
                    <MenuItem Header="开发计划(_P)" Click="OpenPlan_Click" ToolTip="打开引导抓取开发计划看板"/>
                    <Separator/>
                    <MenuItem Header="快捷键(_K)" Command="{Binding ShowShortcutsCommand}"/>
                    <MenuItem Header="关于(_A)" Command="{Binding ShowAboutCommand}"/>
                </MenuItem>
            </Menu>

            <!-- 行1/行2 分割线（Logo 右侧起，跨菜单/窗口控制区域） -->
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="1"
                    Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" VerticalAlignment="Bottom"/>

            <!-- 行2：工具栏（图标按钮横排，各占一半空间） -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button ToolTip="解决方案配置 (Ctrl+Alt+S)" Style="{StaticResource TitleBarButton}" Command="{Binding ShowSolutionConfigurationCommand}">
                    <!-- ⚙ 改用默认 emoji 字体（与 💾📷🔌🧮 等同字体），统一字符 ascent/descent 度量，
                         避免 Segoe UI Symbol 线条字形与 emoji 字形混排时基线偏移导致整体不对齐 -->
                    <TextBlock Text="⚙" FontSize="16"/>
                </Button>
                <Button ToolTip="保存 (Ctrl+S)" Style="{StaticResource TitleBarButton}" Command="{Binding SaveCurrentSolutionCommand}">
                    <TextBlock Text="💾" FontSize="16"/>
                </Button>
                <Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>

                <!-- 运行（单次） -->
                <Button ToolTip="运行 (F5)" Style="{StaticResource TitleBarButton}" Command="{Binding RunWorkflowCommand}">
                    <TextBlock Text="▶️" FontSize="16"/>
                </Button>
                <!-- 连续运行/停止（切换按钮：点击立即切换，空闲🔁灰色，运行中⏹️红色+主色高亮） -->
                <ToggleButton x:Name="ContinuousRunToggle"
                              ToolTip="连续运行全部工作流"
                              Command="{Binding ToggleContinuousAllCommand}"
                              IsChecked="False"
                              Checked="ContinuousRunToggle_Checked"
                              Unchecked="ContinuousRunToggle_Unchecked"
                              Padding="10,4" Cursor="Hand"
                              WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarButtonHoverBrush}}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <TextBlock x:Name="ContinuousRunIcon" Text="🔁" FontSize="16" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}" VerticalAlignment="Center"/>
                </ToggleButton>

                <Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>

                <Button ToolTip="相机管理" Style="{StaticResource TitleBarButton}" Command="{Binding ShowCameraManagerCommand}">
                    <TextBlock Text="📷" FontSize="16"/>
                </Button>
                <Button ToolTip="通讯管理" Style="{StaticResource TitleBarButton}" Command="{Binding ShowCommunicationManagerCommand}">
                    <TextBlock Text="🔌" FontSize="16"/>
                </Button>
                <Button ToolTip="全局变量管理" Style="{StaticResource TitleBarButton}" Command="{Binding ShowGlobalVariableManagerCommand}">
                    <TextBlock Text="🧮" FontSize="16"/>
                </Button>

                <Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>

                <!-- 主题切换按钮：亮色显示太阳☀️，暗色显示月亮🌙（点击切换并记住） -->
                <Button ToolTip="切换亮/暗主题" Style="{StaticResource TitleBarButton}" Command="{Binding ToggleThemeCommand}">
                    <TextBlock FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="☀️"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="Text" Value="🌙"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>

                <TextBlock Text="工作流:" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextSecondaryBrush}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="150" Height="24" VerticalAlignment="Center"
                          ItemsSource="{Binding Tabs}"
                          SelectedItem="{Binding SelectedTab, Mode=OneWay}"
                          SelectionChanged="WorkflowComboBox_SelectionChanged"
                          IsSynchronizedWithCurrentItem="True"
                          Style="{StaticResource WorkflowComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       TextElement.Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- 右侧：项目信息 + 窗口控制（第一行） -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Border Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarProjectInfoBgBrush}}" CornerRadius="3" Padding="8,4" Margin="0,0,8,0"
                        Visibility="{Binding HasCurrentSolution, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding CurrentSolutionName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button ToolTip="最小化" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click" Padding="10,4">
                    <Rectangle Width="10" Height="2" Fill="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="向下还原" Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click" Padding="10,4">
                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                        <!-- 背景矩形（右下） -->
                        <Rectangle Width="12" Height="12" Stroke="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <!-- 前景矩形（左上） -->
                        <Rectangle Width="8" Height="6" Stroke="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    </Grid>
                </Button>
                <Button ToolTip="关闭" Style="{StaticResource TitleBarButton}" Click="ExitMenu_Click" Padding="10,4">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
