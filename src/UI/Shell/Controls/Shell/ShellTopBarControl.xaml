<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.ShellTopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="1600">

    <UserControl.Resources>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 工具栏按钮样式（含 IsHitTestVisibleInChrome，使按钮在窗口 Caption 区域可点击） -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单按钮样式 -->
        <Style x:Key="TitleBarMenuButton" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>
    </UserControl.Resources>

    <!-- ========== 一体化标题栏（VisionMaster 风格：菜单行 + 工具栏行，两行紧凑布局） ========== -->
    <Border Background="{StaticResource TitleBarBackgroundBrush}"
            BorderBrush="{StaticResource TitleBarBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Height="64">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- 行1：菜单栏 -->
                <RowDefinition Height="32"/>  <!-- 行2：工具栏 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- 窗口控制 -->
            </Grid.ColumnDefinitions>

            <!-- Logo：跨两行，垂直居中，放大 -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                <Image Source="/SunEyeVision.UI;component/Icons/app_logo.ico" Width="55" Height="55" VerticalAlignment="Center"/>
                <TextBlock Text="SunEyeVision" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,18,0"/>
            </StackPanel>

            <!-- 菜单栏（行1） -->
            <Menu Grid.Row="0" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <MenuItem Header="文件(_F)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="解决方案配置(_C)" Command="{Binding ShowSolutionConfigurationCommand}" InputGestureText="Ctrl+Alt+S"/>
                    <Separator/>
                    <MenuItem Header="保存当前(_S)" Command="{Binding SaveCurrentSolutionCommand}" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="退出(_X)" Click="ExitMenu_Click" InputGestureText="Alt+F4"/>
                </MenuItem>
                <MenuItem Header="视图(_V)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="显示路径拐点(_P)" InputGestureText="Ctrl+P" Command="{Binding TogglePathPointsCommand}"/>
                    <Separator/>
                    <MenuItem Header="全屏(_F)" InputGestureText="F11" Click="ToggleFullscreen_Click"/>
                </MenuItem>
                <MenuItem Header="运行(_R)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="运行(_R)" Command="{Binding RunWorkflowCommand}" InputGestureText="F5"/>
                    <MenuItem Header="停止(_S)" Command="{Binding StopWorkflowCommand}" InputGestureText="Shift+F5"/>
                </MenuItem>
                <MenuItem Header="工具(_T)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="全局变量管理(_G)" Command="{Binding ShowGlobalVariableManagerCommand}"/>
                    <MenuItem Header="相机管理(_C)" Command="{Binding ShowCameraManagerCommand}"/>
                    <MenuItem Header="通讯管理(_M)" Command="{Binding ShowCommunicationManagerCommand}"/>
                </MenuItem>
                <MenuItem Header="帮助(_H)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="用户手册(_M)" InputGestureText="F1" Command="{Binding ShowHelpCommand}"/>
                    <MenuItem Header="快捷键(_K)" Command="{Binding ShowShortcutsCommand}"/>
                    <MenuItem Header="关于(_A)" Command="{Binding ShowAboutCommand}"/>
                </MenuItem>
            </Menu>

            <!-- 行1/行2 分割线（Logo 右侧起，跨菜单/窗口控制区域） -->
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="1"
                    Background="#3E3E42" VerticalAlignment="Bottom"/>

            <!-- 行2：工具栏（图标按钮横排，各占一半空间） -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button ToolTip="解决方案配置 (Ctrl+Alt+S)" Style="{StaticResource TitleBarButton}" Command="{Binding ShowSolutionConfigurationCommand}">
                    <TextBlock Text="⚙" FontSize="16"/>
                </Button>
                <Button ToolTip="保存 (Ctrl+S)" Style="{StaticResource TitleBarButton}" Command="{Binding SaveCurrentSolutionCommand}">
                    <TextBlock Text="💾" FontSize="15"/>
                </Button>
                <Border Width="1" Height="18" Background="#3E3E42" Margin="4,0"/>

                <!-- 运行（单次） -->
                <Button ToolTip="运行 (F5)" Style="{StaticResource TitleBarButton}" Command="{Binding RunWorkflowCommand}">
                    <TextBlock Text="▶️" FontSize="16"/>
                </Button>
                <!-- 连续运行/停止（切换按钮：点击立即切换，空闲🔁灰色，运行中⏹️红色+主色高亮） -->
                <ToggleButton x:Name="ContinuousRunToggle"
                              ToolTip="连续运行全部工作流"
                              Command="{Binding ToggleContinuousAllCommand}"
                              IsChecked="False"
                              Checked="ContinuousRunToggle_Checked"
                              Unchecked="ContinuousRunToggle_Unchecked"
                              Padding="10,4" Cursor="Hand"
                              WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <TextBlock x:Name="ContinuousRunIcon" Text="🔁" FontSize="16" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                </ToggleButton>

                <Border Width="1" Height="18" Background="#3E3E42" Margin="4,0"/>

                <Button ToolTip="相机管理" Style="{StaticResource TitleBarButton}" Command="{Binding ShowCameraManagerCommand}">
                    <TextBlock Text="📷" FontSize="16"/>
                </Button>
                <Button ToolTip="通讯管理" Style="{StaticResource TitleBarButton}" Command="{Binding ShowCommunicationManagerCommand}">
                    <TextBlock Text="🔌" FontSize="16"/>
                </Button>
                <Button ToolTip="全局变量管理" Style="{StaticResource TitleBarButton}" Command="{Binding ShowGlobalVariableManagerCommand}">
                    <TextBlock Text="🧮" FontSize="16"/>
                </Button>

                <Border Width="1" Height="18" Background="#3E3E42" Margin="4,0"/>

                <TextBlock Text="工作流:" FontSize="11" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="150" Height="24" VerticalAlignment="Center"
                          ItemsSource="{Binding Tabs}"
                          SelectedItem="{Binding SelectedTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name"
                          IsSynchronizedWithCurrentItem="True"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          Style="{StaticResource StyledComboBox}"/>
            </StackPanel>

            <!-- 右侧：项目信息 + 窗口控制（第一行） -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Border Background="#3A3A3E" CornerRadius="3" Padding="8,4" Margin="0,0,8,0"
                        Visibility="{Binding HasCurrentSolution, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding CurrentSolutionName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button ToolTip="最小化" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click" Padding="10,4">
                    <Rectangle Width="10" Height="2" Fill="#E0E0E0" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="向下还原" Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click" Padding="10,4">
                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                        <!-- 背景矩形（右下） -->
                        <Rectangle Width="12" Height="12" Stroke="#E0E0E0" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <!-- 前景矩形（左上） -->
                        <Rectangle Width="8" Height="6" Stroke="#E0E0E0" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    </Grid>
                </Button>
                <Button ToolTip="关闭" Style="{StaticResource TitleBarButton}" Click="ExitMenu_Click" Padding="10,4">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
