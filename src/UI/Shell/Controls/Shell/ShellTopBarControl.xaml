<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.ShellTopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="1600">

    <UserControl.Resources>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- VS 同款即时提示样式（ScreenTip）：仅窗口控制按钮（最小化/最大化/关闭）使用。
             即时显示（无延迟）+ 无箭头纯文本框（VS 标题栏按钮提示风格） -->
        <Style x:Key="WindowControlScreenTip" TargetType="ToolTip">
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter ContentSource="Content"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏按钮样式（含 IsHitTestVisibleInChrome，使按钮在窗口 Caption 区域可点击） -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarButtonHoverBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconHoverBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconHoverBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单按钮样式 -->
        <Style x:Key="TitleBarMenuButton" TargetType="MenuItem" BasedOn="{StaticResource ThemeMenuItemStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!-- ========== 一体化标题栏（VisionMaster 风格：菜单行 + 工具栏行，两行紧凑布局） ========== -->
    <Border Background="{DynamicResource ThemeTitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource {x:Static base:ThemeKeys.DividerBrush}}"
            BorderThickness="0,0,0,1">
        <Grid Height="64">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- 行1：菜单栏 -->
                <RowDefinition Height="32"/>  <!-- 行2：工具栏 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- 窗口控制 -->
            </Grid.ColumnDefinitions>

            <!-- Logo：跨两行，垂直居中，放大 -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                <Image Source="{DynamicResource SunEyeVision.BrandLogo}" Width="72" Height="55" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="SunEyeVision" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center" Margin="8,0,18,0"/>
            </StackPanel>

            <!-- 菜单栏（行1） -->
            <Menu Grid.Row="0" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <MenuItem Header="文件(_F)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="新建方案(_N)" Command="{Binding NewSolutionCommand}" InputGestureText="Ctrl+N"/>
                    <MenuItem Header="打开方案(_O)" Command="{Binding OpenSolutionCommand}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="从磁盘重新加载" Command="{Binding ReloadSolutionCommand}"/>
                    <MenuItem Header="起始页 / 最近方案" Command="{Binding ShowStartPageCommand}"/>
                    <Separator/>
                    <MenuItem Header="保存当前(_S)" Command="{Binding SaveCurrentSolutionCommand}" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="退出(_X)" Click="ExitMenu_Click" InputGestureText="Alt+F4"/>
                </MenuItem>
                <MenuItem Header="视图(_V)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="显示路径拐点(_P)" InputGestureText="Ctrl+P" Command="{Binding TogglePathPointsCommand}"/>
                    <Separator/>
                    <MenuItem Header="全屏(_F)" InputGestureText="F11" Click="ToggleFullscreen_Click"/>
                </MenuItem>
                <MenuItem Header="运行(_R)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="运行(_R)" Command="{Binding RunWorkflowCommand}" InputGestureText="F5"/>
                    <MenuItem Header="停止(_S)" Command="{Binding StopWorkflowCommand}" InputGestureText="Shift+F5"/>
                </MenuItem>
                <MenuItem Header="工具(_T)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="全局变量管理(_G)" Command="{Binding ShowGlobalVariableManagerCommand}"/>
                    <MenuItem Header="相机管理(_C)" Command="{Binding ShowCameraManagerCommand}"/>
                    <MenuItem Header="通讯管理(_M)" Command="{Binding ShowCommunicationManagerCommand}"/>
                </MenuItem>
                <MenuItem Header="帮助(_H)" Style="{StaticResource TitleBarMenuButton}">
                    <MenuItem Header="用户手册(_M)" InputGestureText="F1" Command="{Binding ShowHelpCommand}"/>
                    <MenuItem Header="开发计划(_P)" Click="OpenPlan_Click" ToolTip="打开引导抓取开发计划看板"/>
                    <Separator/>
                    <MenuItem Header="快捷键(_K)" Command="{Binding ShowShortcutsCommand}"/>
                    <MenuItem Header="关于(_A)" Command="{Binding ShowAboutCommand}"/>
                </MenuItem>
            </Menu>

            <!-- 行1/行2 分割线（Logo 右侧起，跨菜单/窗口控制区域） -->
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="1"
                    Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" VerticalAlignment="Bottom"/>

            <!-- 原件工具栏按功能分组；缺基础入口明确禁用。 -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
<Button ToolTip="保存 (Ctrl+S)" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}" Command="{Binding SaveCurrentSolutionCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarsave_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarsave_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button ToolTip="打开方案" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}" Command="{Binding OpenSolutionCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbaropen_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbaropen_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button Content="起始页" ToolTip="起始页 / 最近方案" Style="{StaticResource TitleBarButton}" Command="{Binding ShowStartPageCommand}"/>
<Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>
<Button x:Name="UndoEditButton" ToolTip="撤销 (Ctrl+Z)" Style="{StaticResource TitleBarButton}" Command="{Binding UndoCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/toolbar_ic_topbar_undo_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/toolbar_ic_topbar_undo_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button x:Name="RedoEditButton" ToolTip="重做 (Ctrl+Y)" Style="{StaticResource TitleBarButton}" Command="{Binding RedoCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/toolbar_ic_topbar_redo_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/toolbar_ic_topbar_redo_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button x:Name="EditHistoryButton" Content="历史" ToolTip="编辑历史" Style="{StaticResource TitleBarButton}" Click="EditHistoryClick"/>
<Button Content="锁定" IsEnabled="False" ToolTip="锁定：功能尚未接入" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}"/>
<Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>
<Button ToolTip="相机管理" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}" Command="{Binding ShowCameraManagerCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_topbar_camera_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_topbar_camera_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>
<Button ToolTip="全局变量管理" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}" Command="{Binding ShowGlobalVariableManagerCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_全局变量_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_全局变量_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button ToolTip="通讯管理" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}" Command="{Binding ShowCommunicationManagerCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_通信管理_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/ic_通信管理_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button Content="触发" IsEnabled="False" ToolTip="触发：功能尚未接入" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}"/>
<Button Content="脚本" IsEnabled="False" ToolTip="脚本：功能尚未接入" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}"/>
<Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>
<Button ToolTip="运行当前工作流 (F5)" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}" Command="{Binding RunWorkflowCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarstart_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarstart_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button x:Name="ContinuousRunToggle" ToolTip="连续运行或停止全部工作流" Style="{StaticResource TitleBarButton}" Command="{Binding ToggleContinuousAllCommand}"><Image Width="20" Height="20"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarrunrepeat_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsAllWorkflowsRunning}" Value="True"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarstop_n.png"/></DataTrigger><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Input/VMControls.WPF/resources/toolbarrunrepeat_disable.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
<Button Content="综合配置" IsEnabled="False" ToolTip="综合配置：功能尚未接入" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}"/>
<Button Content="运行界面" IsEnabled="False" ToolTip="运行界面：功能尚未接入" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TitleBarButton}"/>
<Border Width="1" Height="18" Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarDividerBrush}}" Margin="4,0"/>
<Button Content="主题" ToolTip="切换亮/暗主题" Style="{StaticResource TitleBarButton}" Command="{Binding ToggleThemeCommand}"/>
            </StackPanel></ScrollViewer>

            <!-- 右侧：项目信息 + 窗口控制（第一行） -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Border Background="{DynamicResource {x:Static base:ThemeKeys.TitleBarProjectInfoBgBrush}}" CornerRadius="3" Padding="8,4" Margin="0,0,8,0"
                        Visibility="{Binding HasCurrentSolution, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="{Binding CurrentSolutionName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button ToolTip="最小化" ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="10000" ToolTipService.Placement="Bottom"
                        Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click" Padding="10,4">
                    <Button.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource WindowControlScreenTip}"/>
                    </Button.Resources>
                    <Rectangle Width="10" Height="2" Fill="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="MaximizeButton" ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="10000" ToolTipService.Placement="Bottom"
                        Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click" Padding="10,4"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- VS 同款图标：Segoe MDL2 Assets 字体，字形由代码按 Window.State 切换
                         (\uE739=最大化方框, \uE923=还原/两个窗口)；ToolTip 由代码随状态设置 -->
                    <Button.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource WindowControlScreenTip}"/>
                    </Button.Resources>
                    <TextBlock x:Name="MaximizeGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Text="&#xE739;"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarIconBrush}}"
                               VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="关闭" ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="10000" ToolTipService.Placement="Bottom"
                        Style="{StaticResource TitleBarButton}" Click="ExitMenu_Click" Padding="10,4">
                    <Button.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource WindowControlScreenTip}"/>
                    </Button.Resources>
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TitleBarTextBrush}}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
