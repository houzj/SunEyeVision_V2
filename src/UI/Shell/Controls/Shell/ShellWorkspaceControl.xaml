<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.ShellWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:canvas="clr-namespace:SunEyeVision.UI.Features.WorkflowUI.Canvas"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             xmlns:shell="clr-namespace:SunEyeVision.UI.Shell.Controls.Shell"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.UI;component/Shell/Controls/Shell/WorkflowTabButtonStyles.xaml"/>
    <ResourceDictionary Source="/SunEyeVision.UI;component/Shell/Controls/Shell/RootWorkflowOverviewDrawings.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>

  <!-- ========== 工作区（含右下角小地图覆盖层） ========== -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource {x:Static base:ThemeKeys.TabStripBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="0">
      <TabControl x:Name="WorkflowTabControl"
                    Background="{DynamicResource {x:Static base:ThemeKeys.TabStripBackgroundBrush}}"
                    BorderThickness="0"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=OneWay}"
                    IsSynchronizedWithCurrentItem="True"
                    SelectionChanged="WorkflowTabControl_SelectionChanged"
                    Loaded="WorkflowTabControl_Loaded">


        <!-- 自定义TabControl模板,将添加按钮放在TabPanel中 -->
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- TabPanel区域,分为两列:左侧TabItems可滚动,右侧添加按钮固定 -->
              <Border x:Name="TabHeaderBar" MinHeight="40" Grid.Row="0" Background="{DynamicResource {x:Static base:ThemeKeys.TabStripBackgroundBrush}}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TabItemBorderBrush}}"
                                ClipToBounds="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 左侧:TabItems区域 -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>

                  </Grid.ColumnDefinitions>

                  <!-- 左侧:ScrollViewer包裹TabPanel和可滚动添加按钮 -->
                  <ScrollViewer Grid.Column="0"
                                              x:Name="TabPanelScrollViewer" Margin="36,0,0,0"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              Focusable="False"
                                              ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                      <TabPanel x:Name="HeaderPanel"
                                                  IsItemsHost="True"/>

                      <!-- 可滚动位置的添加按钮 - 当TabItems多时隐藏 -->
                      <Border x:Name="ScrollableAddButtonBorder"
                                                Visibility="Collapsed"
                                                Background="Transparent" Padding="0,1,6,0"
                                                Margin="2,1,0,0"
                                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WorkflowAddButton}" Click="AddWorkflow_Click"/>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>

                  <Button x:Name="WorkflowViewButton" Grid.Column="0" HorizontalAlignment="Left" Width="36" Style="{StaticResource WorkflowImageButton}" Click="ToggleRootOverviewClick" ToolTip="全部流程"><Image Width="30" Height="30"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{StaticResource ic_单个normalDrawingImage}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="False"/><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_单个hoverDrawingImage}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="False"/><Condition Binding="{Binding IsPressed,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_单个clickDrawingImage}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="False"/><Condition Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_单个disableDrawingImage}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_全局normalDrawingImage}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True"/><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_全局hoverDrawingImage}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True"/><Condition Binding="{Binding IsPressed,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_全局clickDrawingImage}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True"/><Condition Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=Button}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Source" Value="{StaticResource ic_全局disableDrawingImage}"/></MultiDataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
                  <shell:WorkflowLocationControl x:Name="WorkflowLocations" Grid.Column="2" Loaded="WorkflowLocationsLoaded"/>

                  <!-- 右侧:固定的添加工作流按钮 - 当TabItems多时显示 -->
                  <Border Grid.Column="1"
                                        x:Name="FixedAddButtonBorder"
                                        Visibility="Collapsed"
                                        Background="Transparent" Padding="0,1,6,0"
                                        VerticalAlignment="Center">
                    <Button Style="{StaticResource WorkflowAddButton}" Click="AddWorkflow_Click"/>
                  </Border>
                </Grid>
              </Border>

              <!-- TabContent内容区域 -->
              <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          Margin="0"/>
            </Grid>
            <ControlTemplate.Triggers><DataTrigger Binding="{Binding IsRootOverviewVisible,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True">
             <Setter TargetName="TabPanelScrollViewer" Property="Visibility" Value="Collapsed"/>
             <Setter TargetName="FixedAddButtonBorder" Property="Visibility" Value="Collapsed"/>
             <Setter TargetName="WorkflowLocations" Property="Visibility" Value="Collapsed"/>
             <Setter TargetName="PART_SelectedContentHost" Property="Visibility" Value="Collapsed"/>
             <Setter TargetName="WorkflowViewButton" Property="ToolTip" Value="子流程"/>
            </DataTrigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </TabControl.Template>

        <!-- 自定义TabItem容器样式 -->
        <TabControl.ItemContainerStyle>
          <Style TargetType="TabItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Grid>
                    <Grid.ContextMenu>
                      <ContextMenu Opened="RootMenuOpened">
                        <MenuItem Header="重命名" Click="TabItem_Rename_Click"/>
                        <Separator/>
                        <MenuItem Header="复制流程" Tag="RootEdit" Click="RootCopyClick"/>
                        <MenuItem Header="设置运行间隔" Tag="RootEdit" Click="RootRunSettingsClick"/>
                        <MenuItem Header="NG时停止流程" Tag="RootEdit" IsCheckable="True" IsChecked="{Binding RootSettings.StopOnNg,Mode=OneWay}" Click="RootStopOnNgClick"/>
                        <MenuItem Header="流程等待超时（待完善）" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="需完成原件等待超时语义与根执行协作取消、资源释放完整链；不提供仅保存无执行的设置。"/>
                        <MenuItem Header="配置检查" Click="RootReadinessClick"/>
                        <MenuItem Header="流程配置" Tag="RootEdit" Click="RootConfigurationClick"/>
                        <MenuItem Header="流程变量（待完善）" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="待流程局部变量作用域及保存、执行快照能力具备后接入。"/>
                        <MenuItem Header="标题注释（待完善）" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="待画布注释模型、编辑事务及保存复制合同具备后接入。"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="TabItem_ContextMenu_Delete_Click"/>
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Border x:Name="TabBorder"
                                          Background="{DynamicResource {x:Static base:ThemeKeys.TabStripBackgroundBrush}}"
                                          BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TabItemBorderBrush}}"
                                          BorderThickness="0,0,1,1"
                                          CornerRadius="0"
                                          Padding="0"
                                          Margin="0,0,0,0"
                                          ClipToBounds="True">
                    <Grid>
                      <!-- Group既有指示样式保留；根Tab使用恢复件矩形40px布局。 -->
                      <Rectangle x:Name="SelectedIndicator"
                                                 Height="2"
                                                 Margin="6,0,6,0"
                                                 VerticalAlignment="Top"
                                                 Fill="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"
                                                 Visibility="Collapsed"/>
                      <Grid x:Name="HeaderLayout" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- [↩] 返回按钮 - 仅子程序模式下可见 -->
                        <Button x:Name="SubroutineBackBtn"
                                                    Grid.Column="0"
                                                    Content="&#x21A9;"
                                                    FontFamily="{StaticResource IconFontFamily}"
                                                    FontSize="14" FontWeight="Bold"
                                                    Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6,2"
                                                    Cursor="Hand"
                                                    Margin="0,0,4,0"
                                                    ToolTip="返回上层工作流"
                                                    Click="NavigateBack_Click">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInSubroutine}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>

                        <!-- [⚙] 设置按钮 - 仅子程序模式下可见。
                             治本（双管齐下）：
                             1. 内容：原 Content="{Binding SubroutineIcon}" (emoji 🔁 U+1F501) 走 Segoe UI Emoji 字体路径，
                                Foreground 主题色对 emoji 无效、暗色主题下肉眼不可见（用户实测截图）。
                                改用 ⚙ (U+2699 BLACK GEAR) 标准几何符号 + IconFontFamily(Segoe UI Symbol) 必含该字形。
                             2. 前景色：必须跟随主题用 TextSecondaryBrush（暗色下=亮灰 #C0C0C0），
                                与本控件"返回"按钮(↩ U+21A9)一致。不能写死 #333333——
                                暗色下 TabItemBackground=#2D2D2D，深灰叠深灰对比度极低几乎不可见（真因）。
                                悬停用主题 AccentBrush 高亮。 -->
                        <Button x:Name="SubroutineSettingsBtn"
                                                    Grid.Column="1"
                                                    Content="&#x2699;"
                                                    FontFamily="{StaticResource IconFontFamily}"
                                                    FontSize="14" FontWeight="Bold"
                                                    Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6,2"
                                                    Cursor="Hand"
                                                    Margin="0,0,8,0"
                                                    ToolTip="子程序参数设置"
                                                    Click="SubroutineSettings_Click">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInSubroutine}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.AccentBrush}}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>

                        <StackPanel x:Name="RootTabTools" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                          <Button x:Name="RootConfigurationBtn" Style="{StaticResource RootConfigurationButton}" Click="RootConfigurationClick"/>
                          <Button x:Name="RootVariablesBtn" Style="{StaticResource RootVariablesButton}"/>
                          <Border Width="1" Height="30" Background="{DynamicResource {x:Static base:ThemeKeys.TabItemBorderBrush}}" Margin="0,0,8,0"/>
                        </StackPanel>
                        <!-- 工作流名称（支持行内重命名） -->
                        <StackPanel x:Name="NameHost" Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse x:Name="RootReadinessIndicator" Width="8" Height="8" Fill="#EC0000" Margin="0,0,8,0" ToolTip="{Binding RootConfigurationSummary}">
                            <Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers>
                              <DataTrigger Binding="{Binding IsRootConfigurationReady}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                              <DataTrigger Binding="{Binding IsInSubroutine}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Ellipse.Style>
                          </Ellipse>
                          <Grid>
                          <TextBlock x:Name="TabNameText"
                                                           Text="{Binding EffectiveDisplayName}"
                                                           FontSize="14"
                                                           FontWeight="Normal"
                                                           MaxWidth="240" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TabItemTextBrush}}"
                                                           VerticalAlignment="Center"/>
                          <TextBox x:Name="TabNameEditor"
                                                         Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13"
                                                         FontWeight="SemiBold"
                                                         VerticalAlignment="Center"
                                                         MinWidth="60"
                                                         Padding="2"
                                                         Visibility="Collapsed"
                                                         KeyDown="TabRenameTextBox_KeyDown"
                                                         LostFocus="TabRenameTextBox_LostFocus"/>
                          </Grid>
                        </StackPanel>

                        <Button x:Name="SingleRunBtn" Grid.Column="3" Tag="{Binding}" Click="TabItem_SingleRun_Click"
                                Style="{StaticResource WorkflowSingleButton}" Visibility="Collapsed"/>
                        <Button x:Name="ContinuousRunBtn" Grid.Column="4" Tag="{Binding}" Click="TabItem_ContinuousRun_Click"
                                Style="{StaticResource WorkflowContinuousButton}" Visibility="Collapsed"/>

                      </Grid>
                      </Grid>
                    </Border>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TabItemHoverBrush}}"/>
                      <Setter TargetName="TabNameText" Property="FontWeight" Value="Bold"/>
                      <Setter TargetName="SingleRunBtn" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="ContinuousRunBtn" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Cursor" Value="Hand"/>
                    </Trigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
                      <Condition Binding="{Binding IsInSubroutine}" Value="False"/>
                    </MultiDataTrigger.Conditions><Setter TargetName="RootTabTools" Property="Visibility" Value="Visible"/></MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsInSubroutine}" Value="True">
                      <Setter Property="Margin" Value="4,1,0,0"/>
                      <Setter TargetName="HeaderLayout" Property="Margin" Value="6,0"/>
                      <Setter TargetName="NameHost" Property="Margin" Value="0,0,8,0"/>
                      <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TabItemBackgroundBrush}}"/>
                      <Setter TargetName="TabNameText" Property="MaxWidth" Value="Infinity"/>
                      <Setter TargetName="TabBorder" Property="CornerRadius" Value="6,6,0,0"/>
                      <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/>
                      <Setter TargetName="TabNameText" Property="FontSize" Value="13"/>
                      <Setter TargetName="TabNameText" Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
                      <Condition Binding="{Binding IsInSubroutine}" Value="True"/>
                    </MultiDataTrigger.Conditions><Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/></MultiDataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource Self}}" Value="True"/>
                      <Condition Binding="{Binding IsInSubroutine}" Value="True"/>
                    </MultiDataTrigger.Conditions><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TabItemHoverBrush}}"/></MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                      <Setter TargetName="TabNameText" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="TabNameEditor" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.ItemContainerStyle>

        <!-- TabItem内容 - 使用CanvasTemplateSelector根据画布类型选择不同的控件 -->
        <TabControl.ContentTemplate>
          <DataTemplate>
            <ContentControl Content="{Binding}">
              <ContentControl.ContentTemplateSelector>
                <canvas:CanvasTemplateSelector>
                  <canvas:CanvasTemplateSelector.WorkflowCanvasTemplate>
                    <DataTemplate>
                      <ScrollViewer x:Name="CanvasScrollViewer"
                                                      HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                                                      PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel"
                                                      ScrollChanged="CanvasScrollViewer_ScrollChanged"
                                                      Background="{DynamicResource {x:Static base:ThemeKeys.WorkspaceBackgroundBrush}}">
                        <!-- 画布容器：尺寸 = 画布缩放后尺寸（跟随缩放），滚动范围 = 画布大小（对齐 VM）。
                             画布外露出 ScrollViewer 深灰工作区；画布左上对齐。 -->
                        <Grid x:Name="CanvasSizingGrid">
                          <canvas:WorkflowCanvasControl
                                                    x:Name="WorkflowCanvasHost"
                                                    Width="5000" Height="5000"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    DataContext="{Binding}"
                                                    Loaded="WorkflowCanvasControl_Loaded"/>
                        </Grid>
                      </ScrollViewer>
                    </DataTemplate>
                  </canvas:CanvasTemplateSelector.WorkflowCanvasTemplate>
                </canvas:CanvasTemplateSelector>
              </ContentControl.ContentTemplateSelector>
            </ContentControl>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Border>

    <StackPanel x:Name="RootEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count,ElementName=WorkflowTabControl}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="暂无流程" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
      <Button Content="添加流程" Padding="20,6" Click="AddWorkflow_Click" IsEnabled="{Binding RootWorkspaceEditingAllowed,RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}"/>
    </StackPanel>

    <shell:WorkflowSearchControl x:Name="WorkflowSearch" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,12,0" Panel.ZIndex="110"/>

    <!-- ========== 右下角小地图（整画布快照 + 黑框标记画布边界，支持最小化/还原） ========== -->
    <Grid x:Name="MiniMapHost" HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="0,0,11,11"
          Panel.ZIndex="100">
      <!-- 状态 A：小地图展开（含右下角收起按钮） -->
      <Border x:Name="MiniMapBorder"
                  Width="187" Height="150"
                  Background="Transparent"
                  BorderBrush="Black" BorderThickness="1"
                  IsHitTestVisible="True"
                  MouseLeftButtonDown="MiniMapBorder_MouseLeftButtonDown"
                  MouseLeftButtonUp="MiniMapBorder_MouseLeftButtonUp"
                  MouseMove="MiniMapBorder_MouseMove"
                  LostMouseCapture="MiniMapBorder_LostMouseCapture" PreviewMouseWheel="MiniMap_PreviewMouseWheel">
        <Grid>
          <Canvas x:Name="MiniMapCanvas"
                        Width="187" Height="150"
                        Background="Transparent"
                        ClipToBounds="True"/>

          <!-- 右下角收起按钮（右下箭头 ↘，点击把面板收向角落） -->
          <Button x:Name="MiniMapMinimizeButton"
                      Width="20" Height="20"
                      Margin="0,0,3,3"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                      ToolTip="最小化小地图"
                      Click="MiniMapMinimizeButton_Click"
                      Cursor="Hand">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Opacity" Value="0.85"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Image Stretch="None"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_retract_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_retract_click.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
          </Button>
        </Grid>
      </Border>

      <!-- 状态 B：还原按钮（小地图收起后显示，左上箭头 ↖，从角落展开） -->
      <Button x:Name="MiniMapRestoreButton"
                  Width="24" Height="24"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                  Visibility="Collapsed"
                  ToolTip="展开小地图"
                  Click="MiniMapRestoreButton_Click"
                  Cursor="Hand">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Opacity" Value="0.9"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Image Stretch="None"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_expand_normal.png"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_expand_click.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
      </Button>
    </Grid>
    <shell:RootWorkflowOverviewControl x:Name="RootOverview" Margin="0,40,0,0" Panel.ZIndex="120" Visibility="Collapsed"/>
    <shell:WorkspaceStatusBarControl x:Name="WorkspaceStatusBar" Grid.Row="1"/>
  </Grid>
</UserControl>
