<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="800">

    <StatusBar Height="24" Background="{DynamicResource {x:Static base:ThemeKeys.StatusBarBackgroundBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.StatusBarBorderBrush}}" BorderThickness="0,1,0,0">
        <StatusBarItem>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="●" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" VerticalAlignment="Center"/>
            </StackPanel>
        </StatusBarItem>
        <Separator/>
        <StatusBarItem>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📷 相机:" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding CameraStatus}" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" VerticalAlignment="Center"/>
            </StackPanel>
        </StatusBarItem>
        <Separator/>
        <StatusBarItem>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="流程1:" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding IsRunning, Converter={StaticResource BoolToRunningTextConverter}}" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" VerticalAlignment="Center"/>
            </StackPanel>
        </StatusBarItem>
        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="流程:" FontSize="11" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding WorkflowCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" VerticalAlignment="Center"/>
            </StackPanel>
        </StatusBarItem>
    </StatusBar>
</UserControl>
