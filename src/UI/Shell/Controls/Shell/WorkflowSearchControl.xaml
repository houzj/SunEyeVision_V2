<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.WorkflowSearchControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource ThemeControlBackgroundBrush}"><StackPanel Orientation="Horizontal" Height="40">
  <Grid x:Name="SearchFields" Width="280" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Scope" Margin="10,5,0,5" SelectedIndex="1" SelectionChanged="ScopeChanged"><ComboBoxItem Content="全部流程"/><ComboBoxItem Content="当前流程"/></ComboBox>
   <TextBox x:Name="Query" Grid.Column="1" Margin="15,5,0,5" Padding="2,0,24,0" VerticalContentAlignment="Center" ToolTip="按模块名称搜索" TextChanged="QueryChanged" PreviewKeyDown="QueryKeyDown" LostFocus="QueryLostFocus"/>
   <Button x:Name="ClearSearch" Grid.Column="1" HorizontalAlignment="Right" Width="30" Height="30" Margin="0,5,0,5" Click="ClearClick" ToolTip="清除搜索"><Button.Style><Style TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Image x:Name="icon" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_closeGrey32_normal.png"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_closeGrey32_click.png"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Query}" Value=""><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   <Popup x:Name="ResultsPopup" PlacementTarget="{Binding ElementName=SearchFields}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
    <Border Width="312" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}" Background="{DynamicResource ThemePanelBackgroundBrush}"><Grid>
     <TextBlock x:Name="NoResults" Text="无匹配结果" Margin="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
     <ListBox x:Name="Results" MaxHeight="215" BorderThickness="0" Background="{DynamicResource ThemePanelBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" PreviewMouseLeftButtonDown="ResultClick"><ListBox.ItemTemplate><DataTemplate><Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding FullPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border>
   </Popup>
  </Grid>
  <ToggleButton x:Name="Expand" Width="32" Height="40" Checked="ExpandChanged" Unchecked="ExpandChanged" ToolTip="搜索模块"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Image x:Name="icon" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_note_search_normal.png"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_note_search_click.png"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_rightarrow32_normal.png"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_rightarrow32_click.png"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
 </StackPanel></Border>
</UserControl>
