<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:SunEyeVision.UI.Shell.Controls.Shell">
 <ControlTemplate x:Key="WorkflowSingleTemplate" TargetType="Button">
  <Border Background="Transparent"><Image x:Name="Icon" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_play_单流程_normal.png"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_play_单流程_hover.png"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_play_单流程_click.png"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_play_单流程_disable.png"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="WorkflowContinuousTemplate" TargetType="Button">
  <Border Background="Transparent"><Image x:Name="Icon" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_多次运行_normal.png"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_多次运行_hover.png"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_多次运行_click.png"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_多次运行_disable.png"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="WorkflowStopTemplate" TargetType="Button">
  <Border Background="Transparent"><Image x:Name="Icon" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_停止运行_normal.png"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_停止运行_hover.png"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_停止运行_click.png"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_停止运行_disable.png"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="WorkflowAddTemplate" TargetType="Button">
  <Border Background="Transparent"><Image x:Name="Icon" Stretch="None" Source="/SunEyeVision.UI;component/Resources/Workflow/ic_hu_add_normal.png"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_hu_add_hover.png"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_hu_add_click.png"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Icon" Property="Source" Value="/SunEyeVision.UI;component/Resources/Workflow/ic_hu_add_disable.png"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style x:Key="WorkflowImageButton" TargetType="Button">
  <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
 </Style>
 <Style x:Key="WorkflowSingleButton" TargetType="Button" BasedOn="{StaticResource WorkflowImageButton}">
  <Setter Property="ToolTip" Value="单次运行"/><Setter Property="Template" Value="{StaticResource WorkflowSingleTemplate}"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
   <DataTrigger Binding="{Binding WorkflowNodes.Count}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
   <DataTrigger Binding="{Binding SingleExecutionBusy, RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="WorkflowContinuousButton" TargetType="Button" BasedOn="{StaticResource WorkflowImageButton}">
  <Setter Property="ToolTip" Value="连续运行"/><Setter Property="Template" Value="{StaticResource WorkflowContinuousTemplate}"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="ToolTip" Value="停止运行"/><Setter Property="Template" Value="{StaticResource WorkflowStopTemplate}"/></DataTrigger>
   <MultiDataTrigger><MultiDataTrigger.Conditions>
    <Condition Binding="{Binding IsRunning}" Value="False"/>
    <Condition Binding="{Binding SingleExecutionBusy, RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="True"/>
   </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False"/></MultiDataTrigger>
   <DataTrigger Binding="{Binding WorkflowNodes.Count}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="WorkflowAddButton" TargetType="Button" BasedOn="{StaticResource WorkflowImageButton}">
  <Setter Property="ToolTip" Value="添加工作流"/><Setter Property="Template" Value="{StaticResource WorkflowAddTemplate}"/>
  <Style.Triggers><DataTrigger Binding="{Binding WorkflowEditingAllowed, RelativeSource={RelativeSource AncestorType=shell:ShellWorkspaceControl}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
