<UserControl x:Class="SunEyeVision.UI.Shell.Controls.Shell.WorkspaceStatusBarControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Controls.Shell">
 <UserControl.Resources>
  <Style x:Key="TrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Rectangle Fill="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="WorkspaceZoomSlider" TargetType="Slider">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="16" SnapsToDevicePixels="True">
    <Border Height="2" Background="{DynamicResource ThemeTextSecondaryBrush}"/>
    <Rectangle Width="2" Height="10" Fill="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center"/>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackButton}"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackButton}"/></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Width="6" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ThemeControlBackgroundBrush}" BorderBrush="{DynamicResource ThemeTextSecondaryBrush}" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    </Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorderBrush}" Background="{DynamicResource ThemeStatusBarBackgroundBrush}" MinHeight="26">
  <DockPanel TextBlock.FontSize="13" TextBlock.Foreground="{DynamicResource ThemeTextSecondaryBrush}">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,5,0">
    <Slider x:Name="ZoomSlider" Width="80" Minimum="0.1" Maximum="2" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Style="{StaticResource WorkspaceZoomSlider}" Value="{Binding Scale,RelativeSource={RelativeSource AncestorType=local:WorkspaceStatusBarControl},Mode=OneWay}" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="流程画布缩放"/>
    <Button x:Name="ResetZoomButton" Width="48" Margin="4,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Click="ResetZoomButton_Click" ToolTip="恢复100%缩放" AutomationProperties.Name="恢复流程画布原始比例"><TextBlock Text="{Binding Scale,RelativeSource={RelativeSource AncestorType=local:WorkspaceStatusBarControl},StringFormat={}{0:P0}}"/></Button>
   </StackPanel>
   <TextBlock x:Name="StatusTextBlock" Margin="5,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusText,RelativeSource={RelativeSource AncestorType=local:WorkspaceStatusBarControl}}"/>
  </DockPanel>
 </Border>
</UserControl>
