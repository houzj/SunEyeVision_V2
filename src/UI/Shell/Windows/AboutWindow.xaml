<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        mc:Ignorable="d"
        Title="关于 SunEyeVision" Width="640" Height="600" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
    <themeWindows:ThemeDialogWindow.Resources>
        <Style x:Key="InformationValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </themeWindows:ThemeDialogWindow.Resources>
    <Grid Margin="24" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource {x:Static base:ThemeKeys.PanelBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static base:ThemeKeys.BorderBrush}}" BorderThickness="1"
                CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource SunEyeVision.BrandLogo}" Width="84" Height="56" Stretch="Uniform" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="太阳眼视觉" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="SunEyeVision · 机器视觉平台" FontSize="13" Margin="0,5,0,0"
                               Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,8,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Top" Margin="0,2,8,0"
                                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource InformationValue}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="提交号表示代码基线，不代表源码没有未提交修改。" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" Margin="0,0,8,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="复制软件信息" Click="CopyInformation_Click" Style="{DynamicResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="用户手册" Click="HelpManual_Click" Style="{DynamicResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="关闭" IsCancel="True" Click="CloseButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="18,7"/>
            </WrapPanel>
            <TextBlock Text="© 2026 SunEyeVision. All rights reserved." FontSize="11" Margin="0,14,0,0"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</themeWindows:ThemeDialogWindow>
