<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.DataDirectoryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
 xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
 Title="SunEyeVision 数据目录" Width="620" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}"
 Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="选择软件数据目录" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Margin="0,12,0,16" TextWrapping="Wrap" Text="软件配置、默认方案和日志保存在此目录，与安装位置分离。建议选择非系统盘；已有数据请选择原目录恢复。" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="PathBox" Padding="8" Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"/>
   <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,6" Style="{DynamicResource SecondaryButtonStyle}" Click="Browse_Click"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <CheckBox x:Name="ImportBox" Content="导入旧桌面管理配置，保留最近记录和偏好（原文件不删除）" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource {x:Static base:ThemeKeys.ErrorBrush}}"/>
  </StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" Padding="18,7" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
   <Button Content="确定" IsDefault="True" Padding="18,7" Style="{DynamicResource PrimaryButtonStyle}" Click="Accept_Click"/>
  </StackPanel>
 </Grid>
</local:ThemeDialogWindow>
