<themeWindows:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.EditSolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
        xmlns:themeWindows="clr-namespace:SunEyeVision.UI.Shell.Windows"
        mc:Ignorable="d"
        Title="编辑解决方案"
        Width="500"
        Height="350"
        MinHeight="320"
        MinWidth="450"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">

    <DockPanel Margin="20">
        <!-- 按钮区：Dock 到底部，永不被内容挤出 -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Width="100" Height="36"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnCancelButtonClick"/>
            <Button Name="SaveButton"
                    Content="保存"
                    Width="100" Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnSaveButtonClick"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- 内容区 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="编辑解决方案" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" Margin="0,0,0,16"/>

            <!-- 解决方案名称 -->
            <TextBlock Grid.Row="1" Text="解决方案名称" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" Margin="0,0,0,6"/>
            <TextBox Grid.Row="2"
                     Name="SolutionNameTextBox"
                     FontSize="13"
                     Padding="8,6"
                     Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                     BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                     Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                     CaretBrush="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                     BorderThickness="1"
                     Margin="0,0,0,12"
                     TextChanged="OnSolutionNameTextChanged"/>

            <!-- 描述（溢出可滚动） -->
            <TextBlock Grid.Row="3" Text="描述（可选）" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}" Margin="0,0,0,6"/>
            <TextBox Grid.Row="4"
                     Name="DescriptionTextBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="70"
                     FontSize="13"
                     Padding="8,6"
                     Background="{DynamicResource {x:Static base:ThemeKeys.InputBackgroundBrush}}"
                     BorderBrush="{DynamicResource {x:Static base:ThemeKeys.InputBorderBrush}}"
                     Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                     CaretBrush="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                     BorderThickness="1"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</themeWindows:ThemeDialogWindow>
