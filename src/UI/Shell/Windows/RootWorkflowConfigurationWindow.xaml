<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.RootWorkflowConfigurationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:native="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageView;assembly=SunEyeVision.Plugin.Wpf" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
 Title="流程配置" Width="1100" Height="680" MinWidth="900" MinHeight="580" WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F2F3F5" FontFamily="Microsoft YaHei" FontSize="14">
 <WindowChrome.WindowChrome><WindowChrome GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False" CaptionHeight="0"/></WindowChrome.WindowChrome>
 <local:ThemeDialogWindow.Resources>
  <Style x:Key="ConfigurationTab" TargetType="TabItem"><Setter Property="Foreground" Value="#666666"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter ContentSource="Header"/><Border x:Name="Line" Height="2" Margin="0,0,0,-7" VerticalAlignment="Bottom" Background="#FF7900" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Line" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ConfigurationTabs" TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#FCFCFC"/><Setter Property="ItemContainerStyle" Value="{StaticResource ConfigurationTab}"/></Style>
 </local:ThemeDialogWindow.Resources>
 <Border BorderBrush="#161617" BorderThickness="1"><DockPanel>
  <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource ThemePanelBackgroundBrush}" MouseLeftButtonDown="DragTitle"><TextBlock x:Name="Heading" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="10,0,35,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/><Button Content="×" Width="30" HorizontalAlignment="Right" Click="CancelClick"/></Grid>
  <Grid DockPanel.Dock="Bottom" Height="36" Background="#E4E5E7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Error" Foreground="DarkRed" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="UndoButton" Content="撤销配置" Click="UndoClick" ToolTip="仅撤销本窗口提交且未被其他配置修改覆盖的事务。"/><Button x:Name="RedoButton" Content="重做" Click="RedoClick"/><Button x:Name="Repeat" Content="连续运行" Click="RepeatClick"/><Button x:Name="Stop" Content="停止运行" Click="StopClick"/><Button x:Name="RunOnce" Content="单次运行" Click="RunClick"/><Button x:Name="ApplyButton" Content="应用" Click="ApplyClick"/><Button x:Name="AcceptButton" Content="确定" Click="AcceptClick"/><Button Content="取消" Click="CancelClick" Margin="0,0,10,0"/></StackPanel>
  </Grid>
  <Border Margin="14,12" BorderBrush="#E0DFDE" BorderThickness="1" Background="#FCFCFC"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TabControl x:Name="ConfigurationTabs" Style="{StaticResource ConfigurationTabs}" SelectedIndex="2">
    <TabItem Header="输入设置" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="尚缺根输入声明、值快照及正式绑定来源合同；不使用Group输入代替。"/>
    <TabItem Header="输出设置" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="尚缺根输出声明、稳定字段及跨流程发布合同；右侧仅展示节点已发布结果。"/>
    <TabItem Header="运行参数"><DockPanel Background="#F2F3F5"><DockPanel DockPanel.Dock="Top" Margin="12,6" Height="34"><Button Content="编辑" Width="70" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="EditParametersClick"/><TextBlock Text="运行参数" Foreground="#666666" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Parameters" Margin="10,0,10,12" Background="#F2F3F5" TextElement.Foreground="#666666"/></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="显示设置" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="根显示声明和报告映射尚未接入正式图像生命周期；节点图像预览不代替显示配置。"/>
    <TabItem Header="通信设置" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="恢复项目该页同样未接原生协议编辑器。"/>
   </TabControl>
   <Border Grid.Column="1" BorderBrush="#E0DFDE" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="188"/></Grid.RowDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="12,0"><TextBlock Text="节点图像预览" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="ImageNodes" DisplayMemberPath="DispName" VerticalAlignment="Center" SelectionChanged="ImageNodeChanged"/><ComboBox x:Name="ImagePorts" DisplayMemberPath="Label" MinWidth="170" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="请选择当前节点正式声明的单图像输出端口；不自动选择图像。" SelectionChanged="ImagePortChanged"/></DockPanel><Border Grid.Row="1" Margin="10" Background="#E4E4E4"><Grid><native:ImageViewBox x:Name="Preview"/><TextBlock x:Name="NoImage" Text="请选择正式图像输出端口；当前无已发布图像" Foreground="#777777" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border></Grid>
    <TabControl Grid.Row="1" Style="{StaticResource ConfigurationTabs}"><TabItem Header="节点结果（只读）"><DataGrid x:Name="Results" Margin="12,8" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" Background="#FCFCFC" Foreground="#666666"><DataGrid.Columns><DataGridTextColumn Header="参数名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="当前结果" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
   </Grid></Border>
  </Grid></Border>
 </DockPanel></Border>
</local:ThemeDialogWindow>
