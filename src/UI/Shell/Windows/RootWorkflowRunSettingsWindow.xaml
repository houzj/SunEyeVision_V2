<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.RootWorkflowRunSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
 Title="设置运行间隔" Width="400" Height="210" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource ThemePanelBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock Text="运行间隔（ms）" VerticalAlignment="Center" Width="125"/><TextBox x:Name="Interval" Width="150" VerticalContentAlignment="Center" ToolTip="0到100000毫秒；本轮完成后等待，可随停止操作取消。"/></StackPanel>
  <CheckBox x:Name="StopOnNg" Grid.Row="1" Content="检测NG时停止连续运行" VerticalAlignment="Center"/>
  <TextBlock x:Name="Error" Grid.Row="2" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="70" Margin="0,0,8,0" Content="确定" IsDefault="True" Click="Apply"/><Button Width="70" Content="取消" IsCancel="True"/></StackPanel>
 </Grid>
</local:ThemeDialogWindow>
