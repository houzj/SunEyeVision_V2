<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.RootWorkflowRunSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
 xmlns:numeric="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.HikPcUI.ListView;assembly=SunEyeVision.Plugin.Wpf"
 Title="设置运行间隔" Width="370" Height="200" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource ThemePanelBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
 <Grid>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32" Margin="0,0,0,20">
   <Label Content="运行间隔（ms）" Width="122" FontSize="14" Margin="26,0,0,0" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
   <numeric:SliderArrange x:Name="Interval" Margin="12,0,0,0" FontSize="14" Width="182" Minimum="0" Maximum="100000" SliderTickFrequency="10" StartValue="80"/>
  </StackPanel>
  <TextBlock x:Name="Error" VerticalAlignment="Bottom" Margin="14,0,14,34" TextWrapping="Wrap"/>
  <Grid Background="{DynamicResource ThemePanelBackgroundBrush}" Height="32" VerticalAlignment="Bottom">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Height="24" Width="66" VerticalAlignment="Center" Content="确定" Margin="0,0,14,0" IsDefault="True" Click="Apply"/>
    <Button Height="24" Width="66" VerticalAlignment="Center" Content="取消" Margin="0,0,14,0" IsCancel="True"/>
   </StackPanel>
  </Grid>
 </Grid>
</local:ThemeDialogWindow>
