<Window x:Class="SunEyeVision.UI.Shell.Windows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SunEyeVision" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Width="480" Height="360" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Startup.Font}" Foreground="{DynamicResource Startup.Text}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Branding/StartupBranding.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource Startup.Accent}"/>
                <Setter Property="Background" Value="#343B42"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left" CornerRadius="2"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource Startup.Background}" BorderBrush="{StaticResource Startup.Border}"
            BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Startup.Accent}" CornerRadius="10,10,0,0"/>
            <StackPanel Grid.Row="1" Margin="32,20" VerticalAlignment="Center">
                <StackPanel x:Name="BrandHeader" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="{StaticResource Startup.BrandMark}" Width="44" Height="44" Margin="0,0,13,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SunEyeVision" FontSize="29" FontWeight="SemiBold"/>
                        <TextBlock Text="BUILD YOUR VISION" FontSize="10" Foreground="{StaticResource Startup.Muted}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="准备你的视觉工作空间" FontSize="19" HorizontalAlignment="Center" Margin="0,26,0,7"/>
                <TextBlock Text="视觉开发平台" FontSize="12" Foreground="{StaticResource Startup.Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource Startup.Panel}" CornerRadius="0,0,10,10" Padding="32,18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="正在初始化..." FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="已用 0.0s" FontSize="11" Foreground="{StaticResource Startup.Muted}"/>
                    </Grid>
                    <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailText" Text="准备应用环境" FontSize="11" Foreground="{StaticResource Startup.Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                    <TextBlock x:Name="VersionText" FontSize="10" Foreground="{StaticResource Startup.Muted}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="BrandHeader" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
