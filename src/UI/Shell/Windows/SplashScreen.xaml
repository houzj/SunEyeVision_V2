<Window x:Class="SunEyeVision.UI.Shell.Windows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SunEyeVision"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="420"
        Height="330"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Background="#FF1E1E1E"
            CornerRadius="12"
            BorderBrush="#FF3C3C3C"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo + 标题（淡入缩放动画） -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,30,0,0">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.9" ScaleY="0.9"/>
                </StackPanel.RenderTransform>
                <Image x:Name="LogoImage"
                       Source="{DynamicResource SunEyeVision.BrandLogo}"
                       Width="180"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="SunEyeVision"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock Text="视觉检测平台"
                           FontSize="14"
                           Foreground="#FF9CDCFE"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 进度条（平滑动画） -->
            <Border Grid.Row="1" Margin="40,0,40,10">
                <ProgressBar x:Name="Progress"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="#FF007ACC"
                             Background="#FF3C3C3C"
                             BorderThickness="0"/>
            </Border>

            <!-- 单行加载状态 + 实时耗时（简洁，随阶段切换，不列列表） -->
            <Grid Grid.Row="2" Margin="40,0,40,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="正在初始化..."
                           FontSize="12"
                           Foreground="#FFDCDCDC"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ElapsedText"
                           Grid.Column="1"
                           Text="已用 0.0s"
                           FontSize="12"
                           Foreground="#FF9E9E9E"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="DetailText"
                       Grid.Row="3"
                       Text="准备应用环境"
                       FontSize="11"
                       Foreground="#FF9E9E9E"
                       TextTrimming="CharacterEllipsis"
                       Margin="40,0,40,10"/>

            <!-- 底部版本：由程序集注入的版本自报（rule-022），禁止硬编码 -->
            <TextBlock x:Name="VersionText"
                       Grid.Row="4"
                       FontSize="11"
                       Foreground="#FF6E6E6E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
        </Grid>
    </Border>

    <!-- 动画：Logo 淡入 + 缩放 + 进度平滑 -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Logo 淡入 -->
                    <DoubleAnimation Storyboard.TargetName="LogoImage"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4"/>
                    <!-- Logo 缩放 -->
                    <DoubleAnimation Storyboard.TargetName="LogoScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.9" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.9" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
