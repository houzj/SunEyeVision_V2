<Window x:Class="SunEyeVision.UI.Shell.Windows.StartPageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SunEyeVision · 起始页" Width="1020" Height="690" MinWidth="820" MinHeight="590"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="#121518" Foreground="#EEF1F3" ShowInTaskbar="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EDF1F3"/><Setter Property="Background" Value="#26313A"/><Setter Property="BorderBrush" Value="#52616D"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Capability" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#20272D"/><Setter Property="BorderBrush" Value="#3C474F"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
 </Window.Resources>
 <Border BorderBrush="#52616D" BorderThickness="1" CornerRadius="10"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#FFAD52" Grid.Row="0"/>
  <Grid Grid.Row="1" Margin="30,25,24,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="SunEyeVision" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="BUILD YOUR VISION" Foreground="#A7B0B8" FontSize="10"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><CheckBox x:Name="HideStartPageBox" Content="不再显示" Foreground="#A7B0B8" Margin="0,7,18,0" Checked="HideStartPage_Changed" Unchecked="HideStartPage_Changed" AutomationProperties.AutomationId="HideStartPage"/><Button Content="×" FontSize="23" Background="Transparent" BorderThickness="0" Padding="4,0" Margin="0" Click="Close_Click" AutomationProperties.AutomationId="CloseStartPage"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Margin="30,0,30,24"><TextBlock Text="让视觉想法，成为可执行的流程。" FontSize="24"/><TextBlock Text="了解工具能力，或继续你的方案。" Foreground="#929DA6" Margin="0,7,0,0"/></StackPanel>
  <Grid Grid.Row="3" Margin="30,0,30,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <UniformGrid Rows="2" Columns="2">
    <Button Style="{StaticResource Capability}" Tag="图像处理" Click="Capability_Click"><StackPanel><TextBlock Text="▧" FontSize="30" Foreground="#FFAD52"/><TextBlock Text="图像处理" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="加载 · 滤波 · 二值化&#10;形态学" TextWrapping="Wrap" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Button>
    <Button Style="{StaticResource Capability}" Tag="定位与测量" Click="Capability_Click"><StackPanel><TextBlock Text="⊕" FontSize="30" Foreground="#FFAD52"/><TextBlock Text="定位与测量" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="轮廓匹配 · 直线／圆&#10;几何测量" TextWrapping="Wrap" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Button>
    <Button Style="{StaticResource Capability}" Tag="标定与坐标" Click="Capability_Click"><StackPanel><TextBlock Text="⌖" FontSize="30" Foreground="#FFAD52"/><TextBlock Text="标定与坐标" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="N 点标定&#10;坐标映射" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Button>
    <Button Style="{StaticResource Capability}" Tag="流程与通信" Click="Capability_Click"><StackPanel><TextBlock Text="⑂" FontSize="30" Foreground="#FFAD52"/><TextBlock Text="流程与通信" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="条件 · 子程序 · 脚本&#10;协议组装与收发" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Button>
   </UniformGrid>
   <Grid Grid.Column="1" Margin="18,0,0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="最近打开" FontSize="18" Margin="0,0,0,14"/>
    <ListBox x:Name="RecentFilesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#EDF1F3" HorizontalContentAlignment="Stretch" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown" AutomationProperties.AutomationId="RecentFiles">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,9"><DockPanel><TextBlock Text="{Binding DisplayTime}" DockPanel.Dock="Right" Foreground="#A7B0B8" FontSize="11"/><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="15"/></DockPanel><TextBlock Text="{Binding Path}" Foreground="#788D9B" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyRecentText" Grid.Row="1" Text="暂无最近方案，打开一个文件开始。" Foreground="#929DA6" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    <UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0"><Button Content="＋ 新建方案" Background="#FFAD52" Foreground="#211B13" Click="New_Click" AutomationProperties.AutomationId="NewSolution"/><Button Content="打开方案" Margin="0" Click="Open_Click" AutomationProperties.AutomationId="OpenSolution"/></UniformGrid>
   </Grid>
  </Grid>
  <Border Grid.Row="4" Background="#1C2227" Padding="30,16"><DockPanel><Button Content="浏览与管理方案 →" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Margin="0" Click="Manage_Click" AutomationProperties.AutomationId="ManageSolutions"/><TextBlock x:Name="StatusText" Text="新建空白方案，不使用模板。" Foreground="#929DA6" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
 </Grid></Border>
</Window>
