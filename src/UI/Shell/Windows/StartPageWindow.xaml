<Window x:Class="SunEyeVision.UI.Shell.Windows.StartPageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SunEyeVision · 起始页" Width="1000" Height="616" MinWidth="900" MinHeight="560"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource Startup.Background}" Foreground="{DynamicResource Startup.Text}" FontFamily="{DynamicResource Startup.Font}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Branding/StartupBranding.xaml"/></ResourceDictionary.MergedDictionaries>

   <!-- 扁平按钮：无边框，用于最近列表行与引导条 -->
   <Style x:Key="Flat" TargetType="Button">
    <Setter Property="Foreground" Value="#C8D2D8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="6,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="S" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="S" Property="Background" Value="#262C31"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="S" Property="Background" Value="#262C31"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <!-- 方案模板卡片：整块可点，悬停高亮边框与底部说明条 -->
   <Style x:Key="Card" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Shell" Background="#262B30" BorderBrush="#343B41" BorderThickness="1" CornerRadius="2">
      <Grid><ContentPresenter/></Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#2A3136"/><Setter TargetName="Shell" Property="BorderBrush" Value="#FFAD52"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#313A40"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FFAD52"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Setter Property="AutomationProperties.HelpText" Value="切换工具箱优先分类"/>
   </Style>

   <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#A7B0B8"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <StackPanel Orientation="Horizontal">
      <Border x:Name="Box" Width="15" Height="15" BorderBrush="#78858F" BorderThickness="1" Background="#20272D" CornerRadius="3">
       <TextBlock x:Name="Tick" Text="✓" Foreground="#211B13" HorizontalAlignment="Center" Visibility="Collapsed" FontSize="12"/>
      </Border>
      <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FFAD52"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFAD52"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF1F3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
   <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="0">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#242A2F"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#282F35"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <!-- 最近方案行：名称 + 相对时间，路径放 ToolTip，与原厂一致不含缩略图 -->
   <DataTemplate x:Key="RecentRow">
    <Grid Margin="0,2" ToolTip="{Binding Path}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Click="Recent_OpenClick" Padding="8,7">
      <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="#EEF1F3" TextTrimming="CharacterEllipsis"/>
     </Button>
     <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0">
      <TextBlock.Style><Style TargetType="TextBlock">
       <Setter Property="Foreground" Value="#8B959C"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Foreground" Value="#FFAD52"/><Setter Property="Text" Value="文件不可用"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <Button Grid.Column="2" Style="{StaticResource Flat}" Content="×" Padding="4,0" FontSize="14" Foreground="#7C868D" Click="Remove_Click" ToolTip="从列表移除（不删除文件）" AutomationProperties.Name="移除最近记录"/>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </Window.Resources>

 <Border BorderBrush="#3C444B" BorderThickness="1" Background="#121518" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Startup.Accent}"/>

   <!-- 顶部：品牌 + 不再显示 + 关闭 -->
   <Grid Grid.Row="1" Margin="28,20,20,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Image Source="{StaticResource Startup.BrandMark}" Width="42" Height="42" Margin="0,0,12,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="SunEyeVision" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="V1.0.0" Foreground="{StaticResource Startup.Muted}" FontSize="11" Margin="0,1,0,0"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
     <CheckBox x:Name="HideStartPageBox" Content="不再显示" Margin="0,9,14,0" Checked="HideStartPage_Changed" Unchecked="HideStartPage_Changed" AutomationProperties.AutomationId="HideStartPage"/>
     <Button Content="✕" Style="{StaticResource Flat}" FontSize="16" Padding="8,2" Click="Close_Click" ToolTip="关闭" AutomationProperties.AutomationId="CloseStartPage"/>
    </StackPanel>
   </Grid>

   <!-- 主体：方案模板四宫格 + 最近打开 -->
   <Grid x:Name="WelcomePanel" Grid.Row="2" Margin="28,22,20,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

    <UniformGrid Rows="2" Columns="2" Margin="0,0,4,0">
     <!-- 通用方案 -->
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="general" AutomationProperties.Name="通用方案">
      <Grid>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
       <Grid Margin="20,0,18,4">
        <TextBlock Text="通用方案" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#E6EBEE"/>
        <Viewbox Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
         <Canvas Width="40" Height="40">
          <Rectangle Canvas.Left="5" Canvas.Top="8" Width="30" Height="24" RadiusX="2" RadiusY="2" Stroke="#FFAD52" StrokeThickness="1.6" StrokeDashArray="3 2"/>
          <Path Data="M20 6 V34 M6 20 H34" Stroke="#FFAD52" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border Grid.Row="1" Background="#1B1F22"><TextBlock Text="建立普通空白方案" FontSize="12.5" Foreground="#A2ACB3" Margin="20,0" VerticalAlignment="Center"/></Border>
      </Grid>
     </Button>

     <!-- 定位测量 -->
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="locate" AutomationProperties.Name="定位测量">
      <Grid>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
       <Grid Margin="20,0,18,4">
        <TextBlock Text="定位测量" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#E6EBEE"/>
        <Viewbox Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
         <Canvas Width="40" Height="40">
          <Path Data="M4 20 A16 16 0 1 1 36 20 A16 16 0 1 1 4 20" Stroke="#FFAD52" StrokeThickness="1.6" StrokeDashArray="3 2"/>
          <Path Data="M20 4 V10 M20 30 V36 M4 20 H10 M30 20 H36" Stroke="#FFAD52" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="16" Canvas.Top="16" Width="8" Height="8" Fill="#FFAD52"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border Grid.Row="1" Background="#1B1F22"><TextBlock Text="通过定位、测量工具进行设计" FontSize="12.5" Foreground="#A2ACB3" Margin="20,0" VerticalAlignment="Center"/></Border>
      </Grid>
     </Button>

     <!-- 缺陷检测 -->
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="detect" AutomationProperties.Name="缺陷检测">
      <Grid>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
       <Grid Margin="20,0,18,4">
        <TextBlock Text="缺陷检测" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#E6EBEE"/>
        <Viewbox Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
         <Canvas Width="40" Height="40">
          <Path Data="M14 34 L30 8" Stroke="#FFAD52" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M22 30 A6 6 0 1 1 21.9 30" Stroke="#FFAD52" StrokeThickness="1.6"/>
          <Path Data="M6 30 H34" Stroke="#FFAD52" StrokeThickness="1.4" StrokeDashArray="2 2"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border Grid.Row="1" Background="#1B1F22"><TextBlock Text="借助检测工具查找工件缺陷" FontSize="12.5" Foreground="#A2ACB3" Margin="20,0" VerticalAlignment="Center"/></Border>
      </Grid>
     </Button>

     <!-- 用于识别 -->
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="identify" AutomationProperties.Name="用于识别">
      <Grid>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
       <Grid Margin="20,0,18,4">
        <TextBlock Text="用于识别" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#E6EBEE"/>
        <Viewbox Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
         <Canvas Width="40" Height="40">
          <Path Data="M10 12 H8 V8 H12 M28 8 H32 V12 M32 28 V32 H28 M12 32 H8 V28" Stroke="#FFAD52" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M18 10 V30 M22 10 V30 M26 10 V30 M30 10 V30" Stroke="#FFAD52" StrokeThickness="1.8"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border Grid.Row="1" Background="#1B1F22"><TextBlock Text="通过识别工具进行方案设计" FontSize="12.5" Foreground="#A2ACB3" Margin="20,0" VerticalAlignment="Center"/></Border>
      </Grid>
     </Button>
    </UniformGrid>

    <!-- 最近打开方案 -->
    <Border Grid.Column="1" BorderBrush="#343B42" BorderThickness="1,0,0,0" Padding="18,0,0,4">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
       <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="Open_Click" ToolTip="打开其他方案" AutomationProperties.Name="打开其他方案" VerticalAlignment="Top">
        <Viewbox Width="18" Height="18"><Canvas Width="20" Height="20">
         <Path Data="M2 6 H8 L10 8 H18 V17 H2 Z" Stroke="#A8BAC7" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent"/>
        </Canvas></Viewbox>
       </Button>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="2" Height="16" Background="{StaticResource Startup.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="最近打开方案" FontSize="16" VerticalAlignment="Center"/>
       </StackPanel>
      </DockPanel>
      <ListBox x:Name="RecentFilesList" Grid.Row="1" ItemTemplate="{StaticResource RecentRow}" KeyDown="Recent_KeyDown" AutomationProperties.AutomationId="RecentFiles"/>
      <TextBlock x:Name="EmptyRecentText" Grid.Row="1" Text="暂无最近方案" Foreground="#8B959C" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
      <TextBlock Grid.Row="2" Text="关闭本窗口即进入空白方案，可直接拖入工具开始设计" Foreground="#7C868D" FontSize="11.5" Margin="2,10,0,0"/>
      
     </Grid>
    </Border>
   </Grid>

   <!-- 底部三段引导条（对齐原厂 GuideWindow） -->
   <Border Grid.Row="3" Background="#191D20" BorderBrush="#2A2F33" BorderThickness="0,1,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource Flat}" Click="Guide_Click" Tag="learn" Padding="18,10" HorizontalContentAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="1" FontSize="34" FontWeight="Bold" Foreground="#3A4247" Margin="0,0,10,0" VerticalAlignment="Center"/>
       <TextBlock Text="学习使用 SunEyeVision" FontSize="14" Foreground="#C8D2D8" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Border Grid.Column="1" Background="#2A2F33"/>
     <Button Grid.Column="2" Style="{StaticResource Flat}" Click="Guide_Click" Tag="sample" Padding="18,10" HorizontalContentAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="2" FontSize="34" FontWeight="Bold" Foreground="#3A4247" Margin="0,0,10,0" VerticalAlignment="Center"/>
       <TextBlock Text="查看示例方案" FontSize="14" Foreground="#C8D2D8" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Border Grid.Column="3" Background="#2A2F33"/>
     <Button Grid.Column="4" Style="{StaticResource Flat}" Click="Guide_Click" Tag="support" Padding="18,10" HorizontalContentAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="3" FontSize="34" FontWeight="Bold" Foreground="#3A4247" Margin="0,0,10,0" VerticalAlignment="Center"/>
       <TextBlock Text="获取更多支持和帮助" FontSize="14" Foreground="#C8D2D8" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <TextBlock x:Name="StatusText" Grid.Column="5" Text="" Foreground="#8B959C" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,18,0" TextWrapping="Wrap" MaxWidth="320">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
