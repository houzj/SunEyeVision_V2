<Window x:Class="SunEyeVision.UI.Shell.Windows.StartPageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SunEyeVision · 起始页" Width="1100" Height="760" MinWidth="960" MinHeight="700"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource Startup.Background}" Foreground="{DynamicResource Startup.Text}" FontFamily="{DynamicResource Startup.Font}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Branding/StartupBranding.xaml"/></ResourceDictionary.MergedDictionaries>

   <!-- 悬停切换图：原件卡片/引导条均为 normal + click 两张整图 -->
   <Style x:Key="ClickOverlay" TargetType="Image">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType=ButtonBase}}" Value="True">
      <Setter Property="Visibility" Value="Visible"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>

   <!-- 扁平按钮 -->
   <Style x:Key="Flat" TargetType="Button">
    <Setter Property="Foreground" Value="#C8D2D8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="6,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="S" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="S" Property="Background" Value="#262C31"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="S" Property="Background" Value="#262C31"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <!-- 方案模板卡片：直接渲染原件 188x130 整图，悬停换 click 图 -->
   <Style x:Key="Card" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="300"/><Setter Property="Height" Value="208"/>
    <Setter Property="Margin" Value="0,0,22,22"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Shell" Background="#23282D" BorderBrush="#313840" BorderThickness="1" CornerRadius="3">
      <Grid>
       <!-- 悬停时左侧亮起强调色竖条，与主题一致 -->
       <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Background="#FFAD52" Opacity="0"/>
       <ContentPresenter/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Shell" Property="Background" Value="#2A3137"/>
       <Setter TargetName="Shell" Property="BorderBrush" Value="#FFAD52"/>
       <Setter TargetName="Accent" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#2F373E"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FFAD52"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#A7B0B8"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <StackPanel Orientation="Horizontal">
      <Border x:Name="Box" Width="15" Height="15" CornerRadius="3" BorderBrush="#78858F" BorderThickness="1" Background="#20272D" VerticalAlignment="Center">
       <Path x:Name="Tick" Data="M3 8 L6.5 11.5 L12 4.5" Stroke="#211B13" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
      </Border>
      <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FFAD52"/><Setter TargetName="Box" Property="BorderBrush" Value="#FFAD52"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF1F3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
   <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Row" Background="Transparent" CornerRadius="3"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#242A2F"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#282F35"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <DataTemplate x:Key="RecentRow">
    <Grid Margin="0,2" ToolTip="{Binding Path}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Click="Recent_OpenClick" Padding="8,7">
      <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="#EEF1F3" TextTrimming="CharacterEllipsis"/>
     </Button>
     <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0">
      <TextBlock.Style><Style TargetType="TextBlock">
       <Setter Property="Foreground" Value="#8B959C"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Foreground" Value="#FFAD52"/><Setter Property="Text" Value="文件不可用"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <Button Grid.Column="2" Style="{StaticResource Flat}" Content="×" Padding="4,0" FontSize="14" Foreground="#7C868D" Click="Remove_Click" ToolTip="从列表移除（不删除文件）" AutomationProperties.Name="移除最近记录"/>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </Window.Resources>

 <Border BorderBrush="#3C444B" BorderThickness="1" Background="#121518" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Startup.Accent}"/>

   <!-- 顶部：品牌 + 不再显示 + 关闭 -->
   <Grid Grid.Row="1" Margin="32,22,24,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Image Source="{StaticResource Startup.BrandMark}" Width="62" Height="62" Margin="0,0,18,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="SunEyeVision" FontSize="36" FontWeight="SemiBold" Foreground="#F2F6F8"/>
      <TextBlock Text="V1.0.0" Foreground="#8B959C" FontSize="13" Margin="2,3,0,0"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
     <CheckBox x:Name="HideStartPageBox" Content="不再显示" Margin="0,9,14,0" Checked="HideStartPage_Changed" Unchecked="HideStartPage_Changed" AutomationProperties.AutomationId="HideStartPage"/>
     <Button Style="{StaticResource Flat}" Padding="6,2" Click="Close_Click" ToolTip="关闭" AutomationProperties.AutomationId="CloseStartPage" AutomationProperties.Name="关闭起始页">
      <TextBlock Text="✕" FontSize="16"/>
     </Button>
    </StackPanel>
   </Grid>

   <!-- 主体：原件卡片四宫格 + 最近打开 -->
   <Grid x:Name="WelcomePanel" Grid.Row="2" Margin="28,14,20,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

    <UniformGrid Rows="2" Columns="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,8">
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="general" AutomationProperties.Name="通用方案">
      <Grid>
       <Grid Margin="26,18,22,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="通用方案" FontSize="22" FontWeight="SemiBold" Foreground="#E9EEF1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,44"/>
        <Viewbox Grid.Column="1" Width="104" Height="104" VerticalAlignment="Center" Margin="0,0,0,30">
         <Canvas Width="100" Height="100">
          <Rectangle Canvas.Left="8" Canvas.Top="14" Width="84" Height="72" RadiusX="5" RadiusY="5" Stroke="#55FFAD52" StrokeThickness="1.6" StrokeDashArray="4 3"/>
          <Rectangle Canvas.Left="20" Canvas.Top="30" Width="22" Height="16" RadiusX="3" RadiusY="3" Stroke="#FFAD52" StrokeThickness="2"/>
          <Rectangle Canvas.Left="58" Canvas.Top="52" Width="22" Height="16" RadiusX="3" RadiusY="3" Stroke="#FFAD52" StrokeThickness="2"/>
          <Path Data="M42 38 H52 V60 H58" Stroke="#FFAD52" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="38" Canvas.Top="34" Width="8" Height="8" Fill="#FFAD52"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border VerticalAlignment="Bottom" Height="38" Background="#1B1F23" BorderBrush="#2A3036" BorderThickness="0,1,0,0">
        <TextBlock Text="建立普通空白方案" FontSize="13" Foreground="#98A2A9" Margin="26,0" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </Button>
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="locate" AutomationProperties.Name="定位测量">
      <Grid>
       <Grid Margin="26,18,22,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="定位测量" FontSize="22" FontWeight="SemiBold" Foreground="#E9EEF1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,44"/>
        <Viewbox Grid.Column="1" Width="104" Height="104" VerticalAlignment="Center" Margin="0,0,0,30">
         <Canvas Width="100" Height="100">
          <Ellipse Canvas.Left="22" Canvas.Top="22" Width="56" Height="56" Stroke="#FFAD52" StrokeThickness="2" StrokeDashArray="3 4"/>
          <Path Data="M50 8 V26 M50 74 V92 M8 50 H26 M74 50 H92" Stroke="#FFAD52" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="44" Canvas.Top="44" Width="12" Height="12" Stroke="#FFAD52" StrokeThickness="2"/>
          <Path Data="M50 50 L72 34" Stroke="#FFAD52" StrokeThickness="1.6" StrokeDashArray="2 3"/>
          <Ellipse Canvas.Left="47" Canvas.Top="47" Width="6" Height="6" Fill="#FFAD52"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border VerticalAlignment="Bottom" Height="38" Background="#1B1F23" BorderBrush="#2A3036" BorderThickness="0,1,0,0">
        <TextBlock Text="通过定位、测量工具进行设计" FontSize="13" Foreground="#98A2A9" Margin="26,0" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </Button>
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="detect" AutomationProperties.Name="缺陷检测">
      <Grid>
       <Grid Margin="26,18,22,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="缺陷检测" FontSize="22" FontWeight="SemiBold" Foreground="#E9EEF1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,44"/>
        <Viewbox Grid.Column="1" Width="104" Height="104" VerticalAlignment="Center" Margin="0,0,0,30">
         <Canvas Width="100" Height="100">
          <Path Data="M10 26 H90 M10 70 H90" Stroke="#55FFAD52" StrokeThickness="1.6" StrokeDashArray="4 3"/>
          <Path Data="M32 34 L36 44 L31 52 L36 62 L32 68" Stroke="#FFAD52" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Rectangle Canvas.Left="24" Canvas.Top="28" Width="24" Height="46" RadiusX="2" RadiusY="2" Stroke="#FFAD52" StrokeThickness="1.6" StrokeDashArray="3 2"/>
          <Ellipse Canvas.Left="56" Canvas.Top="46" Width="28" Height="28" Stroke="#FFAD52" StrokeThickness="2"/>
          <Path Data="M79 69 L89 79" Stroke="#FFAD52" StrokeThickness="2.6" StrokeStartLineCap="Round"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border VerticalAlignment="Bottom" Height="38" Background="#1B1F23" BorderBrush="#2A3036" BorderThickness="0,1,0,0">
        <TextBlock Text="借助检测工具查找工件缺陷" FontSize="13" Foreground="#98A2A9" Margin="26,0" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </Button>
     <Button Style="{StaticResource Card}" Click="Template_Click" Tag="identify" AutomationProperties.Name="用于识别">
      <Grid>
       <Grid Margin="26,18,22,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="用于识别" FontSize="22" FontWeight="SemiBold" Foreground="#E9EEF1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,44"/>
        <Viewbox Grid.Column="1" Width="104" Height="104" VerticalAlignment="Center" Margin="0,0,0,30">
         <Canvas Width="100" Height="100">
          <Path Data="M18 28 V18 H28 M72 18 H82 V28 M82 72 V82 H72 M28 82 H18 V72" Stroke="#FFAD52" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M32 34 V66 M38 34 V66 M44 34 V66 M50 34 V66 M56 34 V66 M62 34 V66 M68 34 V66" Stroke="#FFAD52" StrokeThickness="2.2"/>
          <Path Data="M26 74 H74" Stroke="#55FFAD52" StrokeThickness="1.6" StrokeDashArray="4 3"/>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border VerticalAlignment="Bottom" Height="38" Background="#1B1F23" BorderBrush="#2A3036" BorderThickness="0,1,0,0">
        <TextBlock Text="通过识别工具进行方案设计" FontSize="13" Foreground="#98A2A9" Margin="26,0" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </Button>
    </UniformGrid>

    <!-- 最近打开方案 -->
    <Border Grid.Column="1" BorderBrush="#343B42" BorderThickness="1,0,0,0" Padding="18,0,0,4">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10"> 
<Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Padding="5,4" Click="Open_Click" ToolTip="浏览并打开其他方案文件" AutomationProperties.Name="打开其他方案" VerticalAlignment="Center">
        <Viewbox Width="22" Height="22">
         <Canvas Width="22" Height="22">
          <Path Data="M2.6 6.4 A1.9 1.9 0 0 1 4.5 4.5 H7.7 L9.6 6.5 H15.4 A1.9 1.9 0 0 1 17.3 8.4 V13.9 A1.9 1.9 0 0 1 15.4 15.8 H4.5 A1.9 1.9 0 0 1 2.6 13.9 Z" Stroke="#C2CDD4" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent">
           <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType=ButtonBase}}" Value="True"><Setter Property="Stroke" Value="#FFAD52"/></DataTrigger></Style.Triggers></Style></Path.Style>
          </Path>
          <Path Data="M2.6 9.2 H17.3" Stroke="#7C868D" StrokeThickness="1.2"/>
         </Canvas>
        </Viewbox>
       </Button>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="2" Height="16" Background="{StaticResource Startup.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="最近打开方案" FontSize="16" VerticalAlignment="Center"/>
       </StackPanel>
      </DockPanel>
      <ListBox x:Name="RecentFilesList" Grid.Row="1" ItemTemplate="{StaticResource RecentRow}" KeyDown="Recent_KeyDown" AutomationProperties.AutomationId="RecentFiles"/>
      <TextBlock x:Name="EmptyRecentText" Grid.Row="1" Text="暂无最近方案" Foreground="#8B959C" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
      
     </Grid>
    </Border>
   </Grid>

   <!-- 底部三段引导条（原件 ic_1/2/3 图标） -->
   <Border Grid.Row="3" Height="88" Background="#191D20" BorderBrush="#2A2F33" BorderThickness="0,1,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource Flat}" Click="Guide_Click" Tag="learn" Padding="18,12" VerticalAlignment="Center" HorizontalContentAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="1" FontSize="36" FontWeight="Bold" Foreground="#FFAD52" Opacity="0.55" Width="30" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0"/>
       <TextBlock Text="学习使用 SunEyeVision" FontSize="15" Foreground="#C8D2D8" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Border Grid.Column="1" Background="#2A2F33"/>
     <Button Grid.Column="2" Style="{StaticResource Flat}" Click="Guide_Click" Tag="sample" Padding="18,12" VerticalAlignment="Center" HorizontalContentAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="2" FontSize="36" FontWeight="Bold" Foreground="#FFAD52" Opacity="0.55" Width="30" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0"/>
       <TextBlock Text="查看示例方案" FontSize="15" Foreground="#C8D2D8" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Border Grid.Column="3" Background="#2A2F33"/>
     <Button Grid.Column="4" Style="{StaticResource Flat}" Click="Guide_Click" Tag="support" Padding="18,12" VerticalAlignment="Center" HorizontalContentAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="3" FontSize="36" FontWeight="Bold" Foreground="#FFAD52" Opacity="0.55" Width="30" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0"/>
       <TextBlock Text="获取更多支持和帮助" FontSize="15" Foreground="#C8D2D8" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <TextBlock x:Name="StatusText" Grid.Column="5" Text="" Foreground="#8B959C" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,18,0" TextWrapping="Wrap" MaxWidth="320">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
