<Window x:Class="SunEyeVision.UI.Shell.Windows.StartPageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SunEyeVision · 起始页" Width="960" Height="720" MinWidth="860" MinHeight="620"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Startup.Background}" Foreground="{DynamicResource Startup.Text}" FontFamily="{DynamicResource Startup.Font}">
 <Window.Resources>
 <ResourceDictionary>
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SunEyeVision.UI;component/Resources/Branding/StartupBranding.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEF1F3"/><Setter Property="Background" Value="#242E36"/><Setter Property="BorderBrush" Value="#52616D"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30352F"/><Setter TargetName="Surface" Property="BorderBrush" Value="#FFAD52"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFAD52"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#44382A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FFAD52"/><Setter Property="Foreground" Value="#211B13"/><Setter Property="BorderBrush" Value="#FFAD52"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="7,5"/><Setter Property="Foreground" Value="#A8BAC7"/></Style>
  <Style x:Key="Capability" TargetType="Border"><Setter Property="Background" Value="#20272D"/><Setter Property="BorderBrush" Value="#3C474F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#A7B0B8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="15" Height="15" BorderBrush="#78858F" BorderThickness="1" Background="#20272D" CornerRadius="3"><TextBlock x:Name="Tick" Text="✓" Foreground="#211B13" HorizontalAlignment="Center" Visibility="Collapsed" FontSize="12"/></Border><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FFAD52"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFAD52"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFAD52"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF1F3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#22292F"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#28333B"/><Setter TargetName="Row" Property="BorderBrush" Value="#52616D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="RecentRow"><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Border Width="28" Height="34" BorderBrush="#53616B" BorderThickness="1" CornerRadius="4" Background="#1F2931"><TextBlock Text="SEV" FontSize="8" Foreground="#A3BDD0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><Button Grid.Column="1" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Recent_OpenClick" ToolTip="{Binding Path}"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="#EEF1F3" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#8396A4" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Button><TextBlock Grid.Column="2" Text="{Binding DisplayTime}" VerticalAlignment="Center" FontSize="11" Margin="10,0,4,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A7B0B8"/><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Foreground" Value="#FFAD52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="3" Content="×" Style="{StaticResource TextButton}" Click="Remove_Click" ToolTip="移除记录，不删除文件" AutomationProperties.Name="移除最近记录"/></Grid></DataTemplate>
 </ResourceDictionary>
 </Window.Resources>
 <Border BorderBrush="#3C444B" BorderThickness="1" Background="#121518"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource Startup.Accent}"/>
  <Grid Grid.Row="1" Margin="30,24" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Startup.BrandMark}" Width="44" Height="44" Margin="0,0,13,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SunEyeVision" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="BUILD YOUR VISION" Foreground="{StaticResource Startup.Muted}" FontSize="10"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><CheckBox x:Name="HideStartPageBox" Content="不再显示" Margin="0,8,18,0" Checked="HideStartPage_Changed" Unchecked="HideStartPage_Changed" AutomationProperties.AutomationId="HideStartPage"/><Button Content="×" Style="{StaticResource TextButton}" FontSize="23" Padding="7,0" Click="Close_Click" AutomationProperties.AutomationId="CloseStartPage"/></StackPanel></Grid>
  <Grid x:Name="WelcomePanel" Grid.Row="2" Margin="30,0,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,24"><TextBlock Text="让视觉想法，成为可执行的流程。" FontSize="24"/><TextBlock Text="了解工具能力，或继续你的方案。" Foreground="#929DA6" Margin="0,7,0,0"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><UniformGrid Rows="2" Columns="2">
<Border Style="{StaticResource Capability}"><Grid><StackPanel><Viewbox Width="36" Height="36" HorizontalAlignment="Left"><Canvas Width="40" Height="40"><Rectangle Canvas.Left="4" Canvas.Top="6" Width="32" Height="28" RadiusX="3" RadiusY="3" Stroke="#FFAD52" StrokeThickness="1.5"/><Path Data="M5 28 L14 18 21 26 26 20 35 29" Stroke="#FFAD52" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="24" Canvas.Top="11" Width="6" Height="6" Stroke="#FFAD52" StrokeThickness="1.5"/></Canvas></Viewbox><TextBlock Text="图像处理" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="从原始图像到清晰的特征&#10;加载 · 滤波 · 二值化 · 形态学" TextWrapping="Wrap" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Grid></Border>
<Border Style="{StaticResource Capability}"><Grid><StackPanel><Viewbox Width="36" Height="36" HorizontalAlignment="Left"><Canvas Width="40" Height="40"><Ellipse Canvas.Left="8" Canvas.Top="8" Width="24" Height="24" Stroke="#FFAD52" StrokeThickness="1.5"/><Path Data="M20 2 V11 M20 29 V38 M2 20 H11 M29 20 H38" Stroke="#FFAD52" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="18" Canvas.Top="18" Width="4" Height="4" Stroke="#FFAD52" StrokeThickness="1.5"/></Canvas></Viewbox><TextBlock Text="定位与测量" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="寻找目标，量化几何关系&#10;轮廓匹配 · 直线／圆 · 距离" TextWrapping="Wrap" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Grid></Border>
<Border Style="{StaticResource Capability}"><Grid><StackPanel><Viewbox Width="36" Height="36" HorizontalAlignment="Left"><Canvas Width="40" Height="40"><Path Data="M8 32 V6 M8 32 H34 M5 10 L8 5 11 10 M29 29 L35 32 29 35" Stroke="#FFAD52" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M13 25 L22 15 31 20" Stroke="#FFAD52" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="11" Canvas.Top="23" Width="4" Height="4" Stroke="#FFAD52" StrokeThickness="1.5"/><Ellipse Canvas.Left="20" Canvas.Top="13" Width="4" Height="4" Stroke="#FFAD52" StrokeThickness="1.5"/><Ellipse Canvas.Left="29" Canvas.Top="18" Width="4" Height="4" Stroke="#FFAD52" StrokeThickness="1.5"/></Canvas></Viewbox><TextBlock Text="标定与坐标" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="建立图像与物理坐标的联系&#10;N 点标定 · 坐标转换" TextWrapping="Wrap" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Grid></Border>
<Border Style="{StaticResource Capability}"><Grid><StackPanel><Viewbox Width="36" Height="36" HorizontalAlignment="Left"><Canvas Width="40" Height="40"><Rectangle Canvas.Left="3" Canvas.Top="15" Width="10" Height="10" RadiusX="2" RadiusY="2" Stroke="#FFAD52" StrokeThickness="1.5"/><Rectangle Canvas.Left="27" Canvas.Top="4" Width="10" Height="10" RadiusX="2" RadiusY="2" Stroke="#FFAD52" StrokeThickness="1.5"/><Rectangle Canvas.Left="27" Canvas.Top="26" Width="10" Height="10" RadiusX="2" RadiusY="2" Stroke="#FFAD52" StrokeThickness="1.5"/><Path Data="M13 20 H20 V9 H27 M20 20 V31 H27" Stroke="#FFAD52" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="流程与通信" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="连接工具，组织业务逻辑&#10;条件分支 · 子程序 · 脚本 · 通信" TextWrapping="Wrap" Foreground="#A7B0B8" FontSize="12"/></StackPanel></Grid></Border>
</UniformGrid><Border Grid.Column="1" BorderBrush="#343B42" BorderThickness="1,0,0,0" Padding="24,0,0,14" Margin="10,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="打开其他方案 ↗" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Click="Open_Click" FontSize="11"/><TextBlock Text="▎最近打开" FontSize="17" VerticalAlignment="Center"/></DockPanel><ListBox x:Name="RecentFilesList" Grid.Row="1" ItemTemplate="{StaticResource RecentRow}" KeyDown="Recent_KeyDown" AutomationProperties.AutomationId="RecentFiles"/><TextBlock x:Name="EmptyRecentText" Grid.Row="1" Text="暂无最近方案，打开一个文件开始。" Foreground="#929DA6" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap"/><UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0"><Button Content="＋ 新建方案" Style="{StaticResource Primary}" Margin="0,0,10,0" Click="New_Click" AutomationProperties.AutomationId="NewSolution"/><Button Content="打开方案" Click="Open_Click" AutomationProperties.AutomationId="OpenSolution"/></UniformGrid></Grid></Border></Grid></Grid>
  <Border Grid.Row="3" Background="#1C2227" Padding="30,16"><DockPanel><TextBlock x:Name="StatusText" Text="新建空白方案，不使用模板。" Foreground="#929DA6" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
 </Grid></Border>
</Window>
