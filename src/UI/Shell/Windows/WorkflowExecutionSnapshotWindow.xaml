<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.WorkflowExecutionSnapshotWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
 Title="耗时查看" Width="370" Height="420" MinWidth="370" MinHeight="260"
 FontFamily="Microsoft YaHei" FontSize="13" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource ThemeWindowBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
 <Window.Resources>
  <Style x:Key="TimingText" TargetType="TextBlock"><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="TimingRow" TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border Background="{DynamicResource ThemeControlBackgroundBrush}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
   <TextBlock Text="流程耗时" FontWeight="Bold"/><TextBlock x:Name="FlowTimeValue" Text="{Binding Elapsed.TotalMilliseconds,Mode=OneWay,StringFormat={}{0:N2}}" Margin="5,0,0,0" FontWeight="Bold"/><TextBlock Text=" ms" FontWeight="Bold"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="18,0,18,13" Grid.IsSharedSizeScope="True">
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="{DynamicResource ThemeControlBackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="模块名称" Style="{StaticResource TimingText}" FontWeight="Bold"/>
    <TextBlock Grid.Column="1" Text="工具耗时" Style="{StaticResource TimingText}" FontWeight="Bold"/>
    <TextBlock Grid.Column="2" Text="算法耗时" Style="{StaticResource TimingText}" FontWeight="Bold"/>
   </Grid>
   <ListView x:Name="TimingList" Grid.Row="1" ItemsSource="{Binding Nodes}" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimaryBrush}" BorderThickness="0" Padding="0"
    ItemContainerStyle="{StaticResource TimingRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="根流程模块耗时">
    <ListView.ItemTemplate><DataTemplate><Grid Height="34" ToolTip="{Binding Status}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding NodeName}" ToolTip="{Binding NodeName}" Style="{StaticResource TimingText}"/>
     <TextBlock Grid.Column="1"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TimingText}"><Setter Property="Text" Value="{Binding ModuleElapsed.TotalMilliseconds,StringFormat={}{0:N2}}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="尚未运行"><Setter Property="Text" Value="—"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="等待中"><Setter Property="Text" Value="—"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBlock Grid.Column="2"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TimingText}"><Setter Property="Text" Value="{Binding AlgorithmElapsedMs,StringFormat={}{0:N2}}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="尚未运行"><Setter Property="Text" Value="—"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="等待中"><Setter Property="Text" Value="—"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid></DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
 </Grid>
</local:ThemeDialogWindow>
