<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.WorkflowExecutionSnapshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows"
    xmlns:base="clr-namespace:SunEyeVision.UI.Themes.Base"
    Title="执行快照" Width="620" Height="520" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource {x:Static base:ThemeKeys.WindowBackgroundBrush}}">
    <Window.Resources>
        <Style x:Key="SnapshotHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableHeaderBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TableHeaderTextBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SnapshotRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowHoverBackgroundBrush}}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapshotCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static base:ThemeKeys.TableRowSelectedBackgroundBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding WorkflowName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"/>
                <TextBlock Margin="0,6,0,12" Foreground="{DynamicResource {x:Static base:ThemeKeys.TextSecondaryBrush}}">
                    <Run Text="状态："/><Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text="    流程耗时："/><Run Text="{Binding Elapsed.TotalMilliseconds, Mode=OneWay, StringFormat={}{0:F2} ms}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Nodes}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="{DynamicResource {x:Static base:ThemeKeys.TableRowBackgroundBrush}}"
                  Foreground="{DynamicResource {x:Static base:ThemeKeys.TextPrimaryBrush}}"
                  BorderBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                  HorizontalGridLinesBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                  VerticalGridLinesBrush="{DynamicResource {x:Static base:ThemeKeys.TableGridLineBrush}}"
                  GridLinesVisibility="All"
                  ColumnHeaderStyle="{StaticResource SnapshotHeaderStyle}"
                  RowStyle="{StaticResource SnapshotRowStyle}"
                  CellStyle="{StaticResource SnapshotCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="模块名称" Binding="{Binding NodeName, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="执行状态" Binding="{Binding Status, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="模块耗时(ms)" Binding="{Binding ModuleElapsed.TotalMilliseconds, Mode=OneWay, StringFormat={}{0:F2}}" Width="130"/>
                <DataGridTextColumn Header="算法耗时(ms)" Binding="{Binding AlgorithmElapsedMs, Mode=OneWay, StringFormat={}{0:F2}}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</local:ThemeDialogWindow>
