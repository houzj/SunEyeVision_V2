<local:ThemeDialogWindow x:Class="SunEyeVision.UI.Shell.Windows.WorkflowIdSearchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SunEyeVision.UI.Shell.Windows" Title="按ID定位模块" Width="400" Height="170" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource ThemePanelBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" PreviewKeyDown="WindowKeyDown">
 <Grid Margin="18,16"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
   <TextBlock Text="模块ID" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <TextBox x:Name="Query" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="QueryChanged" ToolTip="输入完整节点序号、节点稳定ID或根流程稳定ID"/>
   <Button x:Name="Search" Grid.Column="2" Margin="12,0,0,0" Content="搜索" IsDefault="True" Click="SearchClick"/>
  </Grid>
  <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="全部流程 · 按完整序号或稳定ID精确匹配" FontSize="11" Opacity="0.7"/>
  <TextBlock x:Name="Error" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
 </Grid>
</local:ThemeDialogWindow>
