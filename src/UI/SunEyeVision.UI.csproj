<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SunEyeVision.UI</RootNamespace>
    <AssemblyName>SunEyeVision.UI</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutDir)SunEyeVision.UI.xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UseWpfHotReload>false</UseWpfHotReload>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Icons/suneyevision.ico</ApplicationIcon>
  </PropertyGroup>

    <ItemGroup>
    <PackageReference Include="AIStudio.Wpf.DiagramDesigner" Version="1.3.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260222" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260222" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260222" />
    <PackageReference Include="RoyT.AStar" Version="3.0.2" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.2" />


    <PackageReference Include="Msagl" Version="1.2.1" />
    <PackageReference Include="Msagl.Drawing" Version="1.2.1" />
    <PackageReference Include="Msagl.WpfGraphControl" Version="1.2.1" />
  </ItemGroup>

  <Import Project="../../product/ToolComponents.props" />
  <ItemGroup>
    <ProjectReference Include="@(ProductToolComponent->'../../%(Identity)')" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Application\SunEyeVision.Application.csproj" />
    <ProjectReference Include="..\Infrastructure.Persistence\SunEyeVision.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Core\SunEyeVision.Core.csproj" />
    <ProjectReference Include="..\Domain\SunEyeVision.Domain.csproj" />
    <ProjectReference Include="..\Plugin.Editing.Wpf\SunEyeVision.Plugin.Editing.Wpf.csproj" />
    <ProjectReference Include="..\Plugin.Editing.Wpf\SunEyeVision.Plugin.Editing.Wpf.csproj" />
    <ProjectReference Include="..\Plugin.Wpf\SunEyeVision.Plugin.Wpf.csproj" />
    <ProjectReference Include="..\Plugin.Infrastructure\SunEyeVision.Plugin.Infrastructure.csproj" />
    <ProjectReference Include="..\DeviceDriver\SunEyeVision.DeviceDriver.csproj" />
    <ProjectReference Include="..\DeviceDriver.Camera\SunEyeVision.DeviceDriver.Camera.csproj" />
    <ProjectReference Include="..\Infrastructure.ImageSources\SunEyeVision.Infrastructure.ImageSources.csproj" />
  </ItemGroup>

  <!-- 测试项目可访问 internal（对齐 Plugin.SDK.csproj:52 既有做法，仅测试基础设施，不改业务代码） -->
  <ItemGroup>
    <InternalsVisibleTo Include="SunEyeVision.UI.Tests" />
    <InternalsVisibleTo Include="SunEyeVision.CanvasLayout.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Help\Output\**\*.*">
      <Link>Help\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icons\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="生成光之眼-Logo-_1__副本.ico" />
    <!-- 起始页和品牌资源 -->
    <Resource Include="Icons/app_logo.ico" />
    <Resource Include="Icons/suneyevision.ico" />
    <Resource Include="Icons/solution.ico" />
  </ItemGroup>

  

  <ItemGroup>
    <Resource Include="Resources\Toolbox\*.png" />
    <Resource Include="Resources\Toolbox\ToolboxDisplayCatalog.json" />
    <Resource Include="Resources\Workflow\*.png" />
    <Resource Include="..\Plugin.Editing.Wpf\Metadata\ToolGroups.xml" Link="Resources\Toolbox\ToolGroups.xml" />
    <Content Include="..\Plugin.Editing.Wpf\Metadata\ToolGroups.xml" Link="ToolGroups.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Group/legacy parameter editor source is retained, but unavailable until its Runtime migration. -->
  <ItemGroup>
    <Compile Remove="Services\Editing\EditorDraftAdapter.cs;Services\Editing\GroupRunParameterConfigWindow.cs;Services\Editing\GroupRegionParameterControl.cs;Services\Editing\GroupRunParametersControl.cs;Services\Editing\GroupRunParameterSession.cs;Shell\Windows\MainWindowGroupEditing.cs;Features\WorkflowUI\Commands\AddGroupNodeCommand.cs" />
  </ItemGroup>
  <!-- Old communication editor is unavailable; keep only existing nonvisual device and parser support. -->
  <ItemGroup>
    <Page Remove="Features\CommunicationManager\**\*.xaml" />
    <Compile Remove="Features\CommunicationManager\**\*.cs" />
    <Compile Include="Features\CommunicationManager\CommunicationDeviceSnapshotFactory.cs;Features\CommunicationManager\CommunicationEventViewModels.cs;Features\CommunicationManager\CommunicationReceiveProcessor.cs;Features\CommunicationManager\CommunicationReceiveTargetKind.cs;Features\CommunicationManager\CommunicationSeparators.cs;Features\CommunicationManager\ModbusSendTestEncoder.cs" />
  </ItemGroup>
</Project>

