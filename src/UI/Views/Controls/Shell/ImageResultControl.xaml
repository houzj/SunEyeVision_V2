<UserControl x:Class="SunEyeVision.UI.Views.Controls.Shell.ImageResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:SunEyeVision.UI.Views.Controls.Panels"
             xmlns:sdk="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:convertersUI="clr-namespace:SunEyeVision.UI.Converters.UI"
             xmlns:convertersVisibility="clr-namespace:SunEyeVision.UI.Converters.Visibility"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700">

    <UserControl.Resources>
        <convertersUI:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convertersVisibility:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>  <!-- 图像显示模块 -->
            <RowDefinition Height="Auto"/>  <!-- 图像加载及预览模块 -->
        </Grid.RowDefinitions>

        <!-- 图像显示模块 - 使用TabControl -->
        <Border Grid.Row="0" BorderThickness="0">
            <TabControl x:Name="ImageDisplayTabControl"
                        Background="White"
                        BorderThickness="0">
                <!-- 第一个TabItem: 图像结果 -->
                <TabItem Header="图像结果" Padding="12,6">
                    <Border Background="Transparent">
                        <sdk:ImageControl x:Name="ImageDisplayContent"
                                          SourceImage="{Binding DisplayImage}"
                                          ShowToolBar="True"
                                          ShowStatusBar="True"
                                          ShowChessboardBackground="True"
                                          EnablePanning="True"
                                          EnableZoom="True"
                                          AutoFitMode="FirstOnly"
                                          ImageSources="{Binding DisplayImageSources}"
                                          SelectedImageSourceIndex="{Binding SelectedDisplayImageSourceIndex, Mode=TwoWay}"
                                          ImageLoaded="OnImageLoaded"
                                          ZoomChanged="OnZoomChanged"/>
                    </Border>
                </TabItem>

                <!-- 第二个TabItem: 模块结果 - DataGrid 实现 -->
                <TabItem Header="模块结果" Padding="12,6">
                    <Grid Background="White">
                        <DataGrid x:Name="ModuleResultDataGrid"
                                  ItemsSource="{Binding FlatResultRows}"
                                  AutoGenerateColumns="False"
                                  GridLinesVisibility="All"
                                  VerticalGridLinesBrush="#E5E5E5"
                                  HorizontalGridLinesBrush="#E5E5E5"
                                  BorderThickness="1"
                                  BorderBrush="#E0E0E0"
                                  RowHeaderWidth="0"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="White"
                                  HeadersVisibility="Column"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasModuleResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="24"/>
                                    <Setter Property="Height" Value="Auto"/>
                                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E8F4FD"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F7FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto" MinWidth="140" Header="结果名称">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="{Binding Indent}"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="ResultExpandIcon_Click">
                                                <TextBlock Text="{Binding ExpandIcon}"
                                                           FontSize="10" Foreground="#999999"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12"
                                                           FontWeight="{Binding FontWeight}"
                                                           Foreground="#333333"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" MinWidth="100" MaxWidth="300"
                                                    Header="当前值"
                                                    Binding="{Binding DisplayValue}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="350"
                                                               FontSize="11"
                                                               Foreground="#333333"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 空状态 -->
                        <Grid Visibility="{Binding HasModuleResults, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📊" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#CCCCCC"/>
                            <TextBlock Text="暂无计算结果" FontSize="12" Foreground="#999999"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                            <TextBlock Text="请选中已执行的节点查看结果" FontSize="10" Foreground="#CCCCCC"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,52,0,0"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 图像加载及预览模块 - 使用现代化的 ImagePreviewControl -->
        <!-- 绑定到 ActiveInputSource 实现每个采集节点独立的图像预览器 -->
        <!-- 新架构：使用 InputSource 替代 ImageData，输入源不被执行流程修改 -->
        <Border Grid.Row="1"
                Background="#F8F9FA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="2"
                Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVisibilityConverter}}">
            <panels:ImagePreviewControl x:Name="ImagePreviewContent"
                                         AutoSwitchEnabled="{Binding ActiveInputSource.AutoSwitchEnabled, Mode=TwoWay}"
                                         CurrentImageIndex="{Binding ActiveInputSource.CurrentIndex, Mode=TwoWay}"
                                         ImageCollection="{Binding ActiveInputSource.Images}"
                                         ImageRunMode="{Binding ActiveInputSource.RunMode, Mode=TwoWay}"/>
        </Border>
    </Grid>
</UserControl>
