  <ItemGroup><Compile Remove="AnnularSectorDisplayContractTests.cs;ArrayTreeFormatterTests.cs;DisplayCollectorGeometryContractTests.cs;FilterDataSourcesByTypeTests.cs;GeometryFieldSchemaContractTests.cs;RoiBindingContractTests.cs;RoiComposeAllContractTests.cs;RoiDesignTimeGroupsContractTests.cs;RoiDisplayTextContractTests.cs;RuntimeParameterSnapshotTests.cs;SolutionExecutionDependencyGraphTests.cs;SubroutineDisplayItemTypeContractTests.cs;ToolParameterSnapshotTests.cs;ViewportScalingContractTests.cs;WorkflowExecutionDependencyGraphTests.cs" /></ItemGroup>
