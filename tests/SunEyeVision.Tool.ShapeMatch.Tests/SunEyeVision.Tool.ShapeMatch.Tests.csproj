<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/SunEyeVision.Tool.ShapeMatch/SunEyeVision.Tool.ShapeMatch.csproj" />
  </ItemGroup>
  <!-- 工具插件(IsToolPlugin)主输出重定向到 dev/Debug/plugins/<Tool>/，
       测试运行目录(dev/Debug 根)需显式复制工具 dll 才能加载其类型（rule-017）。 -->
  <Target Name="CopyToolPluginForTests" AfterTargets="Build">
    <ItemGroup>
      <_ToolPluginDll Include="$(MSBuildProjectDirectory)\..\..\dev\Debug\plugins\SunEyeVision.Tool.ShapeMatch\SunEyeVision.Tool.ShapeMatch.dll" />
      <_ToolPluginPdb Include="$(MSBuildProjectDirectory)\..\..\dev\Debug\plugins\SunEyeVision.Tool.ShapeMatch\SunEyeVision.Tool.ShapeMatch.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_ToolPluginDll);@(_ToolPluginPdb)"
          DestinationFolder="$(MSBuildProjectDirectory)\..\..\dev\Debug\"
          SkipUnchangedFiles="true"
          Condition="Exists('%(FullPath)')" />
  </Target>
</Project>