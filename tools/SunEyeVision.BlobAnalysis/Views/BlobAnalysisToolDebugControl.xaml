<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.BlobAnalysis.Views.BlobAnalysisToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:designParameters="clr-namespace:SunEyeVision.Tool.BlobAnalysis"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Views;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Converters;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SunEyeVision.Tool.BlobAnalysis"
        xmlns:localConverters="clr-namespace:SunEyeVision.Tool.BlobAnalysis.Converters"
        xmlns:results="clr-namespace:SunEyeVision.Plugin.SDK.Execution.Results;assembly=SunEyeVision.Plugin.SDK"
        xmlns:presentation="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.ResultPresentation;assembly=SunEyeVision.Plugin.SDK"
        xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        d:DesignHeight="550" d:DesignWidth="400"
        d:DataContext="{d:DesignInstance Type=designParameters:BlobAnalysisParameters, IsDesignTimeCreatable=True}"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}"
        Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:DesignTimeThemeResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <localConverters:ThresholdTypeConverter x:Key="ThresholdTypeConverter"/>
            <localConverters:BlobSortModeConverter x:Key="BlobSortModeConverter"/>
            <localConverters:PreprocessMethodConverter x:Key="PreprocessMethodConverter"/>
            <localConverters:MorphOperationConverter x:Key="MorphOperationConverter"/>
            <localConverters:MorphElementShapeConverter x:Key="MorphElementShapeConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

    <!-- 主布局 -->
  <Grid>
    <TabControl Margin="5,0,5,0">
      <!-- Tab1: 基本参数 -->
      <TabItem Header="基本参数" IsSelected="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <controls:LabeledControl Label="输入图像"  HorizontalAlignment="Left">
              <controls:ImageSourceSelector
                                x:Name="imageSourceSelector"
                                PlaceholderText="请选择输入图像源"
                                Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"
                                SelectedDataSource="{Binding ImageSource, Mode=TwoWay}"/>
            </controls:LabeledControl>

            <!-- 区域设置（检测区域数量=0时全图分析，否则自动启用区域限制） -->
            <GroupBox Header="区域设置" Margin="0,8,0,0">
                <region:RoiEditorManagerControl x:Name="regionManager"
                    InspectionRoisSource="{Binding InspectionRois.Rois}"
                    MaskRoisSource="{Binding MaskRois.Rois}"/>
            </GroupBox>

            <!-- 位置修正 -->
            <controls:LabeledControl Label="位置修正" Margin="0,8,0,0" HorizontalAlignment="Left">
              <controls:ToggleSwitch
                  IsChecked="{Binding IsPositionCorrectionEnabled, Mode=TwoWay}"
                  SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="修正信息" Margin="0,4,0,0" HorizontalAlignment="Left"
                Visibility="{Binding IsPositionCorrectionEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ParamBinding
                  x:Name="positionCorrectionBinding"
                  DataType="{x:Type results:AffineMatrix}"
                  ParameterName="位置修正" Width="200"
                  BindingSource="{Binding PositionCorrectionBindingSource, Mode=TwoWay}"
                  BindingDisplayText="{Binding PositionCorrectionBindingDisplayText, Mode=OneWay}"
                  AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab2: 预处理参数 -->
      <TabItem Header="预处理参数">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <!-- ===== 图像预处理 ===== -->
            <Separator Margin="0,0,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="图像预处理" FontWeight="SemiBold" Margin="0,4,0,8"/>

            <controls:LabeledControl Label="启用预处理" ContentHorizontalAlignment="Left" Margin="0,0,0,4">
              <controls:ToggleSwitch
                IsChecked="{Binding IsPreprocessingEnabled, Mode=TwoWay}"
                SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="预处理方法"
              Visibility="{Binding IsPreprocessingEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <ComboBox Height="32" VerticalContentAlignment="Center" Width="250"
                SelectedItem="{Binding PreprocessMethodValue, Mode=TwoWay, Converter={StaticResource PreprocessMethodConverter}}">
                <sys:String>无</sys:String>
                <sys:String>均值滤波</sys:String>
                <sys:String>高斯滤波</sys:String>
                <sys:String>中值滤波</sys:String>
                <sys:String>直方图均衡化</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <controls:LabeledControl Label="滤波核大小"
              Visibility="{Binding IsPreprocessingEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ConfigSetting
                ParameterName="PreprocessKernelSize"
                DataType="{x:Type sys:Int32}"
                Value="{Binding PreprocessKernelSize, Mode=TwoWay}"
                Minimum="3" Maximum="31"
                SmallChange="2" LargeChange="4"
                Width="250"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <!-- ===== 阈值分割 ===== -->
            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="阈值分割" FontWeight="SemiBold" Margin="0,4,0,8"/>

            <controls:LabeledControl Label="阈值">
              <controls:ConfigSetting
                x:Name="thresholdParam"
                ParameterName="Threshold"
                DataType="{x:Type sys:Int32}"
                Value="{Binding Threshold, Mode=TwoWay}"
                Minimum="0" Maximum="255"
                SmallChange="1" LargeChange="10"
                ShowSlider="True" Width="250"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="最大值">
              <controls:ConfigSetting
                x:Name="maxValueParam"
                ParameterName="MaxValue"
                DataType="{x:Type sys:Int32}"
                Value="{Binding MaxValue, Mode=TwoWay}"
                Minimum="0" Maximum="255"
                SmallChange="1" LargeChange="10"
                ShowSlider="True" Width="250"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="阈值类型">
              <ComboBox x:Name="thresholdTypeComboBox"
                Height="32" VerticalContentAlignment="Center" Width="250"
                SelectedItem="{Binding Type, Mode=TwoWay, Converter={StaticResource ThresholdTypeConverter}}">
                <sys:String>Binary</sys:String>
                <sys:String>BinaryInv</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <!-- ===== 形态学处理 ===== -->
            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="形态学处理" FontWeight="SemiBold" Margin="0,4,0,8"/>

            <controls:LabeledControl Label="启用形态学" ContentHorizontalAlignment="Left" Margin="0,0,0,4">
              <controls:ToggleSwitch
                IsChecked="{Binding IsMorphologyEnabled, Mode=TwoWay}"
                SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="操作类型"
              Visibility="{Binding IsMorphologyEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <ComboBox Height="32" VerticalContentAlignment="Center" Width="250"
                SelectedItem="{Binding MorphOperationValue, Mode=TwoWay, Converter={StaticResource MorphOperationConverter}}">
                <sys:String>腐蚀</sys:String>
                <sys:String>膨胀</sys:String>
                <sys:String>开运算</sys:String>
                <sys:String>闭运算</sys:String>
                <sys:String>顶帽</sys:String>
                <sys:String>黑帽</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <controls:LabeledControl Label="结构元素"
              Visibility="{Binding IsMorphologyEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <ComboBox Height="32" VerticalContentAlignment="Center" Width="250"
                SelectedItem="{Binding MorphElementShapeValue, Mode=TwoWay, Converter={StaticResource MorphElementShapeConverter}}">
                <sys:String>矩形</sys:String>
                <sys:String>圆形</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <controls:LabeledControl Label="结构元素宽度"
              Visibility="{Binding IsMorphologyEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ConfigSetting
                ParameterName="MorphElementWidth"
                DataType="{x:Type sys:Int32}"
                Value="{Binding MorphElementWidth, Mode=TwoWay}"
                Minimum="1" Maximum="101"
                SmallChange="1" LargeChange="10"
                Width="250"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="结构元素高度"
              Visibility="{Binding IsMorphologyEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ConfigSetting
                ParameterName="MorphElementHeight"
                DataType="{x:Type sys:Int32}"
                Value="{Binding MorphElementHeight, Mode=TwoWay}"
                Minimum="1" Maximum="101"
                SmallChange="1" LargeChange="10"
                Width="250"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="迭代次数"
              Visibility="{Binding IsMorphologyEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ConfigSetting
                ParameterName="MorphIterations"
                DataType="{x:Type sys:Int32}"
                Value="{Binding MorphIterations, Mode=TwoWay}"
                Minimum="1" Maximum="10"
                SmallChange="1" LargeChange="2"
                Width="250"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab3: Blob筛选 -->
      <TabItem Header="Blob筛选">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <!-- 排序方式 -->
            <controls:LabeledControl Label="排序方式" >
              <ComboBox Height="32"
                      VerticalContentAlignment="Center" Width="250"
                      SelectedItem="{Binding SortMode, Mode=TwoWay, Converter={StaticResource BlobSortModeConverter}}">
                <sys:String>不排序</sys:String>
                <sys:String>面积 ↑</sys:String>
                <sys:String>面积 ↓</sys:String>
                <sys:String>圆度 ↑</sys:String>
                <sys:String>圆度 ↓</sys:String>
                <sys:String>矩形度 ↑</sys:String>
                <sys:String>矩形度 ↓</sys:String>
                <sys:String>X坐标 ↑</sys:String>
                <sys:String>X坐标 ↓</sys:String>
                <sys:String>Y坐标 ↑</sys:String>
                <sys:String>Y坐标 ↓</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <!-- ====== 查找数量筛选 ====== -->
            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="查找数量筛选" FontWeight="SemiBold" Margin="0,4,0,8"/>
            <controls:LabeledControl Label="启用数量筛选" ContentHorizontalAlignment="Left" Margin="0,0,0,4">
              <controls:ToggleSwitch IsChecked="{Binding IsBlobCountFilterEnabled, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>
            <controls:LabeledControl Label="查找数量">
              <controls:ConfigSetting
                ParameterName="BlobCountLimit"
                DataType="{x:Type sys:Int32}"
                Value="{Binding BlobCountLimit, Mode=TwoWay}"
                Minimum="{x:Static local:BlobAnalysisParameters.BlobCountLimitMin}"
                Maximum="{x:Static local:BlobAnalysisParameters.BlobCountLimitMax}"
                SmallChange="100" LargeChange="1000"
                Width="250"
                IsEnabled="{Binding IsBlobCountFilterEnabled}"
                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="输出" FontWeight="SemiBold" Margin="0,4,0,8"/>
            <controls:LabeledControl Label="Blob图像输出" ContentHorizontalAlignment="Left">
              <controls:ToggleSwitch IsChecked="{Binding OutputBlobImage, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>
            <controls:LabeledControl Label="二值化图像输出" ContentHorizontalAlignment="Left">
              <controls:ToggleSwitch IsChecked="{Binding OutputBinaryImage, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>
            <controls:LabeledControl Label="轮廓输出" ContentHorizontalAlignment="Left">
              <controls:ToggleSwitch IsChecked="{Binding OutputContours, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <!-- ====== 面积筛选 ====== -->
            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="面积筛选" FontWeight="SemiBold" Margin="0,4,0,8"/>

            <controls:LabeledControl Label="启用面积筛选" ContentHorizontalAlignment="Left" Margin="0,0,0,4">
              <controls:ToggleSwitch
                IsChecked="{Binding IsAreaFilterEnabled, Mode=TwoWay}"
                SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="面积范围 (px²)"
              Visibility="{Binding IsAreaFilterEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:RangeInputControl
                Unit="px²"
                Minimum="0"
                Maximum="999999"
                MinValue="{Binding FilterAreaMin, Mode=TwoWay}"
                MaxValue="{Binding FilterAreaMax, Mode=TwoWay}"
                DecimalPlaces="0"
                SmallChange="10"
                NumericWidth="100"/>
            </controls:LabeledControl>

            <!-- ====== 圆度筛选 ====== -->
            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="圆度筛选" FontWeight="SemiBold" Margin="0,4,0,8"/>

            <controls:LabeledControl Label="启用圆度筛选" ContentHorizontalAlignment="Left" Margin="0,0,0,4">
              <controls:ToggleSwitch
                IsChecked="{Binding IsCircularityFilterEnabled, Mode=TwoWay}"
                SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="圆度范围"
              Visibility="{Binding IsCircularityFilterEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:RangeInputControl
                Unit=""
                Minimum="0"
                Maximum="1"
                MinValue="{Binding FilterCircularityMin, Mode=TwoWay}"
                MaxValue="{Binding FilterCircularityMax, Mode=TwoWay}"
                DecimalPlaces="3"
                SmallChange="0.01"
                NumericWidth="100"/>
            </controls:LabeledControl>

            <!-- ====== 矩形度筛选 ====== -->
            <Separator Margin="0,8,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.DividerBrush}}" Height="1"/>
            <TextBlock Text="矩形度筛选" FontWeight="SemiBold" Margin="0,4,0,8"/>

            <controls:LabeledControl Label="启用矩形度筛选" ContentHorizontalAlignment="Left" Margin="0,0,0,4">
              <controls:ToggleSwitch
                IsChecked="{Binding IsRectangularityFilterEnabled, Mode=TwoWay}"
                SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="矩形度范围"
              Visibility="{Binding IsRectangularityFilterEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:RangeInputControl
                Unit=""
                Minimum="0"
                Maximum="1"
                MinValue="{Binding FilterRectangularityMin, Mode=TwoWay}"
                MaxValue="{Binding FilterRectangularityMax, Mode=TwoWay}"
                DecimalPlaces="3"
                SmallChange="0.01"
                NumericWidth="100"/>
            </controls:LabeledControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab4: 结果显示 -->
      <TabItem Header="结果显示">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <presentation:JudgmentEditorControl ItemsSource="{Binding ResultPresentation.Judgments}"/>
            <presentation:GraphicsDisplayEditorControl ItemsSource="{Binding ResultPresentation.Graphics}"/>
            <presentation:TextDisplayEditorControl ItemsSource="{Binding ResultPresentation.Texts}"
                                                   AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</controls:ToolDebugControlBase>
