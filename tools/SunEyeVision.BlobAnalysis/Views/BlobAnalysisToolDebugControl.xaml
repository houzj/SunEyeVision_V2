<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.BlobAnalysis.Views.BlobAnalysisToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Converters;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SunEyeVision.Tool.BlobAnalysis"
        xmlns:localConverters="clr-namespace:SunEyeVision.Tool.BlobAnalysis.Converters"
        mc:Ignorable="d"
        d:DesignHeight="550" d:DesignWidth="400"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <localConverters:ThresholdTypeConverter x:Key="ThresholdTypeConverter"/>
            <localConverters:PreprocessFilterTypeConverter x:Key="PreprocessFilterTypeConverter"/>
            <localConverters:MorphOperationConverter x:Key="MorphOperationConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

    <!-- 主布局 -->
  <Grid>
    <TabControl Margin="5,0,5,0">
      <!-- Tab1: 基本参数 -->
      <TabItem Header="基本参数" IsSelected="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <controls:LabeledControl Label="输入图像"  HorizontalAlignment="Left">
              <controls:ImageSourceSelector
                                x:Name="imageSourceSelector"
                                PlaceholderText="请选择输入图像源"
                                Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"
                                SelectedDataSource="{Binding ImageSource, Mode=TwoWay}"/>
            </controls:LabeledControl>
            
            <!-- 启用区域限制 -->
            <controls:LabeledControl Label="启用区域限制">
              <CheckBox IsChecked="{Binding IsRegionEnabled.Value, Mode=TwoWay}"
                        Content="仅对指定区域进行分析"/>
            </controls:LabeledControl>
            
            <!-- 区域管理器（集成检测区域 + 屏蔽区域） -->
            <GroupBox Header="区域设置" Margin="0,8,0,0"
                      Visibility="{Binding IsRegionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
                <region:RegionEditorManagerControl x:Name="regionManager"
                    InspectionRegionsSource="{Binding InspectionRegions.Regions}"
                    MaskRegionsSource="{Binding MaskRegions.Regions}"/>
            </GroupBox>

            <!-- 位置修正 -->
            <controls:LabeledControl Label="位置修正" Margin="0,8,0,0" HorizontalAlignment="Left">
              <controls:ToggleSwitch
                  IsChecked="{Binding IsPositionCorrectionEnabled.Value, Mode=TwoWay}"
                  SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="修正信息" Margin="0,4,0,0" HorizontalAlignment="Left"
                Visibility="{Binding IsPositionCorrectionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ParamBinding
                  x:Name="positionCorrectionBinding"
                  ParameterName="位置修正" Width="200"
                  BindingSource="{Binding PositionCorrectionBindingSource, Mode=TwoWay}"
                  BindingDisplayText="{Binding PositionCorrectionBindingDisplayText, Mode=TwoWay}"
                  AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab2: 预处理参数 -->
      <TabItem Header="预处理参数">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <!-- ========== 图像预处理 ========== -->
            <controls:LabeledControl Label="启用图像预处理">
              <controls:ToggleSwitch IsChecked="{Binding IsImagePreprocessingEnabled.Value, Mode=TwoWay}"/>
            </controls:LabeledControl>

            <StackPanel Visibility="{Binding IsImagePreprocessingEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:LabeledControl Label="滤波类型">
                <ComboBox Height="32" VerticalContentAlignment="Center" Width="250"
                    SelectedItem="{Binding PreprocessFilterType.Value, Mode=TwoWay, Converter={StaticResource PreprocessFilterTypeConverter}}">
                  <sys:String>高斯滤波</sys:String>
                  <sys:String>中值滤波</sys:String>
                  <sys:String>均值滤波</sys:String>
                  <sys:String>锐化</sys:String>
                </ComboBox>
              </controls:LabeledControl>
              <controls:LabeledControl Label="内核大小">
                <controls:ConfigSetting ParameterName="PreprocessKernelSize"
                    DataType="{x:Type sys:Int32}"
                    Value="{Binding PreprocessKernelSize.Value, Mode=TwoWay}"
                    Minimum="1" Maximum="31" SmallChange="2" LargeChange="2"
                    ShowSlider="True" Width="250"/>
              </controls:LabeledControl>
              <controls:LabeledControl Label="Sigma"
                  Visibility="{Binding IsGaussianMethod, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:ConfigSetting ParameterName="PreprocessSigma"
                    DataType="{x:Type sys:Double}"
                    Value="{Binding PreprocessSigma.Value, Mode=TwoWay}"
                    Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                    ShowSlider="True" Width="250"/>
              </controls:LabeledControl>
              <controls:LabeledControl Label="锐化强度"
                  Visibility="{Binding IsEmphasizeMethod, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:ConfigSetting ParameterName="PreprocessEmphasizeFactor"
                    DataType="{x:Type sys:Double}"
                    Value="{Binding PreprocessEmphasizeFactor.Value, Mode=TwoWay}"
                    Minimum="0.5" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                    ShowSlider="True" Width="250"/>
              </controls:LabeledControl>
            </StackPanel>

            <Separator Margin="0,8,0,4" Background="#E0E0E0" Height="1"/>

            <!-- ========== 阈值化 ========== -->
            <controls:LabeledControl Label="阈值" >
              <controls:ConfigSetting
                                x:Name="thresholdParam"
                                ParameterName="Threshold"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding Threshold.Value, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="255"
                                SmallChange="1"
                                LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="最大值">
              <controls:ConfigSetting
                                x:Name="maxValueParam"
                                ParameterName="MaxValue"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding MaxValue.Value, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="255"
                                SmallChange="1"
                                LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="阈值类型" >
              <ComboBox x:Name="thresholdTypeComboBox"
                      Height="32"
                      VerticalContentAlignment="Center" Width="250"
                      SelectedItem="{Binding Type.Value, Mode=TwoWay, Converter={StaticResource ThresholdTypeConverter}}">
                <sys:String>Binary</sys:String>
                <sys:String>BinaryInv</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <controls:LabeledControl Label="反转结果" ContentHorizontalAlignment="Left" Margin="0,4,0,0">
              <CheckBox IsChecked="{Binding Invert.Value, Mode=TwoWay}"
                        Content="反转二值化结果"/>
            </controls:LabeledControl>

            <Separator Margin="0,8,0,4" Background="#E0E0E0" Height="1"/>

            <!-- ========== 形态学预处理 ========== -->
            <controls:LabeledControl Label="启用形态学预处理">
              <controls:ToggleSwitch IsChecked="{Binding IsMorphologyEnabled.Value, Mode=TwoWay}"/>
            </controls:LabeledControl>

            <StackPanel Visibility="{Binding IsMorphologyEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:LabeledControl Label="操作类型">
                <ComboBox Height="32" VerticalContentAlignment="Center" Width="250"
                    SelectedItem="{Binding MorphOperation.Value, Mode=TwoWay, Converter={StaticResource MorphOperationConverter}}">
                  <sys:String>腐蚀</sys:String>
                  <sys:String>膨胀</sys:String>
                  <sys:String>开运算</sys:String>
                  <sys:String>闭运算</sys:String>
                  <sys:String>梯度</sys:String>
                  <sys:String>顶帽</sys:String>
                  <sys:String>黑帽</sys:String>
                </ComboBox>
              </controls:LabeledControl>
              <controls:LabeledControl Label="结构元素大小">
                <controls:ConfigSetting ParameterName="MorphKernelSize"
                    DataType="{x:Type sys:Int32}"
                    Value="{Binding MorphKernelSize.Value, Mode=TwoWay}"
                    Minimum="1" Maximum="51" SmallChange="2" LargeChange="2"
                    ShowSlider="True" Width="250"/>
              </controls:LabeledControl>
              <controls:LabeledControl Label="迭代次数">
                <controls:ConfigSetting ParameterName="MorphIterations"
                    DataType="{x:Type sys:Int32}"
                    Value="{Binding MorphIterations.Value, Mode=TwoWay}"
                    Minimum="1" Maximum="20" SmallChange="1" LargeChange="1"
                    ShowSlider="True" Width="250"/>
              </controls:LabeledControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab3: Blob筛选 -->
      <TabItem Header="Blob筛选">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <!-- 面积范围 -->
            <controls:LabeledControl Label="面积范围 (px²)">
              <controls:RangeInputControl
                      Unit="px²"
                      Minimum="0"
                      Maximum="999999"
                      MinValue="{Binding MinArea.Value, Mode=TwoWay}"
                      MaxValue="{Binding MaxArea.Value, Mode=TwoWay}"
                      DecimalPlaces="0"
                      SmallChange="10"
                      NumericWidth="100"/>
            </controls:LabeledControl>

            <!-- 圆度范围 -->
            <controls:LabeledControl Label="圆度范围">
              <controls:RangeInputControl
                      Unit=""
                      Minimum="0"
                      Maximum="1"
                      MinValue="{Binding MinCircularity.Value, Mode=TwoWay}"
                      MaxValue="{Binding MaxCircularity.Value, Mode=TwoWay}"
                      DecimalPlaces="3"
                      SmallChange="0.01"
                      NumericWidth="100"/>
            </controls:LabeledControl>

            <!-- 矩形度范围 -->
            <controls:LabeledControl Label="矩形度范围">
              <controls:RangeInputControl
                      Unit=""
                      Minimum="0"
                      Maximum="1"
                      MinValue="{Binding MinRectangularity.Value, Mode=TwoWay}"
                      MaxValue="{Binding MaxRectangularity.Value, Mode=TwoWay}"
                      DecimalPlaces="3"
                      SmallChange="0.01"
                      NumericWidth="100"/>
            </controls:LabeledControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab4: 结果显示 -->
      <TabItem Header="结果显示">
        <Grid Background="#F5F5F5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" Padding="3">
            <StackPanel>
              <!-- 结果判断分组 -->
              <Expander Header="结果判断"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <!-- 输出为空判断 -->
                  <controls:LabeledControl Label="输出为空判断" ContentHorizontalAlignment="Left">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsEmptyCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>

                  <!-- 白色像素比例判断 -->
                  <controls:LabeledControl Label="白色像素比例" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsWhitePixelRatioCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="白色像素比例 (%):"  Margin="0,2,0,0" ContentHorizontalAlignment="Left"
                                           Visibility="{Binding ResultConfig.IsWhitePixelRatioCheckEnabled,
                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="%"
                                            Minimum="0"
                                            Maximum="100"
                                            MinValue="{Binding ResultConfig.WhitePixelRatioMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.WhitePixelRatioMax, Mode=TwoWay}"
                                            DecimalPlaces="1"
                      SmallChange="1"
                      NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- Blob数量判断 -->
                  <controls:LabeledControl Label="Blob数量判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsBlobCountCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="Blob数量范围:" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsBlobCountCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="个"
                                            Minimum="0"
                                            Maximum="9999"
                                            MinValue="{Binding ResultConfig.BlobCountMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.BlobCountMax, Mode=TwoWay}"
                                            DecimalPlaces="0"  NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 总面积判断 -->
                  <controls:LabeledControl Label="总面积判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsTotalAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="总面积范围 (px²):" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsTotalAreaCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="px²"
                                            Minimum="0"
                                            Maximum="10000000"
                                            MinValue="{Binding ResultConfig.TotalAreaMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.TotalAreaMax, Mode=TwoWay}"
                                            DecimalPlaces="0"  NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 平均面积判断 -->
                  <controls:LabeledControl Label="平均面积判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsAverageAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="平均面积范围 (px²):" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsAverageAreaCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="px²"
                                            Minimum="0"
                                            Maximum="10000000"
                                            MinValue="{Binding ResultConfig.AverageAreaMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.AverageAreaMax, Mode=TwoWay}"
                                            DecimalPlaces="0"  NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 最大面积判断 -->
                  <controls:LabeledControl Label="最大面积判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsMaxAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="最大面积范围 (px²):" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsMaxAreaCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="px²"
                                            Minimum="0"
                                            Maximum="10000000"
                                            MinValue="{Binding ResultConfig.MaxAreaMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.MaxAreaMax, Mode=TwoWay}"
                                            DecimalPlaces="0"  NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 最小面积判断 -->
                  <controls:LabeledControl Label="最小面积判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsMinAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="最小面积范围 (px²):" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsMinAreaCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="px²"
                                            Minimum="0"
                                            Maximum="10000000"
                                            MinValue="{Binding ResultConfig.MinAreaMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.MinAreaMax, Mode=TwoWay}"
                                            DecimalPlaces="0"  NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 平均圆度判断 -->
                  <controls:LabeledControl Label="平均圆度判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsAverageCircularityCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="平均圆度范围:" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsAverageCircularityCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit=""
                                            Minimum="0"
                                            Maximum="1"
                                            MinValue="{Binding ResultConfig.AverageCircularityMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.AverageCircularityMax, Mode=TwoWay}"
                                            DecimalPlaces="3"
                      SmallChange="0.01"
                      NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 平均矩形度判断 -->
                  <controls:LabeledControl Label="平均矩形度判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsAverageRectangularityCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="平均矩形度范围:" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsAverageRectangularityCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit=""
                                            Minimum="0"
                                            Maximum="1"
                                            MinValue="{Binding ResultConfig.AverageRectangularityMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.AverageRectangularityMax, Mode=TwoWay}"
                                            DecimalPlaces="3"
                      SmallChange="0.01"
                      NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- ===== 独立Blob判断（控制每个Blob显示颜色） ===== -->
                  <Separator Margin="0,8,0,4" Background="#E0E0E0" Height="1"/>
                  <TextBlock Text="独立Blob判断（控制每个Blob显示颜色）" FontWeight="SemiBold" Margin="0,4,0,0"/>

                  <!-- 每个Blob面积 -->
                  <controls:LabeledControl Label="每个Blob面积" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsPerBlobAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="每个Blob面积范围 (px²):" Margin="0,2,0,0"
                    Visibility="{Binding ResultConfig.IsPerBlobAreaCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                      Unit="px²"
                      Minimum="0"
                      Maximum="10000000"
                      MinValue="{Binding ResultConfig.PerBlobAreaMin, Mode=TwoWay}"
                      MaxValue="{Binding ResultConfig.PerBlobAreaMax, Mode=TwoWay}"
                      DecimalPlaces="0"
                      SmallChange="10"
                      NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 每个Blob圆度 -->
                  <controls:LabeledControl Label="每个Blob圆度" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsPerBlobCircularityCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="每个Blob圆度范围:" Margin="0,2,0,0"
                    Visibility="{Binding ResultConfig.IsPerBlobCircularityCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                      Unit=""
                      Minimum="0"
                      Maximum="1"
                      MinValue="{Binding ResultConfig.PerBlobCircularityMin, Mode=TwoWay}"
                      MaxValue="{Binding ResultConfig.PerBlobCircularityMax, Mode=TwoWay}"
                      DecimalPlaces="3"
                      SmallChange="0.01"
                      NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 每个Blob矩形度 -->
                  <controls:LabeledControl Label="每个Blob矩形度" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsPerBlobRectangularityCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="每个Blob矩形度范围:" Margin="0,2,0,0"
                    Visibility="{Binding ResultConfig.IsPerBlobRectangularityCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                      Unit=""
                      Minimum="0"
                      Maximum="1"
                      MinValue="{Binding ResultConfig.PerBlobRectangularityMin, Mode=TwoWay}"
                      MaxValue="{Binding ResultConfig.PerBlobRectangularityMax, Mode=TwoWay}"
                      DecimalPlaces="3"
                      SmallChange="0.01"
                      NumericWidth="120"/>
                  </controls:LabeledControl>
                </StackPanel>
              </Expander>

              <!-- 图形显示分组 -->
              <Expander Header="图形显示"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <controls:LabeledControl Label="轮廓" ContentHorizontalAlignment="Left">
                    <controls:DispItemColorControl
                        Item="{Binding ContoursStyle, Mode=TwoWay}"
                        ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="外接矩形" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispItemColorControl
                        Item="{Binding BlobsStyle, Mode=TwoWay}"
                        ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="质心标记" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispItemColorControl
                        Item="{Binding CentroidsStyle, Mode=TwoWay}"
                        ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>
                </StackPanel>
              </Expander>

              <!-- 文本显示分组 -->
              <Expander Header="文本显示"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <controls:LabeledControl Label="统计信息" ContentHorizontalAlignment="Left">
                    <controls:DispTextColorControl
                        Item="{Binding StatisticsStyle, Mode=TwoWay}"
                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="面积列表" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispTextColorControl
                        Item="{Binding AreaDisplayStyle, Mode=TwoWay}"
                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </controls:LabeledControl>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</controls:ToolDebugControlBase>
