<UserControl x:Class="SunEyeVision.Tool.BlobAnalysis.Views.BlobDataAnalysisControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Converters;assembly=SunEyeVision.Plugin.SDK"
        d:DesignHeight="350" d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- 统计摘要区域（顶部固定） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Blob: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FilteredBlobCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries1Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="面积: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FilteredTotalArea, StringFormat='{}{0:F0}', Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries2Brush}}"/>
                    <TextBlock Text=" px²" Foreground="{DynamicResource ThemeTextDisabledBrush}" FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="均值: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AverageArea, StringFormat='{}{0:F0}', Mode=OneWay}" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries3Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="最大: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MaxArea, StringFormat='{}{0:F0}', Mode=OneWay}" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries4Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="阈值: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ThresholdUsed, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries5Brush}}"/>
                </StackPanel>

                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding ThresholdTypeText, Mode=OneWay}" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeriesMutedBrush}}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Blob 详细数据表格 -->
        <DataGrid x:Name="BlobDataGrid"
                  ItemsSource="{Binding FilteredBlobs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeight="22"
                  FontSize="11"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource ThemeTableRowBackgroundBrush}"
                  RowBackground="{DynamicResource ThemeTableRowBackgroundBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  AlternatingRowBackground="{DynamicResource ThemeTableRowHoverBackgroundBrush}"
                  SelectionChanged="BlobDataGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTableHeaderTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeTableGridLineBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Label}" Width="36"/>
                <DataGridTextColumn Header="面积" Binding="{Binding Area, StringFormat='{}{0:F0}'}" Width="58"/>
                <DataGridTextColumn Header="周长" Binding="{Binding Perimeter, StringFormat='{}{0:F1}'}" Width="52"/>
                <DataGridTextColumn Header="中心X" Binding="{Binding CentroidX, StringFormat='{}{0:F1}'}" Width="52"/>
                <DataGridTextColumn Header="中心Y" Binding="{Binding CentroidY, StringFormat='{}{0:F1}'}" Width="52"/>
                <DataGridTextColumn Header="圆度" Binding="{Binding Circularity, StringFormat='{}{0:F3}'}" Width="50"/>
                <DataGridTextColumn Header="矩形度" Binding="{Binding Rectangularity, StringFormat='{}{0:F3}'}" Width="52"/>
                <DataGridTextColumn Header="边框" Binding="{Binding BoundingRectText}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
