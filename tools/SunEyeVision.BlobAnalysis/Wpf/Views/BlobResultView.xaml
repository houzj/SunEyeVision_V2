<UserControl x:Class="SunEyeVision.Tool.BlobAnalysis.Views.BlobResultView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:design="clr-namespace:SunEyeVision.Tool.BlobAnalysis.Wpf.Design"
        xmlns:presentation="clr-namespace:SunEyeVision.Tool.BlobAnalysis.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=design:BlobResultDesignData, IsDesignTimeCreatable=True}"
        d:DesignHeight="350" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Generic.xaml"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- 统计摘要区域（顶部固定） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource O06.PanelBackgroundBrush}" BorderBrush="{DynamicResource O06.BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Blob: " Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FilteredBlobCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="面积: " Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FilteredTotalArea, StringFormat='{}{0:F0}', Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                    <TextBlock Text=" px²" Foreground="{DynamicResource O06.TextSecondaryBrush}" FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="均值: " Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AverageArea, StringFormat='{}{0:F0}', Mode=OneWay}" Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="最大: " Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MaxArea, StringFormat='{}{0:F0}', Mode=OneWay}" Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="阈值范围: " Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ThresholdRangeText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource O06.TextSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding ThresholdTypeText, Mode=OneWay}" Foreground="{DynamicResource O06.TextSecondaryBrush}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Blob 详细数据表格 -->
        <DataGrid x:Name="BlobDataGrid"
                  presentation:BlobResultColumns.Enabled="True"
                  ItemsSource="{Binding FilteredBlobs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeight="22"
                  FontSize="11"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource O06.InputBackgroundBrush}"
                  RowBackground="{DynamicResource O06.InputBackgroundBrush}"
                  Foreground="{DynamicResource O06.TextSecondaryBrush}"
                  AlternatingRowBackground="{DynamicResource O06.ControlHoverBackgroundBrush}"
                  SelectionChanged="BlobDataGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource O06.PanelBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource O06.TextSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource O06.BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>

    </DockPanel>
</UserControl>
