<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SunEyeVision.Tool.ContourMatch.Wpf.Views"
                    xmlns:parameters="clr-namespace:SunEyeVision.Plugin.Wpf.Presenters.Parameters;assembly=SunEyeVision.Plugin.Wpf">
  <!--
    逐字迁移自原厂 hpfeaturepatmatchdialoguibasestyle.xaml:16-49（BottomBorder/Shadow）。
    品牌中性化：HikTextBox→TemplateTextBox；AncestorType HPFeaturepatMatchDialogUI→TemplateConfigWindow。
  -->
  <DataTemplate x:Key="BottomBorder">
    <Border BorderBrush="#C2C2C2" BorderThickness="0,1,0,0">
      <Grid Background="#E6E6E6">
        <StatusBar Name="statusBarMain" Grid.Row="1" Height="30" Background="#00FFFFFF" Foreground="#808080" FontSize="13">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StatusBarItem Content="匹配中心" />
            <StatusBarItem Content=":(" />
            <Border BorderThickness="1" CornerRadius="4">
              <parameters:TemplateTextBox Name="FixX" Width="76" TextAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                                          Style="{StaticResource TemplateTextBoxStyle}" Text="{Binding FixPointX, Converter={StaticResource cvtDoubleToFloat}}"
                                          ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <StatusBarItem Content="," />
            <Border BorderThickness="1" CornerRadius="4">
              <parameters:TemplateTextBox Name="FixY" Width="76" TextAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                                          Style="{StaticResource TemplateTextBoxStyle}" Text="{Binding FixPointY, Converter={StaticResource cvtDoubleToFloat}}"
                                          ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <StatusBarItem Content=")" />
            <CheckBox Name="isLock" Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource CheckBoxStyle1}"
                      IsChecked="{Binding MatchPointLock, Mode=TwoWay}" />
            <TextBlock Text="锁定" VerticalAlignment="Center" />
          </StackPanel>
        </StatusBar>
        <Grid HorizontalAlignment="Right">
          <Button Grid.Column="0" Margin="0,0,10,0" Content="确定" Style="{StaticResource BottomButtonStyle}"
                  Command="{Binding ConfirmCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=views:TemplateConfigWindow}}" />
        </Grid>
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="Shadow">
    <TextBlock Text="生成模型中..." Foreground="#808080" VerticalAlignment="Center" HorizontalAlignment="Center" />
  </DataTemplate>
</ResourceDictionary>
