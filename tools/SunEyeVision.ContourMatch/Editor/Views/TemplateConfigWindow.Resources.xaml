<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:parameters="clr-namespace:SunEyeVision.Plugin.Wpf.Presenters.Parameters;assembly=SunEyeVision.Plugin.Wpf" xmlns:nativeControls="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Interaction.Controls;assembly=SunEyeVision.Plugin.Wpf" xmlns:core="http://schemas.microsoft.com/xaml/behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SunEyeVision.Plugin.Wpf.Presenters.Parameters;assembly=SunEyeVision.Plugin.Wpf" xmlns:views="clr-namespace:SunEyeVision.Tool.ContourMatch.Wpf.Views" xmlns:commomcontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Input.Interaction.Commom;assembly=SunEyeVision.Plugin.Wpf" xmlns:Lang="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Common.Localization;assembly=SunEyeVision.Plugin.Wpf" xmlns:moduleLayout="clr-namespace:SunEyeVision.Tool.ContourMatch.Wpf.Views" xmlns:pcUiControl="clr-namespace:SunEyeVision.Tool.ContourMatch.Wpf.Views" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:ei="http://schemas.microsoft.com/xaml/behaviors" xmlns:pcuicontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Numeric.ParameterPresentation.ParamTabControl;assembly=SunEyeVision.Plugin.Wpf" xmlns:localcontrol="clr-namespace:HikPcUI.ImageView;assembly=VM.PcUI" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:imagecontrol="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageViewport;assembly=SunEyeVision.Plugin.Wpf" xmlns:Interface="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Dependencies.PresentationControls.RenderInterface;assembly=SunEyeVision.Plugin.Wpf" xmlns:UIHelper="clr-namespace:SunEyeVision.Plugin.Wpf.Controls.Interaction;assembly=SunEyeVision.Plugin.Wpf" xmlns:baseData="clr-namespace:SunEyeVision.Tool.ContourMatch.Wpf.Views" xmlns:appUI="clr-namespace:SunEyeVision.Plugin.Wpf.Presenters.Parameters;assembly=SunEyeVision.Plugin.Wpf" xmlns:polygonProperty="clr-namespace:SunEyeVision.Plugin.Wpf.Native.Display.ImageViewport.Base.ImageView.ROI;assembly=SunEyeVision.Plugin.Wpf" xmlns:s="clr-namespace:System;assembly=mscorlib">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/SharedStyles/TemplateWindowButtonStyles.xaml" />
    <ResourceDictionary Source="/SunEyeVision.Plugin.Wpf;component/Themes/Native/Composition/ParameterPresentation/ResourceDictionaries/GlobalResources.xaml" />
    
    <ResourceDictionary>
      <s:Boolean x:Key="True">True</s:Boolean>
      <!-- cvtDoubleToFloat / cvtFloatToInt / cvtBoolToInt 由
           TemplateWindowButtonStyles.xaml（上方 MergedDictionaries）提供，此处不再重复定义。 -->
      <Style x:Key="ComboxStyleBtnSign" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
                <Image Name="icon" Height="8" Width="8" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_掩膜类型_unfold_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_掩膜类型_unfold_select.png" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/ic_掩膜类型_unfold_select.png" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ComboxStyleBtn" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF">
                <Image Name="icon" Height="14" Width="14" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/combo_ic_triangle_normal.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/combo_ic_triangle_click.png" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/combo_ic_triangle_click.png" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ComboxStyleNormal" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="Background" Value="#FCFCFC" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30" Margin="2,0,2,0" Focusable="False">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Focusable="False" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                        <Setter Property="Foreground" Value="#4D4D4D" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Popup Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Margin="4" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="4" Padding="0,6,0,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0.0" Color="#FCFCFC" />
                          <GradientStop Offset="0.15" Color="#FCFCFC" />
                          <GradientStop Offset="1" Color="#F7F7F7" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#CCCCCD" BlurRadius="4" ShadowDepth="4" Opacity="0.4" />
                      </UIElement.Effect>
                      <UIElement.RenderTransform>
                        <TranslateTransform X="-4" />
                      </UIElement.RenderTransform>
                      <ScrollViewer Style="{DynamicResource RecScrollViewer}" Focusable="False" Background="#00FFFFFF" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Grid Column="0" Margin="11,0,0,0">
                  <ContentPresenter Name="ContentPresenter" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Grid>
                <Border Name="Border" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsOpen, ElementName=Popup}">
                  <Setter TargetName="Border" Value="{DynamicResource Col_Theme}" Property="Border.BorderBrush" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ComboBoxSignList" TargetType="{x:Type ComboBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="28" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Back" Background="#00FFFFFF" Height="30">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="24" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Focusable="False" Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="None">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Image}">
                              <Setter Property="Source" Value="{Binding ComboxItemImgNormal}" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBoxItem}}">
                                  <Setter Property="Source" Value="{Binding ComboxItemImgSelect}" />
                                </DataTrigger>
                                <DataTrigger Value="False" Binding="{Binding IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBoxItem}}">
                                  <Setter Property="Source" Value="{Binding ComboxItemImgDisable}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </Image>
                        <TextBlock Margin="2,0,0,0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding DisplayValue}" />
                        <Rectangle Name="Rect" Grid.ColumnSpan="3" Height="0" StrokeThickness="1" Stroke="{DynamicResource Col_Theme}" VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Back" Property="Border.Background" Value="#E7E5E4" />
                        <Setter TargetName="Rect" Property="Height" Value="1" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter Value="{DynamicResource Col_Theme}" Property="Foreground" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Border Name="Border" Background="#00FFFFFF" Grid.ColumnSpan="2" BorderThickness="0" BorderBrush="#00FFFFFF" />
                <Image Grid.Column="0" Height="24" Width="24" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Image}">
                      <Setter Property="Source" Value="{Binding SelectedItem.ComboxImgNormal, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}">
                          <Setter Property="Source" Value="{Binding SelectedItem.ComboxImgSelect, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}" />
                        </DataTrigger>
                        <DataTrigger Value="True" Binding="{Binding IsEnable, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}">
                          <Setter Property="Source" Value="{Binding SelectedItem.ComboxImgDisable, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Image>
                <ToggleButton Name="toggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Style="{StaticResource ComboxStyleBtnSign}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Popup Name="Popup" VerticalOffset="3" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                  <Grid>
                    <Border Name="DropDown" Height="Auto" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="#CCCCCD" BorderThickness="1" CornerRadius="2" Padding="5,6,5,6">
                      <Border.Background>
                        <LinearGradientBrush>
                          <GradientStop Offset="0" Color="#FCFCFC" />
                          <GradientStop Offset="1" Color="#FCFCFC" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <UIElement.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="5" Opacity="0.16" />
                      </UIElement.Effect>
                      <StackPanel IsItemsHost="True" Focusable="False" SnapsToDevicePixels="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#00FFFFFF" />
                    </Border>
                  </Grid>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ImageButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="EditButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" Padding="{TemplateBinding Control.Padding}" Margin="-4" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                <ContentPresenter Name="con" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter TargetName="con" Property="ContentPresenter.Content">
                    <Setter.Value>
                      <Image Stretch="None" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/edit_click.png" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="con" Property="ContentPresenter.Content" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TextButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="iBorder" CornerRadius="2" Padding="{TemplateBinding Control.Padding}" Margin="0" Background="{TemplateBinding Control.Background}" BorderBrush="#CCCCCC" BorderThickness="1">
                <ContentPresenter Margin="10,0,10,0" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="iBorder" Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListViewStyle1" TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="#FCFFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListView}">
              <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Padding="0" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Control.Padding}" Style="{StaticResource shrinkScrollViewer}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="switchbutton" TargetType="{x:Type ToggleButton}">
        <Image Name="icon" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/swith_off.png" Stretch="None" />
        <ControlTemplate.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="icon" Property="Image.Source" Value="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/swith_on.png" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </ResourceDictionary.MergedDictionaries>
  <!-- 原厂底栏 BottomBorder/Shadow（合并入同一字典，确保 StaticResource 同字典内前向可见） -->

  <!--
    逐字迁移自原厂 hpfeaturepatmatchdialoguibasestyle.xaml:16-49（BottomBorder/Shadow）。
    品牌中性化：HikTextBox→TemplateTextBox；AncestorType HPFeaturepatMatchDialogUI→TemplateConfigWindow。
  -->
  <DataTemplate x:Key="BottomBorder">
    <Border BorderBrush="#C2C2C2" BorderThickness="0,1,0,0">
      <Grid Background="#E6E6E6">
        <StatusBar Name="statusBarMain" Grid.Row="1" Height="30" Background="#00FFFFFF" Foreground="#808080" FontSize="13">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StatusBarItem Content="匹配中心" />
            <StatusBarItem Content=":(" />
            <Border BorderThickness="1" CornerRadius="4">
              <parameters:TemplateTextBox Name="FixX" Width="76" TextAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                                          Style="{StaticResource TemplateTextBoxStyle}" Text="{Binding FixPointX, Converter={StaticResource cvtDoubleToFloat}}"
                                          ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <StatusBarItem Content="," />
            <Border BorderThickness="1" CornerRadius="4">
              <parameters:TemplateTextBox Name="FixY" Width="76" TextAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                                          Style="{StaticResource TemplateTextBoxStyle}" Text="{Binding FixPointY, Converter={StaticResource cvtDoubleToFloat}}"
                                          ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <StatusBarItem Content=")" />
            <CheckBox Name="isLock" Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource CheckBoxStyle1}"
                      IsChecked="{Binding MatchPointLock, Mode=TwoWay}" />
            <TextBlock Text="锁定" VerticalAlignment="Center" />
          </StackPanel>
        </StatusBar>
        <Grid HorizontalAlignment="Right">
          <Button Grid.Column="0" Margin="0,0,10,0" Content="确定" Style="{StaticResource BottomButtonStyle}"
                  Command="{Binding ConfirmCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=views:TemplateConfigSurface}}" />
        </Grid>
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="Shadow">
    <TextBlock Text="生成模型中..." Foreground="#808080" VerticalAlignment="Center" HorizontalAlignment="Center" />
  </DataTemplate>


  <Style x:Key="{x:Type views:TemplateConfigSurface}" TargetType="{x:Type views:TemplateConfigSurface}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Grid Row="0" Background="#f2f3f4">
              <Border Padding="10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Padding="2">
                    <Grid>
                      <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button Name="BtnCurImage" Width="95" Margin="0,7,8,6" Content="{DynamicResource Lang_SelectCurrentImage}" Style="{StaticResource Orange_ButtonStyle}" Command="{Binding SelectCurImageCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        <Button Width="95" Margin="0,7,5,6" Content="{DynamicResource Lang_SelectOtherImage}" Style="{StaticResource Orange_ButtonStyle}" Command="{Binding SelectOtherImageCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{DynamicResource 模板存图}" Foreground="{DynamicResource ParamsTabForeground}" FontFamily="Microsoft YaHei" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <ToggleButton Name="cbIsSaveImage" Width="80" IsChecked="{Binding IsSaveImage, Mode=TwoWay}" Margin="-5,0,0,0" Template="{StaticResource switchbutton}" />
                        </StackPanel>
                        <commomcontrol:SuperImageButton Name="Save" Width="30" ToolTip="{DynamicResource 保存模型工程}" Command="{Binding SaveCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                          <commomcontrol:SuperImageButton.NormalConnent>
                            <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/ic_导出_normal.png" />
                          </commomcontrol:SuperImageButton.NormalConnent>
                          <commomcontrol:SuperImageButton.DisableConnent>
                            <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/SharedStyles/resources/ic_导出_disable.png" />
