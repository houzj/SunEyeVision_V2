                                              <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/window_visible_normal.png" Height="24" Width="24" />
                                              <FrameworkElement.Tag>
                                                <Image Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/window_invisible_normal.png" Height="24" Width="24" />
                                              </FrameworkElement.Tag>
                                            </ToggleButton>
                                            <!-- 原厂绑到 FeaturepatMatchDialogUIBase 祖先；本方窗口 DataContext 是 TemplateConfigData，
                                                 必须改绑 Window 祖先的 DataContext，否则符号列表与删除命令永远解析失败（功能"未接入"）。 -->
                                            <ComboBox Name="Sign" Grid.Column="2" Background="#00FFFFFF" Style="{StaticResource ComboBoxSignList}" ItemsSource="{Binding DataContext.SignList, RelativeSource={RelativeSource AncestorType=Window}}" SelectedIndex="{Binding SignIndex, Mode=TwoWay}" />
                                            <Button Name="Delete" Grid.Column="4" Background="#00FFFFFF" Style="{StaticResource ImageButtonStyleK}" Tag="{Binding}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                              <Image Margin="0" Source="/SunEyeVision.Plugin.Wpf;component/Themes/Assets/Native/Composition/ParameterPresentation/resources/window_cross_normal.png" Height="24" Width="24" />
                                            </Button>
                                          </Grid>
                                        </Grid>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                                          <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                                        </Trigger>
                                        <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                          <Setter TargetName="bd" Property="Border.Background" Value="#FFE8E4E4" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                              </Style.Setters>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                        </ListView>
                        <Separator Grid.Row="2" Margin="10" BorderThickness="1" BorderBrush="#E0DFDE" />
                        <GroupBox Name="FeatureConfig" Grid.Row="3" Background="#FCFFFFFF" BorderBrush="#00FFFFFF" Height="260">
                          <HeaderedContentControl.HeaderTemplate>
                            <DataTemplate>
                              <TextBlock Name="txtHeader" Text="{DynamicResource Tab_Match Params}" Margin="3,0,0,0" Foreground="#4C4C4C" FontFamily="Microsoft YaHei" FontSize="14" FontWeight="Bold" />
                            </DataTemplate>
                          </HeaderedContentControl.HeaderTemplate>
                          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="5,0" Style="{StaticResource shrinkScrollViewer}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource PyramidScaleFlag}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource PyramidScaleLevel}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource PyramidScaleRLevel}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Thresh Mode}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource EdgeThreshold}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="5" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="轮廓优化" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="6" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="最小对比度" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <TextBlock Grid.Row="7" Grid.Column="0" FontFamily="Microsoft YaHei" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Text="亚像素模式" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                              <ComboBox Name="ComboBoxPyramidScaleFlag" Grid.Row="0" Grid.Column="1" Width="100" Margin="0,0,10,0" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding PyramidScaleFlag, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="{DynamicResource Mannual}" />
                                <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                              </ComboBox>
                              <pcuicontrol:SliderArrange Grid.Row="1" Grid.Column="1" Width="100" Margin="0,0,10,0" SliderTickFrequency="1" Minimum="1" Maximum="10" StartValue="{Binding PyramidScaleLevel, Mode=TwoWay}" IsEnabled="{Binding ElementName=ComboBoxPyramidScaleFlag, Path=SelectedIndex, Converter={x:Static views:PyramidModeToEnableCvt.Cvt}}" />
                              <pcuicontrol:SliderArrange Grid.Row="2" Grid.Column="1" Width="100" Margin="0,0,10,0" SliderTickFrequency="1" Minimum="1" Maximum="10" StartValue="{Binding PyramidScaleRLevel, Mode=TwoWay}" IsEnabled="{Binding ElementName=ComboBoxPyramidScaleFlag, Path=SelectedIndex, Converter={x:Static views:PyramidModeToEnableCvt.Cvt}}" />
                              <ComboBox Name="ComboBoxEdgeThresholdFlag" Grid.Row="3" Grid.Column="1" Width="100" Margin="0,0,10,0" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding EdgeThresholdFlag, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="{DynamicResource Mannual}" />
                                <ComboBoxItem Content="{DynamicResource RunParam_Auto}" />
                              </ComboBox>
                              <pcuicontrol:SliderArrange Grid.Row="4" Grid.Column="1" Width="100" Margin="0,0,10,0" SliderTickFrequency="1" Minimum="1" Maximum="255" StartValue="{Binding EdgeThreshold, Mode=TwoWay}" IsEnabled="{Binding ElementName=ComboBoxEdgeThresholdFlag, Path=SelectedIndex, Converter={x:Static views:PyramidModeToEnableCvt.Cvt}}" />
                              <ComboBox Name="ComboBoxOptimization" Grid.Row="5" Grid.Column="1" Width="100" Margin="0,0,10,0" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding OptimizationIndex, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="自动" />
                                <ComboBoxItem Content="不优化" />
                                <ComboBoxItem Content="低" />
                                <ComboBoxItem Content="中" />
                                <ComboBoxItem Content="高" />
                              </ComboBox>
                              <pcuicontrol:SliderArrange Grid.Row="6" Grid.Column="1" Width="100" Margin="0,0,10,0" SliderTickFrequency="1" Minimum="1" Maximum="255" StartValue="{Binding MinContrast, Mode=TwoWay}" />
                              <ComboBox Name="ComboBoxSubPixel" Grid.Row="7" Grid.Column="1" Width="100" Margin="0,0,10,0" Style="{StaticResource ComboxStyleNormal}" SelectedIndex="{Binding SubPixelIndex, Mode=TwoWay}" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                                <ComboBoxItem Content="无" />
                                <ComboBoxItem Content="插值" />
                                <ComboBoxItem Content="最小二乘" />
                              </ComboBox>
                            </Grid>
                          </ScrollViewer>
                        </GroupBox>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource BottomBorder}" Content="{Binding}" />
            <ContentControl Name="windowShadow" Margin="-50,-50,-50,-50" Visibility="Collapsed" ContentTemplate="{StaticResource Shadow}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsUsePen}">
              <Setter TargetName="hikCoverCircle" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="hikSector" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="hikFrame" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="hikPolygon" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="iBack" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="iPen" Property="UIElement.Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding MatchPointLock}">
              <Setter TargetName="hikCross" Property="UIElement.Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
