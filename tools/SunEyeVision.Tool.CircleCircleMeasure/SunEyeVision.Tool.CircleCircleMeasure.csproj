<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SunEyeVision.Tool.CircleCircleMeasure</RootNamespace>
    <AssemblyName>SunEyeVision.Tool.CircleCircleMeasure</AssemblyName>
    <IsToolPlugin>true</IsToolPlugin>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugin.SDK\SunEyeVision.Plugin.SDK.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnetxl">
      <HintPath>..\..\libs\halcon\net\halcondotnetxl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Hal 实现（HalImage/GetHalconImage/HOperatorSet 扩展），首期统一引 HalAdapter 做 metrology measure -->
    <ProjectReference Include="..\..\src\SunEyeVision.HalAdapter\SunEyeVision.HalAdapter.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
