<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.Condition.Views.ConditionDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DesignHeight="300" d:DesignWidth="380"
        Width="380" Height="300"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Condition rule configuration" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,2" Padding="8" CornerRadius="4" Background="#FAFAFA">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="24"/>
                                    <ComboBox Grid.Column="2" SelectedItem="{Binding Judgment, Mode=TwoWay}" Width="55" Height="24" Margin="6,0,0,0">
                                        <sys:String>OK</sys:String>
                                        <sys:String>NG</sys:String>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Range:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666"/>
                                    <TextBox Grid.Column="1" Text="{Binding MinValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="24"/>
                                    <TextBlock Grid.Column="2" Text=" ~ " VerticalAlignment="Center" Margin="2,0" Foreground="#999"/>
                                    <TextBox Grid.Column="3" Text="{Binding MaxValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="24"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666"/>
                                    <TextBox Grid.Column="1" Text="{Binding ExecutionModuleId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="24"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Separator/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Default module:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666"/>
                <TextBox Grid.Column="1" Text="{Binding DefaultExecutionModuleId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="24"/>
            </Grid>
        </StackPanel>
    </Grid>
</controls:ToolDebugControlBase>
