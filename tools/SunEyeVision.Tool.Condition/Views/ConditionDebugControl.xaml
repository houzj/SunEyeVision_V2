<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.Condition.Views.ConditionDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SunEyeVision.Tool.Condition.Views"
        mc:Ignorable="d"
        d:DesignHeight="560" d:DesignWidth="960"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:DesignTimeThemeResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <local:ConditionTypeConverter x:Key="ConditionTypeConverter"/>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="RowHeight" Value="34"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTableHeaderTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeTableGridLineBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Height" Value="28"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeTableGridLineBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ThemeTableRowHoverBackgroundBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                    </Trigger>
                    <!-- 失焦仍保留选中主题色，而非系统默认灰 -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

    <StackPanel Margin="12">
        <!-- 规则表格：高度随行数自适应，超过 MaxHeight 后表格内部滚动（表头固定、虚拟化保留） -->
        <DataGrid ItemsSource="{Binding Parameters.Rules, RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}}"
                  MaxHeight="450">
            <DataGrid.Columns>
                <!-- 名称（只读，圆角标签样式，文字用主题主色） -->
                <DataGridTemplateColumn Header="名称" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ThemeTableRowHoverBackgroundBrush}" CornerRadius="3" Padding="8,3"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 条件：ParamBinding（绑定/常量，SyncEditingToSource=True 契约 C2） -->
                <DataGridTemplateColumn Header="条件" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:ParamBinding
                                AvailableDataSources="{Binding RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}, Path=AvailableDataSources}"
                                DataType="{Binding RuleType, Converter={StaticResource ConditionTypeConverter}}"
                                BindingSource="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SyncEditingToSource="True"
                                ParameterName="{Binding Name}"
                                Height="28"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 有效值范围 / 期望值：数值类型显示 Min/Max 输入框，String 类型显示期望值 TextBox -->
                <DataGridTemplateColumn Header="范围 / 期望值" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RuleType}" Value="String">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <controls:RangeInputControl
                                        MinValue="{Binding MinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        MaxValue="{Binding MaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ShowSlider="False"
                                        NumericWidth="90"
                                        Height="28"/>
                                </StackPanel>
                                <TextBox Text="{Binding ExpectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" FontSize="11" VerticalContentAlignment="Center"
                                         Margin="0,0,4,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RuleType}" Value="String">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 判断：OK/NG 下拉（Int/Double=范围内/范围外，String=相等/不相等） -->
                <DataGridTemplateColumn Header="判断" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}, Path=JudgmentOptions}"
                                      SelectedItem="{Binding Judgment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="28" FontSize="11" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 目标：普通 ComboBox（GetChildNodes 画布下游，无外层 Border，简洁下拉）
                     ★ ItemTemplate 统一关闭态/下拉项显示（避免关闭态回退到 ToString() 渲染"6 Script2 (Script)"） -->
                <DataGridTemplateColumn Header="目标" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}, Path=ChildNodeOptions}"
                                      SelectedValuePath="NodeId"
                                      SelectedValue="{Binding ExecutionModuleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="28" FontSize="11" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NodeName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 操作：删除 -->
                <DataGridTemplateColumn Header="操作" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="&#x2715;" Click="DeleteRule_Click"
                                    Width="26" Height="28" Padding="0"
                                    Background="{DynamicResource ThemeControlBackgroundBrush}" Foreground="{DynamicResource ThemeErrorBrush}"
                                    BorderThickness="0" FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：类型下拉 + 新增规则（紧跟表格，随表格一起自适应） -->
        <Border Margin="0,8,0,0"
                BorderBrush="{DynamicResource ThemeStatusBarBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource ThemeStatusBarBackgroundBrush}" Padding="4,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="类型:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,6,0"/>
                <ComboBox x:Name="TypeCombo" Height="26" MinWidth="90" VerticalAlignment="Center">
                    <sys:String>Int</sys:String>
                    <sys:String>Double</sys:String>
                    <sys:String>String</sys:String>
                </ComboBox>
                <Button Content="+ 新增规则" Height="26" Margin="6,0,0,0"
                        Click="AddRule_Click"
                        Background="{DynamicResource ThemeSuccessBrush}" Foreground="{DynamicResource ThemeTextOnDarkBrush}"
                        BorderThickness="0" FontWeight="Bold" FontSize="12"/>
            </StackPanel>
        </Border>
    </StackPanel>
</controls:ToolDebugControlBase>
