<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.EdgeDetect.Views.EdgeDetectToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:measure="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Measure.Views;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        d:DesignHeight="560" d:DesignWidth="900"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid Margin="5">
        <TabControl>
            <!-- ===== Tab1 基本参数 ===== -->
            <TabItem Header="基本参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="区域设置" Margin="0,0,0,8">
                            <measure:MeasurementEditorManagerControl x:Name="MeasurementManager"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Tab2 运行参数 ===== -->
            <TabItem Header="运行参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Expander Header="卡尺参数" IsExpanded="True">
                            <StackPanel Margin="8,4">
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="测量带宽度" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Parameters.MeasureLength1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" HorizontalAlignment="Left"/>
                                    <TextBlock Text="px（法线方向）" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="测量带长度" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Parameters.MeasureLength2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" HorizontalAlignment="Left"/>
                                    <TextBlock Text="px（切线方向）" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="平滑 Sigma" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Parameters.Sigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="边缘阈值" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Parameters.Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="边缘极性" Width="110" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TransitionCombo"
                                              SelectedIndex="0"
                                              SelectionChanged="TransitionCombo_SelectionChanged"
                                              Width="120" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="全部"/>
                                        <ComboBoxItem Content="黑到白"/>
                                        <ComboBoxItem Content="白到黑"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="选取模式" Width="110" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="SelectCombo"
                                              SelectedIndex="0"
                                              SelectionChanged="SelectCombo_SelectionChanged"
                                              Width="120" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="全部"/>
                                        <ComboBoxItem Content="第一个"/>
                                        <ComboBoxItem Content="最后一个"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="拟合筛选" IsExpanded="True">
                            <StackPanel Margin="8,4">
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="最小边缘点数" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Parameters.MinEdgePoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="最大残差 RMSE" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Parameters.MaxRMSE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" HorizontalAlignment="Left"/>
                                    <TextBlock Text="px" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Tab3 结果显示 ===== -->
            <TabItem Header="结果显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Expander Header="拟合结果" IsExpanded="True">
                            <StackPanel Margin="8,4">
                                <TextBlock Text="{Binding ResultText, RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}}"
                                           Margin="0,2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="拟合质量" IsExpanded="True">
                            <StackPanel Margin="8,4">
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="拟合残差 RMSE" Width="120" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ResultRMSE, RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}}"
                                               FontWeight="Bold"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="边缘点数" Width="120" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ResultEdgePointCount, RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}}"
                                               FontWeight="Bold"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</controls:ToolDebugControlBase>
