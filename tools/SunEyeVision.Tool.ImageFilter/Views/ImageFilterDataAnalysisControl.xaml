<UserControl x:Class="SunEyeVision.Tool.ImageFilter.Views.ImageFilterDataAnalysisControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Converters;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        d:DesignHeight="350" d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- 统计摘要区域（顶部固定） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="滤波类型: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FilterTypeName, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries1Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="内核: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding KernelText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries2Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="均值: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MeanValue, StringFormat='{}{0:F1}', Mode=OneWay}" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries3Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="标准差: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding StdValue, StringFormat='{}{0:F1}', Mode=OneWay}" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries4Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="最小值: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MinValue, StringFormat='{}{0:F1}', Mode=OneWay}" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeries5Brush}}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="最大值: " Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding MaxValue, StringFormat='{}{0:F1}', Mode=OneWay}" FontSize="11" Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.DataSeriesMutedBrush}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 详细数据分析列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DataItems}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 判断结果面板（底部固定） -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeWarningBrush}" BorderThickness="1,0,0,0" Padding="10,8"
                Visibility="{Binding HasResultData, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="结果: " FontWeight="Bold" Foreground="{Binding IsPassColor, Mode=OneWay}"/>
                    <TextBlock Text="{Binding IsPassText, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding IsPassColor, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Text="{Binding FailReasonText, Mode=OneWay}"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
