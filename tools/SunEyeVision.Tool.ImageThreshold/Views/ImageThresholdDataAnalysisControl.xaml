<UserControl x:Class="SunEyeVision.Tool.ImageThreshold.Views.ImageThresholdDataAnalysisControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Converters;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        d:DesignHeight="350" d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- 统计摘要区域（顶部固定） -->
        <Border DockPanel.Dock="Top" Background="#F0F4F8" BorderBrush="#D0D8E0" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="方法: " Foreground="#666"/>
                    <TextBlock Text="{Binding MethodName, Mode=OneWay}" FontWeight="Bold" Foreground="#2196F3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="阈值: " Foreground="#666"/>
                    <TextBlock Text="{Binding ThresholdValue, StringFormat='{}{0:F0}', Mode=OneWay}" FontWeight="Bold" Foreground="#4CAF50"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="白色比例: " Foreground="#666"/>
                    <TextBlock Text="{Binding WhiteRatio, StringFormat='{}{0:F1}%', Mode=OneWay}" Foreground="#E91E63"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="面积: " Foreground="#666"/>
                    <TextBlock Text="{Binding OutputArea, StringFormat='{}{0}', Mode=OneWay}" Foreground="#9C27B0"/>
                </StackPanel>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding MethodDetail, Mode=OneWay}" Foreground="#607D8B" FontSize="11"/>
            </Grid>
        </Border>

        <!-- 详细数据分析列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DataItems}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#333" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 判断结果面板（底部固定） -->
        <Border DockPanel.Dock="Bottom" Background="#FFFDE7" BorderBrush="#FFC107" BorderThickness="1,0,0,0" Padding="10,8"
                Visibility="{Binding HasResultData, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="结果: " FontWeight="Bold" Foreground="{Binding IsPassColor, Mode=OneWay}"/>
                    <TextBlock Text="{Binding IsPassText, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding IsPassColor, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#5D4037" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Text="{Binding FailReasonText, Mode=OneWay}"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
