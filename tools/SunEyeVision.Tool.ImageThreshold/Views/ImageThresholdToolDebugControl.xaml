<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.ImageThreshold.Views.ImageThresholdToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Converters;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SunEyeVision.Tool.ImageThreshold"
        mc:Ignorable="d"
        d:DesignHeight="550" d:DesignWidth="400"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

    <Grid>
        <TabControl Margin="5,0,5,0">
            <!-- Tab1: 基本参数（对齐 BlobAnalysis） -->
            <TabItem Header="基本参数" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <controls:LabeledControl Label="输入图像" HorizontalAlignment="Left">
                            <controls:ImageSourceSelector
                                x:Name="imageSourceSelector"
                                PlaceholderText="请选择输入图像源"
                                Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"
                                SelectedDataSource="{Binding ImageSource, Mode=TwoWay}"/>
                        </controls:LabeledControl>

                        <!-- 启用区域限制 -->
                        <controls:LabeledControl Label="启用区域限制">
                            <CheckBox IsChecked="{Binding IsRegionEnabled.Value, Mode=TwoWay}"
                                Content="仅对指定区域进行分析"/>
                        </controls:LabeledControl>

                        <!-- 区域管理器 -->
                        <GroupBox Header="区域设置" Margin="0,8,0,0"
                            Visibility="{Binding IsRegionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
                            <region:RegionEditorManagerControl x:Name="regionManager"
                                InspectionRegionsSource="{Binding InspectionRegions.Regions}"
                                MaskRegionsSource="{Binding MaskRegions.Regions}"/>
                        </GroupBox>

                        <!-- 位置修正 -->
                        <controls:LabeledControl Label="位置修正" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <controls:ToggleSwitch
                                IsChecked="{Binding IsPositionCorrectionEnabled.Value, Mode=TwoWay}"
                                SwitchWidth="48" SwitchHeight="24"/>
                        </controls:LabeledControl>

                        <controls:LabeledControl Label="修正信息" Margin="0,4,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding IsPositionCorrectionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
                            <controls:ParamBinding
                                x:Name="positionCorrectionBinding"
                                ParameterName="位置修正" Width="200"
                                BindingSource="{Binding PositionCorrectionBindingSource, Mode=TwoWay}"
                                BindingDisplayText="{Binding PositionCorrectionBindingDisplayText, Mode=TwoWay}"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab2: 运行参数 -->
            <TabItem Header="运行参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <controls:LabeledControl Label="二值化方法">
                            <ComboBox x:Name="methodComboBox"
                                Height="32"
                                VerticalContentAlignment="Center" Width="250"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Global (全局阈值)"/>
                                <ComboBoxItem Content="OTSU (自动阈值)"/>
                                <ComboBoxItem Content="SmoothHisto (平滑直方图)"/>
                                <ComboBoxItem Content="Dynamic (动态阈值)"/>
                                <ComboBoxItem Content="LocalStats (局部统计)"/>
                            </ComboBox>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="阈值" x:Name="thresholdGroup">
                            <controls:ConfigSetting
                                x:Name="thresholdParam"
                                ParameterName="Threshold"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding Threshold.Value, Mode=TwoWay}"
                                Minimum="0" Maximum="255"
                                SmallChange="1" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="最大值" x:Name="maxValueGroup">
                            <controls:ConfigSetting
                                x:Name="maxValueParam"
                                ParameterName="MaxValue"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding MaxValue.Value, Mode=TwoWay}"
                                Minimum="0" Maximum="255"
                                SmallChange="1" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="亮暗选择" x:Name="lightDarkGroup" Visibility="Collapsed">
                            <ComboBox x:Name="lightDarkComboBox"
                                Height="32"
                                VerticalContentAlignment="Center" Width="250"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Light (亮区域)"/>
                                <ComboBoxItem Content="Dark (暗区域)"/>
                            </ComboBox>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="反转结果">
                            <controls:ToggleSwitch
                                IsChecked="{Binding Invert.Value, Mode=TwoWay}"
                                SwitchWidth="48" SwitchHeight="24"/>
                        </controls:LabeledControl>
                        <Separator Margin="0,8,0,8"/>

                        <!-- 动态/局部阈值参数组 -->
                        <TextBlock Text="动态/局部阈值参数" x:Name="advParamHeader"
                            FontSize="13" FontWeight="Medium"
                            Margin="0 8 0 4" Foreground="#333333" Visibility="Collapsed"/>
                        <controls:LabeledControl Label="偏移量" x:Name="offsetGroup" Visibility="Collapsed">
                            <controls:ConfigSetting
                                x:Name="offsetParam"
                                ParameterName="Offset"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding Offset.Value, Mode=TwoWay}"
                                Minimum="0" Maximum="255"
                                SmallChange="1" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="平滑核大小" x:Name="smoothKernelGroup" Visibility="Collapsed">
                            <controls:ConfigSetting
                                x:Name="smoothKernelParam"
                                ParameterName="SmoothKernel"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding SmoothKernel.Value, Mode=TwoWay}"
                                Minimum="3" Maximum="51"
                                SmallChange="2" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="掩码宽度" x:Name="maskWidthGroup" Visibility="Collapsed">
                            <controls:ConfigSetting
                                x:Name="maskWidthParam"
                                ParameterName="MaskWidth"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding MaskWidth.Value, Mode=TwoWay}"
                                Minimum="3" Maximum="99"
                                SmallChange="2" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="掩码高度" x:Name="maskHeightGroup" Visibility="Collapsed">
                            <controls:ConfigSetting
                                x:Name="maskHeightParam"
                                ParameterName="MaskHeight"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding MaskHeight.Value, Mode=TwoWay}"
                                Minimum="3" Maximum="99"
                                SmallChange="2" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="标准差缩放" x:Name="stdDevScaleGroup" Visibility="Collapsed">
                            <controls:ConfigSetting
                                x:Name="stdDevScaleParam"
                                ParameterName="StdDevScale"
                                DataType="{x:Type sys:Double}"
                                Value="{Binding StdDevScale.Value, Mode=TwoWay}"
                                Minimum="0" Maximum="10"
                                SmallChange="0.1" LargeChange="0.5"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="绝对阈值偏移" x:Name="absThresholdGroup" Visibility="Collapsed">
                            <controls:ConfigSetting
                                x:Name="absThresholdParam"
                                ParameterName="AbsThreshold"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding AbsThreshold.Value, Mode=TwoWay}"
                                Minimum="0" Maximum="255"
                                SmallChange="1" LargeChange="10"
                                ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab3: 结果显示（二值化专用简化版） -->
            <TabItem Header="结果显示">
                <Grid Background="#F5F5F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Padding="3">
                        <StackPanel>
                            <!-- 结果判断分组 -->
                            <Expander Header="结果判断" IsExpanded="True"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Margin="0,0,0,8" Background="White">
                                <StackPanel Margin="16,8">
                                    <controls:LabeledControl Label="输出为空判断" ContentHorizontalAlignment="Left">
                                        <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsEmptyCheckEnabled, Mode=TwoWay}"/>
                                    </controls:LabeledControl>
                                    <controls:LabeledControl Label="白色像素比例" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                                        <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsWhitePixelRatioCheckEnabled, Mode=TwoWay}"/>
                                    </controls:LabeledControl>
                                    <controls:LabeledControl Label="白色像素比例 (%)" Margin="0,2,0,0"
                                        Visibility="{Binding ResultConfig.IsWhitePixelRatioCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:RangeInputControl Unit="%" Minimum="0" Maximum="100"
                                            MinValue="{Binding ResultConfig.WhitePixelRatioMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.WhitePixelRatioMax, Mode=TwoWay}"
                                            DecimalPlaces="1" SmallChange="1" NumericWidth="120"/>
                                    </controls:LabeledControl>
                                </StackPanel>
                            </Expander>

                            <!-- 图形显示分组 -->
                            <Expander Header="图形显示" IsExpanded="True"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Margin="0,0,0,8" Background="White">
                                <StackPanel Margin="16,8">
                                    <controls:LabeledControl Label="二值图叠加" ContentHorizontalAlignment="Left">
                                        <controls:DispItemColorControl
                                            Item="{Binding BinaryOverlayStyle, Mode=TwoWay}"
                                            ContentHorizontalAlignment="Left"/>
                                    </controls:LabeledControl>
                                </StackPanel>
                            </Expander>

                            <!-- 文本显示分组 -->
                            <Expander Header="文本显示" IsExpanded="True"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Margin="0,0,0,8" Background="White">
                                <StackPanel Margin="16,8">
                                    <controls:LabeledControl Label="统计信息" ContentHorizontalAlignment="Left">
                                        <controls:DispTextColorControl
                                            Item="{Binding StatisticsStyle, Mode=TwoWay}"
                                            AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                                    </controls:LabeledControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</controls:ToolDebugControlBase>
