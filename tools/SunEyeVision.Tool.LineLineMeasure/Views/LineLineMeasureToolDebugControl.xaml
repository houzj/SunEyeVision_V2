<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.LineLineMeasure.Views.LineLineMeasureToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:designParameters="clr-namespace:SunEyeVision.Tool.LineLineMeasure"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Converters;assembly=SunEyeVision.Plugin.SDK"
        xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
        xmlns:measure="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Measure.Views;assembly=SunEyeVision.Plugin.SDK"
        xmlns:presentation="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.ResultPresentation;assembly=SunEyeVision.Plugin.SDK"
        xmlns:results="clr-namespace:SunEyeVision.Plugin.SDK.Execution.Results;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        d:DataContext="{d:DesignInstance Type=designParameters:LineLineMeasureParameters, IsDesignTimeCreatable=True}"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}"
        Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:DesignTimeThemeResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

    <TabControl Margin="5,0,5,0">
        <!-- ============ Tab1 基本参数：输入图像 + 双卡尺编辑 + 位置修正 ============ -->
        <TabItem Header="基本参数" IsSelected="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <controls:LabeledControl Label="输入图像" HorizontalAlignment="Left">
                        <controls:ImageSourceSelector
                            PlaceholderText="请选择输入图像源" Width="250"
                            AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"
                            SelectedDataSource="{Binding ImageSource, Mode=TwoWay}"/>
                    </controls:LabeledControl>

                    <!-- 双测量元素（卡尺1/卡尺2 无屏蔽区，互斥并排）—— 去掉外层 GroupBox 边框，避免双层卡片 -->
                    <measure:MeasureElementsEditorControl x:Name="ElementsEditor" Margin="0,8,0,0"
                                                          Element1GeometryType="Line"
                                                          Element2GeometryType="Line"/>

                    <controls:LabeledControl Label="位置修正" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <controls:ToggleSwitch
                            IsChecked="{Binding IsPositionCorrectionEnabled, Mode=TwoWay}"
                            SwitchWidth="48" SwitchHeight="24"/>
                    </controls:LabeledControl>
                    <controls:LabeledControl Label="修正信息" Margin="0,4,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding IsPositionCorrectionEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:ParamBinding
                            x:Name="positionCorrectionBinding"
                            DataType="{x:Type results:AffineMatrix}"
                            ParameterName="位置修正" Width="200"
                            BindingSource="{Binding PositionCorrectionBindingSource, Mode=TwoWay}"
                            BindingDisplayText="{Binding PositionCorrectionBindingDisplayText, Mode=OneWay}"
                            AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                    </controls:LabeledControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ Tab2 运行参数：两元素 边缘检测参数 + 拟合筛选（卡尺几何参数见 Tab1 选中卡尺面板） ============ -->
        <TabItem Header="运行参数">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <!-- 卡尺切换（一份运行参数区，切换卡尺1/2） -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="卡尺" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RunElementSwitchCombo" Width="140" Margin="8,0,0,0"
                                  SelectionChanged="OnRunElementSwitchChanged">
                            <ComboBoxItem Content="卡尺1"/>
                            <ComboBoxItem Content="卡尺2"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- ===== 卡尺1 运行参数（边缘检测参数，参考直线查找 Tab2） ===== -->
                    <StackPanel x:Name="RunElement1Panel">
                        <Separator Margin="0,0,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}" Height="1"/>
                        <TextBlock Text="边缘检测参数" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <controls:LabeledControl Label="平滑 Sigma" Margin="0,0,0,4">
                            <controls:ConfigSetting ParameterName="E1Sigma" DataType="{x:Type sys:Double}"
                                Value="{Binding E1Sigma, Mode=TwoWay}" Minimum="0.5" Maximum="10" ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="边缘阈值" Margin="0,0,0,4">
                            <controls:ConfigSetting ParameterName="E1Threshold" DataType="{x:Type sys:Double}"
                                Value="{Binding E1Threshold, Mode=TwoWay}" Minimum="0" Maximum="255" ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="边缘极性" Margin="0,0,0,4">
                            <ComboBox x:Name="E1TransitionCombo" Width="250" HorizontalAlignment="Left" Height="32"
                                      VerticalContentAlignment="Center" SelectionChanged="OnE1TransitionChanged"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="选取模式" Margin="0,0,0,4">
                            <ComboBox x:Name="E1SelectCombo" Width="250" HorizontalAlignment="Left" Height="32"
                                      VerticalContentAlignment="Center" SelectionChanged="OnE1SelectChanged"/>
                        </controls:LabeledControl>
                        <Expander Header="高级参数（鲁棒拟合）" IsExpanded="False" Margin="0,8,0,0"
                                  BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}" BorderThickness="1">
                            <StackPanel Margin="16,8">
                                <controls:LabeledControl Label="距离阈值" Margin="0,0,0,4">
                                    <controls:ConfigSetting ParameterName="E1DistanceThreshold" DataType="{x:Type sys:Double}"
                                        Value="{Binding E1DistanceThreshold, Mode=TwoWay}" Minimum="0.5" Maximum="20" Width="250"
                                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                                </controls:LabeledControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ===== 卡尺2 运行参数（同构） ===== -->
                    <StackPanel x:Name="RunElement2Panel" Visibility="Collapsed">
                        <Separator Margin="0,0,0,4" Background="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}" Height="1"/>
                        <TextBlock Text="边缘检测参数" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <controls:LabeledControl Label="平滑 Sigma" Margin="0,0,0,4">
                            <controls:ConfigSetting ParameterName="E2Sigma" DataType="{x:Type sys:Double}"
                                Value="{Binding E2Sigma, Mode=TwoWay}" Minimum="0.5" Maximum="10" ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="边缘阈值" Margin="0,0,0,4">
                            <controls:ConfigSetting ParameterName="E2Threshold" DataType="{x:Type sys:Double}"
                                Value="{Binding E2Threshold, Mode=TwoWay}" Minimum="0" Maximum="255" ShowSlider="True" Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="边缘极性" Margin="0,0,0,4">
                            <ComboBox x:Name="E2TransitionCombo" Width="250" HorizontalAlignment="Left" Height="32"
                                      VerticalContentAlignment="Center" SelectionChanged="OnE2TransitionChanged"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="选取模式" Margin="0,0,0,4">
                            <ComboBox x:Name="E2SelectCombo" Width="250" HorizontalAlignment="Left" Height="32"
                                      VerticalContentAlignment="Center" SelectionChanged="OnE2SelectChanged"/>
                        </controls:LabeledControl>
                        <Expander Header="高级参数（鲁棒拟合）" IsExpanded="False" Margin="0,8,0,0"
                                  BorderBrush="{DynamicResource {x:Static themes:SdkThemeKeys.BorderBrush}}" BorderThickness="1">
                            <StackPanel Margin="16,8">
                                <controls:LabeledControl Label="距离阈值" Margin="0,0,0,4">
                                    <controls:ConfigSetting ParameterName="E2DistanceThreshold" DataType="{x:Type sys:Double}"
                                        Value="{Binding E2DistanceThreshold, Mode=TwoWay}" Minimum="0.5" Maximum="20" Width="250"
                                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                                </controls:LabeledControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ Tab3 结果显示：判定（MeasureThreshold 列表）+ 图形 + 文本 ============ -->
        <TabItem Header="结果显示">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
            <presentation:JudgmentEditorControl ItemsSource="{Binding ResultPresentation.Judgments}"/>
            <presentation:GraphicsDisplayEditorControl ItemsSource="{Binding ResultPresentation.Graphics}"/>
            <presentation:TextDisplayEditorControl ItemsSource="{Binding ResultPresentation.Texts}"
                                                   AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
          </StackPanel>
            </ScrollViewer></TabItem>
    </TabControl>
</controls:ToolDebugControlBase>
