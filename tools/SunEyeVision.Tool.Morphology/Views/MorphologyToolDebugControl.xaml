<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.Morphology.Views.MorphologyToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Converters;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SunEyeVision.Tool.Morphology"
        xmlns:localConverters="clr-namespace:SunEyeVision.Tool.Morphology.Converters"
        xmlns:results="clr-namespace:SunEyeVision.Plugin.SDK.Execution.Results;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        d:DesignHeight="550" d:DesignWidth="400"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <localConverters:MorphOperationConverter x:Key="MorphOperationConverter"/>
            <localConverters:MorphShapeConverter x:Key="MorphShapeConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

  <Grid>
    <TabControl Margin="5,0,5,0">
      <!-- Tab1: 基本参数 -->
      <TabItem Header="基本参数" IsSelected="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <controls:LabeledControl Label="输入图像" ContentHorizontalAlignment="Center" ContentVerticalAlignment="Center" LabelVerticalAlignment="Center">
              <controls:ImageSourceSelector
                                x:Name="imageSourceSelector"
                                PlaceholderText="请选择输入图像源"
                                Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"
                                SelectedDataSource="{Binding ImageSource, Mode=TwoWay}"/>
            </controls:LabeledControl>

            <!-- 启用区域限制 -->
            <controls:LabeledControl Label="启用区域限制">
              <CheckBox IsChecked="{Binding IsRegionEnabled.Value, Mode=TwoWay}"
                        Content="仅对指定区域进行形态学处理"/>
            </controls:LabeledControl>

            <!-- 区域管理器 -->
            <GroupBox Header="区域设置" Margin="0,8,0,0"
                      Visibility="{Binding IsRegionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
                <region:RegionEditorManagerControl x:Name="regionManager"
                    InspectionRegionsSource="{Binding InspectionRegions.Regions}"
                    MaskRegionsSource="{Binding MaskRegions.Regions}"/>
            </GroupBox>

            <!-- 位置修正（参考 BlobAnalysis 布局） -->
            <controls:LabeledControl Label="位置修正" Margin="0,8,0,0" HorizontalAlignment="Left">
              <controls:ToggleSwitch
                  IsChecked="{Binding IsPositionCorrectionEnabled.Value, Mode=TwoWay}"
                  SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="修正信息" Margin="0,4,0,0" HorizontalAlignment="Left"
                Visibility="{Binding IsPositionCorrectionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ParamBinding
                  x:Name="positionCorrectionBinding"
                  DataType="{x:Type results:AffineMatrix}"
                  ParameterName="位置修正" Width="200"
                  BindingSource="{Binding PositionCorrectionBindingSource, Mode=TwoWay}"
                  BindingDisplayText="{Binding PositionCorrectionBindingDisplayText, Mode=TwoWay}"
                  AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab2: 运行参数 -->
      <TabItem Header="运行参数">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <controls:LabeledControl Label="形态学操作">
              <ComboBox x:Name="operationComboBox"
                      Height="32"
                      VerticalContentAlignment="Center" Width="250"
                      ToolTip="形态学运算类型：腐蚀/膨胀/开运算/闭运算/梯度/顶帽/黑帽"
                      SelectedItem="{Binding Operation.Value, Mode=TwoWay, Converter={StaticResource MorphOperationConverter}}">
                <sys:String>腐蚀</sys:String>
                <sys:String>膨胀</sys:String>
                <sys:String>开运算</sys:String>
                <sys:String>闭运算</sys:String>
                <sys:String>梯度</sys:String>
                <sys:String>顶帽</sys:String>
                <sys:String>黑帽</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <controls:LabeledControl Label="结构元素形状">
              <ComboBox x:Name="shapeComboBox"
                      Height="32"
                      VerticalContentAlignment="Center" Width="250"
                      ToolTip="结构元素形状：矩形(通用)、十字形(线状特征)、椭圆形(圆形特征)"
                      SelectedItem="{Binding KernelShape.Value, Mode=TwoWay, Converter={StaticResource MorphShapeConverter}}">
                <sys:String>矩形</sys:String>
                <sys:String>十字形</sys:String>
                <sys:String>椭圆形</sys:String>
              </ComboBox>
            </controls:LabeledControl>

            <controls:LabeledControl Label="核宽度">
              <controls:ConfigSetting
                                x:Name="kernelWidthParam"
                                ParameterName="KernelWidth"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding KernelWidth.Value, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="51"
                                SmallChange="2"
                                LargeChange="10"
                                ShowSlider="True" Width="250"
                                ToolTip="核宽度(奇数, 1-51)：结构元素的水平尺寸，决定操作强度"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="核高度">
              <controls:ConfigSetting
                                x:Name="kernelHeightParam"
                                ParameterName="KernelHeight"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding KernelHeight.Value, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="51"
                                SmallChange="2"
                                LargeChange="10"
                                ShowSlider="True" Width="250"
                                ToolTip="核高度(奇数, 1-51)：结构元素的垂直尺寸，决定操作强度"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="迭代次数">
              <controls:ConfigSetting
                                x:Name="iterationsParam"
                                ParameterName="Iterations"
                                DataType="{x:Type sys:Int32}"
                                Value="{Binding Iterations.Value, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="20"
                                SmallChange="1"
                                LargeChange="5"
                                ShowSlider="True" Width="250"
                                ToolTip="迭代次数(1-20)：操作重复执行的次数，次数越多效果越显著"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>

            <!-- 参数说明（默认折叠） -->
            <controls:ParamGroup Header="参数说明" IsExpanded="False" Margin="0,12,0,0">
                <StackPanel Margin="8,4">
                    <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="12" FontWeight="SemiBold" Text="形态学操作说明"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,2,0,0"
                               Text="● 腐蚀(Erode): 结构元素取最小值替换锚点，消除细小凸起，断开窄连接"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="● 膨胀(Dilate): 结构元素取最大值替换锚点，填补空洞，连接断裂区域"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="● 开运算(Open): 先腐蚀后膨胀，消除细小亮点，断开窄连接，面积大致不变"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="● 闭运算(Close): 先膨胀后腐蚀，填补细小暗洞，连接窄断裂，面积大致不变"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="● 梯度(Gradient): 膨胀结果减腐蚀结果，提取目标边缘轮廓"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="● 顶帽(TopHat): 原图减开运算，提取比结构元素小的亮区域"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="● 黑帽(BlackHat): 闭运算减原图，提取比结构元素小的暗区域"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0" Text="参数详解"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,2,0,0"
                               Text="结构形状: Rect矩形(通用)、Cross十字形(线状)、Ellipse椭圆形(圆形)"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="核宽高: 结构元素的尺寸，必须为奇数，越大操作越强"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="迭代次数: 操作重复执行次数，多次迭代效果叠加"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,1,0,0"
                               Text="边界类型: Constant(黑色填充)推荐，Reflect(镜像反射)，Replicate(复制边界)"/>
                </StackPanel>
            </controls:ParamGroup>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab3: 结果显示 -->
      <TabItem Header="结果显示">
        <Grid Background="#F5F5F5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" Padding="3">
            <StackPanel>
              <!-- 结果判断分组 -->
              <Expander Header="结果判断"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <!-- 输出为空判断 -->
                  <controls:LabeledControl Label="输出为空判断" ContentHorizontalAlignment="Left">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsEmptyCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>

                  <!-- 总面积判断 -->
                  <controls:LabeledControl Label="总面积判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="总面积范围 (px²):" Margin="0,2,0,0" ContentHorizontalAlignment="Left"
                                           Visibility="{Binding ResultConfig.IsAreaCheckEnabled,
                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="px²"
                                            Minimum="0"
                                            Maximum="1000000"
                                            MinValue="{Binding ResultConfig.AreaMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.AreaMax, Mode=TwoWay}"
                                            DecimalPlaces="0"
                      SmallChange="1"
                      NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- Blob数量判断 -->
                  <controls:LabeledControl Label="Blob数量判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsBlobCountCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="Blob数量范围:" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsBlobCountCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit=""
                                            Minimum="0"
                                            Maximum="10000"
                                            MinValue="{Binding ResultConfig.BlobCountMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.BlobCountMax, Mode=TwoWay}"
                                            DecimalPlaces="0" NumericWidth="120"/>
                  </controls:LabeledControl>

                  <!-- 最大Blob面积判断 -->
                  <controls:LabeledControl Label="最大Blob面积判断" ContentHorizontalAlignment="Left" Margin="0,2,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsMaxBlobAreaCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="最大Blob面积范围 (px²):" Margin="0,2,0,0"
                                                            Visibility="{Binding ResultConfig.IsMaxBlobAreaCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RangeInputControl
                                            Unit="px²"
                                            Minimum="0"
                                            Maximum="1000000"
                                            MinValue="{Binding ResultConfig.MaxBlobAreaMin, Mode=TwoWay}"
                                            MaxValue="{Binding ResultConfig.MaxBlobAreaMax, Mode=TwoWay}"
                                            DecimalPlaces="1" NumericWidth="120"/>
                  </controls:LabeledControl>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</controls:ToolDebugControlBase>
