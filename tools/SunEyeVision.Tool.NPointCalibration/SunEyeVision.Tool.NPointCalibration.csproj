<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SunEyeVision.Tool.NPointCalibration</RootNamespace>
    <AssemblyName>SunEyeVision.Tool.NPointCalibration</AssemblyName>
    <IsToolPlugin>true</IsToolPlugin>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Plugin.SDK/SunEyeVision.Plugin.SDK.csproj" Private="false" />
    <ProjectReference Include="../../src/SunEyeVision.HalAdapter/SunEyeVision.HalAdapter.csproj" Private="false" />
    <Reference Include="halcondotnetxl">
      <HintPath>../../libs/halcon/net/halcondotnetxl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
