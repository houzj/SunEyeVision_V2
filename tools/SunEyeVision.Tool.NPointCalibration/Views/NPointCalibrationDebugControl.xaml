<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.NPointCalibration.Views.NPointCalibrationDebugControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
    xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
    xmlns:geometry="clr-namespace:SunEyeVision.Plugin.SDK.Models.Geometry;assembly=SunEyeVision.Plugin.SDK"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:SunEyeVision.Tool.NPointCalibration"
    xmlns:views="clr-namespace:SunEyeVision.Tool.NPointCalibration.Views"
    xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
    xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Converters;assembly=SunEyeVision.Plugin.SDK"
    DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}"
    Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
    Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}">
    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:DesignTimeThemeResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumToVisibilityConverter x:Key="EnumVisibility"/>
            <converters:EnumToBoolConverter x:Key="EnumToBool"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="清空标定点" Click="ClearSamples_Click" Margin="2" Padding="8,4"/>
            <Button Content="生成标定文件" Click="SaveCalibration_Click" Margin="2" Padding="8,4"/>
            <Button Content="执行" Command="{x:Static commands:ToolCommands.Execute}" Margin="2" Padding="12,4"/>
        </StackPanel>
        <TabControl Margin="5,0,5,0">
            <TabItem Header="基本参数" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="标定参数" FontWeight="Bold" Margin="0,4,0,10"/>
                        <controls:LabeledControl Label="标定点获取">
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding AcquisitionMode, Mode=TwoWay}" Width="240">
                                <ComboBoxItem Content="触发获取" Tag="{x:Static local:NPointAcquisitionMode.Trigger}"/>
                                <ComboBoxItem Content="手动输入" Tag="{x:Static local:NPointAcquisitionMode.Manual}"/>
                            </ComboBox>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="标定点输入">
                            <StackPanel Orientation="Horizontal" Width="240">
                                <RadioButton Content="按点" GroupName="NPointInputMode" Margin="0,0,16,0"
                                             IsChecked="{Binding InputMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Point}"/>
                                <RadioButton Content="按坐标" GroupName="NPointInputMode"
                                             IsChecked="{Binding InputMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Coordinates}"/>
                            </StackPanel>
                        </controls:LabeledControl>
                        <StackPanel Visibility="{Binding InputMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Point}">
                        <controls:LabeledControl Label="图像点">
                            <controls:ParamBinding ParameterName="ImagePoint" DataType="{x:Type geometry:Point2d}"
                                BindingSource="{Binding ImagePointBindingSource, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="物理点">
                            <controls:ParamBinding ParameterName="PhysicalPoint" DataType="{x:Type geometry:Point2d}"
                                BindingSource="{Binding PhysicalPointBindingSource, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding InputMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Coordinates}">
                        <controls:LabeledControl Label="图像坐标X">
                            <controls:ConfigSetting ParameterName="ImageX" DataType="{x:Type sys:Double}" Value="{Binding ImageX, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="图像坐标Y">
                            <controls:ConfigSetting ParameterName="ImageY" DataType="{x:Type sys:Double}" Value="{Binding ImageY, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="物理坐标X">
                            <controls:ConfigSetting ParameterName="PhysicalX" DataType="{x:Type sys:Double}" Value="{Binding PhysicalX, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="物理坐标Y">
                            <controls:ConfigSetting ParameterName="PhysicalY" DataType="{x:Type sys:Double}" Value="{Binding PhysicalY, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        </StackPanel>
                        <controls:LabeledControl Label="图像角度">
                            <controls:ConfigSetting ParameterName="ImageAngle" DataType="{x:Type sys:Double}" Value="{Binding ImageAngle, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="物理角度">
                            <controls:ConfigSetting ParameterName="PhysicalAngle" DataType="{x:Type sys:Double}" Value="{Binding PhysicalAngle, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="平移次数">
                            <controls:NumericUpDown Width="240" IntValue="{Binding TranslationCount, Mode=TwoWay}"
                                                    Minimum="1" Maximum="1000" ShowSlider="False"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="旋转次数">
                            <StackPanel Orientation="Horizontal">
                                <controls:NumericUpDown Width="194" IntValue="{Binding RotationCount, Mode=TwoWay}"
                                                        Minimum="0" Maximum="1000" ShowSlider="False"/>
                                <Button Content="✎" ToolTip="编辑标定点" Width="38" Margin="8,0,0,0" Click="EditSamples_Click"/>
                            </StackPanel>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="示教触发">
                            <controls:ConfigSetting ParameterName="TeachSignal" DataType="{x:Type sys:Boolean}" Value="{Binding TeachSignal, Mode=TwoWay}" Width="240"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="字符示教">
                            <controls:ToggleSwitch IsChecked="{Binding TeachEnabled, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/>
                        </controls:LabeledControl>
                        <StackPanel Visibility="{Binding TeachEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:LabeledControl Label="输入字符">
                                <controls:ConfigSetting ParameterName="ExternalInputText" DataType="{x:Type sys:String}" Value="{Binding ExternalInputText, Mode=TwoWay}" Width="240"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                            </controls:LabeledControl>
                            <controls:LabeledControl Label="触发字符"><TextBox Width="240" Text="{Binding TeachTriggerText, Mode=TwoWay}"/></controls:LabeledControl>
                            <controls:LabeledControl Label="事件序号">
                                <controls:ConfigSetting ParameterName="TeachEventId" DataType="{x:Type sys:Int64}" Value="{Binding TeachEventId, Mode=TwoWay}" Width="240"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                            </controls:LabeledControl>
                        </StackPanel>
                        <TextBlock Text="物理坐标系参数" FontWeight="Bold" Margin="0,16,0,8"/>
                        <controls:LabeledControl Label="自动生成物理点">
                            <controls:ToggleSwitch IsChecked="{Binding UseGeneratedPhysical, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="基准点 X"><controls:NumericUpDown Width="240" Value="{Binding BaseX, Mode=TwoWay}" Minimum="-1000000000" Maximum="1000000000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="基准点 Y"><controls:NumericUpDown Width="240" Value="{Binding BaseY, Mode=TwoWay}" Minimum="-1000000000" Maximum="1000000000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="偏移 X"><controls:NumericUpDown Width="240" Value="{Binding OffsetX, Mode=TwoWay}" Minimum="-1000000000" Maximum="1000000000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="偏移 Y"><controls:NumericUpDown Width="240" Value="{Binding OffsetY, Mode=TwoWay}" Minimum="-1000000000" Maximum="1000000000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="移动优先方向">
                            <ComboBox Width="240" SelectedValuePath="Tag" SelectedValue="{Binding XFirst, Mode=TwoWay}">
                                <ComboBoxItem Content="X 优先"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                <ComboBoxItem Content="Y 优先"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                            </ComboBox>
                        </controls:LabeledControl>
                        <controls:LabeledControl Label="换向移动次数"><controls:NumericUpDown Width="240" IntValue="{Binding ReverseAfter, Mode=TwoWay}" Minimum="1" Maximum="1000" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="基准角度"><controls:NumericUpDown Width="240" Value="{Binding BaseAngle, Mode=TwoWay}" Minimum="-36000" Maximum="36000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="角度偏移"><controls:NumericUpDown Width="240" Value="{Binding AngleStep, Mode=TwoWay}" Minimum="-36000" Maximum="36000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl>
                        <controls:LabeledControl Label="使用相对坐标"><controls:ToggleSwitch IsChecked="{Binding UseRelativeCoordinates, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/></controls:LabeledControl>
                        <controls:LabeledControl Label="标定原点点号"><controls:NumericUpDown Width="240" IntValue="{Binding OriginIndex, Mode=TwoWay}" Minimum="0" Maximum="1000" ShowSlider="False"/></controls:LabeledControl>
                        <TextBlock Text="标定文件" FontWeight="Bold" Margin="0,16,0,8"/>
                        <controls:LabeledControl Label="求解后更新文件"><controls:ToggleSwitch IsChecked="{Binding UpdateFileAfterSolve, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/></controls:LabeledControl>
                        <controls:LabeledControl Label="标定文件路径">
                            <StackPanel Orientation="Horizontal"><TextBox Width="194" Text="{Binding CalibrationFilePath, Mode=TwoWay}"/>
                                <Button Content="…" Width="38" Margin="8,0,0,0" Click="ChooseFile_Click"/></StackPanel>
                        </controls:LabeledControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="运行参数">
                <ScrollViewer Padding="12"><StackPanel>
                    <TextBlock Text="运行参数" FontWeight="Bold" Margin="0,4,0,10"/>
                    <controls:LabeledControl Label="相机模式">
                        <ComboBox Width="240" SelectedValuePath="Tag" SelectedValue="{Binding CameraMode, Mode=TwoWay}">
                            <ComboBoxItem Content="相机静止上相机位" Tag="{x:Static local:NPointCameraMode.FixedAbove}"/>
                            <ComboBoxItem Content="相机静止下相机位（待实现）" Tag="{x:Static local:NPointCameraMode.FixedBelow}"/>
                            <ComboBoxItem Content="相机运动（待实现）" Tag="{x:Static local:NPointCameraMode.Moving}"/>
                        </ComboBox>
                    </controls:LabeledControl>
                    <controls:LabeledControl Label="自由度">
                        <ComboBox Width="240" SelectedValuePath="Tag" SelectedValue="{Binding TransformModel, Mode=TwoWay}">
                            <ComboBoxItem Content="相似性" Tag="{x:Static local:NPointTransformModel.Similarity}"/>
                            <ComboBoxItem Content="仿射" Tag="{x:Static local:NPointTransformModel.Affine}"/>
                            <ComboBoxItem Content="透视" Tag="{x:Static local:NPointTransformModel.Projective}"/>
                        </ComboBox>
                    </controls:LabeledControl>
                    <controls:LabeledControl Label="权重函数">
                        <ComboBox Width="240" SelectedValuePath="Tag" SelectedValue="{Binding WeightFunction, Mode=TwoWay}">
                            <ComboBoxItem Content="最小二乘" Tag="{x:Static local:NPointWeightFunction.LeastSquares}"/>
                            <ComboBoxItem Content="Huber（待实现）" Tag="{x:Static local:NPointWeightFunction.Huber}"/>
                            <ComboBoxItem Content="Tukey（待实现）" Tag="{x:Static local:NPointWeightFunction.Tukey}"/>
                        </ComboBox>
                    </controls:LabeledControl>
                    <controls:LabeledControl Label="权重系数"><controls:NumericUpDown Width="240" Value="{Binding WeightCoefficient, Mode=TwoWay}" Minimum="0" Maximum="1000000" DecimalPlaces="2" ShowSlider="False"/></controls:LabeledControl>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="结果显示">
                <ScrollViewer Padding="12"><StackPanel>
                    <TextBlock Text="采集与求解结果" FontWeight="Bold" Margin="0,4,0,10"/>
                    <TextBlock Text="{Binding ResultText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/>
                    <TextBlock Text="仅求解成功不代表已完成独立验证；发布为生产标定结果需另行确认。" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</controls:ToolDebugControlBase>
