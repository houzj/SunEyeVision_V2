<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.NPointCalibration.Views.NPointCalibrationDebugControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
 xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
 xmlns:geometry="clr-namespace:SunEyeVision.Plugin.SDK.Models.Geometry;assembly=SunEyeVision.Plugin.SDK"
 xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:SunEyeVision.Tool.NPointCalibration"
 xmlns:views="clr-namespace:SunEyeVision.Tool.NPointCalibration.Views"
 xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Converters;assembly=SunEyeVision.Plugin.SDK"
 DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}"
 Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
 Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}">
 <controls:ToolDebugControlBase.Resources><ResourceDictionary>
 <ResourceDictionary.MergedDictionaries><themes:DesignTimeThemeResourceDictionary/></ResourceDictionary.MergedDictionaries>
 <converters:EnumToVisibilityConverter x:Key="EnumVisibility"/><converters:EnumToBoolConverter x:Key="EnumToBool"/>
 <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
 </ResourceDictionary></controls:ToolDebugControlBase.Resources>
<DockPanel>
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
<Button Content="清空标定点" Click="ClearSamples_Click" Margin="2" Padding="6,4"/>
<Button Content="记录本次" Click="RecordCurrent_Click" Margin="2" Padding="6,4" Visibility="{Binding AcquisitionMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Trigger}"/>
<Button Content="执行标定" Click="Solve_Click" Margin="2" Padding="6,4"/>
<Button Content="生成候选文件" Click="SaveCalibration_Click" Margin="2" Padding="6,4"/>
</StackPanel>
<TabControl x:Name="ParameterTabs">
<TabItem Header="基本参数"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"><StackPanel><controls:LabeledControl LabelWidth="170" Label="标定点获取"><ComboBox Width="300" SelectedValuePath="Tag" SelectedValue="{Binding AcquisitionMode, Mode=TwoWay}"><ComboBoxItem Content="触发获取" Tag="{x:Static local:NPointAcquisitionMode.Trigger}"/><ComboBoxItem Content="手动输入" Tag="{x:Static local:NPointAcquisitionMode.Manual}"/></ComboBox></controls:LabeledControl>
<StackPanel x:Name="TriggerInputsPanel" Visibility="{Binding AcquisitionMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Trigger}"><controls:LabeledControl LabelWidth="170" Label="输入方式"><StackPanel Orientation="Horizontal" Width="300"><RadioButton Content="按点" GroupName="InputMode" Margin="0,0,22,0" IsChecked="{Binding InputMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Point}"/><RadioButton Content="按坐标" GroupName="InputMode" IsChecked="{Binding InputMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Coordinates}"/></StackPanel></controls:LabeledControl>
<StackPanel Visibility="{Binding InputMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Point}"><controls:LabeledControl LabelWidth="170" Label="图像点"><controls:ParamBinding ParameterName="ImagePoint" DataType="{x:Type geometry:Point2d}" BindingSource="{Binding ImagePointBindingSource, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="机构轴心 XY"><controls:ParamBinding ParameterName="AxisPoint" DataType="{x:Type geometry:Point2d}" BindingSource="{Binding AxisPointBindingSource, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl></StackPanel>
<StackPanel Visibility="{Binding InputMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Coordinates}"><controls:LabeledControl LabelWidth="170" Label="图像 X"><controls:ConfigSetting ParameterName="ImageX" DataType="{x:Type sys:Double}" Value="{Binding ImageX, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="图像 Y"><controls:ConfigSetting ParameterName="ImageY" DataType="{x:Type sys:Double}" Value="{Binding ImageY, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="轴心 X (mm)"><controls:ConfigSetting ParameterName="AxisX" DataType="{x:Type sys:Double}" Value="{Binding AxisX, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="轴心 Y (mm)"><controls:ConfigSetting ParameterName="AxisY" DataType="{x:Type sys:Double}" Value="{Binding AxisY, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl></StackPanel>
<controls:LabeledControl LabelWidth="170" Label="编码器 R (°)"><controls:ConfigSetting ParameterName="AxisAngle" DataType="{x:Type sys:Double}" Value="{Binding AxisAngle, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl></StackPanel>
<controls:LabeledControl LabelWidth="170" Label="平移点数"><controls:NumericUpDown Width="300" IntValue="{Binding TranslationCount, Mode=TwoWay}" Minimum="9" Maximum="100" ShowSlider="False"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="旋转点数"><controls:NumericUpDown Width="300" IntValue="{Binding RotationCount, Mode=TwoWay}" Minimum="3" Maximum="100" ShowSlider="False"/></controls:LabeledControl>
<Button Content="编辑标定点..." Click="EditSamples_Click" HorizontalAlignment="Left" Margin="0,8"/>
<controls:LabeledControl LabelWidth="170" Label="当前阶段"><TextBlock Width="300" Text="{Binding StageText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="采样进度"><TextBlock Width="300" Text="{Binding ProgressText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/></controls:LabeledControl>
<StackPanel Visibility="{Binding AcquisitionMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Trigger}">
<controls:LabeledControl LabelWidth="170" Label="示教"><controls:ToggleSwitch IsChecked="{Binding TeachEnabled, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/></controls:LabeledControl>
<StackPanel x:Name="TeachFieldsPanel" Visibility="{Binding TeachEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
<controls:LabeledControl LabelWidth="170" Label="输入字符"><controls:ConfigSetting ParameterName="ExternalInputText" DataType="{x:Type sys:String}" Value="{Binding ExternalInputText, Mode=TwoWay}" Width="300" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="触发字符"><TextBox Width="300" Text="{Binding TeachTriggerText, Mode=TwoWay}"/></controls:LabeledControl>
</StackPanel></StackPanel>
<TextBlock Text="标定文件" FontWeight="Bold" Margin="0,16,0,8"/>
<controls:LabeledControl LabelWidth="170" Label="自动更新候选"><controls:ToggleSwitch IsChecked="{Binding UpdateFileAfterSolve, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="正式文件路径"><DockPanel Width="300"><Button DockPanel.Dock="Right" Content="..." Width="36" Margin="6,0,0,0" Click="ChooseFile_Click"/><TextBox Text="{Binding CalibrationFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></controls:LabeledControl>
<controls:LabeledControl LabelWidth="170" Label="候选文件"><TextBlock Width="300" Text="{Binding CandidatePathText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="文件状态"><TextBlock Width="300" Text="{Binding CandidateStatusText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/></controls:LabeledControl>
<Expander Header="本轮采样信息" Margin="0,12"><TextBlock Text="{Binding SourceInfoText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/></Expander></StackPanel></ScrollViewer></TabItem>
<TabItem Header="运行参数"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"><StackPanel><controls:LabeledControl LabelWidth="170" Label="算法"><TextBlock Width="300" Text="HALCON 原生算子" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="相机模式"><TextBlock Width="300" Text="固定上相机位" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="映射模型"><TextBlock Width="300" Text="平面仿射" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="求解流程"><TextBlock Width="300" Text="平移映射 → R角偏心 → 最终映射" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="参考 R角 (°)"><controls:NumericUpDown Width="300" Value="{Binding ReferenceRAngle, Mode=TwoWay}" Minimum="-36000" Maximum="36000" DecimalPlaces="3" ShowSlider="False"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="R 正方向"><ComboBox Width="300" SelectedValuePath="Tag" SelectedValue="{Binding RotationSign, Mode=TwoWay}"><ComboBoxItem Content="正向"><ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="反向"><ComboBoxItem.Tag><sys:Int32>-1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem></ComboBox></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="最大允许误差 (mm)"><controls:NumericUpDown Width="300" Value="{Binding MaximumTrainingErrorMm, Mode=TwoWay}" Minimum="0" Maximum="1000000" DecimalPlaces="4" ShowSlider="False"/></controls:LabeledControl><Expander Header="采样质量设置" Margin="0,12"><StackPanel><controls:LabeledControl LabelWidth="170" Label="平移 R角容差 (°)"><controls:NumericUpDown Width="300" Value="{Binding TranslationAngleToleranceDeg, Mode=TwoWay}" Minimum="0" Maximum="1000000" DecimalPlaces="4" ShowSlider="False"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="轴心移动容差 (mm)"><controls:NumericUpDown Width="300" Value="{Binding RotationAxisToleranceMm, Mode=TwoWay}" Minimum="0" Maximum="1000000" DecimalPlaces="4" ShowSlider="False"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="最小旋转覆盖 (°)"><controls:NumericUpDown Width="300" Value="{Binding MinimumRotationSpanDeg, Mode=TwoWay}" Minimum="0" Maximum="180" DecimalPlaces="4" ShowSlider="False"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="复拍容差 (mm)"><controls:NumericUpDown Width="300" Value="{Binding RepeatToleranceMm, Mode=TwoWay}" Minimum="0" Maximum="1000000" DecimalPlaces="4" ShowSlider="False"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="参考平移点号"><controls:NumericUpDown Width="300" IntValue="{Binding ReferencePointNumber, Mode=TwoWay}" Minimum="1" Maximum="100" ShowSlider="False"/></controls:LabeledControl></StackPanel></Expander>
<Expander Header="图像与机构配对设置"><StackPanel><controls:LabeledControl LabelWidth="170" Label="最大时间差 (ms)"><controls:NumericUpDown Width="300" IntValue="{Binding MaxPairingDelayMs, Mode=TwoWay}" Minimum="1" Maximum="10000" ShowSlider="False"/></controls:LabeledControl><TextBlock Text="触发采样需上游同一步到位、新帧和XYR证据；缺失时拒绝，不使用手填时间。" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
<TabItem Header="结果显示"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"><StackPanel><TextBlock Width="300" Text="{Binding ResultText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/>
<StackPanel DataContext="{Binding LatestResult, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}">
<TextBlock Text="平移标定" FontWeight="Bold" Margin="0,14,0,8"/>
<controls:LabeledControl LabelWidth="170" Label="有效点数"><TextBlock Width="300" Text="{Binding TranslationSamples}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="平移 RMS (mm)"><TextBlock Width="300" Text="{Binding TranslationRmsError, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl>
<TextBlock Text="旋转标定" FontWeight="Bold" Margin="0,14,0,8"/>
<controls:LabeledControl LabelWidth="170" Label="有效点数"><TextBlock Width="300" Text="{Binding RotationSamples}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="旋转覆盖 (°)"><TextBlock Width="300" Text="{Binding RotationSpanDeg, StringFormat=F3}" TextWrapping="Wrap"/></controls:LabeledControl>
<controls:LabeledControl LabelWidth="170" Label="Mark 偏心 X (mm)"><TextBlock Width="300" Text="{Binding AxisToMarkX, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="Mark 偏心 Y (mm)"><TextBlock Width="300" Text="{Binding AxisToMarkY, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl>
<controls:LabeledControl LabelWidth="170" Label="旋转 RMS (mm)"><TextBlock Width="300" Text="{Binding RotationRmsError, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="复拍误差 (mm)"><TextBlock Width="300" Text="{Binding RepeatErrorMm, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl>
<TextBlock Text="最终标定" FontWeight="Bold" Margin="0,14,0,8"/>
<controls:LabeledControl LabelWidth="170" Label="整体 RMS (mm)"><TextBlock Width="300" Text="{Binding RmsError, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl><controls:LabeledControl LabelWidth="170" Label="最大误差 (mm)"><TextBlock Width="300" Text="{Binding MaxError, StringFormat=F6}" TextWrapping="Wrap"/></controls:LabeledControl>
</StackPanel>
<Button Content="查看逐点误差..." Click="ShowResiduals_Click" HorizontalAlignment="Left" Margin="0,8"/>
<Expander Header="最终变换矩阵" Margin="0,8"><TextBlock Text="{Binding MatrixText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointCalibrationDebugControl}}}" TextWrapping="Wrap"/></Expander>
<Expander Header="算法诊断"><TextBlock Text="HALCON 原生最小二乘；辅助映射非生产矩阵。Mark偏心不等于TCP偏置。偏心接近零时，仅靠该Mark不能验证R方向，需现场独立方向检查。" TextWrapping="Wrap"/></Expander>
<TextBlock Text="候选文件不能直接用于生产，请在独立验证节点验证并发布。" TextWrapping="Wrap" Margin="0,12"/></StackPanel></ScrollViewer></TabItem>
</TabControl></DockPanel></controls:ToolDebugControlBase>
