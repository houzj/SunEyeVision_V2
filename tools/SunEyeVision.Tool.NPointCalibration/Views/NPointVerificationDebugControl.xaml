<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.NPointCalibration.Views.NPointVerificationDebugControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
    xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:SunEyeVision.Tool.NPointCalibration"
    xmlns:views="clr-namespace:SunEyeVision.Tool.NPointCalibration.Views"
    xmlns:commands="clr-namespace:SunEyeVision.Plugin.SDK.Commands;assembly=SunEyeVision.Plugin.SDK"
    DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}"
    Background="{DynamicResource {x:Static themes:SdkThemeKeys.PanelBackgroundBrush}}"
    Foreground="{DynamicResource {x:Static themes:SdkThemeKeys.TextPrimaryBrush}}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="清空验证点" Click="ClearSamples_Click" Margin="2" Padding="8,4"/>
            <Button Content="执行" Command="{x:Static commands:ToolCommands.Execute}" Margin="2" Padding="12,4"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
                <TextBlock Text="候选文件与发布" FontWeight="Bold" Margin="0,4,0,10"/>
                <controls:LabeledControl Label="候选文件路径"><TextBox Width="300" Text="{Binding CandidateFilePath, Mode=TwoWay}"/></controls:LabeledControl>
                <controls:LabeledControl Label="活动文件路径"><TextBox Width="300" Text="{Binding ActiveFilePath, Mode=TwoWay}"/></controls:LabeledControl>
                <controls:LabeledControl Label="最大验证误差 (mm)"><controls:NumericUpDown Width="240" Value="{Binding MaximumValidationErrorMm, Mode=TwoWay}" Minimum="0" Maximum="1000000" DecimalPlaces="4" ShowSlider="False"/></controls:LabeledControl>
                <controls:LabeledControl Label="通过后发布"><controls:ToggleSwitch IsChecked="{Binding PublishOnPass, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/></controls:LabeledControl>
                <TextBlock Text="同一图像环境" FontWeight="Bold" Margin="0,16,0,8"/>
                <controls:LabeledControl Label="相机设备 ID"><controls:ConfigSetting ParameterName="SourceDeviceId" DataType="{x:Type sys:String}" Value="{Binding SourceDeviceId, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="图像宽度"><controls:ConfigSetting ParameterName="ImageWidth" DataType="{x:Type sys:Int32}" Value="{Binding ImageWidth, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="图像高度"><controls:ConfigSetting ParameterName="ImageHeight" DataType="{x:Type sys:Int32}" Value="{Binding ImageHeight, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="图像域"><TextBox Width="240" Text="{Binding ImageDomain, Mode=TwoWay}"/></controls:LabeledControl>
                <TextBlock Text="本轮独立采样" FontWeight="Bold" Margin="0,16,0,8"/>
                <controls:LabeledControl Label="记录本轮"><controls:ToggleSwitch IsChecked="{Binding CaptureSample, Mode=TwoWay}" SwitchWidth="48" SwitchHeight="24"/></controls:LabeledControl>
                <controls:LabeledControl Label="采样事件序号"><controls:ConfigSetting ParameterName="SampleEventId" DataType="{x:Type sys:Int64}" Value="{Binding SampleEventId, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="类别">
                    <ComboBox Width="240" SelectedValuePath="Tag" SelectedValue="{Binding SampleKind, Mode=TwoWay}">
                        <ComboBoxItem Content="平移" Tag="{x:Static local:NPointSampleKind.Translation}"/>
                        <ComboBoxItem Content="旋转" Tag="{x:Static local:NPointSampleKind.Rotation}"/>
                    </ComboBox>
                </controls:LabeledControl>
                <controls:LabeledControl Label="图像 X"><controls:ConfigSetting ParameterName="ImageX" DataType="{x:Type sys:Double}" Value="{Binding ImageX, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="图像 Y"><controls:ConfigSetting ParameterName="ImageY" DataType="{x:Type sys:Double}" Value="{Binding ImageY, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="轴心 X"><controls:ConfigSetting ParameterName="AxisX" DataType="{x:Type sys:Double}" Value="{Binding AxisX, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="轴心 Y"><controls:ConfigSetting ParameterName="AxisY" DataType="{x:Type sys:Double}" Value="{Binding AxisY, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="编码器 R 角"><controls:ConfigSetting ParameterName="AxisAngle" DataType="{x:Type sys:Double}" Value="{Binding AxisAngle, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="图像帧号"><controls:ConfigSetting ParameterName="FrameId" DataType="{x:Type sys:Int64}" Value="{Binding FrameId, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="帧时间 ISO 8601"><controls:ConfigSetting ParameterName="FrameTimestampText" DataType="{x:Type sys:String}" Value="{Binding FrameTimestampText, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <controls:LabeledControl Label="XYR 回读 Unix ms"><controls:ConfigSetting ParameterName="AxisReadUnixMs" DataType="{x:Type sys:Int64}" Value="{Binding AxisReadUnixMs, Mode=TwoWay}" Width="240" AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/></controls:LabeledControl>
                <TextBlock Text="结果" FontWeight="Bold" Margin="0,16,0,8"/>
                <TextBlock Text="{Binding ResultText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:NPointVerificationDebugControl}}}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</controls:ToolDebugControlBase>
