<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SunEyeVision.Tool.PointLineMeasure</RootNamespace>
    <AssemblyName>SunEyeVision.Tool.PointLineMeasure</AssemblyName>
    <IsToolPlugin>true</IsToolPlugin>
  </PropertyGroup>

  <ItemGroup>
    <!-- 契约与业务依赖**随工具复制**（自带行李，方案 §六 ①）: 独立开发 / XAML 设计器可解析 / 交付即用。
         大件平台(halcondotnetxl / OpenCV) 由 Directory.Build.targets 的 Step 1 剔除，宿主统一提供。 -->
    <ProjectReference Include="..\..\src\Plugin.SDK\SunEyeVision.Plugin.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 大件平台：仅用于编译，不复制（宿主提供） -->
    <Reference Include="halcondotnetxl">
      <HintPath>..\..\libs\halcon\net\halcondotnetxl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Hal 实现（HalImage/GetHalconImage/HOperatorSet 扩展），首期统一引 HalAdapter 做 metrology measure -->
    <ProjectReference Include="..\..\src\SunEyeVision.HalAdapter\SunEyeVision.HalAdapter.csproj" />
  </ItemGroup>

</Project>
