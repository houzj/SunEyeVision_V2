<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.ProtocolParse.Views.ProtocolParseEditor"
 xmlns:comm="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Communication;assembly=SunEyeVision.Plugin.SDK"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
 xmlns:themes="clr-namespace:SunEyeVision.Plugin.SDK.UI.Themes;assembly=SunEyeVision.Plugin.SDK"
 Background="{DynamicResource ThemePanelBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
 <controls:ToolDebugControlBase.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <themes:DesignTimeThemeResourceDictionary/>
  <ResourceDictionary Source="/SunEyeVision.Plugin.SDK;component/UI/Controls/Communication/ProtocolEditorResources.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Style x:Key="OrderSelector" TargetType="ComboBox" BasedOn="{StaticResource ProtocolComboBox}">
  <Style.Triggers>
   <DataTrigger Binding="{Binding DataType}" Value="string"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
   <DataTrigger Binding="{Binding DataContext.AsciiData, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
  </Style.Triggers>
 </Style>
 </ResourceDictionary></controls:ToolDebugControlBase.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
  <TextBlock Text="解析方式" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="方式选择" VerticalAlignment="Center"/>
  <ComboBox Grid.Column="1" x:Name="ModeOptions" Style="{StaticResource ProtocolComboBox}" Width="150" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Mode, Mode=TwoWay}">
   <ComboBoxItem Content="文本解析" Tag="Text"/><ComboBoxItem Content="字节解析" Tag="Bytes"/>
  </ComboBox></Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="解析内容" VerticalAlignment="Center"/>
  <controls:ParamBinding Grid.Column="1" Style="{StaticResource ProtocolBindingInputStyle}" AllowedDataTypes="{x:Static comm:CommunicationBindingTypes.Parse}" BindingSource="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SyncEditingToSource="True"
   AvailableDataSources="{Binding RelativeSource={RelativeSource AncestorType=controls:ToolDebugControlBase}, Path=AvailableDataSources}"/>
  </Grid>
  <Grid x:Name="TextSettings" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="分隔符" VerticalAlignment="Center"/>
   <WrapPanel Grid.Column="1">
   <ComboBox x:Name="DelimiterOptions" Style="{StaticResource ProtocolComboBox}" Width="150" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectionChanged="DelimiterChanged"/>
   <Button Content="自定义" Click="CustomSeparator_Click" Margin="8,0"/>
   <TextBox x:Name="CustomSeparator" Visibility="Collapsed" Width="120" Height="30" VerticalContentAlignment="Center" Text="{Binding Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
  </WrapPanel></Grid>
  <StackPanel x:Name="ByteSettings" Visibility="Collapsed" Margin="0,10,0,0">
   <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="ASCII数据" VerticalAlignment="Center" ToolTip="按ASCII字符解释字段；二进制数值解析时关闭。"/>
    <CheckBox Grid.Column="1" IsChecked="{Binding AsciiData, Mode=TwoWay}" VerticalAlignment="Center"/>
   </Grid>
   <Expander x:Name="AdvancedSettings" Margin="0,10,0,0">
    <Expander.Header><TextBlock Text="高级设置" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/></Expander.Header>
    <StackPanel Margin="0,10,0,0">
     <Grid x:Name="InputFormatRow" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="输入格式" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" Style="{StaticResource ProtocolComboBox}" Width="150" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding InputFormat, Mode=TwoWay}">
       <ComboBoxItem Content="HEX文本" Tag="Hex"/><ComboBoxItem Content="字符文本" Tag="Text"/>
      </ComboBox>
     </Grid>
     <Grid x:Name="EncodingRow" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="字符编码" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" Style="{StaticResource ProtocolComboBox}" Width="150" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding StringEncoding, Mode=TwoWay}">
       <ComboBoxItem Content="UTF-8" Tag="UTF8"/><ComboBoxItem Content="ASCII" Tag="ASCII"/>
      </ComboBox>
     </Grid>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="当前字段" VerticalAlignment="Center"/>
      <ComboBox x:Name="SelectedFieldOptions" Grid.Column="1" Style="{StaticResource ProtocolComboBox}" Width="150" HorizontalAlignment="Left"
       ItemsSource="{Binding Outputs}" DisplayMemberPath="Name" SelectionChanged="SelectedFieldChanged"/>
     </Grid>
     <Grid x:Name="NumericRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="数值解释" VerticalAlignment="Center" ToolTip="统一规则：1～3字节非负，4字节有符号；输出必须在int32范围。"/>
      <ComboBox Grid.Column="1" Style="{StaticResource ProtocolComboBox}" Width="150" HorizontalAlignment="Left" SelectedValuePath="Tag"
       SelectedValue="{Binding SelectedItem.NumericInterpretation, ElementName=SelectedFieldOptions, Mode=TwoWay}">
       <ComboBoxItem Content="按统一规则" Tag="Auto"/><ComboBoxItem Content="有符号" Tag="Signed"/><ComboBoxItem Content="无符号" Tag="Unsigned"/>
      </ComboBox>
     </Grid>
    </StackPanel>
   </Expander>
  </StackPanel>
  <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,16,0,16"/>
  <TextBlock Text="输出列表" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"
   ToolTip="按配置字段输出；执行值在模块结果查看，详细片段在主界面数据分析查看。"/>
  </StackPanel>
  <Grid Grid.Row="1" x:Name="OutputsListViewport"><StackPanel>
  <DataGrid x:Name="OutputsGrid" ItemsSource="{Binding Outputs}" AutoGenerateColumns="False" SelectionChanged="GridSelectionChanged"
   MaxHeight="{Binding ActualHeight, ElementName=OutputsListViewport, Converter={StaticResource ListViewport}}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="序号" Width="38" MinWidth="38"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <TextBlock Style="{StaticResource ProtocolFieldText}" Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(comm:ProtocolRowPosition.Index), Converter={StaticResource CommunicationOrdinal}}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="80" ElementStyle="{StaticResource ProtocolFieldText}" EditingElementStyle="{StaticResource ProtocolFieldEdit}"/>
    <DataGridComboBoxColumn x:Name="TypeColumn" Header="类型" SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="86" MinWidth="86" ElementStyle="{StaticResource ProtocolComboBox}" EditingElementStyle="{StaticResource ProtocolComboBox}"/>
    <DataGridTextColumn x:Name="StartColumn" Header="起始" Binding="{Binding Start}" Width="44" MinWidth="44" ElementStyle="{StaticResource ProtocolFieldText}" EditingElementStyle="{StaticResource ProtocolFieldEdit}"/>
    <DataGridTextColumn x:Name="EndColumn" Header="结束" Binding="{Binding End}" Width="44" MinWidth="44" ElementStyle="{StaticResource ProtocolFieldText}" EditingElementStyle="{StaticResource ProtocolFieldEdit}"/>
    <DataGridComboBoxColumn x:Name="OrderColumn" Header="顺序" SelectedItemBinding="{Binding Order}" Width="86" MinWidth="86" ElementStyle="{StaticResource OrderSelector}" EditingElementStyle="{StaticResource OrderSelector}"/>
    <DataGridTemplateColumn Header="操作" Width="102" MinWidth="102"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="↑" Style="{StaticResource ProtocolRowAction}" Click="MoveUp_Click" ToolTip="上移" AutomationProperties.Name="上移字段">
       <Button.IsEnabled><MultiBinding Converter="{StaticResource CanMove}" ConverterParameter="-1">
        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="(comm:ProtocolRowPosition.Index)"/>
        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.Outputs.Count"/>
       </MultiBinding></Button.IsEnabled>
      </Button>
      <Button Content="↓" Style="{StaticResource ProtocolRowAction}" Click="MoveDown_Click" ToolTip="下移" AutomationProperties.Name="下移字段">
       <Button.IsEnabled><MultiBinding Converter="{StaticResource CanMove}" ConverterParameter="1">
        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="(comm:ProtocolRowPosition.Index)"/>
        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.Outputs.Count"/>
       </MultiBinding></Button.IsEnabled>
      </Button>
      <Button Content="×" Style="{StaticResource ProtocolDeleteAction}" Click="DeleteField_Click" ToolTip="删除" AutomationProperties.Name="删除字段"/>
     </StackPanel>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <Button x:Name="AddFieldButton" Content="＋" Click="AddField_Click" HorizontalAlignment="Left" Margin="8,4,0,0" Width="28" Height="28" ToolTip="添加字段"/>
  </StackPanel></Grid>
 </Grid>
</controls:ToolDebugControlBase>
