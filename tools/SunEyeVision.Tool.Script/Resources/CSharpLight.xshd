<?xml version="1.0"?>
<SyntaxDefinition name="C#" extensions=".cs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Default" foreground="#000000" />
  <Color name="PlainText" foreground="#000000" />
  <Color name="Comment" foreground="#008000" />
  <Color name="CommentLine" foreground="#008000" />
  <Color name="String" foreground="#A31515" />
  <Color name="VerbatimString" foreground="#A31515" />
  <Color name="Char" foreground="#A31515" />
  <Color name="Keyword" foreground="#0000FF" fontWeight="bold" />
  <Color name="Type" foreground="#2B91AF" />
  <Color name="Method" foreground="#74569F" />
  <Color name="Number" foreground="#098658" />
  <Color name="Preprocessor" foreground="#888888" />


  <!-- Main rule set -->
  <RuleSet>

    <!-- Multi-line comment /* ... */ -->
    <Span color="Comment" ruleSet="CommentContent" multiline="true">
      <Begin>/\*</Begin>
      <End>\*/</End>
    </Span>

    <!-- XML Doc comment /// (必须在 // 之前) -->
    <Span color="CommentLine">
      <Begin>///(?!/)</Begin>
      <!-- 无 End，自动行尾；(?!/) 防止 //// 误匹配 -->
    </Span>

    <!-- Single-line comment // ... -->
    <Span color="CommentLine">
      <Begin>//</Begin>
      <!-- 无 End，自动行尾 -->
    </Span>

    <!-- Verbatim string @"..." -->
    <Span color="VerbatimString" multiline="true">
      <Begin>@"</Begin>
      <End>"</End>
      <RuleSet>
        <Rule color="VerbatimString">
          ""
        </Rule>
      </RuleSet>
    </Span>

    <!-- Regular string "..." -->
    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span color="String">
          <Begin>\\</Begin>
          <End>.</End>
        </Span>
      </RuleSet>
    </Span>

    <!-- Char literal '...' -->
    <Span color="Char">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span color="Char">
          <Begin>\\</Begin>
          <End>.</End>
        </Span>
      </RuleSet>
    </Span>

    <!-- Preprocessor directives (# followed by directive name, rest of line colored) -->
    <Rule color="Preprocessor">
      \#(if|else|elif|endif|define|undef|region|endregion|error|warning|line|pragma|nullable)\b[^\r\n]*
    </Rule>

    <!-- C# keywords -->
    <Keywords color="Keyword">
      <Word>abstract</Word>
      <Word>as</Word>
      <Word>base</Word>
      <Word>bool</Word>
      <Word>break</Word>
      <Word>byte</Word>
      <Word>case</Word>
      <Word>catch</Word>
      <Word>char</Word>
      <Word>checked</Word>
      <Word>class</Word>
      <Word>const</Word>
      <Word>continue</Word>
      <Word>decimal</Word>
      <Word>default</Word>
      <Word>delegate</Word>
      <Word>do</Word>
      <Word>double</Word>
      <Word>else</Word>
      <Word>enum</Word>
      <Word>event</Word>
      <Word>explicit</Word>
      <Word>extern</Word>
      <Word>false</Word>
      <Word>finally</Word>
      <Word>fixed</Word>
      <Word>float</Word>
      <Word>for</Word>
      <Word>foreach</Word>
      <Word>goto</Word>
      <Word>if</Word>
      <Word>implicit</Word>
      <Word>in</Word>
      <Word>int</Word>
      <Word>interface</Word>
      <Word>internal</Word>
      <Word>is</Word>
      <Word>lock</Word>
      <Word>long</Word>
      <Word>namespace</Word>
      <Word>new</Word>
      <Word>null</Word>
      <Word>object</Word>
      <Word>operator</Word>
      <Word>out</Word>
      <Word>override</Word>
      <Word>params</Word>
      <Word>private</Word>
      <Word>protected</Word>
      <Word>public</Word>
      <Word>readonly</Word>
      <Word>ref</Word>
      <Word>return</Word>
      <Word>sbyte</Word>
      <Word>sealed</Word>
      <Word>short</Word>
      <Word>sizeof</Word>
      <Word>stackalloc</Word>
      <Word>static</Word>
      <Word>string</Word>
      <Word>struct</Word>
      <Word>switch</Word>
      <Word>this</Word>
      <Word>throw</Word>
      <Word>true</Word>
      <Word>try</Word>
      <Word>typeof</Word>
      <Word>uint</Word>
      <Word>ulong</Word>
      <Word>unchecked</Word>
      <Word>unsafe</Word>
      <Word>ushort</Word>
      <Word>using</Word>
      <Word>var</Word>
      <Word>virtual</Word>
      <Word>void</Word>
      <Word>volatile</Word>
      <Word>while</Word>
    </Keywords>

    <!-- Contextual keywords -->
    <Keywords color="Keyword">
      <Word>async</Word>
      <Word>await</Word>
      <Word>from</Word>
      <Word>let</Word>
      <Word>orderby</Word>
      <Word>select</Word>
      <Word>where</Word>
      <Word>group</Word>
      <Word>by</Word>
      <Word>into</Word>
      <Word>join</Word>
      <Word>on</Word>
      <Word>equals</Word>
      <Word>descending</Word>
      <Word>ascending</Word>
      <Word>yield</Word>
      <Word>nameof</Word>
      <Word>notnull</Word>
      <Word>record</Word>
      <Word>init</Word>
      <Word>required</Word>
      <Word>global</Word>
      <Word>file</Word>
      <Word>partial</Word>
      <Word>when</Word>
    </Keywords>

    <!-- BCL 常用类型名（脚本场景高频类型，Layer 1 即时高亮，Layer 2a 语义补充） -->
    <Keywords color="Type">
      <Word>DateTime</Word>
      <Word>TimeSpan</Word>
      <Word>DateTimeOffset</Word>
      <Word>Guid</Word>
      <Word>Math</Word>
      <Word>Convert</Word>
      <Word>Environment</Word>
      <Word>Console</Word>
      <Word>Random</Word>
      <Word>Stopwatch</Word>
      <Word>Version</Word>
      <Word>Uri</Word>
      <Word>StringBuilder</Word>
      <Word>StringComparison</Word>
      <Word>StringSplitOptions</Word>
      <Word>Type</Word>
      <Word>Array</Word>
      <Word>Enum</Word>
      <Word>Delegate</Word>
      <Word>Action</Word>
      <Word>Func</Word>
      <Word>Predicate</Word>
      <Word>Tuple</Word>
      <Word>ValueTuple</Word>
      <Word>Nullable</Word>
      <Word>Lazy</Word>
      <Word>Exception</Word>
      <Word>InvalidOperationException</Word>
      <Word>ArgumentException</Word>
      <Word>ArgumentNullException</Word>
      <Word>NotImplementedException</Word>
      <Word>NotSupportedException</Word>
      <Word>KeyNotFoundException</Word>
      <Word>List</Word>
      <Word>Dictionary</Word>
      <Word>HashSet</Word>
      <Word>SortedList</Word>
      <Word>SortedDictionary</Word>
      <Word>SortedSet</Word>
      <Word>Queue</Word>
      <Word>Stack</Word>
      <Word>LinkedList</Word>
      <Word>KeyValuePair</Word>
      <Word>IReadOnlyList</Word>
      <Word>IReadOnlyDictionary</Word>
      <Word>IReadOnlyCollection</Word>
      <Word>IEnumerable</Word>
      <Word>IEnumerator</Word>
      <Word>ICollection</Word>
      <Word>IDictionary</Word>
      <Word>IList</Word>
      <Word>ISet</Word>
      <Word>Task</Word>
      <Word>TaskCompletionSource</Word>
      <Word>CancellationToken</Word>
      <Word>SemaphoreSlim</Word>
      <Word>ManualResetEvent</Word>
      <Word>AutoResetEvent</Word>
      <Word>Stream</Word>
      <Word>FileStream</Word>
      <Word>MemoryStream</Word>
      <Word>StreamReader</Word>
      <Word>StreamWriter</Word>
      <Word>StringReader</Word>
      <Word>StringWriter</Word>
      <Word>BinaryReader</Word>
      <Word>BinaryWriter</Word>
      <Word>Directory</Word>
      <Word>File</Word>
      <Word>Path</Word>
      <Word>DirectoryInfo</Word>
      <Word>FileInfo</Word>
      <Word>DriveInfo</Word>
      <Word>Encoding</Word>
      <Word>Regex</Word>
      <Word>Match</Word>
      <Word>Group</Word>
      <Word>Capture</Word>
      <Word>XDocument</Word>
      <Word>XElement</Word>
      <Word>XAttribute</Word>
      <Word>JObject</Word>
      <Word>JArray</Word>
      <Word>JToken</Word>
      <Word>WebClient</Word>
      <Word>HttpClient</Word>
      <Word>IPAddress</Word>
      <Word>IPEndPoint</Word>
      <Word>Dns</Word>
      <Word>Socket</Word>
      <Word>Bitmap</Word>
      <Word>Image</Word>
      <Word>Point</Word>
      <Word>PointF</Word>
      <Word>Size</Word>
      <Word>SizeF</Word>
      <Word>Rectangle</Word>
      <Word>RectangleF</Word>
      <Word>Color</Word>
      <Word>Pen</Word>
      <Word>Brush</Word>
      <Word>Font</Word>
      <Word>String</Word>
      <Word>IntPtr</Word>
      <Word>UIntPtr</Word>
      <Word>Marshal</Word>
      <Word>BitConverter</Word>
      <Word>Buffer</Word>
      <Word>ValueType</Word>
      <Word>Attribute</Word>
      <Word>FlagsAttribute</Word>
      <Word>SerializableAttribute</Word>
      <Word>DataTable</Word>
      <Word>DataSet</Word>
      <Word>DataColumn</Word>
      <Word>DataRow</Word>
      <Word>SqlConnection</Word>
      <Word>SqlCommand</Word>
      <Word>SqlDataReader</Word>
      <Word>OleDbConnection</Word>
      <Word>OleDbCommand</Word>
      <Word>OleDbDataReader</Word>
      <Word>XPathDocument</Word>
      <Word>XmlDocument</Word>
      <Word>XmlNode</Word>
      <Word>XmlElement</Word>
      <Word>XmlAttribute</Word>
      <Word>XmlReader</Word>
      <Word>XmlWriter</Word>
      <Word>XmlSerializer</Word>
    </Keywords>

    <!-- Number literal (integer, float, hex, binary) -->
    <Rule color="Number">
      \b0[xX][0-9a-fA-F][0-9a-fA-F_]*(u|l|ul|lu|U|L|UL|LU)?\b
    </Rule>
    <Rule color="Number">
      \b0[bB][01][01_]*\b
    </Rule>
    <Rule color="Number">
      \b\d[\d_]*\.\d[\d_]*([eE][+-]?\d[\d_]*)?[fFdDmM]?\b
    </Rule>
    <Rule color="Number">
      \b\d[\d_]*[fFdDmMuUlL]\b
    </Rule>
    <Rule color="Number">
      \b\d[\d_]*\b
    </Rule>

    <!-- Method name fallback: 标识符后跟 ( → 方法颜色（Layer 2 Roslyn 语义分类覆盖） -->
    <Rule color="Method">
      \b[A-Za-z_]\w*(?=\s*\()
    </Rule>

  </RuleSet>

  <!-- Comment content (support TODO, FIXME, etc.) -->
  <RuleSet name="CommentContent">
    <Rule color="Comment">
      TODO|FIXME|HACK|UNDONE|XXX
    </Rule>
  </RuleSet>

  <!-- Preprocessor content ruleSet removed: preprocessor now uses a single Rule that colors the whole line -->

</SyntaxDefinition>
