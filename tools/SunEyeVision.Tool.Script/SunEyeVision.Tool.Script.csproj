<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SunEyeVision.Tool.Script</RootNamespace>
    <AssemblyName>SunEyeVision.Tool.Script</AssemblyName>
    <IsToolPlugin>true</IsToolPlugin>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- 将 xshd 语法高亮文件复制到输出目录的 Resources 子文件夹 -->
    <None Include="Resources\CSharpLight.xshd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\CSharpDark.xshd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 嵌入式资源：代码模板（由 ScriptParameters.LoadEmbeddedResource 加载） -->
    <EmbeddedResource Include="Resources\MinimalCode.txt" />
    <EmbeddedResource Include="Resources\DemoCode.txt" />
  </ItemGroup>
  <!-- XAML 编译期 + C# 代码 (ICSharpCode.AvalonEdit.*) 都需要类型解析,
       运行时由主程序 SunEyeVision.UI 统一加载,Directory.Build.targets Step 1.2 拦截
       不让 AvalonEdit / Roslyn dll 复制到 plugins/<ToolName>/,工具目录保持干净。
       (主程序已声明同名 PackageReference,Assembly.LoadFrom 时 CLR 在 probing 根找到) -->
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.12.0" />
  </ItemGroup>
  <!-- ScriptRefs 部署：构建后从主程序输出根目录复制宿主 DLL 到 ScriptRefs 子目录，
       这些 DLL 被 Roslyn 编译和沙箱运行时引用。部署机制确保 clean build 后 ScriptRefs 非空。 -->
  <Target Name="CopyToScriptRefs" AfterTargets="Build" Condition="'$(IsToolPlugin)'=='true'">
    <PropertyGroup>
      <_ScriptRefsDir>$(OutDir)ScriptRefs\</_ScriptRefsDir>
    </PropertyGroup>
    <ItemGroup>
      <_ScriptRefsDlls Include="$([System.IO.Path]::GetFullPath('$(OutDir)..\..\halcondotnetxl.dll'))" />
      <_ScriptRefsDlls Include="$([System.IO.Path]::GetFullPath('$(OutDir)..\..\OpenCvSharp.dll'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_ScriptRefsDlls)" DestinationFolder="$(_ScriptRefsDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugin.SDK\SunEyeVision.Plugin.SDK.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Workflow\SunEyeVision.Workflow.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\SunEyeVision.CvEngine\SunEyeVision.CvEngine.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
