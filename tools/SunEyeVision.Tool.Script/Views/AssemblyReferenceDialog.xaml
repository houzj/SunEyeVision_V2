<Window x:Class="SunEyeVision.Tool.Script.Views.AssemblyReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SunEyeVision.Tool.Script.Views"
        Title="程序集引用管理"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500" Height="400"
        ResizeMode="NoResize">

    <Border Background="#FF2D2D30"
            CornerRadius="0"
            BorderBrush="#FF3C3C3C"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="3" BlurRadius="10"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FF1E1E1E" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="程序集引用管理"
                               Foreground="White" VerticalAlignment="Center" FontSize="13"/>
                    <Button Grid.Column="1" Content="✕" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="14" Cursor="Hand"
                            Click="OnCloseButtonClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区：TabControl 两标签页 -->
            <TabControl Grid.Row="1" Margin="12,8,12,8"
                        Background="#FF1E1E1E" BorderBrush="#FF3C3C3C"
                        Foreground="#FFDCDCDC" FontSize="12">
                <TabControl.Resources>
                    <local:AssemblyStatusConverter x:Key="AssemblyStatusConverter"/>
                </TabControl.Resources>

                <!-- 内置程序集标签页（只读：ScriptRefs 自动部署的 8 个关键 DLL） -->
                <TabItem Header="内置程序集"
                         Background="#FF1E1E1E" Foreground="#FFDCDCDC"
                         BorderBrush="#FF3C3C3C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 说明文字 -->
                        <TextBlock Grid.Row="0" Text="CopyScriptRefs.ps1 自动部署的 8 个关键程序集（只读）"
                                   Foreground="#FF999999" FontSize="11" Margin="0,0,0,6"
                                   TextWrapping="Wrap"/>

                        <!-- 内置程序集列表 -->
                        <ListBox Grid.Row="1" x:Name="BuiltInAssemblyListBox"
                                 Background="#FF1E1E1E" Foreground="#FFDCDCDC"
                                 BorderBrush="#FF3C3C3C" BorderThickness="1"
                                 FontSize="12"
                                 ItemsSource="{Binding}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Status, Converter={StaticResource AssemblyStatusConverter}}"
                                                   Margin="4,2,6,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" Margin="0,2" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- 用户自定义DLL标签页（可管理：添加/删除） -->
                <TabItem Header="用户自定义DLL"
                         Background="#FF1E1E1E" Foreground="#FFDCDCDC"
                         BorderBrush="#FF3C3C3C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ 添加DLL..." Click="OnAddButtonClick"
                                    Background="#FF007ACC" Foreground="White"
                                    BorderThickness="0" Padding="10,4" FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>

                        <!-- 用户自定义 DLL 列表（每条自带 ✕ 删除按钮） -->
                        <ListBox Grid.Row="1" x:Name="UserCustomListBox"
                                 Background="#FF1E1E1E" Foreground="#FFDCDCDC"
                                 BorderBrush="#FF3C3C3C" BorderThickness="1"
                                 FontSize="12"
                                 ItemsSource="{Binding}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" Margin="4,2" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Width="20" Height="20"
                                                Background="Transparent" Foreground="#FF999999"
                                                BorderThickness="0" FontSize="10" Cursor="Hand"
                                                Click="OnItemDeleteButtonClick"
                                                ToolTip="移除此引用">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E81123"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="#FF252526" BorderBrush="#FF3C3C3C"
                    BorderThickness="0,1,0,0" Padding="12,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Width="80" Height="28" Margin="0,0,8,0"
                            Background="#FF007ACC" Foreground="White"
                            BorderThickness="0" FontSize="12" Cursor="Hand"
                            Click="OnOkButtonClick"/>
                    <Button Content="取消" Width="80" Height="28"
                            Background="#FF3C3C3C" Foreground="#FFDCDCDC"
                            BorderThickness="0" FontSize="12" Cursor="Hand"
                            Click="OnCancelButtonClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
