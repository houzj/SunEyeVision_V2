<Window x:Class="SunEyeVision.Tool.Script.Views.AssemblyReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序集引用管理"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500" Height="400"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource ThemePanelBackgroundBrush}"
            CornerRadius="0"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="3" BlurRadius="10"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBarBackgroundBrush}" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="程序集引用管理"
                               Foreground="{DynamicResource ThemeTitleBarTextBrush}" VerticalAlignment="Center" FontSize="13"/>
                    <Button Grid.Column="1" Content="✕" Width="32" Height="32"
                            Background="Transparent" Foreground="{DynamicResource ThemeTitleBarTextBrush}"
                            BorderThickness="0" FontSize="14" Cursor="Hand"
                            Click="OnCloseButtonClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeErrorBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区：当前节点程序集引用勾选列表 -->
            <Grid Grid.Row="1" Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 说明 -->
                <TextBlock Grid.Row="0" Text="勾选要引用的程序集（系统必需项锁定不可取消）："
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="2,0,0,6"/>

                <!-- 勾选列表 -->
                <ListBox Grid.Row="1" x:Name="RefCheckListBox"
                         Background="{DynamicResource ThemeInputBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                         BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}"
                                      IsEnabled="{Binding IsEditable}"
                                      Content="{Binding DisplayName}"
                                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                      Margin="6,3"
                                      Checked="OnRefCheckChanged"
                                      Unchecked="OnRefCheckChanged"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 添加用户 DLL -->
                <Button Grid.Row="2" Content="+ 添加用户 DLL..." Click="OnAddButtonClick"
                        Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeTextOnDarkBrush}"
                        BorderThickness="0" Padding="10,4" FontSize="12"
                        Margin="0,8,0,0" HorizontalAlignment="Left" Cursor="Hand"/>
            </Grid>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource ThemeStatusBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeStatusBarBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="12,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Width="80" Height="28" Margin="0,0,8,0"
                            Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeTextOnDarkBrush}"
                            BorderThickness="0" FontSize="12" Cursor="Hand"
                            Click="OnOkButtonClick"/>
                    <Button Content="取消" Width="80" Height="28"
                            Background="{DynamicResource ThemeButtonBackgroundBrush}" Foreground="{DynamicResource ThemeButtonTextBrush}"
                            BorderThickness="0" FontSize="12" Cursor="Hand"
                            Click="OnCancelButtonClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
