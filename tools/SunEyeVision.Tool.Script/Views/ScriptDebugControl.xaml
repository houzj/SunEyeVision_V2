<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.Script.Views.ScriptDebugControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#FF2D2D30"
             Foreground="#FFDCDCDC">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <ToolBar Grid.Row="0" Background="#FF3C3C3C" BorderBrush="#FF3C3C3C" Height="32">
            <Button x:Name="ExecuteButton" Content="  执行" Click="ExecuteButton_Click"
                    Background="#FF007ACC" Foreground="White" BorderThickness="0"
                    Padding="10,3" Margin="2,0" FontSize="13" FontWeight="Bold" />
            <Separator />
            <Button x:Name="ClearCodeButton" Content="清空代码" Click="ClearCodeButton_Click"
                    Background="#FF3C3C3C" Foreground="#FFDCDCDC" BorderThickness="0"
                    Padding="8,3" Margin="2,0" FontSize="12" />
            <Button x:Name="ClearResultButton" Content="清空结果" Click="ClearResultButton_Click"
                    Background="#FF3C3C3C" Foreground="#FFDCDCDC" BorderThickness="0"
                    Padding="8,3" Margin="2,0" FontSize="12" />
            <Separator />
            <Label Content="状态:" Foreground="#FF999999" FontSize="12" VerticalAlignment="Center" Padding="4,0" />
            <Label x:Name="StatusLabel" Content="就绪" Foreground="#FF6A9955" FontSize="12"
                   VerticalAlignment="Center" Padding="4,0" FontWeight="Bold" />
        </ToolBar>

        <!-- ===== 主内容区域（可调节分区）===== -->
        <Grid Grid.Row="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 左侧面板：输入/输出变量（TabControl 切换） -->
            <Grid Grid.Column="0" Background="#FF252526">
                <TabControl Background="#FF252526" BorderThickness="0"
                           Padding="0" Margin="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="#FF2D2D30" />
                        </Style>
                    </TabControl.Resources>

                    <!-- ===== Tab 1: 输入变量 ===== -->
                    <TabItem Header="输入变量" Background="#FF252526" Foreground="#FFDCDCDC"
                             FontSize="12" Padding="8,3">
                        <DataGrid x:Name="InputDataGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                  Background="#FF252526" Foreground="#FFDCDCDC"
                                  RowHeaderWidth="0" BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FontSize="12">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF264F78" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding DisplayValue}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- ===== Tab 2: 输出变量 ===== -->
                    <TabItem Header="输出变量" Background="#FF252526" Foreground="#FFDCDCDC"
                             FontSize="12" Padding="8,3">
                        <DataGrid x:Name="OutputDataGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="#FF252526" Foreground="#FFDCDCDC"
                                  RowHeaderWidth="0" BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FontSize="12">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF264F78" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding DisplayValue}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" Background="#FF3C3C3C"
                          HorizontalAlignment="Stretch" />

            <!-- 中间面板：代码编辑器（AvalonEdit） -->
            <Grid Grid.Column="2" Background="#FF1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF1E1E1E" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="脚本代码 (C#)" Foreground="#FF569CD6" FontSize="13" FontWeight="Bold" />
                        <Label x:Name="CodeInfoLabel" Grid.Column="1"
                               Content="就绪" Foreground="#FF999999" FontSize="11"
                               VerticalAlignment="Center" Padding="4,0" />
                    </Grid>
                </Border>

                <avalonedit:TextEditor Grid.Row="1" x:Name="CodeEditor"
                                        FontFamily="Consolas" FontSize="12"
                                        Foreground="#FFDCDCDC" Background="#FF1E1E1E"
                                        LineNumbersForeground="#FF2B91AF"
                                        WordWrap="False"
                                        ShowLineNumbers="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Visible"
                                        SyntaxHighlighting="C#" />
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" Background="#FF3C3C3C"
                          HorizontalAlignment="Stretch" />

            <!-- 右侧面板：错误列表 + DLL 引用 -->
            <Grid Grid.Column="4" Background="#FF252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF1E1E1E" Padding="6,4">
                    <TextBlock Text="错误列表" Foreground="#FFF44747" FontSize="13" FontWeight="Bold" />
                </Border>

                <ListBox Grid.Row="1" x:Name="ErrorListBox"
                         Background="#FF252526" Foreground="#FFF44747"
                         BorderThickness="0" FontSize="12"
                         MouseDoubleClick="ErrorListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#FF1E1E1E" Padding="6,4">
                    <TextBlock Text="DLL 引用" Foreground="#FF4EC9B0" FontSize="13" FontWeight="Bold" />
                </Border>

                <ListBox Grid.Row="3" x:Name="DllReferenceList"
                         Background="#FF252526" Foreground="#FFDCDCDC"
                         BorderThickness="0" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="3" Background="#FF3C3C3C"
                      HorizontalAlignment="Stretch" />

        <!-- ===== 底部：日志输出面板 ===== -->
        <Grid Grid.Row="3" Background="#FF1E1E1E" Margin="0,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#FF1E1E1E" Margin="6,4,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="日志输出" Foreground="#FFDCDCDC" FontSize="12" FontWeight="Bold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Label x:Name="CompileTimeLabel" Content="" Foreground="#FF569CD6" FontSize="11" Padding="4,0" />
                    <Label x:Name="ExecTimeLabel" Content="" Foreground="#FF6A9955" FontSize="11" Padding="4,0" />
                </StackPanel>
            </Grid>

            <ListBox Grid.Row="1" x:Name="LogListBox"
                     Background="#FF1E1E1E" Foreground="#FFDCDCDC"
                     BorderThickness="0" FontSize="11"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="1" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="2,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</controls:ToolDebugControlBase>
