<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.Script.Views.ScriptDebugControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
             xmlns:models="clr-namespace:SunEyeVision.Tool.Script.Models"
             xmlns:views="clr-namespace:SunEyeVision.Tool.Script.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#FFF5F5F5"
             Foreground="#FF333333">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <ToolBar Grid.Row="0" Background="#FFF0F0F0" BorderBrush="#FFE0E0E0" Height="32">
            <!-- 执行由基窗口 DefaultDebugWindow 底部的统一按钮提供 -->
            <Button x:Name="ClearResultButton" Content="清空结果" Click="ClearResultButton_Click"
                    Background="#FFF0F0F0" Foreground="#FF333333" BorderThickness="0"
                    Padding="8,3" Margin="2,0" FontSize="12" />
            <Separator />
            <Button x:Name="AssemblyRefButton" Content="引用程序集"
                    Click="AssemblyRefButton_Click"
                    Background="#FFF0F0F0" Foreground="#FF333333" BorderThickness="0"
                    Padding="8,3" Margin="2,0" FontSize="12" />
            <Separator />
            <Label Content="状态:" Foreground="#FF666666" FontSize="12" VerticalAlignment="Center" Padding="4,0" />
            <Label x:Name="StatusLabel" Content="就绪" Foreground="#FF107C10" FontSize="12"
                   VerticalAlignment="Center" Padding="4,0" FontWeight="Bold" />
        </ToolBar>

        <!-- ===== 主内容区域（左：变量面板 | 右：代码编辑器+日志）===== -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ***** 浅色 TabControl 和 DataGrid 共用资源 ***** -->
            <Grid.Resources>
                <ResourceDictionary>
                    <Style TargetType="TabPanel">
                        <Setter Property="Background" Value="#FFF0F0F0" />
                    </Style>

                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#FFF0F0F0" />
                        <Setter Property="Foreground" Value="#FF555555" />
                        <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FFFFFFFF" />
                                            <Setter Property="Foreground" Value="#FF000000" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FFE8E8E8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- DataGrid 浅色样式 -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFF0F0F0" />
                        <Setter Property="Foreground" Value="#FF000000" />
                        <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFFAFAFA" />
                        <Setter Property="Foreground" Value="#FF000000" />
                        <Setter Property="BorderBrush" Value="#FFE8E8E8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF007ACC" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5F5" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF000000" />
                        <Setter Property="BorderBrush" Value="#FFE8E8E8" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF007ACC" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </Grid.Resources>

            <!-- ===== 左侧面板：输入/输出/显示 Tab（无外层嵌套）===== -->
            <TabControl Grid.Column="0" Background="#FFFAFAFA" BorderThickness="0"
                       Padding="0" Margin="0">
                <TabItem Header="输入设置" FontSize="12" Padding="8,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:ScriptVariableTab x:Name="InputTabControl" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="输出设置" FontSize="12" Padding="8,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:ScriptVariableTab x:Name="OutputTabControl" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="显示设置" FontSize="12" Padding="8,4">
                    <TextBlock Text="显示设置（占位）" Margin="12,20"
                               Foreground="#FF888888"/>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" Background="#FFD0D0D0"
                          HorizontalAlignment="Stretch" />

            <!-- ===== 右侧面板：代码编辑器 + 下方日志 ===== -->
            <Grid Grid.Column="2" Background="#FFFFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="3" />
                    <RowDefinition Height="200" MinHeight="80" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFF8F8F8" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="脚本代码 (C#)" Foreground="#FF0066CC" FontSize="13" FontWeight="Bold" />
                        <Label x:Name="CodeInfoLabel" Grid.Column="1"
                               Content="就绪" Foreground="#FF666666" FontSize="11"
                               VerticalAlignment="Center" Padding="4,0" />
                    </Grid>
                </Border>

                <avalonedit:TextEditor Grid.Row="1" x:Name="CodeEditor"
                                        FontFamily="Consolas" FontSize="12"
                                        Background="#FFFFFFFF"
                                        Foreground="#FF000000"
                                        LineNumbersForeground="#FF888888"
                                        WordWrap="False"
                                        ShowLineNumbers="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Visible" />

                <GridSplitter Grid.Row="2" Height="3" Background="#FFD0D0D0"
                              HorizontalAlignment="Stretch" />

                <!-- 日志输出（在代码编辑器下方） -->
                <Grid Grid.Row="3" Background="#FFFAFAFA" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#FFF8F8F8" Margin="6,4,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出" Foreground="#FF000000" FontSize="12" FontWeight="Bold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Label x:Name="CompileTimeLabel" Content="" Foreground="#FF0066CC" FontSize="11" Padding="4,0" />
                            <Label x:Name="ExecTimeLabel" Content="" Foreground="#FF107C10" FontSize="11" Padding="4,0" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="LogListBox"
                             Background="#FFFAFAFA" Foreground="#FF333333"
                             BorderThickness="0" FontSize="11"
                             SelectionMode="Extended"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             MouseDoubleClick="LogListBox_MouseDoubleClick"
                             KeyDown="LogListBox_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制选中" Click="CopyLogMenuItem_Click" InputGestureText="Ctrl+C" />
                                <MenuItem Header="全选" Click="SelectAllLogMenuItem_Click" InputGestureText="Ctrl+A" />
                                <Separator />
                                <MenuItem Header="清空" Click="ClearResultButton_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:LogEntry">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="2,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FFCC0000" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="False">
                                        <Setter Property="Foreground" Value="#FF333333" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</controls:ToolDebugControlBase>
