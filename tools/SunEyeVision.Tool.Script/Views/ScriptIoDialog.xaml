<Window x:Class="SunEyeVision.Tool.Script.Views.ScriptIoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SunEyeVision.Tool.Script.Models"
        mc:Ignorable="d"
        Title="脚本变量管理" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5"
        Foreground="#FF333333"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFAFAFA"/>
            <Setter Property="BorderBrush" Value="#FFE8E8E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- 输入变量区域 -->
        <Label DockPanel.Dock="Top" Content="输入变量" FontWeight="Bold" FontSize="14"
               Foreground="#FF0066CC" Padding="0,5,0,3"/>
        <DataGrid x:Name="InputGrid" DockPanel.Dock="Top" Height="150" Margin="0,0,0,5">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="变量名" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="2,0" BorderThickness="1"
                                     Background="#FFFAFAFA"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=AvailableTypes}"
                                      Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" Margin="2,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Click="DeleteInput_Click"
                                    Background="#FFE0E0E0" Foreground="#FFCC0000"
                                    BorderThickness="0" Width="28" Height="24" Padding="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="AddInputButton" DockPanel.Dock="Top" Content="+ 添加输入" Click="AddInput_Click"
                Background="#FFE8F5FF" Foreground="#FF0066CC" BorderBrush="#FFB8D6F0"
                HorizontalAlignment="Left" Margin="0,0,0,12"/>

        <!-- 输出变量区域 -->
        <Label DockPanel.Dock="Top" Content="输出变量" FontWeight="Bold" FontSize="14"
               Foreground="#FF007A33" Padding="0,5,0,3"/>
        <DataGrid x:Name="OutputGrid" DockPanel.Dock="Top" Height="150" Margin="0,0,0,5">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="变量名" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="2,0" BorderThickness="1"
                                     Background="#FFFAFAFA"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=AvailableTypes}"
                                      Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" Margin="2,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Click="DeleteOutput_Click"
                                    Background="#FFE0E0E0" Foreground="#FFCC0000"
                                    BorderThickness="0" Width="28" Height="24" Padding="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="AddOutputButton" Content="+ 添加输出" Click="AddOutput_Click"
                Background="#FFE8FFEE" Foreground="#FF007A33" BorderBrush="#FFB8F0C8"
                HorizontalAlignment="Left" Margin="0,0,0,12"/>

        <!-- 底部按钮 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="取消" Click="Cancel_Click" Width="80" Height="30"
                    Background="#FFF0F0F0" Foreground="#FF333333"
                    BorderBrush="#FFD0D0D0" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            <Button Content="确定" Click="Ok_Click" Width="80" Height="30"
                    Background="#FF007ACC" Foreground="White"
                    BorderThickness="0" DockPanel.Dock="Right"/>
        </DockPanel>
    </DockPanel>
</Window>
