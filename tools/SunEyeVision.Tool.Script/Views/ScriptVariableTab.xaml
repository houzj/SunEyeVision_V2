<UserControl x:Class="SunEyeVision.Tool.Script.Views.ScriptVariableTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
    xmlns:models="clr-namespace:SunEyeVision.Tool.Script.Models"
    mc:Ignorable="d"
    d:DesignHeight="350" d:DesignWidth="350"
    Background="{DynamicResource ThemePanelBackgroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTableHeaderTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeTableGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource ThemeTableRowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeTableGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeTableRowHoverBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                </Trigger>
                <!-- 失焦仍保留选中主题色，而非系统默认灰 -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Style.Triggers>
                <!-- 选中/失焦选中主题适配：覆盖系统默认 InactiveSelectionHighlight 样式，
                     暗色主题下避免选中行文字因系统默认前景色不可见 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                </Trigger>
                <!-- 失焦仍保留选中主题色 -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeTableRowSelectedBackgroundBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 标题行 -->
            <RowDefinition Height="*" />  <!-- 内容行（填满剩余空间，编辑模式 DataGrid + 添加栏） -->
        </Grid.RowDefinitions>

        <!-- ===== 第 1 行：标题栏 + ✏ 编辑/完成按钮 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Left"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
            <Button x:Name="ToggleEditButton" DockPanel.Dock="Right"
                    Content="✏ 编辑" Click="ToggleEditMode_Click"
                    Width="70" Height="26" Padding="0" FontSize="12"
                    Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeTextOnDarkBrush}"
                    BorderThickness="0" Cursor="Hand"/>
        </DockPanel>

        <!-- ===== 第 2 行：监视模式 / 编辑模式 ===== -->
        <!-- 监视模式：变量树（TreeView 自带 ScrollViewer，删除外层冗余包装）
             ItemsSource 绑定到 MonitorNodes（SSOT），外部可直接增删改该集合，UI 自动刷新。 -->
        <TreeView x:Name="MonitorItems" Grid.Row="1" BorderThickness="0"
                  Background="Transparent"
                  ItemsSource="{Binding MonitorNodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True">
            <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:MonitorNode}"
                                              ItemsSource="{Binding Children}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 单行布局：Name（+ 叶子节点的 Value 同行） + Type + Binding -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeAccentBrush}" FontSize="12"/>
                                <!-- 叶子节点：Name 同行追加 " DisplayValue" -->
                                <TextBlock Margin="4,0,0,0" FontSize="11" FontStyle="Italic"
                                           Foreground="{Binding ValueBrush}"
                                           Text="{Binding DisplayValue}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TypeDisplay}"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           Margin="4,0,0,0" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TypeDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <!-- Binding 显示（仅 HasBinding=True 时显示） -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BindingDisplayText}"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="10" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBinding}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </HierarchicalDataTemplate>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <!-- 鼠标悬停时浅色高亮提升交互感 -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeTableRowHoverBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.Resources>
            </TreeView>

        <!-- 编辑模式：DataGrid + 添加栏（默认隐藏） -->
        <Grid x:Name="EditView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="EditGrid" Grid.Row="0">
                <DataGrid.Columns>
                        <!-- 变量名 -->
                        <DataGridTemplateColumn Header="&#x53D8;&#x91CF;&#x540D;" Width="*" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                             BorderThickness="1" Padding="4,2"
                                             Height="28" Margin="2,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 类型 -->
                        <DataGridTemplateColumn Header="&#x7C7B;&#x578B;" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AvailableTypes}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="False" Height="28" Margin="2,2"
                                              BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                              Background="{DynamicResource ThemeInputBackgroundBrush}"
                                              Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 订阅关系（仅输入列，输出隐藏） -->
                        <DataGridTemplateColumn x:Name="BindingColumn" Header="&#x8BA2;&#x9605;&#x5173;&#x7CFB;" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:ParamBinding
                                        AvailableDataSources="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AvailableSources}"
                                        DataType="{Binding ParamType}"
                                        BindingSource="{Binding BindingSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        BindingDisplayText="{Binding BindingDisplayText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        ParameterName="{Binding Name}"
                                        Height="28"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 操作 -->
                        <DataGridTemplateColumn Header="&#x64CD;&#x4F5C;" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&#x2191;" Click="MoveUp_Click"
                                                Width="26" Height="28" Padding="0" Margin="1,2"
                                                Background="{DynamicResource ThemeControlBackgroundBrush}" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                BorderThickness="0" FontSize="12"/>
                                        <Button Content="&#x2193;" Click="MoveDown_Click"
                                                Width="26" Height="28" Padding="0" Margin="1,2"
                                                Background="{DynamicResource ThemeControlBackgroundBrush}" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                BorderThickness="0" FontSize="12"/>
                                        <Button x:Name="DeleteButton" Content="&#x2715;"
                                                Click="DeleteItem_Click"
                                                Width="26" Height="28" Padding="0" Margin="1,2"
                                                Background="{DynamicResource ThemeControlBackgroundBrush}" Foreground="{DynamicResource ThemeErrorBrush}"
                                                BorderThickness="0" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            <!-- 添加栏紧贴 DataGrid 底部 -->
            <Border x:Name="AddBar" Grid.Row="1"
                    BorderBrush="{DynamicResource ThemeStatusBarBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource ThemeStatusBarBackgroundBrush}" Padding="4,4">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="TypeCombo" Height="26" MinWidth="110"
                              VerticalAlignment="Center"
                              SelectedValuePath="Value"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="+" Height="26" Width="32" Margin="4,0,0,0"
                            Click="AddVariable_Click"
                            Background="{DynamicResource ThemeSuccessBrush}" Foreground="{DynamicResource ThemeTextOnDarkBrush}"
                            BorderThickness="0" FontWeight="Bold" FontSize="16"
                            ToolTip="&#x6DFB;&#x52A0;&#x53D8;&#x91CF;"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>