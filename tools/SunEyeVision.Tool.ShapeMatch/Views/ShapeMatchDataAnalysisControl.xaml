<UserControl x:Class="SunEyeVision.Tool.ShapeMatch.Views.ShapeMatchDataAnalysisControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.RoiEditor.Converters;assembly=SunEyeVision.Plugin.SDK"
        mc:Ignorable="d"
        d:DesignHeight="350" d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- 统计摘要区域（顶部固定） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="匹配: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MatchCount, Mode=OneWay}" FontWeight="Bold" Foreground="#2196F3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="最佳分: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding BestScore, StringFormat='{}{0:F3}', Mode=OneWay}" FontWeight="Bold" Foreground="#4CAF50"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="判断: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding JudgmentStatus, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding JudgmentColor, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="耗时: " Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ExecutionTime, StringFormat='{}{0}ms', Mode=OneWay}" Foreground="#9C27B0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 匹配详细数据表格 -->
        <DataGrid x:Name="MatchDataGrid"
                  ItemsSource="{Binding MatchedItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeight="22"
                  FontSize="11"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource ThemeTableRowBackgroundBrush}"
                  RowBackground="{DynamicResource ThemeTableRowBackgroundBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  AlternatingRowBackground="{DynamicResource ThemeTableRowHoverBackgroundBrush}"
                  SelectionChanged="MatchDataGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTableHeaderTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeTableGridLineBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Label}" Width="36"/>
                <DataGridTextColumn Header="模板名" Binding="{Binding TemplateName}" Width="80"/>
                <DataGridTextColumn Header="分数" Binding="{Binding Score, StringFormat='{}{0:F3}'}" Width="52"/>
                <DataGridTextColumn Header="中心X" Binding="{Binding CenterX, StringFormat='{}{0:F1}'}" Width="56"/>
                <DataGridTextColumn Header="中心Y" Binding="{Binding CenterY, StringFormat='{}{0:F1}'}" Width="56"/>
                <DataGridTextColumn Header="角度(°)" Binding="{Binding Angle, StringFormat='{}{0:F2}'}" Width="58"/>
                <DataGridTextColumn Header="缩放" Binding="{Binding Scale, StringFormat='{}{0:F4}'}" Width="54"/>
                <DataGridTextColumn Header="判断" Binding="{Binding JudgmentText}" Width="40"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>