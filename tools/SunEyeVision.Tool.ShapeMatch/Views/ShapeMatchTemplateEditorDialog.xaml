<Window x:Class="SunEyeVision.Tool.ShapeMatch.Views.ShapeMatchTemplateEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views;assembly=SunEyeVision.Plugin.SDK"
        Title="模版创建 / 编辑"
        Width="1200" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 模版名称 + 图像源选择（同一行） -->
    <Border Grid.Row="0" Background="White" Padding="12,8" Margin="0,0,0,6" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="模版名称:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
        <TextBox x:Name="templateNameTextBox" Width="220" Margin="8,0,12,0" VerticalContentAlignment="Center"
                 FontSize="13" Padding="4,2"/>
        <TextBlock Text="图像源:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
        <ComboBox x:Name="imageSourceCombo" Width="100" Height="26" FontSize="11"
                  SelectionChanged="OnImageSourceSelectionChanged"/>
        <Rectangle Width="1" Fill="#D0D0D0" Margin="0,2,8,2"/>
        <Button x:Name="btnExtractContour" Content="创建模版" Width="70" Height="26" Click="OnExtractClick" FontSize="11" Margin="0,0,6,0"/>
        <Button x:Name="btnPreviewContour" Content="👁 预览" Width="70" Height="26" Click="OnPreviewClick" FontSize="11" Margin="0,0,6,0"/>
        <Button x:Name="btnClearContour" Content="🗑 清除" Width="70" Height="26" Click="OnClearClick" FontSize="11" Foreground="#D32F2F"/>
      </StackPanel>
    </Border>

    <!-- 主内容区：左右分栏 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="65*"/>
        <ColumnDefinition Width="35*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== 左侧栏 (65%) - 仅图像显示 ===== -->
      <Border Grid.Column="0" Background="White" Margin="0,0,3,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
        <controls:ImageControl x:Name="dialogImageControl"
                               ShowToolBar="True"
                               ShowImageSourceSelector="False"
                               ShowStatusBar="True"
                               EnablePanning="True"
                               EnableZoom="True"
                               OverlayHitTestVisible="True"/>
      </Border>

      <!-- ===== 右侧栏 (35%) ===== -->
      <ScrollViewer Grid.Column="1" Margin="3,0,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 区域编辑管理器 -->
          <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
            <region:RegionEditorManagerControl x:Name="dialogRegionManager"
                                                InspectionRegionsSource="{Binding DialogInspectionRegions}"
                                                MaskRegionsSource="{Binding DialogMaskRegions}"/>
          </Border>

          <!-- 轮廓提取参数 -->
          <GroupBox Header="轮廓提取参数" Margin="0,6,0,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- 第0行 -->
              <TextBlock Text="平滑核大小:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numSmoothKernel" Grid.Row="0" Grid.Column="1" Height="26"
                                       IntValue="3" Minimum="1" Maximum="9" SmallChange="2" ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="高斯模糊的核大小。值越大，图像越模糊，只保留粗轮廓；值越小，细节越多。"
                                       Margin="0,0,0,3"/>

              <!-- 第1行 -->
              <TextBlock Text="低阈值:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numLowThreshold" Grid.Row="1" Grid.Column="1" Height="26"
                                       IntValue="50" Minimum="1" Maximum="255" SmallChange="1" ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="边缘判断的下限。强度低于此值的像素不会被判定为边缘。"
                                       Margin="0,0,0,3"/>

              <!-- 第2行 -->
              <TextBlock Text="高阈值:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numHighThreshold" Grid.Row="2" Grid.Column="1" Height="26"
                                       IntValue="150" Minimum="1" Maximum="255" SmallChange="1" ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="边缘判断的上限。强度高于此值的像素必为边缘。"
                                       Margin="0,0,0,3"/>

              <!-- 第3行 -->
              <TextBlock Text="孔径大小:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numApertureSize" Grid.Row="3" Grid.Column="1" Height="26"
                                       IntValue="3" Minimum="3" Maximum="7" SmallChange="2" ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="Canny 内部 Sobel 梯度算子的核大小。3=精确但敏感，5/7=平滑但可能丢失细节。"
                                       Margin="0,0,0,3"/>

              <!-- 第4行 -->
              <TextBlock Text="近似方法:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <ComboBox x:Name="cmbApproxMethod" Grid.Row="4" Grid.Column="1" Height="26" FontSize="11" Margin="0,0,0,3"
                        SelectionChanged="OnApproxMethodChanged"/>

              <!-- 第5行 -->
              <TextBlock Text="近似精度:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numApproxPrecision" Grid.Row="5" Grid.Column="1" Height="26"
                                       Value="2.0" Minimum="0.1" Maximum="10.0" SmallChange="0.1" DecimalPlaces="1"
                                       ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="控制轮廓点的密度。值越大，轮廓点越少（轮廓越粗）；值越小，轮廓点越多（轮廓越精细）。"
                                       Margin="0,0,0,3"/>

              <!-- 第6行 - 目标点数 -->
              <TextBlock Text="目标点数:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numTargetPointCount" Grid.Row="6" Grid.Column="1" Height="26"
                                       IntValue="60" Minimum="3" Maximum="500" SmallChange="10" ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="等距重采样的目标点数。值越大，轮廓越精细（匹配越慢）；值越小，轮廓越粗（匹配越快）。"
                                       Margin="0,0,0,3"/>

              <!-- 分隔线 -->
              <Rectangle Grid.Row="7" Grid.ColumnSpan="2" Height="1" Fill="#E0E0E0" Margin="0,2,0,4"/>

              <!-- 第8行 -->
              <TextBlock Text="最小链长:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numMinChainLength" Grid.Row="8" Grid.Column="1" Height="26"
                                       IntValue="8" Minimum="1" Maximum="500" SmallChange="1" ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="轮廓的最小长度（点数）。长度低于此值的短边缘段会被过滤掉。"
                                       Margin="0,0,0,3"/>

              <!-- 第9行 -->
              <TextBlock Text="最小面积:" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numMinArea" Grid.Row="9" Grid.Column="1" Height="26"
                                       Value="50.0" Minimum="0.1" Maximum="100000.0" SmallChange="10.0" DecimalPlaces="1"
                                       ShowUpDownButtons="True" ShowSlider="False"
                                       ToolTip="轮廓围成区域的最小面积。面积小于此值的孤立小轮廓会被过滤。"
                                       Margin="0,0,0,3"/>

              <!-- 第10行 -->
              <TextBlock Text="轮廓检索:" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,3"/>
              <ComboBox x:Name="cmbRetrievalMode" Grid.Row="10" Grid.Column="1" Height="26" FontSize="11"
                         ToolTip="External=只提取最外层轮廓；List=提取所有层级的轮廓（含内孔）。"
                         Margin="0,0,0,3"/>

              <!-- 第11行 -->
              <CheckBox x:Name="chkL2Gradient" Grid.Row="11" Grid.ColumnSpan="2" Content="使用 L2 梯度（更精确）"
                        IsChecked="True" FontSize="11"
                        ToolTip="梯度幅值的计算方式。开启(sqrt)更精确，关闭(|dx|+|dy|)更快但斜边可能偏弱。"
                        Margin="0,2,0,0"/>

              <!-- 第12行 -->
              <CheckBox x:Name="chkShowPointsOnly" Grid.Row="12" Grid.ColumnSpan="2" Content="仅显示点（不显示轮廓线）"
                        IsChecked="False" FontSize="11" Margin="0,2,0,0"/>

              <!-- 第13行 -->
              <CheckBox x:Name="chkUseSubPixel" Grid.Row="13" Grid.ColumnSpan="2" Content="亚像素轮廓（梯度插值细化）"
                        IsChecked="False" FontSize="11"
                        ToolTip="在梯度方向插值，将轮廓点坐标精确到小数位，提升匹配精度。"
                        Margin="0,2,0,0"/>
            </Grid>
          </GroupBox>

          <!-- 提取结果 -->
          <GroupBox Header="提取结果" Margin="0,6,0,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
            <StackPanel>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="状态:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtResultStatus" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="轮廓点数:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtPointCount" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="包围矩形:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtBoundingRect" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="中心点:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtCenterPoint" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 底部按钮栏 -->
    <Border Grid.Row="2" Background="#F0F0F0" Padding="16,10" Margin="0,6,0,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btnOk" Content="✓ 确定" Width="80" Height="30" Click="OnOkClick" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0"/>
        <Button x:Name="btnCancel" Content="取消" Width="80" Height="30" Click="OnCancelClick" FontSize="13"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
