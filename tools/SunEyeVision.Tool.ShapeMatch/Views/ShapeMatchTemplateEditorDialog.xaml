<Window x:Class="SunEyeVision.Tool.ShapeMatch.Views.ShapeMatchTemplateEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views;assembly=SunEyeVision.Plugin.SDK"
        Title="模版创建 / 编辑"
        Width="1200" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 模版名称 + 图像源选择（同一行） -->
    <Border Grid.Row="0" Background="White" Padding="12,8" Margin="0,0,0,6" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="模版名称:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
        <TextBox x:Name="templateNameTextBox" Width="220" Margin="8,0,12,0" VerticalContentAlignment="Center"
                 FontSize="13" Padding="4,2"/>
        <TextBlock Text="图像源:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
        <ComboBox x:Name="imageSourceCombo" Width="100" Height="26" FontSize="11"
                  SelectionChanged="OnImageSourceSelectionChanged"/>
        <Rectangle Width="1" Fill="#D0D0D0" Margin="0,2,8,2"/>
        <Button x:Name="btnExtractContour" Content="提取轮廓" Width="70" Height="26" Click="OnExtractClick" FontSize="11" Margin="0,0,6,0"/>
        <ComboBox x:Name="cmbPyramidLevel" Width="120" Height="26" FontSize="11" Margin="0,0,6,0"
                  SelectionChanged="OnPyramidLevelSelected" IsEnabled="False"/>
        <ComboBox x:Name="cmbDebugView" Width="90" Height="26" FontSize="10" Margin="0,0,6,0"
                  SelectionChanged="OnDebugViewChanged" IsEnabled="False">
          <ComboBoxItem Content="原始" Tag="original" IsSelected="True"/>
          <ComboBoxItem Content="对比度" Tag="mag"/>
          <ComboBoxItem Content="NMS" Tag="nms"/>
        </ComboBox>
        <Button x:Name="btnClearContour" Content="🗑 清除" Width="70" Height="26" Click="OnClearClick" FontSize="11" Foreground="#D32F2F"/>
      </StackPanel>
    </Border>

    <!-- 主内容区：左右分栏 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="65*"/>
        <ColumnDefinition Width="35*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== 左侧栏 (65%) - 仅图像显示 ===== -->
      <Border Grid.Column="0" Background="White" Margin="0,0,3,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
        <controls:ImageControl x:Name="dialogImageControl"
                               ShowToolBar="True"
                               ShowImageSourceSelector="False"
                               ShowStatusBar="True"
                               EnablePanning="True"
                               EnableZoom="True"
                               OverlayHitTestVisible="True"/>
      </Border>

      <!-- ===== 右侧栏 (35%) ===== -->
      <ScrollViewer Grid.Column="1" Margin="3,0,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 区域编辑管理器 -->
          <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
            <region:RegionEditorManagerControl x:Name="dialogRegionManager"
                                                InspectionRegionsSource="{Binding DialogInspectionRegions}"
                                                MaskRegionsSource="{Binding DialogMaskRegions}"/>
          </Border>

          <!-- 轮廓提取参数 -->
          <GroupBox Header="轮廓提取参数" Margin="0,6,0,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- 第0行 - 金字塔模式 -->
              <TextBlock Text="金字塔模式:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,6,3"/>
              <ComboBox x:Name="cmbPyramidMode" Grid.Row="0" Grid.Column="1" Height="26" FontSize="11" Margin="0,0,0,3"
                        SelectedIndex="0" SelectionChanged="OnPyramidModeChanged"
                        ToolTip="Auto=根据ROI尺寸自动计算金字塔结束层（短边≤64px），Manual=手动设置起始层和结束层。"/>

              <!-- 第1行 - 起始层 -->
              <TextBlock Text="  起始层:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#1565C0" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numPyramidStart" Grid.Row="1" Grid.Column="1" Height="26"
                                       IntValue="1" Minimum="1" Maximum="10" SmallChange="1" ShowUpDownButtons="True" ShowSlider="True"
                                       ToolTip="起始层（最细匹配层），1=半分辨率，值越小越精细。仅 Manual 模式有效。"
                                       Margin="0,0,0,3"/>

              <!-- 第2行 - 结束层 -->
              <TextBlock Text="  结束层:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#1565C0" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numPyramidEnd" Grid.Row="2" Grid.Column="1" Height="26"
                                       IntValue="4" Minimum="1" Maximum="10" SmallChange="1" ShowUpDownButtons="True" ShowSlider="True"
                                       ToolTip="结束层（最粗匹配层），值越大图像缩得越小。仅 Manual 模式有效。"
                                       Margin="0,0,0,3"/>

              <!-- 第3行 - 阈值模式 -->
              <TextBlock Text="阈值模式:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,6,3"/>
              <ComboBox x:Name="cmbThresholdMode" Grid.Row="3" Grid.Column="1" Height="26" FontSize="11" Margin="0,0,0,3"
                        SelectedIndex="0" SelectionChanged="OnThresholdModeChanged"
                        ToolTip="Auto=从梯度幅值直方图自动计算对比度阈值，Manual=使用下方设定的对比度值。"/>

              <!-- 第4行 - 对比度 -->
              <TextBlock Text="  对比度:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#1565C0" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numContrast" Grid.Row="4" Grid.Column="1" Height="26"
                                       IntValue="30" Minimum="1" Maximum="255" SmallChange="1" ShowUpDownButtons="True" ShowSlider="True"
                                       ToolTip="边缘提取对比度阈值。高对比度=保留强边缘，低对比度=保留更弱边缘。典型值：20~100。仅 Manual 模式有效。"
                                       Margin="0,0,0,3"/>

              <!-- 第5行 - 链长模式 -->
              <TextBlock Text="链长模式:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,6,3"/>
              <ComboBox x:Name="cmbChainLengthMode" Grid.Row="5" Grid.Column="1" Height="26" FontSize="11" Margin="0,0,0,3"
                        SelectedIndex="0" SelectionChanged="OnChainLengthModeChanged"
                        ToolTip="Auto=自动按80%累积能量阈值过滤，Manual=使用下方设定的最小链长。"/>

              <!-- 第6行 - 最小链长 -->
              <TextBlock Text="  最小链长:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#1565C0" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numMinChainLength" Grid.Row="6" Grid.Column="1" Height="26"
                                       IntValue="10" Minimum="0" Maximum="200" SmallChange="1" ShowUpDownButtons="True" ShowSlider="True"
                                       ToolTip="最小轮廓链长(像素)。短于此长度的短线段被视为噪声丢弃。仅 Manual 模式有效。典型值：0~30。"
                                       Margin="0,0,0,3"/>

              <!-- 第7行 - 密度模式 -->
              <TextBlock Text="密度模式:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,6,3"/>
              <ComboBox x:Name="cmbDensityMode" Grid.Row="7" Grid.Column="1" Height="26" FontSize="11" Margin="0,0,0,3"
                        SelectedIndex="0" SelectionChanged="OnDensityModeChanged"
                        ToolTip="Auto=根据L0点数自动选择重采样比例，Manual=使用下方密度系数控制。"/>

              <!-- 第8行 - 密度系数 -->
              <TextBlock Text="  密度系数:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#1565C0" Margin="0,0,6,3"/>
              <controls:NumericUpDown x:Name="numDensityFactor" Grid.Row="8" Grid.Column="1" Height="26"
                                       Value="1.0" Minimum="0.1" Maximum="2.0" SmallChange="0.1" ShowUpDownButtons="True" ShowSlider="True" DecimalPlaces="1"
                                       ToolTip="密度系数(0.1~2.0)。1.0=中等密度，>1.0=更多点，&lt;1.0=更少点。仅 Manual 模式有效。"
                                       Margin="0,0,0,3"/>
            </Grid>
          </GroupBox>

          <!-- 提取结果 -->
          <GroupBox Header="提取结果" Margin="0,6,0,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
            <StackPanel>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="状态:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtResultStatus" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前层级:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtCurrentLevel" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#1976D2" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="轮廓点数:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtPointCount" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="包围矩形:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtBoundingRect" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="中心点:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtCenterPoint" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="过滤统计:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="txtFilterStats" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="#999" Text="--"/>
              </Grid>
              <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4,0,2"/>
              <TextBlock x:Name="txtLevelAdvice" Grid.ColumnSpan="2" FontSize="11" Foreground="#E65100"
                         TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 底部按钮栏 -->
    <Border Grid.Row="2" Background="#F0F0F0" Padding="16,10" Margin="0,6,0,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btnOk" Content="✓ 确定" Width="80" Height="30" Click="OnOkClick" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0"/>
        <Button x:Name="btnCancel" Content="取消" Width="80" Height="30" Click="OnCancelClick" FontSize="13"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
