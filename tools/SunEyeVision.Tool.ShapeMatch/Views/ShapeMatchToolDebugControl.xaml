<controls:ToolDebugControlBase x:Class="SunEyeVision.Tool.ShapeMatch.Views.ShapeMatchToolDebugControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:region="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Views;assembly=SunEyeVision.Plugin.SDK"
        xmlns:converters="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls.Region.Converters;assembly=SunEyeVision.Plugin.SDK"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SunEyeVision.Tool.ShapeMatch"
        xmlns:models="clr-namespace:SunEyeVision.Tool.ShapeMatch.Models"
        xmlns:localConverters="clr-namespace:SunEyeVision.Tool.ShapeMatch.Converters"
        xmlns:views="clr-namespace:SunEyeVision.Tool.ShapeMatch.Views"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="420"
        DataContext="{Binding Parameters, RelativeSource={RelativeSource Self}}">

    <controls:ToolDebugControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.Plugin.SDK;component/UI/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <localConverters:SortModeConverter x:Key="SortModeConverter"/>
            <localConverters:MultiTemplateModeConverter x:Key="MultiTemplateModeConverter"/>
            <localConverters:ExtractionStatusConverter x:Key="ExtractionStatusConverter"/>
        </ResourceDictionary>
    </controls:ToolDebugControlBase.Resources>

  <Grid>
    <TabControl Margin="5,0,5,0">
      <!-- Tab1: 基本参数 -->
      <TabItem Header="基本参数" IsSelected="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <controls:LabeledControl Label="输入图像" HorizontalAlignment="Left">
              <controls:ImageSourceSelector
                                x:Name="imageSourceSelector"
                                PlaceholderText="请选择输入图像源"
                                Width="250"
                                AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"
                                SelectedDataSource="{Binding ImageSource, Mode=TwoWay}"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="启用区域限制">
              <CheckBox IsChecked="{Binding IsRegionEnabled.Value, Mode=TwoWay}"
                        Content="仅对指定区域进行匹配"/>
            </controls:LabeledControl>

            <GroupBox Header="搜索区域" Margin="0,8,0,0"
                      Visibility="{Binding IsRegionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
                <region:RegionEditorManagerControl x:Name="regionManager"
                    InspectionRegionsSource="{Binding InspectionRegions.Regions}"
                    MaskRegionsSource="{Binding MaskRegions.Regions}"/>
            </GroupBox>

            <controls:LabeledControl Label="位置修正" Margin="0,8,0,0" HorizontalAlignment="Left">
              <controls:ToggleSwitch
                  IsChecked="{Binding IsPositionCorrectionEnabled.Value, Mode=TwoWay}"
                  SwitchWidth="48" SwitchHeight="24"/>
            </controls:LabeledControl>

            <controls:LabeledControl Label="修正信息" Margin="0,4,0,0" HorizontalAlignment="Left"
                Visibility="{Binding IsPositionCorrectionEnabled.Value, Converter={StaticResource BoolToVisibilityConverter}}">
              <controls:ParamBinding
                  x:Name="positionCorrectionBinding"
                  ParameterName="位置修正" Width="200"
                  BindingSource="{Binding PositionCorrectionBindingSource, Mode=TwoWay}"
                  BindingDisplayText="{Binding PositionCorrectionBindingDisplayText, Mode=TwoWay}"
                  AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
            </controls:LabeledControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab2: 模板管理 -->
      <TabItem Header="模板管理">
        <Grid Background="#FAFAFA">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
          </Grid.ColumnDefinitions>

          <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="10,8"
                    BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal">
                <Button Content="+ 创建" Width="65" Height="28" Margin="0,0,8,0"
                        Click="OnCreateTemplateClick" FontSize="12"/>
                <Button Content="↓ 载入" Width="65" Height="28"
                        Click="OnLoadTemplatesClick" FontSize="12"/>
              </StackPanel>
            </Border>

            <ListView x:Name="templateListView"
                     DockPanel.Dock="Top"
                     ItemsSource="{Binding Templates}"
                     SelectionMode="Single"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Header="序号" DisplayMemberBinding="{Binding OrderIndex}" Width="32"/>
                  <GridViewColumn Header="名称" Width="Auto"
                                  DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="启用" Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="" Width="80">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Content="▲" Width="24" Height="22" FontSize="9" Padding="0"
                                  Click="OnMoveUpClick" Tag="{Binding}" ToolTip="上移"/>
                          <Button Content="▼" Width="24" Height="22" FontSize="9" Padding="0"
                                  Click="OnMoveDownClick" Tag="{Binding}" ToolTip="下移"/>
                          <Button Content="⊗" Width="24" Height="22" FontSize="9" Padding="0"
                                  Foreground="#D32F2F" Click="OnDeleteTemplateClick" Tag="{Binding}" ToolTip="删除"/>
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>

          <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="100"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#333" CornerRadius="3" ClipToBounds="True"
                    BorderBrush="#CCC" BorderThickness="1">
              <Grid>
                <Image x:Name="previewImage" Stretch="Uniform" />
                <TextBlock x:Name="previewPlaceholder" Text="预览"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#888" FontSize="11"/>
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,4,0,0">
              <TextBlock x:Name="rightStatusText" FontSize="10" Foreground="#888" TextWrapping="Wrap"
                         Text="--"/>
              <TextBlock x:Name="rightPointCountText" FontSize="10" Foreground="#888" Margin="0,1,0,0"
                         Text="--"/>
              <TextBlock x:Name="rightSizeText" FontSize="10" Foreground="#888" Margin="0,1,0,0"
                         Text="--"/>
            </StackPanel>

            <Button Grid.Row="2" x:Name="btnEditTemplate" Content="编辑模板" Width="90" Height="26"
                    HorizontalAlignment="Left" Margin="0,6,0,2" FontSize="11"
                    Click="OnEditTemplateClick"/>

            <Button Grid.Row="3" x:Name="btnDeleteAllTemplates" Content="删除所有" Width="90" Height="24"
                    HorizontalAlignment="Left" Foreground="#D32F2F" FontSize="10"
                    Click="OnDeleteAllTemplatesClick"/>

            <Border Grid.Row="4"/>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Tab3: 运行参数 -->
      <TabItem Header="运行参数">
        <TabItem.Resources>
          <Style TargetType="{x:Type controls:LabeledControl}" BasedOn="{StaticResource {x:Type controls:LabeledControl}}">
            <Setter Property="LabelWidth" Value="130"/>
          </Style>
        </TabItem.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <GroupBox Header="匹配参数" Margin="0,0,0,8">
              <StackPanel>
                <controls:LabeledControl Label="最小分数 (0~1)">
                  <controls:ConfigSetting
                                    ParameterName="MinMatchScore"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding MinMatchScore.Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.1"
                                    ShowSlider="True" Width="220"
                                    DecimalPlaces="3"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

                <controls:LabeledControl Label="最大匹配数">
                  <controls:ConfigSetting
                                    ParameterName="MaxMatchCount"
                                    DataType="{x:Type sys:Int32}"
                                    Value="{Binding MaxMatchCount.Value, Mode=TwoWay}"
                                    Minimum="1" Maximum="100"
                                    SmallChange="1" LargeChange="5"
                                    Width="200"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

                <controls:LabeledControl Label="超时时间 (ms)">
                  <controls:ConfigSetting
                                    ParameterName="MatchTimeoutMs"
                                    DataType="{x:Type sys:Int32}"
                                    Value="{Binding MatchTimeoutMs.Value, Mode=TwoWay}"
                                    Minimum="100" Maximum="60000"
                                    SmallChange="500" LargeChange="5000"
                                    Width="200"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

                <controls:LabeledControl Label="NMS 重叠率 (0~1)">
                  <controls:ConfigSetting
                                    ParameterName="MaxOverlap"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding MaxOverlap.Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.1"
                                    Width="200" DecimalPlaces="2"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

                <controls:LabeledControl Label="贪婪度 (0~1)">
                  <controls:ConfigSetting
                                    ParameterName="Greediness"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding Greediness.Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.1"
                                    Width="200" DecimalPlaces="2"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

                <!-- 最小对比度 — 自动/手动 -->
                <controls:LabeledControl Label="最小对比度" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsMinContrastAuto.Value, Mode=TwoWay}"
                              Content="自动" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <controls:ConfigSetting
                                    ParameterName="MinContrast"
                                    DataType="{x:Type sys:Single}"
                                    Value="{Binding MinContrast.Value, Mode=TwoWay}"
                                    Minimum="1" Maximum="255"
                                    SmallChange="1" LargeChange="10"
                                    Width="160" DecimalPlaces="0"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </StackPanel>
                </controls:LabeledControl>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="搜索范围" Margin="0,0,0,8">
              <StackPanel>
                <!-- 角度起始（改名 AngleStart） -->
                <controls:LabeledControl Label="角度起始 (°)">
                  <controls:ConfigSetting
                                    ParameterName="AngleStart"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding AngleStart.Value, Mode=TwoWay}"
                                    Minimum="-360" Maximum="360"
                                    SmallChange="1" LargeChange="45"
                                    ShowSlider="False" Width="200" DecimalPlaces="1"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>
                <!-- 角度终止（改名 AngleEnd） -->
                <controls:LabeledControl Label="角度终止 (°)">
                  <controls:ConfigSetting
                                    ParameterName="AngleEnd"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding AngleEnd.Value, Mode=TwoWay}"
                                    Minimum="-360" Maximum="360"
                                    SmallChange="1" LargeChange="45"
                                    ShowSlider="False" Width="200" DecimalPlaces="1"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>
                <!-- 角度步长（0=auto） -->
                <controls:LabeledControl Label="角度步长 (°)">
                  <controls:ConfigSetting
                                    ParameterName="AngleStep"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding AngleStep.Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="90"
                                    SmallChange="0.1" LargeChange="10"
                                    ShowSlider="False" Width="200" DecimalPlaces="1"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

                <!-- 缩放起始 -->
                <controls:LabeledControl Label="缩放起始">
                  <controls:ConfigSetting
                                    ParameterName="ScaleMin"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding ScaleMin.Value, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="10.0"
                                    SmallChange="0.01" LargeChange="0.1"
                                    ShowSlider="False" Width="200" DecimalPlaces="3"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>
                <!-- 缩放终止 -->
                <controls:LabeledControl Label="缩放终止">
                  <controls:ConfigSetting
                                    ParameterName="ScaleMax"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding ScaleMax.Value, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="10.0"
                                    SmallChange="0.01" LargeChange="0.1"
                                    ShowSlider="False" Width="200" DecimalPlaces="3"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>
                <!-- 缩放步长（0=auto） -->
                <controls:LabeledControl Label="缩放步长">
                  <controls:ConfigSetting
                                    ParameterName="ScaleStep"
                                    DataType="{x:Type sys:Double}"
                                    Value="{Binding ScaleStep.Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="1.0"
                                    SmallChange="0.001" LargeChange="0.01"
                                    ShowSlider="False" Width="200" DecimalPlaces="3"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>
              </StackPanel>
            </GroupBox>

            <!-- 引擎参数（新增） -->
            <GroupBox Header="引擎参数" Margin="0,0,0,8">
              <StackPanel>
                <controls:LabeledControl Label="极性匹配">
                  <ComboBox SelectedItem="{Binding MetricMode.Value, Mode=TwoWay}"
                            Height="32" VerticalContentAlignment="Center" Width="220">
                    <models:MetricMode>UsePolarity</models:MetricMode>
                    <models:MetricMode>IgnoreGlobalPolarity</models:MetricMode>
                    <models:MetricMode>IgnoreLocalPolarity</models:MetricMode>
                  </ComboBox>
                </controls:LabeledControl>
                <controls:LabeledControl Label="优化模式" Margin="0,4,0,0">
                  <ComboBox SelectedItem="{Binding OptimizationMode.Value, Mode=TwoWay}"
                            Height="32" VerticalContentAlignment="Center" Width="220">
                    <models:OptimizationMode>Auto</models:OptimizationMode>
                    <models:OptimizationMode>None</models:OptimizationMode>
                    <models:OptimizationMode>PointReductionLow</models:OptimizationMode>
                    <models:OptimizationMode>PointReductionMedium</models:OptimizationMode>
                    <models:OptimizationMode>PointReductionHigh</models:OptimizationMode>
                  </ComboBox>
                </controls:LabeledControl>
                <controls:LabeledControl Label="亚像素" Margin="0,4,0,0">
                  <ComboBox SelectedItem="{Binding SubPixelMode.Value, Mode=TwoWay}"
                            Height="32" VerticalContentAlignment="Center" Width="220">
                    <models:SubPixelMode>None</models:SubPixelMode>
                    <models:SubPixelMode>Interpolation</models:SubPixelMode>
                    <models:SubPixelMode>LeastSquares</models:SubPixelMode>
                    <models:SubPixelMode>LeastSquaresHigh</models:SubPixelMode>
                    <models:SubPixelMode>LeastSquaresVeryHigh</models:SubPixelMode>
                  </ComboBox>
                </controls:LabeledControl>
              </StackPanel>
            </GroupBox>

            <!-- 排序方式 -->
            <controls:LabeledControl Label="排序方式">
              <ComboBox Height="32" VerticalContentAlignment="Center" Width="220"
                      SelectedItem="{Binding SortMode.Value, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource SortModeConverter}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <models:SortMode>None</models:SortMode>
                <models:SortMode>ScoreDescending</models:SortMode>
                <models:SortMode>AngleDescending</models:SortMode>
                <models:SortMode>XAscending</models:SortMode>
                <models:SortMode>YAscending</models:SortMode>
                <models:SortMode>XThenYAscending</models:SortMode>
                <models:SortMode>YThenXAscending</models:SortMode>
              </ComboBox>
            </controls:LabeledControl>

            <!-- 高级参数 -->
            <Expander Header="高级参数" IsExpanded="False"
                                      BorderBrush="#E0E0E0" BorderThickness="1"
                                      Margin="0,8,0,0" Background="White">
              <StackPanel Margin="16,8">
                <controls:LabeledControl Label="多模板模式">
                  <ComboBox Height="32" VerticalContentAlignment="Center" Width="220"
                          SelectedItem="{Binding MultiMode.Value, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource MultiTemplateModeConverter}}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <models:MultiTemplateMode>Sequential</models:MultiTemplateMode>
                    <models:MultiTemplateMode>ParallelIndependent</models:MultiTemplateMode>
                    <models:MultiTemplateMode>ParallelShared</models:MultiTemplateMode>
                  </ComboBox>
                </controls:LabeledControl>

                <controls:LabeledControl Label="最大并行度 (0=自动)" Margin="0,4,0,0">
                  <controls:ConfigSetting
                                    ParameterName="MaxParallelism"
                                    DataType="{x:Type sys:Int32}"
                                    Value="{Binding MaxParallelism.Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="16"
                                    SmallChange="1" Width="200"
                                    AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                </controls:LabeledControl>

              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab4: 结果显示 -->
      <TabItem Header="结果显示">
        <Grid Background="#F5F5F5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" Padding="3">
            <StackPanel>
              <!-- 结果判断 -->
              <Expander Header="结果判断"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <controls:LabeledControl Label="匹配数量判断" ContentHorizontalAlignment="Left">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsMatchCountCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="数量范围:" Margin="0,2,0,0" ContentHorizontalAlignment="Left"
                                                             Visibility="{Binding ResultConfig.IsMatchCountCheckEnabled,
                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBox Text="{Binding ResultConfig.MatchCountMin, Mode=TwoWay}" Width="50" VerticalContentAlignment="Center"/>
                      <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="4,0"/>
                      <TextBox Text="{Binding ResultConfig.MatchCountMax, Mode=TwoWay}" Width="50" VerticalContentAlignment="Center"/>
                    </StackPanel>
                  </controls:LabeledControl>

                  <controls:LabeledControl Label="匹配分数判断" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:ToggleSwitch IsChecked="{Binding ResultConfig.IsMatchScoreCheckEnabled, Mode=TwoWay}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="分数范围:" Margin="0,2,0,0" ContentHorizontalAlignment="Left"
                                                             Visibility="{Binding ResultConfig.IsMatchScoreCheckEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBox Text="{Binding ResultConfig.MatchScoreMin, Mode=TwoWay, StringFormat=F2}" Width="55" VerticalContentAlignment="Center"/>
                      <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="4,0"/>
                      <TextBox Text="{Binding ResultConfig.MatchScoreMax, Mode=TwoWay, StringFormat=F2}" Width="55" VerticalContentAlignment="Center"/>
                    </StackPanel>
                  </controls:LabeledControl>
                </StackPanel>
              </Expander>

              <!-- 图形显示 -->
              <Expander Header="图形显示"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <controls:LabeledControl Label="匹配框" ContentHorizontalAlignment="Left">
                    <controls:DispItemColorControl Item="{Binding ResultConfig.MatchBoxStyle, Mode=TwoWay}" ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="匹配中心" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispItemColorControl Item="{Binding ResultConfig.MatchCenterStyle, Mode=TwoWay}" ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="角度指示线" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispItemColorControl Item="{Binding ResultConfig.AngleLineStyle, Mode=TwoWay}" ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="轮廓叠加" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispItemColorControl Item="{Binding ResultConfig.TemplateContourStyle, Mode=TwoWay}" ContentHorizontalAlignment="Left"/>
                  </controls:LabeledControl>

                </StackPanel>
              </Expander>

              <!-- 文本显示 -->
              <Expander Header="文本显示"
                                      IsExpanded="True"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <controls:LabeledControl Label="得分文本" ContentHorizontalAlignment="Left">
                    <controls:DispTextColorControl
                        Item="{Binding ResultConfig.ScoreStyle, Mode=TwoWay}"
                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="位置文本" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispTextColorControl
                        Item="{Binding ResultConfig.PositionStyle, Mode=TwoWay}"
                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="角度文本" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispTextColorControl
                        Item="{Binding ResultConfig.AngleStyle, Mode=TwoWay}"
                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </controls:LabeledControl>
                  <controls:LabeledControl Label="缩放文本" ContentHorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:DispTextColorControl
                        Item="{Binding ResultConfig.ScaleStyle, Mode=TwoWay}"
                        AvailableDataSources="{Binding AvailableDataSources, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:ToolDebugControlBase}}}"/>
                  </controls:LabeledControl>
                </StackPanel>
              </Expander>

              <!-- 中间调试图像 -->
              <Expander Header="中间调试图像"
                                      IsExpanded="False"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      Margin="0,0,0,8"
                                      Background="White">
                <StackPanel Margin="16,8">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Background="#333" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1" Width="180" Height="135" ClipToBounds="True">
                      <Image x:Name="imgDebugGray" Stretch="Uniform"/>
                    </Border>
                    <Border Background="#333" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1" Width="180" Height="135" ClipToBounds="True" Margin="8,0,0,0">
