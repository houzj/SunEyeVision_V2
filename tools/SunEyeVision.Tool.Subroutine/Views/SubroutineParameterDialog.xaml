<!-- 子程序参数配置对话框 - 对齐 VisionMaster 21001 模块布局 -->
<Window x:Class="SunEyeVision.Tool.Subroutine.Views.SubroutineParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunEyeVision.Plugin.SDK.UI.Controls;assembly=SunEyeVision.Plugin.SDK"
        xmlns:local="clr-namespace:SunEyeVision.Tool.Subroutine.Views"
        Title="{Binding DialogTitle}"
        Width="1150" Height="680"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SunEyeVision.UI;component/Views/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tab按钮样式 -->
            <Style x:Key="TabHeaderButton" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 底部确定按钮样式 -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="#1976D2"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <!-- 添加按钮样式 -->
            <Style x:Key="AddButton" TargetType="Button">
                <Setter Property="Background" Value="#4CAF50"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 标签列样式 -->
            <Style x:Key="TagColumnStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="Height" Value="30"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Background" Value="White"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容: 左右分割布局 -->
        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧: TabControl ========== -->
            <Border Grid.Column="0" Margin="4" CornerRadius="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TabControl -->
                    <TabControl Grid.Row="1" BorderThickness="0" Background="White">
                        <!-- Tab 0: 输入设置 -->
                        <TabItem Header="输入设置" Padding="8,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid ItemsSource="{Binding Inputs}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              GridLinesVisibility="None"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowHeight="32"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="参数名称" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderBrush="#D0D0D0" BorderThickness="1" Padding="4,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="类型" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TypeName}" IsReadOnly="True"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#D0D0D0" BorderThickness="1" Padding="4,2"
                                                             Background="#F5F5F5"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="订阅关系" Width="*" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:ParamBinding
                                                        AvailableDataSources="{Binding DataContext.AvailableSources, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        DataType="{Binding ParamType}"
                                                        BindingSource="{Binding BindingSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        BindingDisplayText="{Binding BindingDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Height="26"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="操作" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Style="{StaticResource TabHeaderButton}"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="删除此项"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"
                                        Background="#FAFAFA" Padding="4,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding AvailableTypes}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedInputTypeName}"
                                                  Height="26" MinWidth="120" VerticalAlignment="Center"/>
                                        <Button Content="+" Height="26" Margin="4,0,0,0"
                                                Style="{StaticResource AddButton}"
                                                Command="{Binding AddInputCommand}"
                                                ToolTip="添加输入参数"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 1: 输出设置 -->
                    <TabItem Header="输出设置" Padding="8,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid ItemsSource="{Binding Outputs}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="None"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          RowHeight="32"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="参数名称" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#D0D0D0" BorderThickness="1" Padding="4,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="类型" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TypeName}" IsReadOnly="True"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#D0D0D0" BorderThickness="1" Padding="4,2"
                                                             Background="#F5F5F5"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="订阅关系" Width="*" MinWidth="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:ParamBinding
                                                            AvailableDataSources="{Binding DataContext.SubroutineInternalSources, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            DataType="{Binding ParamType}"
                                                            BindingSource="{Binding BindingSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            BindingDisplayText="{Binding BindingDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Height="26"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="操作" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕" Style="{StaticResource TabHeaderButton}"
                                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="删除此项"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="累计输出" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:ToggleSwitch
                                                            IsChecked="{Binding IsAccumulated, Mode=TwoWay}"
                                                            SwitchWidth="36" SwitchHeight="18"
                                                            HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"
                                            Background="#FAFAFA" Padding="4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding AvailableTypes}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedOutputTypeName}"
                                                      Height="26" MinWidth="120" VerticalAlignment="Center"/>
                                            <Button Content="+" Height="26" Margin="4,0,0,0"
                                                    Style="{StaticResource AddButton}"
                                                    Command="{Binding AddOutputCommand}"
                                                    ToolTip="添加输出项"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: 运行参数 -->
                        <TabItem Header="运行参数" Padding="8,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <TextBlock Text="执行参数" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#333333" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="启用循环执行:" VerticalAlignment="Center"
                                                   Margin="0,0,8,8"/>
                                        <controls:ToggleSwitch Grid.Row="0" Grid.Column="1"
                                                               IsChecked="{Binding LoopConfig.EnableLoop}"
                                                               SwitchWidth="42" SwitchHeight="22"
                                                               Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="最大迭代次数:" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding LoopConfig.MaxIterations}"
                                                 Width="100" Height="26"
                                                 HorizontalAlignment="Left"
                                                 IsEnabled="{Binding LoopConfig.EnableLoop}"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="循环条件" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#333333" Margin="0,8,0,8"/>
                                    <TextBox Text="{Binding LoopConfig.LoopCondition}"
                                             Height="60"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsEnabled="{Binding LoopConfig.EnableLoop}"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#D0D0D0" BorderThickness="1"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: 显示设置 -->
                        <TabItem Header="显示设置" Padding="8,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="图像显示"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333" Margin="8,6,8,0"/>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid ItemsSource="{Binding DisplayItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              GridLinesVisibility="None"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowHeight="32"
                                              HeadersVisibility="Column"
                                              Margin="0,4,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="参数名称" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderBrush="#D0D0D0" BorderThickness="1" Padding="4,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="类型" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding DisplayType}" IsReadOnly="True"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#D0D0D0" BorderThickness="1" Padding="4,2"
                                                             Background="#F5F5F5"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="关联关系" Width="*" MinWidth="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:ParamBinding
                                                            AvailableDataSources="{Binding DataContext.SubroutineInternalSources, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            DataType="{Binding ParamType}"
                                                            BindingSource="{Binding BindingSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            BindingDisplayText="{Binding BindingDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Height="26"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="操作" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕" Style="{StaticResource TabHeaderButton}"
                                                                Command="{Binding DataContext.RemoveDisplayItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="删除此显示项"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="累积显示" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:ToggleSwitch
                                                            IsChecked="{Binding IsAccumulated, Mode=TwoWay}"
                                                            SwitchWidth="36" SwitchHeight="18"
                                                            HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"
                                            Background="#FAFAFA" Padding="4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding AvailableDisplayTypes}"
                                                      SelectedItem="{Binding SelectedDisplayType}"
                                                      Height="26" MinWidth="120" VerticalAlignment="Center"/>
                                            <Button Content="+" Height="26" Margin="4,0,0,0"
                                                    Style="{StaticResource AddButton}"
                                                    Command="{Binding AddDisplayItemCommand}"
                                                    ToolTip="添加显示项"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 4: 循环设置 -->
                        <TabItem Header="循环设置" Padding="8,4">
                            <StackPanel Margin="8">
                                <TextBlock Text="循环结果配置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333333" Margin="0,0,0,8"/>
                                <TextBlock Text="累计结果存储方式、迭代数据保留策略等将在后续版本完善。"
                                           FontSize="12" Foreground="#999999" Margin="0,4"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Width="3"
                          HorizontalAlignment="Stretch"
                          Background="#E0E0E0"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ========== 右侧: 图像预览 + 输出结果 ========== -->
            <Border Grid.Column="2" Margin="4" CornerRadius="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 图像预览区域 -->
                    <Border Grid.Row="0" Margin="8" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Border Background="#1A1A1A" CornerRadius="4">
                                <Viewbox Stretch="Uniform">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="图像预览"
                                       Foreground="#888888"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 输出结果表格 -->
                    <Border Grid.Row="1" Margin="8,0,8,8" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="输出结果"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Padding="8,4" Background="#F5F5F5"/>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding OutputResults}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeight="24"
                                      HeadersVisibility="Column"
                                      MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="Auto" MinWidth="60"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="Auto" MinWidth="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定"
                        Width="80" Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
