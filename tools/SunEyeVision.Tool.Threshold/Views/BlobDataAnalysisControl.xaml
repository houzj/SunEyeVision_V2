<UserControl x:Class="SunEyeVision.Tool.Threshold.Views.BlobDataAnalysisControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignHeight="200" d:DesignWidth="700">

    <DataGrid ItemsSource="{Binding Blobs}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              RowHeight="22"
              FontSize="11"
              BorderThickness="0"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F8F8F8">
        <DataGrid.Columns>
            <DataGridTextColumn Header="序号" Binding="{Binding Label}" Width="40"/>
            <DataGridTextColumn Header="面积" Binding="{Binding Area, StringFormat='{}{0:F0}'}" Width="60"/>
            <DataGridTextColumn Header="周长" Binding="{Binding Perimeter, StringFormat='{}{0:F1}'}" Width="55"/>
            <DataGridTextColumn Header="质心X" Binding="{Binding CentroidX, StringFormat='{}{0:F1}'}" Width="55"/>
            <DataGridTextColumn Header="质心Y" Binding="{Binding CentroidY, StringFormat='{}{0:F1}'}" Width="55"/>
            <DataGridTextColumn Header="圆度" Binding="{Binding Circularity, StringFormat='{}{0:F3}'}" Width="50"/>
            <DataGridTextColumn Header="矩形度" Binding="{Binding Rectangularity, StringFormat='{}{0:F3}'}" Width="55"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
